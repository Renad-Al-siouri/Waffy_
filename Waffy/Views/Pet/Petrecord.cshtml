    <script>
            const mobileToggle = document.getElementById("mobileToggle");
            const navMenu = document.getElementById("navMenu");

            /* =========================
               PET DATA
            ========================= */

          const servicesDropdown = document.getElementById("servicesDropdown");
          const servicesToggle = document.getElementById("servicesToggle");
          const menuBtn = document.getElementById("menuBtn");
          const navLinks = document.getElementById("navLinks");
          const mobileServicesBlock = document.getElementById("mobileServicesBlock");
          const mobileServicesToggle = document.getElementById("mobileServicesToggle");

          if (servicesToggle && servicesDropdown) {
            servicesToggle.addEventListener("click", (e) => {
              e.stopPropagation();
              servicesDropdown.classList.toggle("open");
            });

            document.addEventListener("click", (e) => {
              if (!servicesDropdown.contains(e.target)) {
                servicesDropdown.classList.remove("open");
              }
            });
          }

          if (menuBtn && navLinks) {
            menuBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              navLinks.classList.toggle("open");
            });

            document.addEventListener("click", (e) => {
              if (!navLinks.contains(e.target) && !menuBtn.contains(e.target)) {
                navLinks.classList.remove("open");
              }
            });
          }

          if (mobileServicesBlock && mobileServicesToggle) {
            mobileServicesToggle.addEventListener("click", () => {
              mobileServicesBlock.classList.toggle("open");
            });
          }

            const petsData = {
              buddy: {
                name: "Lexi",
                age: "3 Years",
                type: "Dog - Beagle",
                gender: "Female",
                image: "images/dog.png",
                healthProblems: ["Mild skin allergy", "Previous digestive issue"],
                behavior: "Friendly, active, responsive",
                training: "Trained on basic commands",
                healthStatus: "Healthy",
                neutered: "Yes",
                vaccines: [
                  { name: "Rabies", taken: "15/05/2025", expiry: "15/05/2026" },
                  { name: "DHPP", taken: "10/06/2025", expiry: "10/06/2026" },
                  { name: "Kennel Cough", taken: "10/06/2025", expiry: "10/06/2026" }
                ]
              },
              milo: {
                name: "Milo",
                age: "1 Year",
                type: "Cat - Persian",
                gender: "Male",
                image: "images/cat.png",
                healthProblems: ["Allergy to chicken"],
                behavior: "Calm, friendly, playful",
                training: "Litter trained",
                healthStatus: "Healthy",
                neutered: "Yes",
                vaccines: [
                  { name: "Rabies", taken: "20/04/2025", expiry: "20/04/2026" },
                  { name: "FVRCP", taken: "22/04/2025", expiry: "22/04/2026" }
                ]
              }
            };

            /* =========================
               BASIC PAGE SETUP
            ========================= */
            if (mobileToggle && navMenu) {
              mobileToggle.addEventListener("click", () => {
                navMenu.classList.toggle("show");
              });
            }

            const params = new URLSearchParams(window.location.search);
            const petKey = params.get("pet") || "buddy";
            const pet = petsData[petKey] || petsData.buddy;

            const petNameEl = document.getElementById("petName");
            const petAgeEl = document.getElementById("petAge");
            const petTypeEl = document.getElementById("petType");
            const petGenderEl = document.getElementById("petGender");
            const petImageEl = document.getElementById("petImage");
            const petBehaviorEl = document.getElementById("petBehavior");
            const petTrainingEl = document.getElementById("petTraining");
            const healthProblemsEl = document.getElementById("healthProblems");
            const vaccineTableEl = document.getElementById("vaccineTable");

            const lostSelectedPetImage = document.getElementById("lostSelectedPetImage");
            const lostSelectedPetName = document.getElementById("lostSelectedPetName");
            const lostSelectedPetType = document.getElementById("lostSelectedPetType");

            if (petNameEl) petNameEl.textContent = pet.name;
            if (petAgeEl) petAgeEl.textContent = pet.age;
            if (petTypeEl) petTypeEl.textContent = pet.type;
            if (petGenderEl) petGenderEl.textContent = pet.gender;
            if (petImageEl) petImageEl.src = pet.image;
            if (petBehaviorEl) petBehaviorEl.textContent = pet.behavior;
            if (petTrainingEl) petTrainingEl.textContent = pet.training;

            if (lostSelectedPetImage) lostSelectedPetImage.src = pet.image;
            if (lostSelectedPetName) lostSelectedPetName.textContent = pet.name;
            if (lostSelectedPetType) lostSelectedPetType.textContent = pet.type;

            if (healthProblemsEl) {
              healthProblemsEl.innerHTML = pet.healthProblems
                .map(problem => `<p>${problem}</p>`)
                .join("");
            }

            if (vaccineTableEl) {
              vaccineTableEl.innerHTML = pet.vaccines
                .map(vaccine => `
                  <tr>
                    <td>${vaccine.name}</td>
                    <td>${vaccine.taken}</td>
                    <td>${vaccine.expiry}</td>
                  </tr>
                `)
                .join("");
            }

            /* =========================
               ADOPTION FLOW
            ========================= */
            const openAdoptionFormBtn = document.getElementById("openAdoptionFormBtn");
            const adoptionFlow = document.getElementById("adoptionFlow");
            const closeAdoptionFlowBtn = document.getElementById("closeAdoptionFlowBtn");

            const adoptionSteps = document.querySelectorAll(".adoption-step");
            const nextBtns = document.querySelectorAll(".next-step-btn");
            const prevBtns = document.querySelectorAll(".prev-step-btn");

            const submitAdoptionBtn = document.getElementById("submitAdoptionBtn");
            const submitAnotherAdBtn = document.getElementById("submitAnotherAdBtn");
            const backToRecordBtn = document.getElementById("backToRecordBtn");

            const adPhotos = document.getElementById("adPhotos");
            const photoPreviewGrid = document.getElementById("photoPreviewGrid");

            const adoptionConfirmModal = document.getElementById("adoptionConfirmModal");
            const closeAdoptionConfirmModal = document.getElementById("closeAdoptionConfirmModal");
            const cancelAdoptionConfirmBtn = document.getElementById("cancelAdoptionConfirmBtn");
            const confirmAdoptionFinalBtn = document.getElementById("confirmAdoptionFinalBtn");

            function showAdoptionStep(stepNumber) {
              adoptionSteps.forEach(step => step.classList.remove("active"));
              const target = document.getElementById(`adoptionStep${stepNumber}`);
              if (target) {
                target.classList.add("active");
                const modalBody = adoptionFlow?.querySelector(".adoption-modal");
                if (modalBody) modalBody.scrollTop = 0;
              }
            }

            function resetAdoptionPhotos() {
              if (!photoPreviewGrid) return;
              photoPreviewGrid.innerHTML = `
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
              `;
            }

            function resetAdoptionFlow() {
              const adCity = document.getElementById("adCity");
              const adArea = document.getElementById("adArea");
              const adPhone = document.getElementById("adPhone");
              const adDescription = document.getElementById("adDescription");
              const agreeAdTerms = document.getElementById("agreeAdTerms");

              if (adCity) adCity.value = "";
              if (adArea) adArea.value = "";
              if (adPhone) adPhone.value = "";
              if (adDescription) adDescription.value = "";
              if (agreeAdTerms) agreeAdTerms.checked = false;

              document.querySelectorAll('input[name="adoptionReason"]').forEach(input => {
                input.checked = false;
              });

              const contactMethods = document.querySelectorAll('input[name="contactMethod"]');
              contactMethods.forEach(input => {
                input.checked = false;
              });

              if (contactMethods.length) {
                contactMethods[0].checked = true;
              }

              if (adPhotos) adPhotos.value = "";
              resetAdoptionPhotos();
              showAdoptionStep(1);
            }

            function fillAdoptionReviewData() {
              const reviewPetName = document.getElementById("reviewPetName");
              const reviewPetType = document.getElementById("reviewPetType");
              const reviewPetAge = document.getElementById("reviewPetAge");
              const reviewPetGender = document.getElementById("reviewPetGender");
              const reviewHealthStatus = document.getElementById("reviewHealthStatus");
              const reviewNeutered = document.getElementById("reviewNeutered");
              const reviewCity = document.getElementById("reviewCity");
              const reviewArea = document.getElementById("reviewArea");
              const reviewPhone = document.getElementById("reviewPhone");
              const reviewMethod = document.getElementById("reviewMethod");
              const reviewDescription = document.getElementById("reviewDescription");
              const reviewReason = document.getElementById("reviewReason");

              if (reviewPetName) reviewPetName.textContent = pet.name;
              if (reviewPetType) reviewPetType.textContent = pet.type;
              if (reviewPetAge) reviewPetAge.textContent = pet.age;
              if (reviewPetGender) reviewPetGender.textContent = pet.gender;
              if (reviewHealthStatus) reviewHealthStatus.textContent = pet.healthStatus || "Healthy";
              if (reviewNeutered) reviewNeutered.textContent = pet.neutered || "Yes";

              if (reviewCity) reviewCity.textContent = document.getElementById("adCity")?.value || "-";
              if (reviewArea) reviewArea.textContent = document.getElementById("adArea")?.value || "-";
              if (reviewPhone) reviewPhone.textContent = "+962 " + (document.getElementById("adPhone")?.value || "-");

              const method = document.querySelector('input[name="contactMethod"]:checked');
              if (reviewMethod) reviewMethod.textContent = method ? method.value : "-";

              if (reviewDescription) {
                reviewDescription.textContent = document.getElementById("adDescription")?.value || "-";
              }

              const reason = document.querySelector('input[name="adoptionReason"]:checked');
              if (reviewReason) reviewReason.textContent = reason ? reason.value : "-";
            }

            if (openAdoptionFormBtn && adoptionFlow) {
              openAdoptionFormBtn.addEventListener("click", () => {
                adoptionFlow.classList.add("show");
                showAdoptionStep(1);
              });
            }

            if (closeAdoptionFlowBtn && adoptionFlow) {
              closeAdoptionFlowBtn.addEventListener("click", () => {
                adoptionFlow.classList.remove("show");
              });
            }

            nextBtns.forEach(btn => {
              btn.addEventListener("click", () => {
                const nextStep = btn.dataset.next;

                if (nextStep === "2") {
                  const city = document.getElementById("adCity")?.value.trim();
                  const area = document.getElementById("adArea")?.value.trim();
                  const phone = document.getElementById("adPhone")?.value.trim();

                  if (!city || !area || !phone) {
                    alert("Please fill in location and contact information first.");
                    return;
                  }
                }

                if (nextStep === "4") {
                  const description = document.getElementById("adDescription")?.value.trim();
                  const reason = document.querySelector('input[name="adoptionReason"]:checked');

                  if (!description || !reason) {
                    alert("Please complete description and reason before continuing.");
                    return;
                  }

                  fillAdoptionReviewData();
                }

                showAdoptionStep(nextStep);
              });
            });

            prevBtns.forEach(btn => {
              btn.addEventListener("click", () => {
                showAdoptionStep(btn.dataset.prev);
              });
            });

            if (submitAdoptionBtn) {
              submitAdoptionBtn.addEventListener("click", () => {
                const agree = document.getElementById("agreeAdTerms");

                if (!agree || !agree.checked) {
                  alert("Please agree to the terms before submitting.");
                  return;
                }

                if (adoptionConfirmModal) {
                  adoptionConfirmModal.classList.add("show");
                }
              });
            }

            if (closeAdoptionConfirmModal) {
              closeAdoptionConfirmModal.addEventListener("click", () => {
                adoptionConfirmModal?.classList.remove("show");
              });
            }

            if (cancelAdoptionConfirmBtn) {
              cancelAdoptionConfirmBtn.addEventListener("click", () => {
                adoptionConfirmModal?.classList.remove("show");
              });
            }

            if (confirmAdoptionFinalBtn) {
              confirmAdoptionFinalBtn.addEventListener("click", () => {
                adoptionConfirmModal?.classList.remove("show");
                showAdoptionStep(5);
              });
            }

            if (submitAnotherAdBtn) {
              submitAnotherAdBtn.addEventListener("click", () => {
                resetAdoptionFlow();
              });
            }

            if (backToRecordBtn) {
              backToRecordBtn.addEventListener("click", () => {
                adoptionFlow?.classList.remove("show");
                resetAdoptionFlow();
              });
            }

            if (adPhotos) {
              adPhotos.addEventListener("change", function () {
                const files = Array.from(this.files).slice(0, 5);
                if (!photoPreviewGrid) return;

                photoPreviewGrid.innerHTML = "";

                files.forEach(file => {
                  const reader = new FileReader();
                  reader.onload = function (e) {
                    const div = document.createElement("div");
                    div.className = "preview-thumb";
                    div.innerHTML = `<img src="${e.target.result}" alt="Pet Photo">`;
                    photoPreviewGrid.appendChild(div);
                  };
                  reader.readAsDataURL(file);
                });

                const remaining = 5 - files.length;
                for (let i = 0; i < remaining; i++) {
                  const empty = document.createElement("div");
                  empty.className = "mini-upload";
                  empty.textContent = "+";
                  photoPreviewGrid.appendChild(empty);
                }
              });
            }

            /* =========================
               LOST PET FLOW
            ========================= */
            const openLostFlowBtn = document.getElementById("openLostFlowBtn");
            const lostFlowModal = document.getElementById("lostFlowModal");
            const closeLostFlowModal = document.getElementById("closeLostFlowModal");
            const lostSteps = document.querySelectorAll(".lost-step");
            const lostNextBtns = document.querySelectorAll(".lost-next-btn");
            const lostPrevBtns = document.querySelectorAll(".lost-prev-btn");

            const fakeMapPickerBtn = document.getElementById("fakeMapPickerBtn");

            const lostPhotos = document.getElementById("lostPhotos");
            const lostPhotoPreviewGrid = document.getElementById("lostPhotoPreviewGrid");

            const lostPaymentModal = document.getElementById("lostPaymentModal");
            const openLostPaymentBtn = document.getElementById("openLostPaymentBtn");
            const closeLostPaymentModal = document.getElementById("closeLostPaymentModal");
            const cancelLostPaymentBtn = document.getElementById("cancelLostPaymentBtn");
            const confirmLostPaymentBtn = document.getElementById("confirmLostPaymentBtn");

            const lostFinalPublishConfirmModal = document.getElementById("lostFinalPublishConfirmModal");
            const closeLostFinalPublishConfirmModal = document.getElementById("closeLostFinalPublishConfirmModal");
            const cancelLostFinalPublishConfirmBtn = document.getElementById("cancelLostFinalPublishConfirmBtn");
            const confirmLostFinalPublishBtn = document.getElementById("confirmLostFinalPublishBtn");

            const submitAnotherLostBtn = document.getElementById("submitAnotherLostBtn");
            const viewLostAdBtn = document.getElementById("viewLostAdBtn");
            const copyFinderCodeBtn = document.getElementById("copyFinderCodeBtn");
            const finderCodeText = document.getElementById("finderCodeText");

            const walletBalance = 25;

            function showLostStep(stepNumber) {
              lostSteps.forEach(step => step.classList.remove("active"));
              const target = document.getElementById(`lostStep${stepNumber}`);
              if (target) {
                target.classList.add("active");
                const modalBody = lostFlowModal?.querySelector(".lost-modal");
                if (modalBody) modalBody.scrollTop = 0;
              }
            }

            function resetLostPhotoGrid() {
              if (!lostPhotoPreviewGrid) return;
              lostPhotoPreviewGrid.innerHTML = `
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
                <div class="mini-upload">+</div>
              `;
            }

            function resetLostFlow() {
              [
                "lostMicrochip",
                "lostDate",
                "lostTime",
                "lostCity",
                "lostArea",
                "lastSeenLocation",
                "lostDescription",
                "specialMarks",
                "secretQuestion",
                "secretAnswer",
                "lostContactPhone",
                "lostWhatsapp",
                "cardNumber",
                "expiryDate",
                "cvv",
                "cardholderName",
                "cliqAlias"
              ].forEach(id => {
                const field = document.getElementById(id);
                if (field) field.value = "";
              });

              const agreeLostTerms = document.getElementById("agreeLostTerms");
              if (agreeLostTerms) agreeLostTerms.checked = false;

              document.querySelectorAll('input[name="lostExpiry"]').forEach(input => {
                input.checked = input.value === "14 Days";
              });

              document.querySelectorAll('input[name="rewardAmount"]').forEach(input => {
                input.checked = input.value === "10";
              });

              document.querySelectorAll('input[name="lostContactMethod"]').forEach(input => {
                input.checked = input.value === "Phone";
              });

              document.querySelectorAll('input[name="paymentMethod"]').forEach(input => {
                input.checked = input.value === "Card";
              });

              activatePaymentMethod("Card");

              if (lostPhotos) lostPhotos.value = "";
              resetLostPhotoGrid();

              updateLostPaymentSummary();
              showLostStep(1);
            }

            function updateLostPaymentSummary() {
              const selectedReward = document.querySelector('input[name="rewardAmount"]:checked');
              const rewardValue = selectedReward ? Number(selectedReward.value) : 0;
              const fee = 2;
              const total = fee + rewardValue;
              const remaining = walletBalance - total;

              const reviewReward = document.getElementById("reviewReward");
              const reviewTotal = document.getElementById("reviewTotal");

              const walletBalanceDisplay = document.getElementById("walletBalanceDisplay");
              const walletRewardAmount = document.getElementById("walletRewardAmount");
              const walletTotalAmount = document.getElementById("walletTotalAmount");
              const walletShortText = document.getElementById("walletShortText");

              if (reviewReward) reviewReward.textContent = `${rewardValue.toFixed(2)} JOD`;
              if (reviewTotal) reviewTotal.textContent = `${total.toFixed(2)} JOD`;

              if (walletBalanceDisplay) walletBalanceDisplay.textContent = `${walletBalance.toFixed(2)} JOD`;
              if (walletRewardAmount) walletRewardAmount.textContent = `${rewardValue.toFixed(2)} JOD`;
              if (walletTotalAmount) walletTotalAmount.textContent = `${total.toFixed(2)} JOD`;

              if (walletShortText) {
                if (remaining >= 0) {
                  walletShortText.textContent = `Remaining balance after payment: ${remaining.toFixed(2)} JOD`;
                } else {
                  walletShortText.textContent = `Insufficient wallet balance. You need ${Math.abs(remaining).toFixed(2)} JOD more.`;
                }
              }
            }

            function validateLostStep(stepNumber) {
              if (stepNumber === "2") {
                const lostDate = document.getElementById("lostDate")?.value.trim();
                const lostCity = document.getElementById("lostCity")?.value.trim();
                const lostArea = document.getElementById("lostArea")?.value.trim();

                if (!lostDate || !lostCity || !lostArea) {
                  alert("Please complete date, city, and area first.");
                  return false;
                }
              }

              if (stepNumber === "3") {
                const lostDescription = document.getElementById("lostDescription")?.value.trim();
                if (!lostDescription) {
                  alert("Please add a description before continuing.");
                  return false;
                }
              }

              if (stepNumber === "6") {
                const secretQuestion = document.getElementById("secretQuestion")?.value.trim();
                const secretAnswer = document.getElementById("secretAnswer")?.value.trim();

                if (!secretQuestion || !secretAnswer) {
                  alert("Please enter the secret question and correct answer.");
                  return false;
                }
              }

              if (stepNumber === "7") {
                const lostContactPhone = document.getElementById("lostContactPhone")?.value.trim();
                if (!lostContactPhone) {
                  alert("Please enter a contact phone number.");
                  return false;
                }
              }

              return true;
            }

            function activatePaymentMethod(method) {
              const panels = {
                Wallet: document.getElementById("walletPanel"),
                Card: document.getElementById("cardPanel"),
                CliQ: document.getElementById("cliqPanel")
              };

              Object.entries(panels).forEach(([key, panel]) => {
                if (!panel) return;

                if (key === method) {
                  panel.classList.add("active");
                  panel.hidden = false;
                } else {
                  panel.classList.remove("active");
                  panel.hidden = true;
                }
              });

              document.querySelectorAll(".payment-method-card").forEach(card => {
                card.classList.remove("selected-red");
                const input = card.querySelector('input[type="radio"]');
                if (input && input.value === method) {
                  card.classList.add("selected-red");
                  input.checked = true;
                }
              });
            }

            function validatePaymentMethod() {
              const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value;

              if (selectedMethod === "Card") {
                const cardNumber = document.getElementById("cardNumber")?.value.trim();
                const expiryDate = document.getElementById("expiryDate")?.value.trim();
                const cvv = document.getElementById("cvv")?.value.trim();
                const cardholderName = document.getElementById("cardholderName")?.value.trim();

                if (!cardNumber || !expiryDate || !cvv || !cardholderName) {
                  alert("Please complete all card details.");
                  return false;
                }
              }

              if (selectedMethod === "CliQ") {
                const cliqAlias = document.getElementById("cliqAlias")?.value.trim();
                if (!cliqAlias) {
                  alert("Please enter your CliQ alias or phone number.");
                  return false;
                }
              }

              if (selectedMethod === "Wallet") {
                const selectedReward = document.querySelector('input[name="rewardAmount"]:checked');
                const rewardValue = selectedReward ? Number(selectedReward.value) : 0;
                const total = 2 + rewardValue;

                if (walletBalance < total) {
                  alert("Wallet balance is not enough for this payment.");
                  return false;
                }
              }

              return true;
            }

            if (openLostFlowBtn) {
              openLostFlowBtn.addEventListener("click", () => {
                lostFlowModal?.classList.add("show");
                showLostStep(1);
              });
            }

            if (closeLostFlowModal) {
              closeLostFlowModal.addEventListener("click", () => {
                lostFlowModal?.classList.remove("show");
              });
            }

            if (fakeMapPickerBtn) {
              fakeMapPickerBtn.addEventListener("click", () => {
                const manualField = document.getElementById("lastSeenLocation");
                if (manualField && !manualField.value.trim()) {
                  manualField.value = "Pinned location near last seen area.";
                }
              });
            }

            lostNextBtns.forEach(btn => {
              btn.addEventListener("click", () => {
                const nextStep = btn.dataset.next;
                if (!validateLostStep(nextStep)) return;
                showLostStep(nextStep);
              });
            });

            lostPrevBtns.forEach(btn => {
              btn.addEventListener("click", () => {
                showLostStep(btn.dataset.prev);
              });
            });

            document.querySelectorAll('input[name="rewardAmount"]').forEach(input => {
              input.addEventListener("change", updateLostPaymentSummary);
            });

            document.querySelectorAll('input[name="paymentMethod"]').forEach(input => {
              input.addEventListener("change", () => {
                activatePaymentMethod(input.value);
              });
            });

            if (lostPhotos) {
              lostPhotos.addEventListener("change", function () {
                const files = Array.from(this.files).slice(0, 5);
                if (!lostPhotoPreviewGrid) return;

                lostPhotoPreviewGrid.innerHTML = "";

                files.forEach(file => {
                  const reader = new FileReader();
                  reader.onload = function (e) {
                    const div = document.createElement("div");
                    div.className = "preview-thumb";
                    div.innerHTML = `<img src="${e.target.result}" alt="Lost Pet Photo">`;
                    lostPhotoPreviewGrid.appendChild(div);
                  };
                  reader.readAsDataURL(file);
                });

                const remaining = 5 - files.length;
                for (let i = 0; i < remaining; i++) {
                  const empty = document.createElement("div");
                  empty.className = "mini-upload";
                  empty.textContent = "+";
                  lostPhotoPreviewGrid.appendChild(empty);
                }
              });
            }

            if (openLostPaymentBtn) {
              openLostPaymentBtn.addEventListener("click", () => {
                const agreeLostTerms = document.getElementById("agreeLostTerms");

                if (!agreeLostTerms || !agreeLostTerms.checked) {
                  alert("Please agree to the terms first.");
                  return;
                }

                lostPaymentModal?.classList.add("show");
                activatePaymentMethod(document.querySelector('input[name="paymentMethod"]:checked')?.value || "Card");
              });
            }

            if (closeLostPaymentModal) {
              closeLostPaymentModal.addEventListener("click", () => {
                lostPaymentModal?.classList.remove("show");
              });
            }

            if (cancelLostPaymentBtn) {
              cancelLostPaymentBtn.addEventListener("click", () => {
                lostPaymentModal?.classList.remove("show");
              });
            }

            if (confirmLostPaymentBtn) {
              confirmLostPaymentBtn.addEventListener("click", () => {
                if (!validatePaymentMethod()) return;

                lostPaymentModal?.classList.remove("show");
                lostFinalPublishConfirmModal?.classList.add("show");
              });
            }

            if (closeLostFinalPublishConfirmModal) {
              closeLostFinalPublishConfirmModal.addEventListener("click", () => {
                lostFinalPublishConfirmModal?.classList.remove("show");
              });
            }

            if (cancelLostFinalPublishConfirmBtn) {
              cancelLostFinalPublishConfirmBtn.addEventListener("click", () => {
                lostFinalPublishConfirmModal?.classList.remove("show");
              });
            }

            if (confirmLostFinalPublishBtn) {
              confirmLostFinalPublishBtn.addEventListener("click", () => {
                lostFinalPublishConfirmModal?.classList.remove("show");
                showLostStep(8);
              });
            }

            if (submitAnotherLostBtn) {
              submitAnotherLostBtn.addEventListener("click", () => {
                resetLostFlow();
              });
            }

            if (viewLostAdBtn) {
              viewLostAdBtn.addEventListener("click", () => {
                lostFlowModal?.classList.remove("show");
                resetLostFlow();
              });
            }

            if (copyFinderCodeBtn && finderCodeText) {
              copyFinderCodeBtn.addEventListener("click", async () => {
                try {
                  await navigator.clipboard.writeText(finderCodeText.textContent.trim());
                  copyFinderCodeBtn.textContent = "Copied!";
                  setTimeout(() => {
                    copyFinderCodeBtn.textContent = "Copy Code";
                  }, 1500);
                } catch (error) {
                  alert("Could not copy the code.");
                }
              });
            }
            const petCameraBtn = document.querySelector(".pet-camera-btn");
        const petPhotoInput = document.getElementById("petPhotoInput");
        const petImage = document.getElementById("petImage");

        if (petCameraBtn && petPhotoInput) {
          petCameraBtn.addEventListener("click", () => {
            petPhotoInput.click();
          });
        }

        if (petPhotoInput) {
          petPhotoInput.addEventListener("change", function () {
            const file = this.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (e) {
              petImage.src = e.target.result;
            };
            reader.readAsDataURL(file);
          });
        }

            /* =========================
               GLOBAL OUTSIDE CLICKS
            ========================= */
            window.addEventListener("click", (e) => {
              if (e.target === adoptionFlow) adoptionFlow.classList.remove("show");
              if (e.target === adoptionConfirmModal) adoptionConfirmModal.classList.remove("show");

              if (e.target === lostPaymentModal) lostPaymentModal.classList.remove("show");
              if (e.target === lostFinalPublishConfirmModal) lostFinalPublishConfirmModal.classList.remove("show");
              if (e.target === lostFlowModal) lostFlowModal.classList.remove("show");
            });

            /* =========================
               INITIALIZE
            ========================= */
            updateLostPaymentSummary();
            activatePaymentMethod("Card");
            showAdoptionStep(1);
            showLostStep(1);
            resetLostPhotoGrid();
    </script>
</body>
</html>