                        </div>
                    </div>
                </div>

            </nav>
        </div>
    </header>

    <main class="details-page">
        <div class="container">
            <section class="record-shell">
                <section class="record-card">

                    <div class="record-hero">
                        <div class="record-hero-left">
                            <div class="record-logo">
                                <img src="../Images/logo.png" alt="logo" />
                            </div>

                            <div class="record-hero-copy">
                                <span class="page-chip">Waffy Pet Profile</span>
                                <h1 class="record-title">Complete Pet Medical Record</h1>
                                <p class="record-subtitle">
                                    A clean and organized space for your pet’s information, health history, vaccinations,
                                    behavior, and quick actions like adoption or lost-pet reporting.
                                </p>
                            </div>
                        </div>

                        <div class="record-hero-right">
                            <div class="hero-side-card">
                                <div class="hero-side-badge">Healthy Profile</div>
                                <h3>Everything in one elegant card</h3>
                                <p>
                                    Keep your pet details ready, clear, and easy to access whenever you need them.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Pet Information -->
                    <div class="box pet-main-box">
                        <div class="box-title">Pet Information</div>

                        <div class="pet-info-grid">
                            <div class="pet-photo">
                                <div class="pet-avatar-wrap">
                                    <div class="pet-avatar">
                                        <img id="petImage" src="../Images/Animals/dod1.jpg" alt="pet" />
                                        <span class="pet-default-icon">🐾</span>
                                    </div>

                                    <button class="pet-camera-btn" type="button">📷</button>
                                    <input type="file" id="petPhotoInput" accept="image/*" hidden />
                                </div>
                            </div>

                            <div class="pet-main-info">
                                <div class="pet-main-top">
                                    <div class="pet-name-block">
                                        <h2 id="petName">Lexi</h2>
                                        <span class="pet-type-pill" id="petType">Dog - Beagle</span>
                                    </div>


                                </div>

                                <div class="pet-main-grid">
                                    <div class="info-item">
                                        <span>Age</span>
                                        <strong id="petAge">3 Years</strong>
                                    </div>

                                    <div class="info-item">
                                        <span>Gender</span>
                                        <strong id="petGender">Female</strong>
                                    </div>

                                    <div class="info-item">
                                        <span>Type</span>
                                        <strong>Dog - Beagle</strong>
                                    </div>

                                    <div class="info-item">
                                        <span>Record</span>
                                        <strong>Complete</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Health Status -->
                    <div class="double-grid">
                        <div class="box">
                            <div class="box-title">Health Issues</div>
                            <div class="mini-content" id="healthProblems">
                                <p>Mild skin allergy</p>
                                <p>Previous digestive issue</p>
                            </div>
                        </div>

                        <div class="box">
                            <div class="box-title">Health Status</div>
                            <div class="mini-content">
                                <p><strong>Health Issues:</strong> Yes ✅</p>
                                <p><strong>Neutered/Spayed:</strong> Yes ✅</p>
                            </div>
                        </div>
                    </div>

                    <!-- Vaccination Record -->
                    <div class="box">
                        <div class="box-title">Vaccination Record</div>

                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Vaccine</th>
                                        <th>Date Taken</th>
                                        <th>Expiry</th>
                                    </tr>
                                </thead>
                                <tbody id="vaccineTable">
                                    <tr>
                                        <td>Rabies</td>
                                        <td>15/05/2025</td>
                                        <td>15/05/2026</td>
                                    </tr>
                                    <tr>
                                        <td>DHPP</td>
                                        <td>10/06/2025</td>
                                        <td>10/06/2026</td>
                                    </tr>
                                    <tr>
                                        <td>Kennel Cough</td>
                                        <td>10/06/2025</td>
                                        <td>10/06/2026</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Behavior -->
                    <div class="box">
                        <div class="box-title">Behavior & Habits</div>
                        <div class="behavior-content">
                            <p><strong>Behavior:</strong> <span id="petBehavior">Friendly, active, responsive</span></p>
                            <p><strong>Training:</strong> <span id="petTraining">Trained on basic commands</span></p>
                        </div>
                    </div>

                    <!-- buttons -->
                    <div class="bottom-actions">
                        <button class="action-btn adopted-btn" id="openAdoptionFormBtn">Put Pet Up for Adoption 🐾</button>
                        <button class="action-btn lost-btn" id="openLostFlowBtn">Pet is Missing 📣</button>
                    </div>

                    <button class="back-btn" onclick="window.location.href='profile.html'">Back</button>

                </section>
            </section>
        </div>
    </main>
    <!-- ADOPTION CONFIRM MODAL -->
    <div class="modal-overlay" id="adoptionConfirmModal">
        <div class="modal confirm-adoption-modal">
            <button class="close-modal" id="closeAdoptionConfirmModal">×</button>

            <div class="confirm-logo">
                <img src="../Images/logo.png" alt="Waffy Logo">
            </div>

            <h2>Confirm Adoption Listing</h2>

            <div class="confirm-image-wrap">
                <img src="../Images/logo.png" alt="Confirm Adoption">
            </div>

            <p class="confirm-text">
                Are you sure you want to list your pet for adoption?
            </p>

            <div class="confirm-actions">
                <button type="button" class="confirm-cancel-btn" id="cancelAdoptionConfirmBtn">Cancel</button>
                <button type="button" class="confirm-ok-btn" id="confirmAdoptionFinalBtn">Yes, Confirm</button>
            </div>
        </div>
    </div>

    <!-- LOST PET FLOW MODAL -->
    <div class="modal-overlay" id="lostFlowModal">
        <div class="modal adoption-modal lost-modal">
            <button class="close-modal" id="closeLostFlowModal">×</button>

            <!-- STEP 1 -->
            <div class="lost-step active" id="lostStep1">
                <div class="box adoption-step-box">

                    <div class="fee-summary-banner">
                        <div class="fee-left">
                            <strong>2.00 JOD</strong>
                            <span>Publishing Fee</span>
                        </div>
                        <div class="fee-right">
                            <h4>Ad Publishing Fee</h4>
                            <p>Non-refundable fee to improve ad quality and reduce fake reports.</p>
                        </div>
                    </div>

                    <div class="step-header">
                        <div>
                            <h3>Select Your Lost Pet</h3>
                            <span>Step 1</span>
                        </div>
                        <div class="step-icon">🐾</div>
                    </div>

                    <div class="selected-pet-card">
                        <div class="selected-pet-image">
                            <img id="lostSelectedPetImage" src="../Images/Animals/dog1.png" alt="Selected pet">
                        </div>
                        <div class="selected-pet-text">
                            <h4 id="lostSelectedPetName">Lexi</h4>
                            <p id="lostSelectedPetType">Dog - Beagle</p>
                            <small>Using the pet from this medical record</small>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label for="lostMicrochip">Microchip ID (Optional)</label>
                        <input type="text" id="lostMicrochip" placeholder="Example: 985141000012345">
                    </div>

                    <div class="adoption-grid">
                        <div class="form-group">
                            <label for="lostDate">Date Lost</label>
                            <input type="date" id="lostDate">
                        </div>

                        <div class="form-group">
                            <label for="lostTime">Time Lost (Optional)</label>
                            <input type="time" id="lostTime">
                        </div>

                        <div class="form-group">
                            <label for="lostCity">City</label>
                            <select id="lostCity">
                                <option value="">Select city</option>
                                <option>Amman</option>
                                <option>Zarqa</option>
                                <option>Irbid</option>
                                <option>Aqaba</option>
                                <option>Madaba</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="lostArea">Area / Neighborhood</label>
                            <input type="text" id="lostArea" placeholder="Example: Al Rabieh">
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Last Seen Location</label>
                        <button type="button" class="map-picker-box" id="fakeMapPickerBtn">
                            <div class="map-icon">🗺️</div>
                            <strong>Tap to set the location on the map</strong>
                            <span>Google Maps Integration</span>
                        </button>
                    </div>

                    <div class="form-group full-width">
                        <label for="lastSeenLocation">Or Enter Address Manually</label>
                        <textarea id="lastSeenLocation" placeholder="Enter the location manually..."></textarea>
                    </div>

                    <div class="step-actions">
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="2">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 2 -->
            <div class="lost-step" id="lostStep2">
                <div class="box adoption-step-box">
                    <div class="step-header">
                        <div>
                            <h3>Description & Special Marks</h3>
                            <span>Step 2</span>
                        </div>
                        <div class="step-icon">📝</div>
                    </div>

                    <div class="form-group full-width">
                        <label for="lostDescription">Description</label>
                        <textarea id="lostDescription" placeholder="Describe how the pet was lost..."></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label for="specialMarks">Special Marks / Features</label>
                        <textarea id="specialMarks" placeholder="Example: blue collar, white spot on chest..."></textarea>
                    </div>

                    <div class="form-group full-width">
                        <label for="lostPhotos">Upload Additional Photos</label>

                        <label for="lostPhotos" class="main-upload-area lost-upload-area">
                            <div class="upload-icon">📷</div>
                            <strong>Upload lost pet photos</strong>
                            <p>Up to 5 images — JPG, PNG</p>
                        </label>

                        <input type="file" id="lostPhotos" multiple accept="image/*" hidden>

                        <div class="photo-preview-grid" id="lostPhotoPreviewGrid">
                            <div class="mini-upload">+</div>
                            <div class="mini-upload">+</div>
                            <div class="mini-upload">+</div>
                            <div class="mini-upload">+</div>
                            <div class="mini-upload">+</div>
                        </div>
                    </div>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="1">Back</button>
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="3">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 3 -->
            <div class="lost-step" id="lostStep3">
                <div class="box adoption-step-box">
                    <div class="step-header">
                        <div>
                            <h3>Visibility Radius & Ad Expiry</h3>
                            <span>Step 3</span>
                        </div>
                        <div class="step-icon">📡</div>
                    </div>

                    <div class="empty-visual-space"></div>

                    <div class="form-group full-width">
                        <label>Ad Expiry</label>
                        <div class="choice-grid three-cols">
                            <label class="choice-card">
                                <input type="radio" name="lostExpiry" value="7 Days">
                                <span>7 Days</span>
                            </label>
                            <label class="choice-card selected-red">
                                <input type="radio" name="lostExpiry" value="14 Days" checked>
                                <span>14 Days</span>
                            </label>
                            <label class="choice-card">
                                <input type="radio" name="lostExpiry" value="30 Days">
                                <span>30 Days</span>
                            </label>
                        </div>
                    </div>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="2">Back</button>
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="4">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 4 -->
            <div class="lost-step" id="lostStep4">
                <div class="box adoption-step-box reward-box">
                    <div class="step-header">
                        <div>
                            <h3>Waffy Wallet - Reward System</h3>
                            <span>Step 4</span>
                        </div>
                        <div class="step-icon">👛</div>
                    </div>

                    <div class="warning-inline">
                        Reward amount will stay reserved in your wallet until the finder is verified.
                    </div>

                    <div class="form-group full-width">
                        <label>Reward Amount</label>
                        <div class="choice-grid four-cols">
                            <label class="choice-card">
                                <input type="radio" name="rewardAmount" value="50">
                                <span>50 JOD</span>
                            </label>
                            <label class="choice-card">
                                <input type="radio" name="rewardAmount" value="25">
                                <span>25 JOD</span>
                            </label>
                            <label class="choice-card selected-red">
                                <input type="radio" name="rewardAmount" value="10" checked>
                                <span>10 JOD</span>
                            </label>
                            <label class="choice-card">
                                <input type="radio" name="rewardAmount" value="0">
                                <span>No Reward</span>
                            </label>
                        </div>
                    </div>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="3">Back</button>
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="5">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 5 -->
            <div class="lost-step" id="lostStep5">
                <div class="box adoption-step-box secret-box">
                    <div class="step-header">
                        <div>
                            <h3>Secret Question</h3>
                            <span>Step 5</span>
                        </div>
                        <div class="step-icon">🔐</div>
                    </div>

                    <div class="info-note-box">
                        The question and answer will never appear in the public ad.
                    </div>

                    <div class="form-group full-width">
                        <label for="secretQuestion">Secret Question</label>
                        <input type="text" id="secretQuestion" placeholder="Example: Does the pet have a mark on one ear?">
                    </div>

                    <div class="form-group full-width">
                        <label for="secretAnswer">Correct Answer</label>
                        <input type="text" id="secretAnswer" placeholder="Hidden answer">
                    </div>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="4">Back</button>
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="6">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 6 -->
            <div class="lost-step" id="lostStep6">
                <div class="box adoption-step-box">
                    <div class="step-header">
                        <div>
                            <h3>Contact Information</h3>
                            <span>Step 6</span>
                        </div>
                        <div class="step-icon">📞</div>
                    </div>

                    <div class="form-group full-width">
                        <label for="lostContactPhone">Contact Phone</label>
                        <div class="phone-wrap">
                            <span class="phone-code">+962</span>
                            <input type="text" id="lostContactPhone" placeholder="7X XXX XXXX">
                        </div>
                    </div>

                    <div class="adoption-grid">
                        <div class="form-group">
                            <label for="lostWhatsapp">WhatsApp Number</label>
                            <div class="phone-wrap">
                                <span class="phone-code">+962</span>
                                <input type="text" id="lostWhatsapp" placeholder="7X XXX XXXX">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Preferred Contact</label>
                            <div class="choice-grid two-cols">
                                <label class="choice-card">
                                    <input type="radio" name="lostContactMethod" value="Phone" checked>
                                    <span>Phone</span>
                                </label>
                                <label class="choice-card selected-red">
                                    <input type="radio" name="lostContactMethod" value="WhatsApp">
                                    <span>WhatsApp</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="5">Back</button>
                        <button type="button" class="action-btn adopted-btn lost-next-btn" data-next="7">Next</button>
                    </div>
                </div>
            </div>

            <!-- STEP 7 -->
            <div class="lost-step" id="lostStep7">
                <div class="box adoption-step-box payment-summary-box">
                    <div class="step-header">
                        <div>
                            <h3>Payment Summary</h3>
                            <span>Step 7</span>
                        </div>
                        <div class="step-icon">💳</div>
                    </div>

                    <div class="review-list">
                        <div><span>Ad Publishing Fee</span><strong>2.00 JOD</strong></div>
                        <div><span>Reward (Reserved in Wallet)</span><strong id="reviewReward">10.00 JOD</strong></div>
                        <div><span>Total Now</span><strong class="total-red" id="reviewTotal">12.00 JOD</strong></div>
                    </div>

                    <label class="agree-check review-agree">
                        <input type="checkbox" id="agreeLostTerms">
                        <span>I agree to publish this lost pet ad and confirm the information is correct.</span>
                    </label>

                    <div class="step-actions between-actions">
                        <button type="button" class="action-btn cancel-adoption-btn lost-prev-btn" data-prev="6">Back</button>
                        <button type="button" class="action-btn lost-submit-btn" id="openLostPaymentBtn">Pay & Publish Ad</button>
                    </div>
                </div>
            </div>

            <!-- STEP 8 -->
            <div class="lost-step" id="lostStep8">
                <div class="box adoption-success-box lost-success-box">
                    <div class="success-icon">🔎</div>
                    <h2>Ad Published Successfully!</h2>
                    <p>Your lost pet ad is now live. You will be notified immediately when someone finds your pet.</p>

                    <div class="success-badge code-badge">
                        Finder Code: <strong id="finderCodeText">WAFFY-F-1D9362</strong>
                    </div>

                    <button type="button" class="copy-code-btn" id="copyFinderCodeBtn">Copy Code</button>

                    <div class="success-steps">
                        <div><span>1</span> Ad is now visible to nearby users</div>
                        <div><span>2</span> Finder will answer the secret question</div>
                        <div><span>3</span> Reward is reserved safely in your wallet</div>
                        <div><span>4</span> Ad expires automatically after selected duration</div>
                    </div>

                    <div class="success-buttons">
                        <button type="button" class="action-btn lost-btn" id="submitAnotherLostBtn">Post Another Ad</button>
                        <button type="button" class="action-btn cancel-adoption-btn" id="viewLostAdBtn">View My Ad</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PAYMENT MODAL -->
    <div class="modal-overlay" id="lostPaymentModal">
        <div class="modal adoption-modal payment-modal">
            <button class="close-modal" id="closeLostPaymentModal">×</button>

            <div class="box adoption-step-box">
                <div class="step-header">
                    <div>
                        <h3>Payment Method</h3>
                        <span>Lost Pet Ad Payment</span>
                    </div>
                    <div class="step-icon">💳</div>
                </div>

                <div class="choice-grid three-cols payment-method-grid">
                    <label class="choice-card payment-method-card" data-method="CliQ">
                        <input type="radio" name="paymentMethod" value="CliQ">
                        <span>CliQ</span>
