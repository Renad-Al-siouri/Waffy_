@model Waffy.Models.Pet
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy | Edit @Model.Name</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Petform.css" />
</head>
<body>
    <div class="pet-form-page">

        <h2>✏️ Edit @Model.Name</h2>

        @if (TempData["PetError"] != null)
        {
            <div class="alert-error">⚠️ @TempData["PetError"]</div>
        }

        <form method="post"
              asp-controller="Pet"
              asp-action="EditPet"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="petId" value="@Model.IdPet" />

            @* ── Pet Information ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">🐾 Pet Information</span>
                </div>
                <div class="s-card-body">
                    <div class="form-grid">

                        <div class="field full">
                            <label>New Photo (optional)</label>
                            <input type="file" name="petImage" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl"
                                     class="current-img-preview"
                                     alt="Current photo" />
                            }
                        </div>

                        <div class="field full">
                            <label>Pet Name <span style="color:red">*</span></label>
                            <input type="text" name="name"
                                   value="@Model.Name" required />
                        </div>

                        <div class="field">
                            <label>Type <span style="color:red">*</span></label>
                            <select name="species" required>
                                <option value="">Select</option>
                                @foreach (var s in new[] { "Dog", "Cat", "Bird", "Rabbit", "Snake", "Hamster", "Other" })
                                {
                                    <option value="@s" selected="@(Model.Species == s)">@s</option>
                                }
                            </select>
                        </div>

                        <div class="field">
                            <label>Breed</label>
                            <input type="text" name="breed" value="@Model.Breed" />
                        </div>

                        <div class="field">
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select</option>
                                <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Birth Date</label>
                            <input type="date" name="birthDate"
                                   value="@Model.BirthDate?.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="field">
                            <label>Color</label>
                            <input type="text" name="color" value="@Model.Color" />
                        </div>

                        <div class="field">
                            <label>Weight (kg)</label>
                            <input type="number" name="weight"
                                   step="0.1" value="@Model.Weight" />
                        </div>

                    </div>
                </div>
            </div>

            @* ── Health ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">❤️ Health</span>
                </div>
                <div class="s-card-body">
                    <div class="form-grid">

                        <div class="field">
                            <label>Vaccination Status</label>
                            <select name="vaccinationStatus">
                                <option value="UpToDate" selected="@(Model.VaccinationStatus == "UpToDate")">Up to date</option>
                                <option value="Partial" selected="@(Model.VaccinationStatus == "Partial")">Partial</option>
                                <option value="None" selected="@(Model.VaccinationStatus == "None")">None</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Neutered / Spayed</label>
                            <select name="isNeutered">
                                <option value="false" selected="@(!Model.IsNeutered)">No</option>
                                <option value="true" selected="@(Model.IsNeutered)">Yes</option>
                            </select>
                        </div>

                        <div class="field full">
                            <label>Medical Notes</label>
                            <textarea name="medicalNotes">@Model.MedicalNotes</textarea>
                        </div>

                    </div>
                </div>
            </div>

            @* ── Behaviour ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">🧠 Behaviour</span>
                </div>
                <div class="s-card-body">
                    <div class="form-grid">

                        <div class="field">
                            <label>Energy Level</label>
                            <select name="energyLevel">
                                <option value="Low" selected="@(Model.EnergyLevel == "Low")">Low</option>
                                <option value="Medium" selected="@(Model.EnergyLevel == "Medium")">Medium</option>
                                <option value="High" selected="@(Model.EnergyLevel == "High")">High</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Trained</label>
                            <select name="isTrained">
                                <option value="false" selected="@(!Model.IsTrained)">No</option>
                                <option value="true" selected="@(Model.IsTrained)">Yes</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Good with Children</label>
                            <select name="goodWithChildren">
                                <option value="false" selected="@(!Model.GoodWithChildren)">No</option>
                                <option value="true" selected="@(Model.GoodWithChildren)">Yes</option>
                            </select>
                        </div>

                        <div class="field">
                            <label>Good with Other Pets</label>
                            <select name="goodWithPets">
                                <option value="false" selected="@(!Model.GoodWithPets)">No</option>
                                <option value="true" selected="@(Model.GoodWithPets)">Yes</option>
                            </select>
                        </div>

                        <div class="field full">
                            <label>Traits / Description</label>
                            <textarea name="traits">@Model.Traits</textarea>
                        </div>

                    </div>
                </div>
            </div>

            <div class="form-actions">
                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn btn-secondary">← Cancel</a>
                <button type="submit" class="btn btn-primary">
                    Save Changes ✅
                </button>
            </div>

        </form>
    </div>
</body>
</html>