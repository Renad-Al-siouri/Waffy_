@model Waffy.Models.ViewModels.AdoptionPageViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Adoption - Waffy</title>
    <link rel="stylesheet" href="~/css/adaptstyle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* ── Carousel ── */
        .pet-thumb {
            position: relative;
            overflow: hidden;
            background: #f5f5f5;
        }

            .pet-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: none;
                transition: opacity .3s ease;
            }

                .pet-thumb img.car-active {
                    display: block;
                }

        .car-dots {
            position: absolute;
            bottom: 7px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 5px;
            z-index: 2;
        }

        .car-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,.55);
            cursor: pointer;
            border: none;
            padding: 0;
            transition: background .2s, transform .2s;
        }

            .car-dot.active {
                background: #fff;
                transform: scale(1.2);
            }

        .car-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(255,255,255,.85);
            border: none;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #3d7a10;
            box-shadow: 0 1px 4px rgba(0,0,0,.15);
            transition: background .2s;
            line-height: 1;
        }

            .car-btn:hover {
                background: rgba(255,255,255,1);
            }

            .car-btn.prev {
                left: 6px;
            }

            .car-btn.next {
                right: 6px;
            }

        .pet-thumb[data-count="1"] .car-btn,
        .pet-thumb[data-count="1"] .car-dots {
            display: none !important;
        }

        .photo-counter {
            position: absolute;
            top: 6px;
            right: 8px;
            background: rgba(0,0,0,.45);
            color: #fff;
            font-size: .68rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 20px;
            font-family: 'Nunito', sans-serif;
            z-index: 2;
        }

        .pet-thumb[data-count="1"] .photo-counter {
            display: none;
        }

        /* ── Report Button ── */
        .report-wrap {
            margin-top: .5rem;
            border-top: 1px solid rgba(89,101,42,.1);
            padding-top: .5rem;
            width: 100%;
        }

        .report-toggle-btn {
            background: none;
            border: 1px solid rgba(220,38,38,.3);
            color: #dc2626;
            font-size: .72rem;
            font-weight: 800;
            padding: 4px 12px;
            border-radius: 20px;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: all .2s;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

            .report-toggle-btn:hover {
                background: #fef2f2;
                border-color: #dc2626;
            }

        .report-already {
            font-size: .74rem;
            color: #9ca3af;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* ── Flag Modal ── */
        .flag-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(38,31,23,.5);
            backdrop-filter: blur(4px);
            z-index: 1200;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .flag-modal-overlay.open {
                display: flex;
            }

        .flag-modal-box {
            background: #fff;
            border-radius: 20px;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,.18);
            animation: flagSlideUp .22s ease;
            overflow: hidden;
        }

        @@keyframes flagSlideUp {
            from {
                opacity: 0;
                transform: translateY(14px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .flag-modal-head {
            padding: 16px 20px 12px;
            border-bottom: 1px solid #f5e8e8;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fef2f2;
        }

        .flag-modal-title {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: #dc2626;
        }

        .flag-modal-close {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(220,38,38,.1);
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
            color: #dc2626;
            display: grid;
            place-items: center;
            transition: .18s;
        }

            .flag-modal-close:hover {
                background: rgba(220,38,38,.2);
            }

        .flag-modal-body {
            padding: 18px 20px 0;
        }

        .flag-modal-note {
            font-size: .78rem;
            color: #9ca3af;
            font-weight: 700;
            margin-bottom: 14px;
            line-height: 1.6;
        }

        .flag-modal-select {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid rgba(220,38,38,.25);
            border-radius: 12px;
            font-family: 'Nunito', sans-serif;
            font-size: .84rem;
            font-weight: 700;
            color: #374151;
            background: #fff;
            outline: none;
            transition: border-color .18s;
            margin-bottom: 4px;
        }

            .flag-modal-select:focus {
                border-color: #dc2626;
            }

        .flag-modal-footer {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            padding: 14px 20px 18px;
        }

        /* ── Flag Toast ── */
        .flag-toast {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #22c55e;
            color: #fff;
            padding: 11px 22px;
            border-radius: 30px;
            font-weight: 800;
            font-size: .84rem;
            z-index: 9999;
            box-shadow: 0 4px 20px rgba(0,0,0,.15);
            font-family: 'Nunito', sans-serif;
            white-space: nowrap;
        }
    </style>
</head>
<body data-logged-in="@(Context.Session.GetInt32("UserId").HasValue ? "true" : "false")">

    @Html.AntiForgeryToken()

    @* ── Flag Success Toast ── *@
    @if (TempData["FlagSuccess"] != null)
    {
        <div class="flag-toast">✅ @TempData["FlagSuccess"]</div>
    }

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="../Images/logo.png" alt="Waffy Logo"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">▼</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container adoption-page">
        <section class="hero-section fade-up">
            <h1>Find Your Perfect Pet to Adopt!</h1>
            <p>
                Browse through our list of adorable pets looking for loving homes.
                Use the filters and search to explore different animal types, like your favorites,
                and reserve the one that steals your heart.
            </p>
        </section>

        <section class="adoption-layout">
            <aside class="sidebar-card fade-up">
                <h3>Select a Pet</h3>
                <div class="filter-list">
                    <button class="filter-item active" data-filter="all">
                        <span>🐾</span><span>All Animals</span>
                    </button>
                    <button class="filter-item" data-filter="dog">
                        <img src="../Images/adapt/dog.png" alt="Dog Icon"><span>Dogs</span>
                    </button>
                    <button class="filter-item" data-filter="cat">
                        <img src="../Images/adapt/cat.png" alt="Cat Icon"><span>Cats</span>
                    </button>
                    <button class="filter-item" data-filter="rabbit">
                        <img src="../Images/adapt/rubit.png" alt="Rabbit Icon"><span>Rabbits</span>
                    </button>
                    <button class="filter-item" data-filter="bird">
                        <img src="../Images/adapt/bird.png" alt="Bird Icon"><span>Birds</span>
                    </button>
                    <button class="filter-item" data-filter="snake">
                        <img src="../Images/adapt/snake.png" alt="Snake Icon"><span>Snakes</span>
                    </button>
                    <button class="filter-item" data-filter="hamster">
                        <img src="../Images/adapt/hamester.png" alt="Hamster Icon"><span>Hamsters</span>
                    </button>
                </div>
                <div class="snake-decor">
                    <img src="../Images/adapt/snakrock.png" alt="Snake Decoration">
                </div>
            </aside>

            <section class="content-card fade-up">
                <div class="section-title-row">
                    <div class="section-title-wrap">
                        <span>🐾</span>
                        <h2>Available Pets</h2>
                    </div>
                    <span class="tiny-dots">···</span>
                </div>

                <div class="search-row">
                    <div class="search-box">
                        <span>🔍</span>
                        <input type="text" id="petSearch" placeholder="Search by name, breed, size, or temperament...">
                    </div>
                </div>

                <div id="petsGrid" class="pet-list">

                    @if (!Model.Posts.Any())
                    {
                        <div class="empty-state">
                            <h3>No pets available</h3>
                            <p>Check back soon for new listings.</p>
                        </div>
                    }

                    @foreach (var pet in Model.Posts)
                    {
                        var alreadyKey = "FlagError_" + pet.Id;
                        var isAlready = TempData[alreadyKey]?.ToString() == "already";
                        var isLoggedIn = Context.Session.GetInt32("UserId") != null;

                        <article class="pet-item" data-type="@pet.Type">

                            @* ── Carousel ── *@
                            <div class="pet-thumb"
                                 data-count="@pet.Images.Count"
                                 data-current="0">
                                @for (int i = 0; i < pet.Images.Count; i++)
                                {
                                    <img src="@pet.Images[i]"
                                         alt="@pet.Name @(i + 1)"
                                         class="@(i == 0 ? "car-active" : "")" />
                                }
                                @if (pet.Images.Count > 1)
                                {
                                    <span class="photo-counter">1 / @pet.Images.Count</span>
                                    <button class="car-btn prev" type="button"
                                            onclick="carMove(this,-1)" aria-label="Previous">
                                        ‹
                                    </button>
                                    <button class="car-btn next" type="button"
                                            onclick="carMove(this, 1)" aria-label="Next">
                                        ›
                                    </button>
                                    <div class="car-dots">
                                        @for (int i = 0; i < pet.Images.Count; i++)
                                        {
                                            <button class="car-dot @(i == 0 ? "active" : "")"
                                                    type="button"
                                                    onclick="carGoTo(this, @i)"
                                                    aria-label="Photo @(i + 1)"></button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="pet-info">
                                <h3>@pet.Name</h3>
                                @if (!string.IsNullOrEmpty(pet.Breed))
                                {
                                    <p><strong>Breed:</strong> @pet.Breed</p>
                                }
                                <p><strong>Age:</strong> @pet.Age</p>
                                <p><strong>Gender:</strong> @pet.Gender</p>
                                <p><strong>City:</strong> 📍 @pet.City @(!string.IsNullOrEmpty(pet.Area) ? $"- {pet.Area}" : "")</p>
                                <p><strong>Temperament:</strong> @pet.Temperament</p>
                                <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.5rem">
                                    <span style="background:#e8f5e9;color:#2e7d32;padding:.2rem .6rem;border-radius:20px;font-size:.75rem;font-weight:700">
                                        @pet.Vaccinations[0]
                                    </span>
                                    @if (pet.IsNeutered)
                                    {
                                        <span style="background:#e3f2fd;color:#1565c0;padding:.2rem .6rem;border-radius:20px;font-size:.75rem;font-weight:700">✂️ Neutered</span>
                                    }
                                    @if (pet.GoodWithChildren)
                                    {
                                        <span style="background:#fff3e0;color:#e65100;padding:.2rem .6rem;border-radius:20px;font-size:.75rem;font-weight:700">👶 Kid-friendly</span>
                                    }
                                    @if (pet.GoodWithPets)
                                    {
                                        <span style="background:#f3e5f5;color:#6a1b9a;padding:.2rem .6rem;border-radius:20px;font-size:.75rem;font-weight:700">🐾 Pet-friendly</span>
                                    }
                                </div>
                            </div>

                            <div class="pet-actions">
                                <div class="like-wrap">
                                    <button class="like-btn @(pet.IsLikedByCurrentUser ? "active" : "")"
                                            data-like="@pet.Id">
                                        ❤
                                    </button>
                                    <span class="likes-count">
                                        <span id="likes-@pet.Id">@pet.Likes</span> likes
                                    </span>
                                </div>
                                <button class="olive-btn"
                                        onclick="openReserveModal(@pet.Id, '@pet.Name')">
                                    Reserve
                                </button>
                                <button class="olive-btn secondary-btn"
                                        data-details="@pet.Id"
                                        data-name="@pet.Name"
                                        data-breed="@pet.Breed"
                                        data-age="@pet.Age"
                                        data-gender="@pet.Gender"
                                        data-city="@pet.City"
                                        data-area="@pet.Area"
                                        data-color="@pet.Color"
                                        data-temperament="@pet.Temperament"
                                        data-health="@pet.Health"
                                        data-description="@pet.Description"
                                        data-phone="@pet.ContactPhone"
                                        data-contact="@pet.ContactName"
                                        data-vacc="@pet.Vaccinations[0]"
                                        data-image="@pet.Image"
                                        data-images="@string.Join("|", pet.Images)"
                                        data-code="@pet.PostCode">
                                    View Details
                                </button>

                                @* ── Report Section ── *@
                                @if (isLoggedIn)
                                {
                                    <div class="report-wrap">
                                        @if (isAlready)
                                        {
                                            <span class="report-already">🚩 Already reported</span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="report-toggle-btn"
                                                    onclick="openFlagModal(@pet.Id)">
                                                🚩 Report
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                        </article>
                    }

                </div>
            </section>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a><span>|</span>
            <a href="about.html">Contact</a><span>|</span>
            <a href="faq.html">FAQ</a><span>|</span>
            <div class="social-inline"><span>f</span><span>🐦</span><span>◎</span></div>
        </div>
        <div>© 2026 Waffy, All rights reserved.</div>
    </footer>

    @* ── Details Modal ── *@
    <div id="detailsModal" class="modal hidden">
        <div class="modal-overlay" data-close-modal></div>
        <div class="modal-card">
            <button class="modal-close" data-close-modal>&times;</button>
            <div id="modalContent"></div>
        </div>
    </div>

    @* ── Reserve Modal ── *@
    <div id="reserveModal" class="modal hidden">
        <div class="modal-overlay" onclick="closeReserveModal()"></div>
        <div class="modal-card" style="max-width:460px">
            <button class="modal-close" onclick="closeReserveModal()">&times;</button>
            <h3 style="font-family:'Fredoka',sans-serif;color:#59652a;margin-bottom:1rem">
                🐾 Reserve <span id="reservePetName"></span>
            </h3>
            <form method="post" asp-controller="Reservation" asp-action="Reserve">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" id="reservePostId" />
                <div class="field" style="margin-bottom:1rem">
                    <label>Message to owner (optional)</label>
                    <textarea name="message" rows="3" placeholder="Tell the owner about yourself..."></textarea>
                </div>
                <div style="display:flex;gap:.5rem;justify-content:flex-end">
                    <button type="button" onclick="closeReserveModal()" class="olive-btn secondary-btn">Cancel</button>
                    <button type="submit" class="olive-btn">Send Request 🐾</button>
                </div>
            </form>
        </div>
    </div>

    @* ── Flag Modal ── *@
    <div id="flagModal" class="flag-modal-overlay">
        <div class="flag-modal-box">
            <div class="flag-modal-head">
                <div class="flag-modal-title">🚩 Report Post</div>
                <button class="flag-modal-close"
                        onclick="closeFlagModal()"
                        type="button">
                    ✕
                </button>
            </div>
            <div class="flag-modal-body">
                <p class="flag-modal-note">
                    Help us keep Waffy safe and honest.<br>
                    Select a reason and we'll review it promptly.
                </p>
                <form method="post"
                      asp-controller="Pet"
                      asp-action="FlagPost"
                      id="flagForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" id="flagPostId" />
                    <select name="reason" class="flag-modal-select">
                        <option value="Selling instead of adoption">💰 Selling instead of adoption</option>
                        <option value="Fake listing">🤥 Fake or misleading listing</option>
                        <option value="Inappropriate content">⚠️ Inappropriate content</option>
                        <option value="Other">📝 Other</option>
                    </select>
                    <div class="flag-modal-footer">
                        <button type="button"
                                onclick="closeFlagModal()"
                                style="background:none;border:1.5px solid #e5e7eb;
                                       color:#6b7280;padding:8px 18px;border-radius:10px;
                                       font-weight:800;font-size:.82rem;
                                       font-family:'Nunito',sans-serif;cursor:pointer;">
                            Cancel
                        </button>
                        <button type="submit"
                                style="background:#dc2626;color:#fff;border:none;
                                       padding:8px 22px;border-radius:10px;
                                       font-weight:900;font-size:.84rem;
                                       font-family:'Nunito',sans-serif;cursor:pointer;
                                       transition:.18s;"
                                onmouseover="this.style.background='#b91c1c'"
                                onmouseout="this.style.background='#dc2626'">
                            🚩 Submit Report
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="toast" class="toast"></div>

    <script src="~/js/adaptjs.js"></script>
    <script>
        // ── Carousel ──
        function carMove(btn, dir) {
            const thumb = btn.closest('.pet-thumb');
            carGoToIndex(thumb, parseInt(thumb.dataset.current) + dir);
        }
        function carGoTo(dot, idx) {
            const thumb = dot.closest('.pet-thumb');
            carGoToIndex(thumb, idx);
        }
        function carGoToIndex(thumb, idx) {
            const imgs    = thumb.querySelectorAll('img');
            const dots    = thumb.querySelectorAll('.car-dot');
            const counter = thumb.querySelector('.photo-counter');
            const count   = imgs.length;
            if (count <= 1) return;
            idx = ((idx % count) + count) % count;
            imgs.forEach((img, i) => img.classList.toggle('car-active', i === idx));
            dots.forEach((d,   i) => d.classList.toggle('active',      i === idx));
            if (counter) counter.textContent = `${idx + 1} / ${count}`;
            thumb.dataset.current = idx;
        }

        // ── Flag Modal ──
        function openFlagModal(postId) {
            document.getElementById('flagPostId').value = postId;
            document.getElementById('flagModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeFlagModal() {
            document.getElementById('flagModal').classList.remove('open');
            document.body.style.overflow = '';
        }

        // إغلاق عند الضغط خارج الـ Modal
        document.getElementById('flagModal').addEventListener('click', function(e) {
            if (e.target === this) closeFlagModal();
        });

        // إغلاق بـ Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeFlagModal();
        });

        // ── Auto-hide flag toast ──
        const flagToast = document.querySelector('.flag-toast');
        if (flagToast) setTimeout(() => flagToast.style.display = 'none', 4000);
    </script>
</body>
</html>
