@model Waffy.Models.ViewModels.AdoptionPageViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Adoption - Waffy</title>

    <link rel="stylesheet" href="~/css/adaptstyle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body data-logged-in="@(Context.Session.GetInt32("UserId").HasValue ? "true" : "false")">
    @Html.AntiForgeryToken()
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">

                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>

                        </div>

                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">



                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services
                                        <span class="dropdown-arrow">▼</span>
                                    </button>

                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>

                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>

                            </div>

                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>

                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>

                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>

                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>

                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>

                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>

                                        <div class="mobile-services-menu" id="mobileServicesMenu">

                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>

                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container adoption-page">
        <section class="hero-section fade-up">
            <h1>Find Your Perfect Pet to Adopt!</h1>
            <p>
                Browse through our list of adorable pets looking for loving homes.
                Use the filters and search to explore different animal types, like your favorites,
                and reserve the one that steals your heart.
            </p>
        </section>

        <section class="adoption-layout">
            <aside class="sidebar-card fade-up">
                <h3>Select a Pet</h3>

                <div class="filter-list">
                    <button class="filter-item active" data-filter="all">
                        <span>🐾</span>
                        <span>All Animals</span>
                    </button>

                    <button class="filter-item" data-filter="dog">
                        <img src="../Images/adapt/dog.png" alt="Dog Icon">
                        <span>Dogs</span>
                    </button>

                    <button class="filter-item" data-filter="cat">
                        <img src="../Images/adapt/cat.png" alt="Cat Icon">
                        <span>Cats</span>
                    </button>

                    <button class="filter-item" data-filter="rabbit">
                        <img src="../Images/adapt/rubit.png" alt="Rabbit Icon">
                        <span>Rabbits</span>
                    </button>

                    <button class="filter-item" data-filter="bird">
                        <img src="../Images/adapt/bird.png" alt="Bird Icon">
                        <span>Birds</span>
                    </button>

                    <button class="filter-item" data-filter="snake">
                        <img src="../Images/adapt/snake.png" alt="Snake Icon">
                        <span>Snakes</span>
                    </button>

                    <button class="filter-item" data-filter="hamster">
                        <img src="../Images/adapt/hamester.png" alt="Hamster Icon">
                        <span>Hamsters</span>
                    </button>
                </div>

                <div class="snake-decor">
                    <img src="../Images/adapt/snakrock.png" alt="Snake Decoration">
                </div>
            </aside>

            <section class="content-card fade-up">
                <div class="section-title-row">
                    <div class="section-title-wrap">
                        <span>🐾</span>
                        <h2>Available Pets</h2>
                    </div>
                    <span class="tiny-dots">···</span>
                </div>

                <div class="search-row">
                    <div class="search-box">
                        <span>🔍</span>
                        <input type="text" id="petSearch" placeholder="Search by name, breed, size, or temperament...">
                    </div>
                </div>

                <div id="petsGrid" class="pet-list">

                    @if (!Model.Posts.Any())
                    {
                        <div class="empty-state">
                            <h3>No pets available</h3>
                            <p>Check back soon for new listings.</p>
                        </div>
                    }

                    @foreach (var pet in Model.Posts)
                    {
                        <article class="pet-item" data-type="@pet.Type">

                            <div class="pet-thumb">
                                <img src="@(string.IsNullOrEmpty(pet.Image)
                                                                 ? "../Images/adapt/golden.png"
                                                                 : pet.Image)"
                                 alt="@pet.Name">
                        </div>

                            <div class="pet-info">
                                <h3>@pet.Name</h3>

                            @if (!string.IsNullOrEmpty(pet.Breed))
                                {
                                    <p><strong>Breed:</strong> @pet.Breed</p>
                                }

                                <p><strong>Age:</strong> @pet.Age</p>
                                <p><strong>Gender:</strong> @pet.Gender</p>
                                <p><strong>City:</strong> 📍 @pet.City @(!string.IsNullOrEmpty(pet.Area) ? $"- {pet.Area}" : "")</p>
                                <p><strong>Temperament:</strong> @pet.Temperament</p>

                                <div style="display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.5rem">
                                    <span style="background:#e8f5e9;color:#2e7d32;
                                     padding:.2rem .6rem;border-radius:20px;
                                     font-size:.75rem;font-weight:700">
                                        @pet.Vaccinations[0]
                                    </span>
                                    @if (pet.IsNeutered)
                                    {
                                        <span style="background:#e3f2fd;color:#1565c0;
                                             padding:.2rem .6rem;border-radius:20px;
                                             font-size:.75rem;font-weight:700">
                                            ✂️ Neutered
                                        </span>
                                    }
                                    @if (pet.GoodWithChildren)
                                    {
                                        <span style="background:#fff3e0;color:#e65100;
                                             padding:.2rem .6rem;border-radius:20px;
                                             font-size:.75rem;font-weight:700">
                                            👶 Kid-friendly
                                        </span>
                                    }
                                    @if (pet.GoodWithPets)
                                    {
                                        <span style="background:#f3e5f5;color:#6a1b9a;
                                             padding:.2rem .6rem;border-radius:20px;
                                             font-size:.75rem;font-weight:700">
                                            🐾 Pet-friendly
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="pet-actions">
                                <div class="like-wrap">
                                    <button class="like-btn @(pet.IsLikedByCurrentUser ? "active" : "")"
                                            data-like="@pet.Id">
                                        ❤
                                    </button>
                                    <span class="likes-count">
                                        <span id="likes-@pet.Id">@pet.Likes</span> likes
                                    </span>
                                </div>
                                <button class="olive-btn"
                                        onclick="openReserveModal(@pet.Id, '@pet.Name')">
                                    Reserve
                                </button>
                                <button class="olive-btn secondary-btn"
                                        data-details="@pet.Id"
                                        data-name="@pet.Name"
                                        data-breed="@pet.Breed"
                                        data-age="@pet.Age"
                                        data-gender="@pet.Gender"
                                        data-city="@pet.City"
                                        data-area="@pet.Area"
                                        data-color="@pet.Color"
                                        data-temperament="@pet.Temperament"
                                        data-health="@pet.Health"
                                        data-description="@pet.Description"
                                        data-phone="@pet.ContactPhone"
                                        data-contact="@pet.ContactName"
                                        data-vacc="@pet.Vaccinations[0]"
                                        data-image="@pet.Image"
                                        data-code="@pet.PostCode">
                                    View Details
                                </button>
                            </div>

                        </article>
                    }

                </div>
            </section>
        </section>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a>
            <span>|</span>
            <a href="about.html">Contact</a>
            <span>|</span>
            <a href="faq.html">FAQ</a>
            <span>|</span>
            <div class="social-inline">
                <span>f</span>
                <span>🐦</span>
                <span>◎</span>
            </div>
        </div>
        <div>© 2026 Waffy, All rights reserved.</div>
    </footer>

    <div id="detailsModal" class="modal hidden">
        <div class="modal-overlay" data-close-modal></div>

        <div class="modal-card">
            <button class="modal-close" data-close-modal>&times;</button>
            <div id="modalContent"></div>
        </div>
    </div>

    <div id="toast" class="toast"></div>
   
    <div id="reserveModal" class="modal hidden">
        <div class="modal-overlay" onclick="closeReserveModal()"></div>
        <div class="modal-card" style="max-width:460px">
            <button class="modal-close" onclick="closeReserveModal()">&times;</button>
            <h3 style="font-family:'Fredoka',sans-serif;color:#59652a;margin-bottom:1rem">
                🐾 Reserve <span id="reservePetName"></span>
            </h3>
            <form method="post" asp-controller="Reservation" asp-action="Reserve">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" id="reservePostId" />
                <div class="field" style="margin-bottom:1rem">
                    <label>Message to owner (optional)</label>
                    <textarea name="message" rows="3"
                              placeholder="Tell the owner about yourself..."></textarea>
                </div>
                <div style="display:flex;gap:.5rem;justify-content:flex-end">
                    <button type="button" onclick="closeReserveModal()"
                            class="olive-btn secondary-btn">
                        Cancel
                    </button>
                    <button type="submit" class="olive-btn">Send Request 🐾</button>
                </div>
            </form>
        </div>
    </div>


    <script src="~/js/adaptjs.js"></script>
</body>
</html>