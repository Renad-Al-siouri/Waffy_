@*
    ═══════════════════════════════════════════════════════
    Waffy — Unified Shared Layout
    File path: Views/Shared/_Layout.cshtml

    HOW TO USE IN ANY PAGE:
    1. Remove  @{ Layout = null; }  from the top of the view
    2. Remove the <header> and <footer> blocks from the view
    3. Add @section Styles { <link rel="stylesheet" href="~/css/your-page.css"> }
    4. Add @section Scripts { <script src="..."></script> } if needed
    ═══════════════════════════════════════════════════════
*@
@{
    bool isAuth = User.Identity?.IsAuthenticated ?? false;

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    Func<string, string, string> Active = (c, a) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (a == "*" || string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
        ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " - Waffy" : "Waffy")</title>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/shared.css" />

    @RenderSection("Styles", required: false)
</head>
<body>

    @*
        NAVBAR
        Default   → sticky  (كل الصفحات الداخلية)
        Transparent → absolute فوق الهيرو  (Home_Before فقط)
        للتفعيل أضف في أعلى الصفحة: @{ ViewBag.NavbarTransparent = true; }
    *@
    <header class="topbar @(ViewBag.NavbarTransparent == true ? "topbar--transparent" : "")">
        <div class="header-shell">
            <nav class="navbar">

                <!-- LEFT NAV (desktop) -->
                <div class="left-nav desktop-nav">
                    @if (isAuth)
                    {
                        <a asp-controller="Home" asp-action="Home_After" class="nav-link @Active("Home", "Home_After")">Home</a>
                        <a asp-controller="Clinic" asp-action="Clinics" class="nav-link @Active("Clinic", "*")">Clinics</a>
                        <a asp-controller="Product" asp-action="Stores" class="nav-link @Active("Product", "*")">Stores</a>
                        <a asp-controller="Pet" asp-action="Adapt" class="nav-link @Active("Pet", "Adapt")">Adoption</a>
                        <a asp-controller="Pet" asp-action="Lost" class="nav-link @Active("Pet", "Lost")">Lost Pets</a>
                    }
                    else
                    {
                        <a asp-controller="Home" asp-action="Home_Before" class="nav-link @Active("Home", "Home_Before")">Home</a>
                        <a asp-controller="Clinic" asp-action="Clinics" class="nav-link @Active("Clinic", "*")">Clinics</a>
                        <a asp-controller="Product" asp-action="Stores" class="nav-link @Active("Product", "*")">Stores</a>
                        <a asp-controller="Pet" asp-action="Adapt" class="nav-link @Active("Pet", "Adapt")">Adoption</a>
                    }
                </div>

                <!-- LOGO CENTER -->
                <div class="logo-center">
                    <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                </div>

                <!-- RIGHT NAV (desktop) -->
                <div class="right-nav desktop-nav">

                    @if (!isAuth)
                    {
                        <a asp-controller="Pet" asp-action="Lost" class="nav-link @Active("Pet", "Lost")">Lost Pets</a>
                        <a asp-controller="Map" asp-action="Gps" class="nav-link @Active("Map", "Gps")">Map</a>
                    }

                    <!-- Services Dropdown -->
                    <div class="services-dropdown" id="servicesDropdown">
                        <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                            Services <span class="dropdown-arrow">&#9660;</span>
                        </button>
                        <div class="dropdown-menu" id="servicesMenu">
                            <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                            <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                        </div>
                    </div>

                    <a asp-controller="Home" asp-action="About" class="nav-link @Active("Home", "About")">About Us</a>

                    @if (isAuth)
                    {
                        <div class="nav-actions">
                            <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                <i class="fa-solid fa-cart-shopping"></i>
                            </a>
                            <a asp-controller="Home" asp-action="Notifications" class="nav-icon" aria-label="Notifications">
                                <i class="fa-solid fa-bell"></i>
                            </a>
                            <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                <img src="~/Images/user.jpg" alt="Profile">
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="nav-link login-btn">Login</a>
                    }
                </div>

                <!-- MOBILE HAMBURGER + DRAWER -->
                <div class="mobile-nav-wrap">
                    <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">&#9776;</button>

                    <div class="nav-links" id="navLinks">
                        <div class="mobile-menu-logo">
                            <img src="~/Images/logo.png" alt="Waffy Logo">
                        </div>

                        @if (isAuth)
                        {
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link @Active("Home", "Home_After")">Home</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Home_Before" class="nav-link @Active("Home", "Home_Before")">Home</a>
                        }

                        <a asp-controller="Clinic" asp-action="Clinics" class="nav-link @Active("Clinic", "*")">Clinics</a>
                        <a asp-controller="Product" asp-action="Stores" class="nav-link @Active("Product", "*")">Stores</a>
                        <a asp-controller="Pet" asp-action="Adapt" class="nav-link @Active("Pet", "Adapt")">Adoption</a>
                        <a asp-controller="Pet" asp-action="Lost" class="nav-link @Active("Pet", "Lost")">Lost Pets</a>
                        <a asp-controller="Map" asp-action="Gps" class="nav-link @Active("Map", "Gps")">Map</a>

                        <div class="mobile-services-block" id="mobileServicesBlock">
                            <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                <span>Services</span>
                                <span class="dropdown-arrow">&#9660;</span>
                            </button>
                            <div class="mobile-services-menu" id="mobileServicesMenu">
                                <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                            </div>
                        </div>

                        <a asp-controller="Home" asp-action="About" class="nav-link @Active("Home", "About")">About Us</a>

                        @if (isAuth)
                        {
                            <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-link login-btn">Login</a>
                        }
                    </div>
                </div>

            </nav>
        </div>
    </header>

    @RenderBody()

    <!-- FOOTER -->
    <div class="footer-wrap">
        <footer class="footer">
            <div class="footer-grid">

                <div class="footer-col footer-brand-col">
                    <div class="footer-brand">
                        <img src="~/Images/logo.png" alt="Waffy Logo">
                        <div class="footer-contact">
                            <h4>Contact Info</h4>
                            <p>+224 556 8939</p>
                            <p>email@waffy.com</p>
                            <p>Pet Street, Amman, Jordan</p>
                        </div>
                    </div>
                </div>

                <div class="footer-col footer-links-col">
                    <div class="footer-links-columns">
                        <div>
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a asp-controller="Product" asp-action="Stores">Shop</a></li>
                                <li><a asp-controller="Clinic" asp-action="Clinics">Clinics</a></li>
                                <li><a asp-controller="Map" asp-action="Gps">Map</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4>Explore</h4>
                            <ul>
                                <li><a asp-controller="Pet" asp-action="Adapt">Adoption</a></li>
                                <li><a asp-controller="Home" asp-action="About">About</a></li>
                                <li><a asp-controller="Home" asp-action="Faq">FAQ</a></li>
                                <li><a asp-controller="Home" asp-action="Suport">Support</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="footer-col footer-social-col">
                    <div class="socials">
                        <a href="#" aria-label="Facebook">f</a>
                        <a href="#" aria-label="Twitter">t</a>
                        <a href="#" aria-label="Instagram">i</a>
                    </div>
                    <div class="copy">Copyright &copy; 2026 Waffy. All rights reserved.</div>
                </div>

            </div>
        </footer>
    </div>

    <script src="~/js/shared-navbar.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
