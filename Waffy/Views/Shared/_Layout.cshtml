<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Waffy</title>

    @* CSS خاص بكل صفحة *@
    @RenderSection("Styles", required: false)

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    @* ── Navbar الموحد ── *@
    @await Html.PartialAsync("_Navbar")

    @* ── محتوى كل صفحة يُحقن هنا ── *@
    @RenderBody()

    @* ── Footer الموحد ── *@
    <div class="footer-wrap" id="contact">
        <footer class="footer">
            <div class="footer-grid">
                <div class="footer-col footer-brand-col">
                    <div class="footer-brand">
                        <img src="~/Images/logo.png" alt="Footer Logo">
                        <div class="footer-contact">
                            <h4>Contact Info</h4>
                            <p>+224 556 8939</p>
                            <p>email@waffy.com</p>
                            <p>Pet Street, Amman, Jordan</p>
                        </div>
                    </div>
                </div>

                <div class="footer-col footer-links-col">
                    <div class="footer-links-columns">
                        <div>
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a asp-controller="Product" asp-action="Stores">Shop</a></li>
                                <li><a asp-controller="Clinic" asp-action="Clinics">Clinics</a></li>
                                <li><a asp-controller="Map" asp-action="Gps">Map</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4>Explore</h4>
                            <ul>
                                <li><a asp-controller="Pet" asp-action="Adapt">Adoption</a></li>
                                <li><a asp-controller="Home" asp-action="About">About</a></li>
                                <li><a asp-controller="Home" asp-action="Faq">FAQ</a></li>
                                <li><a asp-controller="Home" asp-action="Suport">Support</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="footer-col footer-social-col">
                    <div class="socials">
                        <a href="#">f</a>
                        <a href="#">t</a>
                        <a href="#">i</a>
                    </div>
                    <div class="copy">Copyright © 2026 Waffy. All rights reserved.</div>
                </div>
            </div>
        </footer>
    </div>

    @* JS مشترك *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    @* JS خاص بكل صفحة *@
    @RenderSection("Scripts", required: false)

</body>
</html>
