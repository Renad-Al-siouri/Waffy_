@* ══ JavaScript — مغلّف بـ DOMContentLoaded لضمان جاهزية الـ DOM ══ *@
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var menuBtn              = document.getElementById("menuBtn");
        var navLinks             = document.getElementById("navLinks");
        var servicesToggle       = document.getElementById("servicesToggle");
        var servicesDropdown     = document.getElementById("servicesDropdown");
        var mobileServicesToggle = document.getElementById("mobileServicesToggle");
        var mobileServicesBlock  = document.getElementById("mobileServicesBlock");

        if (menuBtn && navLinks) {
            menuBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                navLinks.classList.toggle("open");
            });
        }

        if (servicesToggle && servicesDropdown) {
            servicesToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                servicesDropdown.classList.toggle("open");
            });
        }

        if (mobileServicesToggle && mobileServicesBlock) {
            mobileServicesToggle.addEventListener("click", function (e) {
                e.stopPropagation();
                mobileServicesBlock.classList.toggle("open");
            });
        }

        document.querySelectorAll(".nav-links .nav-link, .nav-links .dropdown-link").forEach(function (link) {
            link.addEventListener("click", function () {
                if (window.innerWidth <= 1188) {
                    if (navLinks)            navLinks.classList.remove("open");
                    if (mobileServicesBlock) mobileServicesBlock.classList.remove("open");
                }
            });
        });

        document.addEventListener("click", function (e) {
            if (servicesDropdown && !servicesDropdown.contains(e.target)) {
                servicesDropdown.classList.remove("open");
            }
            if (navLinks && menuBtn &&
                !navLinks.contains(e.target) && !menuBtn.contains(e.target)) {
                navLinks.classList.remove("open");
                if (mobileServicesBlock) mobileServicesBlock.classList.remove("open");
            }
        });

        window.addEventListener("resize", function () {
            if (window.innerWidth > 1188) {
                if (navLinks)            navLinks.classList.remove("open");
                if (mobileServicesBlock) mobileServicesBlock.classList.remove("open");
            }
        });
    });
</script>

@* ══ Back Button Protection — يمنع العودة بعد Logout ══ *@
@if (isLoggedIn)
{
    <script>
        // حماية صفحات ما بعد الدخول من زر Back بعد Logout
        (function () {
            // نضع علامة في sessionStorage تثبت أن المستخدم شاف هذه الصفحة وهو مسجل دخول
            sessionStorage.setItem("wasLoggedIn", "true");

            // عند ظهور الصفحة من الـ cache (bfcache) نتحقق من الـ Session
            window.addEventListener("pageshow", function (e) {
                if (e.persisted) {
                    // الصفحة جاءت من bfcache — تحقق من الـ server
                    fetch("/Account/CheckSession", { cache: "no-store" })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (!data.loggedIn) {
                                // Session انتهت — أعد توجيهه لـ Login
                                window.location.replace("/Account/Login");
                            }
                        })
                        .catch(function () {
                            window.location.replace("/Account/Login");
                        });
                }
            });
        })();
    </script>
}
