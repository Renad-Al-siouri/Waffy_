@{
    var userId = Context.Session.GetInt32("UserId");
    var isLoggedIn = userId != null;

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string Nav(string c, string a)
        => (ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) &&
            action.Equals(a, StringComparison.OrdinalIgnoreCase))
           ? "nav-link active" : "nav-link";

    string NavC(string c)
        => ctrl.Equals(c, StringComparison.OrdinalIgnoreCase)
           ? "nav-link active" : "nav-link";
}

