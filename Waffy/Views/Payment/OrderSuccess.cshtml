@{
    Layout = null;
    ViewData["Title"] = "Order Confirmed - Waffy";

    var cliqCode = ViewBag.CliQCode as string;
    var cliqNumber = ViewBag.CliQNumber as string;
    var isCliQ = !string.IsNullOrEmpty(cliqCode);
    var isWallet = ViewBag.PaymentMethod as string == "Wallet";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/check.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg,#f0f7e6 0%,#e8f0d8 100%);
            min-height: 100vh;
        }

        .success-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .success-card {
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0,0,0,.1);
            padding: 36px 32px;
            max-width: 520px;
            width: 100%;
            text-align: center;
        }

        .success-logo {
            width: 70px;
            margin-bottom: 12px;
        }

        .success-card h3 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.5rem;
            color: #2e7d32;
            margin-bottom: 6px;
        }

        .success-card > p {
            font-size: .88rem;
            color: #666;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        /* Order code box */
        .order-code-box {
            background: #e8f0d8;
            border-radius: 14px;
            padding: 14px;
            margin-bottom: 20px;
            font-family: 'Fredoka', sans-serif;
        }

            .order-code-box .label {
                font-size: .75rem;
                color: #7a9a60;
                font-weight: 700;
            }

            .order-code-box .code {
                font-size: 1.3rem;
                color: #3a5e1f;
                letter-spacing: 1px;
                font-weight: 700;
            }

            .order-code-box .total {
                font-size: .88rem;
                color: #5a7a2f;
                font-weight: 700;
                margin-top: 4px;
            }

        /* Wallet success */
        .wallet-success-box {
            background: #ede7f6;
            border: 2px solid #b39ddb;
            border-radius: 16px;
            padding: 18px;
            margin-bottom: 20px;
            text-align: center;
        }

        /* CliQ box */
        .cliq-box {
            background: #fff8e1;
            border: 2px solid #ffb74d;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            text-align: left;
        }

            .cliq-box .cliq-title {
                font-weight: 800;
                font-size: .95rem;
                color: #e65100;
                margin-bottom: 14px;
                text-align: center;
            }

        .cliq-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .cliq-info-cell {
            background: #fff;
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #ffe0b2;
            text-align: center;
        }

            .cliq-info-cell .cell-label {
                font-size: .68rem;
                color: #888;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .cliq-info-cell .cell-val {
                font-weight: 900;
                color: #bf360c;
            }

                .cliq-info-cell .cell-val.code {
                    font-size: 1.6rem;
                    letter-spacing: 6px;
                    font-family: 'Courier New', monospace;
                }

                .cliq-info-cell .cell-val.number {
                    font-size: 1.1rem;
                    color: #1b5e20;
                }

        .cliq-warning {
            background: #fdecea;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: .78rem;
            color: #c62828;
            font-weight: 700;
            margin-bottom: 14px;
            line-height: 1.6;
        }

        .cliq-steps {
            font-size: .8rem;
            color: #e65100;
            line-height: 1.8;
            margin-bottom: 14px;
        }

        /* زر تم الدفع */
        .btn-paid {
            width: 100%;
            background: linear-gradient(135deg,#2e7d32,#43a047);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-size: .92rem;
            font-weight: 800;
            cursor: pointer;
            transition: .2s;
            font-family: 'Nunito', sans-serif;
        }

            .btn-paid:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(46,125,50,.3);
            }

            .btn-paid:active {
                transform: translateY(0);
            }

            .btn-paid:disabled {
                opacity: .5;
                cursor: not-allowed;
                transform: none;
            }

        .btn-paid-done {
            background: linear-gradient(135deg,#1565c0,#1976d2) !important;
        }

        /* Nav buttons */
        .nav-btn-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 16px;
        }

        .nav-btn {
            display: block;
            text-align: center;
            padding: 12px;
            border-radius: 12px;
            font-weight: 800;
            font-size: .86rem;
            text-decoration: none;
            transition: .2s;
        }

            .nav-btn.primary {
                background: #6a9b3b;
                color: #fff;
            }

                .nav-btn.primary:hover {
                    background: #5a8a2b;
                }

            .nav-btn.secondary {
                background: #f5f5f5;
                color: #555;
            }

                .nav-btn.secondary:hover {
                    background: #ebebeb;
                }
    </style>
</head>
<body>
    <div class="success-wrap">
        <div class="success-card">

            <!-- Logo + Title -->
            @if (!isCliQ)
            {
                <div style="font-size:3.5rem;margin-bottom:8px">✅</div>
            }
            else
            {
                <div style="font-size:3.5rem;margin-bottom:8px">📱</div>
            }
            <img src="~/Images/logo.png" alt="Waffy Logo" class="success-logo" />
            <h3>
                @if (isWallet)
                {
                    <text>Payment Deducted!</text>
                }
                else if (isCliQ)
                {

                    <text>Order Placed — Pay via CliQ</text>
                }
                else
                {

                    <text>Order Confirmed!</text>
                }
            </h3>
            <p>
                Thank you for your order from <strong>@ViewBag.StoreName</strong>.
                @if (isWallet)
                {
                    <text>Your wallet has been charged and the store will prepare your order shortly.</text>
                }
                else if (isCliQ)
                {
                    <text>Please complete your CliQ payment using the details below.</text>
                }
                else
                {
                    <text>Your order has been received. Pay when your delivery arrives.</text>
                }
            </p>

            <!-- Order Code -->
            <div class="order-code-box">
                <div class="label">Order Code</div>
                <div class="code">@ViewBag.OrderCode</div>
                <div class="total">Total: @ViewBag.OrderTotal JD</div>
            </div>

            <!-- ══ Wallet Success ══ -->
            @if (isWallet)
            {
                <div class="wallet-success-box">
                    <div style="font-size:2rem;margin-bottom:6px">👛</div>
                    <div style="font-weight:900;font-size:.95rem;color:#4527a0;margin-bottom:4px">
                        Wallet Payment Successful
                    </div>
                    <div style="font-size:.82rem;color:#512da8">
                        <strong>@ViewBag.OrderTotal JD</strong> deducted from your Waffy Wallet.
                        Your order is confirmed and the store will start preparing it now.
                    </div>
                </div>
            }

            <!-- ══ CliQ Payment Section ══ -->
            @if (isCliQ)
            {
                <div class="cliq-box" id="cliqBox">
                    <div class="cliq-title">📱 Complete Your CliQ Payment</div>

                    <div class="cliq-info-grid">
                        <div class="cliq-info-cell">
                            <div class="cell-label">Store CliQ Number</div>
                            <div class="cell-val number">@(string.IsNullOrEmpty(cliqNumber) ? "Contact store" : cliqNumber)</div>
                        </div>
                        <div class="cliq-info-cell">
                            <div class="cell-label">Amount to Send</div>
                            <div class="cell-val number" style="color:#1b5e20">@ViewBag.OrderTotal JD</div>
                        </div>
                        <div class="cliq-info-cell" style="grid-column:1/-1">
                            <div class="cell-label">⭐ Your Verification Code (write in CliQ message)</div>
                            <div class="cell-val code">@cliqCode</div>
                        </div>
                    </div>

                    <div class="cliq-warning">
                        ⚠️ You MUST write the code <strong>@cliqCode</strong> in your CliQ transfer message/note.
                        The store will search for this exact code to verify your payment.
                        Without it, your order will not be processed.
                    </div>

                    <div class="cliq-steps">
                        1️⃣ &nbsp;Open your CliQ app<br>
                        2️⃣ &nbsp;Send <strong>@ViewBag.OrderTotal JD</strong> to <strong>@(string.IsNullOrEmpty(cliqNumber) ? "store CliQ number" : cliqNumber)</strong><br>
                        3️⃣ &nbsp;In the message/note field write: <strong style="font-family:monospace;letter-spacing:2px;color:#bf360c">@cliqCode</strong><br>
                        4️⃣ &nbsp;Come back here and press "I've Sent the Payment"
                    </div>

                    <!-- زر تم الدفع -->
                    <button class="btn-paid" id="btnPaid"
                            onclick="confirmPaymentSent('@ViewBag.OrderCode')">
                        ✅ I've Sent the Payment
                    </button>

                    <!-- رسالة بعد الضغط -->
                    <div id="paidConfirmMsg" style="display:none;margin-top:12px;background:#e8f5e9;
                         border-radius:10px;padding:12px;font-size:.82rem;color:#2e7d32;font-weight:700;
                         text-align:center;line-height:1.6">
                        ✅ Great! We've notified the store that you've sent the payment.<br>
                        The store will verify your transfer and start processing your order.
                        You'll receive a notification when confirmed.
                    </div>
                </div>
            }

            <!-- ══ Navigation Buttons ══ -->
            <div class="nav-btn-group">
                <a asp-controller="Payment" asp-action="Cart" class="nav-btn primary">
                    🛒 Back to Cart
                </a>
                <a asp-controller="Home" asp-action="Home_After" class="nav-btn secondary">
                    🏠 Back to Home
                </a>
            </div>

        </div>
    </div>

    <script>
        async function confirmPaymentSent(orderCode) {
            const btn = document.getElementById('btnPaid');
            if (!btn || btn.disabled) return;

            btn.disabled = true;
            btn.textContent = '⏳ Sending notification...';

            try {
                const fd = new FormData();
                fd.append('orderCode', orderCode);
                const res  = await fetch('/Payment/NotifyCliQSent', { method: 'POST', body: fd });
                const data = await res.json();

                if (data.success) {
                    btn.textContent = '✅ Store Notified!';
                    btn.classList.add('btn-paid-done');
                    document.getElementById('paidConfirmMsg').style.display = 'block';
                } else {
                    btn.disabled = false;
                    btn.textContent = "✅ I've Sent the Payment";
                    alert(data.message || 'Something went wrong. Please try again.');
                }
            } catch {
                btn.disabled = false;
                btn.textContent = "✅ I've Sent the Payment";
                alert('Network error. Please try again.');
            }
        }
    </script>

</body>
</html>
