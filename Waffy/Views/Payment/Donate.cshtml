@using Waffy.Models
@{
    Layout = null;
    decimal walletBalance = (decimal)(ViewBag.WalletBalance ?? 0m);
    var animals = ViewBag.Animals as List<DonationAnimal> ?? new List<DonationAnimal>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        /* ✅ Flip Card */
        .flip-card {
            perspective: 1000px;
        }

        .flip-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.55s cubic-bezier(.4,0,.2,1);
            transform-style: preserve-3d;
        }

        .flip-card.flipped .flip-inner {
            transform: rotateY(180deg);
        }

        .flip-front, .flip-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .flip-back {
            transform: rotateY(180deg);
        }

        /* Open Form Btn hover */
        #openFormBtn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(95,116,48,.45) !important;
        }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Donate - Waffy</title>
    <link rel="stylesheet" href="~/css/money.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container donate-page">

        @* رسائل النجاح والخطأ *@
        @if (TempData["DonateSuccess"] != null)
        {
            <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                        padding:1rem 1.2rem;margin:1rem 0;border-radius:14px;
                        font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                @TempData["DonateSuccess"]
            </div>
        }
        @if (TempData["DonateError"] != null)
        {
            <div style="background:#fff0f0;border:1px solid #ffb2b2;color:#c0392b;
                        padding:1rem 1.2rem;margin:1rem 0;border-radius:14px;
                        font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                ⚠️ @TempData["DonateError"]
            </div>
        }
        @if (Context.Session.GetInt32("UserId") == null)
        {
            <div style="background:#fff4e6;border:1px solid #f0d4a8;color:#b36d2c;
                    padding:1.2rem 1.4rem;margin:1rem 0;border-radius:14px;
                    font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem;
                    display:flex;align-items:center;gap:12px">
                <span style="font-size:1.4rem">🔒</span>
                <div>
                    You must be logged in to make a donation.
                    <a asp-controller="Account" asp-action="Login"
                       style="color:var(--olive-dark);text-decoration:underline;margin-left:6px">
                        Log in now →
                    </a>
                </div>
            </div>
        }

        @* Hero *@
        <section class="donate-hero fade-up">
            <div class="hero-text">
                <h1>Give a Little, Help a Lot ♡</h1>
                <p>Your donation can provide food, medicine, care, and hope for animals who need kindness the most.</p>
            </div>
            <div class="hero-image-box">
                <img src="../Images/money.png" alt="Human hugging animals" class="hero-image" />
            </div>
        </section>

        @* ✅ Call-to-Action Card *@
        <div class="fade-up" style="margin:28px 0 24px;">
            <div style="background:linear-gradient(135deg,#f9f5ee 0%,#eef5db 100%);
                    border:1.5px solid #c8dfa0;border-radius:22px;
                    padding:28px 32px;display:flex;align-items:center;
                    justify-content:space-between;flex-wrap:wrap;gap:18px;
                    box-shadow:0 8px 28px rgba(95,116,48,.1);">
                <div>
                    @* <div style="font-size:1.7rem;margin-bottom:6px;">💛</div>*@
                    <div style="font-family:'Fredoka',sans-serif;font-size:1.45rem;
                            font-weight:700;color:#4a6228;margin-bottom:6px;">
                        Help an Animal <span style="font-size:1.7rem;margin-bottom:6px;">💛</span>
                    </div>
                    <p style="font-size:.92rem;font-weight:700;color:#7a8e5a;max-width:670px;line-height:1.55;">
                        Every donation — big or small — helps us provide food, medicine, and care
                        to animals who need it most. Choose a specific case or donate generally.
                    </p>
                </div>
                <button id="openFormBtn" type="button"
                        style="background:linear-gradient(135deg,#8ba94a,#5f7430);
                           color:#fff;border:none;border-radius:var(--pill, 999px);
                           padding:14px 28px;font-family:'Nunito',sans-serif;
                           font-size:.95rem;font-weight:800;cursor:pointer;
                           box-shadow:0 6px 18px rgba(95,116,48,.35);
                           transition:transform .2s,box-shadow .2s;
                           display:flex;align-items:center;gap:8px;white-space:nowrap;">
                    <span style="font-size:1.1rem;">＋</span> Add Donation
                </button>
            </div>
        </div>

        @* ✅ Flip Cards — الحيوانات من DB *@
        @if (animals.Any())
        {

            <div class="fade-up" style="margin-bottom:28px;">
                <div style="font-family:'Fredoka',sans-serif;font-size:1.2rem;
                            font-weight:700;color:#4a6228;margin-bottom:14px;">
                    🐾 Animals That Need Your Help
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;">
                    @foreach (var a in animals)
                    {
                        var emoji = a.AnimalType?.ToLower() switch
                        {
                            "dog" => "🐕",
                            "cat" => "🐈",
                            "bird" => "🐦",
                            _ => "🐾"
                        };
                        var pct = (a.GoalAmount.HasValue && a.GoalAmount > 0)
                        ? (int)Math.Min(100, Math.Round(a.CollectedAmount / a.GoalAmount.Value * 100))
                        : 0;
                        var remaining = a.GoalAmount.HasValue
                        ? Math.Max(0, a.GoalAmount.Value - a.CollectedAmount)
                        : 0;
                        <div class="flip-card" style="height:290px;cursor:pointer;" onclick="this.classList.toggle('flipped')">
                            <div class="flip-inner">
                                @* وجه أمامي *@
                                <div class="flip-front" style="background:#fff;border:1.5px solid #d8eaac;
                                                border-radius:18px;display:flex;flex-direction:column;
                                                align-items:center;justify-content:center;gap:8px;padding:20px;">
                                    <div style="font-size:3rem;">@emoji</div>
                                    <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;
                                                    font-weight:700;color:#4a6228;text-align:center;">
                                        @a.Name
                                    </div>
                                    <div style="font-size:.78rem;font-weight:800;
                                                    background:#f0f8e0;color:#5f7430;
                                                    padding:4px 12px;border-radius:999px;">
                                        @a.Condition
                                    </div>
                                    @if (a.Location != null)
                                    {
                                        <div style="font-size:.72rem;color:#9aaa7a;font-weight:700;">
                                            📍 @a.Location
                                        </div>
                                    }
                                    <div style="font-size:.7rem;color:#aaa;font-weight:700;margin-top:4px;">
                                        Tap to see story →
                                    </div>
                                </div>
                                @* وجه خلفي *@
                                <div class="flip-back" style="background:linear-gradient(135deg,#4a6228,#6b8c35);
                                                                border-radius:18px;display:flex;flex-direction:column;
                                                                justify-content:space-between;padding:18px;color:#fff;
                                                                overflow-y:auto;">
                                    <div>
                                        <div style="font-family:'Fredoka',sans-serif;font-size:1rem;
                                                        font-weight:700;margin-bottom:8px;">
                                            @emoji @a.Name's Story
                                        </div>
                                        <p style="font-size:.78rem;font-weight:700;line-height:1.55;
                                                      color:rgba(255,255,255,.9);">
                                            @{
                                                var shortStory = a.Story?.Length > 130 ? a.Story[..130] : a.Story;
                                                var hasMore = a.Story?.Length > 130;
                                            }
                                            <span class="story-text-@a.Id">@shortStory</span>
                                            @if (hasMore)
                                            {
                                                <span class="story-more-@a.Id" style="display:none;">@a.Story</span>
                                                <button type="button"
                                                        onclick="this.previousElementSibling.style.display='inline';
                                 this.previousElementSibling.previousElementSibling.style.display='none';
                                 this.style.display='none';"
                                                        style="background:rgba(255,255,255,.2);border:none;color:#c8f060;
                               font-size:.7rem;font-weight:800;padding:3px 8px;border-radius:999px;
                               cursor:pointer;margin-top:4px;font-family:'Nunito',sans-serif;">
                                                    Read more
                                                </button>
                                            }
                                        </p>
                                    </div>
                                    @if (a.GoalAmount.HasValue)
                                    {
                                        <div>
                                            <div style="display:flex;justify-content:space-between;
                                                                font-size:.72rem;font-weight:800;
                                                                color:rgba(255,255,255,.85);margin-bottom:5px;">
                                                <span>@a.CollectedAmount.ToString("F0") JOD raised</span>
                                                <span>@remaining.ToString("F0") JOD left</span>
                                            </div>
                                            <div style="height:7px;background:rgba(255,255,255,.25);
                                                                border-radius:999px;overflow:hidden;">
                                                <div style="height:100%;width:@pct%;
                                                                    background:#c8f060;border-radius:999px;
                                                                    transition:width .6s ease;">
                                                </div>
                                            </div>
                                            <div style="text-align:right;font-size:.68rem;
                                                                color:rgba(255,255,255,.7);font-weight:800;margin-top:3px;">
                                                @pct% of @a.GoalAmount.Value.ToString("F0") JOD goal
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ✅ الفورم — مخفي بالبداية *@
        <section id="donationFormSection" class="donation-form-wrap fade-up"
                 style="display:none;margin-bottom:32px;">
            <div class="form-card">

                @* Donation Type *@
                <section class="form-section">
                    <div class="section-head"><h2>Donation Type</h2><span>❤</span></div>
                    <div class="type-grid">
                        <button class="type-card" type="button" data-type="Supplies">
                            <div class="type-icon">📦</div>
                            <div class="type-title">Supplies</div>
                        </button>
                        <button class="type-card" type="button" data-type="Medicine">
                            <div class="type-icon">💊</div>
                            <div class="type-title">Medicine</div>
                        </button>
                        <button class="type-card" type="button" data-type="Food">
                            <div class="type-icon">🍖</div>
                            <div class="type-title">Food</div>
                        </button>
                        <button class="type-card active" type="button" data-type="Money">
                            <div class="type-icon">💵</div>
                            <div class="type-title">Money</div>
                        </button>
                    </div>
                </section>

                @* Money Section *@
                <section class="form-section" id="moneySection">
                    <div class="section-head"><h2>Donation Amount</h2><span>💵</span></div>
                    <label class="mini-label">Choose Amount</label>
                    <div class="amount-grid">
                        <button class="amount-btn" type="button" data-amount="custom">Custom</button>
                        <button class="amount-btn" type="button" data-amount="50">50 JD</button>
                        <button class="amount-btn" type="button" data-amount="25">25 JD</button>
                        <button class="amount-btn active" type="button" data-amount="10">10 JD</button>
                        <button class="amount-btn" type="button" data-amount="5">5 JD</button>
                    </div>
                    <div id="customAmountWrap" class="hidden input-row">
                        <input id="customAmountInput" type="number" min="1" placeholder="Enter custom amount" />
                    </div>
                    <label class="mini-label">Payment Method</label>
                    <div class="payment-grid">
                        <button class="payment-card" type="button" data-payment="cliq">
                            <strong>CliQ</strong><small>Instant payment</small>
                        </button>
                        <button class="payment-card" type="button" data-payment="card">
                            <strong>Card</strong><small>Visa / Mastercard</small>
                        </button>
                        <button class="payment-card active" type="button" data-payment="wallet">
                            <strong>Waffy Wallet</strong><small>Use your balance</small>
                        </button>
                    </div>
                    <div id="walletBox" class="payment-box">
                        <div class="wallet-line">
                            <strong>Waffy Wallet</strong>
                            <span id="walletBalanceDisplay">@walletBalance.ToString("F2") JD</span>
                        </div>
                        <div class="wallet-line">
                            Selected donation
                            <span id="walletSelectedAmount">10 JD</span>
                        </div>
                        <div class="wallet-line muted-line">
                            Remaining after donation
                            <span id="walletRemainingAmount">@((walletBalance - 10m).ToString("F2")) JD</span>
                        </div>
                    </div>
                    <div id="cardBox" class="payment-box hidden">
                        <div class="form-grid two">
                            <label><span>Card Number</span><input type="text" placeholder="1234 5678 9012 3456" /></label>
                            <label><span>Cardholder Name</span><input type="text" placeholder="FIRSTNAME LASTNAME" /></label>
                        </div>
                        <div class="form-grid two">
                            <label><span>Expiry</span><input type="text" placeholder="MM / YY" /></label>
                            <label><span>CVV</span><input type="text" placeholder="..." /></label>
                        </div>
                    </div>
                    <div id="cliqBox" class="payment-box hidden">
                        <div class="form-grid two">
                            <label>
                                <span>Phone Number</span>
                                <input type="text" id="donateCliqPhone" placeholder="7X XXX XXXX" />
                            </label>
                            <label>
                                <span>Country Code</span>
                                <select>
                                    <option>JO +962</option>
                                    <option>SA +966</option>
                                    <option>UAE +971</option>
                                    <option>EG +20</option>
                                </select>
                            </label>
                        </div>
                        <p class="payment-note">A verification notice can be sent to your phone.</p>
                    </div>
                </section>

                @* Food Section *@
                <section class="form-section hidden" id="foodSection">
                    <div class="section-head"><h2>Food Donation Details</h2><span>🍖</span></div>
                    <div class="form-grid two">
                        <label>
                            <span>Food Type</span>
                            <select id="foodType">
                                <option value="">Choose food type</option>
                                <option>Dry Food</option>
                                <option>Wet Food</option>
                                <option>Treats</option>
                                <option>Special Diet Food</option>
                            </select>
                        </label>
                        <label>
                            <span>Brand / Product Name</span>
                            <input id="foodName" type="text" placeholder="Example: Royal Canin / Pedigree" />
                        </label>
                    </div>
                    <div class="form-grid two">
                        <label>
                            <span>Quantity / Weight</span>
                            <input id="foodWeight" type="text" placeholder="Example: 5 kg / 10 packs" />
                        </label>
                        <label>
                            <span>Target Animal</span>
                            <select id="foodAnimal">
                                <option value="">Choose animal</option>
                                <option>Dog</option>
                                <option>Cat</option>
                                <option>Bird</option>
                                <option>Rabbit</option>
                                <option>Mixed Shelter Animals</option>
                            </select>
                        </label>
                    </div>
                </section>

                @* Medicine Section *@
                <section class="form-section hidden" id="medicineSection">
                    <div class="section-head"><h2>Medicine Donation Details</h2><span>💊</span></div>
                    <div class="form-grid two">
                        <label>
                            <span>Medicine Name</span>
                            <input id="medicineName" type="text" placeholder="Enter medicine name" />
                        </label>
                        <label>
                            <span>Medicine Type</span>
                            <select id="medicineType">
                                <option value="">Choose type</option>
                                <option>Antibiotic</option>
                                <option>Pain Relief</option>
                                <option>Skin Treatment</option>
                                <option>Eye / Ear Drops</option>
                                <option>Vitamins</option>
                                <option>Other</option>
                            </select>
                        </label>
                    </div>
                    <div class="form-grid two">
                        <label>
                            <span>Target Animal</span>
                            <select id="medicineAnimal">
                                <option value="">Choose animal</option>
                                <option>Dog</option>
                                <option>Cat</option>
                                <option>Bird</option>
                                <option>Rabbit</option>
                                <option>Any animal in need</option>
                            </select>
                        </label>
                        <label>
                            <span>Quantity</span>
                            <input id="medicineQty" type="number" min="1" placeholder="Example: 3" />
                        </label>
                    </div>
                </section>

                @* Supplies Section *@
                <section class="form-section hidden" id="suppliesSection">
                    <div class="section-head"><h2>Supplies Donation Details</h2><span>📦</span></div>
                    <div class="form-grid two">
                        <label>
                            <span>Supply Name</span>
                            <input id="supplyName" type="text" placeholder="Example: blanket / carrier / bowl" />
                        </label>
                        <label>
                            <span>Supply Category</span>
                            <select id="supplyCategory">
                                <option value="">Choose category</option>
                                <option>Bedding</option>
                                <option>Carrier / Cage</option>
                                <option>Bowls / Feeding</option>
                                <option>Cleaning Supplies</option>
                                <option>Toys</option>
                                <option>Other</option>
                            </select>
                        </label>
                    </div>
                    <div class="form-grid two">
                        <label>
                            <span>Target Animal</span>
                            <select id="supplyAnimal">
                                <option value="">Choose animal</option>
                                <option>Dog</option>
                                <option>Cat</option>
                                <option>Bird</option>
                                <option>Rabbit</option>
                                <option>General Shelter Use</option>
                            </select>
                        </label>
                        <label>
                            <span>Quantity</span>
                            <input id="supplyQty" type="number" min="1" placeholder="Example: 4" />
                        </label>
                    </div>
                </section>

                @* ✅ Donate to Specific Animal — مع خيار General *@
                <section class="form-section">
                    <div class="section-head"><h2>Donate to Specific Animal</h2><span>🎯</span></div>
                    <div class="animal-note">
                        Choose a specific animal or leave unselected for general shelter support.
                    </div>
                    <div class="specific-grid">

                        @* ✅ خيار General *@
                        <button class="animal-card active" type="button"
                                data-animal-card="" data-animal-name="General">
                            <div style="font-size:1.6rem;margin-bottom:6px;">🌍</div>
                            <strong>General Support</strong>
                            <span>Your donation helps all shelter animals</span>
                        </button>

                        @foreach (var a in animals)
                        {
                            var emoji = a.AnimalType?.ToLower() switch
                            {
                                "dog" => "🐕",
                                "cat" => "🐈",
                                "bird" => "🐦",
                                _ => "🐾"
                            };
                            <button class="animal-card" type="button"
                                    data-animal-card="@a.Id"
                                    data-animal-name="@a.Name">
                                <div style="font-size:1.6rem;margin-bottom:6px;">@emoji</div>
                                <strong>@a.Name — @a.Condition</strong>
                                <span>@(a.Story?.Length > 55 ? a.Story[..55] + "…" : a.Story)</span>
                                @if (a.GoalAmount.HasValue)
                                {
                                    <span style="font-size:.72rem;color:var(--olive-dark);font-weight:800;margin-top:4px;">
                                        Goal: @a.GoalAmount.Value.ToString("F0") JOD
                                    </span>
                                }
                            </button>
                        }
                    </div>
                </section>

                @* Additional Note *@
                <section class="form-section">
                    <div class="section-head"><h2>Additional Note</h2><span>📝</span></div>
                    <div class="form-grid one">
                        <label>
                            <span>Message (optional)</span>
                            <textarea id="donorNote" placeholder="Write any message you want us to know..."></textarea>
                        </label>
                    </div>
                </section>

                @* Hidden Form *@
                <form id="donationForm" method="post"
                      asp-controller="Payment" asp-action="SubmitDonation">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="hDonationType" name="donationType" value="Money" />
                    <input type="hidden" id="hAmount" name="amount" />
                    <input type="hidden" id="hQuantity" name="quantity" />
                    <input type="hidden" id="hUnit" name="unit" />
                    <input type="hidden" id="hDescription" name="description" />
                    <input type="hidden" id="hTargetType" name="targetType" value="General" />
                    <input type="hidden" id="hTargetId" name="targetId" value="" />
                    <input type="hidden" id="hPaymentMethod" name="paymentMethod" value="wallet" />
                </form>

                <div class="submit-row">
                    <button type="button" class="cancel-btn" onclick="closeForm()">Cancel</button>
                    <button id="submitDonationBtn" class="submit-btn" type="button">❤ Send Donation</button>
                </div>

            </div>
        </section>

    </main>

    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a><span>|</span>
            <a asp-controller="Home" asp-action="Suport">Contact</a><span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a><span>|</span>
            <div class="social-inline"><span>f</span><span>🐦</span><span>◎</span></div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <div id="toast" class="toast"></div>

  

    <script>
        var currentType    = 'Money';
        var currentAmount  = 10;
        var currentPayment = 'wallet';
        var walletBalance  = @walletBalance.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

        // ✅ Open / Close Form
        document.getElementById('openFormBtn').addEventListener('click', function() {
            var section = document.getElementById('donationFormSection');
            section.style.display = 'block';
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        function closeForm() {
            document.getElementById('donationFormSection').style.display = 'none';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ✅ Donation Type
        document.querySelectorAll('.type-card').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.type-card').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                currentType = this.dataset.type;
                document.getElementById('hDonationType').value = currentType;
                ['moneySection','foodSection','medicineSection','suppliesSection'].forEach(function(id) {
                    document.getElementById(id).classList.add('hidden');
                });
                var map = { Money:'moneySection', Food:'foodSection', Medicine:'medicineSection', Supplies:'suppliesSection' };
                if (map[currentType]) document.getElementById(map[currentType]).classList.remove('hidden');
            });
        });

        // ✅ Amount Buttons
        document.querySelectorAll('.amount-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.amount-btn').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                var v = this.dataset.amount;
                var wrap = document.getElementById('customAmountWrap');
                if (v === 'custom') {
                    wrap.classList.remove('hidden');
                    currentAmount = null;
                } else {
                    wrap.classList.add('hidden');
                    currentAmount = parseFloat(v);
                    updateWalletDisplay(currentAmount);
                }
            });
        });

        document.getElementById('customAmountInput')?.addEventListener('input', function() {
            currentAmount = parseFloat(this.value) || 0;
            updateWalletDisplay(currentAmount);
        });

        // ✅ Payment Method
        document.querySelectorAll('.payment-card').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.payment-card').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                currentPayment = this.dataset.payment;
                document.getElementById('hPaymentMethod').value = currentPayment;
                ['walletBox','cardBox','cliqBox'].forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el) el.classList.add('hidden');
                });
                var map = { wallet:'walletBox', card:'cardBox', cliq:'cliqBox' };
                if (map[currentPayment]) document.getElementById(map[currentPayment]).classList.remove('hidden');
            });
        });

        // ✅ Animal Cards — General مختار بالبداية
        document.querySelectorAll('.animal-card').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.animal-card').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                var animalId = this.dataset.animalCard || '';
                if (animalId === '') {
                    document.getElementById('hTargetType').value = 'General';
                    document.getElementById('hTargetId').value   = '';
                } else {
                    document.getElementById('hTargetType').value = 'Animal';
                    document.getElementById('hTargetId').value   = animalId;
                }
            });
        });

        // ✅ Wallet Display
        function updateWalletDisplay(amt) {
            var sel = document.getElementById('walletSelectedAmount');
            var rem = document.getElementById('walletRemainingAmount');
            if (sel) sel.textContent = (amt || 0).toFixed(2) + ' JD';
            if (rem) {
                var remaining = walletBalance - (amt || 0);
                rem.textContent = remaining.toFixed(2) + ' JD';
                rem.style.color = remaining < 0 ? '#c0392b' : '';
            }
        }

        // ✅ Submit
        document.getElementById('submitDonationBtn').addEventListener('click', function() {
            if (!currentType) { showToast('⚠️ Please select a donation type.'); return; }

            if (currentType === 'Money') {
                var amt = currentAmount;
                if (document.querySelector('.amount-btn[data-amount="custom"].active')) {
                    amt = parseFloat(document.getElementById('customAmountInput').value) || 0;
                }
                if (!amt || amt <= 0) { showToast('⚠️ Please select or enter a donation amount.'); return; }

                // ✅ تحقق من رقم CliQ — داخل Money فقط
                if (currentPayment === 'cliq') {
                    var donateCliq = document.getElementById('donateCliqPhone');
                    if (!donateCliq?.value) {
                        showToast('⚠️ Please enter your CliQ phone number.');
                        return;
                    }
                    var cleanedCliq = donateCliq.value.trim().replace(/[\s\-]/g, '');
                    if (cleanedCliq.startsWith('+962')) cleanedCliq = '0' + cleanedCliq.slice(4);
                    else if (cleanedCliq.startsWith('962')) cleanedCliq = '0' + cleanedCliq.slice(3);
                    else if (/^7[789]/.test(cleanedCliq) && cleanedCliq.length === 9) cleanedCliq = '0' + cleanedCliq;
                    if (!/^07[789]\d{7}$/.test(cleanedCliq)) {
                        showToast('⚠️ Please enter a valid Jordanian CliQ number (077/078/079).');
                        return;
                    }
                }

                // ✅ تحقق من رصيد الـ Wallet
                if (currentPayment === 'wallet' && amt > walletBalance) {
                    showToast('❌ Insufficient wallet balance! Your balance: ' + walletBalance.toFixed(2) + ' JD');
                    return;
                }

                document.getElementById('hAmount').value      = amt;
                document.getElementById('hQuantity').value    = '';
                document.getElementById('hUnit').value        = '';
                document.getElementById('hDescription').value = document.getElementById('donorNote').value || '';

            } else if (currentType === 'Food') {
                var foodType   = document.getElementById('foodType').value;
                var foodName   = document.getElementById('foodName').value.trim();
                var foodWeight = document.getElementById('foodWeight').value.trim();
                var foodAnimal = document.getElementById('foodAnimal').value;
                if (!foodType || !foodWeight) { showToast('⚠️ Please fill in food type and quantity.'); return; }
                document.getElementById('hAmount').value      = '';
                document.getElementById('hQuantity').value    = 1;
                document.getElementById('hUnit').value        = foodWeight;
                document.getElementById('hDescription').value =
                    [foodType, foodName, foodAnimal, document.getElementById('donorNote').value].filter(Boolean).join(' | ');

            } else if (currentType === 'Medicine') {
                var medName   = document.getElementById('medicineName').value.trim();
                var medType   = document.getElementById('medicineType').value;
                var medAnimal = document.getElementById('medicineAnimal').value;
                var medQty    = parseInt(document.getElementById('medicineQty').value) || 1;
                if (!medName) { showToast('⚠️ Please enter the medicine name.'); return; }
                document.getElementById('hAmount').value      = '';
                document.getElementById('hQuantity').value    = medQty;
                document.getElementById('hUnit').value        = 'units';
                document.getElementById('hDescription').value =
                    [medName, medType, medAnimal, document.getElementById('donorNote').value].filter(Boolean).join(' | ');

            } else if (currentType === 'Supplies') {
                var supName   = document.getElementById('supplyName').value.trim();
                var supCat    = document.getElementById('supplyCategory').value;
                var supAnimal = document.getElementById('supplyAnimal').value;
                var supQty    = parseInt(document.getElementById('supplyQty').value) || 1;
                if (!supName) { showToast('⚠️ Please enter the supply name.'); return; }
                document.getElementById('hAmount').value      = '';
                document.getElementById('hQuantity').value    = supQty;
                document.getElementById('hUnit').value        = 'pieces';
                document.getElementById('hDescription').value =
                    [supName, supCat, supAnimal, document.getElementById('donorNote').value].filter(Boolean).join(' | ');
            }

            document.getElementById('donationForm').submit();
        });

        function showToast(msg, duration) {
            duration = duration || 3500;
            var t = document.getElementById('toast');
            if (!t) return;
            t.textContent = msg;
            t.classList.add('show');
            clearTimeout(t._timer);
            t._timer = setTimeout(function() { t.classList.remove('show'); }, duration);
        }

        updateWalletDisplay(10);

        // ════════ Navbar & Animations ════════
        document.addEventListener('DOMContentLoaded', function() {
            var fadeEls = document.querySelectorAll('.fade-up');
            if ('IntersectionObserver' in window) {
                var obs = new IntersectionObserver(function(entries) {
                    entries.forEach(function(e) {
                        if (e.isIntersecting) { e.target.classList.add('show'); obs.unobserve(e.target); }
                    });
                }, { threshold: 0.15 });
                fadeEls.forEach(function(el) { obs.observe(el); });
            } else {
                fadeEls.forEach(function(el) { el.classList.add('show'); });
            }

            var sd = document.getElementById('servicesDropdown');
            var st = document.getElementById('servicesToggle');
            if (sd && st) {
                st.addEventListener('click', function(e) { e.stopPropagation(); sd.classList.toggle('open'); });
                document.addEventListener('click', function(e) { if (!sd.contains(e.target)) sd.classList.remove('open'); });
            }

            var menuBtn  = document.getElementById('menuBtn');
            var navLinks = document.getElementById('navLinks');
            if (menuBtn && navLinks) {
                menuBtn.addEventListener('click', function(e) { e.stopPropagation(); navLinks.classList.toggle('open'); });
                document.addEventListener('click', function(e) {
                    if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove('open');
                });
            }

            var mt = document.getElementById('mobileServicesToggle');
            var mb = document.getElementById('mobileServicesBlock');
            if (mt && mb) mt.addEventListener('click', function() { mb.classList.toggle('open'); });
        });
    </script>
         
</body>
</html>