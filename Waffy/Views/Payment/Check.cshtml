    <main class="container checkout-page">
        <section class="hero-section fade-up">
            <h1>Checkout </h1>
            <p>
                Complete your order details, choose your preferred payment method,
                and confirm your pet care essentials securely.
            </p>
        </section>

        <section class="checkout-layout">
            <div class="checkout-left">
                <div class="checkout-card fade-up">
                    <h2>Personal Information</h2>

                    <div class="input-grid one">
                        <input type="text" id="fullName" placeholder="Your Name" />
                        <h1></h1>
                    </div>

                    <div class="input-grid two">
                        <input type="email" id="email" placeholder="Email" />

                        <input type="text" id="phone" placeholder="Phone Number" />
                    </div>
                </div>

                <div class="checkout-card fade-up">
                    <h2>Shipping Address</h2>

                    <div class="input-grid two">
                        <input type="text" id="address" placeholder="Address" />
                        <input type="text" id="postalCode" placeholder="Postal Code" />
                        <h1></h1>
                    </div>

                    <div class="input-grid two">
                        <input type="text" id="city" placeholder="City" />
                        <input type="text" id="country" placeholder="Country" />
                    </div>
                </div>

                <div class="checkout-card note-card fade-up">
                    <h2>Order Notes</h2>
                    <textarea id="orderNotes" placeholder="Add a note if needed, or leave this empty..."></textarea>
                </div>

                <div class="checkout-card fade-up">
                    <h2>Payment Methods</h2>

                    <div class="payment-methods">
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="cash" checked />
                            <span>Cash On Delivery</span>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="card" />
                            <span>Credit or Debit Card</span>
                        </label>
                    </div>

                    <div id="cardFields" class="card-fields hidden">
                        <input type="text" id="cardholderName" placeholder="Cardholder Name" />
                        <input type="text" id="cardNumber" placeholder="Card Number" />
                        <div class="input-grid two small-two">
                            <input type="text" id="expDate" placeholder="EXP Date" />
                            <input type="text" id="cvc" placeholder="CVC" />
                        </div>
                    </div>
                </div>
            </div>

            <aside class="checkout-right fade-up">
                <div class="summary-card">
                    <h2>Order Summary</h2>

                    <div id="checkoutItems" class="checkout-items"></div>

                    <div class="summary-line">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">0.00 JD</strong>
                    </div>

                    <div class="summary-line">
                        <span>Shipping</span>
                        <strong id="summaryShipping">2.00 JD</strong>
                    </div>

                    <div class="summary-line total-line">
                        <span>Total</span>
                        <strong id="summaryTotal">0.00 JD</strong>
                    </div>

                    <button id="checkoutBtn" class="checkout-btn" type="button">
                        Confirm Checkout
                    </button>
                </div>
            </aside>
        </section>
