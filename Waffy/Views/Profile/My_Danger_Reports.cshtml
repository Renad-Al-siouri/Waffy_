@model Waffy.Models.ViewModels.WalletViewModel
@{
    Layout = null;
    ViewBag.SidebarName = Model.User.FullName;
    ViewBag.SidebarEmail = Model.User.Email;
    ViewBag.SidebarProfileImage = Model.User.ProfileImage;
    ViewBag.SidebarBalance = Model.Balance.ToString("F2");
    ViewBag.SidebarDangerBadge = Model.DangerReports.Count.ToString();
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy | My Danger Reports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/waffy-shared.css">
    <link rel="stylesheet" href="~/css/waffy-responsive-patch.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">&#9660;</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">&#9776;</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">&#9660;</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <div class="page-wrap">
        @await Html.PartialAsync("_ProfileSidebar")

        <main class="main-content">
            @if (TempData["DangerSuccess"] != null)
            {
                <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                    padding:1rem 1.2rem;margin-bottom:16px;border-radius:14px;
                    font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                    @TempData["DangerSuccess"]
                </div>
            }
            <div class="page-header">
                <div>
                    <h2>Danger Reports 🚨</h2>
                    <p>Track all your dangerous animal reports</p>
                </div>
                <a asp-controller="Map" asp-action="Dangerous" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> New Report
                </a>
            </div>

            @* ── إحصائيات سريعة ── *@
            @{
                var totalReports = Model.DangerReports.Count;
                var pendingCount = Model.DangerReports.Count(r => r.Status == "Pending");
                var resolvedCount = Model.DangerReports.Count(r => r.Status == "Resolved");
                var highCount = Model.DangerReports.Count(r => r.Severity == "High");
            }
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px">
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;
                                color:var(--olive-dark);font-weight:600">
                        @totalReports
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        Total Reports
                    </div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;
                                color:#b36d2c;font-weight:600">
                        @pendingCount
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        Pending
                    </div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;
                                color:#2d7a2d;font-weight:600">
                        @resolvedCount
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        Resolved
                    </div>
                </div>
            </div>

            @* ── قائمة البلاغات ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">Report History</span>
                    <span class="badge badge-blue">@totalReports</span>
                </div>
                <div class="s-card-body">

                    @if (!Model.DangerReports.Any())
                    {
                        <div style="text-align:center;padding:3rem 1rem">
                            <div style="font-size:3rem;margin-bottom:12px">🚨</div>
                            <p style="font-weight:800;color:var(--text);margin-bottom:6px">
                                No reports yet
                            </p>
                            <p style="color:var(--muted);font-size:.85rem;
                                          font-weight:700;margin-bottom:18px">
                                Help your community by reporting dangerous animals!
                            </p>
                            <a asp-controller="Map" asp-action="Dangerous" class="btn btn-primary">
                                <i class="fa-solid fa-plus"></i> Submit a Report
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var r in Model.DangerReports)
                        {
                            @* أيقونة الحيوان *@
                            var animalIcon = r.AnimalType switch
                            {
                                "Dog" => "🐕",
                                "Cat" => "🐈",
                                "Monkey" => "🐒",
                                "Reptile" => "🦎",
                                _ => "❓"
                            };

                            @* لون الخطورة *@
                            var severityColor = r.Severity switch
                            {
                                "High" => "#dc2626",
                                "Medium" => "#b36d2c",
                                _ => "#2d7a2d"
                            };
                            var severityBg = r.Severity switch
                            {
                                "High" => "#fef2f2",
                                "Medium" => "#fff4e6",
                                _ => "#f0fff4"
                            };

                            @* مراحل التتبع *@
                            var steps = new[] { "Submitted", "Under Review", "Resolved" };
                            var currentStep = r.Status switch
                            {
                                "Resolved" => 2,
                                "Under Review" => 1,
                                _ => 0
                            };

                            @* badge الحالة *@
                            var badgeClass = r.Status switch
                            {
                                "Resolved" => "badge-green",
                                "Under Review" => "badge-blue",
                                _ => "badge-orange"
                            };

                            <div style="border:1px solid var(--line);border-radius:18px;
                                                padding:18px;margin-bottom:14px;background:#fcfaf6">

                                @* Header *@
                                <div style="display:flex;align-items:center;
                                                    gap:14px;margin-bottom:14px">
                                    <div style="width:48px;height:48px;border-radius:14px;
                                                        background:@severityBg;display:flex;
                                                        align-items:center;justify-content:center;
                                                        font-size:1.4rem;flex-shrink:0">
                                        @animalIcon
                                    </div>
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:800;font-size:.92rem;color:var(--text)">
                                            @r.AnimalType Report
                                            @if (!string.IsNullOrEmpty(r.ProblemType))
                                            {
                                                <span style="color:var(--muted);font-weight:700;
                                                                         font-size:.8rem"> — @r.ProblemType</span>
                                            }
                                        </div>
                                        <div style="font-size:.76rem;color:var(--muted);
                                                            font-weight:700;margin-top:2px">
                                            @r.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                                        </div>
                                    </div>
                                    <span class="badge @badgeClass">@r.Status</span>
                                </div>

                                @* تفاصيل *@
                                <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px">
                                    <div>
                                        <div style="font-size:.72rem;color:var(--muted);font-weight:700">
                                            Severity
                                        </div>
                                        <div style="font-weight:800;font-size:.88rem;color:@severityColor">
                                            @(r.Severity == "High" ? "🔴" : r.Severity == "Medium" ? "🟠" : "🟢")
                                            @r.Severity
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.City))
                                    {
                                        <div>
                                            <div style="font-size:.72rem;color:var(--muted);font-weight:700">
                                                Location
                                            </div>
                                            <div style="font-weight:800;font-size:.88rem">
                                                @r.City @(!string.IsNullOrEmpty(r.Area) ? $"· {r.Area}" : "")
                                            </div>
                                        </div>
                                    }
                                    <div>
                                        <div style="font-size:.72rem;color:var(--muted);font-weight:700">
                                            Reference
                                        </div>
                                        <div style="font-weight:800;font-size:.82rem;
                                                            font-family:monospace;color:var(--olive-dark)">
                                            @r.ReportCode
                                        </div>
                                    </div>
                                    @if (r.Latitude.HasValue && r.Longitude.HasValue)
                                    {
                                        <div>
                                            <div style="font-size:.72rem;color:var(--muted);font-weight:700">
                                                Coordinates
                                            </div>
                                            <div style="font-weight:700;font-size:.78rem;
                                                                    font-family:monospace;color:var(--muted)">
                                                @r.Latitude.Value.ToString("F4"),
                                                @r.Longitude.Value.ToString("F4")
                                            </div>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(r.Description))
                                {
                                    <div style="background:#fff;border:1px solid var(--line);
                                                            border-radius:10px;padding:8px 12px;
                                                            margin-bottom:14px;font-size:.8rem;
                                                            color:var(--muted);font-weight:700">
                                        📝 @r.Description
                                    </div>
                                }
                                @* ── صور البلاغ ── *@
                                @if (r.Images.Any())
                                {
                                    <div style="display:grid;grid-template-columns:repeat(4,1fr);
                            gap:8px;margin-bottom:14px">
                                        @foreach (var img in r.Images)
                                        {
                                            <a href="@img.ImageUrl" target="_blank"
                                               style="border-radius:10px;overflow:hidden;display:block;
                                      aspect-ratio:1;background:#f0e8d8">
                                                <img src="@img.ImageUrl"
                                                     style="width:100%;height:100%;object-fit:cover"
                                                     alt="Report photo" />
                                            </a>
                                        }
                                    </div>
                                }
                                @* Track Bar *@
                                <div>
                                    <div style="font-size:.72rem;font-weight:800;color:var(--muted);
                                                        margin-bottom:8px;text-transform:uppercase;
                                                        letter-spacing:.8px">
                                        Tracking
                                    </div>

                                    @* Step Labels *@
                                    <div style="display:flex;justify-content:space-between;
                                                        margin-bottom:6px">
                                        @for (int i = 0; i < steps.Length; i++)
                                        {
                                            var isActive = i <= currentStep;
                                            var isCurrent = i == currentStep;
                                            <div style="text-align:center;flex:1;font-size:.7rem;
                                                                    font-weight:800;
                                                                    color:@(isActive ? "var(--olive-dark)" : "var(--muted)")">
                                                @steps[i]
                                                @if (isCurrent && r.Status != "Resolved")
                                                {
                                                    <span style="display:block;font-size:.6rem;
                                                                                 color:var(--olive);margin-top:1px">
                                                        ▲ Now
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @* Progress Bar *@
                                    <div style="position:relative;height:8px;border-radius:999px;
                                                        background:#e8f0d0;overflow:hidden">
                                        <div style="height:100%;border-radius:999px;
                                                            background:linear-gradient(90deg,#dc2626,#f97316);
                                                            width:@((currentStep == 0 ? 10 : currentStep == 1 ? 55 : 100))%;
                                                            transition:width .5s ease">
                                        </div>
                                    </div>

                                    @* Dots *@
                                    <div style="display:flex;justify-content:space-between;
                                                        margin-top:4px">
                                        @for (int i = 0; i < steps.Length; i++)
                                        {
                                            var filled = i <= currentStep;
                                            <div style="width:12px;height:12px;border-radius:50%;
                                                                    background:@(filled ? "#dc2626" : "#d4c7b5");
                                                                    border:2px solid @(filled ? "#fca5a5" : "#e8dfd2");
                                                                    box-shadow:@(filled ? "0 0 0 3px rgba(220,38,38,.15)" : "none")">
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        }
                    }
                </div>
            </div>
        </main>
    </div>

    @* Mobile Bottom Nav *@
    <div class="mobile-bottom-nav" id="mobileBottomNav">
        <a asp-controller="Profile" asp-action="Edit_Profile" class="mb-nav-item">
            <i class="fa-solid fa-user"></i><span>Edit</span>
        </a>
        <a asp-controller="Profile" asp-action="My_Wallet" class="mb-nav-item">
            <i class="fa-solid fa-wallet"></i><span>Wallet</span>
        </a>
        <a asp-controller="Profile" asp-action="My_Danger_Reports" class="mb-nav-item active">
            <i class="fa-solid fa-triangle-exclamation"></i><span>Reports</span>
        </a>
        <a asp-controller="Profile" asp-action="Orders" class="mb-nav-item">
            <i class="fa-solid fa-box"></i><span>Orders</span>
        </a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="mb-more-grid">
            <a asp-controller="Profile" asp-action="Contact_Info" class="mb-more-link">
                <i class="fa-solid fa-address-card"></i><span>Contact Info</span>
            </a>
            <a asp-controller="Profile" asp-action="Rewards" class="mb-more-link">
                <i class="fa-solid fa-gift"></i><span>Rewards</span>
            </a>
            <a asp-controller="Profile" asp-action="Lost_Reports" class="mb-more-link">
                <i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span>
            </a>
            <a asp-controller="Profile" asp-action="Adoption_Ads" class="mb-more-link">
                <i class="fa-solid fa-paw"></i><span>Adoption Ads</span>
            </a>
            <a asp-controller="Profile" asp-action="My_Donations" class="mb-more-link">
                <i class="fa-solid fa-heart"></i><span>My Donations</span>
            </a>
            <a asp-controller="Profile" asp-action="Timeline" class="mb-more-link">
                <i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span>
            </a>
            <a asp-controller="Profile" asp-action="Complaints" class="mb-more-link">
                <i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span>
            </a>
            <a asp-controller="Profile" asp-action="Security" class="mb-more-link">
                <i class="fa-solid fa-lock"></i><span>Security</span>
            </a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Home_After">Home</a><span>|</span>
                <a asp-controller="Clinic" asp-action="Clinics">Clinics</a><span>|</span>
                <a asp-controller="Product" asp-action="Stores">Supplies</a><span>|</span>
                <a asp-controller="Home" asp-action="About">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const moreBtn     = document.getElementById('mbMoreBtn');
            const moreDrawer  = document.getElementById('mbMoreDrawer');
            const moreOverlay = document.getElementById('mbMoreOverlay');
            const moreClose   = document.getElementById('mbMoreClose');
            if (!moreBtn || !moreDrawer) return;
            function open()  { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); }
            function close() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); }
            moreBtn.addEventListener('click', () => moreDrawer.classList.contains('open') ? close() : open());
            if (moreClose)   moreClose.addEventListener('click', close);
            moreOverlay.addEventListener('click', close);
            document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

            const menuBtn  = document.getElementById('menuBtn');
            const navLinks = document.getElementById('navLinks');
            if (menuBtn && navLinks) {
               menuBtn.addEventListener('click', e => { e.stopPropagation(); navLinks.classList.toggle('open'); });
                document.addEventListener('click', e => {
                    if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove('open');
                });
            }
            const sd = document.getElementById('servicesDropdown');
            const st = document.getElementById('servicesToggle');
            if (sd && st) {
                st.addEventListener('click', e => { e.stopPropagation(); sd.classList.toggle('open'); });
                document.addEventListener('click', () => sd.classList.remove('open'));
            }
            const mt = document.getElementById('mobileServicesToggle');
            const mb = document.getElementById('mobileServicesBlock');
            if (mt && mb) mt.addEventListener('click', () => mb.classList.toggle('open'));
        });

        function changeAvatar(input) {
            if (input.files && input.files[0]) {
                const r = new FileReader();
                r.onload = e => {
                    const sb = document.getElementById('sidebarAvatar');
                    if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`;
                };
                r.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>