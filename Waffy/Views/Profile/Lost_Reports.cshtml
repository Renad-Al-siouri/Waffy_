@* رسائل *@
@if (TempData["LostSuccess"] != null)
{
    <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                padding:.8rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:700">
        ✅ @TempData["LostSuccess"]
    </div>
}

<div class="s-card">
    <div class="s-card-head">
        <span class="s-card-title">My Lost Pet Ads</span>
    </div>
    <div class="s-card-body">


        @if (!Model.Reports.Any())
        {
            <p style="color:#6b7c5a;text-align:center;padding:2rem">
                No lost reports yet.
            </p>
        }

        @foreach (var r in Model.Reports)
        {

            var isActive = r.Status == "Active";
            var claims = Model.Finders.ContainsKey(r.IdLostReport)
                         ? Model.Finders[r.IdLostReport]
                         : new List<Waffy.Models.FoundPetClaim>();
            var pendingClaims = claims.Where(c => c.Status == "Pending").ToList();

            <div class="report-row" style="opacity:@(isActive ? "1" : ".65")">

                <div class="report-icon lost"
                     style="opacity:@(isActive ? "1" : ".5")">🔍</div>

                <div class="report-info">
                    <h4>@r.PetName — @r.Breed</h4>
                    <p>
                        Lost near @r.Area, @r.City ·
                        @r.CreatedAt.ToString("MMM dd, yyyy") ·
                        @(r.RewardAmount > 0 ? $"Reward: {r.RewardAmount} JOD" : "No reward")
                    </p>
                    <small>Code: @r.ReportCode</small>
                </div>

                <div style="text-align:right;display:flex;flex-direction:column;
                            gap:6px;align-items:flex-end">

                    @if (isActive)
                    {
                        <span class="badge badge-orange">Active</span>

                        <form method="post"
                              asp-controller="Profile"
                              asp-action="CloseLostReport"
                              onsubmit="return confirm('Mark as found and close?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reportId" value="@r.IdLostReport" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Close Ad
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge badge-green">Found ✓</span>
                    }
                </div>
            </div>

            <hr style="border:none;border-top:1px solid #e8f0d8;margin:0.5rem 0">

 

@if (pendingClaims.Any())
{
    <div style="background:#f8fdf2;border:1px solid #d4e8bc;
                border-radius:12px;padding:1rem;margin:.5rem 0 1rem">
        <h4 style="font-family:'Fredoka',sans-serif;color:#59652a;margin-bottom:.8rem">
            🔍 @pendingClaims.Count Person@(pendingClaims.Count > 1 ? "s" : "") Found Your Pet
        </h4>

        @foreach (var claim in pendingClaims.OrderByDescending(c => c.IsVerified))
        {
            <div style="background:#fff;
                        border:1px solid @(claim.IsVerified ? "#b2dfb2" : "#ffe082");
                        border-radius:10px;padding:.8rem 1rem;margin-bottom:.6rem">
                <div style="display:flex;justify-content:space-between;
                            align-items:start;flex-wrap:wrap;gap:.5rem">
                    <div>
                        @if (claim.IsVerified)
                        {
                            <span style="background:#e8f5e9;color:#2d7a2d;padding:.2rem .6rem;
                                          border-radius:999px;font-size:.75rem;font-weight:800">
                                ✅ Verified — Answered correctly
                            </span>
                        }
                        else
                        {
                            <span style="background:#fff8e1;color:#e65100;padding:.2rem .6rem;
                                          border-radius:999px;font-size:.75rem;font-weight:800">
                                ⚠️ Unverified — Wrong answer
                            </span>
                        }
                        <br />
                        <strong>@claim.FinderName</strong>
                        <span style="color:#7b6c58;font-size:.82rem;margin-left:.4rem">
                            📞 @claim.FinderPhone
                        </span>
                        <br />
                        <small style="color:#9e8e77">
                            @claim.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                        </small>

                        @if (!claim.IsVerified)
                        {
                            <div style="background:#fff8e1;border:1px solid #ffe082;
                                         border-radius:8px;padding:.4rem .6rem;
                                         margin-top:.4rem;font-size:.78rem;color:#92400e">
                                ⚠️ Wrong secret answer. Confirm only if you spoke with this person.
                            </div>
                        }

                        @if (r.RewardAmount > 0)
                        {
                            <div style="margin-top:.4rem;font-size:.8rem;color:#2d7a2d;font-weight:700">
                                🎁 Confirming will send @r.RewardAmount JOD to finder's wallet
                            </div>
                        }
                    </div>

                    <div style="display:flex;gap:.5rem;flex-direction:column">
                        <form method="post"
                              asp-controller="FoundPetClaim"
                              asp-action="ConfirmFound"
                              onsubmit="return confirm('Confirm this person found your pet?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="claimId" value="@claim.IdClaim" />
                            <button type="submit" class="btn btn-primary btn-sm">
                                ✅ Confirm Found
                            </button>
                        </form>

                        <form method="post"
                              asp-controller="FoundPetClaim"
                              asp-action="RejectClaim"
                              onsubmit="return confirm('Reject this claim?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="claimId" value="@claim.IdClaim" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                ❌ Reject
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
        }




    </div>
</div>

@* ══════════════════════════════════════ *@
@* قسم 2 — My Finder Claims (تتبع العملية) *@
@* ══════════════════════════════════════ *@
@if (Model.MyClaims.Any())
{
    <div class="s-card" style="margin-top:1.5rem">
        <div class="s-card-head">
            <span class="s-card-title">🔍 My Found Pet Claims</span>
            <span class="badge badge-blue">@Model.MyClaims.Count Claim@(Model.MyClaims.Count > 1 ? "s" : "")</span>
        </div>
        <div class="s-card-body">
            @foreach (var claim in Model.MyClaims)
            {
                <div class="report-row" style="flex-wrap:wrap;gap:1rem">
                    <div class="report-icon lost">🐾</div>

                    <div class="report-info" style="flex:1;min-width:200px">
                        <h4>@(claim.PetName ?? "Unknown Pet")</h4>
                        <p>Submitted @claim.CreatedAt?.ToString("MMM dd, yyyy")</p>

                        @* ✅ badge التحقق *@
                        @if (claim.IsVerified)
                        {
                            <span style="background:#e8f5e9;color:#2d7a2d;padding:.2rem .6rem;
                                          border-radius:999px;font-size:.75rem;font-weight:800">
                                ✅ Verified Answer
                            </span>
                        }
                        else
                        {
                            <span style="background:#fff8e1;color:#e65100;padding:.2rem .6rem;
                                          border-radius:999px;font-size:.75rem;font-weight:800">
                                ⚠️ Unverified Answer
                            </span>
                        }
                    </div>

                    <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">

                        @* ✅ badge الحالة *@
                        @if (claim.Status == "Pending")
                        {
                            <span class="badge badge-orange">⏳ Pending</span>
                            <small style="color:#7b6c58;font-size:.78rem">
                                Waiting for owner confirmation
                            </small>
                        }
                        else if (claim.Status == "Confirmed")
                        {
                            <span class="badge badge-green">🎉 Confirmed!</span>
                            @if (claim.RewardAmount > 0)
                            {
                                <span style="color:#2d7a2d;font-size:.85rem;font-weight:800">
                                    🎁 +@claim.RewardAmount JOD added to wallet
                                </span>
                            }
                        }
                        else
                        {
                            <span class="badge badge-grey">❌ Rejected</span>
                        }
                    </div>
                </div>
                <hr style="border:none;border-top:1px solid #e8f0d8;margin:.5rem 0">
            }
        </div>
    </div>
}
            
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <div class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile bottom navigation">
        <a href="/Profile/Edit_Profile" class="mb-nav-item"><i class="fa-solid fa-user"></i><span>Edit</span></a>
        <a href="/Profile/My_Wallet" class="mb-nav-item"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
        <a href="/Profile/Appointments" class="mb-nav-item"><i class="fa-solid fa-calendar-check"></i><span>Appointments</span></a>
        <a href="/Profile/Orders" class="mb-nav-item"><i class="fa-solid fa-box"></i><span>Orders</span></a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn" aria-expanded="false" aria-controls="mbMoreDrawer">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mb-more-grid">
            <a href="/Profile/Contact_Info" class="mb-more-link"><i class="fa-solid fa-address-card"></i><span>Contact Info</span></a>
            <a href="/Profile/Rewards" class="mb-more-link"><i class="fa-solid fa-gift"></i><span>Rewards</span></a>
            <a href="/Profile/Lost_Reports" class="mb-more-link"><i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span></a>
            <a href="/Profile/Adoption_Ads" class="mb-more-link"><i class="fa-solid fa-paw"></i><span>Adoption Ads</span></a>
            <a href="/Profile/Timeline" class="mb-more-link"><i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span></a>
            <a href="/Profile/Complaints" class="mb-more-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span></a>
            <a href="/Profile/Security" class="mb-more-link"><i class="fa-solid fa-lock"></i><span>Security</span></a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="/Home/Index">Home</a><span>|</span>
                <a href="/Clinics/Index">Clinics</a><span>|</span>
                <a href="/Stores/Index">Supplies</a><span>|</span>
                <a href="/About/Index">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const moreBtn = document.getElementById('mbMoreBtn'); const moreDrawer = document.getElementById('mbMoreDrawer'); const moreOverlay = document.getElementById('mbMoreOverlay'); const moreClose = document.getElementById('mbMoreClose');
          if (!moreBtn || !moreDrawer || !moreOverlay) return;
          function openMoreDrawer() { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); moreBtn.setAttribute('aria-expanded','true'); moreDrawer.setAttribute('aria-hidden','false'); document.body.classList.add('mb-menu-open'); }
          function closeMoreDrawer() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); moreBtn.setAttribute('aria-expanded','false'); moreDrawer.setAttribute('aria-hidden','true'); document.body.classList.remove('mb-menu-open'); }
          function toggleMoreDrawer() { moreDrawer.classList.contains('open') ? closeMoreDrawer() : openMoreDrawer(); }
          moreBtn.addEventListener('click', toggleMoreDrawer);
          if (moreClose) moreClose.addEventListener('click', closeMoreDrawer);
          moreOverlay.addEventListener('click', closeMoreDrawer);
          document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMoreDrawer(); });
          window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeMoreDrawer(); });
        });
        function showToast(msg, duration = 3000) { const t = document.getElementById("toast"); if (!t) return; t.textContent = msg; t.classList.add("show"); clearTimeout(t._timer); t._timer = setTimeout(() => t.classList.remove("show"), duration); }
        document.addEventListener("DOMContentLoaded", () => {
          const menuBtn = document.getElementById("menuBtn"); const navLinks = document.getElementById("navLinks");
          if (menuBtn && navLinks) { menuBtn.addEventListener("click", e => { e.stopPropagation(); navLinks.classList.toggle("open"); }); document.addEventListener("click", e => { if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove("open"); }); }
          const sd = document.getElementById("servicesDropdown"); const st = document.getElementById("servicesToggle");
          if (sd && st) { st.addEventListener("click", e => { e.stopPropagation(); sd.classList.toggle("open"); }); document.addEventListener("click", () => sd.classList.remove("open")); }
          const mt = document.getElementById("mobileServicesToggle"); const mb = document.getElementById("mobileServicesBlock");
          if (mt && mb) mt.addEventListener("click", () => mb.classList.toggle("open"));
        });
        function changeAvatar(input) { if (input.files && input.files[0]) { const r = new FileReader(); r.onload = e => { const sb = document.getElementById("sidebarAvatar"); if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`; const big = document.getElementById("bigAvatar"); if (big) big.innerHTML = `<img src="${e.target.result}" alt="Profile">`; }; r.readAsDataURL(input.files[0]); } }
        function closeReport() {
          if (!confirm("Mark as found and close this ad?")) return;
          const r = document.getElementById("activeReport");
          r.querySelector(".badge-orange").className = "badge badge-green";
          r.querySelector(".badge-green").textContent = "Found ✓";
          r.querySelector("button").remove();
          r.querySelector(".report-info").style.opacity = ".6";
          r.querySelector(".report-icon").style.opacity = ".5";
          showToast("✓ Report closed");
        }
    </script>
</body>
</html>