@model Waffy.Models.User
@{
    ViewData["Title"] = "Edit Profile";
    Layout = null;
    ViewBag.SidebarName = Model.FullName;
    ViewBag.SidebarEmail = Model.Email;
    ViewBag.SidebarProfileImage = Model.ProfileImage;
    ViewBag.SidebarBalance = ViewBag.SidebarBalance as string ?? "0.00";
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy | Edit Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/waffy-shared.css">
    <link rel="stylesheet" href="~/css/waffy-responsive-patch.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">&#9660;</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a href="/Cart/Index" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a href="/Notifications/Index" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                                <a asp-controller="Profile" asp-action="Edit_Profile" class="profile-btn">
                                    @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                    {
                                        <img src="@Model.ProfileImage" alt="Profile">
                                    }
                                    else
                                    {
                                        <img src="~/Images/user.jpg" alt="Profile">
                                    }
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">&#9776;</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">&#9660;</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <div class="page-wrap">
        @await Html.PartialAsync("_ProfileSidebar")

        <main class="main-content">
            <div class="page-header">
                <div>
                    <h2>Edit Profile</h2>
                    <p>Update your personal information</p>
                </div>
            </div>

            @* ✅ رسائل النجاح والخطأ *@
            @if (TempData["ProfileSuccess"] != null)
            {
                <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;padding:0.7rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:700;">
                    ✅ @TempData["ProfileSuccess"]
                </div>
            }
            @if (TempData["ProfileError"] != null)
            {
                <div style="background:#fff0f0;border:1px solid #ffcccc;color:#c0392b;padding:0.7rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:700;">
                    ⚠️ @TempData["ProfileError"]
                </div>
            }

            @* ✅ الفورم مرتبط بالـ POST *@
            <form method="post" asp-controller="Profile" asp-action="Edit_Profile" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">&#128444;&#65039; Profile Photo</span></div>
                    <div class="s-card-body">
                        <div class="profile-avatar-edit">
                            <div class="big-avatar" id="bigAvatar">
                                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                {
                                    <img src="@Model.ProfileImage" alt="Profile">
                                }
                                else
                                {
                                    <span>&#128100;</span>
                                }
                            </div>
                            <div class="avatar-actions">
                                <div style="display:flex;gap:8px;flex-wrap:wrap">
                                    <button class="btn btn-secondary btn-sm" type="button" onclick="document.getElementById('avatarFile').click()">
                                        <i class="fa-solid fa-camera"></i> Change Photo
                                    </button>
                                    <button class="btn btn-danger btn-sm" type="button" onclick="resetAvatar()">
                                        <i class="fa-solid fa-trash"></i> Remove
                                    </button>
                                </div>
                                <p>JPG or PNG &mdash; Max 5MB</p>
                                @* ✅ input الصورة مرتبط بالـ form *@
                                <input type="file" id="avatarFile" name="avatarFile" accept="image/*" hidden onchange="changeAvatar(this)">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">&#128100; Basic Information</span></div>
                    <div class="s-card-body">
                        <div class="form-grid">
                            <div class="field full">
                                <label>Full Name</label>
                                <input id="f-name" name="fullName" value="@Model.FullName" oninput="syncName()">
                            </div>
                            <div class="field full">
                                <label>Email Address</label>
                                <input id="f-email" name="email" type="email" value="@Model.Email" oninput="syncEmail()">
                            </div>
                            <div class="field">
                                <label>Gender</label>
                                <select id="f-gender" name="gender">
                                    <option value="">Select</option>
                                    <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                                    <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                                    <option value="Prefer not to say" selected="@(Model.Gender == "Prefer not to say")">Prefer not to say</option>
                                </select>
                            </div>
                            <div class="field full">
                                <label>Bio</label>
                                <textarea id="f-bio" name="bio">@Model.Bio</textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="removeAvatar" id="removeAvatarInput" value="false" />
                <div style="display:flex;justify-content:flex-end;margin-top:1rem;">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> Save Changes
                    </button>
                </div>

            </form>
        </main>
    </div>

    <!-- Mobile Bottom Navigation — بدون تغيير -->
    <div class="mobile-bottom-nav" id="mobileBottomNav">
        <a asp-controller="Profile" asp-action="Edit_Profile" class="mb-nav-item active"><i class="fa-solid fa-user"></i><span>Edit</span></a>
        <a asp-controller="Profile" asp-action="My_Wallet" class="mb-nav-item"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
        <a asp-controller="Profile" asp-action="Appointments" class="mb-nav-item"><i class="fa-solid fa-calendar-check"></i><span>Appointments</span></a>
        <a asp-controller="Profile" asp-action="Orders" class="mb-nav-item"><i class="fa-solid fa-box"></i><span>Orders</span></a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn"><i class="fa-solid fa-grid-2"></i><span>More</span></button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mb-more-grid">
            <a asp-controller="Profile" asp-action="Contact_Info" class="mb-more-link"><i class="fa-solid fa-address-card"></i><span>Contact Info</span></a>
            <a asp-controller="Profile" asp-action="Rewards" class="mb-more-link"><i class="fa-solid fa-gift"></i><span>Rewards</span></a>
            <a asp-controller="Profile" asp-action="Lost_Reports" class="mb-more-link"><i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span></a>
            <a asp-controller="Profile" asp-action="Adoption_Ads" class="mb-more-link"><i class="fa-solid fa-paw"></i><span>Adoption Ads</span></a>
            <a asp-controller="Profile" asp-action="Timeline" class="mb-more-link"><i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span></a>
            <a asp-controller="Profile" asp-action="Complaints" class="mb-more-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span></a>
            <a asp-controller="Profile" asp-action="Security" class="mb-more-link"><i class="fa-solid fa-lock"></i><span>Security</span></a>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="/Home/Index">Home</a><span>|</span>
                <a href="/Clinics/Index">Clinics</a><span>|</span>
                <a href="/Stores/Index">Supplies</a><span>|</span>
                <a href="/About/Index">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // ── Mobile drawer & navbar — بدون تغيير ──
        document.addEventListener('DOMContentLoaded', function () {
            const moreBtn = document.getElementById('mbMoreBtn');
            const moreDrawer = document.getElementById('mbMoreDrawer');
            const moreOverlay = document.getElementById('mbMoreOverlay');
            const moreClose = document.getElementById('mbMoreClose');
            if (!moreBtn || !moreDrawer || !moreOverlay) return;
            function openMoreDrawer() { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); moreBtn.setAttribute('aria-expanded', 'true'); moreDrawer.setAttribute('aria-hidden', 'false'); document.body.classList.add('mb-menu-open'); }
            function closeMoreDrawer() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); moreBtn.setAttribute('aria-expanded', 'false'); moreDrawer.setAttribute('aria-hidden', 'true'); document.body.classList.remove('mb-menu-open'); }
            moreBtn.addEventListener('click', () => moreDrawer.classList.contains('open') ? closeMoreDrawer() : openMoreDrawer());
            if (moreClose) moreClose.addEventListener('click', closeMoreDrawer);
            moreOverlay.addEventListener('click', closeMoreDrawer);
            document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMoreDrawer(); });
            window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeMoreDrawer(); });
        });
        document.addEventListener("DOMContentLoaded", () => {
            const menuBtn = document.getElementById("menuBtn");
            const navLinks = document.getElementById("navLinks");
            if (menuBtn && navLinks) { menuBtn.addEventListener("click", e => { e.stopPropagation(); navLinks.classList.toggle("open"); }); document.addEventListener("click", e => { if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove("open"); }); }
            const sd = document.getElementById("servicesDropdown");
            const st = document.getElementById("servicesToggle");
            if (sd && st) { st.addEventListener("click", e => { e.stopPropagation(); sd.classList.toggle("open"); }); document.addEventListener("click", () => sd.classList.remove("open")); }
            const mt = document.getElementById("mobileServicesToggle");
            const mb = document.getElementById("mobileServicesBlock");
            if (mt && mb) mt.addEventListener("click", () => mb.classList.toggle("open"));
        });

        function showToast(msg, duration = 3000) {
            const t = document.getElementById("toast");
            if (!t) return;
            t.textContent = msg;
            t.classList.add("show");
            clearTimeout(t._timer);
            t._timer = setTimeout(() => t.classList.remove("show"), duration);
        }

        function changeAvatar(input) {
            if (input.files && input.files[0]) {
                const r = new FileReader();
                r.onload = e => {
                    const sb = document.getElementById("sidebarAvatar");
                    if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`;
                    const big = document.getElementById("bigAvatar");
                    if (big) big.innerHTML = `<img src="${e.target.result}" alt="Profile">`;
                };
                r.readAsDataURL(input.files[0]);
            }
        }

        function syncName()  { document.getElementById("sidebarName").textContent  = document.getElementById("f-name").value; }
        function syncEmail() { document.getElementById("sidebarEmail").textContent = document.getElementById("f-email").value; }
             function resetAvatar() {
            document.getElementById("bigAvatar").innerHTML = "<span>&#128100;</span>";
            const sb = document.getElementById("sidebarAvatar");
            if (sb) sb.innerHTML = "<span>&#128100;</span>";
            document.getElementById("removeAvatarInput").value = "true";
            document.getElementById("avatarFile").value = "";
            showToast("Photo removed");
        }
    </script>
</body>
</html>