@model Waffy.Models.ViewModels.WalletViewModel
@{
    Layout = null;
    var clinics = ViewBag.Clinics as List<Waffy.Models.Clinic> ?? new();
    var stores = ViewBag.Stores as List<Waffy.Models.Store> ?? new();
    var hasError = TempData["ComplaintError"] != null;
    var errorMsg = TempData["ComplaintError"]?.ToString();
    var hasSuccess = TempData["ComplaintSuccess"] != null;
    var successMsg = TempData["ComplaintSuccess"]?.ToString();
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy | Complaints</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/waffy-shared.css">
    <link rel="stylesheet" href="~/css/waffy-responsive-patch.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">&#9660;</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">&#9776;</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">&#9660;</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <div class="page-wrap">
        <aside class="sidebar">
            <div class="sb-profile">
                <div class="sb-profile-inner">
                    <div class="sb-avatar-wrap">
                        <div class="sb-avatar" id="sidebarAvatar"><span>&#128100;</span></div>
                        <button class="sb-cam" onclick="document.getElementById('avatarFile').click()">&#128247;</button>
                        <input type="file" id="avatarFile" accept="image/*" hidden onchange="changeAvatar(this)">
                    </div>
                    <div class="sb-profile-text">
                        <div class="sb-name">@Model.User.FullName</div>
                        <div class="sb-email">@Model.User.Email</div>
                        <div class="sb-wallet-mini">
                            <span>&#128155; Wallet</span>
                            <strong>@Model.Balance.ToString("F2") JOD</strong>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-nav-label">Account</div>
                <a asp-controller="Profile" asp-action="Edit_Profile" class="sb-item"><i class="fa-solid fa-user"></i> Edit Profile</a>
                <a asp-controller="Profile" asp-action="Contact_Info" class="sb-item"><i class="fa-solid fa-address-card"></i> Contact Info</a>
                <a asp-controller="Profile" asp-action="My_Wallet" class="sb-item"><i class="fa-solid fa-wallet"></i> My Wallet</a>
                <a asp-controller="Profile" asp-action="Rewards" class="sb-item"><i class="fa-solid fa-gift"></i> Rewards</a>

                <div class="sb-nav-label">Pets &amp; Services</div>
                <a asp-controller="Profile" asp-action="Appointments" class="sb-item"><i class="fa-solid fa-calendar-check"></i> Appointments</a>
                <a asp-controller="Profile" asp-action="Orders" class="sb-item"><i class="fa-solid fa-box"></i> Orders</a>
                <a asp-controller="Profile" asp-action="Lost_Reports" class="sb-item"><i class="fa-solid fa-magnifying-glass"></i> Lost Reports</a>
                <a asp-controller="Profile" asp-action="Adoption_Ads" class="sb-item"><i class="fa-solid fa-paw"></i> Adoption Ads</a>
                <a asp-controller="Profile" asp-action="My_Donations" class="sb-item"><i class="fa-solid fa-heart"></i> My Donations</a>
                <a asp-controller="Profile" asp-action="My_Danger_Reports" class="sb-item"><i class="fa-solid fa-triangle-exclamation"></i> Danger Reports</a>

                <div class="sb-nav-label">History</div>
                <a asp-controller="Profile" asp-action="Timeline" class="sb-item"><i class="fa-solid fa-clock-rotate-left"></i> Timeline</a>
                <a asp-controller="Profile" asp-action="Complaints" class="sb-item active">
                    <i class="fa-solid fa-flag"></i> Complaints
                    <span class="sb-badge red">@Model.Complaints.Count(c => c.Status == "Open")</span>
                </a>

                <div class="sb-nav-label">Settings</div>
                <a asp-controller="Profile" asp-action="Security" class="sb-item"><i class="fa-solid fa-lock"></i> Security</a>
            </nav>
        </aside>

        <main class="main-content">

            @* ✅ رسالة النجاح *@
            @if (hasSuccess)
            {
                <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                                padding:1rem 1.2rem;margin-bottom:16px;border-radius:14px;
                                font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                    @successMsg
                </div>
            }

            @* ✅ رسالة الخطأ *@
            @if (hasError)
            {
                <div style="background:#fff0f0;border:1px solid #ffb2b2;color:#c0392b;
                                padding:1rem 1.2rem;margin-bottom:16px;border-radius:14px;
                                font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                    ⚠️ @errorMsg
                </div>
            }

            <div class="page-header">
                <div>
                    <h2>Complaints 📢</h2>
                    <p>Submit and track your complaints</p>
                </div>
            </div>

            @* ── إحصائيات ── *@
            @{
                var totalC = Model.Complaints.Count;
                var openC = Model.Complaints.Count(c => c.Status == "Open");
                var resolvedC = Model.Complaints.Count(c => c.Status == "Resolved");
            }
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px">
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:var(--olive-dark);font-weight:600">@totalC</div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">Total</div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:#b36d2c;font-weight:600">@openC</div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">Open</div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:#2d7a2d;font-weight:600">@resolvedC</div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">Resolved</div>
                </div>
            </div>

            @* ── فورم الشكوى — مخفي بالبداية ── *@
            <div class="s-card" style="margin-bottom:20px">
                <div class="s-card-head">
                    <span class="s-card-title">Submit a New Complaint</span>
                    <button type="button" class="btn btn-primary btn-sm"
                            id="toggleBtn" onclick="toggleComplaintForm()">
                        <i class="fa-solid fa-plus"></i> New Complaint
                    </button>
                </div>

                <div id="complaintFormWrap" style="display:none">
                    <div class="s-card-body">
                        <form method="post"
                              asp-controller="Profile"
                              asp-action="SubmitComplaint">
                            @Html.AntiForgeryToken()

                            @* Target Type *@
                            <div style="margin-bottom:14px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Complaint Type</label>
                                <select name="targetType" required
                                        onchange="handleTargetType(this.value)"
                                        style="width:100%;padding:11px 14px;border-radius:14px;
                                               border:1px solid #d8cdbf;font-weight:700;
                                               font-family:Nunito,sans-serif;background:#fff">
                                    <option value="">Choose complaint type</option>
                                    <option value="Clinic">🏥 Clinic Complaint</option>
                                    <option value="Store">🛍️ Store Complaint</option>
                                    <option value="System">⚙️ System Complaint</option>
                                </select>
                            </div>

                            @* Clinic Select *@
                            <div id="clinicWrap" style="display:none;margin-bottom:14px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Select Clinic</label>
                                <select name="targetId"
                                        style="width:100%;padding:11px 14px;border-radius:14px;
                                               border:1px solid #d8cdbf;font-weight:700;
                                               font-family:Nunito,sans-serif;background:#fff">
                                    <option value="">Choose clinic</option>
                                    @foreach (var clinic in clinics)
                                    {
                                        <option value="@clinic.IdClinic">@clinic.Name</option>
                                    }
                                </select>
                                <div style="font-size:.76rem;color:var(--muted);font-weight:700;margin-top:4px">
                                    Sent to Clinic Admin + Super Admin
                                </div>
                            </div>

                            @* Store Select *@
                            <div id="storeWrap" style="display:none;margin-bottom:14px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Select Store</label>
                                <select name="targetId"
                                        style="width:100%;padding:11px 14px;border-radius:14px;
                                               border:1px solid #d8cdbf;font-weight:700;
                                               font-family:Nunito,sans-serif;background:#fff">
                                    <option value="">Choose store</option>
                                    @foreach (var store in stores)
                                    {
                                        <option value="@store.IdStore">@store.Name</option>
                                    }
                                </select>
                                <div style="font-size:.76rem;color:var(--muted);font-weight:700;margin-top:4px">
                                    Sent to Store Admin + Super Admin
                                </div>
                            </div>

                            @* System Note *@
                            <div id="systemNote" style="display:none;margin-bottom:14px;
                                 background:#fff4e6;border:1px solid #f0d4a8;border-radius:12px;
                                 padding:10px 14px;font-size:.82rem;font-weight:700;color:#b36d2c">
                                ℹ️ System complaints are sent directly to Super Admin.
                            </div>

                            @* Title *@
                            <div style="margin-bottom:14px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Complaint Title</label>
                                <input name="title" type="text" required
                                       placeholder="Write a short title..."
                                       style="width:100%;padding:11px 14px;border-radius:14px;
                                              border:1px solid #d8cdbf;font-weight:700;
                                              font-family:Nunito,sans-serif" />
                            </div>

                            @* Priority *@
                            <div style="margin-bottom:14px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Priority</label>
                                <select name="priority"
                                        style="width:100%;padding:11px 14px;border-radius:14px;
                                               border:1px solid #d8cdbf;font-weight:700;
                                               font-family:Nunito,sans-serif;background:#fff">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Urgent">Urgent</option>
                                </select>
                            </div>

                            @* Description *@
                            <div style="margin-bottom:16px">
                                <label style="font-weight:800;font-size:.82rem;color:#716451;
                                              display:block;margin-bottom:6px">Details</label>
                                <textarea name="description" required
                                          placeholder="Explain the issue in detail..."
                                          style="width:100%;padding:11px 14px;border-radius:14px;
                                                 border:1px solid #d8cdbf;font-weight:700;
                                                 min-height:110px;font-family:Nunito,sans-serif;
                                                 resize:vertical"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary"
                                    style="width:100%;justify-content:center">
                                <i class="fa-solid fa-paper-plane"></i> Submit Complaint
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            @* ── قائمة الشكاوى ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">My Complaints</span>
                    <span class="badge badge-blue">@totalC</span>
                </div>
                <div class="s-card-body">
                    @if (!Model.Complaints.Any())
                    {
                        <div style="text-align:center;padding:3rem 1rem">
                            <div style="font-size:3rem;margin-bottom:12px">📢</div>
                            <p style="font-weight:800;color:var(--text);margin-bottom:6px">No complaints yet</p>
                            <p style="color:var(--muted);font-size:.85rem;font-weight:700">
                                Use the form above to submit a complaint.
                            </p>
                        </div>
                    }
                    else
                    {
                        @foreach (var c in Model.Complaints)
                        {
                            var badgeClass = c.Status switch
                            {
                                "Resolved" => "badge-green",
                                "Under Review" => "badge-blue",
                                _ => "badge-orange"
                            };
                            var priorityColor = c.Priority switch
                            {
                                "Urgent" => "#dc2626",
                                "High" => "#b91c1c",
                                "Medium" => "#b36d2c",
                                _ => "#2d7a2d"
                            };

                            <div class="complaint-card">
                                <div class="complaint-head">
                                    <h4>@c.TargetType Complaint — @c.Title</h4>
                                    <span class="badge @badgeClass">@c.Status</span>
                                </div>
                                <p>
                                    <strong>Priority:</strong>
                                    <span style="color:@priorityColor;font-weight:800">@c.Priority</span>
                                </p>
                                <p><strong>Date:</strong> @c.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")</p>
                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <p style="color:var(--muted);font-size:.82rem;margin-top:6px">
                                        @c.Description
                                    </p>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </main>
    </div>

    @* Mobile Bottom Nav *@
    <div class="mobile-bottom-nav" id="mobileBottomNav">
        <a asp-controller="Profile" asp-action="Edit_Profile" class="mb-nav-item">
            <i class="fa-solid fa-user"></i><span>Edit</span>
        </a>
        <a asp-controller="Profile" asp-action="My_Wallet" class="mb-nav-item">
            <i class="fa-solid fa-wallet"></i><span>Wallet</span>
        </a>
        <a asp-controller="Profile" asp-action="Complaints" class="mb-nav-item active">
            <i class="fa-solid fa-flag"></i><span>Complaints</span>
        </a>
        <a asp-controller="Profile" asp-action="Orders" class="mb-nav-item">
            <i class="fa-solid fa-box"></i><span>Orders</span>
        </a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="mb-more-grid">
            <a asp-controller="Profile" asp-action="Contact_Info" class="mb-more-link">
                <i class="fa-solid fa-address-card"></i><span>Contact Info</span>
            </a>
            <a asp-controller="Profile" asp-action="Rewards" class="mb-more-link">
                <i class="fa-solid fa-gift"></i><span>Rewards</span>
            </a>
            <a asp-controller="Profile" asp-action="Lost_Reports" class="mb-more-link">
                <i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span>
            </a>
            <a asp-controller="Profile" asp-action="Adoption_Ads" class="mb-more-link">
                <i class="fa-solid fa-paw"></i><span>Adoption Ads</span>
            </a>
            <a asp-controller="Profile" asp-action="My_Donations" class="mb-more-link">
                <i class="fa-solid fa-heart"></i><span>My Donations</span>
            </a>
            <a asp-controller="Profile" asp-action="My_Danger_Reports" class="mb-more-link">
                <i class="fa-solid fa-triangle-exclamation"></i><span>Danger Reports</span>
            </a>
            <a asp-controller="Profile" asp-action="Timeline" class="mb-more-link">
                <i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span>
            </a>
            <a asp-controller="Profile" asp-action="Security" class="mb-more-link">
                <i class="fa-solid fa-lock"></i><span>Security</span>
            </a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Home_After">Home</a><span>|</span>
                <a asp-controller="Clinic" asp-action="Clinics">Clinics</a><span>|</span>
                <a asp-controller="Product" asp-action="Stores">Supplies</a><span>|</span>
                <a asp-controller="Home" asp-action="About">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ✅ More drawer
            const moreBtn     = document.getElementById('mbMoreBtn');
            const moreDrawer  = document.getElementById('mbMoreDrawer');
            const moreOverlay = document.getElementById('mbMoreOverlay');
            const moreClose   = document.getElementById('mbMoreClose');
            if (moreBtn && moreDrawer) {
                function open()  { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); }
                function close() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); }
                moreBtn.addEventListener('click', () => moreDrawer.classList.contains('open') ? close() : open());
                if (moreClose)   moreClose.addEventListener('click', close);
                moreOverlay.addEventListener('click', close);
                document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
            }

            // ✅ Navbar
            const menuBtn  = document.getElementById('menuBtn');
            const navLinks = document.getElementById('navLinks');
            if (menuBtn && navLinks) {
                menuBtn.addEventListener('click', e => { e.stopPropagation(); navLinks.classList.toggle('open'); });
                document.addEventListener('click', e => {
                    if (!navLinks.contains(e.target) && e.target !== menuBtn)
                        navLinks.classList.remove('open');
                });
            }
            const sd = document.getElementById('servicesDropdown');
            const st = document.getElementById('servicesToggle');
            if (sd && st) {
                st.addEventListener('click', e => { e.stopPropagation(); sd.classList.toggle('open'); });
                document.addEventListener('click', () => sd.classList.remove('open'));
            }
            const mt = document.getElementById('mobileServicesToggle');
            const mb = document.getElementById('mobileServicesBlock');
            if (mt && mb) mt.addEventListener('click', () => mb.classList.toggle('open'));

            // ✅ لو يوجد خطأ — افتح الفورم تلقائياً
            @if (hasError)
            {
                    <text>
                    var wrap = document.getElementById('complaintFormWrap');
                    var btn  = document.getElementById('toggleBtn');
                    if (wrap) wrap.style.display = 'block';
                    if (btn)  btn.innerHTML = '<i class="fa-solid fa-xmark"></i> Cancel';
                    </text>
            }
        });

        // ✅ إظهار/إخفاء الـ dropdowns
        function handleTargetType(val) {
            document.getElementById('clinicWrap').style.display  = val === 'Clinic' ? 'block' : 'none';
            document.getElementById('storeWrap').style.display   = val === 'Store'  ? 'block' : 'none';
            document.getElementById('systemNote').style.display  = val === 'System' ? 'block' : 'none';
        }

        // ✅ toggle الفورم
        function toggleComplaintForm() {
            var wrap = document.getElementById('complaintFormWrap');
            var btn  = document.getElementById('toggleBtn');
            if (wrap.style.display === 'none') {
                wrap.style.display = 'block';
                btn.innerHTML = '<i class="fa-solid fa-xmark"></i> Cancel';
            } else {
                wrap.style.display = 'none';
                btn.innerHTML = '<i class="fa-solid fa-plus"></i> New Complaint';
            }
        }

        function changeAvatar(input) {
            if (input.files && input.files[0]) {
                const r = new FileReader();
                r.onload = e => {
                    const sb = document.getElementById('sidebarAvatar');
                    if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`;
                };
                r.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>