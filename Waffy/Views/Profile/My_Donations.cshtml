@model Waffy.Models.ViewModels.WalletViewModel

@{
    ViewData["Title"] = "My Donations";
    Layout = null;
    ViewBag.SidebarName = Model.User.FullName;
    ViewBag.SidebarEmail = Model.User.Email;
    ViewBag.SidebarProfileImage = Model.User.ProfileImage;
    ViewBag.SidebarBalance = Model.Balance.ToString("F2");
    ViewBag.SidebarDonationsBadge = Model.Donations.Count.ToString();
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy | My Donations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/waffy-shared.css">
    <link rel="stylesheet" href="~/css/waffy-responsive-patch.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">&#9660;</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">&#9776;</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">&#9660;</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <div class="page-wrap">
        @await Html.PartialAsync("_ProfileSidebar")

        <main class="main-content">
            <div class="page-header">
                <div>
                    <h2>My Donations 💚</h2>
                    <p>Track all your kindness in one place</p>
                </div>
                <a asp-controller="Payment" asp-action="Donate" class="btn btn-primary">
                    <i class="fa-solid fa-heart"></i> Donate Again
                </a>
            </div>

            @* ── إحصائيات سريعة ── *@
            @{
                var moneyTotal = Model.Donations.Where(d => d.DonationType == "Money").Sum(d => d.Amount ?? 0);
                var totalCount = Model.Donations.Count;
                var pendingCount = Model.Donations.Count(d => d.Status == "Pending");
            }
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px">
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:var(--olive-dark);font-weight:600">
                        @totalCount
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        Total Donations
                    </div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:#2d7a2d;font-weight:600">
                        @moneyTotal.ToString("F2") JD
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        Money Donated
                    </div>
                </div>
                <div class="s-card" style="margin-bottom:0;text-align:center;padding:18px">
                    <div style="font-size:1.8rem;font-family:Fredoka,sans-serif;color:#b36d2c;font-weight:600">
                        @pendingCount
                    </div>
                    <div style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">
                        In Progress
                    </div>
                </div>
            </div>

            @* ── قائمة التبرعات ── *@
            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">Donation History</span>
                    <span class="badge badge-blue">@totalCount</span>
                </div>
                <div class="s-card-body">

                    @if (!Model.Donations.Any())
                    {
                        <div style="text-align:center;padding:3rem 1rem">
                            <div style="font-size:3rem;margin-bottom:12px">💚</div>
                            <p style="font-weight:800;color:var(--text);margin-bottom:6px">No donations yet</p>
                            <p style="color:var(--muted);font-size:.85rem;font-weight:700;margin-bottom:18px">
                                Your first donation can change an animal's life!
                            </p>
                            <a asp-controller="Payment" asp-action="Donate" class="btn btn-primary">
                                <i class="fa-solid fa-heart"></i> Make a Donation
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var d in Model.Donations)
                        {
                            @* ── أيقونة حسب النوع ── *@
                            var icon = d.DonationType switch
                            {
                                "Money" => "💵",
                                "Food" => "🍖",
                                "Medicine" => "💊",
                                _ => "📦"
                            };
                            var iconBg = d.DonationType switch
                            {
                                "Money" => "#eef5df",
                                "Food" => "#fff4e6",
                                "Medicine" => "#fef2f2",
                                _ => "#eff6ff"
                            };

                            @* ── مراحل التتبع ── *@
                            var steps = d.DonationType == "Money"
                            ? new[] { "Submitted", "Verified", "Completed" }
                            : new[] { "Submitted", "Received", "Delivered" };

                            var currentStep = d.Status switch
                            {
                                "Completed" => 2,
                                "Delivered" => 2,
                                "Received" => 1,
                                "Verified" => 1,
                                _ => 0   // Pending
                            };

                            <div style="border:1px solid var(--line);border-radius:18px;
                                                padding:18px;margin-bottom:14px;background:#fcfaf6">

                                @* Header *@
                                <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
                                    <div style="width:48px;height:48px;border-radius:14px;
                                                        background:@iconBg;display:flex;align-items:center;
                                                        justify-content:center;font-size:1.4rem;flex-shrink:0">
                                        @icon
                                    </div>
                                    <div style="flex:1;min-width:0">
                                        <div style="font-weight:800;font-size:.92rem;color:var(--text)">
                                            @d.DonationType Donation
                                            @if (!string.IsNullOrEmpty(d.TargetType) && d.TargetType != "General")
                                            {
                                                <span style="color:var(--muted);font-weight:700;font-size:.8rem">
                                                    → @d.TargetType
                                                </span>
                                            }
                                        </div>
                                        <div style="font-size:.76rem;color:var(--muted);font-weight:700;margin-top:2px">
                                            @d.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                                        </div>
                                    </div>
                                    @* Badge الحالة *@
                                    @{
                                        var badgeClass = d.Status switch
                                        {
                                            "Completed" => "badge-green",
                                            "Delivered" => "badge-green",
                                            "Received" => "badge-blue",
                                            "Verified" => "badge-blue",
                                            _ => "badge-orange"
                                        };
                                    }
                                    <span class="badge @badgeClass">@d.Status</span>
                                </div>

                                @* تفاصيل *@
                                <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px">
                                    @if (d.DonationType == "Money" && d.Amount.HasValue)
                                    {
                                        <div>
                                            <div style="font-size:.72rem;color:var(--muted);font-weight:700">Amount</div>
                                            <div style="font-family:Fredoka,sans-serif;font-size:1.1rem;
                                                                    color:#2d7a2d;font-weight:600">
                                                @d.Amount.Value.ToString("F2") JD
                                            </div>
                                        </div>
                                    }
                                    @if (d.Quantity.HasValue && d.DonationType != "Money")
                                    {
                                        <div>
                                            <div style="font-size:.72rem;color:var(--muted);font-weight:700">Quantity</div>
                                            <div style="font-weight:800;font-size:.9rem">
                                                @d.Quantity @d.Unit
                                            </div>
                                        </div>
                                    }
                                    <div>
                                        <div style="font-size:.72rem;color:var(--muted);font-weight:700">Reference</div>
                                        <div style="font-weight:800;font-size:.82rem;
                                                            font-family:monospace;color:var(--olive-dark)">
                                            @d.ReferenceCode
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(d.Description))
                                {
                                    <div style="background:#fff;border:1px solid var(--line);border-radius:10px;
                                                            padding:8px 12px;margin-bottom:14px;
                                                            font-size:.8rem;color:var(--muted);font-weight:700">
                                        📝 @d.Description
                                    </div>
                                }

                                @* ── Track Bar ── *@
                                <div>
                                    <div style="font-size:.72rem;font-weight:800;color:var(--muted);
                                                        margin-bottom:8px;text-transform:uppercase;letter-spacing:.8px">
                                        Tracking
                                    </div>

                                    @* Steps Labels *@
                                    <div style="display:flex;justify-content:space-between;margin-bottom:6px">
                                        @for (int i = 0; i < steps.Length; i++)
                                        {
                                            var isActive = i <= currentStep;
                                            var isCurrent = i == currentStep;
                                            <div style="text-align:center;flex:1;
                                                                    font-size:.7rem;font-weight:800;
                                                                    color:@(isActive ? "var(--olive-dark)" : "var(--muted)")">
                                                @steps[i]
                                                @if (isCurrent && d.Status != "Completed" && d.Status != "Delivered")
                                                {
                                                    <span style="display:block;font-size:.6rem;
                                                                                 color:var(--olive);margin-top:1px">▲ Now</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @* Progress Bar *@
                                    <div style="position:relative;height:8px;border-radius:999px;
                                                        background:#e8f0d0;overflow:hidden">
                                        <div style="height:100%;border-radius:999px;
                                                            background:linear-gradient(90deg,var(--olive),var(--olive-light));
                                                            width:@((currentStep == 0 ? 10 : currentStep == 1 ? 55 : 100))%;
                                                            transition:width .5s ease">
                                        </div>
                                    </div>

                                    @* Dots *@
                                    <div style="display:flex;justify-content:space-between;margin-top:4px">
                                        @for (int i = 0; i < steps.Length; i++)
                                        {
                                            var filled = i <= currentStep;
                                            <div style="width:12px;height:12px;border-radius:50%;
                                                                    background:@(filled ? "var(--olive)" : "#d4c7b5");
                                                                    border:2px solid @(filled ? "var(--olive-light)" : "#e8dfd2");
                                                                    box-shadow:@(filled ? "0 0 0 3px rgba(151,173,77,.15)" : "none")">
                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>
                        }
                    }
                </div>
            </div>
        </main>
    </div>

    @* Mobile Bottom Nav *@
    <div class="mobile-bottom-nav" id="mobileBottomNav">
        <a href="/Profile/Edit_Profile" class="mb-nav-item"><i class="fa-solid fa-user"></i><span>Edit</span></a>
        <a href="/Profile/My_Wallet" class="mb-nav-item"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
        <a href="/Profile/My_Donations" class="mb-nav-item active"><i class="fa-solid fa-heart"></i><span>Donations</span></a>
        <a href="/Profile/Orders" class="mb-nav-item"><i class="fa-solid fa-box"></i><span>Orders</span></a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mb-more-grid">
            <a href="/Profile/Contact_Info" class="mb-more-link"><i class="fa-solid fa-address-card"></i><span>Contact Info</span></a>
            <a href="/Profile/Rewards" class="mb-more-link"><i class="fa-solid fa-gift"></i><span>Rewards</span></a>
            <a href="/Profile/Lost_Reports" class="mb-more-link"><i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span></a>
            <a href="/Profile/Adoption_Ads" class="mb-more-link"><i class="fa-solid fa-paw"></i><span>Adoption Ads</span></a>
            <a href="/Profile/Timeline" class="mb-more-link"><i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span></a>
            <a href="/Profile/Complaints" class="mb-more-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span></a>
            <a href="/Profile/Security" class="mb-more-link"><i class="fa-solid fa-lock"></i><span>Security</span></a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Home_After">Home</a><span>|</span>
                <a asp-controller="Clinic" asp-action="Clinics">Clinics</a><span>|</span>
                <a asp-controller="Product" asp-action="Stores">Supplies</a><span>|</span>
                <a asp-controller="Home" asp-action="About">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const moreBtn     = document.getElementById('mbMoreBtn');
            const moreDrawer  = document.getElementById('mbMoreDrawer');
            const moreOverlay = document.getElementById('mbMoreOverlay');
            const moreClose   = document.getElementById('mbMoreClose');
            if (!moreBtn || !moreDrawer) return;
            function open()  { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); }
            function close() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); }
            moreBtn.addEventListener('click', () => moreDrawer.classList.contains('open') ? close() : open());
            if (moreClose)   moreClose.addEventListener('click', close);
            moreOverlay.addEventListener('click', close);
            document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

            // Navbar
            const menuBtn  = document.getElementById('menuBtn');
            const navLinks = document.getElementById('navLinks');
            if (menuBtn && navLinks) {
                menuBtn.addEventListener('click', e => { e.stopPropagation(); navLinks.classList.toggle('open'); });
                document.addEventListener('click', e => { if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove('open'); });
            }
            const sd = document.getElementById('servicesDropdown');
            const st = document.getElementById('servicesToggle');
            if (sd && st) {
                st.addEventListener('click', e => { e.stopPropagation(); sd.classList.toggle('open'); });
                document.addEventListener('click', () => sd.classList.remove('open'));
            }
            const mt = document.getElementById('mobileServicesToggle');
            const mb = document.getElementById('mobileServicesBlock');
            if (mt && mb) mt.addEventListener('click', () => mb.classList.toggle('open'));
        });

        function changeAvatar(input) {
            if (input.files && input.files[0]) {
                const r = new FileReader();
                r.onload = e => {
                    const sb = document.getElementById('sidebarAvatar');
                    if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`;
                };
                r.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>