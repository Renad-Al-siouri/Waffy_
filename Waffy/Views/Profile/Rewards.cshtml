            </header>
        </div>
    </div>

    <div class="page-wrap">
        <aside class="sidebar">
            <div class="sb-profile">
                <div class="sb-profile-inner">
                    <div class="sb-avatar-wrap">
                        <div class="sb-avatar" id="sidebarAvatar"><span>&#128100;</span></div>
                        <button class="sb-cam" onclick="document.getElementById('avatarFile').click()">&#128247;</button>
                        <input type="file" id="avatarFile" accept="image/*" hidden onchange="changeAvatar(this)">
                    </div>
                    <div class="sb-profile-text">
                        <div class="sb-name" id="sidebarName">Batool Jaber</div>
                        <div class="sb-email" id="sidebarEmail">Batool@@email.com</div>
                        <div class="sb-wallet-mini">
                            <span>&#128155; Wallet</span>
                            <strong id="sidebarBalance">100.50 JOD</strong>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-nav-label">Account</div>
                <a href="/Profile/Edit_Profile" class="sb-item"><i class="fa-solid fa-user"></i> Edit Profile</a>
                <a href="/Profile/Contact_Info" class="sb-item"><i class="fa-solid fa-address-card"></i> Contact Info</a>
                <a href="/Profile/My_Wallet" class="sb-item"><i class="fa-solid fa-wallet"></i> My Wallet<span class="sb-badge">32.50</span></a>
                <a href="/Profile/Rewards" class="sb-item active"><i class="fa-solid fa-gift"></i> Rewards<span class="sb-badge">3</span></a>

                <div class="sb-nav-label">Pets &amp; Services</div>
                <a href="/Profile/Appointments" class="sb-item"><i class="fa-solid fa-calendar-check"></i> Appointments<span class="sb-badge">2</span></a>
                <a href="/Profile/Orders" class="sb-item"><i class="fa-solid fa-box"></i> Orders<span class="sb-badge">3</span></a>
                <a href="/Profile/Lost_Reports" class="sb-item"><i class="fa-solid fa-magnifying-glass"></i> Lost Reports<span class="sb-badge red">1</span></a>
                <a href="/Profile/Adoption_Ads" class="sb-item"><i class="fa-solid fa-paw"></i> Adoption Ads<span class="sb-badge">1</span></a>

                <div class="sb-nav-label">History</div>
                <a href="/Profile/Timeline" class="sb-item"><i class="fa-solid fa-clock-rotate-left"></i> Timeline</a>
                <a href="/Profile/Complaints" class="sb-item"><i class="fa-solid fa-triangle-exclamation"></i> Complaints</a>

                <div class="sb-nav-label">Settings</div>
                <a href="/Profile/Security" class="sb-item"><i class="fa-solid fa-lock"></i> Security</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header"><div><h2>Rewards &#127873;</h2><p>Your earned points and coupons</p></div></div>

            <div class="s-card">
                <div class="s-card-head"><span class="s-card-title">&#11088; Points Balance</span></div>
                <div class="s-card-body">
                    <div style="display:flex;align-items:center;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:16px">
                        <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#fef9c3,#fde68a);display:flex;align-items:center;justify-content:center;font-size:1.5rem">&#11088;</div>
                        <div>
                            <div style="font-family:Fredoka,sans-serif;font-size:1.8rem;color:#92400e;font-weight:600">240 pts</div>
                            <p style="font-size:.8rem;color:var(--muted);font-weight:700">Redeem at 500 points for 5 JOD credit</p>
                            <div class="progress-wrap" style="width:200px;margin-top:6px"><div class="progress-fill" style="width:48%"></div></div>
                        </div>
                    </div>
                    <div class="reward-card"><div class="reward-ico">&#127942;</div><div class="reward-info"><h4>Found Lost Pet Reward</h4><p>Finder reward credited &mdash; Feb 28</p></div><div class="reward-val">+10.00 JOD</div></div>
                    <div class="reward-card"><div class="reward-ico">&#127873;</div><div class="reward-info"><h4>Welcome Bonus</h4><p>Registration reward &mdash; Mar 1</p></div><div class="reward-val">+5.00 JOD</div></div>
                    <div class="reward-card"><div class="reward-ico">&#128176;</div><div class="reward-info"><h4>Cashback 2%</h4><p>On your last order &mdash; Mar 8</p></div><div class="reward-val">+0.37 JOD</div></div>
                </div>
            </div>

            <div class="s-card">
                <div class="s-card-head"><span class="s-card-title">&#127903;&#65039; My Coupons</span></div>
                <div class="s-card-body">
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px;border:2px dashed #d4e2b0;border-radius:16px;background:#f5faea;margin-bottom:10px">
                        <div><h4 style="font-weight:800;font-size:.9rem;color:var(--olive-dark)">WAFFY-10OFF</h4><p style="font-size:.78rem;color:var(--muted);font-weight:700">10% off next clinic visit &middot; Expires Apr 30</p></div>
                        <button class="btn btn-ghost btn-sm" onclick="navigator.clipboard.writeText('WAFFY-10OFF').then(()=>showToast('&#128203; Coupon copied!'))">Copy</button>
                    </div>
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px;border:1px solid var(--line);border-radius:16px;background:#fafaf6;opacity:.55">
                        <div><h4 style="font-weight:800;font-size:.9rem;color:var(--muted)">WAFFY-5JOD</h4><p style="font-size:.78rem;color:var(--muted);font-weight:700">5 JOD store credit &middot; Expired</p></div>
                        <span class="badge badge-grey">Expired</span>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <div class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile bottom navigation">
        <a href="/Profile/Edit_Profile" class="mb-nav-item">
            <i class="fa-solid fa-user"></i><span>Edit</span>
        </a>
        <a href="/Profile/My_Wallet" class="mb-nav-item">
            <i class="fa-solid fa-wallet"></i><span>Wallet</span>
        </a>
        <a href="/Profile/Appointments" class="mb-nav-item">
            <i class="fa-solid fa-calendar-check"></i><span>Appointments</span>
        </a>
        <a href="/Profile/Orders" class="mb-nav-item">
            <i class="fa-solid fa-box"></i><span>Orders</span>
        </a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn" aria-expanded="false" aria-controls="mbMoreDrawer">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mb-more-grid">
            <a href="/Profile/Contact_Info" class="mb-more-link"><i class="fa-solid fa-address-card"></i><span>Contact Info</span></a>
            <a href="/Profile/Rewards" class="mb-more-link"><i class="fa-solid fa-gift"></i><span>Rewards</span></a>
            <a href="/Profile/Lost_Reports" class="mb-more-link"><i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span></a>
            <a href="/Profile/Adoption_Ads" class="mb-more-link"><i class="fa-solid fa-paw"></i><span>Adoption Ads</span></a>
            <a href="/Profile/Timeline" class="mb-more-link"><i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span></a>
            <a href="/Profile/Complaints" class="mb-more-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span></a>
            <a href="/Profile/Security" class="mb-more-link"><i class="fa-solid fa-lock"></i><span>Security</span></a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="/Home/Index">Home</a><span>|</span>
                <a href="/Clinics/Index">Clinics</a><span>|</span>
                <a href="/Stores/Index">Supplies</a><span>|</span>
                <a href="/About/Index">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const moreBtn = document.getElementById('mbMoreBtn');
          const moreDrawer = document.getElementById('mbMoreDrawer');
          const moreOverlay = document.getElementById('mbMoreOverlay');
          const moreClose = document.getElementById('mbMoreClose');
          if (!moreBtn || !moreDrawer || !moreOverlay) return;
          function openMoreDrawer() { moreDrawer.classList.add('open'); moreOverlay.classList.add('open'); moreBtn.setAttribute('aria-expanded','true'); moreDrawer.setAttribute('aria-hidden','false'); document.body.classList.add('mb-menu-open'); }
          function closeMoreDrawer() { moreDrawer.classList.remove('open'); moreOverlay.classList.remove('open'); moreBtn.setAttribute('aria-expanded','false'); moreDrawer.setAttribute('aria-hidden','true'); document.body.classList.remove('mb-menu-open'); }
          function toggleMoreDrawer() { moreDrawer.classList.contains('open') ? closeMoreDrawer() : openMoreDrawer(); }
          moreBtn.addEventListener('click', toggleMoreDrawer);
          if (moreClose) moreClose.addEventListener('click', closeMoreDrawer);
          moreOverlay.addEventListener('click', closeMoreDrawer);
          document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMoreDrawer(); });
          window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeMoreDrawer(); });
        });
        function showToast(msg, duration = 3000) { const t = document.getElementById("toast"); if (!t) return; t.textContent = msg; t.classList.add("show"); clearTimeout(t._timer); t._timer = setTimeout(() => t.classList.remove("show"), duration); }
        document.addEventListener("DOMContentLoaded", () => {
          const menuBtn = document.getElementById("menuBtn");
          const navLinks = document.getElementById("navLinks");
          if (menuBtn && navLinks) { menuBtn.addEventListener("click", e => { e.stopPropagation(); navLinks.classList.toggle("open"); }); document.addEventListener("click", e => { if (!navLinks.contains(e.target) && e.target !== menuBtn) navLinks.classList.remove("open"); }); }
          const sd = document.getElementById("servicesDropdown");
          const st = document.getElementById("servicesToggle");
          if (sd && st) { st.addEventListener("click", e => { e.stopPropagation(); sd.classList.toggle("open"); }); document.addEventListener("click", () => sd.classList.remove("open")); }
          const mt = document.getElementById("mobileServicesToggle");
          const mb = document.getElementById("mobileServicesBlock");
          if (mt && mb) mt.addEventListener("click", () => mb.classList.toggle("open"));
        });
        function changeAvatar(input) { if (input.files && input.files[0]) { const r = new FileReader(); r.onload = e => { const sb = document.getElementById("sidebarAvatar"); if (sb) sb.innerHTML = `<img src="${e.target.result}" alt="Profile">`; const big = document.getElementById("bigAvatar"); if (big) big.innerHTML = `<img src="${e.target.result}" alt="Profile">`; }; r.readAsDataURL(input.files[0]); } }
    </script>
</body>
</html>