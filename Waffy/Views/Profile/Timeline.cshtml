        <main class="main-content">
            <div class="page-header"><div><h2>Activity Timeline &#9200;&#65039;</h2><p>Everything that happened on your account</p></div></div>

            <div class="s-card">
                <div class="s-card-head"><span class="s-card-title">Recent Activity</span></div>
                <div class="s-card-body">
                    <div class="timeline">
                        <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><h4>Appointment booked &mdash; Buddy &middot; Checkup</h4><p>Al Amanah Clinic &middot; Dr. Rania Hassan</p><small>Today, 9:14 AM</small></div></div>
                        <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><h4>Wallet topped up &mdash; +20 JOD via Card</h4><p>Visa ending in 4242</p><small>Mar 10, 2:30 PM</small></div></div>
                        <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><h4>Lost pet ad published &mdash; Buddy</h4><p>Reward: 25 JOD &middot; 14-day duration</p><small>Mar 10, 11:00 AM</small></div></div>
                        <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><h4>Order delivered &mdash; Royal Canin 2kg</h4><p>Pet Friends Store</p><small>Mar 8, 4:00 PM</small></div></div>
                        <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><h4>Finder reward received &mdash; +10 JOD</h4><p>Returned lost pet to owner</p><small>Feb 28, 6:45 PM</small></div></div>
                        <div class="tl-item"><div class="tl-dot grey"></div><div class="tl-content"><h4>Account created &#127881;</h4><p>Welcome to Waffy! +5 JOD welcome bonus</p><small>Mar 1, 2026</small></div></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <div class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile bottom navigation">
