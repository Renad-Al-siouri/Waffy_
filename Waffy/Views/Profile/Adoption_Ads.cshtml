                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">&#9660;</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a href="/Cart/Index" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a href="/Notifications/Index" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                                <a href="/Profile/Edit_Profile" class="profile-btn">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>
                                <a href="/Account/Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">&#9776;</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy"></div>

                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">&#9660;</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <div class="page-wrap">
        <aside class="sidebar">
            <div class="sb-profile">
                <div class="sb-profile-inner">
                    <div class="sb-avatar-wrap">
                        <div class="sb-avatar" id="sidebarAvatar"><span>&#128100;</span></div>
                        <button class="sb-cam" onclick="document.getElementById('avatarFile').click()">&#128247;</button>
                        <input type="file" id="avatarFile" accept="image/*" hidden onchange="changeAvatar(this)">
                    </div>
                    <div class="sb-profile-text">

                        <div class="sb-name" id="sidebarName">@Model.User.FullName</div>
                        <div class="sb-email" id="sidebarEmail">@Model.User.Email</div>
                        <div class="sb-wallet-mini">
                            <span>&#128155; Wallet</span>
                            <strong id="sidebarBalance">100.50 JOD</strong>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-nav-label">Account</div>
                <a href="/Profile/Edit_Profile" class="sb-item"><i class="fa-solid fa-user"></i> Edit Profile</a>
                <a href="/Profile/Contact_Info" class="sb-item"><i class="fa-solid fa-address-card"></i> Contact Info</a>
                <a href="/Profile/My_Wallet" class="sb-item"><i class="fa-solid fa-wallet"></i> My Wallet<span class="sb-badge">32.50</span></a>
                <a href="/Profile/Rewards" class="sb-item"><i class="fa-solid fa-gift"></i> Rewards<span class="sb-badge">3</span></a>

                <div class="sb-nav-label">Pets &amp; Services</div>
                <a href="/Profile/Appointments" class="sb-item"><i class="fa-solid fa-calendar-check"></i> Appointments<span class="sb-badge">2</span></a>
                <a href="/Profile/Orders" class="sb-item"><i class="fa-solid fa-box"></i> Orders<span class="sb-badge">3</span></a>
                <a href="/Profile/Lost_Reports" class="sb-item"><i class="fa-solid fa-magnifying-glass"></i> Lost Reports<span class="sb-badge red">1</span></a>
                <a href="/Profile/Adoption_Ads" class="sb-item active"><i class="fa-solid fa-paw"></i> Adoption Ads<span class="sb-badge">1</span></a>

                <div class="sb-nav-label">History</div>
                <a href="/Profile/Timeline" class="sb-item"><i class="fa-solid fa-clock-rotate-left"></i> Timeline</a>
                <a href="/Profile/Complaints" class="sb-item"><i class="fa-solid fa-triangle-exclamation"></i> Complaints</a>

                <div class="sb-nav-label">Settings</div>
                <a href="/Profile/Security" class="sb-item"><i class="fa-solid fa-lock"></i> Security</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="page-header">
                <div>
                    <h2>Adoption Ads 🐾</h2>
                    <p>Pets you've posted for adoption</p>
                </div>
            </div>

            @* رسائل النجاح *@
            @if (TempData["AdoptionSuccess"] != null)
            {
                <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                    padding:.8rem 1rem;border-radius:10px;margin-bottom:1rem;font-weight:700">
                    ✅ @TempData["AdoptionSuccess"]
                </div>
            }

            <div class="s-card">
                <div class="s-card-head">
                    <span class="s-card-title">My Adoption Listings</span>
                    <span class="badge badge-green">@Model.Posts.Count Active</span>
                </div>
                <div class="s-card-body">

                    @if (!Model.Posts.Any())
                    {
                        <p style="color:#6b7c5a;text-align:center;padding:2rem">
                            No adoption ads yet.
                            <a asp-controller="Account" asp-action="Profile">Go add a pet first</a>
                        </p>
                    }

                    @foreach (var post in Model.Posts)
{
    var reqs = Model.Reservations.ContainsKey(post.IdPost)
               ? Model.Reservations[post.IdPost]
               : new List<Waffy.Models.AdoptionReservation>();
    var pending = reqs.Where(r => r.Status == "Pending").ToList();

    <div class="report-row" style="flex-wrap:wrap;gap:1rem">
        <div class="report-icon adopt">🐾</div>
        <div class="report-info" style="flex:1;min-width:200px">
            <h4>@post.PetName — @post.AnimalType · @post.City</h4>
            <p>
                Posted @post.CreatedAt.ToString("MMM dd, yyyy") ·
                Status: <strong>@post.AdoptionStatus</strong>
            </p>
            <div class="adoption-meta">
                <span class="meta-chip">@post.Gender</span>
                <span class="meta-chip">@(post.IsVaccinated ? "Vaccinated" : "Not Vaccinated")</span>
                <span class="meta-chip">@post.AdoptionStatus</span>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
            <span class="badge @(post.AdoptionStatus == "Available" ? "badge-green" : "badge-orange")">
                @post.AdoptionStatus
            </span>

            @* ✅ كبسة Requests *@
            @if (pending.Any())
            {
                <button class="btn btn-primary btn-sm"
                        onclick="toggleRequests('req_@post.IdPost')">
                    📋 @pending.Count Request@(pending.Count > 1 ? "s" : "")
                </button>
            }

            <div class="adoption-actions" style="display:flex;gap:.5rem">
                <a href="#editForm_@post.IdPost" class="btn btn-secondary btn-sm">✏ Edit</a>

                @if (post.AdoptionStatus != "Closed")
                {
                    <form method="post" asp-controller="Profile" asp-action="CloseAdoptionPost"
                          onsubmit="return confirm('Close this ad?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@post.IdPost" />
                        <button type="submit" class="btn btn-danger btn-sm">✕ Close</button>
                    </form>
                }
            </div>
        </div>
    </div>

    @* ✅ قسم الطلبات — يظهر/يختفي *@
    @if (pending.Any())
    {
        <div id="req_@post.IdPost"
             style="display:none;background:#f8fdf2;border:1px solid #d4e8bc;
                    border-radius:14px;padding:1rem;margin:.5rem 0 1rem">
            <h4 style="font-family:'Fredoka',sans-serif;color:#59652a;margin-bottom:.8rem">
                📋 Reservation Requests
            </h4>

            @foreach (var req in pending)
            {
                <div style="background:#fff;border:1px solid #e0ebb4;border-radius:10px;
                             padding:.8rem 1rem;margin-bottom:.6rem">
                    <div style="display:flex;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:.5rem">
                        <div>
                            <strong>@req.RequesterName</strong>
                            <span style="color:#7b6c58;font-size:.82rem;margin-left:.5rem">
                                📞 @req.RequesterPhone
                            </span>
                            <br />
                            @if (!string.IsNullOrEmpty(req.Message))
                            {
                                <span style="color:#564632;font-size:.85rem;font-weight:700">
                                    💬 @req.Message
                                </span>
                            }
                            <br />
                            <small style="color:#9e8e77">
                                @req.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt")
                            </small>
                        </div>

                        <div style="display:flex;gap:.5rem">
                            @* ✅ Approve *@
                            <form method="post" asp-controller="Reservation" asp-action="Approve"
                                  onsubmit="return confirm('Approve and transfer pet ownership?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reservationId" value="@req.IdReservation" />
                                <button type="submit" class="btn btn-primary btn-sm">✅ Approve</button>
                            </form>

                            @* ✅ Reject *@
                            <form method="post" asp-controller="Reservation" asp-action="Reject"
                                  onsubmit="return confirm('Reject this request?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reservationId" value="@req.IdReservation" />
                                <button type="submit" class="btn btn-danger btn-sm">❌ Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Edit Form *@
   <div id="editForm_@post.IdPost"
     style="background:#f8fdf2;border:1px solid #d4e8bc;
            border-radius:12px;padding:1.2rem;
            margin:0.5rem 0 1.5rem;
            display:none"
     class="edit-form-section">

    <form method="post"
          asp-controller="Profile"
          asp-action="EditAdoptionPost">
        @Html.AntiForgeryToken()
        <input type="hidden" name="postId" value="@post.IdPost" />

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">

            <div class="field">
                <label>City</label>
                <select name="city">
                    @foreach (var city in new[] { "Amman", "Zarqa", "Irbid", "Aqaba", "Madaba", "Karak" })
                    {
                        <option value="@city" selected="@(post.City == city)">@city</option>
                    }
                </select>
            </div>

            <div class="field">
                <label>Area</label>
                <input type="text" name="area" value="@post.Area" />
            </div>

            <div class="field">
                <label>Contact Phone</label>
                <input type="tel" name="contactPhone" value="@post.ContactPhone" />
            </div>

            <div class="field">
                <label>Ad Status</label>
                <select name="adoptionStatus">
                    @foreach (var s in new[] { "Available", "Reserved", "Adopted", "Closed" })
                    {
                        <option value="@s" selected="@(post.AdoptionStatus == s)">@s</option>
                    }
                </select>
            </div>

            <div class="field" style="grid-column:1/-1">
                <label>Description</label>
                <textarea name="description" rows="3">@post.Description</textarea>
            </div>

            <div class="field" style="grid-column:1/-1">
                <label>Reason for Adoption</label>
                <textarea name="reasonForAdoption" rows="2">@post.ReasonForAdoption</textarea>
            </div>

        </div>

        <div style="display:flex;gap:.5rem;margin-top:1rem;justify-content:flex-end">
            <a href="#"
               onclick="document.getElementById('editForm_@post.IdPost').style.display='none';return false;"
               class="btn btn-secondary btn-sm">Cancel</a>
            <button type="submit" class="btn btn-primary btn-sm">💾 Save Changes</button>
        </div>
    </form>
</div>

    <hr style="border:none;border-top:1px solid #e8f0d8;margin:.5rem 0">
}
                </div>
            </div>

            @* ══════════════════════════════════════ *@
@* قسم 2 — My Reservation Requests       *@
@* ══════════════════════════════════════ *@
<div class="s-card" style="margin-top:1.5rem">
    <div class="s-card-head">
        <span class="s-card-title">🐾 My Reservation Requests</span>
        <span class="badge badge-blue">
            @Model.MyRequests.Count(r => r.Status == "Pending") Pending
        </span>
    </div>
    <div class="s-card-body">

        @if (!Model.MyRequests.Any())
        {
            <p style="color:#6b7c5a;text-align:center;padding:2rem">
                You haven't sent any reservation requests yet.
                <a asp-controller="Pet" asp-action="Adapt">Browse pets</a>
            </p>
        }

        @foreach (var req in Model.MyRequests.OrderByDescending(r => r.CreatedAt))
        {
            <div class="report-row" style="flex-wrap:wrap;gap:1rem">
                <div class="report-icon adopt">🐾</div>

                <div class="report-info" style="flex:1;min-width:200px">
                    <h4>@req.PetName</h4>
                    <p>
                        Requested @req.CreatedAt.ToString("MMM dd, yyyy") ·
                        Status: <strong>@req.Status</strong>
                    </p>
                    @if (!string.IsNullOrEmpty(req.Message))
                    {
                        <p style="color:#7b6c58;font-size:.85rem">
                            💬 "@req.Message"
                        </p>
                    }
                </div>

                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">

                    @* Badge الحالة *@
                    <span class="badge @(req.Status == "Pending" ? "badge-orange" :
                                         req.Status == "Approved" ? "badge-green" :
                                         "badge-grey")">
                        @req.Status
                    </span>

                    @* زر Cancel — فقط لو Pending *@
                    @if (req.Status == "Pending")
                    {
                        <form method="post"
                              asp-controller="Reservation"
                              asp-action="Cancel"
                              onsubmit="return confirm('Cancel this reservation request?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reservationId" value="@req.IdReservation" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                ✕ Cancel
                            </button>
                        </form>
                    }

                    @* لو Approved — رسالة تهنئة *@
                    @if (req.Status == "Approved")
                    {
                        <span style="color:#2d7a2d;font-size:.8rem;font-weight:700">
                            🎉 Approved!
                        </span>
                    }
                </div>
            </div>

            <hr style="border:none;border-top:1px solid #e8f0d8;margin:.5rem 0">
        }
    </div>
</div>
        </main>
    </div>

    <!-- Mobile Bottom Navigation -->
    <div class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile bottom navigation">
        <a href="/Profile/Edit_Profile" class="mb-nav-item"><i class="fa-solid fa-user"></i><span>Edit</span></a>
        <a href="/Profile/My_Wallet" class="mb-nav-item"><i class="fa-solid fa-wallet"></i><span>Wallet</span></a>
        <a href="/Profile/Appointments" class="mb-nav-item"><i class="fa-solid fa-calendar-check"></i><span>Appointments</span></a>
        <a href="/Profile/Orders" class="mb-nav-item"><i class="fa-solid fa-box"></i><span>Orders</span></a>
        <button type="button" class="mb-nav-item mb-more-btn" id="mbMoreBtn" aria-expanded="false" aria-controls="mbMoreDrawer">
            <i class="fa-solid fa-grid-2"></i><span>More</span>
        </button>
    </div>

    <div class="mb-more-overlay" id="mbMoreOverlay"></div>
    <div class="mb-more-drawer" id="mbMoreDrawer" aria-hidden="true">
        <div class="mb-more-head">
            <h3>More Pages</h3>
            <button type="button" class="mb-more-close" id="mbMoreClose" aria-label="Close menu"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="mb-more-grid">
            <a href="/Profile/Contact_Info" class="mb-more-link"><i class="fa-solid fa-address-card"></i><span>Contact Info</span></a>
            <a href="/Profile/Rewards" class="mb-more-link"><i class="fa-solid fa-gift"></i><span>Rewards</span></a>
            <a href="/Profile/Lost_Reports" class="mb-more-link"><i class="fa-solid fa-magnifying-glass"></i><span>Lost Reports</span></a>
            <a href="/Profile/Adoption_Ads" class="mb-more-link"><i class="fa-solid fa-paw"></i><span>Adoption Ads</span></a>
            <a href="/Profile/Timeline" class="mb-more-link"><i class="fa-solid fa-clock-rotate-left"></i><span>Timeline</span></a>
            <a href="/Profile/Complaints" class="mb-more-link"><i class="fa-solid fa-triangle-exclamation"></i><span>Complaints</span></a>
            <a href="/Profile/Security" class="mb-more-link"><i class="fa-solid fa-lock"></i><span>Security</span></a>
        </div>
    </div>

    <div class="toast" id="toast"></div>
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="/Home/Index">Home</a><span>|</span>
                <a href="/Clinics/Index">Clinics</a><span>|</span>
                <a href="/Stores/Index">Supplies</a><span>|</span>
                <a href="/About/Index">About Us</a>
            </div>
            <p>&#169; 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        document.querySelectorAll('a[href^="#editForm_"]').forEach(btn => {
            btn.addEventListener('click', e => {
                e.preventDefault();
                const id  = btn.getAttribute('href').substring(1);
                const frm = document.getElementById(id);
                if (frm) frm.style.display = frm.style.display === 'none' ? 'block' : 'none';
            });
        });

        
        function toggleRequests(id) {
            const el = document.getElementById(id);
            if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
        }

    </script>
</body>
</html>