@model Waffy.Models.Store
@{
    Layout = null;
    ViewData["Title"] = "Waffy — Store Admin | Settings";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-theme.css">
    <link rel="stylesheet" href="~/css/waffy-store-compat.css">
    <style>
        .settings-layout { display:grid; grid-template-columns:220px 1fr; gap:16px; align-items:start }
        .settings-nav { background:#fff; border:1px solid var(--border); border-radius:var(--r-lg); overflow:hidden; box-shadow:var(--shadow-sm) }
        .settings-nav-item { display:flex; align-items:center; gap:8px; padding:12px 16px; font-size:.84rem; font-weight:700; color:var(--text-muted); cursor:pointer; border-bottom:1px solid var(--border); transition:.18s; border-left:3px solid transparent }
        .settings-nav-item:hover { background:var(--brand-ghost); color:var(--brand-dark) }
        .settings-nav-item.on { background:var(--brand-xlight); color:var(--brand-dark); font-weight:900; border-left-color:var(--brand) }
        .settings-nav-item:last-child { border-bottom:none }
        .settings-nav-ico { font-size:1rem; width:20px; text-align:center }
        .settings-content { background:#fff; border:1px solid var(--border); border-radius:var(--r-lg); padding:24px; box-shadow:var(--shadow-sm) }
        .settings-pane { display:none }
        .settings-pane.on { display:block }
        .settings-section-title { font-family:'Fredoka',sans-serif; font-size:1.05rem; font-weight:700; color:var(--brand-dark); margin-bottom:18px; padding-bottom:10px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:8px }
        .toggle-row { display:flex; align-items:center; justify-content:space-between; padding:12px 14px; background:var(--brand-ghost); border:1px solid var(--border); border-radius:12px; margin-bottom:8px }
        .toggle-row:last-child { margin-bottom:0 }
        .toggle-row-info { display:flex; align-items:center; gap:10px }
        .toggle-row-ico { font-size:1.1rem }
        .toggle-row-label { font-size:.86rem; font-weight:800; color:var(--brand-dark) }
        .toggle { width:40px; height:22px; background:rgba(139,169,74,0.22); border-radius:11px; position:relative; cursor:pointer; transition:.22s; flex-shrink:0 }
        .toggle.on { background:var(--brand) }
        .toggle::after { content:''; position:absolute; top:3px; left:3px; width:16px; height:16px; background:#fff; border-radius:50%; transition:.22s; box-shadow:0 1px 4px rgba(0,0,0,.18) }
        .toggle.on::after { transform:translateX(18px) }
        @@media(max-width:900px) {
            .settings-layout { grid-template-columns:1fr }
            .settings-nav { display:grid; grid-template-columns:repeat(3,1fr) }
            .settings-nav-item { border-left:none; border-bottom:1px solid var(--border); border-right:1px solid var(--border); justify-content:center; text-align:center; padding:10px 8px; font-size:.78rem }
            .settings-nav-item.on { border-left:none; border-bottom:2px solid var(--brand) }
        }
        @@media(max-width:500px) { .settings-nav { grid-template-columns:repeat(2,1fr) } }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Store Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Dashboard","StoreAdmin")" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Store</div>
                    <a class="sb-row" href="@Url.Action("Products","StoreAdmin")" data-tip="Products">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                        <span class="sb-lbl">Products</span>
                        <span class="sb-bdg bd-g" id="productsCountBadge">0</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Orders","StoreAdmin")" data-tip="Orders">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/></svg></span>
                        <span class="sb-lbl">Orders</span>
                        <span class="sb-bdg bd-y" id="ordersCountBadge">0</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Customers","StoreAdmin")" data-tip="Customers">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                        <span class="sb-lbl">Customers</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Reviews","StoreAdmin")" data-tip="Reviews">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
                        <span class="sb-lbl">Reviews</span>
                        <span class="sb-bdg bd-r" id="reviewsCountBadge">0</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Adoption","StoreAdmin")" data-tip="Adoption">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
                        <span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <a class="sb-row" href="@Url.Action("Notifications","StoreAdmin")" data-tip="Notifications">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
                        <span class="sb-lbl">Notifications</span>
                        <span class="sb-bdg bd-r" id="notifCountBadge">0</span>
                    </a>
                    <a class="sb-row active" href="@Url.Action("Settings","StoreAdmin")" data-tip="Settings">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                        <span class="sb-lbl">Store Settings</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Subscription","StoreAdmin")" data-tip="Subscription">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></span>
                        <span class="sb-lbl">Subscription</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.OwnerInitial</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.OwnerName</div>
                        <div class="sb-user-role">@ViewBag.StoreName</div>
                    </div>
                </div>
                <a class="sb-logout" href="@Url.Action("Logout","Account")">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <nav class="tn-bread"><span>Store</span><span>/</span><b>Store Settings</b></nav>
            <div class="tn-center"><div class="tn-center-main">Store Settings</div><div class="tn-center-sub">Store Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <button class="tn-btn" type="button"><svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
                <a class="tn-btn" href="@Url.Action("Notifications","StoreAdmin")">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <span class="tn-count" id="tnNotifCount">0</span>
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.OwnerInitial</div>
                    <div><div class="tn-pname">@ViewBag.OwnerName</div><div class="tn-prole">@ViewBag.StoreName</div></div>
                </div>
            </div>
        </header>

        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div class="page-hero-text">
                    <h1>Store Settings ⚙️</h1>
                    <p>Manage store info, images, delivery options, payment methods, and security.</p>
                </div>
                <div class="page-hero-actions">
                    <button class="btn btn-primary" form="settingsForm" type="submit">💾 Save Changes</button>
                </div>
            </section>

            <div class="page-body">

                @if (TempData["SettingsSuccess"] != null)
                {
                    <div class="info-box" style="margin-bottom:16px;background:var(--gp);border-color:var(--brand)">
                        @TempData["SettingsSuccess"]
                    </div>
                }

                <form id="settingsForm"
                      method="post"
                      asp-action="Settings"
                      asp-controller="StoreAdmin"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="settings-layout">
                        <div class="settings-nav">
                            <div class="settings-nav-item on" onclick="switchSettings(this,'st-info')"><span class="settings-nav-ico">🏪</span> Store Info</div>
                            <div class="settings-nav-item" onclick="switchSettings(this,'st-media')"><span class="settings-nav-ico">🖼</span> Images</div>
                            <div class="settings-nav-item" onclick="switchSettings(this,'st-contact')"><span class="settings-nav-ico">📞</span> Contact</div>
                            <div class="settings-nav-item" onclick="switchSettings(this,'st-delivery')"><span class="settings-nav-ico">🚚</span> Delivery</div>
                            <div class="settings-nav-item" onclick="switchSettings(this,'st-payment')"><span class="settings-nav-ico">💳</span> Payment</div>
                            <div class="settings-nav-item" onclick="switchSettings(this,'st-security')"><span class="settings-nav-ico">🔒</span> Security</div>
                        </div>

                        <div class="settings-content">

                            <!-- ── Store Info ── -->
                            <div class="settings-pane on" id="st-info">
                                <div class="settings-section-title">🏪 Basic Store Information</div>
                                <div class="form-group">
                                    <div class="form-field full">
                                        <label class="form-label">Store Name <span class="req">*</span></label>
                                        <input class="form-input" name="name" value="@Model.Name" required>
                                    </div>
                                    <div class="form-field full">
                                        <label class="form-label">Store Description</label>
                                        <textarea class="form-textarea" name="description">@Model.Description</textarea>
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Store Type</label>
                                        <select class="form-select" name="storeType">
                                            <option value="All Pet Supplies" >All Pet Supplies</option>
                                            <option value="Pet Food" >Pet Food</option>
                                            <option value="Pet Accessories" >Pet Accessories</option>
                                            <option value="Pet Pharmacy" >Pet Pharmacy</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- ── Images ── -->
                            <div class="settings-pane" id="st-media">
                                <div class="settings-section-title">🖼 Images & Logo</div>

                                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                                {
                                    <div style="margin-bottom:12px">
                                        <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:4px">Current Logo:</div>
                                        <img src="@Model.LogoUrl" alt="Logo" style="width:80px;height:80px;object-fit:contain;border-radius:12px;border:1px solid var(--border)">
                                    </div>
                                }

                                <div class="form-group">
                                    <div class="form-field full">
                                        <label class="form-label">Store Logo</label>
                                        <label class="upload-zone" for="logoInput">
                                            <span class="upload-zone-ico">🖼️</span>
                                            <span class="upload-zone-label">Upload new Logo</span>
                                            <span class="upload-zone-hint">PNG or SVG — 512×512px recommended</span>
                                        </label>
                                        <input id="logoInput" type="file" name="logoFile" accept="image/*" hidden>
                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                                    {
                                        <div class="form-field full" style="margin-bottom:8px">
                                            <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:4px">Current Banner:</div>
                                            <img src="@Model.CoverImageUrl" alt="Banner" style="width:100%;max-height:100px;object-fit:cover;border-radius:12px;border:1px solid var(--border)">
                                        </div>
                                    }

                                    <div class="form-field full">
                                        <label class="form-label">Store Banner</label>
                                        <label class="upload-zone" for="bannerInput">
                                            <span class="upload-zone-ico">🏞</span>
                                            <span class="upload-zone-label">Upload new Banner</span>
                                            <span class="upload-zone-hint">PNG or JPG — 1200×400px</span>
                                        </label>
                                        <input id="bannerInput" type="file" name="coverFile" accept="image/*" hidden>
                                    </div>
                                </div>
                            </div>

                            <!-- ── Contact ── -->
                            <div class="settings-pane" id="st-contact">
                                <div class="settings-section-title">📞 Contact & Location</div>
                                <div class="form-group">
                                    <div class="form-field full">
                                        <label class="form-label">Store Email</label>
                                        <input class="form-input" name="email" value="@Model.Email" type="email">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Phone</label>
                                        <input class="form-input" name="phone" value="@Model.Phone">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">WhatsApp</label>
                                        <input class="form-input" name="whatsApp" value="@Model.WhatsApp">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">City</label>
                                        <select class="form-select" name="city">
                                            @foreach (var c in new[]{"Amman","Zarqa","Irbid","Salt","Aqaba","Madaba","Jerash"})
                                            {
                                                <option ></option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Area / Street</label>
                                        <input class="form-input" name="area" value="@Model.Area">
                                    </div>
                                    <div class="form-field full">
                                        <label class="form-label">Full Address</label>
                                        <input class="form-input" name="address" value="@Model.Address">
                                    </div>
                                </div>
                            </div>

                            <!-- ── Delivery ── -->
                            <div class="settings-pane" id="st-delivery">
                                <div class="settings-section-title">🚚 Delivery Settings</div>
                                <div class="form-group">
                                    <div class="form-field full">
                                        <label class="form-label">Delivery Available?</label>
                                        <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
                                            <div class="toggle @(Model.DeliveryAvailable ? "on" : "")"
                                                 id="deliveryToggle"
                                                 onclick="toggleDelivery()"></div>
                                            <span id="deliveryToggleLabel" style="font-size:.84rem;color:var(--text-muted);font-weight:700">
                                                @(Model.DeliveryAvailable ? "Yes, we offer delivery" : "No delivery available")
                                            </span>
                                            <input type="hidden" name="deliveryAvailable" id="deliveryAvailableInput" value="@(Model.DeliveryAvailable ? "true" : "false")">
                                        </div>
                                    </div>
                                    <div class="form-field full">
                                        <label class="form-label">Delivery Areas</label>
                                        <textarea class="form-textarea" name="deliveryAreas" style="min-height:70px">@Model.DeliveryAreas</textarea>
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Opening Time</label>
                                        <input class="form-input" name="openTime" type="time"
                                               value="@(Model.OpenTime.HasValue ? Model.OpenTime.Value.ToString(@"hh\:mm") : "")">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Closing Time</label>
                                        <input class="form-input" name="closeTime" type="time"
                                               value="@(Model.CloseTime.HasValue ? Model.CloseTime.Value.ToString(@"hh\:mm") : "")">
                                    </div>
                                    <div class="form-field full">
                                        <label class="form-label">Working Days</label>
                                        <input class="form-input" name="workingDays" value="@Model.WorkingDays" placeholder="e.g. Sun-Thu">
                                    </div>
                                </div>
                            </div>

                            <!-- ── Payment ── -->
                            <div class="settings-pane" id="st-payment">
                                <div class="settings-section-title">💳 Accepted Payment Methods</div>
                                <input type="hidden" name="acceptedPayments" id="acceptedPaymentsInput" value="@Model.AcceptedPayments">
                                @{
                                    var accepted = Model.AcceptedPayments ?? "";
                                }
                                <div class="toggle-row">
                                    <div class="toggle-row-info"><span class="toggle-row-ico">💵</span><span class="toggle-row-label">Cash on Delivery</span></div>
                                    <div class="toggle @(accepted.Contains("Cash") ? "on" : "")" onclick="togglePayment(this,'Cash')"></div>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-row-info"><span class="toggle-row-ico">💳</span><span class="toggle-row-label">Online Payment (Card)</span></div>
                                    <div class="toggle @(accepted.Contains("Card") ? "on" : "")" onclick="togglePayment(this,'Card')"></div>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-row-info"><span class="toggle-row-ico">👛</span><span class="toggle-row-label">Waffy Wallet</span></div>
                                    <div class="toggle @(accepted.Contains("Wallet") ? "on" : "")" onclick="togglePayment(this,'Wallet')"></div>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-row-info"><span class="toggle-row-ico">📱</span><span class="toggle-row-label">CliQ / Instant Transfer</span></div>
                                    <div class="toggle @(accepted.Contains("CliQ") ? "on" : "")" onclick="togglePayment(this,'CliQ')"></div>
                                </div>
                            </div>

                            <!-- ── Security ── -->
                            <div class="settings-pane" id="st-security">
                                <div class="settings-section-title">🔒 Account Security</div>
                                <div class="form-group">
                                    <div class="form-field full">
                                        <label class="form-label">Current Password</label>
                                        <input class="form-input" type="password" placeholder="••••••••">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">New Password</label>
                                        <input class="form-input" type="password" placeholder="••••••••">
                                    </div>
                                    <div class="form-field">
                                        <label class="form-label">Confirm New Password</label>
                                        <input class="form-input" type="password" placeholder="••••••••">
                                    </div>
                                    <div class="form-field full">
                                        <label class="form-label">Two-Factor Authentication (2FA)</label>
                                        <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
                                            <div class="toggle" onclick="this.classList.toggle('on')"></div>
                                            <span style="font-size:.84rem;color:var(--text-muted);font-weight:700">Currently disabled — click to enable</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div><!-- settings-content -->
                    </div><!-- settings-layout -->
                </form>
            </div>
        </main>
    </div>
    <div id="toast">✅ Done!</div>

    <script>
        /* ── Delivery Toggle ── */
        function toggleDelivery() {
            const toggle = document.getElementById('deliveryToggle');
            const input  = document.getElementById('deliveryAvailableInput');
            const label  = document.getElementById('deliveryToggleLabel');
            const isOn   = toggle.classList.toggle('on');
            input.value  = isOn ? 'true' : 'false';
            label.textContent = isOn ? 'Yes, we offer delivery' : 'No delivery available';
        }

        /* ── Payment Toggles ── */
        function togglePayment(el, method) {
            el.classList.toggle('on');
            const input   = document.getElementById('acceptedPaymentsInput');
            const methods = input.value ? input.value.split(',').map(s => s.trim()).filter(Boolean) : [];
            const idx     = methods.indexOf(method);
            if (idx === -1) methods.push(method);
            else methods.splice(idx, 1);
            input.value = methods.join(',');
        }

        /* ── Settings Pane Switcher ── */
        function switchSettings(el, paneId) {
            document.querySelectorAll('.settings-nav-item').forEach(i => i.classList.remove('on'));
            document.querySelectorAll('.settings-pane').forEach(p => p.classList.remove('on'));
            el.classList.add('on');
            document.getElementById(paneId)?.classList.add('on');
        }

        /* ── Sidebar ── */
        const shell=document.getElementById('waShell'),sb=document.getElementById('waSb'),ovl=document.getElementById('waOvl');
        const mob=()=>window.innerWidth<=992;let mini=false;
        function save(v){localStorage.setItem('wa_mini',v);}
        function miniOn(){mini=true;shell.classList.add('mini');save('1');}
        function miniOff(){mini=false;shell.classList.remove('mini');save('0');}
        function openMob(){sb.classList.add('mob-open');ovl.classList.add('show');document.body.style.overflow='hidden';}
        function closeMob(){sb.classList.remove('mob-open');ovl.classList.remove('show');document.body.style.overflow='';}
        function toggleSb(){if(mob()){sb.classList.contains('mob-open')?closeMob():openMob();}else{mini?miniOff():miniOn();}}
        function toggleSidebar(){toggleSb();}function closeSidebar(){closeMob();}
        function openModal(id){document.getElementById(id)?.classList.add('on');}
        function closeModal(id){document.getElementById(id)?.classList.remove('on');}
        let rt;window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(()=>{if(!mob()){closeMob();localStorage.getItem('wa_mini')==='1'?miniOn():miniOff();}else{shell.classList.remove('mini');mini=false;}},90);});
        document.addEventListener('keydown',e=>{if(e.key==='['&&!e.ctrlKey&&!e.metaKey)toggleSb();if(e.key==='Escape')closeMob();});
        let tx=0;
        document.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
        document.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-tx;if(!mob())return;if(dx>55&&tx<28)openMob();if(dx<-55)closeMob();},{passive:true});
        document.addEventListener('DOMContentLoaded',()=>{
            if(!mob()&&localStorage.getItem('wa_mini')==='1')miniOn();
            const el=document.getElementById('tnNotifCount'),b=document.getElementById('notifCountBadge');
            if(el&&b)el.textContent=b.textContent;
        });
    </script>
    <script src="~/js/AdminStore.js"></script>
</body>
</html>
