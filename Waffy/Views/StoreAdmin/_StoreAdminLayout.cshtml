@{
    string activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
    string pageTitle = ViewData["PageTitle"]?.ToString() ?? "Store Admin";
    string breadSection = ViewData["BreadSection"]?.ToString() ?? "Store";
    string breadPage = ViewData["BreadPage"]?.ToString() ?? pageTitle;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — @pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-theme.css">
    <link rel="stylesheet" href="~/css/waffy-store-compat.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ════════════ SIDEBAR ════════════ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Store Admin</div>
                </div>
            </div>

            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row @(activeNav == "Dashboard" ? "active" : "")"
                       href="@Url.Action("Dashboard", "StoreAdmin")" data-tip="Dashboard">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                                <rect x="3" y="14" width="7" height="7" rx="1.5" />
                                <rect x="14" y="14" width="7" height="7" rx="1.5" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group">
                    <div class="sb-grp-hd">Store</div>
                    <a class="sb-row @(activeNav == "Products" ? "active" : "")"
                       href="@Url.Action("Products", "StoreAdmin")" data-tip="Products">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                                <line x1="3" y1="6" x2="21" y2="6" />
                                <path d="M16 10a4 4 0 0 1-8 0" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Products</span>
                        <span class="sb-bdg bd-g" id="productsCountBadge">0</span>
                    </a>

                    <a class="sb-row @(activeNav == "Orders" ? "active" : "")"
                       href="@Url.Action("Orders", "StoreAdmin")" data-tip="Orders">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Orders</span>
                        <span class="sb-bdg bd-y" id="ordersCountBadge">0</span>
                    </a>

                    <a class="sb-row @(activeNav == "Customers" ? "active" : "")"
                       href="@Url.Action("Customers", "StoreAdmin")" data-tip="Customers">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Customers</span>
                    </a>

                    <a class="sb-row @(activeNav == "Reviews" ? "active" : "")"
                       href="@Url.Action("Reviews", "StoreAdmin")" data-tip="Reviews">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reviews</span>
                        <span class="sb-bdg bd-r" id="reviewsCountBadge">0</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group sb-group-flat">
                    <a class="sb-row @(activeNav == "Adoption" ? "active" : "")"
                       href="@Url.Action("Adoption", "StoreAdmin")" data-tip="Adoption">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Adoption</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <a class="sb-row @(activeNav == "Notifications" ? "active" : "")"
                       href="@Url.Action("Notifications", "StoreAdmin")" data-tip="Notifications">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Notifications</span>
                        <span class="sb-bdg bd-r" id="notifCountBadge">0</span>
                    </a>

                    <a class="sb-row @(activeNav == "Settings" ? "active" : "")"
                       href="@Url.Action("SettingsInfo", "StoreAdmin")" data-tip="Settings">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3" />
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Store Settings</span>
                    </a>

                    <a class="sb-row @(activeNav == "Subscription" ? "active" : "")"
                       href="@Url.Action("Subscription", "StoreAdmin")" data-tip="Subscription">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <rect x="1" y="4" width="22" height="16" rx="2" ry="2" />
                                <line x1="1" y1="10" x2="23" y2="10" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Subscription</span>
                    </a>
                </div>
            </nav>

            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.OwnerInitial</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.OwnerName</div>
                        <div class="sb-user-role">@ViewBag.StoreName</div>
                    </div>
                </div>
                <a class="sb-logout" href="@Url.Action("Logout", "Account")">
                    <svg class="ico" viewBox="0 0 24 24">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ════════════ TOPNAV ════════════ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <nav class="tn-bread">
                <span>@breadSection</span>
                <span>/</span>
                <b>@breadPage</b>
            </nav>
            <div class="tn-center">
                <div class="tn-center-main">@breadPage</div>
                <div class="tn-center-sub">Store Admin Panel</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
               
                <a class="tn-btn" href="@Url.Action("Notifications", "StoreAdmin")">
                    <svg class="ico" viewBox="0 0 24 24">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span class="tn-count" id="tnNotifCount">0</span>
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.OwnerInitial</div>
                    <div>
                        <div class="tn-pname">@ViewBag.OwnerName</div>
                        <div class="tn-prole">@ViewBag.StoreName</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ════════════ MAIN CONTENT ════════════ -->
        <main class="wa-main" id="waMain">
            @RenderBody()
        </main>

    </div><!-- wa-shell -->

    <div id="toast">✅ Done!</div>

    <script>
        // ── Sidebar JS ──
        const shell = document.getElementById('waShell'),
              sb    = document.getElementById('waSb'),
              ovl   = document.getElementById('waOvl');
        const mob = () => window.innerWidth <= 992;
        let mini = false;
        function save(v) { localStorage.setItem('wa_mini', v); }
        function miniOn()  { mini = true;  shell.classList.add('mini');    save('1'); }
        function miniOff() { mini = false; shell.classList.remove('mini'); save('0'); }
        function openMob()  { sb.classList.add('mob-open');    ovl.classList.add('show');    document.body.style.overflow = 'hidden'; }
        function closeMob() { sb.classList.remove('mob-open'); ovl.classList.remove('show'); document.body.style.overflow = ''; }
        function toggleSb() {
            if (mob()) { sb.classList.contains('mob-open') ? closeMob() : openMob(); }
            else        { mini ? miniOff() : miniOn(); }
        }
        function openModal(id)  { document.getElementById(id)?.classList.add('on'); }
        function closeModal(id) { document.getElementById(id)?.classList.remove('on'); }
        function showToast(msg = '✅ Done!') {
            const t = document.getElementById('toast');
            if (!t) return;
            t.textContent = msg;
            t.style.display = 'flex';
            setTimeout(() => { t.style.display = 'none'; }, 2200);
        }

        let rt;
        window.addEventListener('resize', () => {
            clearTimeout(rt);
            rt = setTimeout(() => {
                if (!mob()) { closeMob(); localStorage.getItem('wa_mini') === '1' ? miniOn() : miniOff(); }
                else        { shell.classList.remove('mini'); mini = false; }
            }, 90);
        });
        document.addEventListener('keydown', e => {
            if (e.key === '[' && !e.ctrlKey && !e.metaKey) toggleSb();
            if (e.key === 'Escape') closeMob();
        });
        let tx = 0;
        document.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
        document.addEventListener('touchend',   e => {
            const dx = e.changedTouches[0].clientX - tx;
            if (!mob()) return;
            if (dx >  55 && tx < 28) openMob();
            if (dx < -55)            closeMob();
        }, { passive: true });

        document.addEventListener('DOMContentLoaded', () => {
            if (!mob() && localStorage.getItem('wa_mini') === '1') miniOn();
        });
    </script>

    <script src="~/js/AdminStore.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
