@model Waffy.Models.Store
@{
    Layout = "~/Views/StoreAdmin/_StoreAdminLayout.cshtml";
    ViewData["Title"] = "Store Settings — Delivery";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ActiveSettings"] = "Delivery";
    ViewData["BreadSection"] = "Settings";
    ViewData["BreadPage"] = "Delivery Settings";
}

@section Styles {
    <style>
        .settings-layout {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 16px;
            align-items: start
        }

        .settings-nav {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm)
        }

        .settings-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            font-size: .84rem;
            font-weight: 700;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            border-left: 3px solid transparent;
            text-decoration: none;
            transition: .18s
        }

            .settings-nav-item:hover {
                background: var(--brand-ghost);
                color: var(--brand-dark)
            }

            .settings-nav-item.on {
                background: var(--brand-xlight);
                color: var(--brand-dark);
                font-weight: 900;
                border-left-color: var(--brand)
            }

            .settings-nav-item:last-child {
                border-bottom: none
            }

        .settings-nav-ico {
            font-size: 1rem;
            width: 20px;
            text-align: center
        }

        .settings-content {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm)
        }

        .settings-section-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px
        }

        .toggle {
            width: 40px;
            height: 22px;
            background: rgba(139,169,74,.22);
            border-radius: 11px;
            position: relative;
            cursor: pointer;
            transition: .22s;
            flex-shrink: 0
        }

            .toggle.on {
                background: var(--brand)
            }

            .toggle::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
                background: #fff;
                border-radius: 50%;
                transition: .22s;
                box-shadow: 0 1px 4px rgba(0,0,0,.18)
            }

            .toggle.on::after {
                transform: translateX(18px)
            }

        @@media(max-width:900px) {
            .settings-layout {
                grid-template-columns: 1fr
            }

            .settings-nav {
                display: grid;
                grid-template-columns: repeat(3,1fr)
            }

            .settings-nav-item {
                border-left: none;
                border-right: 1px solid var(--border);
                justify-content: center;
                text-align: center;
                padding: 10px 8px;
                font-size: .78rem
            }

                .settings-nav-item.on {
                    border-left: none;
                    border-bottom: 2px solid var(--brand)
                }
        }

        @@media(max-width:500px) {
            .settings-nav {
                grid-template-columns: repeat(2,1fr)
            }
        }
    </style>
}

<section class="page-hero">
    <div class="page-hero-text">
        <h1>Store Settings ⚙️</h1>
        <p>Configure your delivery options and working hours.</p>
    </div>
    <div class="page-hero-actions">
        <button class="btn btn-primary" form="settingsForm" type="submit">💾 Save Changes</button>
    </div>
</section>

<div class="page-body">

    @if (TempData["Success"] != null)
    {
        <div class="info-box" style="margin-bottom:16px;background:var(--gp);border-color:var(--brand)">
            @TempData["Success"]
        </div>
    }

    <div class="settings-layout">

        @await Html.PartialAsync("_SettingsNav")

        <div class="settings-content">
            <form id="settingsForm"
                  method="post"
                  asp-action="SettingsDelivery"
                  asp-controller="StoreAdmin">
                @Html.AntiForgeryToken()

                <div class="settings-section-title">🚚 Delivery Settings</div>

                <div class="form-group">

                    <!-- Delivery Toggle -->
                    <div class="form-field full">
                        <label class="form-label">Delivery Available?</label>
                        <div style="display:flex;align-items:center;gap:10px;margin-top:4px">
                            <div class="toggle @(Model.DeliveryAvailable ? "on" : "")"
                                 id="deliveryToggle"
                                 onclick="toggleDelivery()"></div>
                            <span id="deliveryToggleLabel"
                                  style="font-size:.84rem;color:var(--text-muted);font-weight:700">
                                @(Model.DeliveryAvailable ? "Yes, we offer delivery" : "No delivery available")
                            </span>
                            <input type="hidden" name="deliveryAvailable" id="deliveryAvailableInput"
                                   value="@(Model.DeliveryAvailable ? "true" : "false")">
                        </div>
                    </div>

                    <div class="form-field full">
                        <label class="form-label">Delivery Areas</label>
                        <textarea class="form-textarea" name="deliveryAreas"
                                  style="min-height:70px">@Model.DeliveryAreas</textarea>
                    </div>

                    <div class="form-field">
                        <label class="form-label">Opening Time</label>
                        <input class="form-input" name="openTime" type="time"
                               value="@(Model.OpenTime.HasValue? Model.OpenTime.Value.ToString(@"hh\:mm") : "")">
                    </div>

                    <div class="form-field">
                        <label class="form-label">Closing Time</label>
                        <input class="form-input" name="closeTime" type="time"
                               value="@(Model.CloseTime.HasValue? Model.CloseTime.Value.ToString(@"hh\:mm") : "")">
                    </div>

                    <div class="form-field full">
                        <label class="form-label">Working Days</label>
                        <input class="form-input" name="workingDays"
                               value="@Model.WorkingDays"
                               placeholder="e.g. Sun-Thu">
                    </div>
                </div>

                <div style="text-align:right;margin-top:20px">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function toggleDelivery() {
            const toggle = document.getElementById('deliveryToggle');
            const input  = document.getElementById('deliveryAvailableInput');
            const label  = document.getElementById('deliveryToggleLabel');
            const isOn   = toggle.classList.toggle('on');
            input.value  = isOn ? 'true' : 'false';
            label.textContent = isOn ? 'Yes, we offer delivery' : 'No delivery available';
        }
    </script>
}
