@{
    Layout = "~/Views/StoreAdmin/_StoreAdminLayout.cshtml";
    ViewData["Title"] = "Store Settings — Security";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ActiveSettings"] = "Security";
    ViewData["BreadSection"] = "Settings";
    ViewData["BreadPage"] = "Account Security";
}

@section Styles {
    <style>
        .settings-layout {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 16px;
            align-items: start
        }

        .settings-nav {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm)
        }

        .settings-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            font-size: .84rem;
            font-weight: 700;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            border-left: 3px solid transparent;
            text-decoration: none;
            transition: .18s
        }

            .settings-nav-item:hover {
                background: var(--brand-ghost);
                color: var(--brand-dark)
            }

            .settings-nav-item.on {
                background: var(--brand-xlight);
                color: var(--brand-dark);
                font-weight: 900;
                border-left-color: var(--brand)
            }

            .settings-nav-item:last-child {
                border-bottom: none
            }

        .settings-nav-ico {
            font-size: 1rem;
            width: 20px;
            text-align: center
        }

        .settings-content {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm)
        }

        .settings-section-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px
        }

        .toggle {
            width: 40px;
            height: 22px;
            background: rgba(139,169,74,.22);
            border-radius: 11px;
            position: relative;
            cursor: pointer;
            transition: .22s;
            flex-shrink: 0
        }

            .toggle.on {
                background: var(--brand)
            }

            .toggle::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
                background: #fff;
                border-radius: 50%;
                transition: .22s;
                box-shadow: 0 1px 4px rgba(0,0,0,.18)
            }

            .toggle.on::after {
                transform: translateX(18px)
            }

        @@media(max-width:900px) {
            .settings-layout {
                grid-template-columns: 1fr
            }

            .settings-nav {
                display: grid;
                grid-template-columns: repeat(3,1fr)
            }

            .settings-nav-item {
                border-left: none;
                border-right: 1px solid var(--border);
                justify-content: center;
                text-align: center;
                padding: 10px 8px;
                font-size: .78rem
            }

                .settings-nav-item.on {
                    border-left: none;
                    border-bottom: 2px solid var(--brand)
                }
        }

        @@media(max-width:500px) {
            .settings-nav {
                grid-template-columns: repeat(2,1fr)
            }
        }
    </style>
}

<section class="page-hero">
    <div class="page-hero-text">
        <h1>Store Settings ⚙️</h1>
        <p>Change your password and manage account security.</p>
    </div>
    <div class="page-hero-actions">
        <button class="btn btn-primary" form="settingsForm" type="submit">💾 Save Changes</button>
    </div>
</section>

<div class="page-body">

    @if (TempData["Success"] != null)
    {
        <div class="info-box" style="margin-bottom:16px;background:var(--gp);border-color:var(--brand)">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="info-box" style="margin-bottom:16px;background:#fff0f0;border-color:#e74c3c;color:#c0392b">
            @TempData["Error"]
        </div>
    }

    <div class="settings-layout">

        @await Html.PartialAsync("_SettingsNav")

        <div class="settings-content">
            <form id="settingsForm"
                  method="post"
                  asp-action="SettingsSecurity"
                  asp-controller="StoreAdmin">
                @Html.AntiForgeryToken()

                <div class="settings-section-title">🔒 Change Password</div>

                <div class="form-group">
                    <div class="form-field full">
                        <label class="form-label">Current Password</label>
                        <input class="form-input" type="password" name="currentPassword"
                               placeholder="••••••••" autocomplete="current-password">
                    </div>

                    <div class="form-field">
                        <label class="form-label">New Password</label>
                        <input class="form-input" type="password" name="newPassword"
                               id="newPasswordInput"
                               placeholder="••••••••" autocomplete="new-password">
                    </div>

                    <div class="form-field">
                        <label class="form-label">Confirm New Password</label>
                        <input class="form-input" type="password" name="confirmPassword"
                               id="confirmPasswordInput"
                               placeholder="••••••••" autocomplete="new-password"
                               oninput="checkPasswordMatch()">
                        <span id="pwMatchMsg" style="font-size:.76rem;margin-top:4px;display:none"></span>
                    </div>
                </div>

                

                <div style="text-align:right;margin-top:24px">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function checkPasswordMatch() {
            const np  = document.getElementById('newPasswordInput').value;
            const cp  = document.getElementById('confirmPasswordInput').value;
            const msg = document.getElementById('pwMatchMsg');
            if (!cp) { msg.style.display = 'none'; return; }
            if (np === cp) {
                msg.textContent = '✅ Passwords match';
                msg.style.color = 'var(--brand-dark)';
            } else {
                msg.textContent = '❌ Passwords do not match';
                msg.style.color = '#e74c3c';
            }
            msg.style.display = 'block';
        }
    </script>
}
