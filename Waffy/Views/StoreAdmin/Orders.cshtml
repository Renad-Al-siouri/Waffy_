@{
    Layout = null;
    ViewData["Title"] = "Waffy — Store Admin | Orders";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-theme.css">
    <link rel="stylesheet" href="~/css/waffy-store-compat.css">
    <style>
        /* ── CliQ Confirm Form ── */
        .cliq-confirm-form {
            background: #fff8e1;
            border: 2px solid #ffb74d;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 4px;
        }

            .cliq-confirm-form .cf-title {
                font-weight: 800;
                font-size: .88rem;
                color: #e65100;
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

        .cliq-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        .cliq-info-cell {
            background: #fff;
            border-radius: 10px;
            padding: 10px 12px;
            border: 1px solid #ffe0b2;
        }

            .cliq-info-cell .cell-lbl {
                font-size: .68rem;
                color: #888;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .cliq-info-cell .cell-val {
                font-weight: 900;
                color: #bf360c;
                font-family: monospace;
                font-size: 1.3rem;
                letter-spacing: 4px;
            }

                .cliq-info-cell .cell-val.num {
                    font-family: inherit;
                    font-size: .95rem;
                    letter-spacing: 0;
                    color: #1b5e20;
                }

        .cliq-warning-box {
            background: #fff3e0;
            border-radius: 8px;
            padding: 10px 12px;
            font-size: .78rem;
            color: #bf360c;
            font-weight: 700;
            line-height: 1.6;
            margin-bottom: 12px;
        }

        .cliq-confirm-btn {
            width: 100%;
            background: linear-gradient(135deg, #2e7d32, #43a047);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 12px;
            font-size: .88rem;
            font-weight: 800;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: .2s;
        }

            .cliq-confirm-btn:hover {
                opacity: .9;
                transform: translateY(-1px);
            }

            .cliq-confirm-btn:disabled {
                opacity: .5;
                cursor: not-allowed;
                transform: none;
            }

        /* ── Wallet Insufficient Box ── */
        .wallet-insufficient-box {
            background: #fff3e0;
            border: 2px solid #ffb74d;
            border-radius: 14px;
            padding: 16px;
        }

            .wallet-insufficient-box .wi-title {
                font-weight: 800;
                font-size: .88rem;
                color: #e65100;
                margin-bottom: 8px;
            }

            .wallet-insufficient-box .wi-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #fff;
                border-radius: 8px;
                padding: 8px 12px;
                margin-bottom: 10px;
                font-size: .82rem;
            }

                .wallet-insufficient-box .wi-row span:last-child {
                    font-weight: 900;
                    color: #c62828;
                }

            .wallet-insufficient-box .wi-msg {
                font-size: .78rem;
                color: #e65100;
                font-weight: 700;
                margin-bottom: 12px;
                line-height: 1.5;
            }

        .wallet-go-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #4527a0;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 18px;
            font-size: .84rem;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: .2s;
        }

            .wallet-go-btn:hover {
                opacity: .9;
            }

        /* ── CliQ Verified Badge ── */
        .cliq-verified-box {
            background: #e8f5e9;
            border: 2px solid #66bb6a;
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 4px;
        }

            .cliq-verified-box .cv-title {
                font-weight: 800;
                font-size: .88rem;
                color: #2e7d32;
                margin-bottom: 6px;
            }

            .cliq-verified-box .cv-code {
                font-family: monospace;
                letter-spacing: 2px;
                font-weight: 900;
                color: #1b5e20;
            }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR ══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Store Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Dashboard", "StoreAdmin")" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Store</div>
                    <a class="sb-row" href="@Url.Action("Products", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span><span class="sb-lbl">Products</span></a>
                    <a class="sb-row active" href="@Url.Action("Orders", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /></svg></span><span class="sb-lbl">Orders</span></a>
                    <a class="sb-row" href="@Url.Action("Customers", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span><span class="sb-lbl">Customers</span></a>
                    <a class="sb-row" href="@Url.Action("Reviews", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg></span><span class="sb-lbl">Complaints</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Adoption", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span><span class="sb-lbl">Adoption</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <a class="sb-row" href="@Url.Action("Notifications", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span></a>
                    <a class="sb-row" href="@Url.Action("SettingsInfo", "StoreAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg></span><span class="sb-lbl">Store Settings</span></a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.OwnerInitial</div>
                    <div class="sb-user-info"><div class="sb-user-name">@ViewBag.OwnerName</div><div class="sb-user-role">@ViewBag.StoreName</div></div>
                </div>
                <a class="sb-logout" href="@Url.Action("Logout", "Account")">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ══ TOPNAV ══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
            <nav class="tn-bread"><span>Store</span><span>/</span><b>Orders</b></nav>
            <div class="tn-center"><div class="tn-center-main">Orders</div><div class="tn-center-sub">Store Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" href="@Url.Action("Notifications", "StoreAdmin")">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    @if ((int)(ViewBag.NotifCount ?? 0) > 0)
                    {
                        <span class="tn-count">@ViewBag.NotifCount</span>
                    }
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.OwnerInitial</div>
                    <div><div class="tn-pname">@ViewBag.OwnerName</div><div class="tn-prole">@ViewBag.StoreName</div></div>
                </div>
            </div>
        </header>

        <!-- ══ MAIN ══ -->
        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div class="page-hero-text"><h1>Orders 🧾</h1><p>Track and manage all customer orders.</p></div>
                <div class="page-hero-actions"><button class="btn btn-outline" onclick="exportOrders()">📥 Export</button></div>
            </section>
            <div class="page-body">

                <!-- Stats -->
                <div class="kpi-grid" style="grid-template-columns:repeat(6,1fr);margin-bottom:16px">
                    <div class="kpi-card" style="cursor:pointer;padding:12px" onclick="filterOrders('all')"><div class="kpi-val" id="statAll" style="font-size:1.6rem">0</div><div class="kpi-label">All</div></div>
                    <div class="kpi-card c3" style="cursor:pointer;padding:12px" onclick="filterOrders('pending')"><div class="kpi-val" id="statPending" style="font-size:1.6rem;color:var(--warning)">0</div><div class="kpi-label">Pending</div></div>
                    <div class="kpi-card c2" style="cursor:pointer;padding:12px" onclick="filterOrders('confirmed')"><div class="kpi-val" id="statConfirmed" style="font-size:1.6rem;color:var(--info)">0</div><div class="kpi-label">Confirmed</div></div>
                    <div class="kpi-card c5" style="cursor:pointer;padding:12px" onclick="filterOrders('preparing')"><div class="kpi-val" id="statPreparing" style="font-size:1.6rem;color:var(--purple)">0</div><div class="kpi-label">Preparing</div></div>
                    <div class="kpi-card c1" style="cursor:pointer;padding:12px" onclick="filterOrders('shipped')"><div class="kpi-val" id="statShipped" style="font-size:1.6rem;color:var(--success)">0</div><div class="kpi-label">Shipped</div></div>
                    <div class="kpi-card c1" style="cursor:pointer;padding:12px" onclick="filterOrders('delivered')"><div class="kpi-val" id="statDelivered" style="font-size:1.6rem">0</div><div class="kpi-label">Delivered</div></div>
                </div>

                <!-- Table -->
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="search-wrap" style="flex:1;max-width:320px"><span>🔍</span><input id="orderSearch" placeholder="Search by order ID or customer..."></div>
                        <select class="sel-wrap" id="orderStatusSelect" style="height:40px;width:auto;min-width:155px">
                            <option value="all">All statuses</option>
                            <option value="pending">Pending</option>
                            <option value="confirmed">Confirmed</option>
                            <option value="preparing">Preparing</option>
                            <option value="shipped">Shipped</option>
                            <option value="delivered">Delivered</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Order ID</th><th>Customer</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th>Action</th></tr></thead>
                            <tbody id="ordersBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Order Detail Modal -->
                <div class="overlay" id="orderModal">
                    <div class="modal wide">
                        <div class="modal-hd">
                            <div class="modal-title">🧾 Order Details</div>
                            <button class="modal-close" onclick="closeModal('orderModal')">✕</button>
                        </div>
                        <div class="modal-body" id="orderModalBody"></div>
                        <div class="modal-ft">
                            <button class="btn btn-outline" onclick="closeModal('orderModal')">Close</button>
                            <div id="orderStatusActions" style="display:flex;gap:.5rem;flex-wrap:wrap;width:100%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <div id="toast">✅ Done!</div>

    <script>window.serverOrders = @Html.Raw(ViewBag.OrdersJson ?? "[]");</script>

    <script>
        'use strict';

        /* ── Sidebar ── */
        const shell=document.getElementById('waShell'),sb=document.getElementById('waSb'),ovl=document.getElementById('waOvl');
        const mob=()=>window.innerWidth<=992; let mini=false;
        function save(v){localStorage.setItem('wa_mini',v);}
        function miniOn(){mini=true;shell.classList.add('mini');save('1');}
        function miniOff(){mini=false;shell.classList.remove('mini');save('0');}
        function openMob(){sb.classList.add('mob-open');ovl.classList.add('show');document.body.style.overflow='hidden';}
        function closeMob(){sb.classList.remove('mob-open');ovl.classList.remove('show');document.body.style.overflow='';}
        function toggleSb(){if(mob()){sb.classList.contains('mob-open')?closeMob():openMob();}else{mini?miniOff():miniOn();}}
        function openModal(id){document.getElementById(id)?.classList.add('on');}
        function closeModal(id){document.getElementById(id)?.classList.remove('on');}
        function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='flex';setTimeout(()=>t.style.display='none',2800);}
        let rt;
        window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(()=>{if(!mob()){closeMob();localStorage.getItem('wa_mini')==='1'?miniOn():miniOff();}else{shell.classList.remove('mini');mini=false;}},90);});
        document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMob();});

        /* ── Status Badge ── */
        function statusBadge(s){
            const c={pending:'#f39c12',confirmed:'#3498db',preparing:'#9b59b6',shipped:'#1abc9c',delivered:'#27ae60',cancelled:'#e74c3c'}[s]||'#999';
            return `<span style="background:${c}20;color:${c};border:1px solid ${c}40;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:800;text-transform:capitalize">${s}</span>`;
        }

        /* ── Items HTML ── */
        function buildItemsHtml(items){
            if(!items||!items.length) return '<li style="color:var(--text-muted)">No items</li>';
            return items.map(i=>{
                if(typeof i==='object'&&i!==null){
                    const lt=(parseFloat(i.price||0)*(i.qty||1)).toFixed(3);
                    const img=i.image
                        ?`<img src="${i.image}" style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid var(--border);flex-shrink:0" onerror="this.style.display='none'">`
                        :`<div style="width:48px;height:48px;border-radius:8px;background:var(--brand-ghost);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">📦</div>`;
                    return `<li style="list-style:none;display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
                        ${img}
                        <div style="flex:1;min-width:0">
                            <div style="font-weight:700;font-size:.84rem">${i.name||''}</div>
                            <div style="font-size:.74rem;color:var(--text-muted)">× ${i.qty||1} · ${parseFloat(i.price||0).toFixed(3)} JD</div>
                        </div>
                        <div style="font-weight:900;font-size:.84rem;color:var(--brand-dark);white-space:nowrap">${lt} JD</div>
                    </li>`;
                }
                return `<li style="font-size:.84rem;margin-bottom:4px">${i}</li>`;
            }).join('');
        }

        /* ── Delivery Person ── */
        function buildDeliveryPersonHtml(o){
            if(o.status!=='shipped'&&o.status!=='delivered') return '';
            const name=o.deliveryPersonName||'',phone=o.deliveryPersonPhone||'';
            return `<div style="margin-bottom:16px;padding:12px 14px;background:var(--brand-ghost);border:1px solid var(--border);border-radius:10px">
                <div style="font-size:.72rem;font-weight:800;color:var(--brand-dark);margin-bottom:6px">🚚 Delivery Person</div>
                ${name||phone
                    ?`<div style="font-weight:700;font-size:.88rem">${name||'—'}</div><div style="font-size:.78rem;color:var(--text-muted);margin-top:2px">📞 ${phone||'—'}</div>`
                    :`<div style="font-size:.78rem;color:var(--text-muted)">Not assigned yet.</div>`}
            </div>`;
        }

        /* ════════════════════════════════════════════════
           CliQ BLOCK — المنظم الجديد
           ════════════════════════════════════════════════ */
        function buildCliQHtml(o){
            if((o.paymentMethod||'').toLowerCase()!=='cliq') return '';
            const code=o.cliqCode||'—';
            const cliqNum=o.cliqNumber||'—';

            /* ── مؤكد ── */
            if(o.cliqVerified){
                return `<div class="cliq-verified-box">
                    <div class="cv-title">📱 CliQ Payment — ✅ Verified & Confirmed</div>
                    <div style="font-size:.82rem;color:#388e3c">
                        Verification code <span class="cv-code">${code}</span> was confirmed.
                        Payment has been received and the guarantee is held in your store wallet.
                    </div>
                </div>`;
            }

            /* ── غير مؤكد → فورم التحقق ── */
            return `<div class="cliq-confirm-form">
                <div class="cf-title">📱 CliQ Payment Verification Required</div>
                <div class="cliq-info-grid">
                    <div class="cliq-info-cell">
                        <div class="cell-lbl">Verification Code</div>
                        <div class="cell-val">${code}</div>
                        <div style="font-size:.65rem;color:#999;margin-top:4px">Must appear in CliQ message</div>
                    </div>
                    <div class="cliq-info-cell">
                        <div class="cell-lbl">Store CliQ Number</div>
                        <div class="cell-val num">${cliqNum}</div>
                    </div>
                </div>
                <div class="cliq-warning-box">
                    ⚠️ Open your CliQ app → find the incoming transfer → check the message/note field
                    for the code <strong>${code}</strong>. Only confirm after you see the exact code.
                    <br><br>
                    <strong>Note:</strong> Confirming will hold the order amount as a guarantee in your
                    store wallet to protect the customer's refund rights.
                </div>
                <button class="cliq-confirm-btn" id="cliqConfirmBtn_${o.idOrder||o.id}"
                        onclick="confirmCliQPayment(${o.idOrder||o.id})">
                    ✅ I verified the code — Confirm Payment & Process Order
                </button>
            </div>`;
        }

        /* ════════════════════════════════════════════════
           DATA + STATS
           ════════════════════════════════════════════════ */
        let allOrders=window.serverOrders||[];
        let currentOrder=null;

        function updateStats(){
            const counts={all:allOrders.length};
            ['pending','confirmed','preparing','shipped','delivered','cancelled'].forEach(s=>{
                counts[s]=allOrders.filter(o=>o.status===s).length;
            });
            document.getElementById('statAll').textContent=counts.all;
            document.getElementById('statPending').textContent=counts.pending;
            document.getElementById('statConfirmed').textContent=counts.confirmed;
            document.getElementById('statPreparing').textContent=counts.preparing;
            document.getElementById('statShipped').textContent=counts.shipped;
            document.getElementById('statDelivered').textContent=counts.delivered;
        }

        function filterOrders(status){
            document.getElementById('orderStatusSelect').value=status;
            renderOrders();
        }

        /* ── Render Table ── */
        function renderOrders(){
            const q=document.getElementById('orderSearch').value.toLowerCase();
            const st=document.getElementById('orderStatusSelect').value;
            let list=allOrders;
            if(st!=='all') list=list.filter(o=>o.status===st);
            if(q) list=list.filter(o=>(o.id||'').toLowerCase().includes(q)||(o.cust||'').toLowerCase().includes(q));

            const tbody=document.getElementById('ordersBody');
            if(!list.length){
                tbody.innerHTML='<tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:30px">No orders found</td></tr>';
                return;
            }
            tbody.innerHTML=list.map(o=>{
                const cliqWarn=(o.paymentMethod||'').toLowerCase()==='cliq'&&!o.cliqVerified
                    ?`<span style="background:#fff3e0;color:#e65100;border:1px solid #ffb74d;padding:2px 7px;border-radius:10px;font-size:.65rem;font-weight:800;margin-left:4px">📱 CliQ Pending</span>`:'';
                return `<tr>
                    <td><span style="font-weight:900;font-family:monospace;font-size:.88rem">#${o.id||o.idOrder}</span></td>
                    <td><div style="font-weight:700">${o.cust||'—'}</div><div style="font-size:.72rem;color:var(--text-muted)">${o.phone||''}</div></td>
                    <td style="font-size:.8rem;color:var(--text-muted)">${o.date||'—'}</td>
                    <td style="font-size:.82rem">${o.prods||0} item(s)</td>
                    <td>
                        <div style="font-weight:900;font-size:.86rem">${parseFloat(o.grandTotal||o.total||0).toFixed(3)} JD</div>
                        <div style="font-size:.70rem;color:var(--text-muted);margin-top:2px">Items: ${parseFloat(o.total||0).toFixed(3)}${o.deliveryFee>0?' + 🚚 '+parseFloat(o.deliveryFee).toFixed(3):''}</div>
                    </td>
                    <td>${statusBadge(o.status||'pending')}${cliqWarn}</td>
                    <td><button class="btn btn-outline btn-sm" onclick="openOrderDetail(${o.idOrder||o.id})">View</button></td>
                </tr>`;
            }).join('');
        }

        /* ── Open Modal ── */
        function openOrderDetail(idOrder){
            const o=allOrders.find(x=>(x.idOrder||x.id)==idOrder);
            if(!o) return;
            currentOrder=o;
            const body=document.getElementById('orderModalBody');
            body.innerHTML=`
                <div style="padding:20px">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
                        <div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Order ID</div><div style="font-weight:900;font-family:monospace">#${o.id||o.idOrder}</div></div>
                        <div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Date</div><div>${o.date||'—'}</div></div>
                        <div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Customer</div><div style="font-weight:700">${o.cust||'—'}</div></div>
                        <div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Phone</div><div>${o.phone||'—'}</div></div>
                        <div style="grid-column:1/-1"><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Delivery Address</div><div>${o.address||'—'}</div></div>
                        <div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700">Payment Method</div><div style="font-weight:700">${o.paymentMethod||'Cash'}</div></div>
                    </div>
                    ${buildCliQHtml(o)}
                    ${buildDeliveryPersonHtml(o)}
                    <div style="font-size:.78rem;font-weight:800;color:var(--brand-dark);margin-bottom:8px">Order Items:</div>
                    <ul style="margin:0;padding:0;margin-bottom:16px">${buildItemsHtml(o.items)}</ul>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid var(--border)">
                        <span style="font-weight:800">Total Amount:</span>
                        <div style="text-align:right">
                            <div style="font-size:.76rem;color:var(--text-muted);font-weight:700">Items: ${parseFloat(o.total||0).toFixed(3)} JD</div>
                            ${o.deliveryFee>0?`<div style="font-size:.76rem;color:var(--text-muted);font-weight:700">🚚 Delivery: ${parseFloat(o.deliveryFee).toFixed(3)} JD</div>`:''}
                            <div style="font-size:1.1rem;font-weight:900;color:var(--brand-dark);margin-top:4px">${parseFloat(o.grandTotal||o.total||0).toFixed(3)} JD</div>
                        </div>
                    </div>
                    <div style="margin-top:10px">${statusBadge(o.status||'pending')}</div>
                </div>
                <div id="deliveryFormSection" style="display:none;padding:0 20px 20px;border-top:1px solid var(--border)">
                    <div style="font-size:.78rem;font-weight:800;color:var(--brand-dark);margin:12px 0 10px">🚚 Assign Delivery Person</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                        <div><label style="font-size:.74rem;font-weight:700;color:var(--text-muted);display:block;margin-bottom:4px">Full Name *</label><input id="dpName" class="form-input" placeholder="Delivery person's name"></div>
                        <div><label style="font-size:.74rem;font-weight:700;color:var(--text-muted);display:block;margin-bottom:4px">Phone Number *</label><input id="dpPhone" class="form-input" placeholder="+962 7X XXX XXXX"></div>
                    </div>
                </div>`;
            buildStatusButtons(o);
            openModal('orderModal');
        }

        /* ── Status Stepper ── */
        function buildStatusButtons(o){
            const steps=['pending','confirmed','preparing','shipped','delivered'];
            const labels={pending:'⏳ Pending',confirmed:'✅ Confirmed',preparing:'🍳 Preparing',shipped:'🚚 Shipped',delivered:'✔️ Delivered'};
            const currentIdx=steps.indexOf(o.status);
            const id=o.idOrder||o.id;
            const actionsEl=document.getElementById('orderStatusActions');

            if(o.status==='cancelled'){
                actionsEl.innerHTML=`<div style="background:#fdecea;border:1px solid #f5c6c2;border-radius:10px;padding:10px 14px;color:#c0392b;font-weight:800;font-size:.84rem;width:100%">❌ This order has been cancelled</div>`;
                return;
            }
            if(o.status==='delivered'){
                actionsEl.innerHTML=`<div style="background:#eafaf1;border:1px solid #a9dfbf;border-radius:10px;padding:12px 16px;text-align:center;width:100%"><div style="font-size:1.5rem;margin-bottom:4px">✅</div><div style="font-weight:900;color:#1e8449;font-size:.9rem">Order Completed</div><div style="font-size:.76rem;color:#27ae60;margin-top:2px">Delivered successfully</div></div>`;
                return;
            }

            /* CliQ غير مؤكد — block */
            const cliqBlocked=(o.paymentMethod||'').toLowerCase()==='cliq'&&!o.cliqVerified&&o.status==='pending';
            if(cliqBlocked){
                actionsEl.innerHTML=`
                    <div style="background:#fff3e0;border:1px solid #ffb74d;border-radius:10px;padding:10px 14px;color:#e65100;font-weight:700;font-size:.82rem;width:100%">
                        ⚠️ Confirm CliQ payment in the section above before processing this order.
                    </div>
                    <button class="btn btn-danger btn-sm" style="margin-top:8px;font-size:.74rem" onclick="doCancel(${id})">❌ Cancel Order</button>`;
                return;
            }

            /* Stepper */
            let html='<div style="display:flex;align-items:center;gap:0;flex-wrap:nowrap;overflow-x:auto;padding:4px 0;width:100%">';
            steps.forEach((step,idx)=>{
                const isPast=idx<currentIdx,isCurrent=idx===currentIdx,isNext=idx===currentIdx+1;
                let bg,color,cursor,border,fw;
                if(isPast){bg='var(--brand)';color='#fff';cursor='default';border='var(--brand)';fw='700';}
                else if(isCurrent){bg='var(--brand-dark)';color='#fff';cursor='default';border='var(--brand-dark)';fw='900';}
                else if(isNext){bg='#fff';color='var(--brand-dark)';cursor='pointer';border='var(--brand)';fw='800';}
                else{bg='#f5f5f5';color='#bbb';cursor='default';border='#e0e0e0';fw='600';}
                const onclick=isNext?`onclick="handleStatusClick(${id},'${step}')"` :'';
                html+=`<div ${onclick} style="background:${bg};color:${color};border:2px solid ${border};border-radius:20px;padding:5px 12px;font-size:.72rem;font-weight:${fw};white-space:nowrap;cursor:${cursor};transition:.15s;${isNext?'box-shadow:0 2px 8px rgba(139,169,74,.3)':''}">${isPast?'✓ ':''}${labels[step]}</div>`;
                if(idx<steps.length-1) html+='<div style="color:#ccc;font-size:.8rem;padding:0 3px;flex-shrink:0">›</div>';
            });
            html+='</div>';

            const cancelHtml=`<button class="btn btn-danger btn-sm" style="margin-top:8px;font-size:.74rem" onclick="doCancel(${id})">❌ Cancel Order</button>`;
            actionsEl.innerHTML=`<div style="display:flex;flex-direction:column;align-items:flex-start;gap:4px;width:100%">${html}${cancelHtml}</div>`;
        }

        /* ── Cancel با confirm بسيط ── */
        function doCancel(idOrder){
            if(!confirm('⚠️ Are you sure you want to CANCEL this order?\nThis cannot be undone.')) return;
            updateStatus(idOrder,'cancelled');
        }

        /* ── Handle Status Click ── */
        function handleStatusClick(idOrder,status){
            const o=allOrders.find(x=>(x.idOrder||x.id)==idOrder);
            if(o&&(o.paymentMethod||'').toLowerCase()==='cliq'&&!o.cliqVerified&&status!=='cancelled'){
                showToast('⚠️ Confirm CliQ payment first.');
                return;
            }
            const messages={confirmed:'Confirm this order?',preparing:'Mark order as Preparing?',delivered:'Mark order as Delivered? This cannot be undone.'};
            if(messages[status]&&!confirm(messages[status])) return;
            if(status==='shipped'){
                document.getElementById('deliveryFormSection').style.display='';
                document.getElementById('orderStatusActions').innerHTML=
                    `<button class="btn btn-outline btn-sm" onclick="cancelShipForm()">← Back</button>
                     <button class="btn btn-primary btn-sm" onclick="confirmShipment(${idOrder})">🚚 Confirm Shipment</button>`;
            } else {
                updateStatus(idOrder,status);
            }
        }

        function cancelShipForm(){
            document.getElementById('deliveryFormSection').style.display='none';
            buildStatusButtons(currentOrder);
        }

        async function confirmShipment(idOrder){
            const name=(document.getElementById('dpName').value||'').trim();
            const phone=(document.getElementById('dpPhone').value||'').trim();
            if(!name||!phone){showToast('Please enter delivery person name and phone.');return;}
            const fd=new FormData();
            fd.append('idOrder',idOrder);fd.append('deliveryPersonName',name);fd.append('deliveryPersonPhone',phone);
            try{
                const res=await fetch('/StoreAdmin/UpdateDeliveryPerson',{method:'POST',body:fd});
                const data=await res.json();
                if(data.success){
                    const o=allOrders.find(x=>(x.idOrder||x.id)==idOrder);
                    if(o){o.status='shipped';o.deliveryPersonName=name;o.deliveryPersonPhone=phone;}
                    updateStats();renderOrders();closeModal('orderModal');
                    showToast('🚚 Order shipped — delivery person assigned!');
                }else{showToast(data.message||'Failed to save.');}
            }catch{showToast('❌ Network error');}
        }

        /* ════════════════════════════════════════════════
           CONFIRM CLIQ — مع معالجة "رصيد غير كافٍ"
           ════════════════════════════════════════════════ */
        async function confirmCliQPayment(idOrder){
            const o=allOrders.find(x=>(x.idOrder||x.id)==idOrder);
            const code=o?.cliqCode||'—';
            const btn=document.getElementById(`cliqConfirmBtn_${idOrder}`);
            if(btn){btn.disabled=true;btn.textContent='⏳ Processing...';}

            const fd=new FormData();
            fd.append('idOrder',idOrder);
            try{
                const res=await fetch('/StoreAdmin/ConfirmCliQPayment',{method:'POST',body:fd});
                const data=await res.json();

                if(data.success){
                    if(o){o.cliqVerified=true;o.status='confirmed';}
                    updateStats();renderOrders();closeModal('orderModal');
                    showToast('✅ CliQ payment confirmed — order is now Confirmed!');
                }else{
                    /* ── رصيد المتجر غير كافٍ ── */
                    const msg=data.message||'Error';
                    const isInsufficient=msg.toLowerCase().includes('wallet')||msg.toLowerCase().includes('balance')||msg.toLowerCase().includes('insufficient');

                    if(isInsufficient){
                        /* استخرج الأرقام من الرسالة */
                        const totalMatch=msg.match(/\(([0-9.]+)\s*JD\)/);
                        const balMatch=msg.match(/balance\s*\(([0-9.]+)\s*JD\)/i)||msg.match(/([0-9.]+)\s*JD\)\s*is insuff/i);
                        const needed=totalMatch?totalMatch[1]:'?';
                        const bal=balMatch?balMatch[1]:'?';
                        const shortfall=data.shortfall?data.shortfall.toFixed(3):'?';

                        /* استبدل الـ confirm btn بصندوق "رصيد غير كافٍ" */
                        const confirmForm=document.querySelector('.cliq-confirm-form');
                        if(confirmForm){
                            confirmForm.innerHTML=`
                                <div class="wallet-insufficient-box">
                                    <div class="wi-title">⚠️ Insufficient Store Wallet Balance</div>
                                    <div class="wi-row">
                                        <span>Order Amount (guarantee required)</span>
                                        <span>${needed} JD</span>
                                    </div>
                                    <div class="wi-row">
                                        <span>Your Store Wallet Balance</span>
                                        <span>${bal} JD</span>
                                    </div>
                                    <div class="wi-msg">
                                        Your store wallet does not have enough balance to hold the guarantee for this order.
                                        Please top up your wallet first, then come back to confirm the payment.
                                    </div>
                                    <a href="/StoreAdmin/SettingsWallet" class="wallet-go-btn">
                                        👛 Top Up Store Wallet →
                                    </a>
                                </div>`;
                        }
                    }else{
                        if(btn){btn.disabled=false;btn.textContent='✅ I verified the code — Confirm Payment & Process Order';}
                        showToast('❌ '+msg);
                    }
                }
            }catch{
                if(btn){btn.disabled=false;btn.textContent='✅ I verified the code — Confirm Payment & Process Order';}
                showToast('❌ Network error');
            }
        }

        /* ── Update Status ── */
        async function updateStatus(idOrder,status){
            const fd=new FormData();
            fd.append('idOrder',idOrder);fd.append('status',status);
            try{
                const res=await fetch('/StoreAdmin/UpdateOrderStatus',{method:'POST',body:fd});
                const data=await res.json();
                if(data.success){
                    const o=allOrders.find(x=>(x.idOrder||x.id)==idOrder);
                    if(o) o.status=status;
                    updateStats();renderOrders();closeModal('orderModal');
                    showToast('Order status updated to '+status);
                }else{showToast('❌ Update failed');}
            }catch{showToast('❌ Network error');}
        }

        /* ── Export ── */
        function exportOrders(){
            if(!allOrders.length){showToast('No orders to export');return;}
            const rows=['Order ID,Customer,Phone,Date,Items,Total,Status,Payment'];
            allOrders.forEach(o=>rows.push(`"${o.id||o.idOrder}","${o.cust||''}","${o.phone||''}","${o.date||''}","${o.prods||0}","${parseFloat(o.total||0).toFixed(3)}","${o.status||''}","${o.paymentMethod||''}"`));
            const blob=new Blob([rows.join('\n')],{type:'text/csv'});
            const link=document.createElement('a');
            link.href=URL.createObjectURL(blob);link.download='orders.csv';link.click();
        }

        /* ── Init ── */
        document.addEventListener('DOMContentLoaded',()=>{
            if(!mob()&&localStorage.getItem('wa_mini')==='1') miniOn();
            updateStats();renderOrders();
            document.getElementById('orderSearch').addEventListener('input',renderOrders);
            document.getElementById('orderStatusSelect').addEventListener('change',renderOrders);
        });
    </script>
</body>
</html>
