@model Waffy.Models.Store
@{
    Layout = "~/Views/StoreAdmin/_StoreAdminLayout.cshtml";
    ViewData["Title"] = "Store Settings — Payment";
    ViewData["ActiveNav"] = "Settings";
    ViewData["ActiveSettings"] = "Payment";
    ViewData["BreadSection"] = "Settings";
    ViewData["BreadPage"] = "Payment Methods";
    var accepted = Model.AcceptedPayments ?? "";
}

@section Styles {
    <style>
        .settings-layout {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 16px;
            align-items: start
        }

        .settings-nav {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm)
        }

        .settings-nav-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            font-size: .84rem;
            font-weight: 700;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
            border-left: 3px solid transparent;
            text-decoration: none;
            transition: .18s
        }

            .settings-nav-item:hover {
                background: var(--brand-ghost);
                color: var(--brand-dark)
            }

            .settings-nav-item.on {
                background: var(--brand-xlight);
                color: var(--brand-dark);
                font-weight: 900;
                border-left-color: var(--brand)
            }

            .settings-nav-item:last-child {
                border-bottom: none
            }

        .settings-nav-ico {
            font-size: 1rem;
            width: 20px;
            text-align: center
        }

        .settings-content {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 24px;
            box-shadow: var(--shadow-sm)
        }

        .settings-section-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 18px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px
        }

        .toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 14px;
            background: var(--brand-ghost);
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 8px
        }

            .toggle-row:last-child {
                margin-bottom: 0
            }

        .toggle-row-info {
            display: flex;
            align-items: center;
            gap: 10px
        }

        .toggle-row-ico {
            font-size: 1.1rem
        }

        .toggle-row-label {
            font-size: .86rem;
            font-weight: 800;
            color: var(--brand-dark)
        }

        .toggle {
            width: 40px;
            height: 22px;
            background: rgba(139,169,74,.22);
            border-radius: 11px;
            position: relative;
            cursor: pointer;
            transition: .22s;
            flex-shrink: 0
        }

            .toggle.on {
                background: var(--brand)
            }

            .toggle::after {
                content: '';
                position: absolute;
                top: 3px;
                left: 3px;
                width: 16px;
                height: 16px;
                background: #fff;
                border-radius: 50%;
                transition: .22s;
                box-shadow: 0 1px 4px rgba(0,0,0,.18)
            }

            .toggle.on::after {
                transform: translateX(18px)
            }

        @@media(max-width:900px) {
            .settings-layout {
                grid-template-columns: 1fr
            }

            .settings-nav {
                display: grid;
                grid-template-columns: repeat(3,1fr)
            }

            .settings-nav-item {
                border-left: none;
                border-right: 1px solid var(--border);
                justify-content: center;
                text-align: center;
                padding: 10px 8px;
                font-size: .78rem
            }

                .settings-nav-item.on {
                    border-left: none;
                    border-bottom: 2px solid var(--brand)
                }
        }

        @@media(max-width:500px) {
            .settings-nav {
                grid-template-columns: repeat(2,1fr)
            }
        }
    </style>
}

<section class="page-hero">
    <div class="page-hero-text">
        <h1>Store Settings ⚙️</h1>
        <p>Choose the payment methods you accept.</p>
    </div>
    <div class="page-hero-actions">
        <button class="btn btn-primary" form="settingsForm" type="submit">💾 Save Changes</button>
    </div>
</section>

<div class="page-body">

    @if (TempData["Success"] != null)
    {
        <div class="info-box" style="margin-bottom:16px;background:var(--gp);border-color:var(--brand)">
            @TempData["Success"]
        </div>
    }

    <div class="settings-layout">

        @await Html.PartialAsync("_SettingsNav")

        <div class="settings-content">
            <form id="settingsForm"
                  method="post"
                  asp-action="SettingsPayment"
                  asp-controller="StoreAdmin">
                @Html.AntiForgeryToken()

                <div class="settings-section-title">💳 Accepted Payment Methods</div>

                <!-- Hidden input — value managed by JS toggles -->
                <input type="hidden" name="acceptedPayments"
                       id="acceptedPaymentsInput" value="@accepted">

                <div class="toggle-row">
                    <div class="toggle-row-info">
                        <span class="toggle-row-ico">💵</span>
                        <span class="toggle-row-label">Cash on Delivery</span>
                    </div>
                    <div class="toggle @(accepted.Contains("Cash") ? "on" : "")"
                         onclick="togglePayment(this,'Cash')"></div>
                </div>

                <div class="toggle-row">
                    <div class="toggle-row-info">
                        <span class="toggle-row-ico">💳</span>
                        <span class="toggle-row-label">Online Payment (Card)</span>
                    </div>
                    <div class="toggle @(accepted.Contains("Card") ? "on" : "")"
                         onclick="togglePayment(this,'Card')"></div>
                </div>

                <div class="toggle-row">
                    <div class="toggle-row-info">
                        <span class="toggle-row-ico">👛</span>
                        <span class="toggle-row-label">Waffy Wallet</span>
                    </div>
                    <div class="toggle @(accepted.Contains("Wallet") ? "on" : "")"
                         onclick="togglePayment(this,'Wallet')"></div>
                </div>

                <div class="toggle-row">
                    <div class="toggle-row-info">
                        <span class="toggle-row-ico">📱</span>
                        <span class="toggle-row-label">CliQ / Instant Transfer</span>
                    </div>
                    <div class="toggle @(accepted.Contains("CliQ") ? "on" : "")"
                         onclick="togglePayment(this,'CliQ')"></div>
                </div>

                <div style="text-align:right;margin-top:24px">
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function togglePayment(el, method) {
            el.classList.toggle('on');
            const input   = document.getElementById('acceptedPaymentsInput');
            const methods = input.value ? input.value.split(',').map(s => s.trim()).filter(Boolean) : [];
            const idx     = methods.indexOf(method);
            if (idx === -1) methods.push(method);
            else            methods.splice(idx, 1);
            input.value = methods.join(',');
        }
    </script>
}
