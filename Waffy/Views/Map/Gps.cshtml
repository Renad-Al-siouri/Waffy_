@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Explore Map — Waffy</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        /* ════════════════════════════════════════════════════════
           VARIABLES  (match prodstyle.css)
        ════════════════════════════════════════════════════════ */
        :root {
            --olive: #7a9e35;
            --olive-dark: #4d6620;
            --olive-light: #a8c558;
            --olive-xl: #eef4e0;
            --cream: #faf6f0;
            --card: #ffffff;
            --text-dark: #26321a;
            --text-mid: #5a6e40;
            --text-muted: #8fa070;
            --line: #e2ecd0;
            --danger: #d94f3a;
            --r-card: 18px;
            --r-btn: 999px;
            --shadow: 0 2px 12px rgba(80,110,30,.09);
            --shadow-h: 0 12px 32px rgba(80,110,30,.18);
            --tr: .22s cubic-bezier(.4,0,.2,1);
            /* pin colors */
            --c-clinic: #00c896;
            --c-store: #8b5cf6;
            --c-friendly: #f59e0b;
            --c-park: #38a169;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--cream);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            display: block;
            max-width: 100%;
        }

        .container {
            width: min(1280px, calc(100% - 28px));
            margin: 0 auto;
        }

        /* ════════════════════════════════════════════════════════
           NAVBAR  (identical to products page)
        ════════════════════════════════════════════════════════ */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 900;
            background: rgba(250,246,240,.88);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(120,160,50,.12);
        }

        .header-shell {
            display: flex;
            justify-content: center;
            padding: 10px 20px;
        }

        .navbar {
            width: 100%;
            max-width: 1280px;
            display: grid;
            grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
            align-items: center;
            gap: 16px;
            min-height: 68px;
        }

        .desktop-nav {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .left-nav {
            justify-content: flex-start;
        }

        .right-nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .logo-center {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-logo {
            width: 130px;
            height: auto;
        }

        .nav-link {
            padding: 8px 14px;
            border-radius: var(--r-btn);
            font-size: .86rem;
            font-weight: 800;
            color: var(--text-mid);
            border: none;
            background: transparent;
            cursor: pointer;
            transition: var(--tr);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .nav-link:hover, .nav-link.active {
                background: var(--olive);
                color: #fff;
            }

        .login-btn {
            background: var(--olive);
            color: #fff !important;
            box-shadow: 0 4px 14px rgba(120,160,50,.3);
        }

            .login-btn:hover {
                background: var(--olive-dark);
            }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .nav-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--olive-dark);
            font-size: .95rem;
            cursor: pointer;
            transition: var(--tr);
            flex-shrink: 0;
        }

            .nav-icon:hover {
                background: var(--olive);
                color: #fff;
                border-color: var(--olive);
            }

        .profile-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid rgba(120,160,50,.3);
            flex-shrink: 0;
        }

            .profile-btn img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .services-dropdown {
            position: relative;
        }

        .dropdown-arrow {
            font-size: .65rem;
            margin-left: 5px;
            transition: transform .2s;
        }

        .services-dropdown.open .dropdown-arrow {
            transform: rotate(180deg);
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 210px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 16px 40px rgba(60,90,20,.14);
            padding: 8px;
            flex-direction: column;
            gap: 2px;
            z-index: 2000;
        }

        .services-dropdown.open .dropdown-menu {
            display: flex;
        }

        .dropdown-link {
            display: block;
            padding: 9px 12px;
            border-radius: 10px;
            font-size: .84rem;
            font-weight: 700;
            color: var(--text-dark);
            transition: var(--tr);
        }

            .dropdown-link:hover {
                background: var(--olive-xl);
                color: var(--olive-dark);
            }

        .mobile-nav-wrap {
            display: none;
            position: relative;
        }

        .menu-btn {
            display: none;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--olive);
            color: #fff;
            border: none;
            font-size: 1rem;
            cursor: pointer;
            place-items: center;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: 52px;
            right: 0;
            width: min(260px, calc(100vw - 20px));
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 16px 40px rgba(60,90,20,.14);
            padding: 12px;
            flex-direction: column;
            gap: 6px;
            z-index: 3000;
            max-height: calc(100vh - 80px);
            overflow-y: auto;
        }

            .nav-links.open {
                display: flex;
            }

            .nav-links .nav-link {
                width: 100%;
                justify-content: center;
            }

        .mobile-menu-logo {
            display: flex;
            justify-content: center;
            padding-bottom: 8px;
        }

            .mobile-menu-logo img {
                width: 70px;
            }

        .mobile-services-block {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .mobile-services-toggle {
            width: 100%;
            border: 1px solid var(--line);
            background: #fafafa;
            color: var(--olive-dark);
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: .86rem;
        }

        .mobile-services-menu {
            display: none;
            flex-direction: column;
            gap: 4px;
            padding-top: 4px;
        }

        .mobile-services-block.open .mobile-services-menu {
            display: flex;
        }

        .mobile-services-block.open .dropdown-arrow {
            transform: rotate(180deg);
        }

        /* ════════════════════════════════════════════════════════
           PAGE HERO HEADER
        ════════════════════════════════════════════════════════ */
        .map-hero {
            background: linear-gradient(135deg, var(--olive-dark) 0%, #2e5010 100%);
            padding: 32px 0 28px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .map-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23a8c558' fill-opacity='0.07'%3E%3Ccircle cx='30' cy='30' r='4'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
                pointer-events: none;
            }

            .map-hero h1 {
                font-family: 'Fredoka', sans-serif;
                font-size: clamp(1.6rem,3vw,2.2rem);
                color: #fff;
                margin-bottom: 6px;
                position: relative;
            }

            .map-hero p {
                color: rgba(255,255,255,.72);
                font-size: .88rem;
                font-weight: 600;
                position: relative;
            }

        .hero-badges {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 16px;
            flex-wrap: wrap;
            position: relative;
        }

        .hero-badge {
            padding: 7px 16px;
            border-radius: var(--r-btn);
            background: rgba(255,255,255,.12);
            border: 1px solid rgba(255,255,255,.2);
            color: rgba(255,255,255,.85);
            font-size: .78rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            backdrop-filter: blur(8px);
        }

            .hero-badge span.dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
            }

        /* ════════════════════════════════════════════════════════
           MAP SHELL — sidebar + map
        ════════════════════════════════════════════════════════ */
        .map-shell {
            display: flex;
            gap: 0;
            height: calc(100vh - 68px - 110px); /* viewport - navbar - hero */
            min-height: 560px;
            border-top: 1px solid var(--line);
        }

        /* ── Left Sidebar ── */
        .map-sidebar {
            width: 340px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: var(--card);
            border-right: 1px solid var(--line);
            overflow: hidden;
        }

        /* Controls section */
        .sb-controls {
            padding: 16px 16px 12px;
            border-bottom: 1px solid var(--line);
            flex-shrink: 0;
            background: #fff;
        }

        /* Mode toggle */
        .mode-toggle {
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: var(--olive-xl);
            border-radius: 12px;
            padding: 4px;
            margin-bottom: 12px;
            gap: 3px;
        }

        .mt-btn {
            padding: 9px 12px;
            border-radius: 9px;
            border: none;
            background: transparent;
            font-family: 'Nunito', sans-serif;
            font-size: .78rem;
            font-weight: 800;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--tr);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

            .mt-btn.active {
                background: #fff;
                color: var(--olive-dark);
                box-shadow: 0 2px 8px rgba(80,110,30,.12);
            }

        /* Search */
        .sb-search {
            display: flex;
            align-items: center;
            gap: 9px;
            background: var(--cream);
            border: 1.5px solid var(--line);
            border-radius: 12px;
            padding: 0 14px;
            height: 42px;
            margin-bottom: 10px;
            transition: var(--tr);
        }

            .sb-search:focus-within {
                border-color: var(--olive);
                background: #fff;
            }

            .sb-search i {
                color: var(--text-muted);
                font-size: .84rem;
                flex-shrink: 0;
            }

            .sb-search input {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'Nunito', sans-serif;
                font-size: .82rem;
                font-weight: 600;
                color: var(--text-dark);
                width: 100%;
            }

                .sb-search input::placeholder {
                    color: var(--text-muted);
                }

        .sb-search-clear {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: .8rem;
            flex-shrink: 0;
            display: none;
        }

        /* Filter chips row */
        .sb-chips {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 2px;
            margin-bottom: 10px;
        }

            .sb-chips::-webkit-scrollbar {
                display: none;
            }

        .fchip {
            flex-shrink: 0;
            padding: 5px 12px;
            border-radius: var(--r-btn);
            border: 1.5px solid var(--line);
            background: #fff;
            font-size: .72rem;
            font-weight: 800;
            color: var(--text-mid);
            cursor: pointer;
            transition: var(--tr);
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .fchip:hover {
                border-color: var(--olive-light);
                color: var(--olive-dark);
            }

            .fchip.active {
                background: var(--olive);
                border-color: var(--olive);
                color: #fff;
                box-shadow: 0 3px 10px rgba(120,160,50,.25);
            }

        .fchip-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        .fchip.active .fchip-dot {
            background: rgba(255,255,255,.6);
        }

        /* Distance filter */
        .sb-dist-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sb-dist-label {
            font-size: .72rem;
            font-weight: 800;
            color: var(--text-muted);
            white-space: nowrap;
        }

        .dist-select {
            flex: 1;
            height: 36px;
            padding: 0 12px;
            border-radius: var(--r-btn);
            border: 1.5px solid var(--line);
            background: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .76rem;
            font-weight: 700;
            color: var(--text-mid);
            cursor: pointer;
            outline: none;
            transition: var(--tr);
        }

            .dist-select:focus {
                border-color: var(--olive);
            }

        /* Results count */
        .sb-count {
            padding: 8px 16px 6px;
            font-size: .7rem;
            font-weight: 800;
            color: var(--text-muted);
            letter-spacing: .5px;
            text-transform: uppercase;
            border-bottom: 1px solid var(--line);
            flex-shrink: 0;
        }

        /* Place list */
        .sb-list {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--line) transparent;
        }

            .sb-list::-webkit-scrollbar {
                width: 4px;
            }

            .sb-list::-webkit-scrollbar-thumb {
                background: var(--line);
                border-radius: 4px;
            }

        .place-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 11px 16px;
            border-bottom: 1px solid #f5f0ea;
            cursor: pointer;
            transition: background .14s;
        }

            .place-item:hover {
                background: var(--olive-xl);
            }

            .place-item.selected {
                background: #f0f7e0;
            }

        .pi-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.1rem;
        }

        .pi-body {
            flex: 1;
            min-width: 0;
        }

        .pi-name {
            font-size: .84rem;
            font-weight: 800;
            color: var(--text-dark);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pi-meta {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 3px;
            flex-wrap: wrap;
        }

        .pi-type {
            font-size: .67rem;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 20px;
        }

        .pi-dist {
            font-size: .67rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .pi-arr {
            color: var(--line);
            font-size: .68rem;
            flex-shrink: 0;
        }

        .sb-empty {
            padding: 40px 20px;
            text-align: center;
        }

            .sb-empty .e-ico {
                font-size: 2.5rem;
                margin-bottom: 12px;
            }

            .sb-empty p {
                font-size: .82rem;
                color: var(--text-muted);
                font-weight: 600;
                line-height: 1.6;
            }

        /* ── Map Area ── */
        .map-area {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        #map {
            width: 100%;
            height: 100%;
        }

        /* ════════════════════════════════════════════════════════
           CUSTOM MAP PINS — type-specific SVG
        ════════════════════════════════════════════════════════ */
        .wm-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .wm-body {
            width: 38px;
            height: 46px;
            position: relative;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,.22));
            transition: filter .18s, transform .18s;
        }

        .wm-wrap:hover .wm-body {
            transform: translateY(-3px);
            filter: drop-shadow(0 7px 14px rgba(0,0,0,.3));
        }

        .wm-svg {
            width: 38px;
            height: 46px;
        }

        .wm-ico {
            position: absolute;
            top: 7px;
            left: 50%;
            transform: translateX(-50%);
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .wm-ico svg {
                width: 14px;
                height: 14px;
            }

        .wm-shadow {
            width: 12px;
            height: 4px;
            background: rgba(0,0,0,.15);
            border-radius: 50%;
            filter: blur(2px);
            margin-top: -2px;
        }

        /* User location */
        .user-pin {
            position: relative;
        }

        .user-dot {
            width: 16px;
            height: 16px;
            background: #3b82f6;
            border: 3px solid #fff;
            border-radius: 50%;
            box-shadow: 0 2px 10px rgba(59,130,246,.5);
        }

        .user-ring {
            position: absolute;
            inset: -8px;
            border: 2px solid rgba(59,130,246,.3);
            border-radius: 50%;
            animation: uRing 2.5s ease-out infinite;
        }

        .user-ring2 {
            position: absolute;
            inset: -16px;
            border: 1.5px solid rgba(59,130,246,.15);
            border-radius: 50%;
            animation: uRing 2.5s ease-out infinite .5s;
        }

        @@keyframes uRing {
            0% {
                transform: scale(.5);
                opacity: 1
            }

            100% {
                transform: scale(1.6);
                opacity: 0
            }
        }

        /* ════════════════════════════════════════════════════════
           PLACE DETAIL PANEL — slides from right
        ════════════════════════════════════════════════════════ */
        .detail-panel {
            position: absolute;
            top: 16px;
            right: 16px;
            bottom: 16px;
            width: 340px;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 16px 56px rgba(0,0,0,.18);
            display: flex;
            flex-direction: column;
            z-index: 500;
            transform: translateX(380px);
            transition: transform .32s cubic-bezier(.4,0,.2,1);
            overflow: hidden;
        }

            .detail-panel.open {
                transform: translateX(0);
            }

        .dp-photo {
            height: 180px;
            position: relative;
            flex-shrink: 0;
            overflow: hidden;
        }

            .dp-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dp-photo-ph {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
        }

        .dp-close {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255,255,255,.92);
            border: none;
            cursor: pointer;
            display: grid;
            place-items: center;
            font-size: .82rem;
            color: var(--text-dark);
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            transition: var(--tr);
        }

            .dp-close:hover {
                background: #fff;
            }

        .dp-type-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            padding: 5px 12px;
            border-radius: var(--r-btn);
            font-size: .7rem;
            font-weight: 800;
            backdrop-filter: blur(8px);
        }

        .dp-dist-pill {
            position: absolute;
            bottom: 12px;
            right: 12px;
            background: rgba(0,0,0,.55);
            color: #fff;
            padding: 4px 10px;
            border-radius: var(--r-btn);
            font-size: .7rem;
            font-weight: 700;
            backdrop-filter: blur(6px);
        }

        .dp-body {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--line) transparent;
        }

        .dp-content {
            padding: 18px 18px 0;
        }

        .dp-name {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.12rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 3px;
        }

        .dp-addr {
            font-size: .76rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 14px;
        }

        .dp-row {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            padding: 9px 0;
            border-bottom: 1px solid #f4efe8;
            font-size: .8rem;
        }

            .dp-row:last-of-type {
                border-bottom: none;
            }

        .dp-ico {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: var(--olive-xl);
            display: grid;
            place-items: center;
            font-size: .85rem;
            flex-shrink: 0;
        }

        .dp-label {
            font-size: .7rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .dp-val {
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-top: 1px;
            line-height: 1.5;
        }

            .dp-val a {
                color: var(--olive-dark);
            }

        .dp-actions {
            display: flex;
            gap: 10px;
            padding: 14px 18px 18px;
            flex-shrink: 0;
            border-top: 1px solid var(--line);
        }

        .dp-btn {
            flex: 1;
            padding: 12px;
            border-radius: 14px;
            border: none;
            font-family: 'Nunito', sans-serif;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: var(--tr);
            text-decoration: none;
        }

        .dp-btn-nav {
            background: var(--olive-dark);
            color: #fff;
            box-shadow: 0 4px 14px rgba(80,110,30,.25);
        }

            .dp-btn-nav:hover {
                background: var(--olive);
                color: #fff;
            }

        .dp-btn-call {
            background: var(--olive-xl);
            color: var(--olive-dark);
        }

            .dp-btn-call:hover {
                background: #e0edca;
            }

        .dp-btn-web {
            background: var(--cream);
            color: var(--text-mid);
            padding: 12px 14px;
            flex: 0 0 auto;
        }

        /* ════════════════════════════════════════════════════════
           MAP CONTROLS OVERLAY (on map)
        ════════════════════════════════════════════════════════ */
        .map-fab {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 400;
        }

        .fab-btn {
            padding: 11px 20px;
            border-radius: var(--r-btn);
            border: none;
            background: #fff;
            color: var(--text-dark);
            font-family: 'Nunito', sans-serif;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow-h);
            transition: var(--tr);
        }

            .fab-btn:hover {
                transform: translateY(-2px);
            }

            .fab-btn.active {
                background: var(--olive);
                color: #fff;
            }

        .fab-cnt {
            background: var(--olive);
            color: #fff;
            border-radius: var(--r-btn);
            padding: 1px 8px;
            font-size: .68rem;
            font-weight: 800;
        }

        .fab-btn.active .fab-cnt {
            background: rgba(255,255,255,.25);
        }

        /* Map locate button */
        .map-loc-btn {
            position: absolute;
            bottom: 20px;
            right: 20px;
            z-index: 400;
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: #fff;
            border: 2px solid var(--line);
            color: var(--olive-dark);
            font-size: 1rem;
            cursor: pointer;
            display: grid;
            place-items: center;
            box-shadow: var(--shadow-h);
            transition: var(--tr);
        }

            .map-loc-btn:hover {
                background: var(--olive);
                color: #fff;
                border-color: var(--olive);
            }

            .map-loc-btn.locating {
                background: var(--olive);
                color: #fff;
                border-color: var(--olive-dark);
            }

        /* Legend */
        .map-legend {
            position: absolute;
            top: 16px;
            left: 16px;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(10px);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 12px 16px;
            z-index: 400;
            box-shadow: var(--shadow);
        }

        .lg-title {
            font-size: .62rem;
            font-weight: 900;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .lg-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .73rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 5px;
        }

            .lg-row:last-child {
                margin-bottom: 0;
            }

        .lg-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ════════════════════════════════════════════════════════
           FOOTER  (from products page)
        ════════════════════════════════════════════════════════ */
        .footer {
            background: linear-gradient(135deg, var(--olive-dark) 0%, #2e4512 100%);
            color: rgba(255,255,255,.8);
            padding: 28px 20px 34px;
            text-align: center;
            margin-top: 0;
        }

        .footer-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 10px;
            font-size: .9rem;
        }

            .footer-links a {
                color: rgba(255,255,255,.8);
            }

                .footer-links a:hover {
                    color: #fff;
                }

        /* ════════════════════════════════════════════════════════
           STATUS TOAST
        ════════════════════════════════════════════════════════ */
        #statusToast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(12px);
            background: var(--text-dark);
            color: #fff;
            padding: 10px 22px;
            border-radius: 30px;
            font-size: .8rem;
            font-weight: 700;
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: all .3s;
            white-space: nowrap;
        }

            #statusToast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* ════════════════════════════════════════════════════════
           LEAFLET overrides
        ════════════════════════════════════════════════════════ */
        .leaflet-control-zoom {
            border: none !important;
        }

            .leaflet-control-zoom a {
                width: 36px !important;
                height: 36px !important;
                line-height: 36px !important;
                background: rgba(255,255,255,.95) !important;
                border: none !important;
                box-shadow: 0 3px 12px rgba(0,0,0,.1) !important;
                color: var(--text-dark) !important;
                font-size: .9rem !important;
                font-weight: 800 !important;
            }

                .leaflet-control-zoom a:first-child {
                    border-radius: 12px 12px 0 0 !important;
                }

                .leaflet-control-zoom a:last-child {
                    border-radius: 0 0 12px 12px !important;
                }

        .leaflet-attribution-flag {
            display: none !important;
        }

        /* ════════════════════════════════════════════════════════
           RESPONSIVE
        ════════════════════════════════════════════════════════ */
        @@media (max-width: 1180px) {
            .desktop-links, .left-nav {
                display: none;
            }

            .mobile-nav-wrap {
                display: flex;
            }

            .menu-btn {
                display: grid;
            }
        }

        @@media (max-width: 1000px) {
            .map-sidebar {
                width: 280px;
            }
        }

        @@media (max-width: 768px) {
            .map-shell {
                flex-direction: column;
                height: auto;
                min-height: auto;
            }

            .map-sidebar {
                width: 100%;
                max-height: 44vh;
                border-right: none;
                border-bottom: 2px solid var(--line);
                order: 2;
            }

            .map-area {
                height: 56vw;
                min-height: 300px;
                order: 1;
                flex-shrink: 0;
            }

            .detail-panel {
                top: auto;
                right: 0;
                left: 0;
                bottom: 0;
                width: 100%;
                border-radius: 22px 22px 0 0;
                height: 80vh;
                transform: translateY(100%);
            }

                .detail-panel.open {
                    transform: translateY(0);
                }

            .map-legend {
                display: none;
            }

            .map-fab {
                bottom: 14px;
            }

            .fab-btn {
                padding: 10px 16px;
                font-size: .76rem;
            }

            .nav-actions .login-btn {
                display: none;
            }

            .map-hero {
                padding: 22px 0 18px;
            }

            .hero-badges {
                gap: 6px;
            }

            .hero-badge {
                font-size: .72rem;
                padding: 5px 12px;
            }
        }

        @@media (max-width: 480px) {
            .map-area {
                height: 52vw;
                min-height: 260px;
            }

            .map-sidebar {
                max-height: 48vh;
            }

            .sb-chips .fchip span:not(.fchip-dot):not(.fchip-ico) {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- ═══ NAVBAR ═══════════════════════════════════════════════ -->
    <header class="topbar">
        <div class="header-shell">
            <nav class="navbar">
