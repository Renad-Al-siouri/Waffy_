                    <div class="mobile-nav-wrap">
                        <button class="menu-btn" id="menuBtn" type="button">☰</button>
                        <div class="nav-links" id="navLinks">
                            <div class="mobile-menu-logo"><img src="../Images/logo.png" alt="Waffy"></div>
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                            <a asp-controller="Map" asp-action="Gps" class="nav-link active">Map</a>
                            <div class="mobile-services-block" id="mobileServicesBlock">
                                <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                    <span>Services</span><span class="dropdown-arrow">▼</span>
                                </button>
                                <div class="mobile-services-menu" id="mobileServicesMenu">
                                    <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                    <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                    <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                    <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
