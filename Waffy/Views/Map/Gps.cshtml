    </header>

    <!-- ═══ HERO ═════════════════════════════════════════════════ -->
    <div class="map-hero">
        <h1>🗺️ Explore Pet Places</h1>
        <p>Find clinics, stores, and pet-friendly spots near you</p>
        <div class="hero-badges">
            <div class="hero-badge"><span class="dot" style="background:var(--c-clinic)"></span> Clinics</div>
            <div class="hero-badge"><span class="dot" style="background:var(--c-store)"></span> Pet Stores</div>
            <div class="hero-badge"><span class="dot" style="background:var(--c-friendly)"></span> Parks & Places</div>
        </div>
    </div>

    <!-- ═══ MAP SHELL ════════════════════════════════════════════ -->
    <div class="map-shell">

        <!-- ── Left Sidebar ── -->
        <aside class="map-sidebar">

            <!-- Controls -->
            <div class="sb-controls">

                <!-- Mode toggle -->
                <div class="mode-toggle">
                    <button class="mt-btn active" id="btnPet" onclick="setMode('pet')">
                        🐾 Pet World
                    </button>
                    <button class="mt-btn" id="btnFull" onclick="setMode('full')">
                        🗺️ Full Map
                    </button>
                </div>

                <!-- Search -->
                <div class="sb-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput" placeholder="Search clinics, stores…" oninput="onSearch(this.value)" />
                    <button class="sb-search-clear" id="searchClear" onclick="clearSearch()">✕</button>
                </div>

                <!-- Category chips -->
                <div class="sb-chips">
                    <button class="fchip active" data-f="all" onclick="setFilter(this,'all')">
                        <span>All</span>
                    </button>
                    <button class="fchip" data-f="clinic" onclick="setFilter(this,'clinic')">
                        <span class="fchip-dot" style="background:var(--c-clinic)"></span>
                        <span>Clinics</span>
                    </button>
                    <button class="fchip" data-f="store" onclick="setFilter(this,'store')">
                        <span class="fchip-dot" style="background:var(--c-store)"></span>
                        <span>Stores</span>
                    </button>
                    <button class="fchip" data-f="petfriendly" onclick="setFilter(this,'petfriendly')">
                        <span class="fchip-dot" style="background:var(--c-friendly)"></span>
                        <span>Places</span>
                    </button>
                </div>

                <!-- Distance filter -->
                <div class="sb-dist-row">
                    <span class="sb-dist-label"><i class="fa-solid fa-route" style="margin-right:4px"></i>Distance</span>
                    <select class="dist-select" id="distSelect" onchange="onDistChange(this.value)">
                        <option value="0">Any distance</option>
                        <option value="1">Within 1 km</option>
                        <option value="2">Within 2 km</option>
                        <option value="5">Within 5 km</option>
                        <option value="10">Within 10 km</option>
                        <option value="20">Within 20 km</option>
                    </select>
                </div>
            </div>

            <!-- Count row -->
            <div class="sb-count" id="sbCount">Loading places…</div>

            <!-- List -->
            <div class="sb-list" id="sbList">
                <div class="sb-empty">
                    <div class="e-ico">📡</div>
                    <p>Getting your location…</p>
                </div>
            </div>

        </aside>

        <!-- ── Map Area ── -->
        <div class="map-area">
            <div id="map"></div>

            <!-- Locate me button -->
            <button class="map-loc-btn" id="locBtn" onclick="goToUser()" title="Go to my location">
                <i class="fa-solid fa-location-crosshairs"></i>
            </button>

            <!-- Legend -->
            <div class="map-legend">
                <div class="lg-title">Legend</div>
                <div class="lg-row"><div class="lg-dot" style="background:var(--c-clinic)"></div> Vet Clinic</div>
                <div class="lg-row"><div class="lg-dot" style="background:var(--c-store)"></div> Pet Store</div>
                <div class="lg-row"><div class="lg-dot" style="background:var(--c-friendly)"></div> Pet-Friendly</div>
                <div class="lg-row"><div class="lg-dot" style="background:var(--c-park)"></div> Park</div>
                <div class="lg-row"><div class="lg-dot" style="background:#3b82f6"></div> You</div>
            </div>

            <!-- Detail Panel -->
            <div class="detail-panel" id="detailPanel">
                <div class="dp-body" id="dpInner"></div>
            </div>
        </div>
    </div>

    <!-- ═══ FOOTER ════════════════════════════════════════════════ -->
    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a><span>|</span>
            <a asp-controller="Home" asp-action="About">Contact</a><span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a>
        </div>
        <div style="font-size:.82rem;opacity:.7">© 2026 Waffy, all rights reserved.</div>
    </footer>

    <div id="statusToast"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function() {
        'use strict';

        /* ════════════════════════════════════════════════════════
           CONFIG
        ════════════════════════════════════════════════════════ */
        const DEFAULT = [31.9539, 35.9106];

        const TILES = {
            pet : 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
            full: 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png'
        };

        const COLORS = {
            clinic     : '#00c896',
            store      : '#8b5cf6',
            petfriendly: '#f59e0b',
            playground : '#f59e0b',
            park       : '#38a169'
        };
        const LABELS = {
            clinic     : 'Vet Clinic',
            store      : 'Pet Store',
            petfriendly: 'Pet-Friendly',
            playground : 'Playground',
            park       : 'Park'
        };

        /* Type-specific SVG icons for pins */
        const PIN_SVG = {
            clinic: `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>`,
            store: `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>`,
            petfriendly: `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round">
                <path d="M12 21s-8-5-8-12a8 8 0 0 1 16 0c0 7-8 12-8 12z"/>
            </svg>`,
            playground: `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round">
                <circle cx="12" cy="7" r="3.5"/><path d="M5 21l3.5-7m7 7L12 14m-3.5 7h7"/>
            </svg>`,
            park: `<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L7 9H3l5 6H5l7 7 7-7h-3l5-6h-4z"/>
            </svg>`
        };

        /* ════════════════════════════════════════════════════════
           STATE
        ════════════════════════════════════════════════════════ */
        let map, tileLayer, userMarker, userCircle;
        let userLat = null, userLng = null;
        let allPlaces   = [];
        let leafMarkers = [];
        let mode        = 'pet';
        let activeFilter = 'all';
        let searchQ     = '';
        let maxDist     = 0;        // 0 = no limit

        /* ════════════════════════════════════════════════════════
           MAP INIT
        ════════════════════════════════════════════════════════ */
        map = L.map('map', { zoomControl: false, attributionControl: false })
              .setView(DEFAULT, 14);

        L.control.attribution({ prefix: '© OpenStreetMap', position: 'bottomright' }).addTo(map);
        L.control.zoom({ position: 'bottomright' }).addTo(map);
        tileLayer = L.tileLayer(TILES.pet, { maxZoom: 19 }).addTo(map);

        map.on('click', () => closeDetail());

        /* ════════════════════════════════════════════════════════
           GEOLOCATION — watchPosition
        ════════════════════════════════════════════════════════ */
        function startTracking() {
            if (!navigator.geolocation) { showToast('⚠️ Geolocation not available', 3500); return; }
            showToast('📡 Getting your location…', 0);
            navigator.geolocation.watchPosition(onPos, onErr,
                { enableHighAccuracy: true, maximumAge: 4000, timeout: 14000 });
        }

        function onPos(pos) {
            const { latitude: lat, longitude: lng, accuracy } = pos.coords;
            const first = userLat === null;
            userLat = lat; userLng = lng;

            if (userCircle) {
                userCircle.setLatLng([lat, lng]).setRadius(accuracy);
            } else {
                userCircle = L.circle([lat, lng], {
                    radius: accuracy, color: '#3b82f6',
                    fillColor: '#3b82f6', fillOpacity: .06, weight: 1.5
                }).addTo(map);
            }

            if (userMarker) {
                userMarker.setLatLng([lat, lng]);
            } else {
                const icon = L.divIcon({
                    className: '',
                    html: `<div class="user-pin">
                             <div class="user-dot"></div>
                             <div class="user-ring"></div>
                             <div class="user-ring2"></div>
                           </div>`,
                    iconSize: [16,16], iconAnchor: [8,8]
                });
                userMarker = L.marker([lat, lng], { icon, zIndexOffset: 2000 }).addTo(map);
                userMarker.bindTooltip('You', { permanent: false, direction: 'top' });
            }

            if (first) {
                map.setView([lat, lng], 15, { animate: true });
                document.getElementById('locBtn').classList.add('locating');
            }

            showToast(`📍 ~${Math.round(accuracy)}m accuracy`, 3500);
            renderList();
        }

        function onErr() { showToast('⚠️ Could not get location', 4000); }

        /* ════════════════════════════════════════════════════════
           FETCH
        ════════════════════════════════════════════════════════ */
        async function fetchData() {
            try {
                const res  = await fetch('/Map/GetMapData');
                const data = await res.json();

                allPlaces = [
                    ...(data.clinics      || []).map(p => ({...p, type:'clinic'})),
                    ...(data.stores       || []).map(p => ({...p, type:'store'})),
                    ...(data.adminMarkers || []).map(p => ({...p, type: p.markerType || 'petfriendly'}))
                    // ★ NO dangerReports — user map only shows pet-related places
                ];

                renderMarkers();
                renderList();
            } catch(e) {
                showToast('⚠️ Could not load map data', 4000);
            }
        }

        /* ════════════════════════════════════════════════════════
           FILTER
        ════════════════════════════════════════════════════════ */
        function visible() {
            return allPlaces.filter(p => {
                // Mode: pet = no danger (already excluded from allPlaces)
                // Chip filter
                const chipOk = activeFilter === 'all' ||
                    p.type === activeFilter ||
                    (activeFilter === 'petfriendly' && ['petfriendly','playground','park'].includes(p.type));
                // Search
                const searchOk = !searchQ ||
                    (p.name || '').toLowerCase().includes(searchQ) ||
                    (p.city || '').toLowerCase().includes(searchQ) ||
                    (p.area || '').toLowerCase().includes(searchQ);
                // Distance
                const dist = (userLat && maxDist > 0)
                    ? haversine(userLat, userLng, p.lat, p.lng)
                    : null;
                const distOk = !maxDist || !userLat || (dist !== null && dist <= maxDist);

                return chipOk && searchOk && distOk && p.lat && p.lng;
            });
        }

        /* ════════════════════════════════════════════════════════
           MAP MARKERS
        ════════════════════════════════════════════════════════ */
        function buildPin(type) {
            const color = COLORS[type] || '#7a9e35';
            const svgIco = PIN_SVG[type] || PIN_SVG.petfriendly;

            return L.divIcon({
                className: '',
                html: `<div class="wm-wrap">
                         <div class="wm-body">
                           <svg class="wm-svg" viewBox="0 0 38 46" xmlns="http://www.w3.org/2000/svg">
                             <path d="M19 2C10.7 2 4 8.7 4 17c0 10.8 13.6 25.5 14.2 26.1a1 1 0 0 0 1.6 0C20.4 42.5 34 27.8 34 17 34 8.7 27.3 2 19 2z"
                                   fill="${color}" stroke="rgba(255,255,255,0.35)" stroke-width="1"/>
                             <circle cx="19" cy="17" r="9.5" fill="rgba(0,0,0,0.1)"/>
                           </svg>
                           <div class="wm-ico">${svgIco}</div>
                         </div>
                         <div class="wm-shadow"></div>
                       </div>`,
                iconSize: [38, 50], iconAnchor: [19, 50]
            });
        }

        function renderMarkers() {
            leafMarkers.forEach(m => m.remove());
            leafMarkers = [];

            visible().forEach(p => {
                const m = L.marker([p.lat, p.lng], { icon: buildPin(p.type) }).addTo(map);
                m.on('click', e => { L.DomEvent.stopPropagation(e); openDetail(p); });
                leafMarkers.push(m);
            });
        }

        /* ════════════════════════════════════════════════════════
           SIDEBAR LIST
        ════════════════════════════════════════════════════════ */
        // Data store (avoids inline JSON issues)
        const _store = new Map(); let _sid = 0;
        function storeP(p) { const k = 's'+(++_sid); _store.set(k,p); return k; }

        function renderList() {
            const places = visible().map(p => ({
                ...p,
                _dist: (userLat && userLng) ? haversine(userLat, userLng, p.lat, p.lng) : null
            }));

            if (userLat) places.sort((a,b) => (a._dist??9999) - (b._dist??9999));

            const count = places.length;
            document.getElementById('sbCount').textContent =
                count > 0 ? `${count} place${count!==1?'s':''} found` : 'No places found';

            const list = document.getElementById('sbList');
            if (!count) {
                list.innerHTML = `<div class="sb-empty">
                    <div class="e-ico">🔍</div>
                    <p>No places match your filters.<br>Try adjusting your search.</p>
                </div>`;
                return;
            }

            list.innerHTML = places.map(p => {
                const col   = COLORS[p.type] || '#7a9e35';
                const label = LABELS[p.type] || p.type;
                const dist  = p._dist !== null ? fmtDist(p._dist) : '';
                const key   = storeP(p);

                return `<div class="place-item" onclick="listClick('${key}')">
                    <div class="pi-icon" style="background:${col}15;color:${col}">
                        ${typeEmoji(p.type)}
                    </div>
                    <div class="pi-body">
                        <div class="pi-name">${p.name || '—'}</div>
                        <div class="pi-meta">
                            <span class="pi-type" style="background:${col}18;color:${col}">${label}</span>
                            ${dist ? `<span class="pi-dist"><i class="fa-solid fa-route" style="font-size:.6rem"></i> ${dist}</span>` : ''}
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right pi-arr"></i>
                </div>`;
            }).join('');
        }

        function typeEmoji(t) {
            const m = { clinic:'🏥', store:'🛍️', petfriendly:'🌳', playground:'🎡', park:'🌲' };
            return m[t] || '📍';
        }

        window.listClick = function(key) {
            const p = _store.get(key);
            if (!p) return;
            map.setView([p.lat, p.lng], 16, { animate: true });
            openDetail(p);
        };

        /* ════════════════════════════════════════════════════════
           DETAIL PANEL
        ════════════════════════════════════════════════════════ */
        function openDetail(p) {
            const color = COLORS[p.type] || '#7a9e35';
            const label = LABELS[p.type] || p.type;
            const dist  = (userLat && userLng) ? haversine(userLat, userLng, p.lat, p.lng) : null;
            const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;

            // Photo / placeholder
            const photo = (p.image || p.logo)
                ? `<img src="${p.image||p.logo}" alt="${p.name}" />`
                : `<div class="dp-photo-ph" style="background:linear-gradient(135deg,${color}20,${color}40)">${typeEmoji(p.type)}</div>`;

            // Info rows
            const rows = [];
            if (p.city||p.area) rows.push(dRow('📍','Location',[p.city,p.area].filter(Boolean).join(', ')));
            if (dist !== null)  rows.push(dRow('📏','Distance', `<strong style="color:${color}">${fmtDist(dist)}</strong> from you`));
            if (p.phone)        rows.push(dRow('📞','Phone',`<a href="tel:${p.phone}">${p.phone}</a>`));
                   const _hrs = p.hours || p.workingHours || p.openingHours;
        if (_hrs) rows.push(dRow('🕐','Hours', _hrs));
            if (p.description)  rows.push(dRow('📝','About', p.description));
            if (p.website)      rows.push(dRow('🌐','Website',`<a href="${p.website}" target="_blank">${p.website.replace(/https?:\/\//,'')}</a>`));
            if (p.hasEmergency) rows.push(dRow('🚑','Emergency','<strong style="color:#16a34a">24/7 Available</strong>'));

            // Action buttons
            let actions = `<a class="dp-btn dp-btn-nav" href="${mapsUrl}" target="_blank">
                <i class="fa-solid fa-diamond-turn-right"></i> Get Directions
            </a>`;
            if (p.phone) actions += `<a class="dp-btn dp-btn-call" href="tel:${p.phone}">
                <i class="fa-solid fa-phone"></i> Call
            </a>`;
            if (p.website) actions += `<a class="dp-btn dp-btn-web" href="${p.website}" target="_blank">
                <i class="fa-solid fa-globe"></i>
            </a>`;

            document.getElementById('dpInner').innerHTML = `
            <div class="dp-photo" style="${!(p.image||p.logo)?'background:linear-gradient(135deg,'+color+'20,'+color+'40)':''}">
                ${photo}
                <button class="dp-close" onclick="closeDetail()">✕</button>
                <div class="dp-type-badge" style="background:${color}22;color:${color};border:1px solid ${color}44">
                    ${typeEmoji(p.type)} ${label}
                </div>
                ${dist !== null ? `<div class="dp-dist-pill">📏 ${fmtDist(dist)}</div>` : ''}
            </div>
            <div class="dp-content">
                <div class="dp-name">${p.name || '—'}</div>
                ${(p.city||p.area) ? `<div class="dp-addr">📍 ${[p.city,p.area].filter(Boolean).join(', ')}</div>` : ''}
                ${rows.join('')}
            </div>
            <div class="dp-actions">${actions}</div>`;

            document.getElementById('detailPanel').classList.add('open');
        }

        function dRow(ico, label, val) {
            return `<div class="dp-row">
                <div class="dp-ico">${ico}</div>
                <div>
                    <div class="dp-label">${label}</div>
                    <div class="dp-val">${val}</div>
                </div>
            </div>`;
        }

        window.closeDetail = function() {
            document.getElementById('detailPanel').classList.remove('open');
        };

        /* ════════════════════════════════════════════════════════
           CONTROLS
        ════════════════════════════════════════════════════════ */
        window.setMode = function(m) {
            mode = m;
            document.getElementById('btnPet').classList.toggle('active', m==='pet');
            document.getElementById('btnFull').classList.toggle('active', m==='full');
            tileLayer.setUrl(TILES[m]);
            renderMarkers(); renderList();
        };

        window.setFilter = function(btn, f) {
            activeFilter = f;
            document.querySelectorAll('.fchip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            renderMarkers(); renderList(); closeDetail();
        };

        window.onSearch = function(v) {
            searchQ = v.trim().toLowerCase();
            document.getElementById('searchClear').style.display = searchQ ? 'block' : 'none';
            renderMarkers(); renderList();
        };
        window.clearSearch = function() {
            document.getElementById('searchInput').value = '';
            searchQ = '';
            document.getElementById('searchClear').style.display = 'none';
            renderMarkers(); renderList();
        };

        window.onDistChange = function(v) {
            maxDist = parseFloat(v) || 0;
            renderMarkers(); renderList();
        };

        window.goToUser = function() {
            if (userLat && userLng) {
                map.setView([userLat, userLng], 16, { animate: true });
                showToast('📍 Centered on your location', 2500);
            } else {
                showToast('📡 Still locating…', 2500);
            }
        };

        /* ════════════════════════════════════════════════════════
           HELPERS
        ════════════════════════════════════════════════════════ */
        function haversine(lat1, lon1, lat2, lon2) {
            const R = 6371, r = Math.PI/180;
            const dL = (lat2-lat1)*r, dN = (lon2-lon1)*r;
            const a = Math.sin(dL/2)**2 + Math.cos(lat1*r)*Math.cos(lat2*r)*Math.sin(dN/2)**2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        }
        function fmtDist(km) { return km < 1 ? `${Math.round(km*1000)} m` : `${km.toFixed(1)} km`; }

        let _toastTimer;
        function showToast(msg, dur) {
            const t = document.getElementById('statusToast');
            t.textContent = msg; t.classList.add('show');
            clearTimeout(_toastTimer);
            if (dur > 0) _toastTimer = setTimeout(() => t.classList.remove('show'), dur);
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDetail(); });

        /* ════════════════════════════════════════════════════════
           BOOT
        ════════════════════════════════════════════════════════ */
        startTracking();
        fetchData();

        })();

        /* ── Navbar JS (identical to products page) ─── */
        const dd = document.getElementById('servicesDropdown');
        const dt = document.getElementById('servicesToggle');
        if (dd && dt) {
            dt.addEventListener('click', e => { e.stopPropagation(); dd.classList.toggle('open'); });
            document.addEventListener('click', e => { if (!dd.contains(e.target)) dd.classList.remove('open'); });
        }
        const mb = document.getElementById('menuBtn');
        const nl = document.getElementById('navLinks');
        if (mb && nl) {
            mb.addEventListener('click', e => { e.stopPropagation(); nl.classList.toggle('open'); });
            document.addEventListener('click', e => { if (!nl.contains(e.target) && !mb.contains(e.target)) nl.classList.remove('open'); });
        }
        const ms = document.getElementById('mobileServicesBlock');
        const mt = document.getElementById('mobileServicesToggle');
        if (ms && mt) mt.addEventListener('click', e => { e.stopPropagation(); ms.classList.toggle('open'); });
    </script>
</body>
</html>