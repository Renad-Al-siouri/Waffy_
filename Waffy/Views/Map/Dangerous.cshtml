@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dangerous Animals Report - Waffy</title>
    <link rel="stylesheet" href="~/css/dangerous-animals.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container danger-page">

        @* رسائل النجاح والخطأ *@
        @if (TempData["DangerSuccess"] != null)
        {
            <div style="background:#f0fff0;border:1px solid #b2dfb2;color:#2d7a2d;
                            padding:1rem 1.2rem;margin:1rem 0;border-radius:14px;
                            font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                @TempData["DangerSuccess"]
            </div>
        }
        @if (TempData["DangerError"] != null)
        {
            <div style="background:#fff0f0;border:1px solid #ffb2b2;color:#c0392b;
                            padding:1rem 1.2rem;margin:1rem 0;border-radius:14px;
                            font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem">
                ⚠️ @TempData["DangerError"]
            </div>
        }

        <section class="danger-hero">
            <h1>Report a Dangerous Animal</h1>
            <p>Help nearby users and clinics by reporting the exact location and condition clearly.</p>
        </section>

        @if (Context.Session.GetInt32("UserId") == null)
        {
            <div style="background:#fff4e6;border:1px solid #f0d4a8;color:#b36d2c;
                            padding:1.2rem 1.4rem;margin:1rem 0;border-radius:14px;
                            font-weight:700;font-family:Nunito,sans-serif;font-size:.95rem;
                            display:flex;align-items:center;gap:12px">
                <span style="font-size:1.4rem">🔒</span>
                <div>
                    You must be logged in to submit a report.
                    <a asp-controller="Account" asp-action="Login"
                       style="color:var(--olive-dark);text-decoration:underline;margin-left:6px">
                        Log in now →
                    </a>
                </div>
            </div>
        }

        @* ✅ الفورم الكامل مع كل الحقول بداخله مباشرةً *@
        <form method="post" asp-controller="Map" asp-action="SubmitDanger"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <section class="danger-card">
                <div class="alert-banner">
                    <div class="alert-icon">🚨</div>
                    <div>
                        <h3>Area Alert</h3>
                        <p>Your report will notify nearby clinics and users in the area.</p>
                    </div>
                </div>

                <section class="report-section">
                    <div class="report-head">
                        <h2>Animal Type & Problem</h2>
                        <p>Select the type of animal and the issue you noticed.</p>
                    </div>
                    <div class="divider"></div>

                    @* ✅ Animal Type — select مباشر *@
                    <label class="field-label">Animal Type</label>
                    <select name="animalType" class="field-select" required
                            style="width:100%;padding:12px 14px;border-radius:14px;
                                   border:1px solid #d8cdbf;font-weight:700;
                                   margin-bottom:16px;font-family:Nunito,sans-serif">
                        <option value="">Choose animal type</option>
                        <option value="Dog">🐕 Dog</option>
                        <option value="Cat">🐈 Cat</option>
                        <option value="Monkey">🐒 Monkey</option>
                        <option value="Reptile">🦎 Reptile</option>
                        <option value="Other">❓ Other</option>
                    </select>

                    @* ✅ Problem Type — select مباشر *@
                    <label class="field-label">Problem Type</label>
                    <select name="problemType" class="field-select" required
                            style="width:100%;padding:12px 14px;border-radius:14px;
                                   border:1px solid #d8cdbf;font-weight:700;
                                   margin-bottom:16px;font-family:Nunito,sans-serif">
                        <option value="">Choose problem type</option>
                        <option value="Aggressive">😡 Aggressive animal</option>
                        <option value="Injured">😿 Injured animal</option>
                        <option value="Stray">🚷 Stray animal</option>
                        <option value="Noise">🔊 Noise / disturbing</option>
                        <option value="Sick">😷 Sick animal</option>
                        <option value="Hazard">⚠️ Safety hazard</option>
                    </select>

                    @* ✅ Severity — select مباشر *@
                    <label class="field-label">Severity Level</label>
                    <select name="severity"
                            style="width:100%;padding:12px 14px;border-radius:14px;
                                   border:1px solid #d8cdbf;font-weight:700;
                                   margin-bottom:16px;font-family:Nunito,sans-serif">
                        <option value="High">🔴 High — Danger / urgent</option>
                        <option value="Medium" selected>🟠 Medium — Needs action</option>
                        <option value="Low">🟢 Low — Monitor only</option>
                    </select>
                </section>

                <section class="report-section">
                    <div class="report-head">
                        <h2>Location & Description</h2>
                        <p>Add the exact area details and describe the situation clearly.</p>
                    </div>
                    <div class="divider"></div>

                    <div class="form-grid two">
                        @* ✅ City مباشر *@
                        <label>
                            <span>City</span>
                            <select name="city" required
                                    style="width:100%;padding:12px 14px;border-radius:14px;
                                           border:1px solid #d8cdbf;font-weight:700;
                                           font-family:Nunito,sans-serif">
                                <option value="">Choose the city</option>
                                <option value="Amman">Amman</option>
                                <option value="Irbid">Irbid</option>
                                <option value="Zarqa">Zarqa</option>
                                <option value="Aqaba">Aqaba</option>
                                <option value="Salt">Salt</option>
                            </select>
                        </label>

                        @* ✅ Area مباشر *@
                        <label>
                            <span>Area / Street</span>
                            <input name="area" type="text"
                                   placeholder="Example: near school, King St..."
                                   style="width:100%;padding:12px 14px;border-radius:14px;
                                          border:1px solid #d8cdbf;font-weight:700;
                                          font-family:Nunito,sans-serif" />
                        </label>
                    </div>

                    @* ✅ الخريطة — للعرض فقط، الإحداثيات تُملأ بالـ JS *@
                    <div class="form-grid one map-only">
                        <label>
                            <span>Exact Location (optional)</span>
                            <div class="map-field-wrap">
                                <div id="reportMap"></div>
                            </div>
                            <small>Click on the map to select the exact location.</small>
                        </label>
                    </div>

                    @* ✅ Hidden inputs للإحداثيات فقط *@
                    <input type="hidden" id="hLatitude" name="latitude" value="" />
                    <input type="hidden" id="hLongitude" name="longitude" value="" />
                    <input type="hidden" id="hLocationText" name="locationText" value="" />

                    @* ✅ Description مباشر *@
                    <div class="form-grid one">
                        <label>
                            <span>Description</span>
                            <textarea name="description" required
                                      placeholder="Example: A large aggressive dog attacking children near the school..."
                                      style="width:100%;padding:12px 14px;border-radius:14px;
                                             border:1px solid #d8cdbf;font-weight:700;
                                             min-height:120px;font-family:Nunito,sans-serif"></textarea>
                        </label>
                    </div>
                </section>
                
                <section class="report-section">
                    <div class="report-head">
                        <h2>Evidence Photos <span style="color:var(--muted);font-size:.8rem;font-weight:700">(optional)</span></h2>
                        <p>Upload up to 4 photos to support your report.</p>
                    </div>
                    <div class="divider"></div>

                    <input type="file"
                           id="reportImagesInput"
                           name="reportImages"
                           accept="image/*"
                           multiple
                           style="display:none"
                           onchange="handleImagePreview(this)" />

                    <div id="imageUploadArea"
                         onclick="document.getElementById('reportImagesInput').click()"
                         style="border:2px dashed #d8cdbf;border-radius:16px;padding:28px;
                text-align:center;cursor:pointer;background:#faf7f2;
                transition:border-color .2s">
                        <div style="font-size:2rem;margin-bottom:8px">📷</div>
                        <div style="font-weight:800;color:var(--text);font-size:.9rem">
                            Click to upload photos
                        </div>
                        <div style="color:var(--muted);font-size:.78rem;font-weight:700;margin-top:4px">
                            JPG, PNG — max 4 photos
                        </div>
                    </div>

                    <div id="imagePreviewGrid"
                         style="display:none;grid-template-columns:repeat(4,1fr);
            gap:10px;margin-top:12px">
                    </div>

                    <div id="imageCountMsg"
                         style="font-size:.78rem;font-weight:700;color:var(--muted);
                margin-top:8px;display:none">
                    </div>
                </section>

                <div class="report-actions">
                    <button type="submit" class="submit-report-btn">
                        🚨 Submit Report
                    </button>
                </div>

            </section>
        </form>
    </main>

    <div id="toast" class="toast"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // ✅ الخريطة فقط — بدون أي منطق submit
        document.addEventListener('DOMContentLoaded', function () {
            var mapEl = document.getElementById('reportMap');
            if (!mapEl) return;

            var map = L.map('reportMap').setView([31.9539, 35.9106], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            var marker = null;
            map.on('click', function (e) {
                if (marker) {
                    marker.setLatLng(e.latlng);
                } else {
                    marker = L.marker(e.latlng).addTo(map);
                }
                document.getElementById('hLatitude').value  = e.latlng.lat.toFixed(6);
                document.getElementById('hLongitude').value = e.latlng.lng.toFixed(6);
                document.getElementById('hLocationText').value =
                    e.latlng.lat.toFixed(4) + ', ' + e.latlng.lng.toFixed(4);
            });

            // Navbar
            var menuBtn  = document.getElementById('menuBtn');
            var navLinks = document.getElementById('navLinks');
            if (menuBtn && navLinks) {
                menuBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    navLinks.classList.toggle('open');
                });
                document.addEventListener('click', function (e) {
                    if (!navLinks.contains(e.target) && e.target !== menuBtn)
                        navLinks.classList.remove('open');
                });
            }
            var sd = document.getElementById('servicesDropdown');
            var st = document.getElementById('servicesToggle');
            if (sd && st) {
                st.addEventListener('click', function (e) {
                    e.stopPropagation(); sd.classList.toggle('open');
                });
                document.addEventListener('click', function () {
                    sd.classList.remove('open');
                });
            }
            var mt = document.getElementById('mobileServicesToggle');
            var mb = document.getElementById('mobileServicesBlock');
            if (mt && mb) mt.addEventListener('click', function () {
                mb.classList.toggle('open');
            });
        });

                      // ── متغير يحفظ الملفات المختارة الحالية ──
        var selectedFiles = [];

        function handleImagePreview(input) {
            // نجمع الملفات الجديدة مع الموجودة حتى 4 كحد أقصى
            var newFiles = Array.from(input.files);
            selectedFiles = selectedFiles.concat(newFiles).slice(0, 4);

            // نصفّر الـ input ثم نعيد بناء DataTransfer لنحدّث الـ input بالملفات الصحيحة
            var dt = new DataTransfer();
            selectedFiles.forEach(function(f) { dt.items.add(f); });
            input.files = dt.files;

            renderPreviews();
        }

        function renderPreviews() {
            var grid = document.getElementById('imagePreviewGrid');
            var msg  = document.getElementById('imageCountMsg');
            var area = document.getElementById('imageUploadArea');

            grid.innerHTML = '';

            if (selectedFiles.length === 0) {
                grid.style.display = 'none';
                msg.style.display  = 'none';
                area.style.display = 'block';
                return;
            }

            area.style.display  = 'none';
            grid.style.display  = 'grid';   // ← الآن يعمل لأن لا display:none في الـ CSS
            msg.style.display   = 'block';
            msg.textContent     = selectedFiles.length + ' photo' +
                                  (selectedFiles.length > 1 ? 's' : '') + ' selected';

            selectedFiles.forEach(function(file, i) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var div = document.createElement('div');
                    div.style.cssText = 'position:relative;border-radius:12px;overflow:hidden;' +
                                        'aspect-ratio:1;background:#f0e8d8';
                    div.innerHTML =
                        '<img src="' + e.target.result + '" ' +
                        '     style="width:100%;height:100%;object-fit:cover" />' +
                        '<button type="button" onclick="removeImage(' + i + ')" ' +
                        '        style="position:absolute;top:4px;right:4px;width:22px;height:22px;' +
                        '               border-radius:50%;background:rgba(0,0,0,.55);color:#fff;' +
                        '               border:none;cursor:pointer;font-size:.7rem;line-height:1">' +
                        '    ✕' +
                        '</button>';
                    grid.insertBefore(div, grid.lastChild);
                };
                reader.readAsDataURL(file);
            });

            // زر إضافة المزيد إذا أقل من 4
            if (selectedFiles.length < 4) {
                var addBtn = document.createElement('div');
                addBtn.onclick = function() {
                    document.getElementById('reportImagesInput').click();
                };
                addBtn.style.cssText =
                    'border:2px dashed #d8cdbf;border-radius:12px;display:flex;' +
                    'align-items:center;justify-content:center;aspect-ratio:1;' +
                    'cursor:pointer;color:#9e8f80;font-size:1.8rem;background:#faf7f2;' +
                    'font-weight:300';
                addBtn.textContent = '+';
                grid.appendChild(addBtn);
            }

            // نحدّث الـ input بالملفات الصحيحة
            var dt = new DataTransfer();
            selectedFiles.forEach(function(f) { dt.items.add(f); });
            document.getElementById('reportImagesInput').files = dt.files;
        }

        function removeImage(index) {
            selectedFiles.splice(index, 1);

            // نحدّث الـ input
            var dt = new DataTransfer();
            selectedFiles.forEach(function(f) { dt.items.add(f); });
            document.getElementById('reportImagesInput').files = dt.files;

            renderPreviews();
        }
    </script>
</body>
</html>