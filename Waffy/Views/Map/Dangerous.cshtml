    <main class="container danger-page">
        <section class="danger-hero">
            <h1>Report a Dangerous Animal</h1>
            <p>Help nearby users and clinics by reporting the exact location and condition clearly.</p>
        </section>

        <section class="danger-card">
            <div class="alert-banner">
                <div class="alert-icon">🚨</div>
                <div>
                    <h3>Area Alert</h3>
                    <p>Your report will notify nearby clinics and users in the area.</p>
                </div>
            </div>

            <section class="report-section">
                <div class="report-head">
                    <h2>Animal Type & Problem</h2>
                    <p>Select the type of animal and the issue you noticed.</p>
                </div>

                <div class="divider"></div>

                <label class="field-label">Animal Type</label>
                <div class="animal-type-grid">
                    <button class="choice-btn" data-animal="dog">🐕<span>Dog</span></button>
                    <button class="choice-btn" data-animal="cat">🐈<span>Cat</span></button>
                    <button class="choice-btn" data-animal="monkey">🐒<span>Monkey</span></button>
                    <button class="choice-btn" data-animal="reptile">🦎<span>Reptile</span></button>
                    <button class="choice-btn" data-animal="other">❓<span>Other</span></button>
                </div>

                <label class="field-label">Problem Type</label>
                <div class="problem-grid">
                    <button class="choice-btn problem-btn" data-problem="aggressive">😡 Aggressive animal</button>
                    <button class="choice-btn problem-btn" data-problem="injured">😿 Injured animal</button>
                    <button class="choice-btn problem-btn" data-problem="stray">🚷 Stray animal</button>
                    <button class="choice-btn problem-btn" data-problem="noise">🔊 Noise / disturbing</button>
                    <button class="choice-btn problem-btn" data-problem="sick">😷 Sick animal</button>
                    <button class="choice-btn problem-btn" data-problem="hazard">⚠️ Safety hazard</button>
                </div>

                <label class="field-label">Severity Level</label>
                <div class="severity-grid">
                    <button class="severity-btn" data-severity="high">
                        <span class="dot red"></span>
                        <strong>High</strong>
                        <small>Danger / urgent</small>
                    </button>

                    <button class="severity-btn active" data-severity="medium">
                        <span class="dot orange"></span>
                        <strong>Medium</strong>
                        <small>Needs action</small>
                    </button>

                    <button class="severity-btn" data-severity="low">
                        <span class="dot green"></span>
                        <strong>Low</strong>
                        <small>Monitor only</small>
                    </button>
                </div>
            </section>

            <section class="report-section">
                <div class="report-head">
                    <h2>Location & Description</h2>
                    <p>Add the exact area details and describe the situation clearly.</p>
                </div>

                <div class="divider"></div>

                <div class="form-grid two">
                    <label>
                        <span>City</span>
                        <select id="cityInput">
                            <option value="">Choose the city</option>
                            <option>Amman</option>
                            <option>Irbid</option>
                            <option>Zarqa</option>
                            <option>Aqaba</option>
                            <option>Salt</option>
                        </select>
                    </label>

                    <label>
                        <span>Area / Street</span>
                        <input id="streetInput" type="text" placeholder="Example: near school, King St..." />
                    </label>
                </div>

                <div class="form-grid one map-only">
                    <label>
                        <span>Exact Location</span>
                        <div class="map-field-wrap">
                            <div id="reportMap"></div>
                        </div>
                        <small>Click on the map to select the exact location.</small>
                    </label>
                </div>

                <div class="form-grid one">
                    <label>
                        <span>Description</span>
                        <textarea id="descriptionInput" placeholder="Example: A large aggressive dog attacking children near the school this morning..."></textarea>
                    </label>
                </div>

                <div class="form-grid one">
                    <label>
                        <span>Photos / Video</span>
                        <input id="mediaInput" type="file" accept="image/png,image/jpeg,image/jpg,video/mp4" />
                        <small>PNG, JPG, MP4 — important for verifying the report.</small>
                    </label>
                </div>
            </section>

            <section class="report-section">
                <div class="report-head">
                    <h2>Reporter Information</h2>
                    <p>Optional information for follow-up if needed.</p>
                </div>

                <div class="divider"></div>

                <div class="form-grid phone-report-grid">
                    <label>
                        <span>Name</span>
                        <input id="reporterName" type="text" placeholder="Your name" />
                    </label>

                    <h1></h1>
                    <h1></h1>
                    <label>
                        <span>Country Code</span>
                        <select id="reporterCode">
                            <option value="+962">JO +962</option>
                            <option value="+966">SA +966</option>
                            <option value="+971">UAE +971</option>
                            <option value="+20">EG +20</option>
                            <option value="+970">PS +970</option>
                        </select>
                    </label>

                    <label>
                        <span>Phone</span>
                        <input id="reporterPhone" type="text" placeholder="7X XXX XXXX" />
                    </label>
                </div>

                <div class="info-blue">
                    ℹ️ Your personal information will not be shared publicly. It will only be used when needed for safety follow-up.
                </div>
            </section>

            <div class="report-actions">

                <button id="submitReportBtn" class="submit-report-btn" type="button">Submit Report</button>
            </div>
        </section>
