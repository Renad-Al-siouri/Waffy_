@model Waffy.Models.ViewModels.ClinicDetailViewModel
@{
    ViewData["Title"] = $"Waffy — {Model.Name}";
    Layout = null;
    var dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    var now = DateTime.Now;
    var currentDow = (int)now.DayOfWeek;
    var currentTime = now.TimeOfDay;
    var todaySchedule = Model.Schedule.FirstOrDefault(s => (s.DayOfWeek ?? -1) == currentDow);
    bool isOpen = false;
    if (todaySchedule?.IsWorkingDay == true && todaySchedule.OpenTime.HasValue && todaySchedule.CloseTime.HasValue)
        isOpen = currentTime >= todaySchedule.OpenTime.Value && currentTime <= todaySchedule.CloseTime.Value;
    else if (Model.DefaultOpenTime.HasValue && Model.DefaultCloseTime.HasValue)
        isOpen = currentTime >= Model.DefaultOpenTime.Value && currentTime <= Model.DefaultCloseTime.Value;
    var bgClass = $"cover-bg{Model.IdClinic % 4}";
    var initials2 = (string name) =>
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : name.Length > 0 ? name[0].ToString().ToUpper() : "Dr";
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/stylev.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --wg: #7d953d;
            --wgl: #9ab451;
            --wgp: #eef4dd;
            --wgb: #dbe8b8;
            --wb: #f8efea;
            --ws: #fbf6f1;
            --ww: #fffdf9;
            --wt: #45382e;
            --wm: #7b6c58;
            --wl: #e8ddd0;
            --wr: #c86a5c;
            --wgold: #efb83c;
            --sh: 0 4px 14px rgba(90,75,49,.08);
            --shh: 0 10px 28px rgba(90,75,49,.14);
        }

        /* ── Cover ── */
        .detail-cover {
            position: relative;
            height: 280px;
            overflow: hidden;
        }

            .detail-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .cover-ph {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 6rem;
        }

        .cover-bg0 {
            background: linear-gradient(135deg,#dbe8b8,#8da546);
        }

        .cover-bg1 {
            background: linear-gradient(135deg,#bccc7e,#5f7430);
        }

        .cover-bg2 {
            background: linear-gradient(135deg,#d4e8b8,#4aac72);
        }

        .cover-bg3 {
            background: linear-gradient(135deg,#c8dcac,#7d953d);
        }

        .cover-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom,transparent 45%,rgba(45,36,26,.35));
        }

        .cover-back {
            position: absolute;
            top: 18px;
            left: 18px;
            padding: 8px 16px;
            background: rgba(255,253,249,.88);
            backdrop-filter: blur(8px);
            border-radius: 999px;
            border: 1px solid var(--wl);
            font-size: .82rem;
            font-weight: 800;
            color: var(--wm);
            text-decoration: none;
            transition: .18s;
            z-index: 2;
        }

            .cover-back:hover {
                background: #fff;
                color: var(--wg);
            }

        .emg-banner {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(200,106,92,.92);
            color: #fff;
            padding: 10px 20px;
            font-size: .84rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 2;
        }

        /* ── Info Bar ── */
        .info-bar {
            background: var(--ww);
            border-bottom: 1px solid var(--wl);
            box-shadow: 0 3px 10px rgba(90,75,49,.07);
        }

        .info-bar-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 16px;
            display: flex;
            align-items: flex-start;
            gap: 18px;
        }

        .info-logo {
            width: 72px;
            height: 72px;
            border-radius: 16px;
            background: var(--ww);
            border: 2px solid var(--wl);
            box-shadow: var(--sh);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            flex-shrink: 0;
            margin-top: -28px;
            margin-bottom: 14px;
            position: relative;
            z-index: 2;
        }

            .info-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .info-content {
            flex: 1;
            padding: 12px 0 14px;
        }

        .info-name-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 3px;
        }

        .info-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.55rem;
            font-weight: 700;
            color: var(--wt);
            margin: 0;
            line-height: 1.1;
        }

        .info-verified {
            font-size: 11px;
            font-weight: 800;
            color: #5f7430;
            background: var(--wgp);
            padding: 3px 9px;
            border-radius: 999px;
            border: 0.5px solid var(--wgb);
            white-space: nowrap;
        }

        .info-status-open {
            font-size: 11px;
            font-weight: 800;
            color: #fff;
            background: rgba(125,149,61,.88);
            padding: 3px 10px;
            border-radius: 999px;
        }

        .info-status-closed {
            font-size: 11px;
            font-weight: 800;
            color: var(--wr);
            background: rgba(200,106,92,.1);
            padding: 3px 10px;
            border-radius: 999px;
            border: 0.5px solid rgba(200,106,92,.3);
        }

        .info-type {
            font-size: 12px;
            color: var(--wm);
            font-weight: 700;
            margin-bottom: 6px;
        }

        .info-meta {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            font-size: .82rem;
            color: var(--wm);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .info-stats {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            font-size: .82rem;
            font-weight: 800;
            color: var(--wm);
        }

        .stat-badge {
            background: var(--ws);
            border: 0.5px solid var(--wl);
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
        }

        .stars-gold {
            color: var(--wgold);
            letter-spacing: 1px;
        }

        /* ── Anchor Nav ── */
        .anchor-nav {
            position: sticky;
            top: 64px;
            z-index: 90;
            background: rgba(251,246,241,.96);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--wl);
            box-shadow: 0 2px 8px rgba(90,75,49,.06);
        }

        .anchor-nav-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 16px;
            display: flex;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .anchor-nav-inner::-webkit-scrollbar {
                display: none;
            }

        .anchor-link {
            padding: 13px 20px;
            font-size: .84rem;
            font-weight: 800;
            color: var(--wm);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            transition: .2s;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .anchor-link:hover {
                color: var(--wg);
                border-bottom-color: rgba(125,149,61,.4);
            }

            .anchor-link.active {
                color: var(--wg);
                border-bottom-color: var(--wg);
            }

        /* ── Layout ── */
        .detail-layout {
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 16px 60px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 24px;
            align-items: start;
        }

        .detail-main {
            min-width: 0;
        }

        /* ── Sections ── */
        .d-section {
            background: var(--ww);
            border-radius: 18px;
            border: 1px solid var(--wl);
            box-shadow: var(--sh);
            margin-bottom: 18px;
            overflow: hidden;
        }

        .d-section-head {
            padding: 1rem 1.3rem .7rem;
            border-bottom: 1px solid var(--wl);
            font-family: 'Fredoka',sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--wg);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .d-section-body {
            padding: 1.2rem 1.3rem;
        }

        /* Services */
        .services-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .svc-tag {
            padding: 7px 16px;
            border-radius: 999px;
            background: var(--wgp);
            color: #5f7430;
            font-size: .82rem;
            font-weight: 800;
            border: 0.5px solid var(--wgb);
        }

        /* Schedule */
        .sch-row {
            display: flex;
            align-items: center;
            padding: 9px 0;
            border-bottom: 0.5px solid var(--wl);
            font-size: .84rem;
        }

            .sch-row:last-child {
                border-bottom: none;
            }

        .sch-day {
            width: 110px;
            font-weight: 800;
            color: var(--wt);
            flex-shrink: 0;
        }

        .sch-today {
            color: var(--wg);
        }

        .sch-time {
            font-weight: 700;
            color: var(--wg);
        }

        .sch-closed {
            font-weight: 700;
            color: rgba(123,108,88,.5);
        }

        .sch-now-badge {
            margin-left: 8px;
            font-size: 10px;
            font-weight: 900;
            color: #fff;
            background: rgba(125,149,61,.88);
            padding: 2px 7px;
            border-radius: 999px;
        }

        /* Doctors */
        .doctors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
            gap: 14px;
        }

        .doctor-card-v2 {
            background: var(--ws);
            border-radius: 16px;
            border: 1px solid var(--wl);
            padding: 1rem;
            text-align: center;
            transition: .2s;
            text-decoration: none;
            color: inherit;
            display: block;
        }

            .doctor-card-v2:hover {
                border-color: var(--wgb);
                box-shadow: 0 6px 16px rgba(90,75,49,.1);
                transform: translateY(-2px);
            }

        .doc-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg,#9ab451,#7d953d);
            color: #fff;
            font-family: 'Fredoka',sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            box-shadow: 0 6px 14px rgba(125,149,61,.25);
        }

        .doc-name {
            font-size: .88rem;
            font-weight: 900;
            color: var(--wt);
            margin-bottom: 3px;
        }

        .doc-spec {
            font-size: .74rem;
            color: var(--wm);
            font-weight: 700;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .doc-exp {
            font-size: .72rem;
            color: var(--wm);
            font-weight: 700;
            margin-bottom: 8px;
        }

        .doc-rating {
            font-size: .75rem;
            color: var(--wgold);
            font-weight: 800;
            margin-bottom: 8px;
        }

        .doc-link {
            display: inline-block;
            padding: 5px 14px;
            border-radius: 999px;
            background: var(--wgp);
            color: #5f7430;
            font-size: .76rem;
            font-weight: 900;
            text-decoration: none;
            border: 0.5px solid var(--wgb);
            transition: .18s;
        }

            .doc-link:hover {
                background: var(--wgb);
            }

        /* Gallery */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 8px;
        }

        .gallery-img {
            height: 100px;
            border-radius: 12px;
            object-fit: cover;
            width: 100%;
            border: 0.5px solid var(--wl);
            transition: .2s;
            cursor: pointer;
        }

            .gallery-img:hover {
                transform: scale(1.03);
                box-shadow: var(--sh);
            }

        /* ── Sidebar ── */
        .detail-sidebar {
            position: sticky;
            top: 130px;
        }

        .sidebar-card {
            background: var(--ww);
            border-radius: 18px;
            border: 1px solid var(--wl);
            box-shadow: var(--sh);
            padding: 1.2rem;
            margin-bottom: 12px;
        }

        .sidebar-title {
            font-family: 'Fredoka',sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--wg);
            margin-bottom: .9rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sb-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 7px 0;
            border-bottom: 0.5px solid var(--wl);
            font-size: .82rem;
        }

            .sb-row:last-child {
                border-bottom: none;
            }

        .sb-lbl {
            color: var(--wm);
            font-weight: 700;
            flex-shrink: 0;
            margin-right: 8px;
        }

        .sb-val {
            font-weight: 800;
            color: var(--wt);
            text-align: right;
            word-break: break-word;
        }

        .sb-link {
            color: var(--wg);
            text-decoration: none;
        }

        .sb-open {
            color: #5f7430;
            font-weight: 900;
        }

        .sb-closed {
            color: var(--wr);
            font-weight: 900;
        }

        .sb-hours-note {
            font-size: .74rem;
            color: var(--wm);
            font-weight: 700;
            margin-top: 2px;
            display: block;
        }

        /* Book Button */
        .book-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(180deg,#9ab451,#7d953d);
            color: #fff;
            border: none;
            border-radius: 14px;
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: .22s;
            box-shadow: 0 8px 20px rgba(125,149,61,.25);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .book-btn:hover {
                background: linear-gradient(180deg,#8da546,#708734);
                transform: translateY(-1px);
            }

        .book-note {
            text-align: center;
            font-size: .74rem;
            color: var(--wm);
            font-weight: 700;
        }

        /* Toast */
        .wa-toast {
            position: fixed;
            left: 50%;
            bottom: 28px;
            transform: translateX(-50%) translateY(20px);
            background: #33411f;
            color: #fff;
            padding: 12px 20px;
            border-radius: 14px;
            box-shadow: 0 16px 28px rgba(0,0,0,.16);
            opacity: 0;
            pointer-events: none;
            transition: .3s ease;
            z-index: 3000;
            font-weight: 700;
            font-size: .86rem;
            font-family: 'Nunito',sans-serif;
            white-space: nowrap;
        }

            .wa-toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* About */
        .about-text {
            font-size: .9rem;
            color: var(--wm);
            line-height: 1.85;
            font-weight: 700;
            margin: 0;
        }

        .about-meta {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 1rem;
        }

        .about-meta-item {
            background: var(--ws);
            border-radius: 12px;
            padding: .75rem 1rem;
            border: 0.5px solid var(--wl);
        }

        .about-meta-label {
            font-size: .72rem;
            color: var(--wm);
            font-weight: 700;
            margin-bottom: 3px;
        }

        .about-meta-val {
            font-size: .88rem;
            font-weight: 900;
            color: var(--wt);
        }

        @@media (max-width:900px) {
            .detail-layout

        {
            grid-template-columns: 1fr;
        }

        .detail-sidebar {
            position: static;
        }

        .gallery-grid {
            grid-template-columns: repeat(2,1fr);
        }

        }
        @@media (max-width:540px) {
            .detail-cover

        {
            height: 200px;
        }

        .info-name {
            font-size: 1.2rem;
        }

        .about-meta {
            grid-template-columns: 1fr;
        }

        }
    </style>
</head>
<body>

    <!-- ── Navbar ── -->
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link active">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn"><img src="~/Images/user.jpg" alt="Profile"></a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="~/Images/logo.png" alt="Waffy Logo"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link active">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- ── Hero Cover ── -->
    <div class="detail-cover">
        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" alt="@Model.Name">
        }
        else
        {
            <div class="cover-ph @bgClass">🏥</div>
        }
        <div class="cover-gradient"></div>
        <a asp-controller="Clinic" asp-action="Clinics" class="cover-back">
            ← Back to Clinics
        </a>
        @if (Model.HasEmergency)
        {
            <div class="emg-banner">
                🚨 <strong>Emergency Services Available</strong> — This clinic is open 24/7 for urgent cases
            </div>
        }
    </div>

    <!-- ── Info Bar ── -->
    <div class="info-bar">
        <div class="info-bar-inner">
            <div class="info-logo">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="Logo">
                }
                else
                {
                    <span>🏥</span>
                }
            </div>
            <div class="info-content">
                <div class="info-name-row">
                    <h1 class="info-name">@Model.Name</h1>
                    <span class="info-verified">✓ Verified by Waffy</span>
                    @if (isOpen)
                    {
                        <span class="info-status-open">● Open Now</span>
                    }
                    else
                    {
                        <span class="info-status-closed">● Closed</span>
                    }
                </div>
                <div class="info-type">@(Model.ClinicType ?? "Veterinary Clinic")</div>
                <div class="info-meta">
                    <span>
                        <i class="fa-solid fa-location-dot" style="color:#97ad4d;font-size:11px;"></i>
                        @Model.City@(!string.IsNullOrEmpty(Model.Area) ? $", {Model.Area}" : "")
                    </span>
                    <span><i class="fa-solid fa-phone" style="color:#97ad4d;font-size:11px;"></i> @Model.Phone</span>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <span><i class="fa-solid fa-envelope" style="color:#97ad4d;font-size:11px;"></i> @Model.Email</span>
                    }
                </div>
                <div class="info-stats">
                    @if (Model.Rating > 0)
                    {
                        <span class="stat-badge"><span class="stars-gold">★</span> @Model.Rating.ToString("F1")</span>
                    }
                    @if (Model.Doctors.Any())
                    {
                        <span class="stat-badge">👨‍⚕️ @Model.Doctors.Count Doctor(s)</span>
                    }
                    @if (Model.Services.Any())
                    {
                        <span class="stat-badge">🩺 @Model.Services.Count Service(s)</span>
                    }
                    @if (Model.GalleryImages.Any())
                    {
                        <span class="stat-badge">🖼 @Model.GalleryImages.Count Photo(s)</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Anchor Nav ── -->
    <nav class="anchor-nav" id="anchorNav">
        <div class="anchor-nav-inner">
            <a href="#overview" class="anchor-link active">Overview</a>
            <a href="#services" class="anchor-link">Services</a>
            <a href="#hours" class="anchor-link">Working Hours</a>
            @if (Model.Doctors.Any())
            {
                <a href="#doctors" class="anchor-link">Doctors</a>
            }
            @if (Model.GalleryImages.Any())
            {
                <a href="#gallery" class="anchor-link">Gallery</a>
            }
        </div>
    </nav>

    <!-- ── Main Layout ── -->
    <div class="detail-layout">

        <!-- ── Main Content ── -->
        <div class="detail-main">

            <!-- Overview -->
            <div id="overview" class="d-section content-section">
                <div class="d-section-head">
                    <i class="fa-solid fa-circle-info" style="color:var(--wg);font-size:14px;"></i>
                    Overview
                </div>
                <div class="d-section-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="about-text">@Model.Description</p>
                    }
                    else
                    {
                        <p class="about-text" style="color:rgba(123,108,88,.5);">No description provided yet.</p>
                    }
                    <div class="about-meta">
                        <div class="about-meta-item">
                            <div class="about-meta-label">Clinic Type</div>
                            <div class="about-meta-val">@(Model.ClinicType ?? "Veterinary Clinic")</div>
                        </div>
                        <div class="about-meta-item">
                            <div class="about-meta-label">City</div>
                            <div class="about-meta-val">@Model.City@(!string.IsNullOrEmpty(Model.Area) ? $", {Model.Area}" : "")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="about-meta-item" style="grid-column:span 2;">
                                <div class="about-meta-label">Address</div>
                                <div class="about-meta-val">📍 @Model.Address</div>
                            </div>
                        }
                        @if (Model.HasEmergency)
                        {
                            <div class="about-meta-item" style="grid-column:span 2;background:rgba(200,106,92,.07);border-color:rgba(200,106,92,.25);">
                                <div class="about-meta-label" style="color:var(--wr);">Emergency</div>
                                <div class="about-meta-val" style="color:var(--wr);">🚨 24/7 Emergency Services Available</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Services -->
            @if (Model.Services.Any())
            {
                <div id="services" class="d-section content-section">
                    <div class="d-section-head">
                        <i class="fa-solid fa-stethoscope" style="color:var(--wg);font-size:14px;"></i>
                        Services
                    </div>
                    <div class="d-section-body">
                        <div class="services-grid">
                            @foreach (var svc in Model.Services)
                            {
                                <span class="svc-tag">🐾 @svc</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Working Hours -->
            <div id="hours" class="d-section content-section">
                <div class="d-section-head">
                    <i class="fa-regular fa-clock" style="color:var(--wg);font-size:14px;"></i>
                    Working Hours
                </div>
                <div class="d-section-body">
                    @if (!Model.Schedule.Any())
                    {
                        <div style="color:var(--wm);font-weight:700;font-size:.88rem;">
                            @if (Model.DefaultOpenTime.HasValue && Model.DefaultCloseTime.HasValue)
                            {
                                <span>
                                    Daily: @Model.DefaultOpenTime.Value.ToString(@"hh\:mm")
                                    – @Model.DefaultCloseTime.Value.ToString(@"hh\:mm")
                                </span>
                            }
                            else
                            {
                                <span style="color:rgba(123,108,88,.5);">Working hours not set yet.</span>
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var s in Model.Schedule)
                        {
                            var dow = s.DayOfWeek ?? 0;
                            var isToday = dow == currentDow;
                            <div class="sch-row">
                                <div class="sch-day @(isToday ? "sch-today" : "")">
                                    @dayNames[dow]
                                    @if (isToday)
                                    {
                                        <span style="font-size:10px;font-weight:900;margin-left:4px;color:var(--wgl);">Today</span>
                                    }
                                </div>
                                @if (s.IsWorkingDay == true && s.OpenTime.HasValue && s.CloseTime.HasValue)
                                {
                                    <div class="sch-time">
                                        @s.OpenTime.Value.ToString(@"hh\:mm") – @s.CloseTime.Value.ToString(@"hh\:mm")
                                        @if (isToday && isOpen)
                                        {
                                            <span class="sch-now-badge">Open Now</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="sch-closed">Closed</div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Doctors -->
            @if (Model.Doctors.Any())
            {
                <div id="doctors" class="d-section content-section">
                    <div class="d-section-head">
                        <i class="fa-solid fa-user-doctor" style="color:var(--wg);font-size:14px;"></i>
                        Our Doctors
                    </div>
                    <div class="d-section-body">
                        <div class="doctors-grid">
                            @foreach (var doc in Model.Doctors)
                            {
                                <a asp-controller="Clinic" asp-action="DoctorDetail"
                                   asp-route-id="@doc.IdDoctor"
                                   class="doctor-card-v2">
                                    @if (!string.IsNullOrEmpty(doc.ProfileImageUrl))
                                    {
                                        <img src="@doc.ProfileImageUrl" alt="Dr. @doc.FullName"
                                             class="doc-avatar"
                                             style="object-fit:cover;font-size:0;">
                                    }
                                    else
                                    {
                                        <div class="doc-avatar">@initials2(doc.FullName)</div>
                                    }
                                    <div class="doc-name">Dr. @doc.FullName</div>
                                    <div class="doc-spec">@(doc.Specialization ?? "General Veterinary")</div>
                                    @if (doc.ExperienceYears.HasValue)
                                    {
                                        <div class="doc-exp">@doc.ExperienceYears yrs experience</div>
                                    }
                                    @if (doc.Rating.HasValue && doc.Rating > 0)
                                    {
                                        <div class="doc-rating">★ @doc.Rating.Value.ToString("F1")</div>
                                    }
                                    <span class="doc-link">View Profile →</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Gallery -->
            @if (Model.GalleryImages.Any())
            {
                <div id="gallery" class="d-section content-section">
                    <div class="d-section-head">
                        <i class="fa-regular fa-images" style="color:var(--wg);font-size:14px;"></i>
                        Gallery
                    </div>
                    <div class="d-section-body">
                        <div class="gallery-grid">
                            @foreach (var img in Model.GalleryImages)
                            {
                                <img src="@img.ImageUrl" alt="Clinic photo" class="gallery-img"
                                     onclick="openImg('@img.ImageUrl')">
                            }
                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- ── Sidebar ── -->
        <aside class="detail-sidebar">

            <!-- Contact Card -->
            <div class="sidebar-card">
                <div class="sidebar-title">
                    <i class="fa-solid fa-address-card" style="color:var(--wg);font-size:14px;"></i>
                    Quick Contact
                </div>
                <div class="sb-row">
                    <span class="sb-lbl">Phone</span>
                    <a href="tel:@Model.Phone" class="sb-val sb-link">@Model.Phone</a>
                </div>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="sb-row">
                        <span class="sb-lbl">Email</span>
                        <a href="mailto:@Model.Email" class="sb-val sb-link" style="font-size:.78rem;">@Model.Email</a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <div class="sb-row">
                        <span class="sb-lbl">Address</span>
                        <span class="sb-val" style="font-size:.78rem;">@Model.Address</span>
                    </div>
                }
                <div class="sb-row">
                    <span class="sb-lbl">Status</span>
                    <span class="sb-val">
                        @if (isOpen)
                        {
                            <span class="sb-open">Open Now ●</span>
                        }
                        else
                        {
                            <span class="sb-closed">Closed ●</span>
                        }
                        @{
                            TimeSpan? openT = null;
                            TimeSpan? closeT = null;
                            if (todaySchedule?.IsWorkingDay == true)
                            {
                                openT = todaySchedule.OpenTime;
                                closeT = todaySchedule.CloseTime;
                            }
                            else if (Model.DefaultOpenTime.HasValue)
                            {
                                openT = Model.DefaultOpenTime;
                                closeT = Model.DefaultCloseTime;
                            }
                        }
                        @if (openT.HasValue && closeT.HasValue)
                        {
                            <span class="sb-hours-note">
                                @openT.Value.ToString(@"hh\:mm") – @closeT.Value.ToString(@"hh\:mm")
                            </span>
                        }
                    </span>
                </div>
            </div>

            <!-- Book Button -->
            <button class="book-btn" onclick="showToast()">
                <i class="fa-regular fa-calendar-check"></i>
                Book Appointment
            </button>
            <div class="book-note">Online booking coming soon</div>

        </aside>

    </div>

    <!-- Toast -->
    <div class="wa-toast" id="waToast">
        📅 Booking feature coming soon! Stay tuned.
    </div>

    <!-- Image Overlay -->
    <div id="imgOverlay" onclick="closeImg()"
         style="display:none;position:fixed;inset:0;background:rgba(45,36,26,.85);
                z-index:5000;align-items:center;justify-content:center;cursor:pointer;">
        <img id="imgFull" src="" alt=""
             style="max-width:90vw;max-height:90vh;border-radius:16px;object-fit:contain;">
    </div>

    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="About">Contact</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <script>
        // Navbar
        const dd = document.getElementById("servicesDropdown");
        const tg = document.getElementById("servicesToggle");
        if (dd && tg) {
            tg.addEventListener("click", e => { e.stopPropagation(); dd.classList.toggle("open"); });
            document.addEventListener("click", e => { if (!dd.contains(e.target)) dd.classList.remove("open"); });
        }
        const mb = document.getElementById("menuBtn");
        const nl = document.getElementById("navLinks");
        if (mb && nl) {
            mb.addEventListener("click", e => { e.stopPropagation(); nl.classList.toggle("open"); });
            document.addEventListener("click", e => { if (!nl.contains(e.target) && !mb.contains(e.target)) nl.classList.remove("open"); });
        }

        // Toast
        function showToast() {
            const t = document.getElementById("waToast");
            t.classList.add("show");
            setTimeout(() => t.classList.remove("show"), 3000);
        }

        // Gallery
        function openImg(src) {
            const ov = document.getElementById("imgOverlay");
            document.getElementById("imgFull").src = src;
            ov.style.display = "flex";
        }
        function closeImg() {
            document.getElementById("imgOverlay").style.display = "none";
        }

        // Anchor nav active on scroll
        document.addEventListener("DOMContentLoaded", () => {
            const sections = document.querySelectorAll(".content-section");
            const links = document.querySelectorAll(".anchor-link");
            const offset = 140;

            window.addEventListener("scroll", () => {
                let current = "";
                sections.forEach(s => {
                    if (window.scrollY >= s.offsetTop - offset) current = s.id;
                });
                links.forEach(l => l.classList.toggle("active", l.getAttribute("href") === "#" + current));
            });
        });
    </script>

</body>
</html>
