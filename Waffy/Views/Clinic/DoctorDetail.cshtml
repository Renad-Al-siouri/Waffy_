@model Waffy.Models.ViewModels.DoctorDetailViewModel
@{
    ViewData["Title"] = $"Dr. {Model.FullName} — Waffy";
    Layout = null;

    var dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    var dayAbbr = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    var workDays = new HashSet<int>();
    if (!string.IsNullOrEmpty(Model.WorkingDays))
        foreach (var d in Model.WorkingDays.Split(','))
            if (int.TryParse(d.Trim(), out var n)) workDays.Add(n);

    var now = DateTime.Now;
    var currentDow = (int)now.DayOfWeek;
    var currentTime = now.TimeOfDay;
    var isOpen = Model.IsAvailable == true
                      && Model.StartTime.HasValue && Model.EndTime.HasValue
                      && workDays.Contains(currentDow)
                      && currentTime >= Model.StartTime.Value
                      && currentTime <= Model.EndTime.Value;

    var initials = Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries) is { Length: >= 2 } p
                   ? $"{p[0][0]}{p[1][0]}".ToUpper()
                   : Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "Dr";

    var expLabel = Model.ExperienceYears switch
    {
        1 => "Less than 1 year",
        2 => "1–3 years",
        4 => "3–5 years",
        7 => "5–10 years",
        11 => "More than 10 years",
        _ => Model.ExperienceYears.HasValue ? $"{Model.ExperienceYears} years" : null
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/stylev.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --wg: #7d953d;
            --wgl: #9ab451;
            --wgp: #eef4dd;
            --wgb: #dbe8b8;
            --wb: #f8efea;
            --ws: #fbf6f1;
            --ww: #fffdf9;
            --wt: #45382e;
            --wm: #7b6c58;
            --wl: #e8ddd0;
            --wr: #c86a5c;
            --wgold: #efb83c;
            --sh: 0 4px 14px rgba(90,75,49,.08);
            --shh: 0 10px 28px rgba(90,75,49,.14);
        }

        /* ── Page Wrapper ── */
        .doctor-detail-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 28px 16px 60px;
        }

        /* ── Back Link ── */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--wm);
            font-size: .84rem;
            font-weight: 800;
            text-decoration: none;
            margin-bottom: 1.4rem;
            transition: .18s;
        }

            .back-link:hover {
                color: var(--wg);
            }

        /* ── Hero Card ── */
        .doctor-hero-card {
            background: var(--ww);
            border-radius: 24px;
            border: 1px solid var(--wl);
            box-shadow: var(--shh);
            padding: 2rem 2.2rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 2rem;
            flex-wrap: wrap;
        }

        .doctor-avatar-xl {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #9ab451, #5f7430);
            color: #fff;
            font-family: 'Fredoka', sans-serif;
            font-size: 2.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 10px 24px rgba(125,149,61,.3);
            border: 4px solid #fff;
            outline: 3px solid var(--wgb);
        }

        .doctor-hero-info {
            flex: 1;
            min-width: 200px;
        }

        .doctor-hero-name {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.9rem;
            font-weight: 700;
            color: var(--wt);
            margin: 0 0 4px;
        }

        .doctor-hero-spec {
            font-size: .96rem;
            font-weight: 800;
            color: var(--wg);
            margin-bottom: 10px;
        }

        .doctor-hero-meta {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 13px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 900;
        }

        .hb-available {
            background: rgba(125,149,61,.12);
            color: #5f7430;
            border: 1px solid var(--wgb);
        }

        .hb-unavailable {
            background: rgba(200,106,92,.1);
            color: var(--wr);
            border: 1px solid rgba(200,106,92,.25);
        }

        .hb-clinic {
            background: var(--ws);
            color: var(--wm);
            border: 1px solid var(--wl);
        }

        .hb-exp {
            background: var(--wgp);
            color: #5f7430;
            border: 1px solid var(--wgb);
        }

        /* Hero right side */
        .doctor-hero-right {
            text-align: center;
            flex-shrink: 0;
            background: var(--wgp);
            border-radius: 18px;
            padding: 1.2rem 1.6rem;
            border: 1px solid var(--wgb);
        }

        .hero-rating-val {
            font-family: 'Fredoka', sans-serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--wg);
            line-height: 1;
        }

        .hero-rating-stars {
            color: var(--wgold);
            font-size: 1rem;
            letter-spacing: 2px;
            margin: 4px 0;
        }

        .hero-rating-lbl {
            font-size: .72rem;
            color: var(--wm);
            font-weight: 700;
        }

        /* ── Layout ── */
        .doctor-detail-layout {
            display: grid;
            grid-template-columns: 1fr 290px;
            gap: 20px;
            align-items: start;
        }

        .doctor-main {
            min-width: 0;
        }

        /* ── Section Card ── */
        .d-card {
            background: var(--ww);
            border-radius: 18px;
            border: 1px solid var(--wl);
            box-shadow: var(--sh);
            margin-bottom: 16px;
            overflow: hidden;
        }

        .d-card-head {
            padding: .9rem 1.3rem .6rem;
            border-bottom: 1px solid var(--wl);
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Fredoka', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: var(--wg);
        }

        .d-card-body {
            padding: 1.2rem 1.3rem;
        }

        /* About */
        .about-text {
            font-size: .9rem;
            color: var(--wm);
            line-height: 1.85;
            font-weight: 700;
            margin: 0;
        }

        /* Info rows */
        .info-row {
            display: flex;
            align-items: flex-start;
            padding: 9px 0;
            border-bottom: .5px solid var(--wl);
            font-size: .86rem;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-icon {
            width: 28px;
            color: var(--wg);
            font-size: 13px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .info-label {
            width: 120px;
            color: var(--wm);
            font-weight: 700;
            flex-shrink: 0;
        }

        .info-val {
            font-weight: 800;
            color: var(--wt);
            flex: 1;
        }

        /* Working days chips */
        .day-chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .day-chip-on {
            padding: 5px 13px;
            border-radius: 999px;
            background: var(--wgp);
            color: #5f7430;
            font-size: .78rem;
            font-weight: 900;
            border: 1px solid var(--wgb);
        }

        .day-chip-off {
            padding: 5px 13px;
            border-radius: 999px;
            background: var(--ws);
            color: rgba(123,108,88,.4);
            font-size: .78rem;
            font-weight: 700;
            border: 1px solid rgba(232,221,208,.6);
        }

        .hours-row {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: .88rem;
            font-weight: 800;
            color: var(--wt);
        }

        .open-now-pill {
            padding: 3px 10px;
            border-radius: 999px;
            background: rgba(125,149,61,.88);
            color: #fff;
            font-size: .72rem;
            font-weight: 900;
        }

        .closed-pill {
            padding: 3px 10px;
            border-radius: 999px;
            background: rgba(200,106,92,.1);
            color: var(--wr);
            font-size: .72rem;
            font-weight: 800;
            border: .5px solid rgba(200,106,92,.3);
        }

        /* Language tags */
        .lang-tags {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .lang-tag {
            padding: 5px 13px;
            border-radius: 999px;
            background: var(--ws);
            color: var(--wm);
            font-size: .78rem;
            font-weight: 800;
            border: 1px solid var(--wl);
        }

        /* Cert link */
        .cert-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 16px;
            border-radius: 999px;
            background: var(--wgp);
            color: #5f7430;
            font-size: .82rem;
            font-weight: 900;
            text-decoration: none;
            border: 1px solid var(--wgb);
            transition: .18s;
        }

            .cert-link:hover {
                background: var(--wgb);
            }

        /* ── Sidebar ── */
        .doctor-sidebar {
            position: sticky;
            top: 100px;
        }

        .sb-card {
            background: var(--ww);
            border-radius: 18px;
            border: 1px solid var(--wl);
            box-shadow: var(--sh);
            padding: 1.2rem;
            margin-bottom: 12px;
        }

        .sb-title {
            font-family: 'Fredoka', sans-serif;
            font-size: .92rem;
            font-weight: 700;
            color: var(--wg);
            margin-bottom: .9rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sb-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 7px 0;
            border-bottom: .5px solid var(--wl);
            font-size: .82rem;
        }

            .sb-row:last-child {
                border-bottom: none;
            }

        .sb-lbl {
            color: var(--wm);
            font-weight: 700;
            flex-shrink: 0;
            margin-right: 8px;
        }

        .sb-val {
            font-weight: 800;
            color: var(--wt);
            text-align: right;
            word-break: break-word;
        }

        /* Book Button */
        .book-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(180deg,#9ab451,#7d953d);
            color: #fff;
            border: none;
            border-radius: 14px;
            font-family: 'Fredoka', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: .22s;
            box-shadow: 0 8px 20px rgba(125,149,61,.25);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .book-btn:hover {
                background: linear-gradient(180deg,#8da546,#708734);
                transform: translateY(-1px);
            }

        .book-note {
            text-align: center;
            font-size: .74rem;
            color: var(--wm);
            font-weight: 700;
        }

        /* Clinic link in sidebar */
        .clinic-link-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            border-radius: 12px;
            background: var(--ws);
            border: 1px solid var(--wl);
            text-decoration: none;
            color: var(--wt);
            transition: .18s;
            font-size: .84rem;
            font-weight: 800;
        }

            .clinic-link-btn:hover {
                background: var(--wgp);
                border-color: var(--wgb);
            }

        /* Toast */
        .wa-toast {
            position: fixed;
            left: 50%;
            bottom: 28px;
            transform: translateX(-50%) translateY(20px);
            background: #33411f;
            color: #fff;
            padding: 12px 20px;
            border-radius: 14px;
            box-shadow: 0 16px 28px rgba(0,0,0,.16);
            opacity: 0;
            pointer-events: none;
            transition: .3s ease;
            z-index: 3000;
            font-weight: 700;
            font-size: .86rem;
            font-family: 'Nunito', sans-serif;
        }

            .wa-toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* Responsive */
        @@media (max-width: 900px) {
            .doctor-detail-layout

        {
            grid-template-columns: 1fr;
        }

        .doctor-sidebar {
            position: static;
        }

        .doctor-hero-card {
            gap: 1.4rem;
        }

        }
        @@media (max-width: 540px) {
            .doctor-avatar-xl

        {
            width: 80px;
            height: 80px;
            font-size: 1.8rem;
        }

        .doctor-hero-name {
            font-size: 1.5rem;
        }

        .doctor-hero-right {
            width: 100%;
        }

        }
    </style>
</head>
<body>

    <!-- ══ Navbar ══ -->
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link active">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon">
                                    <i class="fa-solid fa-bell"></i>
                                </a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="~/Images/logo.png" alt="Waffy Logo">
                                    </div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link active">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- ══ Main ══ -->
    <main class="container">
        <div class="doctor-detail-page">

            <!-- Back -->
            @if (Model.IdClinic.HasValue)
            {
                <a asp-controller="Clinic" asp-action="ClinicDetail"
                   asp-route-id="@Model.IdClinic"
                   class="back-link fade-up">
                    <i class="fa-solid fa-arrow-left" style="font-size:12px;"></i>
                    Back to @(Model.ClinicName ?? "Clinic")
                </a>
            }
            else
            {
                <a asp-controller="Clinic" asp-action="Clinics" class="back-link fade-up">
                    <i class="fa-solid fa-arrow-left" style="font-size:12px;"></i>
                    Back to Clinics
                </a>
            }

            <!-- ── Hero Card ── -->
            <div class="doctor-hero-card fade-up">

                <!-- Avatar -->
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="Dr. @Model.FullName"
                         class="doctor-avatar-xl"
                         style="object-fit:cover; font-size:0;">
                }
                else
                {
                    <div class="doctor-avatar-xl">@initials</div>
                }

                <!-- Info -->
                <div class="doctor-hero-info">
                    <h1 class="doctor-hero-name">Dr. @Model.FullName</h1>
                    <div class="doctor-hero-spec">
                        @(Model.Specialization ?? "General Veterinary Medicine")
                        @if (!string.IsNullOrEmpty(Model.SecondarySpec))
                        {
                            <span style="color:var(--wm);font-weight:700;">
                                &nbsp;·&nbsp;@Model.SecondarySpec
                            </span>
                        }
                    </div>
                    <div class="doctor-hero-meta">
                        @if (Model.IsAvailable == true)
                        {
                            <span class="hero-badge hb-available">
                                <i class="fa-solid fa-circle" style="font-size:7px;"></i>
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="hero-badge hb-unavailable">
                                <i class="fa-regular fa-circle" style="font-size:7px;"></i>
                                Unavailable
                            </span>
                        }
                        @if (expLabel != null)
                        {
                            <span class="hero-badge hb-exp">
                                🎓 @expLabel experience
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Model.ClinicName))
                        {
                            <span class="hero-badge hb-clinic">
                                🏥 @Model.ClinicName
                            </span>
                        }
                    </div>
                </div>

                <!-- Rating -->
                <div class="doctor-hero-right">
                    @if (Model.Rating.HasValue && Model.Rating > 0)
                    {
                        <div class="hero-rating-val">@Model.Rating.Value.ToString("F1")</div>
                        <div class="hero-rating-stars">★★★★★</div>
                        <div class="hero-rating-lbl">Overall Rating</div>
                    }
                    else
                    {
                        <div style="font-size:1.8rem;margin-bottom:4px;">🌟</div>
                        <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--wg);">New</div>
                        <div class="hero-rating-lbl">No reviews yet</div>
                    }
                </div>

            </div>

            <!-- ── Two Column Layout ── -->
            <div class="doctor-detail-layout">

                <!-- ── Main Content ── -->
                <div class="doctor-main">

                    <!-- About -->
                    @if (!string.IsNullOrEmpty(Model.Bio))
                    {
                        <div class="d-card fade-up">
                            <div class="d-card-head">
                                <i class="fa-solid fa-user-doctor" style="font-size:14px;"></i>
                                About Dr. @Model.FullName.Split(' ')[0]
                            </div>
                            <div class="d-card-body">
                                <p class="about-text">@Model.Bio</p>
                            </div>
                        </div>
                    }

                    <!-- Qualifications & Professional Info -->
                    <div class="d-card fade-up">
                        <div class="d-card-head">
                            <i class="fa-solid fa-graduation-cap" style="font-size:14px;"></i>
                            Qualifications & Experience
                        </div>
                        <div class="d-card-body">
                            @if (!string.IsNullOrEmpty(Model.Specialization))
                            {
                                <div class="info-row">
                                    <div class="info-icon"><i class="fa-solid fa-stethoscope"></i></div>
                                    <div class="info-label">Specialty</div>
                                    <div class="info-val">
                                        @Model.Specialization
                                        @if (!string.IsNullOrEmpty(Model.SecondarySpec))
                                        {
                                            <span style="color:var(--wm);font-size:.84rem;">
                                                · @Model.SecondarySpec
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (expLabel != null)
                            {
                                <div class="info-row">
                                    <div class="info-icon"><i class="fa-regular fa-clock"></i></div>
                                    <div class="info-label">Experience</div>
                                    <div class="info-val">@expLabel</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Qualification))
                            {
                                <div class="info-row">
                                    <div class="info-icon"><i class="fa-solid fa-award"></i></div>
                                    <div class="info-label">Qualification</div>
                                    <div class="info-val">@Model.Qualification</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Languages))
                            {
                                <div class="info-row">
                                    <div class="info-icon"><i class="fa-solid fa-language"></i></div>
                                    <div class="info-label">Languages</div>
                                    <div class="info-val">
                                        <div class="lang-tags">
                                            @foreach (var lang in Model.Languages.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span class="lang-tag">@lang.Trim()</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                         
                        </div>
                    </div>

                    <!-- Working Schedule -->
                    @if (workDays.Any() || (Model.StartTime.HasValue && Model.EndTime.HasValue))
                    {
                        <div class="d-card fade-up">
                            <div class="d-card-head">
                                <i class="fa-regular fa-calendar-check" style="font-size:14px;"></i>
                                Working Schedule
                            </div>
                            <div class="d-card-body">

                                <!-- Day Chips -->
                                @if (workDays.Any())
                                {
                                    <div style="margin-bottom:14px;">
                                        <div style="font-size:.78rem;font-weight:800;color:var(--wm);margin-bottom:8px;">
                                            Working Days
                                        </div>
                                        <div class="day-chips">
                                            @for (int i = 0; i < 7; i++)
                                            {
                                                var isWorkDay = workDays.Contains(i);
                                                var isToday = i == currentDow;
                                                <span class="@(isWorkDay ? "day-chip-on" : "day-chip-off")"
                                                      style="@(isToday && isWorkDay ? "outline:2px solid var(--wg);outline-offset:2px;" : "")">
                                                    @dayAbbr[i]
                                                    @if (isToday && isWorkDay)
                                                    {
                                                        <span style="font-size:9px;"> ●</span>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }

                                <!-- Hours -->
                                @if (Model.StartTime.HasValue && Model.EndTime.HasValue)
                                {
                                    <div style="font-size:.78rem;font-weight:800;color:var(--wm);margin-bottom:8px;">
                                        Working Hours
                                    </div>
                                    <div class="hours-row">
                                        <i class="fa-regular fa-clock" style="color:var(--wg);"></i>
                                        @Model.StartTime.Value.ToString(@"hh\:mm")
                                        <span style="color:var(--wm);">–</span>
                                        @Model.EndTime.Value.ToString(@"hh\:mm")
                                        @if (isOpen)
                                        {
                                            <span class="open-now-pill">Open Now</span>
                                        }
                                        else
                                        {
                                            <span class="closed-pill">Closed Now</span>
                                        }
                                    </div>
                                }

                                <!-- Appointment Duration -->
                            </div>
                        </div>
                    }


                    @if (!string.IsNullOrEmpty(Model.Certifications) || Model.CertificationDocs.Any())
                    {
                        <div class="d-card fade-up">
                            <div class="d-card-head">
                                <i class="fa-solid fa-certificate" style="font-size:14px;"></i>
                                Certifications &amp; Qualifications
                            </div>
                            <div class="d-card-body">

                                <!-- Text description -->
                                @if (!string.IsNullOrEmpty(Model.Certifications))
                                {
                                    <div style="font-size:.88rem;color:var(--wm);font-weight:700;
                                    line-height:1.8;margin-bottom:@(Model.CertificationDocs.Any() ? "16px" : "0");">
                                        @foreach (var line in Model.Certifications.Split('\n',
                                                                        StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:4px;">
                                                <span style="color:var(--wg);flex-shrink:0;margin-top:2px;">✓</span>
                                                <span>@line.Trim()</span>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Certificate files/images -->
                                @if (Model.CertificationDocs.Any())
                                {
                                    <div style="font-size:.78rem;font-weight:800;color:var(--wm);margin-bottom:10px;">
                                        📎 Certificate Files
                                    </div>
                                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;">
                                        @foreach (var cert in Model.CertificationDocs)
                                        {
                                            var ext = System.IO.Path.GetExtension(cert.FileUrl).ToLowerInvariant();
                                            var isImg = ext is ".jpg" or ".jpeg" or ".png" or ".webp";
                                            <a href="@cert.FileUrl" target="_blank"
                                               style="display:block;border-radius:12px;overflow:hidden;
                                              border:1px solid var(--wl);text-decoration:none;
                                              transition:.2s;box-shadow:var(--sh);"
                                               onmouseover="this.style.transform='translateY(-2px)'"
                                               onmouseout="this.style.transform='translateY(0)'">
                                                @if (isImg)
                                                {
                                                    <img src="@cert.FileUrl" alt="Certificate"
                                                         style="width:100%;height:90px;object-fit:cover;display:block;">
                                                }
                                                else
                                                {
                                                    <div style="height:90px;display:flex;align-items:center;
                                                            justify-content:center;font-size:2.2rem;
                                                            background:var(--wgp);">
                                                        📄
                                                    </div>
                                                }
                                                <div style="padding:7px 9px;background:var(--ww);">
                                                    <div style="font-size:.72rem;font-weight:800;color:var(--wg);">
                                                        🎓 View Certificate
                                                    </div>
                                                    <div style="font-size:.68rem;color:var(--wm);font-weight:700;">
                                                        @cert.UploadedAt.ToString("MMM yyyy")
                                                    </div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                }

                            </div>
                        </div>
                    }
                </div>

                <!-- ── Sidebar ── -->
                <aside class="doctor-sidebar">

                    <!-- Book Button -->
                    <div class="sb-card">
                        @if (Model.IsAvailable == true && Model.IdClinic.HasValue)
                        {
                            <a asp-controller="Appointment" asp-action="Book"
                               asp-route-clinicId="@Model.IdClinic"
                               asp-route-doctorId="@Model.IdDoctor"
                               class="book-btn" style="text-decoration:none;">
                                <i class="fa-regular fa-calendar-check"></i>
                                Book Appointment
                            </a>
                        }
                        else
                        {
                            <button class="book-btn" style="opacity:.5;cursor:not-allowed;" disabled>
                                🔴 Not Available
                            </button>
                        }
                        <div class="book-note">Online booking coming soon</div>
                    </div>

                    <!-- Quick Contact -->
                    <div class="sb-card">
                        <div class="sb-title">
                            <i class="fa-solid fa-address-card" style="font-size:13px;color:var(--wg);"></i>
                            Quick Info
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <div class="sb-row">
                                <span class="sb-lbl">📞 Phone</span>
                                <a href="tel:@Model.Phone" class="sb-val"
                                   style="color:var(--wg);text-decoration:none;">
                                    @Model.Phone
                                </a>
                            </div>
                        }
                        <div class="sb-row">
                            <span class="sb-lbl">🩺 Specialty</span>
                            <span class="sb-val">@(Model.Specialization ?? "—")</span>
                        </div>
                        @if (expLabel != null)
                        {
                            <div class="sb-row">
                                <span class="sb-lbl">🎓 Experience</span>
                                <span class="sb-val">@expLabel</span>
                            </div>
                        }
                        <div class="sb-row">
                            <span class="sb-lbl">⭐ Rating</span>
                            <span class="sb-val">
                                @if (Model.Rating.HasValue && Model.Rating > 0)
                                {
                                    <span style="color:var(--wgold);">★</span> 
                                    @Model.Rating.Value.ToString("F1")
                                }
                                else
                                {

                                    <span>New Doctor</span>
                                }
                            </span>
                        </div>
                        <div class="sb-row">
                            <span class="sb-lbl">📅 Status</span>
                            <span class="sb-val">
                                @if (isOpen)
                                {
                                    <span style="color:#5f7430;font-weight:900;">● Open Now</span>
                                }
                                else
                                {
                                    <span style="color:var(--wr);font-weight:900;">● Closed</span>
                                }
                            </span>
                        </div>
                    </div>

                    <!-- Clinic Card -->
                    @if (!string.IsNullOrEmpty(Model.ClinicName) && Model.IdClinic.HasValue)
                    {
                        <div class="sb-card">
                            <div class="sb-title">
                                <i class="fa-solid fa-hospital" style="font-size:13px;color:var(--wg);"></i>
                                Works At
                            </div>
                            <a asp-controller="Clinic" asp-action="ClinicDetail"
                               asp-route-id="@Model.IdClinic"
                               class="clinic-link-btn">
                                <div>
                                    <div style="font-weight:900;font-size:.88rem;">🏥 @Model.ClinicName</div>
                                    @if (!string.IsNullOrEmpty(Model.ClinicCity))
                                    {
                                        <div style="font-size:.74rem;color:var(--wm);font-weight:700;margin-top:2px;">
                                            📍 @Model.ClinicCity
                                        </div>
                                    }
                                </div>
                                <i class="fa-solid fa-arrow-right"
                                   style="font-size:12px;color:var(--wg);flex-shrink:0;"></i>
                            </a>
                        </div>
                    }

                </aside>

            </div>
        </div>
    </main>

    <!-- Toast -->
    <div class="wa-toast" id="waToast">
        📅 Booking feature coming soon! Stay tuned.
    </div>

    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="About">Contact</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <script>
        // Toast
        function showBookToast() {
            const t = document.getElementById("waToast");
            t.classList.add("show");
            setTimeout(() => t.classList.remove("show"), 3000);
        }

        // Dropdown
        const dd = document.getElementById("servicesDropdown");
        const tg = document.getElementById("servicesToggle");
        if (dd && tg) {
            tg.addEventListener("click", e => { e.stopPropagation(); dd.classList.toggle("open"); });
            document.addEventListener("click", e => { if (!dd.contains(e.target)) dd.classList.remove("open"); });
        }
        const mb = document.getElementById("menuBtn");
        const nl = document.getElementById("navLinks");
        if (mb && nl) {
            mb.addEventListener("click", e => { e.stopPropagation(); nl.classList.toggle("open"); });
            document.addEventListener("click", e => {
                if (!nl.contains(e.target) && !mb.contains(e.target)) nl.classList.remove("open");
            });
        }

        // Fade-up
        document.addEventListener("DOMContentLoaded", () => {
            if ("IntersectionObserver" in window) {
                const obs = new IntersectionObserver(entries => {
                    entries.forEach(e => {
                        if (e.isIntersecting) { e.target.classList.add("show"); obs.unobserve(e.target); }
                    });
                }, { threshold: 0.08 });
                document.querySelectorAll(".fade-up").forEach(el => obs.observe(el));
            } else {
                document.querySelectorAll(".fade-up").forEach(el => el.classList.add("show"));
            }
        });
    </script>

</body>
</html>
