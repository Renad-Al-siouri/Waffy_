@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body>

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a href="signup.html" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:100%"></div></div>

            <div class="sw-wrap">
                <div class="sw-fwrap" style="max-width:700px;margin:0 auto;">
                    <div class="sw-screen on" id="sw-ssuccess">
                        <div class="sw-success">
                            <div class="sw-s-ico">🏪</div>
                            <div class="sw-s-title">Application Submitted Successfully!</div>
                            <div class="sw-s-sub">Thank you for registering your store on Waffy.<br>Your application will be reviewed and you will be contacted within <strong>24–48 hours</strong>.</div>
                            <div class="sw-s-badge">📬 Reference number: <strong id="swReqNum" style="color:var(--sw-gd);font-family:monospace">—</strong></div>

                            <div class="sw-timeline">
                                <div class="sw-tl-item"><div class="sw-tl-num">1</div>Your application has been received and review started ✅</div>
                                <div class="sw-tl-item"><div class="sw-tl-num">2</div>Official document verification (24 hours)</div>
                                <div class="sw-tl-item"><div class="sw-tl-num">3</div>Store approval by the Waffy admin team</div>
                                <div class="sw-tl-item"><div class="sw-tl-num">4</div>Email notification + account activation 🎉</div>
                            </div>

                            <div style="display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap">
                                <button class="sw-btn sw-btn-o sw-btn-lg" onclick="window.location.href='home-after.html'">← Back to Home</button>
                                <button class="sw-btn sw-btn-p sw-btn-lg" onclick="window.location.href='login.html'">Log In →</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>