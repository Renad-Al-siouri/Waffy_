@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="store-step-3">

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a asp-controller="Account" asp-action="Signup" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:75%"></div></div>

            <div class="sw-wrap">
                <aside class="sw-sidebar">
                    <div class="sw-sb-brand">
                        <div class="sw-sb-brand-title">🏪 Store Registration</div>
                        <div class="sw-sb-brand-sub">Join Waffy and start selling to thousands of pet owners across Jordan</div>
                    </div>

                    <div class="sw-sb-steps">
                        <div class="sw-sb-lbl">Registration Steps</div>
                        <div id="swSbSteps">
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">👤 Account Owner</div><div class="sw-si-sub">Step 1</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">🏪 Store Details & Location</div><div class="sw-si-sub">Step 2</div></div></div>
                            <div class="sw-si active"><div class="sw-si-num">3</div><div><div class="sw-si-title">📞 Contact & Payments</div><div class="sw-si-sub">Step 3</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">4</div><div><div class="sw-si-title">📄 Business & Docs</div><div class="sw-si-sub">Step 4</div></div></div>
                        </div>
                    </div>
                </aside>

                <div class="sw-fwrap">
                    <div class="sw-dots" id="swDots">
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot active"></div>
                        <div class="sw-dot"></div>
                    </div>

                    <div class="sw-screen on" id="sw-s3">
                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">📞</div>
                                <div>
                                    <div class="sw-card-title">Contact Information</div>
                                    <div class="sw-card-sub">How customers can reach your store</div>
                                </div>
                            </div>

                            <div class="sw-fg">
                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Email <span class="sw-req">*</span></label>
                                    <input class="sw-inp" id="sw-semail" type="email" placeholder="store@example.com" oninput="swCe(this)">
                                    <div class="sw-ferr" id="sw-e-semail">⚠ Please enter a valid email address</div>
                                    <div class="sw-hint">💡 This may be different from your personal account email</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">Store Phone <span class="sw-req">*</span></label>
                                    <div class="sw-ph-wrap">
                                        <span class="sw-ph-pre">🇯🇴 +962</span>
                                        <input class="sw-inp" id="sw-sphone" type="tel" placeholder="6 XXX XXXX" oninput="swCe(this)" style="flex:1">
                                    </div>
                                    <div class="sw-ferr" id="sw-e-sphone">⚠ Please enter a valid phone number</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">WhatsApp <span class="sw-opt">(Optional)</span></label>
                                    <div class="sw-ph-wrap">
                                        <span class="sw-ph-pre">🇯🇴 +962</span>
                                        <input class="sw-inp" type="tel" placeholder="7X XXX XXXX" style="flex:1">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">💳</div>
                                <div>
                                    <div class="sw-card-title">Accepted Payment Methods</div>
                                    <div class="sw-card-sub">Select all payment methods you accept</div>
                                </div>
                            </div>

                            <div class="sw-chip-group">
                                <div class="sw-chip" onclick="this.classList.toggle('on')">💵 Cash on Delivery</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">💳 Online Payment</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">👛 Waffy Wallet</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">🏦 Bank Transfer</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">📲 CliQ</div>
                            </div>
                        </div>

                        <div class="sw-fnav">
                            <a class="sw-btn sw-btn-o" asp-controller="Account" asp-action="Stor_step2">← Previous</a>
                            <a class="sw-btn sw-btn-p" asp-controller="Account" asp-action="Stor_step5">Next →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>