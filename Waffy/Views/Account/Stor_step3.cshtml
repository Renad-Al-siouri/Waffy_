    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="store-step-3">

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a href="signup.html" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:60%"></div></div>

            <div class="sw-wrap">
                <aside class="sw-sidebar">
                    <div class="sw-sb-brand">
                        <div class="sw-sb-brand-title">🏪 Store Registration</div>
                        <div class="sw-sb-brand-sub">Join Waffy and start selling to thousands of pet owners across Jordan</div>
                    </div>

                    <div class="sw-sb-steps">
                        <div class="sw-sb-lbl">Registration Steps</div>
                        <div id="swSbSteps">
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">👤 Account Owner</div><div class="sw-si-sub">Step 1</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">🏪 Store Information</div><div class="sw-si-sub">Step 2</div></div></div>
                            <div class="sw-si active"><div class="sw-si-num">3</div><div><div class="sw-si-title">📍 Contact & Location</div><div class="sw-si-sub">Step 3</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">4</div><div><div class="sw-si-title">🖼 Media & Payments</div><div class="sw-si-sub">Step 4</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">5</div><div><div class="sw-si-title">📄 Business & Docs</div><div class="sw-si-sub">Step 5</div></div></div>
                        </div>
                    </div>
                </aside>

                <div class="sw-fwrap">
                    <div class="sw-dots" id="swDots">
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot active"></div>
                        <div class="sw-dot"></div>
                        <div class="sw-dot"></div>
                    </div>

                    <div class="sw-screen on" id="sw-s3">
                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">📞</div>
                                <div>
                                    <div class="sw-card-title">Contact Information</div>
                                    <div class="sw-card-sub">How customers can reach your store</div>
                                </div>
                            </div>

                            <div class="sw-fg">
                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Email <span class="sw-req">*</span></label>
                                    <input class="sw-inp" id="sw-semail" type="email" placeholder="store@example.com" oninput="swCe(this)">
                                    <div class="sw-ferr" id="sw-e-semail">⚠ Please enter a valid email address</div>
                                    <div class="sw-hint">💡 This may be different from your personal account email</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">Store Phone <span class="sw-req">*</span></label>
                                    <div class="sw-ph-wrap">
                                        <span class="sw-ph-pre">🇯🇴 +962</span>
                                        <input class="sw-inp" id="sw-sphone" type="tel" placeholder="6 XXX XXXX" oninput="swCe(this)" style="flex:1">
                                    </div>
                                    <div class="sw-ferr" id="sw-e-sphone">⚠ Please enter a valid phone number</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">WhatsApp <span class="sw-opt">(Optional)</span></label>
                                    <div class="sw-ph-wrap">
                                        <span class="sw-ph-pre">🇯🇴 +962</span>
                                        <input class="sw-inp" type="tel" placeholder="7X XXX XXXX" style="flex:1">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">📍</div>
                                <div>
                                    <div class="sw-card-title">Store Location</div>
                                    <div class="sw-card-sub">Help customers find your store</div>
                                </div>
                            </div>

                            <div class="sw-fg">
                                <div class="sw-f">
                                    <label class="sw-lbl">Country <span class="sw-req">*</span></label>
                                    <select class="sw-inp" id="sw-country" oninput="swCe(this)">
                                        <option value="">Select country</option>
                                        <option selected>Jordan</option>
                                        <option>Saudi Arabia</option>
                                        <option>UAE</option>
                                        <option>Kuwait</option>
                                        <option>Qatar</option>
                                    </select>
                                    <div class="sw-ferr" id="sw-e-country">⚠ Please select a country</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">City <span class="sw-req">*</span></label>
                                    <select class="sw-inp" id="sw-scity" oninput="swCe(this)">
                                        <option value="">Select city</option>
                                        <option>Amman</option>
                                        <option>Zarqa</option>
                                        <option>Irbid</option>
                                        <option>Aqaba</option>
                                        <option>Salt</option>
                                        <option>Madaba</option>
                                        <option>Karak</option>
                                        <option>Jerash</option>
                                        <option>Other</option>
                                    </select>
                                    <div class="sw-ferr" id="sw-e-scity">⚠ Please select a city</div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Address <span class="sw-req">*</span></label>
                                    <input class="sw-inp" id="sw-saddr" placeholder="Street, neighborhood, building..." oninput="swCe(this)">
                                    <div class="sw-ferr" id="sw-e-saddr">⚠ Please enter your store address</div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Google Maps Link <span class="sw-opt">(Optional)</span></label>
                                    <input class="sw-inp" id="sw-gmaps" placeholder="https://maps.google.com/..." type="url">
                                    <div class="sw-hint">💡 Share a Google Maps link to make it easier for customers to find you</div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Delivery Available? <span class="sw-req">*</span></label>

                                    <div class="sw-del-toggle">
                                        <div class="sw-del-opt" id="swDelYes" onclick="swSetDel(true)">✅ Yes, delivery available</div>
                                        <div class="sw-del-opt" id="swDelNo" onclick="swSetDel(false)">❌ No, pickup only</div>
                                    </div>

                                    <div class="sw-del-extra" id="swDelExtra">
                                        <div class="sw-fg" style="margin-top:.6rem">
                                            <div class="sw-f sw-fw">
                                                <label class="sw-lbl">Delivery Areas</label>
                                                <textarea class="sw-inp" placeholder="e.g. Amman, Zarqa, Irbid..." style="min-height:70px"></textarea>
                                            </div>

                                            <div class="sw-f">
                                                <label class="sw-lbl">Delivery Fee (JOD)</label>
                                                <div class="sw-ph-wrap">
                                                    <input class="sw-inp" type="number" placeholder="0.00" style="flex:1">
                                                    <span class="sw-ph-pre">JOD</span>
                                                </div>
                                            </div>

                                            <div class="sw-f">
                                                <label class="sw-lbl">Estimated Delivery Time</label>
                                                <select class="sw-inp">
                                                    <option>Within 24 hours</option>
                                                    <option>1–2 business days</option>
                                                    <option>2–3 business days</option>
                                                    <option>3–5 business days</option>
                                                    <option>More than 5 days</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-fnav">
                            <button class="sw-btn sw-btn-o" onclick="window.location.href='store-step2.html'">← Previous</button>
                            <button class="sw-btn sw-btn-p" onclick="window.location.href='store-step4.html'">Next →</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>