@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – Logged Out</title>

    <link rel="stylesheet" href="~/css/logstyle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

    <main class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="../Images/biglogo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>


        <h1 class="card-title">You’ve Been Logged Out!</h1>

        <p class="card-sub">
            We'll miss you. If you need anything, we're always here to help.
            Goodbye for now...
        </p>

        <a asp-controller="Account" asp-action="Login" id="loginBtn" class="btn-send" style="display:flex;width:100%;height:50px;align-items:center;justify-content:center;text-align:center;text-decoration:none;color:#fff;margin:0 auto;border-radius:12px;background:linear-gradient(135deg,#59652a,#97ad4d);font-family:'Nunito',sans-serif;font-weight:800;font-size:0.95rem;padding:12px;box-shadow:0 8px 18px rgba(151,173,77,0.16);">Log In Again</a>

    </main>

    <script src="~/js/logjs.js"></script>
</body>
</html>