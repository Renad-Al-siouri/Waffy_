@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – Reset Password</title>

    <link rel="stylesheet" href="~/css/ResetPass.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>

    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="../Images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card reset-card">
            <div class="reset-view" id="resetView">
                <div class="card-title">Reset Password</div>

                <div class="card-sub">
                    Please enter your new password and confirm it
                </div>

                <form id="resetForm" novalidate>
                    <div class="field">
                        <i class="fa-solid fa-lock field-icon"></i>
                        <input type="password" id="newPassword" placeholder="New Password" />
                        <button type="button" class="toggle-password" onclick="togglePassword('newPassword', this)">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <div class="field">
                        <i class="fa-solid fa-lock field-icon"></i>
                        <input type="password" id="confirmPassword" placeholder="Confirm New Password" />
                        <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <button type="submit" class="btn-reset">Reset Password</button>
                </form>

                <div class="bottom-link">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login" >Log In</a>
                </div>
            </div>

            <div class="success-view" id="successView">
                <div class="success-stars">✦ ✦</div>
                <div class="success-title">Password Changed</div>
                <div class="success-text">
                    Your password has been changed successfully
                </div>
                <a asp-controller="Account" asp-action="Login" class="btn-login">Back to Login</a>
            </div>
        </div>
    </div>

    <script src="~/js/ResetPass.js"></script>
</body>
</html>