@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Sign Up</title>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/signup.css" />
</head>
<body>
    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="~/Images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card signup-role-card">
            <div class="card-title">Choose Your Account Type <i class="fa-solid fa-paw pet-paw-icon"></i></div>
            <div class="card-sub">
                Select the role that matches you, then continue with the registration steps.
            </div>

            <div class="signup-role-grid">
                <div class="signup-select-card user-card" onclick="window.location.href='user-step1.html'">
                    <div class="signup-select-icon"><i class="fa-regular fa-user signup-select-icon user-icon"></i></div>
                    <div class="signup-select-title">User</div>
                    <div class="signup-select-text">
                        Join Waffy as a pet owner and access pet services, appointments, shopping, and more.
                    </div>
                    <a asp-controller="Account" asp-action="user_signup" class="signup-select-btn">Continue as User</a>
                </div>

                <div class="signup-select-card store-card" onclick="goToPage('store-step1.html')">
                    <div class="signup-select-icon"><i class="fa-solid fa-store signup-select-icon store-icon"></i></div>
                    <div class="signup-select-title">Store</div>
                    <div class="signup-select-text">
                        Register your pet store and start selling products and supplies to pet owners across Jordan.
                    </div>
                    <a asp-controller="Account" asp-action="Stor_step1" class="signup-select-btn">Continue as Store</a>
                </div>

                <div class="signup-select-card clinic-card" onclick="goToPage('clinic-step1.html')">
                    <div class="signup-select-icon"><i class="fa-solid fa-house-medical signup-select-icon clinic-icon"></i></div>
                    <div class="signup-select-title">Clinic</div>
                    <div class="signup-select-text">
                        Register your clinic or join as a doctor and manage appointments, services, and records.
                    </div>
                    <a asp-controller="Account" asp-action="Clinic_step1" class="signup-select-btn">Continue as Clinic</a>
                </div>
            </div>


        </div>
    </div>

    <script src="~/js/signup.js"></script>
</body>
</html>