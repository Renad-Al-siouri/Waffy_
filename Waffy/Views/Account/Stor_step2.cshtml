@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="store-step-2">

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a href="signup.html" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:40%"></div></div>

            <div class="sw-wrap">
                <aside class="sw-sidebar">
                    <div class="sw-sb-brand">
                        <div class="sw-sb-brand-title">🏪 Store Registration</div>
                        <div class="sw-sb-brand-sub">Join Waffy and start selling to thousands of pet owners across Jordan</div>
                    </div>

                    <div class="sw-sb-steps">
                        <div class="sw-sb-lbl">Registration Steps</div>
                        <div id="swSbSteps">
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">👤 Account Owner</div><div class="sw-si-sub">Step 1</div></div></div>
                            <div class="sw-si active"><div class="sw-si-num">2</div><div><div class="sw-si-title">🏪 Store Information</div><div class="sw-si-sub">Step 2</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">3</div><div><div class="sw-si-title">📍 Contact & Location</div><div class="sw-si-sub">Step 3</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">4</div><div><div class="sw-si-title">🖼 Media & Payments</div><div class="sw-si-sub">Step 4</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">5</div><div><div class="sw-si-title">📄 Business & Docs</div><div class="sw-si-sub">Step 5</div></div></div>
                        </div>
                    </div>
                </aside>

                <div class="sw-fwrap">
                    <div class="sw-dots" id="swDots">
                        <div class="sw-dot done"></div>
                        <div class="sw-dot active"></div>
                        <div class="sw-dot"></div>
                        <div class="sw-dot"></div>
                        <div class="sw-dot"></div>
                    </div>

                    <div class="sw-screen on" id="sw-s2">
                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">🏪</div>
                                <div>
                                    <div class="sw-card-title">Store Basic Information</div>
                                    <div class="sw-card-sub">This information will appear to customers on your store page</div>
                                </div>
                            </div>

                            <div class="sw-fg">
                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Name <span class="sw-req">*</span></label>
                                    <input class="sw-inp" id="sw-sname" placeholder="e.g. Pet Friends Store" oninput="swCe(this)">
                                    <div class="sw-ferr" id="sw-e-sname">⚠ Please enter your store name</div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Logo <span class="sw-opt">(Recommended)</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-logoFile')">
                                        <input type="file" id="sw-logoFile" accept="image/*" style="display:none" onchange="swPreviewFile(this,'sw-logoPrev','sw-logoName')">
                                        <div class="wf-upload-ico">🖼</div>
                                        <div class="wf-upload-txt"><strong>Click to upload logo</strong><br>PNG, JPG — max 5MB</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-logoPrev">
                                        <span>🖼</span>
                                        <span class="wf-prev-name" id="sw-logoName"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-logoFile','sw-logoPrev','sw-logoName')">✕ Remove</button>
                                    </div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Description <span class="sw-opt">(Optional)</span></label>
                                    <textarea class="sw-inp" id="sw-sdesc" placeholder="Write a brief description about your store, products, and what makes it unique..."></textarea>
                                    <div class="sw-hint">💡 Displayed to customers on your public store page</div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Type / Specialty <span class="sw-req">*</span></label>
                                    <div class="sw-hint" style="margin-bottom:.6rem">💡 You can select more than one type</div>

                                    <div class="sw-type-grid" id="swTypeGrid">
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">🐾</span><span class="sw-type-lbl">Pet Food<br><small style="font-size:.65rem;color:var(--sw-muted)">Animal nutrition</small></span></div>
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">🎀</span><span class="sw-type-lbl">Pet Accessories<br><small style="font-size:.65rem;color:var(--sw-muted)">Collars, toys &amp; more</small></span></div>
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">💊</span><span class="sw-type-lbl">Pet Pharmacy<br><small style="font-size:.65rem;color:var(--sw-muted)">Medicines &amp; vitamins</small></span></div>
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">✂️</span><span class="sw-type-lbl">Pet Grooming<br><small style="font-size:.65rem;color:var(--sw-muted)">Care &amp; styling</small></span></div>
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">🛒</span><span class="sw-type-lbl">All Pet Supplies<br><small style="font-size:.65rem;color:var(--sw-muted)">General supplies</small></span></div>
                                        <div class="sw-type-btn" onclick="this.classList.toggle('on')"><span class="sw-type-ico">🐟</span><span class="sw-type-lbl">Fish &amp; Reptiles<br><small style="font-size:.65rem;color:var(--sw-muted)">Aquatic &amp; exotic pets</small></span></div>
                                    </div>

                                    <div class="sw-ferr" id="sw-e-type" style="margin-top:5px">⚠ Please select at least one store type</div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-fnav">
                            <button class="sw-btn sw-btn-o" onclick="window.location.href='store-step1.html'">← Previous</button>
                            <button class="sw-btn sw-btn-p" onclick="window.location.href='store-step3.html'">Next →</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>