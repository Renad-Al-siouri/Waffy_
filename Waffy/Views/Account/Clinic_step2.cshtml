@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Clinic Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/clinic.css" />
</head>
<body class="clinic-step-2">
    <div id="clinicWizardContainer" dir="ltr" lang="en">
        <div class="cw-bg"></div>

        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo">Waffy</div>
                <div class="topbar-right">
                    <a asp-controller="Account" asp-action="Signup" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line">
                <div class="prog-fill" style="width:100%"></div>
            </div>

            <div class="cw-wrap">
                <aside class="cw-left">
                    <div class="cw-info-card" id="cwStepsCard">
                        <div class="cw-info-title">📋 Registration Steps</div>
                        <div id="cwStepsList">
                            <div class="cw-step-item">
                                <div class="cw-step-num done">✓</div>
                                <div class="cw-step-text">Clinic Information</div>
                            </div>
                            <div class="cw-step-item">
                                <div class="cw-step-num active">2</div>
                                <div class="cw-step-text">Clinic Owner Information</div>
                            </div>
                        </div>
                    </div>

                    <div class="cw-info-card">
                        <div class="cw-info-title">✨ Why Waffy?</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">📅</span>Smart appointment management</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">📉</span>Reduce no-shows by 87%</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">🐾</span>Digital medical records</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">⭐</span>Better ratings & visibility</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">💰</span>Low commission from 3%</div>
                    </div>
                </aside>

                <div class="cw-form-outer">
                    <div class="cw-step-form show" id="cwClinicForm">
                        <div class="cw-prog-wrap">
                            <div class="cw-prog-header">
                                <div class="cw-prog-title">🏥 New Clinic Registration</div>
                                <div class="cw-prog-counter" id="cwClinicCounter">Step 2 of 2</div>
                            </div>
                        </div>

                        @* ✅ عرض رسالة الخطأ *@
                        @if (TempData["ClinicStep2Error"] != null)
                        {
                            <div class="cw-error-msg" style="color:red;margin-bottom:1rem;padding:0.6rem 1rem;background:#fff0f0;border-radius:8px;border:1px solid #ffcccc;">
                                ⚠️ @TempData["ClinicStep2Error"]
                            </div>
                        }

                        <form method="post" asp-action="Clinic_step2">
                            @Html.AntiForgeryToken()

                            <div class="cw-content" id="cc-2">
                                <div class="cw-content-title">Clinic Owner Information</div>
                                <div class="cw-content-sub">These will be your login credentials as clinic manager</div>

                                <div class="cw-grid">
                                    <div class="cw-field">
                                        <label class="cw-label"><span class="req">*</span>Full Name</label>
                                        <input class="cw-input" name="fullName" type="text" id="co-fullName" placeholder="Full name">
                                    </div>

                                    <div class="cw-field">
                                        <label class="cw-label"><span class="req">*</span>Phone Number</label>
                                        <input class="cw-input" name="ownerPhone" type="tel" id="co-phone"
                                               placeholder="07XXXXXXXX"
                                               maxlength="10"
                                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);"
                                               required>
                                    </div>

                                    <div class="cw-field cw-field-full">
                                        <label class="cw-label"><span class="req">*</span>Email Address</label>
                                        <input class="cw-input" name="email" type="email" id="co-email" placeholder="manager@clinic.jo">
                                    </div>

                                    <div class="cw-field">
                                        <label class="cw-label"><span class="req">*</span>Password</label>
                                        <input class="cw-input" name="password" type="password" id="co-password" placeholder="At least 8 characters">
                                    </div>

                                    <div class="cw-field">
                                        <label class="cw-label"><span class="req">*</span>Confirm Password</label>
                                        <input class="cw-input" name="confirmPassword" type="password" id="co-confirmPassword" placeholder="Re-enter password">
                                    </div>
                                </div>

                                <div style="height:1px;background:rgba(90,143,56,0.18);margin:1.2rem 0;"></div>

                                <div class="cw-content-title" style="margin-bottom:0.8rem">📋 Review Your Details</div>

                                @* ✅ Review — بيانات من Server Session عبر ViewBag *@
                                <div class="cw-review">
                                    <div class="cw-review-title">🏥 Clinic</div>
                                    <div class="cw-review-item">
                                        <span class="cw-review-key">Clinic Name</span>
                                        <span class="cw-review-val">@ViewBag.ReviewName</span>
                                    </div>
                                    <div class="cw-review-item">
                                        <span class="cw-review-key">City</span>
                                        <span class="cw-review-val">@ViewBag.ReviewCity</span>
                                    </div>
                                    <div class="cw-review-item">
                                        <span class="cw-review-key">Phone</span>
                                        <span class="cw-review-val">@ViewBag.ReviewPhone</span>
                                    </div>
                                </div>

                                <div class="cw-nav" style="display:flex;justify-content:space-between;gap:12px;margin-top:1.4rem;">
                                    <a class="cw-btn-back" href="/Account/Clinic_step1">← Previous</a>
                                    <button class="cw-btn-next" type="submit">Submit Application 🚀</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/clinic.js"></script>
</body>
</html>