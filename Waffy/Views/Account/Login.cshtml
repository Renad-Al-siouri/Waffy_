@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – Login</title>

    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>

    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="~/Images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card login-card" id="loginCard">
            <div class="card-title">
                <span>🐾</span>
                Welcome to Waffy!
                <span>🐾</span>
            </div>

            <form id="loginForm" autocomplete="on" novalidate>
                <div class="field">
                    <i class="fa-regular fa-envelope field-icon"></i>
                    <input type="email" id="email" name="email" placeholder="Email" autocomplete="email" />
                </div>

                <div class="field">
                    <i class="fa-solid fa-lock field-icon"></i>
                    <input type="password" id="password" name="password" placeholder="Password" autocomplete="current-password" />
                    <button type="button" class="toggle-password" onclick="togglePassword(this)">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>

                <div class="options-row">
                    <label class="remember-wrap">
                        <input type="checkbox" id="rememberMe" />
                        <span>Remember me</span>
                    </label>

                    <a asp-controller="Account" asp-action="ForgotPass" class="forgot-link">Forgot Password</a>
                </div>

                <a asp-controller="Home" asp-action="Home_After" class="btn-login" style="display:flex;width:100%;height:50px;align-items:center;justify-content:center;text-align:center;text-decoration:none;color:#fff;margin:0 auto;border-radius:12px;background:linear-gradient(135deg,#59652a,#97ad4d);font-family:'Nunito',sans-serif;font-weight:800;font-size:0.95rem;padding:12px;box-shadow:0 8px 18px rgba(151,173,77,0.16);">Log In</a>

                <div class="success-message" id="successMessage">
                    Logged in successfully!
                </div>
            </form>

            <div class="bottom-text">
                New here?
                <a asp-controller="Account" asp-action="Signup" class="signup-link">Sign Up</a>
            </div>
        </div>
    </div>

    
</body>
</html>