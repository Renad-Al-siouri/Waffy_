@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="store-step-4">

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a href="signup.html" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:80%"></div></div>

            <div class="sw-wrap">
                <aside class="sw-sidebar">
                    <div class="sw-sb-brand">
                        <div class="sw-sb-brand-title">🏪 Store Registration</div>
                        <div class="sw-sb-brand-sub">Join Waffy and start selling to thousands of pet owners across Jordan</div>
                    </div>

                    <div class="sw-sb-steps">
                        <div class="sw-sb-lbl">Registration Steps</div>
                        <div id="swSbSteps">
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">👤 Account Owner</div><div class="sw-si-sub">Step 1</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">🏪 Store Information</div><div class="sw-si-sub">Step 2</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">📍 Contact & Location</div><div class="sw-si-sub">Step 3</div></div></div>
                            <div class="sw-si active"><div class="sw-si-num">4</div><div><div class="sw-si-title">🖼 Media & Payments</div><div class="sw-si-sub">Step 4</div></div></div>
                            <div class="sw-si"><div class="sw-si-num">5</div><div><div class="sw-si-title">📄 Business & Docs</div><div class="sw-si-sub">Step 5</div></div></div>
                        </div>
                    </div>
                </aside>

                <div class="sw-fwrap">
                    <div class="sw-dots" id="swDots">
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot active"></div>
                        <div class="sw-dot"></div>
                    </div>

                    <div class="sw-screen on" id="sw-s4">
                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">🖼</div>
                                <div>
                                    <div class="sw-card-title">Store Images &amp; Banner</div>
                                    <div class="sw-card-sub">Visuals that help customers get to know your store</div>
                                </div>
                            </div>

                            <div class="sw-fg">
                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Banner <span class="sw-opt">(Optional)</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-bannerFile')" style="padding:1.5rem">
                                        <input type="file" id="sw-bannerFile" accept="image/*" style="display:none" onchange="swPreviewFile(this,'sw-bannerPrev','sw-bannerName')">
                                        <div class="wf-upload-ico">🏞</div>
                                        <div class="wf-upload-txt"><strong>Upload store banner</strong><br>Displayed at the top of your store page — 1200×400px ideal</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-bannerPrev">
                                        <span>🏞</span>
                                        <span class="wf-prev-name" id="sw-bannerName"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-bannerFile','sw-bannerPrev','sw-bannerName')">✕ Remove</button>
                                    </div>
                                </div>

                                <div class="sw-f sw-fw">
                                    <label class="sw-lbl">Store Photos <span class="sw-opt">(up to 8 photos)</span></label>
                                    <div class="sw-hint" style="margin-bottom:.6rem">💡 Products, storefront, interior environment</div>

                                    <div class="sw-img-grid" id="swImgGrid">
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                        <div class="sw-img-thumb" onclick="swAddImg(this)">➕</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">🐾</div>
                                <div>
                                    <div class="sw-card-title">Pet Types Served</div>
                                    <div class="sw-card-sub">Which pets does your store serve?</div>
                                </div>
                            </div>

                            <div class="sw-pet-grid">
                                <div class="sw-pet-btn" onclick="this.classList.toggle('on')"><span class="sw-pet-ico">🐕</span><span class="sw-pet-lbl">Dogs</span></div>
                                <div class="sw-pet-btn" onclick="this.classList.toggle('on')"><span class="sw-pet-ico">🐈</span><span class="sw-pet-lbl">Cats</span></div>
                                <div class="sw-pet-btn" onclick="this.classList.toggle('on')"><span class="sw-pet-ico">🐦</span><span class="sw-pet-lbl">Birds</span></div>
                                <div class="sw-pet-btn" onclick="this.classList.toggle('on')"><span class="sw-pet-ico">🐠</span><span class="sw-pet-lbl">Fish</span></div>
                                <div class="sw-pet-btn" onclick="this.classList.toggle('on')"><span class="sw-pet-ico">🐹</span><span class="sw-pet-lbl">Small Pets</span></div>
                            </div>
                        </div>

                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">💳</div>
                                <div>
                                    <div class="sw-card-title">Accepted Payment Methods</div>
                                    <div class="sw-card-sub">Select all payment methods you accept</div>
                                </div>
                            </div>

                            <div class="sw-chip-group">
                                <div class="sw-chip" onclick="this.classList.toggle('on')">💵 Cash on Delivery</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">💳 Online Payment</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">👛 Waffy Wallet</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">🏦 Bank Transfer</div>
                                <div class="sw-chip" onclick="this.classList.toggle('on')">📱 JoMoPay</div>
                            </div>

                            <div class="sw-hint" style="margin-top:.6rem">💡 You can edit these later from your store settings</div>
                        </div>

                        <div class="sw-fnav">
                            <button class="sw-btn sw-btn-o" onclick="window.location.href='store-step3.html'">← Previous</button>
                            <button class="sw-btn sw-btn-p" onclick="window.location.href='store-step5.html'">Next →</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>