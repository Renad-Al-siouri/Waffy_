@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy | Profile</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/profile.css" />
</head>
<body>
    <!-- HEADER -->
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">

                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>

                        </div>

                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">



                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services
                                        <span class="dropdown-arrow">▼</span>
                                    </button>

                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>

                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>

                            </div>

                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>

                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>

                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>

                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>

                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>

                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>

                                        <div class="mobile-services-menu" id="mobileServicesMenu">

                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>

                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- PAGE -->
    <main class="profile-page">
        <div class="container">
            <!-- PROFILE CARD -->
            <section class="profile-card">
                <div class="profile-top">
                    <div class="avatar-wrap">
                        <div class="avatar">
                            <span>👤</span>
                        </div>
                        <button class="camera-btn" id="changePhotoBtn" type="button">📷</button>
                        <input type="file" id="photoInput" accept="image/*" hidden />
                    </div>

                    <div class="profile-info">
                        <h1>Layan Mugdadi</h1>

                        <div class="meta-line">
                            <span>♀ Female</span>
                        </div>

                        <div class="meta-line">
                            <span>📍 Amman, Jordan</span>
                        </div>

                        <a href="profileEdit.html" class="edit-profile-btn">✏ Edit Profile</a>
                    </div>
                </div>

                <div class="contact-box">
                    <div class="contact-row">
                        <span class="contact-label">✉ Email</span>
                        <span class="contact-value" id="userEmail">layan.mugdadi@email.com</span>
                    </div>

                    <div class="contact-row">
                        <span class="contact-label">📞 Phone</span>
                        <span class="contact-value" id="userPhone">+962 79 123 4567</span>
                    </div>

                    <div class="contact-row">
                        <span class="contact-label">🏠 Address</span>
                        <span class="contact-value" id="userAddress">123 Pet Street, Amman, Jordan</span>
                    </div>
                </div>
            </section>

            <!-- PETS SECTION -->
            <section class="pets-section">
                <div class="section-title">
                    <span>🐾 My Pets</span>
                </div>

                <div class="pets-grid" id="petsGrid">
                    <!-- PET 1 -->
                    <article class="pet-card">
                        <div class="pet-image-box">
                            <div class="pet-avatar-wrap">
                                <div class="pet-avatar">
                                    <img src="" alt="Buddy" class="pet-image" style="display: none;" />
                                    <span class="pet-default-icon">🐾</span>
                                </div>

                                <button class="pet-camera-btn" type="button">📷</button>
                                <input type="file" class="pet-photo-input" accept="image/*" hidden />
                            </div>
                        </div>

                        <div class="pet-content">
                            <div class="pet-head">
                                <div>
                                    <h3>Buddy</h3>
                                    <p class="pet-type">Dog</p>
                                </div>
                                <span class="pet-dot"></span>
                            </div>

                            <p class="pet-age">Age: 3 Years</p>

                            <ul class="pet-notes">
                                <li class="good">Up-to-date on vaccines</li>
                                <li class="alert">Medication needed</li>
                            </ul>

                            <div class="pet-actions">
                                <button class="pet-btn primary details-btn" data-pet="buddy" type="button">View Details</button>
                                <button class="pet-btn secondary edit-pet-btn" type="button">Edit</button>
                                <button class="pet-btn danger delete-pet-btn" type="button">Delete</button>
                            </div>
                        </div>
                    </article>

                    <!-- PET 2 -->
                    <article class="pet-card">
                        <div class="pet-image-box">
                            <div class="pet-avatar-wrap">
                                <div class="pet-avatar">
                                    <img src="" alt="Buddy" class="pet-image" style="display: none;" />
                                    <span class="pet-default-icon">🐾</span>
                                </div>

                                <button class="pet-camera-btn" type="button">📷</button>
                                <input type="file" class="pet-photo-input" accept="image/*" hidden />
                            </div>
                        </div>

                        <div class="pet-content">
                            <div class="pet-head">
                                <div>
                                    <h3>Milo</h3>
                                    <p class="pet-type">Cat</p>
                                </div>
                                <span class="pet-dot"></span>
                            </div>

                            <p class="pet-age">Age: 1 Year</p>

                            <ul class="pet-notes">
                                <li class="good">Up-to-date on vaccines</li>
                                <li class="alert">Allergy to chicken</li>
                            </ul>

                            <div class="pet-actions">
                                <button class="pet-btn primary details-btn" data-pet="milo" type="button">View Details</button>
                                <button class="pet-btn secondary edit-pet-btn" type="button">Edit</button>
                                <button class="pet-btn danger delete-pet-btn" type="button">Delete</button>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- ADD PET -->
                <div class="add-pet-box" id="addPetBox">
                    <button class="add-pet-circle" type="button">＋</button>
                    <p>Click to add a new pet</p>
                </div>
            </section>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-links">
                <a href="#">Home</a>
                <span>|</span>
                <a href="#">Clinics</a>
                <span>|</span>
                <a href="#">Supplies</a>
                <span>|</span>
                <a href="#">About Us</a>
            </div>
            <p>© 2026 Waffy. All rights reserved.</p>
        </div>
    </footer>

    <!-- PET DETAILS MODAL -->
    <div class="modal-overlay" id="petModal">
        <div class="modal small-modal">
            <button class="close-modal" id="closePetModal" type="button">×</button>
            <h2 id="petModalTitle">Pet Details</h2>
            <div id="petModalBody">
                <p><strong>Name:</strong> Buddy</p>
                <p><strong>Type:</strong> Dog</p>
                <p><strong>Age:</strong> 3 Years</p>
                <p><strong>Status:</strong> Up-to-date on vaccines</p>
                <p><strong>Notes:</strong> Medication needed</p>
            </div>
        </div>
    </div>

    <!-- ADD PET MODAL -->
    <div class="modal-overlay" id="addPetModal">
        <div class="modal">
            <button class="close-modal" id="closeAddPetModal" type="button">×</button>
            <h2>Add New Pet</h2>

            <div class="form-group full">
                <div id="petImagePreview" class="pet-upload-preview">No image selected</div>
            </div>

            <form id="addPetForm">
                <!-- BASIC -->
                <div class="pet-form-section">
                    <div class="pet-form-title">🐾 Pet Information</div>

                    <div class="form-group full">
                        <label for="petImageInput">Pet Photo</label>
                        <input type="file" id="petImageInput" accept="image/*" />
                    </div>

                    <div class="pet-grid-2">
                        <div class="form-group">
                            <label>Pet Name</label>
                            <input type="text" id="petNameInput" required />
                        </div>

                        <div class="form-group">
                            <label>Pet Type</label>
                            <select id="petTypeInput" required>
                                <option value="">Select</option>
                                <option>🐕 Dog</option>
                                <option>🐈 Cat</option>
                                <option>🐦 Bird</option>
                                <option>🐰 Rabbit</option>
                                <option>🦜 Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Breed</label>
                            <input type="text" id="petBreedInput" />
                        </div>

                        <div class="form-group">
                            <label>Age</label>
                            <input type="number" id="petAgeInput" required />
                        </div>

                        <div class="form-group">
                            <label>Gender</label>
                            <select id="petGenderInput">
                                <option>Male</option>
                                <option>Female</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Color</label>
                            <input type="text" id="petColorInput" />
                        </div>
                    </div>
                </div>

                <!-- HEALTH -->
                <div class="pet-form-section">
                    <div class="pet-form-title">❤️ Health</div>

                    <div class="pet-grid-2">
                        <div class="form-group">
                            <label>Health Status</label>
                            <select id="petHealthInput">
                                <option>Healthy</option>
                                <option>Has issues</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Vaccinated</label>
                            <select id="petVaccinatedInput">
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Vaccination Date</label>
                            <input type="date" id="petVaccDateInput" />
                        </div>

                        <div class="form-group">
                            <label>Neutered</label>
                            <select id="petNeuterInput">
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="form-group full">
                            <label>Health Notes</label>
                            <textarea id="petNotesInput"></textarea>
                        </div>
                    </div>
                </div>

                <!-- BEHAVIOR -->
                <div class="pet-form-section">
                    <div class="pet-form-title">🧠 Behaviour</div>

                    <div class="pet-grid-2">
                        <div class="form-group">
                            <label>Energy Level</label>
                            <select id="petEnergyInput">
                                <option>Low</option>
                                <option selected>Medium</option>
                                <option>High</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Good with Children</label>
                            <select id="petChildrenInput">
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Good with Pets</label>
                            <select id="petOtherPetsInput">
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="form-group full">
                            <label>Description</label>
                            <textarea id="petDescInput"></textarea>
                        </div>
                    </div>
                </div>

                <button type="submit" class="save-btn">Add Pet</button>
            </form>
        </div>
    </div>

    <script src="~/js/profile.js"></script>
</body>
</html>