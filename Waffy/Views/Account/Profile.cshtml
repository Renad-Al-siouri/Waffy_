                                <a href="law.html" class="dropdown-link">Law</a>
                                <a href="dangerousAnimal.html" class="dropdown-link">Dangerous Animal</a>
                                <a href="support.html" class="dropdown-link">Technical Support</a>
                                <a href="faq.html" class="dropdown-link">FAQ</a>
                            </div>
                        </div>

                        <a href="about.html" class="nav-link">About Us</a>

                    </div>

                    <div class="nav-actions">
                        <a href="cart.html" class="nav-icon" aria-label="Cart">
