</head>
<body>
    <!-- HEADER -->
    <header class="topbar">
        <div class="header-shell">
            <nav class="navbar">

                <div class="left-nav desktop-nav desktop-links">
                    <a href="home-after.html" class="nav-link active">Home</a>
                    <a href="veterinary.html" class="nav-link">Clinics</a>
