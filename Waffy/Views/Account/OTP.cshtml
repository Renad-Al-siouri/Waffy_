@{
    Layout = null;
    var otpEmail = TempData.Peek("OtpEmail")?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – OTP Verification</title>

    <link rel="stylesheet" href="~/css/OTPVer.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>

    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="../Images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card otp-card">
            <div class="card-title">Verification Code</div>

            <div class="card-sub">
                Enter the 4-digit code sent to your email address
            </div>

            <form id="otpForm" asp-controller="Account" asp-action="VerifyOtp" method="post" novalidate>
                @Html.AntiForgeryToken()
                @if (TempData["OtpError"] != null)
                {
                    <div style="color:red;margin-bottom:10px;">
                        @TempData["OtpError"]
                    </div>
                }
                <div class="otp-group">
                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="otp-input" inputmode="numeric" />
                </div>

                <button type="submit" class="btn-verify" style="display:flex;width:100%;height:50px;align-items:center;justify-content:center;text-align:center;text-decoration:none;color:#fff;margin:0 auto;border-radius:12px;background:linear-gradient(135deg,#59652a,#97ad4d);font-family:'Nunito',sans-serif;font-weight:800;font-size:0.95rem;padding:12px;box-shadow:0 8px 18px rgba(151,173,77,0.16);border:none;">
                    Verify
                </button>

                <div class="success" id="successMsg">
                    Code verified successfully!
                </div>
                <input type="hidden" name="code" id="finalCode" />
                

            </form>
           
            <div class="bottom-text">
                Didn’t receive the code?
                <a href="#" class="resend-link disabled" id="resendCode">Resend in 30s</a>
            </div>

            <div class="bottom-text back-row">
                <a asp-controller="Account" asp-action="ForgotPass" class="back-link">Back</a>
            </div>
        </div>
    </div>
    <script src="~/js/OTPVer.js" asp-append-version="true"></script>
</body>
</html>