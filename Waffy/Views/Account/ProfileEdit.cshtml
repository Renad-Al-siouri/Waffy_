                </div>

            </nav>
        </div>
    </header>

    <div class="page-wrap">

        <!-- ═══ SIDEBAR ═══ -->
        <aside class="sidebar">
            <div class="sb-profile">
                <div class="sb-avatar-wrap">
                    <div class="sb-avatar" id="sidebarAvatar"><span>👤</span></div>
                    <button class="sb-cam" onclick="document.getElementById('avatarFile').click()">📷</button>
                    <input type="file" id="avatarFile" accept="image/*" hidden onchange="changeAvatar(this)" />
                </div>
                <div class="sb-name" id="sidebarName">Layan Mugdadi</div>
                <div class="sb-email" id="sidebarEmail">layan@email.com</div>
                <div class="sb-wallet-mini">
                    <span>👛 Wallet</span>
                    <strong id="sidebarBalance">32.50 JOD</strong>
                </div>
            </div>

            <nav class="sb-nav">
                <div class="sb-nav-label">Account</div>
                <div class="sb-item active" onclick="switchTab('info')"><i class="fa-solid fa-user"></i> Edit Profile</div>
                <div class="sb-item" onclick="switchTab('contact')"><i class="fa-solid fa-address-card"></i> Contact Info</div>
                <div class="sb-item" onclick="switchTab('wallet')"><i class="fa-solid fa-wallet"></i> My Wallet<span class="sb-badge">32.50</span></div>
                <div class="sb-item" onclick="switchTab('rewards')"><i class="fa-solid fa-gift"></i> Rewards<span class="sb-badge">3</span></div>

                <div class="sb-nav-label">Pets & Services</div>
                <div class="sb-item" onclick="switchTab('appointments')"><i class="fa-solid fa-calendar-check"></i> Appointments<span class="sb-badge">2</span></div>
                <div class="sb-item" onclick="switchTab('orders')"><i class="fa-solid fa-box"></i> Orders<span class="sb-badge">3</span></div>
                <div class="sb-item" onclick="switchTab('lost')"><i class="fa-solid fa-magnifying-glass"></i> Lost Reports<span class="sb-badge red">1</span></div>
                <div class="sb-item" onclick="switchTab('adoption')"><i class="fa-solid fa-paw"></i> Adoption Ads<span class="sb-badge">1</span></div>

                <div class="sb-nav-label">History</div>
                <div class="sb-item" onclick="switchTab('timeline')"><i class="fa-solid fa-clock-rotate-left"></i> Timeline</div>
                <div class="sb-item" onclick="switchTab('complaints')"><i class="fa-solid fa-triangle-exclamation"></i> Complaints</div>

                <div class="sb-nav-label">Settings</div>
                <div class="sb-item" onclick="switchTab('security')"><i class="fa-solid fa-lock"></i> Security</div>
            </nav>
        </aside>

        <!-- ═══ MAIN CONTENT ═══ -->
        <main class="main-content">

            <!-- ── EDIT PROFILE ── -->
            <div class="tab-pane active" id="tab-info">
                <div class="page-header">
                    <div><h2>Edit Profile</h2><p>Update your personal information</p></div>
                    <button class="btn btn-primary" onclick="saveProfile()"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">🖼️ Profile Photo</span></div>
                    <div class="s-card-body">
                        <div class="profile-avatar-edit">
                            <div class="big-avatar" id="bigAvatar"><span>👤</span></div>
                            <div class="avatar-actions">
                                <div style="display:flex;gap:8px;flex-wrap:wrap">
                                    <button class="btn btn-secondary btn-sm" onclick="document.getElementById('avatarFile').click()"><i class="fa-solid fa-camera"></i> Change Photo</button>
                                    <button class="btn btn-danger btn-sm" onclick="resetAvatar()"><i class="fa-solid fa-trash"></i> Remove</button>
                                </div>
                                <p>JPG or PNG — Max 5MB</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">👤 Basic Information</span></div>
                    <div class="s-card-body">
                        <div class="form-grid">
                            <div class="field full"><label>Full Name</label><input id="f-name" value="Layan Mugdadi" oninput="syncName()" /></div>
                            <div class="field full"><label>Email Address</label><input id="f-email" type="email" value="layan@email.com" oninput="syncEmail()" /></div>
                            <div class="field"><label>Date of Birth</label><input id="f-dob" type="date" value="1998-03-15" /></div>
                            <div class="field">
                                <label>Gender</label>
                                <select id="f-gender">
                                    <option>Female</option>
                                    <option>Male</option>
                                    <option>Prefer not to say</option>
                                </select>
                            </div>
                            <div class="field full"><label>Bio</label><textarea id="f-bio" placeholder="Write a short bio...">I love my pets and care deeply about their health!</textarea></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── CONTACT INFO ── -->
            <div class="tab-pane" id="tab-contact">
                <div class="page-header">
                    <div><h2>Contact Info</h2><p>Phone, address and location</p></div>
                    <button class="btn btn-primary" onclick="showToast('Contact info saved!')"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">📞 Contact Details</span></div>
                    <div class="s-card-body">
                        <div class="form-grid">
                            <div class="field fw">
                                <label>Phone Number</label>
                                <div class="phone-row"><span class="phone-code">+962</span><input value="79 123 4567" /></div>
                            </div>
                            <div class="field fw">
                                <label>WhatsApp (if different)</label>
                                <div class="phone-row"><span class="phone-code">+962</span><input placeholder="7X XXX XXXX" /></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">📍 Location</span></div>
                    <div class="s-card-body">
                        <div class="form-grid">
                            <div class="field">
                                <label>City</label>
                                <select><option>Amman</option><option>Zarqa</option><option>Irbid</option><option>Aqaba</option></select>
                            </div>
                            <div class="field"><label>Area</label><input value="Al Jubaiha" placeholder="Neighborhood..." /></div>
                            <div class="field full"><label>Full Address</label><input value="123 Pet Street, Amman" /></div>
                        </div>
                        <div style="margin-top:14px">
                            <div style="border:2px dashed #d7e2be;border-radius:16px;background:#f3f8ea;padding:20px;text-align:center;cursor:pointer" onclick="showToast('Map integration coming soon!')">
                                <div style="font-size:1.8rem;margin-bottom:6px">🗺️</div>
                                <p style="font-weight:800;color:var(--olive-dark)">Set Location on Map</p>
                                <p style="font-size:.8rem;color:var(--muted);font-weight:700;margin-top:4px">Google Maps Integration</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── WALLET ── -->
            <div class="tab-pane" id="tab-wallet">
                <div class="page-header">
                    <div><h2>My Wallet</h2><p>Balance, top-up and transaction history</p></div>
                </div>

                <div class="wallet-hero">
                    <div class="wallet-bal-label">Current Balance</div>
                    <div class="wallet-bal">32.50 <span style="font-size:1rem;opacity:.7">JOD</span></div>
                    <div class="cashback-chip">🎁 2% Cashback on every order</div>
                    <div class="wallet-meta">
                        <div class="wallet-meta-item"><span>Total Topped Up</span><strong>85.00 JOD</strong></div>
                        <div class="wallet-meta-item"><span>Total Spent</span><strong>57.50 JOD</strong></div>
                        <div class="wallet-meta-item"><span>Rewards Earned</span><strong>+5.00 JOD</strong></div>
                    </div>
                </div>

                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">💳 Top Up Wallet</span></div>
                    <div class="s-card-body">
                        <p style="font-size:.82rem;color:var(--muted);font-weight:700;margin-bottom:12px">Select amount</p>
                        <div class="amt-grid" id="amtGrid">
                            <div class="amt-btn" onclick="selAmt(this,'5')">5 JOD</div>
                            <div class="amt-btn active" onclick="selAmt(this,'10')">10 JOD</div>
                            <div class="amt-btn" onclick="selAmt(this,'20')">20 JOD</div>
                            <div class="amt-btn" onclick="selAmt(this,'custom')">Custom</div>
                        </div>
                        <div id="customAmtWrap" style="display:none;margin-bottom:14px">
                            <div class="field"><input type="number" placeholder="Enter amount in JOD" /></div>
                        </div>
                        <p style="font-size:.82rem;color:var(--muted);font-weight:700;margin-bottom:10px">Payment method</p>
                        <div class="topup-grid" id="topupGrid">
                            <div class="topup-btn active" onclick="selTopup(this,'card')"><span>💳</span><p>Card</p></div>
                            <div class="topup-btn" onclick="selTopup(this,'cliq')"><span>📱</span><p>CliQ</p></div>
                            <div class="topup-btn" onclick="selTopup(this,'cash')"><span>💵</span><p>Cash Point</p></div>
                        </div>
                        <div id="topup-card">
                            <div class="form-grid">
                                <div class="field full"><label>Card Number</label><input placeholder="1234 5678 9012 3456" dir="ltr" /></div>
                                <div class="field"><label>Expiry</label><input placeholder="MM / YY" dir="ltr" /></div>
                                <div class="field"><label>CVV</label><input placeholder="•••" type="password" dir="ltr" /></div>
                                <div class="field full"><label>Cardholder Name</label><input placeholder="Name on card" dir="ltr" /></div>
                            </div>
                        </div>
                        <div id="topup-cliq" style="display:none">
                            <div class="field">
                                <label>CliQ Alias or Phone</label>
                                <div class="phone-row"><span class="phone-code">+962</span><input placeholder="7X XXX XXXX" /></div>
                            </div>
                        </div>
                        <div id="topup-cash" style="display:none">
                            <div style="background:#fff8e6;border:1px solid #fde68a;border-radius:14px;padding:14px;font-size:.85rem;font-weight:700;color:#92400e">
                                📍 Top up at any authorized Waffy cash point. A top-up code will be sent to your phone via SMS.
                            </div>
                        </div>
                        <button class="btn btn-primary" style="width:100%;justify-content:center;margin-top:14px" onclick="showToast('💳 Wallet topped up successfully!')">
                            <i class="fa-solid fa-bolt"></i> Top Up Now
                        </button>
                        <p style="text-align:center;font-size:.75rem;color:var(--muted);font-weight:700;margin-top:8px">🔒 Your payment data is protected with SSL encryption</p>
                    </div>
                </div>

                <div class="s-card">
                    <div class="s-card-head">
                        <span class="s-card-title">📋 Transaction History</span>
                        <select style="padding:6px 12px;border:1px solid var(--line);border-radius:var(--pill);font-size:.78rem;font-weight:700;background:#fff;outline:none;cursor:pointer">
                            <option>All</option>
                            <option>Top Up</option>
                            <option>Payment</option>
                            <option>Reward</option>
                        </select>
                    </div>
                    <div class="s-card-body" id="txList">
                        <!-- rendered by JS -->
                    </div>
                </div>
            </div>

            <!-- ── REWARDS ── -->
            <div class="tab-pane" id="tab-rewards">
                <div class="page-header"><div><h2>Rewards 🎁</h2><p>Your earned points and coupons</p></div></div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">⭐ Points Balance</span></div>
                    <div class="s-card-body">
                        <div style="display:flex;align-items:center;gap:16px;padding-bottom:16px;border-bottom:1px solid var(--line);margin-bottom:16px">
                            <div style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#fef9c3,#fde68a);display:flex;align-items:center;justify-content:center;font-size:1.5rem">⭐</div>
                            <div>
                                <div style="font-family:'Fredoka',sans-serif;font-size:1.8rem;color:#92400e;font-weight:600">240 pts</div>
                                <p style="font-size:.8rem;color:var(--muted);font-weight:700">Redeem at 500 points for 5 JOD credit</p>
                                <div class="progress-wrap" style="width:200px;margin-top:6px"><div class="progress-fill" style="width:48%"></div></div>
                            </div>
                        </div>
                        <div class="reward-card">
                            <div class="reward-ico">🏆</div>
                            <div class="reward-info"><h4>Found Lost Pet Reward</h4><p>Finder reward credited — Feb 28</p></div>
                            <div class="reward-val">+10.00 JOD</div>
                        </div>
                        <div class="reward-card">
                            <div class="reward-ico">🎁</div>
                            <div class="reward-info"><h4>Welcome Bonus</h4><p>Registration reward — Mar 1</p></div>
                            <div class="reward-val">+5.00 JOD</div>
                        </div>
                        <div class="reward-card">
                            <div class="reward-ico">💰</div>
                            <div class="reward-info"><h4>Cashback 2%</h4><p>On your last order — Mar 8</p></div>
                            <div class="reward-val">+0.37 JOD</div>
                        </div>
                    </div>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">🎟️ My Coupons</span></div>
                    <div class="s-card-body">
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:14px;border:2px dashed #d4e2b0;border-radius:16px;background:#f5faea;margin-bottom:10px">
                            <div><h4 style="font-weight:800;font-size:.9rem;color:var(--olive-dark)">WAFFY-10OFF</h4><p style="font-size:.78rem;color:var(--muted);font-weight:700">10% off next clinic visit · Expires Apr 30</p></div>
                            <button class="btn btn-ghost btn-sm" onclick="showToast('📋 Coupon code copied!')">Copy</button>
                        </div>
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:14px;border:1px solid var(--line);border-radius:16px;background:#fafaf6;opacity:.55">
                            <div><h4 style="font-weight:800;font-size:.9rem;color:var(--muted)">WAFFY-5JOD</h4><p style="font-size:.78rem;color:var(--muted);font-weight:700">5 JOD store credit · Expired</p></div>
                            <span class="badge badge-grey">Expired</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── APPOINTMENTS ── -->
            <div class="tab-pane" id="tab-appointments">
                <div class="page-header"><div><h2>Appointments 📅</h2><p>Upcoming and past vet visits</p></div></div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">Upcoming</span><span class="badge badge-green">2 Scheduled</span></div>
                    <div class="s-card-body">
                        <div class="appt-card">
                            <div class="appt-date-box"><span class="appt-day">18</span><span class="appt-mon">Apr</span></div>
                            <div class="appt-info">
                                <h4>General Checkup — Buddy</h4>
                                <p>Dr. Rania Hassan · Al Amanah Clinic · 10:00 AM</p>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                                <span class="badge badge-green">Confirmed</span>
                                <button class="btn btn-danger btn-sm">Cancel</button>
                            </div>
                        </div>
                        <div class="appt-card">
                            <div class="appt-date-box"><span class="appt-day">25</span><span class="appt-mon">Apr</span></div>
                            <div class="appt-info">
                                <h4>Vaccination — Milo</h4>
                                <p>Dr. Khaled Noor · PetCare Center · 2:30 PM</p>
                            </div>
                            <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                                <span class="badge badge-orange">Pending</span>
                                <button class="btn btn-danger btn-sm">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">Past Appointments</span></div>
                    <div class="s-card-body">
                        <div class="appt-card">
                            <div class="appt-date-box" style="background:linear-gradient(180deg,#f0ebe2,#e5ddd0)"><span class="appt-day">05</span><span class="appt-mon">Mar</span></div>
                            <div class="appt-info"><h4>Emergency Visit — Buddy</h4><p>Dr. Rania Hassan · Al Amanah Clinic</p></div>
                            <span class="badge badge-grey">Completed</span>
                        </div>
                        <div class="appt-card">
                            <div class="appt-date-box" style="background:linear-gradient(180deg,#f0ebe2,#e5ddd0)"><span class="appt-day">18</span><span class="appt-mon">Feb</span></div>
                            <div class="appt-info"><h4>Dental Cleaning — Milo</h4><p>Dr. Khaled Noor · PetCare Center</p></div>
                            <span class="badge badge-red">No-Show</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── ORDERS ── -->
            <div class="tab-pane" id="tab-orders">
                <div class="page-header"><div><h2>My Orders 🛍️</h2><p>Track your purchases</p></div></div>
                <div class="s-card">
                    <div class="s-card-head"><span class="s-card-title">Recent Orders</span></div>
                    <div class="s-card-body">
                        <div class="order-row">
                            <div class="order-img">🦴</div>
                            <div class="order-info"><h4>Royal Canin Dog Food · 2kg</h4><p>Pet Friends Store · Mar 8 · 2 items</p></div>
                            <div style="text-align:right">
                                <div class="order-amount">18.50 JOD</div>
                                <span class="badge badge-green" style="margin-top:5px">Delivered</span>
                            </div>
                        </div>
                        <div class="order-row">
                            <div class="order-img">💊</div>
                            <div class="order-info"><h4>Flea & Tick Treatment</h4><p>PetCare Pharmacy · Mar 1 · 1 item</p></div>
                            <div style="text-align:right">
                                <div class="order-amount">8.00 JOD</div>
                                <span class="badge badge-blue" style="margin-top:5px">Shipped</span>
                            </div>
                        </div>
                        <div class="order-row">
                            <div class="order-img">🧶</div>
                            <div class="order-info"><h4>Cat Toy Set</h4><p>Colorful Birds Store · Feb 20 · 3 items</p></div>
                            <div style="text-align:right">
                                <div class="order-amount">12.00 JOD</div>
