@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – Forgot Password</title>

    <link rel="stylesheet" href="~/css/forgotPass.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="../images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card forgot-card">
            <div class="card-title">Forgot Password</div>
            <div class="card-sub">
                Enter your email address to recover your password.
            </div>

            <form id="forgotForm" novalidate>
                <div class="field">
                    <i class="fa-regular fa-envelope field-icon"></i>
                    <input type="email" id="email" placeholder="Enter your email address" />
                </div>

                <button class="btn-send" type="submit">Send Code</button>

                <div class="success" id="successMsg">
                    Recovery code sent to your email.
                </div>
            </form>

            <div class="login-row">
                Remembered your password?
                <a href="login.html">Back to Log In</a>
            </div>
        </div>
    </div>

    <script src="~/js/forgotPass.js"></script>
</body>
</html>