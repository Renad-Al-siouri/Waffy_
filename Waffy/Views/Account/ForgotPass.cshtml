@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy – Forgot Password</title>

    <link rel="stylesheet" href="~/css/forgotPass.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <div class="page">
        <div class="logo-wrap">
            <div class="logo-box">
                <img src="../images/logo.png" alt="Waffy Logo" class="logo-img" />
            </div>
        </div>

        <div class="card forgot-card">
            <div class="card-title">Forgot Password</div>
            <div class="card-sub">
                Enter your email address to recover your password.
            </div>

            <form id="forgotForm" novalidate>
                <div class="field">
                    <i class="fa-regular fa-envelope field-icon"></i>
                    <input type="email" id="email" placeholder="Enter your email address" />
                </div>

                <a class="btn-send" asp-controller="Account" asp-action="OTP" style="display:flex;width:100%;height:50px;align-items:center;justify-content:center;text-align:center;text-decoration:none;color:#fff;margin:0 auto;border-radius:12px;background:linear-gradient(135deg,#59652a,#97ad4d);font-family:'Nunito',sans-serif;font-weight:800;font-size:0.95rem;padding:12px;box-shadow:0 8px 18px rgba(151,173,77,0.16);">Send Code</a>

                <div class="success" id="successMsg">
                    Recovery code sent to your email.
                </div>
            </form>

            <div class="login-row">
                Remembered your password?
                <a asp-controller="Account" asp-action="Login">Back to Log In</a>
            </div>
        </div>
    </div>

    <script src="~/js/forgotPass.js"></script>
</body>
</html>