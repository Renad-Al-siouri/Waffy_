    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Clinic Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/clinic.css" />
</head>
<body>
    <div id="clinicWizardContainer" dir="ltr" lang="en">
        <div class="cw-bg"></div>

        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo">Waffy</div>
                <div class="topbar-right">
                    <a href="signup.html" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:20%"></div></div>

            <div class="cw-wrap">
                <aside class="cw-left">
                    <div class="cw-info-card" id="cwStepsCard">
                        <div class="cw-info-title">📋 Registration Steps</div>

                    </div>

                    <div class="cw-info-card">
                        <div class="cw-info-title">✨ Why Waffy?</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">📅</span>Smart appointment management</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">📉</span>Reduce no-shows by 87%</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">🐾</span>Digital medical records</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">⭐</span>Better ratings & visibility</div>
                        <div class="cw-benefit"><span class="cw-benefit-icon">💰</span>Low commission from 3%</div>
                    </div>
                </aside>

                <div class="cw-form-outer">
                    <div class="cw-step-form show" id="cwClinicForm">
                        <div class="cw-prog-wrap">
                            <div class="cw-prog-header">
                                <div class="cw-prog-title">🏥 New Clinic Registration</div>
                                <div class="cw-prog-counter" id="cwClinicCounter">Step 1 of 5</div>
                            </div>

                            <div class="cw-indicators" id="cwClinicIndicators">
                                <div class="cw-ind active"><div class="cw-dot">1</div><div class="cw-ind-label">Clinic</div></div>
                                <div class="cw-ind"><div class="cw-dot">2</div><div class="cw-ind-label">Schedule</div></div>
                                <div class="cw-ind"><div class="cw-dot">3</div><div class="cw-ind-label">Plan</div></div>
                                <div class="cw-ind"><div class="cw-dot">4</div><div class="cw-ind-label">Documents</div></div>
                                <div class="cw-ind"><div class="cw-dot">5</div><div class="cw-ind-label">Manager</div></div>
                            </div>
                        </div>

                        <div class="cw-content" id="cc-1">
                            <div class="cw-content-title">Clinic Information</div>
                            <div class="cw-content-sub">This information will be shown to users on your clinic page</div>

                            <div class="cw-grid">
                                <div class="cw-field cw-field-full">
                                    <label class="cw-label"><span class="req">*</span>Clinic Name</label>
                                    <input class="cw-input" type="text" id="cc-clinicName" placeholder="e.g. Al-Amana Veterinary Clinic">
                                </div>

                                <div class="cw-field">
                                    <label class="cw-label"><span class="req">*</span>Clinic Type</label>
                                    <select class="cw-input">
                                        <option value="">Select type...</option>
                                        <option>Small Private Clinic</option>
                                        <option>Veterinary Hospital</option>
                                        <option>Mobile Clinic</option>
                                        <option>Animal Care Center</option>
                                    </select>
                                </div>

                                <div class="cw-field">
                                    <label class="cw-label"><span class="req">*</span>City</label>
                                    <select class="cw-input" id="cc-city">
                                        <option value="">Select city...</option>
                                        <option>Amman</option>
                                        <option>Zarqa</option>
                                        <option>Irbid</option>
                                        <option>Aqaba</option>
                                        <option>Salt</option>
                                        <option>Madaba</option>
                                    </select>
                                </div>

                                <div class="cw-field cw-field-full">
                                    <label class="cw-label"><span class="req">*</span>Full Address</label>
                                    <input class="cw-input" type="text" placeholder="Street, neighborhood, building...">
                                </div>

                                <div class="cw-field">
                                    <label class="cw-label"><span class="req">*</span>Phone Number</label>
                                    <input class="cw-input" type="tel" id="cc-phone" placeholder="06-XXXXXXX">
                                </div>

                                <div class="cw-field">
                                    <label class="cw-label"><span class="req">*</span>Email Address</label>
                                    <input class="cw-input" type="email" id="cc-email" placeholder="clinic@waffy.jo">
                                </div>

                                <div class="cw-field cw-field-full">
                                    <label class="cw-label">Location on Map</label>
                                    <div class="cw-map" onclick="this.querySelector('.cw-map-label').textContent='📍 Location set ✓'">
                                        <div class="cw-map-pin">📍</div>
                                        <div class="cw-map-label">Click to set location</div>
                                    </div>
                                    <div class="cw-hint">🗺 Set your exact location so users can find you on the map</div>
                                </div>

                                <div class="cw-field cw-field-full">
                                    <label class="cw-label">Clinic Description</label>
                                    <textarea class="cw-input" placeholder="Brief description of your services and specializations..."></textarea>
                                </div>
                            </div>

                            <div class="cw-submit-wrap">
                                <button class="cw-btn-back" onclick="window.location.href='signup.html'">← Back</button>
                                <button class="cw-btn-next" onclick="window.location.href='clinic-step2.html'">Next — Schedule & Services →</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script src="~/js/clinic.js"></script>
</body>
</html>