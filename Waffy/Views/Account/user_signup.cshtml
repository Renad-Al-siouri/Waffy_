@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - User Registration</title>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/user-signup.css" />
</head>
<body class="user-step-1">
    <div id="userWizardContainer">
        <div class="topbar">
            <div class="logo"><span class="logo-ico"></span> Waffy</div>
            <div class="topbar-right">
                <a asp-controller="Account" asp-action="Signup" class="top-signup-link">← Back to Sign Up</a>
            </div>
        </div>

        <div class="prog-line"><div class="prog-fill" id="pf"></div></div>

        <div class="wrap">
            <aside class="sidebar">
                <div class="sb-hero">
                    <div class="sb-hero-title">Welcome to Waffy</div>
                    <div class="sb-hero-sub">
                        Complete your profile and enjoy all pet services in one place.
                    </div>
                </div>

                <div class="sb-perks">
                    <div class="sb-perks-title">What do you get?</div>
                    <div class="perk"><div class="perk-ico">📅</div><span>Easy clinic appointments</span></div>
                    <div class="perk"><div class="perk-ico">🗂</div><span>Pet medical records</span></div>
                    <div class="perk"><div class="perk-ico">🛒</div><span>Pet shopping & services</span></div>
                    <div class="perk"><div class="perk-ico">🐾</div><span>Adoption and pet tracking</span></div>
                    <div class="perk"><div class="perk-ico">👛</div><span>Waffy wallet rewards</span></div>
                </div>


            </aside>

            <div class="fwrap">

                <section class="screen on" id="s1">
                    <form asp-controller="Account" asp-action="user_signup" method="post">
                      
                        @Html.AntiForgeryToken()
                        <div class="card">
                            <div class="card-hd">
                                <div class="card-ico">👤</div>
                                <div>
                                    <div class="card-title">Account Information</div>
                                    <div class="card-sub">Review and complete your main account information.</div>
                                </div>
                            </div>

                            <div class="social-btns">
                                <button type="button" class="social-btn google"><i class="fa-brands fa-google"></i> Continue with Google</button>
                                <button type="button" class="social-btn facebook"><i class="fa-brands fa-facebook-f"></i> Continue with Facebook</button>
                            </div>

                            <div class="divider"><span>Or create a new account</span></div>

                            <div class="fg">
                                <div class="f fw">
                                    <label class="lbl">Full Name <span class="req">*</span></label>
                                    <input class="inp" name="fullName" id="fullName" type="text" oninput="ce(this)" />
                                    <div class="ferr" id="e-fullName">Please enter your full name.</div>
                                </div>

                                <div class="f fw">
                                    <label class="lbl">Email Address <span class="req">*</span></label>
                                    <input class="inp" name="email" id="email" type="email" oninput="ce(this)" />
                                    <div class="ferr" id="e-email">Please enter a valid email.</div>
                                </div>
                                <div class="f fw">
                                    <label class="lbl">Phone Number <span class="req">*</span></label>
                                    <div class="ph-wrap">
                                        <span class="ph-pre">+962</span>
                                        <input class="inp" name="phone" id="phone" type="tel" placeholder="7X XXX XXXX" oninput="ce(this)" />
                                    </div>
                                    <div class="ferr" id="e-phone">Please enter a valid phone number.</div>
                                </div>
                                <div class="fg">
                                    <div class="f">
                                        <label class="lbl">Governorate <span class="req">*</span></label>
                                        <select class="inp" name="city" id="regCity"
                                                onchange="updateDistricts('regCity','regArea')"
                                                oninput="ce(this)" required>
                                            <option value="">— Select governorate —</option>
                                            @{
                                                var locs = System.Text.Json.JsonSerializer
                                                .Deserialize<List<System.Text.Json.JsonElement>>(
                                                ViewBag.LocationsJson as string ?? "[]");
                                            }
                                            @foreach (var g in locs ?? new())
                                            {
                                                <option value="@g.GetProperty("name").GetString()">
                                                    @g.GetProperty("name").GetString()
                                                </option>
                                            }
                                        </select>
                                        <div class="ferr" id="e-city">Please select your governorate.</div>
                                    </div>

                                    <div class="f">
                                        <label class="lbl">Area / District</label>
                                        <select class="inp" name="area" id="regArea">
                                            <option value="">— Select governorate first —</option>
                                        </select>
                                    </div>


                                </div>
                                <div class="f fw">
                                    <label class="lbl">Password <span class="req">*</span></label>
                                    <input class="inp" id="pwd" name="password" type="password" oninput="ce(this);pwdStr(this)" />
                                    <div class="pwd-str" id="pwdStr">
                                        <div class="pb"></div>
                                        <div class="pb"></div>
                                        <div class="pb"></div>
                                        <div class="pl" id="pwdLbl">Enter a password</div>
                                    </div>
                                </div>

                                <div class="f fw">
                                    <label class="lbl">Confirm Password <span class="req">*</span></label>
                                    <input class="inp" name="confirmPassword" id="pwd2" type="password" oninput="ce(this)" />
                                    <div class="ferr" id="e-pwd2">Passwords do not match.</div>
                                    <div class="hint">At least 8 characters with numbers recommended.</div>
                                    @if (TempData["SignupError"] != null)
                                    {
                                        <div class="server-msg server-msg-error" style="color:red">
                                            @TempData["SignupError"]
                                        </div>
                                    }

                                    @if (TempData["SignupSuccess"] != null)
                                    {
                                        <div class="server-msg server-msg-success" style="color:red">
                                            @TempData["SignupSuccess"]
                                        </div>
                                    }
                                </div>


                            </div>
                        </div>

                        <div class="fnav">
                            <div class="bottom-corner-link">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></div>
                            <button type="submit" class="btn btn-p">
                                Create My Account
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>

    <script src="~/js/user-signup.js"></script>
    <script>
        const _locations = @Html.Raw(ViewBag.LocationsJson ?? "[]");

        function updateDistricts(cityId, areaId) {
            const city = document.getElementById(cityId).value;
            const sel  = document.getElementById(areaId);
            sel.innerHTML = '<option value="">— Select area —</option>';

            const gov = _locations.find(g => g.name === city);
            if (!gov) return;

            gov.districts.forEach(d => {
                const opt = document.createElement('option');
                opt.value       = d;
                opt.textContent = d;
                sel.appendChild(opt);
            });
        }
    </script>
</body>
</html>