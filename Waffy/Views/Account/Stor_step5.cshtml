@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Store Registration</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;500;600;700;800&family=Readex+Pro:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/store.css" />
</head>
<body class="store-step-5">

    <div id="storeWizardContainer" dir="ltr" lang="en">
        <div id="userWizardContainer">
            <div class="topbar">
                <div class="logo"><span class="logo-ico"></span> Waffy</div>
                <div class="topbar-right">
                    <a asp-controller="Account" asp-action="Signup" class="top-signup-link">← Back to Sign Up</a>
                </div>
            </div>

            <div class="prog-line"><div class="prog-fill" style="width:100%"></div></div>

            <div class="sw-wrap">
                <aside class="sw-sidebar">
                    <div class="sw-sb-brand">
                        <div class="sw-sb-brand-title">🏪 Store Registration</div>
                        <div class="sw-sb-brand-sub">Join Waffy and start selling to thousands of pet owners across Jordan</div>
                    </div>

                    <div class="sw-sb-steps">
                        <div class="sw-sb-lbl">Registration Steps</div>
                        <div id="swSbSteps">
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">👤 Account Owner</div><div class="sw-si-sub">Step 1</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">🏪 Store Information</div><div class="sw-si-sub">Step 2</div></div></div>
                            <div class="sw-si done"><div class="sw-si-num">✓</div><div><div class="sw-si-title">📍 Contact & Location</div><div class="sw-si-sub">Step 3</div></div></div>
              
                            <div class="sw-si active"><div class="sw-si-num">5</div><div><div class="sw-si-title">📄 Business & Docs</div><div class="sw-si-sub">Step 5</div></div></div>
                        </div>
                    </div>
                </aside>

                <div class="sw-fwrap">
                    <div class="sw-dots" id="swDots">
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot done"></div>
                        <div class="sw-dot active"></div>
                    </div>

                    <div class="sw-screen on" id="sw-s5">
                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">💼</div>
                                <div>
                                    <div class="sw-card-title">Business Model</div>
                                    <div class="sw-card-sub">How would you like to work with Waffy?</div>
                                </div>
                            </div>

                            <div class="sw-warn-box">
                                ⚠️ Choose your model carefully — it can only be changed later by contacting support
                            </div>

                            <div class="sw-biz-grid">
                                <div class="sw-biz-card" id="swBizComm" onclick="swSelectBiz('commission')">
                                    <span class="sw-biz-ico">📊</span>
                                    <div class="sw-biz-title">Commission</div>
                                    <div class="sw-biz-desc">Pay a percentage of each sale only — ideal for new and growing stores</div>
                                </div>

                                <div class="sw-biz-card" id="swBizSub" onclick="swSelectBiz('subscription')">
                                    <span class="sw-biz-ico">📅</span>
                                    <div class="sw-biz-title">Monthly Subscription</div>
                                    <div class="sw-biz-desc">Fixed monthly fee — ideal for high-volume stores with consistent sales</div>
                                </div>
                            </div>

                            <div class="sw-biz-extra" id="swCommExtra">
                                <div class="sw-f">
                                    <label class="sw-lbl">Commission % <span class="sw-req">*</span></label>
                                    <div class="sw-ph-wrap">
                                        <input class="sw-inp" type="number" min="1" max="30" placeholder="e.g. 10" style="flex:1">
                                        <span class="sw-ph-pre">%</span>
                                    </div>
                                    <div class="sw-hint">💡 Agreed percentage from each sale transaction</div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">Minimum Commission <span class="sw-opt">(Optional)</span></label>
                                    <div class="sw-ph-wrap">
                                        <input class="sw-inp" type="number" placeholder="0.50" style="flex:1">
                                        <span class="sw-ph-pre">JOD</span>
                                    </div>
                                </div>
                            </div>

                            <div class="sw-biz-extra fw" id="swSubExtra">
                                <label class="sw-lbl" style="margin-bottom:.7rem">Subscription Plan <span class="sw-req">*</span></label>

                                <div class="sw-plan-grid">
                                    <div class="sw-plan-card" onclick="swSelPlan(this)">
                                        <div class="sw-plan-name">Basic</div>
                                        <div class="sw-plan-price">25 <span>JOD/mo</span></div>
                                        <div class="sw-plan-feat">Up to 50 products<br>Basic support</div>
                                    </div>

                                    <div class="sw-plan-card" onclick="swSelPlan(this)">
                                        <div class="sw-plan-name">Professional</div>
                                        <div class="sw-plan-price">60 <span>JOD/mo</span></div>
                                        <div class="sw-plan-feat">Unlimited products<br>Priority in search</div>
                                    </div>

                                    <div class="sw-plan-card" onclick="swSelPlan(this)">
                                        <div class="sw-plan-name">Enterprise</div>
                                        <div class="sw-plan-price">120 <span>JOD/mo</span></div>
                                        <div class="sw-plan-feat">All features<br>Dedicated account manager</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-card">
                            <div class="sw-card-hd">
                                <div class="sw-card-ico">📄</div>
                                <div>
                                    <div class="sw-card-title">Official Documents &amp; Verification</div>
                                    <div class="sw-card-sub">Required for store approval — reviewed within 24–48 hours</div>
                                </div>
                            </div>

                            <div class="sw-info-box">
                                ℹ️ The Waffy team will review your application within 24–48 hours. Documents marked with <strong>*</strong> are mandatory for store approval.
                            </div>

                            <div class="sw-doc-grid">
                                <div class="sw-f">
                                    <label class="sw-lbl">Commercial Registration <span class="sw-req">*</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-doc1')" style="padding:.9rem">
                                        <input type="file" id="sw-doc1" accept=".pdf,image/*" style="display:none" onchange="swPreviewFile(this,'sw-doc1p','sw-doc1n')">
                                        <div class="wf-upload-ico" style="font-size:1.4rem">📋</div>
                                        <div class="wf-upload-txt" style="font-size:.72rem"><strong>Upload file</strong> — PDF or image</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-doc1p">
                                        <span>📋</span>
                                        <span class="wf-prev-name" id="sw-doc1n"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-doc1','sw-doc1p','sw-doc1n')">✕</button>
                                    </div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">Business License <span class="sw-req">*</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-doc2')" style="padding:.9rem">
                                        <input type="file" id="sw-doc2" accept=".pdf,image/*" style="display:none" onchange="swPreviewFile(this,'sw-doc2p','sw-doc2n')">
                                        <div class="wf-upload-ico" style="font-size:1.4rem">🏛</div>
                                        <div class="wf-upload-txt" style="font-size:.72rem"><strong>Upload file</strong> — PDF or image</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-doc2p">
                                        <span>🏛</span>
                                        <span class="wf-prev-name" id="sw-doc2n"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-doc2','sw-doc2p','sw-doc2n')">✕</button>
                                    </div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">Trademark Certificate <span class="sw-opt">(Optional)</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-doc3')" style="padding:.9rem">
                                        <input type="file" id="sw-doc3" accept=".pdf,image/*" style="display:none" onchange="swPreviewFile(this,'sw-doc3p','sw-doc3n')">
                                        <div class="wf-upload-ico" style="font-size:1.4rem">™️</div>
                                        <div class="wf-upload-txt" style="font-size:.72rem"><strong>Upload file</strong> — PDF or image</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-doc3p">
                                        <span>™️</span>
                                        <span class="wf-prev-name" id="sw-doc3n"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-doc3','sw-doc3p','sw-doc3n')">✕</button>
                                    </div>
                                </div>

                                <div class="sw-f">
                                    <label class="sw-lbl">VAT Certificate <span class="sw-opt">(Optional)</span></label>
                                    <div class="wf-upload-box" onclick="swTrigUpload('sw-doc4')" style="padding:.9rem">
                                        <input type="file" id="sw-doc4" accept=".pdf,image/*" style="display:none" onchange="swPreviewFile(this,'sw-doc4p','sw-doc4n')">
                                        <div class="wf-upload-ico" style="font-size:1.4rem">🧾</div>
                                        <div class="wf-upload-txt" style="font-size:.72rem"><strong>Upload file</strong> — PDF or image</div>
                                    </div>
                                    <div class="wf-upload-prev" id="sw-doc4p">
                                        <span>🧾</span>
                                        <span class="wf-prev-name" id="sw-doc4n"></span>
                                        <button class="wf-prev-rm" onclick="swRemoveFile('sw-doc4','sw-doc4p','sw-doc4n')">✕</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sw-card" style="padding:1.3rem">
                            <div class="sw-check-row"><input type="checkbox" id="sw-t1"><label class="sw-check-lbl" for="sw-t1">I agree to the <a href="#">Terms of Use</a> and <a href="#">Privacy Policy</a> of Waffy</label></div>
                            <div class="sw-check-row"><input type="checkbox" id="sw-t2"><label class="sw-check-lbl" for="sw-t2">I agree to the <a href="#">Business Model Policy</a>, commissions, and subscription rates applicable on the platform</label></div>
                            <div class="sw-check-row"><input type="checkbox" id="sw-t3"><label class="sw-check-lbl" for="sw-t3">I confirm that all submitted information and documents are accurate and take full legal responsibility for any misleading information</label></div>
                        </div>

                        <div class="sw-fnav">
                            <a class="sw-btn sw-btn-o" oasp-controller="Account" asp-action="Stor_step4">← Previous</a>
                            <a class="sw-btn sw-btn-p sw-btn-lg" asp-controller="Account" asp-action="Stor_success">🚀 Submit Registration</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/store.js"></script>
</body>
</html>