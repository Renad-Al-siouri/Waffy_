@{
    ViewData["Title"] = "Waffy — Clinic Admin | Reviews";
    Layout = null;
    var reviews = ViewBag.Reviews as List<Waffy.Models.Review> ?? new();
    var avg = (double)(ViewBag.AvgRating ?? 0.0);
    var total = (int)(ViewBag.TotalCount ?? 0);
    int star5 = (int)(ViewBag.Star5 ?? 0);
    int star4 = (int)(ViewBag.Star4 ?? 0);
    int star3 = (int)(ViewBag.Star3 ?? 0);
    int star2 = (int)(ViewBag.Star2 ?? 0);
    int star1 = (int)(ViewBag.Star1 ?? 0);

    string StarsHtml(int rating)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++)
            sb.Append(i <= rating ? "★" : "☆");
        return sb.ToString();
    }
    string RatingColor(int r) => r switch
    {
        5 => "var(--gre)",
        4 => "#7d953d",
        3 => "var(--ora)",
        2 => "var(--red)",
        _ => "var(--red)"
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css" asp-append-version="true">
    <style>
        .star-fill {
            color: #efb83c;
            font-size: 1rem;
            letter-spacing: 1px;
        }

        .star-empty {
            color: #d8cbb8;
            font-size: 1rem;
            letter-spacing: 1px;
        }

        .rating-bar-bg {
            flex: 1;
            height: 8px;
            background: var(--line);
            border-radius: 999px;
            overflow: hidden;
        }

        .rating-bar-fill {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg,#9ab451,#7d953d);
            transition: width .4s ease;
        }

        .reviewer-av {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg,#9ab451,#7d953d);
            color: #fff;
            font-size: .82rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-family: 'Fredoka',sans-serif;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 900;
        }
    </style>
</head>
<body class="admin-shell">
    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="wa-shell" id="waShell">

        <!-- SIDEBAR -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"
                         onerror="this.remove();this.parentElement.innerHTML='🐾';">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Dashboard", "ClinicAdmin")">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" href="@Url.Action("Appointments", "ClinicAdmin")">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Patients", "ClinicAdmin")">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Medical_Records", "ClinicAdmin")">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" href="@Url.Action("Doctors", "ClinicAdmin")">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Basic_Information", "ClinicAdmin")">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Revenue", "ClinicAdmin")">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Adoption", "ClinicAdmin")">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" href="@Url.Action("Reports", "ClinicAdmin")">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                    <a class="sb-row active" href="@Url.Action("Reviews", "ClinicAdmin")">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Settings</div>
                    <a class="sb-row" href="@Url.Action("Images", "ClinicAdmin")"><span class="sb-icon">🖼️</span><span class="sb-lbl">Images</span></a>
                    <a class="sb-row" href="@Url.Action("Services", "ClinicAdmin")"><span class="sb-icon">🔧</span><span class="sb-lbl">Services</span></a>
                    <a class="sb-row" href="@Url.Action("Working_Hours", "ClinicAdmin")"><span class="sb-icon">🕐</span><span class="sb-lbl">Working Hours</span></a>
                    <a class="sb-row" href="@Url.Action("Documents_C", "ClinicAdmin")"><span class="sb-icon">📋</span><span class="sb-lbl">Documents</span></a>
                    <a class="sb-row" href="@Url.Action("Notifications", "ClinicAdmin")"><span class="sb-icon">🔔</span><span class="sb-lbl">Notifications</span></a>
                    <a class="sb-row" href="@Url.Action("Logout", "ClinicAdmin")"><span class="sb-icon">🚪</span><span class="sb-lbl">Logout</span></a>
                </div>
            </nav>
        </aside>

        <!-- TOPNAV -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread"><span>Clinic Admin</span><span>/</span><b>Reviews</b></div>
            <div class="tn-center">
                <div class="tn-center-main">Reviews &amp; Ratings</div>
                <div class="tn-center-sub">What patients say about your clinic</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @(Context.Session.GetString("ClinicName") ?? "Clinic")</div>
            </div>
        </header>

        <!-- MAIN -->
        <main class="wa-main">

            <section class="page-hero page-hero-split">
                <div>
                    <h1>⭐ Reviews &amp; Ratings</h1>
                    <p>
                        @if (total == 0)
                        {
                            <text>No reviews yet — reviews appear here once patients submit them.</text>
                        }
                        else
                        {

                            <text>@total review@(total != 1 ? "s" : "") · Average rating <strong>@avg.ToString("F1") / 5.0</strong></text>
                        }
                    </p>
                </div>
            </section>

            <div class="page-body">

                @* KPI Row *@
                <div class="kpi-grid kpi-4" style="margin-bottom:20px;">
                    <div class="kpi-card green">
                        <div class="kpi-top"><div class="kpi-icon green">📝</div></div>
                        <div class="kpi-val">@total</div>
                        <div class="kpi-label">Total reviews</div>
                    </div>
                    <div class="kpi-card blue">
                        <div class="kpi-top"><div class="kpi-icon blue">⭐</div></div>
                        <div class="kpi-val">@avg.ToString("F1")</div>
                        <div class="kpi-label">Average rating</div>
                    </div>
                    <div class="kpi-card green">
                        <div class="kpi-top"><div class="kpi-icon green">🏆</div></div>
                        <div class="kpi-val">@star5</div>
                        <div class="kpi-label">5-star reviews</div>
                    </div>
                    <div class="kpi-card orange">
                        <div class="kpi-top"><div class="kpi-icon orange">💬</div></div>
                        <div class="kpi-val">@(reviews.Count(r => !string.IsNullOrEmpty(r.Comment)))</div>
                        <div class="kpi-label">With comments</div>
                    </div>
                </div>

                @if (total > 0)
                {
                    <div style="display:grid;grid-template-columns:320px 1fr;gap:16px;margin-bottom:20px;align-items:start;">

                        @* Rating Breakdown Card *@
                        <div class="table-card" style="padding:1.2rem;">
                            <div style="text-align:center;margin-bottom:1rem;">
                                <div style="font-family:'Fredoka',sans-serif;font-size:3.5rem;
                                            font-weight:700;color:var(--olive-dark);line-height:1;">
                                    @avg.ToString("F1")
                                </div>
                                <div class="star-fill" style="font-size:1.4rem;margin:.3rem 0;">
                                    @{
                                        int full = (int)Math.Floor(avg);
                                        bool half = (avg - full) >= 0.5;
                                        int empty = 5 - full - (half ? 1 : 0);
                                    }
                                    @for (int i = 0; i < full; i++)
                                    {
                                        <text>★</text>
                                    }
                                    @if (half)
                                    {
                                        <span style="color:#d8cbb8">½</span>
                                    }
                                    @for (int i = 0; i < empty; i++)
                                    {
                                        <span class="star-empty">★</span>
                                    }
                                </div>
                                <div style="font-size:.8rem;font-weight:800;color:var(--text-muted);">
                                    Based on @total review@(total != 1 ? "s" : "")
                                </div>
                            </div>
                            @foreach (var (star, count) in new[] { (5, star5), (4, star4), (3, star3), (2, star2), (1, star1) })
                            {
                                var pct = total > 0 ? (double)count / total * 100 : 0;
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                                    <span style="font-size:.78rem;font-weight:900;
                                                     color:var(--text-muted);width:14px;text-align:right;">
                                        @star
                                    </span>
                                    <span class="star-fill" style="font-size:.76rem;flex-shrink:0;">★</span>
                                    <div class="rating-bar-bg">
                                        <div class="rating-bar-fill" style="width:@pct.ToString("F0")%;"></div>
                                    </div>
                                    <span style="font-size:.76rem;font-weight:800;color:var(--text-muted);
                                                     width:24px;text-align:right;">@count</span>
                                </div>
                            }
                        </div>

                        @* Reviews List *@
                        <div class="table-card">
                            <div class="table-head-bar">
                                <div class="table-head-title">Patient Reviews</div>
                                <span style="font-size:.78rem;font-weight:800;color:var(--text-muted);">
                                    @total review@(total != 1 ? "s" : "")
                                </span>
                            </div>
                            @foreach (var rev in reviews)
                            {
                                var initials = string.IsNullOrEmpty(rev.UserFullName) ? "?"
                                : rev.UserFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries) is { Length: >= 2 } p
                                ? $"{p[0][0]}{p[1][0]}".ToUpper()
                                : rev.UserFullName[0].ToString().ToUpper();

                                <div style="padding:14px 16px;border-bottom:1px solid var(--line);
                                                display:flex;gap:12px;align-items:flex-start;">
                                    @if (!string.IsNullOrEmpty(rev.UserProfileImage))
                                    {
                                        <img src="@rev.UserProfileImage" alt=""
                                             class="reviewer-av" style="object-fit:cover;">
                                    }
                                    else
                                    {
                                        <div class="reviewer-av">@initials</div>
                                    }
                                    <div style="flex:1;min-width:0;">
                                        <div style="display:flex;align-items:center;
                                                        justify-content:space-between;flex-wrap:wrap;gap:4px;">
                                            <div style="font-weight:900;font-size:.88rem;color:var(--text);">
                                                @(rev.UserFullName ?? "Anonymous")
                                            </div>
                                            <div style="font-size:.74rem;font-weight:700;color:var(--text-muted);">
                                                @rev.CreatedAt.ToString("MMM dd, yyyy")
                                            </div>
                                        </div>
                                        <div style="margin-top:3px;">
                                            <span class="star-fill" style="font-size:.88rem;color:@RatingColor(rev.Rating);">
                                                @StarsHtml(rev.Rating)
                                            </span>
                                            <span class="pill" style="background:var(--olive-soft);
                                                                           color:var(--olive-dark);margin-left:4px;">
                                                @rev.Rating / 5
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(rev.Title))
                                        {
                                            <div style="font-weight:900;font-size:.86rem;
                                                                color:var(--text);margin-top:5px;">
                                                @rev.Title
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(rev.Comment))
                                        {
                                            <div style="font-size:.83rem;color:var(--text-muted);
                                                                font-weight:700;margin-top:3px;
                                                                line-height:1.6;">
                                                @rev.Comment
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-card" style="text-align:center;padding:56px 20px;">
                        <div style="font-size:3rem;margin-bottom:12px;">⭐</div>
                        <div style="font-family:'Fredoka',sans-serif;font-size:1.2rem;
                                    font-weight:700;color:var(--text);">
                            No reviews yet
                        </div>
                        <div style="font-size:.84rem;color:var(--text-muted);margin-top:6px;">
                            Reviews appear here once patients rate your clinic.
                        </div>
                    </div>
                }

            </div>
        </main>
    </div>
    <script>
        function toggleSidebar() {
            document.getElementById('waShell').classList.toggle('sb-open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }
        function closeSidebar() {
            document.getElementById('waShell').classList.remove('sb-open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
</body>
</html>