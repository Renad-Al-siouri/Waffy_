@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy — Clinic Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
</head>
<body>
    <div id="loginScreen">
        <div class="login-card">
            <div class="login-logo">
                <div class="login-logo-icon">🐾</div>
                <div class="login-logo-name">Waffy</div>
                <div class="login-logo-sub">Clinic Dashboard</div>
            </div>
            <div style="font-size:1rem;font-weight:800;color:var(--text);margin-bottom:1.2rem;text-align:center;">
                Choose your role to sign in
            </div>
            <div class="role-selector">
                <div class="role-btn selected" id="roleManager">
                    <div class="rb-icon">👑</div>
                    <div class="rb-title">Clinic Manager</div>
                    <div class="rb-sub">Full access</div>
                </div>
                <div class="role-btn" id="roleDoctor">
                    <div class="rb-icon">👨‍⚕️</div>
                    <div class="rb-title">Doctor</div>
                    <div class="rb-sub">My appointments &amp; patients</div>
                </div>
            </div>
            <div class="inp-group">
                <label class="inp-label">Email Address</label>
                <input class="inp" type="email" id="loginEmail" placeholder="clinic@waffy.jo">
            </div>
            <div class="inp-group">
                <label class="inp-label">Password</label>
                <input class="inp" type="password" id="loginPassword" placeholder="••••••••">
            </div>
            <button class="login-btn" id="loginBtn">Enter Dashboard →</button>
        </div>
    </div>
    <script src="~/js/AdminClinicDoctor.js"></script>
</body>
</html>
