@model Waffy.Models.ViewModels.DocumentsCViewModel
@{
    ViewData["Title"] = "Waffy — Clinic Documents";
   
    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";

    var docTypeMap = new Dictionary<string, (string Label, string Icon)>
    {
        ["MunicipalLicense"] = ("Municipal License", "🏛"),
        ["VeterinaryLicense"] = ("Veterinary Practice License", "⚕️"),
        ["NationalId"] = ("National ID", "🪪"),
        ["Logo"] = ("Clinic Logo", "🎨"),
        ["Other"] = ("Other Document", "📄"),
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <link rel="stylesheet" href="~/css/clinic-setting.css">
    <style>
        .doc-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: var(--gp);
            border-radius: 10px;
            border: 1px solid var(--b2);
            flex-wrap: wrap;
        }

        .doc-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .doc-info {
            flex: 1;
            min-width: 120px;
        }

        .doc-name {
            font-weight: 700;
            font-size: .88rem;
            color: var(--text);
        }

        .doc-meta {
            font-size: .75rem;
            color: var(--muted);
            margin-top: 2px;
        }
    </style>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">
        @await Html.PartialAsync("~/Views/ClinicAdmin/_ClinicAdminSidebar.cshtml")


        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread">
                <span>Clinic Management</span><span>/</span><b>Clinic Settings</b>
            </div>
            <div class="tn-center">
                <div class="tn-center-main">Clinic Settings</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">
            <section class="page-hero">
                <div>
                    <h1>Clinic Settings</h1>
                    <p>View and update your clinic's official documents.</p>
                </div>
            </section>

            <div class="page-body">

                @* Messages *@
                @if (TempData["DocSuccess"] != null)
                {
                    <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                        ✅ @TempData["DocSuccess"]
                    </div>
                }
                @if (TempData["DocError"] != null)
                {
                    <div style="background:#faece8;border:1px solid rgba(200,106,92,.3);border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#c86a5c;">
                        ⚠️ @TempData["DocError"]
                    </div>
                }

                @* Verification status banner *@
                @if (Model.ClinicVerificationStatus == "Under Review")
                {
                    <div style="background:#fff8e1;border:1px solid #f0c040;border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:700;color:#b8860b;">
                        🔍 Your documents are under review by the Waffy team.
                    </div>
                }

                <!-- Tab navigation -->
                <nav class="tabs cs-tab-nav">
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Basic_Information">📋 Basic Information</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Working_Hours">⏰ Working Hours</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Services">🩺 Services</a>
                    <a class="tab active" asp-controller="ClinicAdmin" asp-action="Documents_C">📄 Documents</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Images">🖼 Images</a>
                </nav>

                <!-- ── Existing Documents ── -->
                <div class="chart-card">
                    <div class="sec-label">Uploaded official documents</div>

                    @if (!Model.Documents.Any())
                    {
                        <div style="color:var(--muted);font-size:.88rem;padding:1rem 0;">
                            No documents uploaded yet.
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:1rem;">
                            @foreach (var doc in Model.Documents)
                            {
                                // ✅ استخدمي Item1 و Item2 بدل Label و Icon
                                var found = docTypeMap.TryGetValue(doc.DocumentType ?? "", out var info);
                                var typeLabel = found ? info.Item1 : "Document";
                                var typeIcon = found ? info.Item2 : "📄";

                                var statusCls = doc.Status?.ToLower() switch
                                {
                                    "approved" => "s-confirmed",
                                    "rejected" => "s-cancelled",
                                    "under review" => "s-pending",
                                    _ => "s-pending"
                                };
                                var statusLabel = doc.Status?.ToLower() switch
                                {
                                    "approved" => "Approved ✓",
                                    "rejected" => "Rejected ✗",
                                    "under review" => "Under Review 🔍",
                                    _ => "Pending ⏳"
                                };

                                <div class="doc-row">
                                    <span class="doc-icon">@typeIcon</span>
                                    <div class="doc-info">
                                        <div class="doc-name">@typeLabel</div>
                                        <div class="doc-meta">
                                            Uploaded: @doc.UploadedAt.ToString("dd MMM yyyy")
                                            @if (doc.ExpiryDate.HasValue)
                                            {
                                                <span> — Expires: @doc.ExpiryDate.Value.ToString("dd MMM yyyy")</span>
                                            }
                                        </div>
                                    </div>

                                    <span class="status @statusCls">@statusLabel</span>

                                    @if (doc.Status?.ToLower() != "pending")
                                    {
                                        <form asp-controller="ClinicAdmin" asp-action="UploadDocument"
                                              method="post" enctype="multipart/form-data" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentType" value="@doc.DocumentType">
                                            <label class="btn btn-outline btn-sm" style="cursor:pointer;margin:0">
                                                📤 Upload New Version
                                                <input type="file" name="file" accept=".pdf,.jpg,.jpeg,.png"
                                                       style="display:none" onchange="this.form.submit()">
                                            </label>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size:.75rem;color:var(--muted)">Awaiting review</span>
                                    }
                                </div>
                            }

                        </div>
                    }

                    <!-- ── Upload New Document ── -->
                    <div class="sec-label" style="margin-top:1rem">Upload additional document</div>
                    <form asp-controller="ClinicAdmin"
                          asp-action="UploadDocument"
                          method="post"
                          enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="f-grid" style="margin-bottom:.8rem">
                            <div class="f-group">
                                <label class="f-label">Document Type</label>
                                <select name="documentType" class="f-inp" required id="newDocType">
                                    <option value="">-- Select Type --</option>
                                    <option value="MunicipalLicense">Municipal License</option>
                                    <option value="VeterinaryLicense">Veterinary Practice License</option>
                                    <option value="NationalId">National ID</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                        <label class="upload-box" style="cursor:pointer;display:block" id="uploadLabel">
                            <input type="file" name="file"
                                   accept=".pdf,.jpg,.jpeg,.png"
                                   style="display:none"
                                   id="newDocFile"
                                   onchange="updateUploadLabel(this)">
                            <div class="upload-icon">📎</div>
                            <div class="upload-txt" id="uploadTxt">Click to select file</div>
                            <div class="upload-sub">PDF, JPG, PNG — max 10MB</div>
                        </label>

                        <button type="submit" class="btn btn-primary"
                                style="margin-top:.8rem;width:100%">
                            📤 Upload Document
                        </button>
                    </form>

                </div>
            </div>
        </main>
    </div>

    <script>
        function updateUploadLabel(input) {
            const txt = document.getElementById("uploadTxt");
            if (input.files && input.files[0]) {
                txt.textContent = input.files[0].name;
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }
        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>