@{
    ViewData["Title"] = "Medical Records";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy — Clinic &amp; Doctor Medical Records</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
</head>
<body class="admin-shell">
    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="wa-shell" id="waShell">
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Dashboard", "ClinicAdmin")" data-tip="Dashboard"><span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" href="@Url.Action("Appointments", "ClinicAdmin")" data-tip="Appointments"><span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span><span class="sb-bdg bd-g">5</span></a>
                    <a class="sb-row" href="@Url.Action("Patients", "ClinicAdmin")" data-tip="Patients"><span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span></a>
                    <a class="sb-row active" href="@Url.Action("Medical_Records", "ClinicAdmin")" data-tip="Medical Records"><span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group" id="managerSection">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" href="@Url.Action("Doctors", "ClinicAdmin")" data-tip="Doctors"><span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span></a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Basic_Information" data-tip="Clinic Settings">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" href="@Url.Action("Revenue", "ClinicAdmin")" data-tip="Revenue &amp; Payments"><span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Adoption", "ClinicAdmin")" data-tip="Adoption"><span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" href="@Url.Action("Reviews", "ClinicAdmin")" data-tip="Reviews"><span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span><span class="sb-bdg bd-g">2</span></a>
                    <a class="sb-row" href="@Url.Action("Reports", "ClinicAdmin")" data-tip="Reports"><span class="sb-icon">📈</span><span class="sb-lbl">Reports</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row " asp-controller="ClinicAdmin" asp-action="Personal_nformation" data-tip="My Settings">
                        <span class="sb-icon">⚙️</span>
                        <span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row" onclick="openSidebarProfile()">
                    <div class="sb-av">DC</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">Daniel Carter</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <button class="sb-logout" onclick="doLogout()" type="button">
                    <span class="sb-icon">↩</span><span class="sb-logout-lbl">Sign Out</span>
                </button>
            </div>
        </aside>
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()" aria-label="Toggle sidebar">☰</button>
            <div class="tn-bread" id="tnBread"><span>Daily Management</span><span>/</span><b id="tnCur">Medical Records</b></div>
            <div class="tn-center">
                <div class="tn-center-main" id="tnTitle">Medical Records</div>
                <div class="tn-center-sub" id="tnSub">Waffy Clinic Dashboard</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity" id="tnIdentityPill">🏥 Al Amanah Veterinary Clinic</div>
                <button class="tn-btn notif-btn" type="button" aria-label="Notifications">🔔<span class="tn-count">3</span></button>
                <div class="tn-sep"></div>
                <div class="tn-profile user-btn">
                    <div class="tn-av" id="userAvaTop">M</div>
                    <div>
                        <div class="tn-pname" id="userNameTop">Clinic Manager</div>
                        <div class="tn-prole" id="roleTagTop">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>
        <main class="wa-main">
            <section class="page-hero">
                <div>
                    <h1 id="pageHeroTitle">Medical Records</h1>
                    <p>Review diagnoses, treatments, and visit history across your patients.</p>
                </div>
            </section>
            <div class="page-body">
                <div id="page-records" class="page-content">
                    <div class="page-header">
                        <div><div class="page-title">📄 Medical Records</div><div class="page-sub">Add and review records after each visit</div></div>
                        <button class="btn btn-primary" onclick="openModal('modalRecord')">+ New Record</button>
                    </div>
                    <div class="filter-bar">
                        <div class="search-input"><span>🔍</span><input placeholder="Search by pet or owner..."></div>
                        <select class="filter-select"><option>All types</option><option>Checkup</option><option>Vaccination</option><option>Surgery</option></select>
                    </div>
                    <div class="record-item">
                        <div class="record-header">
                            <div><div class="record-title">🐕 Max — Routine checkup</div><div class="record-date">10 March 2026 • Dr. Ahmad Al-Zoubi</div></div>
                            <div style="display:flex;gap:6px">
                                <button class="btn btn-outline btn-sm" onclick="openModal('modalRecord')">✏️ Edit</button>
                                <button class="btn btn-red btn-sm">🗑</button>
                            </div>
                        </div>
                        <div style="font-size:.84rem;color:var(--textm)">Diagnosis: Healthy condition. Weight 28 kg is normal. Treatment: Nutritional supplements.</div>
                        <div class="record-tags"><span class="record-tag">General checkup</span><span class="record-tag rx">Nutritional supplements</span><span class="record-tag vax">Rabies vaccination ✓</span><span class="record-tag" style="background:var(--gp)">Follow-up: 10 April</span></div>
                    </div>
                    <div class="record-item">
                        <div class="record-header">
                            <div><div class="record-title">🐈 Luna — Routine vaccination</div><div class="record-date">5 March 2026 • Dr. Sarah Al-Hussein</div></div>
                            <div style="display:flex;gap:6px">
                                <button class="btn btn-outline btn-sm" onclick="openModal('modalRecord')">✏️ Edit</button>
                                <button class="btn btn-red btn-sm">🗑</button>
                            </div>
                        </div>
                        <div style="font-size:.84rem;color:var(--textm)">FVR + rabies vaccination. Condition is excellent.</div>
                        <div class="record-tags"><span class="record-tag vax">FVR ✓</span><span class="record-tag vax">Rabies ✓</span><span class="record-tag" style="background:var(--gp)">Next dose: 5 March 2027</span></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal: Appointment -->
    <div class="modal-overlay" id="modalAppt" onclick="closeOnBg(event,'modalAppt')">
        <div class="modal">
            <div class="modal-header"><div class="modal-title">📅 New Appointment / Edit Appointment</div><button class="modal-close" onclick="closeModal('modalAppt')">✕</button></div>
            <div class="modal-body">
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Pet (Patient)</label><select class="f-inp"><option>Choose a pet...</option><option>🐕 Max — Sarah Al-Khatib</option><option>🐈 Luna — Ahmad Mansour</option><option>🐕 Buddy — Rana Al-Salem</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Owner</label><input class="f-inp" placeholder="Owner name or phone number..."></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Doctor</label><select class="f-inp"><option>Choose a doctor...</option><option>Dr. Ahmad Al-Zoubi</option><option>Dr. Sarah Al-Hussein</option><option>Dr. Mohammad Salameh</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Service</label><select class="f-inp"><option>Choose a service...</option><option>General checkup</option><option>Vaccination</option><option>Surgery</option><option>Dentistry</option><option>Lab Tests</option><option>X-Ray</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Appointment date</label><input class="f-inp" type="date"></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Appointment time</label><input class="f-inp" type="time" value="09:00"></div>
                    <div class="f-group"><label class="f-label">Status</label><select class="f-inp"><option>Scheduled</option><option>Completed</option><option>Cancelled</option></select></div>
                    <div class="f-group f-full"><label class="f-label">Notes</label><textarea class="f-inp" placeholder="Any notes about the appointment..."></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalAppt')">Cancel</button><button class="btn btn-primary">💾 Save Appointment</button></div>
        </div>
    </div>

    <!-- Modal: Pet -->
    <div class="modal-overlay" id="modalPet" onclick="closeOnBg(event,'modalPet')">
        <div class="modal modal-wide">
            <div class="modal-header"><div class="modal-title">🐾 Add / Edit Patient (Pet)</div><button class="modal-close" onclick="closeModal('modalPet')">✕</button></div>
            <div class="modal-body">
                <div class="sec-label">🐾 Pet Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Pet Name</label><input class="f-inp" placeholder="Example: Max"></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Type</label><select class="f-inp"><option>Choose a type...</option><option>🐕 Dog</option><option>🐈 Cat</option><option>🐦 Bird</option><option>🐇 Rabbit</option><option>🐠 Fish</option><option>🦎 Reptile</option><option>Other</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Breed / Family</label><input class="f-inp" placeholder="Example: Labrador"></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Gender</label><select class="f-inp"><option>Male</option><option>Female</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Age</label><input class="f-inp" placeholder="Example: 3 years / 6 months"></div>
                    <div class="f-group"><label class="f-label">Microchip ID</label><input class="f-inp" placeholder="Microchip number if available"><div class="f-hint">🔍 Used to track lost pets</div></div>
                </div>
                <hr class="sec-div"><div class="sec-label">❤️ Health Status</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Vaccination status</label><select class="f-inp"><option>Updated ✓</option><option>Expired — needs update</option><option>Unknown</option></select></div>
                    <div class="f-group"><label class="f-label">Overall Health Status</label><select class="f-inp"><option>Healthy</option><option>Has a health issue</option><option>Under treatment</option></select></div>
                    <div class="f-group f-full"><label class="f-label">Chronic health issues</label><textarea class="f-inp" placeholder="Example: diabetes, heart disease..."></textarea></div>
                    <div class="f-group f-full"><label class="f-label">Allergies</label><textarea class="f-inp" placeholder="Example: allergy to some antibiotics..."></textarea></div>
                </div>
                <hr class="sec-div"><div class="sec-label">👤 Owner Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Owner Name</label><input class="f-inp" placeholder="Full name"></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Phone Number</label><input class="f-inp" type="tel" placeholder="07XXXXXXXX"></div>
                    <div class="f-group f-full"><label class="f-label">Email Address</label><input class="f-inp" type="email" placeholder="owner@email.com"></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🖼 Pet Photo</div>
                <div class="upload-box"><div class="upload-icon">📸</div><div class="upload-txt">Upload Pet Photo</div><div class="upload-sub">JPG, PNG — max 5MB</div></div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalPet')">Cancel</button><button class="btn btn-primary">💾 Save Patient</button></div>
        </div>
    </div>

    <!-- Modal: Medical Record -->
    <div class="modal-overlay" id="modalRecord" onclick="closeOnBg(event,'modalRecord')">
        <div class="modal modal-wide">
            <div class="modal-header"><div class="modal-title">📄 Add / Edit Medical Record</div><button class="modal-close" onclick="closeModal('modalRecord')">✕</button></div>
            <div class="modal-body">
                <div class="sec-label">🐾 Visit Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Pet</label><select class="f-inp"><option>Choose a pet...</option><option>🐕 Max</option><option>🐈 Luna</option><option>🐕 Buddy</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Doctor</label><select class="f-inp"><option>Dr. Ahmad Al-Zoubi</option><option>Dr. Sarah Al-Hussein</option><option>Dr. Mohammad Salameh</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Visit date</label><input class="f-inp" type="date"></div>
                    <div class="f-group"><label class="f-label">Follow-up date</label><input class="f-inp" type="date"><div class="f-hint">📅 Added automatically to the calendar</div></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🩺 Diagnosis</div>
                <div class="f-grid">
                    <div class="f-group f-full"><label class="f-label"><span class="req">*</span>Diagnosis</label><textarea class="f-inp" placeholder="Diagnostic findings..."></textarea></div>
                    <div class="f-group f-full"><label class="f-label">Symptoms</label><textarea class="f-inp" placeholder="Symptoms noticed by the owner or doctor..."></textarea></div>
                </div>
                <hr class="sec-div"><div class="sec-label">💊 Treatment</div>
                <div class="f-grid">
                    <div class="f-group f-full"><label class="f-label">Treatment provided</label><textarea class="f-inp" placeholder="Completed treatment procedures..."></textarea></div>
                    <div class="f-group f-full"><label class="f-label">Prescription</label><textarea class="f-inp" placeholder="Medication: name, dose, duration..."></textarea></div>
                </div>
                <hr class="sec-div"><div class="sec-label">💉 Vaccination</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Vaccine name</label><input class="f-inp" placeholder="Example: Rabies, FVR..."></div>
                    <div class="f-group"><label class="f-label">Next dose date</label><input class="f-inp" type="date"></div>
                </div>
                <hr class="sec-div"><div class="sec-label">📄 Files &amp; Images</div>
                <div class="f-grid">
                    <div class="f-group"><div class="upload-box"><div class="upload-icon">🧪</div><div class="upload-txt">Lab Test Results</div><div class="upload-sub">PDF, JPG — max 10MB</div></div></div>
                    <div class="f-group"><div class="upload-box"><div class="upload-icon">🩻</div><div class="upload-txt">X-Ray images</div><div class="upload-sub">DICOM, JPG — max 20MB</div></div></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalRecord')">Cancel</button><button class="btn btn-primary">💾 Save Record</button></div>
        </div>
    </div>

    <!-- Modal: Add Doctor -->
    <div class="modal-overlay" id="modalDoctor" onclick="closeOnBg(event,'modalDoctor')">
        <div class="modal modal-wide">
            <div class="modal-header"><div class="modal-title">👨‍⚕️ Add Doctor (Manually)</div><button class="modal-close" onclick="closeModal('modalDoctor')">✕</button></div>
            <div class="modal-body">
                <div class="sec-label">👤 Personal Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Doctor Name</label><input class="f-inp" placeholder="Dr. Full Name"></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Phone Number</label><input class="f-inp" type="tel" placeholder="07XXXXXXXX"></div>
                    <div class="f-group f-full"><label class="f-label"><span class="req">*</span>Email Address</label><input class="f-inp" type="email" placeholder="doctor@waffy.jo"></div>
                    <div class="f-group f-full"><div class="upload-box"><div class="upload-icon">👤</div><div class="upload-txt">Professional profile image</div><div class="upload-sub">JPG, PNG — max 3MB</div></div></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🎓 Professional Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Specialty</label><select class="f-inp"><option>Choose a specialty...</option><option>General Veterinary Medicine</option><option>Veterinary Surgery</option><option>Dermatology</option><option>Veterinary Dentistry</option><option>Bird &amp; Reptile Medicine</option></select></div>
                    <div class="f-group"><label class="f-label"><span class="req">*</span>Years of experience</label><select class="f-inp"><option>Less than 1 year</option><option>1–3 years</option><option>3–5 years</option><option>5–10 years</option><option>More than 10 years</option></select></div>
                    <div class="f-group f-full"><label class="f-label">Certifications &amp; Qualifications</label><textarea class="f-inp" placeholder="Bachelor of Veterinary Medicine, certifications..."></textarea></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🗓 Work Schedule</div>
                <div class="f-group">
                    <label class="f-label">Working Days</label>
                    <div class="days-row">
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Sunday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Monday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Tuesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Wednesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Thursday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Friday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Saturday</div>
                    </div>
                </div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Start time</label><input class="f-inp" type="time" value="09:00"></div>
                    <div class="f-group"><label class="f-label">End time</label><input class="f-inp" type="time" value="17:00"></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalDoctor')">Cancel</button><button class="btn btn-primary">💾 Add Doctor</button></div>
        </div>
    </div>

    <!-- Modal: Edit Doctor -->
    <div class="modal-overlay" id="modalDoctorEdit" onclick="closeOnBg(event,'modalDoctorEdit')">
        <div class="modal modal-wide">
            <div class="modal-header"><div class="modal-title">✏️ Edit Doctor Information</div><button class="modal-close" onclick="closeModal('modalDoctorEdit')">✕</button></div>
            <div class="modal-body">
                <div class="sec-label">👤 Personal Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Doctor Name</label><input class="f-inp" value="Dr. Ahmad Al-Zoubi"></div>
                    <div class="f-group"><label class="f-label">Phone Number</label><input class="f-inp" value="0791234567"></div>
                    <div class="f-group f-full"><label class="f-label">Email Address</label><input class="f-inp" value="ahmed@clinic.jo"></div>
                    <div class="f-group f-full"><div class="upload-box"><div class="upload-icon">👤</div><div class="upload-txt">Change profile image</div><div class="upload-sub">JPG, PNG — max 3MB</div></div></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🎓 Professional Information</div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Specialty</label><select class="f-inp"><option selected>Veterinary Surgery</option><option>General Veterinary Medicine</option><option>Dermatology</option></select></div>
                    <div class="f-group"><label class="f-label">Years of experience</label><select class="f-inp"><option>5–10 years</option><option selected>More than 10 years</option></select></div>
                    <div class="f-group f-full"><label class="f-label">Certifications</label><textarea class="f-inp">Bachelor of Veterinary Medicine — University of Jordan, Advanced Surgery Certificate</textarea></div>
                </div>
                <hr class="sec-div"><div class="sec-label">🗓 Work Schedule</div>
                <div class="f-group">
                    <label class="f-label">Working Days</label>
                    <div class="days-row">
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Sunday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Monday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Tuesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Wednesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Thursday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Friday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Saturday</div>
                    </div>
                </div>
                <div class="f-grid">
                    <div class="f-group"><label class="f-label">Start time</label><input class="f-inp" type="time" value="09:00"></div>
                    <div class="f-group"><label class="f-label">End time</label><input class="f-inp" type="time" value="17:00"></div>
                </div>
                <hr class="sec-div"><div class="sec-label" style="color:var(--red)">⚠️ Actions</div>
                <div style="display:flex;gap:8px">
                    <button class="btn btn-outline btn-sm" style="color:var(--ora);border-color:var(--ora)">🔒 Temporarily suspend account</button>
                    <button class="btn btn-red btn-sm">🗑 Remove from Clinic</button>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalDoctorEdit')">Cancel</button><button class="btn btn-primary">💾 Save Changes</button></div>
        </div>
    </div>

    <!-- Modal: Adoption Pet -->
    <div class="modal-overlay" id="adoptionPetModal">
        <div class="modal">
            <div class="modal-header"><div class="modal-title" id="adoptionPetModalTitle">🐾 Pet Details</div><button class="modal-close" onclick="closeModal('adoptionPetModal')">✕</button></div>
            <div class="modal-body" id="adoptionPetModalBody"></div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('adoptionPetModal')">Close</button></div>
        </div>
    </div>

    <!-- Modal: Invite Doctor -->
    <div class="modal-overlay" id="modalInvite" onclick="closeOnBg(event,'modalInvite')">
        <div class="modal">
            <div class="modal-header"><div class="modal-title">📨 Send Invite Code for a Doctor</div><button class="modal-close" onclick="closeModal('modalInvite')">✕</button></div>
            <div class="modal-body">
                <div style="background:linear-gradient(135deg,var(--gp),var(--gu));border-radius:12px;padding:1.2rem;text-align:center;margin-bottom:1.2rem">
                    <div style="font-size:2rem;margin-bottom:8px">🔑</div>
                    <div style="font-size:1.8rem;font-weight:800;color:var(--gd);letter-spacing:3px">WAFFY-DR-4X9K</div>
                    <div style="font-size:.78rem;color:var(--muted);margin-top:6px">Invite code — valid for 7 days</div>
                </div>
                <div class="f-group"><label class="f-label">Invited Doctor Name</label><input class="f-inp" placeholder="Dr. Full Name"></div>
                <div class="f-group"><label class="f-label">Send to</label><input class="f-inp" type="email" placeholder="doctor@email.com"></div>
                <div class="f-group">
                    <label class="f-label">Delivery method</label>
                    <div style="display:flex;gap:8px;margin-top:6px">
                        <button class="btn btn-outline btn-sm">📧 Email</button>
                        <button class="btn btn-outline btn-sm">📱 WhatsApp</button>
                        <button class="btn btn-outline btn-sm">📋 Copy code</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeModal('modalInvite')">Close</button><button class="btn btn-primary">📨 Send Invite</button></div>
        </div>
    </div>

    <script src="~/js/AdminClinicDoctor.js"></script>
</body>
</html>
