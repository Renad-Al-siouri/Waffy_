@{
    ViewData["Title"] = "Waffy — Clinic Images";
    Layout = null;

    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";

    var logoUrl = ViewBag.LogoUrl as string;
    var coverImageUrl = ViewBag.CoverImageUrl as string;

    // ✅ الجديد
    var gallery = ViewBag.GalleryImages as List<Waffy.Models.ClinicImage>
                  ?? new List<Waffy.Models.ClinicImage>();
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <link rel="stylesheet" href="~/css/clinic-setting.css">
    <style>
        .img-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .img-thumb {
            height: 80px;
            background: linear-gradient(135deg, var(--gp), var(--gu));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            border: 1px solid var(--b2);
            position: relative;
            overflow: hidden;
        }

            .img-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 8px;
            }

            .img-thumb .img-remove {
                position: absolute;
                top: 4px;
                right: 4px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: rgba(200,106,92,.88);
                color: #fff;
                font-size: .7rem;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                opacity: 0;
                transition: opacity .2s;
                border: none;
            }

            .img-thumb:hover .img-remove {
                opacity: 1;
            }

        .img-add-box {
            height: 80px;
            border: 2px dashed var(--b2);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            gap: 2px;
            background: var(--gu);
            transition: .2s ease;
        }

            .img-add-box:hover {
                border-color: var(--gm);
                background: var(--gp);
            }

        .img-add-label {
            font-size: .7rem;
            font-weight: 800;
            color: var(--muted);
        }

        .img-add-icon {
            font-size: 1.2rem;
            color: var(--muted);
        }

        @@media (max-width: 768px) {
            .img-grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media (max-width: 420px) {
            .img-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }
    </style>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        <!-- ── Sidebar ── -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Basic_Information">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation">
                        <span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@userInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@sessionUserName</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
                    <span class="sb-icon">↩</span>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread">
                <span>Clinic Management</span><span>/</span><b>Clinic Settings</b>
            </div>
            <div class="tn-center">
                <div class="tn-center-main">Clinic Settings</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">
            <section class="page-hero">
                <div>
                    <h1>Clinic Settings</h1>
                    <p>Manage your clinic logo, cover image, and gallery photos.</p>
                </div>
            </section>

            <div class="page-body">

                @if (TempData["ImgSuccess"] != null)
                {
                    <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                        ✅ @TempData["ImgSuccess"]
                    </div>
                }
                @if (TempData["ImgError"] != null)
                {
                    <div style="background:#faece8;border:1px solid rgba(200,106,92,.3);border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#c86a5c;">
                        ⚠️ @TempData["ImgError"]
                    </div>
                }

                <nav class="tabs cs-tab-nav">
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Basic_Information">📋 Basic Information</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Working_Hours">⏰ Working Hours</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Services">🩺 Services</a>
                    <a class="tab" asp-controller="ClinicAdmin" asp-action="Documents_C">📄 Documents</a>
                    <a class="tab active" asp-controller="ClinicAdmin" asp-action="Images">🖼 Images</a>
                </nav>

                <!-- ── Logo ── -->
                <div class="chart-card mb">
                    <div class="sec-label">Clinic Logo</div>

                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <div style="margin-bottom:10px;">
                            <img src="@logoUrl" alt="Current Logo"
                                 style="width:82px;height:82px;object-fit:contain;
                                            border-radius:16px;border:1px solid rgba(151,173,77,.28);">
                            <div style="font-size:.75rem;color:var(--muted);margin-top:4px;">
                                Current logo
                            </div>
                        </div>
                    }

                    <form asp-controller="ClinicAdmin" asp-action="UploadLogo"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <label class="upload-box" style="cursor:pointer;display:block">
                            <input type="file" name="file" accept="image/*"
                                   style="display:none" onchange="this.form.submit()">
                            <div class="upload-icon">🎨</div>
                            <div class="upload-txt">
                                @(string.IsNullOrEmpty(logoUrl) ? "Upload Logo" : "Change Logo")
                            </div>
                            <div class="upload-sub">PNG preferred — max 2MB</div>
                        </label>
                    </form>
                </div>

                <!-- ── Cover Image ── -->
                <div class="chart-card mb">
                    <div class="sec-label">Cover Image</div>

                    @if (!string.IsNullOrEmpty(coverImageUrl))
                    {
                        <div style="margin-bottom:10px;">
                            <img src="@coverImageUrl" alt="Cover Image"
                                 style="width:100%;max-height:160px;object-fit:cover;
                                            border-radius:10px;border:1px solid var(--b2);">
                            <div style="font-size:.75rem;color:var(--muted);margin-top:4px;">
                                Current cover
                            </div>
                        </div>
                    }

                    <form asp-controller="ClinicAdmin" asp-action="UploadCover"
                          method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <label class="upload-box" style="cursor:pointer;display:block">
                            <input type="file" name="file" accept="image/*"
                                   style="display:none" onchange="this.form.submit()">
                            <div class="upload-icon">🖼</div>
                            <div class="upload-txt">
                                @(string.IsNullOrEmpty(coverImageUrl) ? "Upload Cover Image" : "Change Cover Image")
                            </div>
                            <div class="upload-sub">JPG, PNG — max 5MB</div>
                        </label>
                    </form>
                </div>

                <!-- ── Gallery ── -->
                <div class="chart-card">
                    <div class="sec-label">
                        Gallery Images
                        <span style="font-size:.75rem;color:var(--muted);font-weight:700;">
                            (@gallery.Count / 8)
                        </span>
                    </div>

                    <div class="img-grid">
                        @foreach (var img in gallery)
                        {
                            <div class="img-thumb">
                                <img src="@img.ImageUrl" alt="Gallery image">
                                @* ✅ Delete button — Gallery يُسمح بالحذف *@
                                <form asp-controller="ClinicAdmin"
                                      asp-action="DeleteGalleryImage"
                                      method="post" style="margin:0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@img.Id">
                                    <button type="submit" class="img-remove"
                                            title="Remove"
                                            onclick="return confirm('Remove this image?')">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        }

                        @* ✅ Add slot — يظهر فقط لو أقل من 8 *@
                        @if (gallery.Count < 8)
                        {
                            <form asp-controller="ClinicAdmin" asp-action="UploadGalleryImage"
                                  method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <label class="img-add-box" style="cursor:pointer;display:flex">
                                    <input type="file" name="file" accept="image/*"
                                           style="display:none" onchange="this.form.submit()">
                                    <span class="img-add-icon">+</span>
                                    <span class="img-add-label">Add</span>
                                </label>
                            </form>
                        }
                    </div>

                    <div class="f-hint" style="margin-top:8px;">
                        JPG, PNG — max 2MB each · Hover to remove
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }
        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>