@model Waffy.Models.ViewModels.ServicesViewModel
@{
    ViewData["Title"] = "Waffy — Clinic Services";
    Layout = null;

    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";

    var allServices = new[]
    {
        ("💉 Vaccinations",   "Vaccinations"),
        ("🔬 General checkup","General checkup"),
        ("🔪 Surgery",        "Surgery"),
        ("🦷 Dentistry",      "Dentistry"),
        ("🧪 Lab Tests",      "Lab Tests"),
        ("📷 X-Ray",          "X-Ray"),
        ("✂️ Grooming",       "Grooming"),
        ("🏠 Home Visit",     "Home Visit"),
        ("🚨 Emergency",      "Emergency")
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <link rel="stylesheet" href="~/css/clinic-setting.css">
    <style>
        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .service-chip {
            padding: 10px;
            text-align: center;
            border-radius: 10px;
            border: 1.5px solid var(--b2);
            background: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .82rem;
            font-weight: 800;
            color: var(--muted);
            cursor: pointer;
            transition: .2s ease;
            user-select: none;
        }

            .service-chip.on,
            .service-chip:hover {
                background: var(--gd);
                color: #fff;
                border-color: var(--gd);
            }

        @@media (max-width: 540px) {
            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        <!-- ── Sidebar ── -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Basic_Information">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation">
                        <span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@userInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@sessionUserName</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
                    <span class="sb-icon">↩</span>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread">
                <span>Clinic Management</span><span>/</span><b>Clinic Settings</b>
            </div>
            <div class="tn-center">
                <div class="tn-center-main">Clinic Settings</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">

            <form asp-controller="ClinicAdmin" asp-action="Services" method="post">
                @Html.AntiForgeryToken()

                <section class="page-hero">
                    <div>
                        <h1>Clinic Settings</h1>
                        <p>Update clinic profile, working hours, and operational preferences.</p>
                    </div>
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </section>

                <div class="page-body">

                    @if (TempData["SaveSuccess"] != null)
                    {
                        <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                        padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                            ✅ @TempData["SaveSuccess"]
                        </div>
                    }

                    <nav class="tabs cs-tab-nav">
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Basic_Information">📋 Basic Information</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Working_Hours">⏰ Working Hours</a>
                        <a class="tab active" asp-controller="ClinicAdmin" asp-action="Services">🩺 Services</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Documents_C">📄 Documents</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Images">🖼 Images</a>
                    </nav>

                    <div class="chart-card">
                        <div class="sec-label">Available services (select all that apply)</div>

                        <div class="services-grid">
                            @foreach (var (label, value) in allServices)
                            {
                                var isOn = Model.SelectedServices.Contains(value);
                                <label class="service-chip @(isOn ? "on" : "")">
                                    <input type="checkbox"
                                           name="SelectedServices"
                                           value="@value"
                                           @(isOn ? "checked" : "")
                                           style="display:none"
                                           onchange="this.closest('.service-chip').classList.toggle('on', this.checked)">
                                    @label
                                </label>
                            }
                        </div>
                    </div>

                </div>
            </form>

        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }
        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>