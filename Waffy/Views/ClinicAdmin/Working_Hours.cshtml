@model Waffy.Models.ViewModels.WorkingHoursViewModel
@{
    ViewData["Title"] = "Waffy — Working Hours";
   

    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <link rel="stylesheet" href="~/css/clinic-setting.css">
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        @await Html.PartialAsync("~/Views/ClinicAdmin/_ClinicAdminSidebar.cshtml")


        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread">
                <span>Clinic Management</span><span>/</span><b>Clinic Settings</b>
            </div>
            <div class="tn-center">
                <div class="tn-center-main">Clinic Settings</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">

            <form asp-controller="ClinicAdmin" asp-action="Working_Hours" method="post">
                @Html.AntiForgeryToken()

                <section class="page-hero">
                    <div>
                        <h1>Clinic Settings</h1>
                        <p>Update clinic profile, working hours, and operational preferences.</p>
                    </div>
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </section>

                <div class="page-body">

                    @if (TempData["SaveSuccess"] != null)
                    {
                        <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                        padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                            ✅ @TempData["SaveSuccess"]
                        </div>
                    }

                    <!-- Tab navigation -->
                    <nav class="tabs cs-tab-nav">
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Basic_Information">📋 Basic Information</a>
                        <a class="tab active" asp-controller="ClinicAdmin" asp-action="Working_Hours">⏰ Working Hours</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Services">🩺 Services</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Documents_C">📄 Documents</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Images">🖼 Images</a>
                    </nav>

                    <div class="chart-card">

                        <!-- ✅ Working Days -->
                        <div class="sec-label">Working Days</div>
                        <div class="days-row mb">

                            @{
                                var dayDefs = new[]
                                {
                                                        ("Sunday",    Model.Sunday),
                                                        ("Monday",    Model.Monday),
                                                        ("Tuesday",   Model.Tuesday),
                                                        ("Wednesday", Model.Wednesday),
                                                        ("Thursday",  Model.Thursday),
                                                        ("Friday",    Model.Friday),
                                                        ("Saturday",  Model.Saturday)
                                                        };
                            }

                            @foreach (var (dayName, isOn) in dayDefs)
                            {
                                <label class="day-chip @(isOn ? "on" : "")" id="chip-@dayName">
                                    <input type="checkbox"
                                           name="@dayName"
                                           value="true"
                                           @(isOn ? "checked" : "")
                                           style="display:none"
                                           onchange="this.closest('.day-chip').classList.toggle('on', this.checked)">
                                    @dayName
                                </label>
                            }

                        </div>

                        <!-- ✅ Hours -->
                        <div class="f-grid">
                            <div class="f-group">
                                <label class="f-label">Opening time</label>
                                <input asp-for="OpenTime" class="f-inp" type="time">
                            </div>
                            <div class="f-group">
                                <label class="f-label">Closing time</label>
                                <input asp-for="CloseTime" class="f-inp" type="time">
                            </div>
                        </div>

                        <!-- ✅ Emergency -->
                        <div style="display:flex;align-items:center;justify-content:space-between;
                                    padding:12px 0;border-top:1px solid var(--b);margin-top:8px">
                            <div>
                                <div style="font-weight:700;font-size:.88rem">
                                    🚨 Emergency service outside working hours
                                </div>
                                <div style="font-size:.75rem;color:var(--muted)">
                                    Available for urgent cases
                                </div>
                            </div>
                            <label id="emergencyLabel"
                                   class="btn @(Model.HasEmergency ? "btn-primary" : "btn-outline") btn-sm"
                                   style="cursor:pointer;min-width:80px;text-align:center">
                                <input type="checkbox"
                                       asp-for="HasEmergency"
                                       style="display:none"
                                       onchange="
                                           var lbl = document.getElementById('emergencyLabel');
                                           var sp  = document.getElementById('emergencyText');
                                           if(this.checked){
                                               lbl.classList.remove('btn-outline');
                                               lbl.classList.add('btn-primary');
                                               sp.textContent = 'Disable';
                                           } else {
                                               lbl.classList.remove('btn-primary');
                                               lbl.classList.add('btn-outline');
                                               sp.textContent = 'Enable';
                                           }">
                                <span id="emergencyText">
                                    @(Model.HasEmergency ? "Disable" : "Enable")
                                </span>
                            </label>
                        </div>

                    </div>
                </div>
            </form>

        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }

        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>