@model Waffy.Models.ViewModels.ClinicPatientsViewModel
@{
    ViewData["Title"] = "Waffy — Patients";
    Layout = null;
    var userName   = Context.Session.GetString("UserName")   ?? "Clinic Manager";
    var clinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var initials   = userName.Length > 0 ? userName[0].ToString().ToUpper() : "C";

    string VaccBadge(string? status) => status?.ToLower() switch {
        "uptodate"       => "<span class='vacc-chip vacc-ok'>✅ Up to Date</span>",
        "partial"        => "<span class='vacc-chip vacc-warn'>⚠️ Partial</span>",
        "notvaccinated"  => "<span class='vacc-chip vacc-err'>❌ Not Vaccinated</span>",
        _                => "<span class='vacc-chip vacc-unk'>❓ Unknown</span>"
    };

    string PetEmoji(string? s) => s?.ToLower() switch {
        "dog"    => "🐕","cat"  => "🐈","bird"   => "🐦",
        "rabbit" => "🐇","fish" => "🐠","hamster" => "🐹",
        _ => "🐾"
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>@ViewData["Title"]</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
<link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
<style>
/* ── KPI ── */
.pat-kpi { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:18px; }
.pat-kpi-card { background:var(--ws); border-radius:16px; border:1px solid var(--line); padding:1rem 1.2rem; display:flex; align-items:center; gap:14px; }
.pat-kpi-icon { font-size:1.6rem; }
.pat-kpi-val  { font-family:'Fredoka',sans-serif; font-size:1.6rem; font-weight:700; color:var(--gd); line-height:1; }
.pat-kpi-lbl  { font-size:.72rem; color:var(--muted); font-weight:700; margin-top:2px; }

/* ── Filter bar ── */
.pat-filter { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
.pat-search  { position:relative; flex:1; min-width:180px; max-width:300px; }
.pat-search input { width:100%; padding:8px 12px 8px 32px; border:1.5px solid var(--line); border-radius:10px; background:var(--ws); font-family:'Nunito',sans-serif; font-size:.84rem; font-weight:700; outline:none; box-sizing:border-box; }
.pat-search input:focus { border-color:var(--gd); }
.pat-search .s-ico { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none; }
.pat-chip { padding:6px 14px; border-radius:10px; border:1.5px solid var(--line); background:var(--ws); font-size:.82rem; font-weight:800; color:var(--muted); cursor:pointer; transition:.15s; }
.pat-chip:hover, .pat-chip.active { border-color:var(--gd); background:var(--gp); color:var(--gd); }
.pat-chip-warn { border-color:#e07b3c!important; color:#e07b3c!important; background:#fef0e6!important; }
.pat-chip-warn.active { background:#e07b3c!important; color:#fff!important; }

/* ── Grid cards ── */
.pat-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
.pat-card  { background:var(--ws); border-radius:16px; border:1px solid var(--line); overflow:hidden; transition:box-shadow .2s, transform .2s; cursor:pointer; }
.pat-card:hover { box-shadow:0 6px 20px rgba(90,101,42,.14); transform:translateY(-2px); }
.pat-card-top  { display:flex; align-items:center; gap:12px; padding:14px 14px 10px; }
.pat-avatar    { width:52px; height:52px; border-radius:12px; overflow:hidden; flex-shrink:0; background:var(--gp); border:2px solid var(--b2); display:flex; align-items:center; justify-content:center; font-size:1.5rem; }
.pat-avatar img { width:100%; height:100%; object-fit:cover; }
.pat-name  { font-family:'Fredoka',sans-serif; font-size:1rem; font-weight:700; color:var(--gd); line-height:1.2; }
.pat-breed { font-size:.74rem; color:var(--muted); font-weight:700; }
.pat-card-body { padding:0 14px 12px; }
.pat-info-row  { display:flex; justify-content:space-between; font-size:.78rem; padding:3px 0; border-bottom:.5px solid var(--line); }
.pat-info-row:last-of-type { border-bottom:none; }
.pat-info-lbl { color:var(--muted); font-weight:700; }
.pat-info-val { font-weight:800; color:var(--text); }
.pat-card-foot { padding:10px 14px; background:var(--gp); border-top:1px solid var(--b2); display:flex; justify-content:space-between; align-items:center; }

/* ── Vaccination chips ── */
.vacc-chip { display:inline-block; border-radius:999px; padding:2px 8px; font-size:.68rem; font-weight:800; }
.vacc-ok   { background:#eef4dd; color:#5f7430; border:1px solid #c3d9a0; }
.vacc-warn { background:#fff3e0; color:#e07b3c; border:1px solid #ffcc80; }
.vacc-err  { background:#fde8e8; color:#c0392b; border:1px solid #f5b8b8; }
.vacc-unk  { background:#f5f5f5; color:#888;    border:1px solid #ddd; }

/* ── Patient Modal ── */
.pat-modal { max-width:600px; max-height:90vh; display:flex; flex-direction:column; overflow:hidden; }
.pat-modal .modal-body { overflow-y:auto; flex:1; padding:0; }
.pm-hero { display:flex; gap:16px; align-items:center; padding:1.2rem; background:var(--gp); border-bottom:1px solid var(--b2); }
.pm-img  { width:72px; height:72px; border-radius:14px; overflow:hidden; flex-shrink:0; background:var(--ws); border:2px solid var(--b2); display:flex; align-items:center; justify-content:center; font-size:2rem; }
.pm-img img { width:100%; height:100%; object-fit:cover; }
.pm-name  { font-family:'Fredoka',sans-serif; font-size:1.15rem; font-weight:700; color:var(--gd); }
.pm-breed { font-size:.78rem; color:#5f7430; font-weight:700; margin-top:2px; }
.pm-sec   { padding:.8rem 1.2rem; }
.pm-sec-title { font-family:'Fredoka',sans-serif; font-size:.84rem; font-weight:700; color:var(--gd); margin-bottom:8px; }
.pm-row   { display:flex; gap:8px; padding:4px 0; border-bottom:.5px solid var(--line); font-size:.82rem; }
.pm-row:last-child { border-bottom:none; }
.pm-lbl   { width:120px; color:var(--muted); font-weight:700; flex-shrink:0; }
.pm-val   { font-weight:800; color:var(--text); flex:1; }
.pm-grid  { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:10px; }
.pm-stat  { background:var(--ws); border-radius:10px; padding:8px 10px; border:1px solid var(--line); }
.pm-stat-lbl { font-size:.66rem; color:var(--muted); font-weight:700; margin-bottom:2px; }
.pm-stat-val { font-size:.86rem; font-weight:800; color:var(--text); }

/* ── Visit History ── */
.visit-timeline { padding:.8rem 1.2rem 1rem; border-top:1px solid var(--line); }
.vt-item  { position:relative; padding-left:20px; margin-bottom:12px; }
.vt-item::before { content:''; position:absolute; left:5px; top:0; bottom:-12px; width:2px; background:var(--b2); }
.vt-item:last-child::before { display:none; }
.vt-dot   { position:absolute; left:0; top:4px; width:12px; height:12px; border-radius:50%; background:var(--gd); border:2px solid var(--ws); box-shadow:0 0 0 2px var(--b2); }
.vt-date  { font-size:.72rem; font-weight:900; color:var(--gd); }
.vt-doc   { font-size:.75rem; color:var(--muted); font-weight:700; }
.vt-note  { background:var(--gp); border-radius:8px; padding:6px 10px; margin-top:5px; font-size:.78rem; font-weight:700; color:#3d4a2d; line-height:1.6; white-space:pre-line; border:1px solid var(--b2); }
.vt-empty { text-align:center; padding:1rem; color:var(--muted); font-size:.82rem; font-weight:700; }

/* ── Behavior chips ── */
.behav-chips { display:flex; gap:5px; flex-wrap:wrap; margin-top:5px; }
.behav-chip  { background:var(--gp); border:1px solid var(--b2); border-radius:999px; padding:2px 9px; font-size:.7rem; font-weight:800; color:var(--gd); }

/* ── Medical notes block ── */
.med-notes-block { background:linear-gradient(135deg,var(--gp),#f0f7e0); border:1px solid var(--b2); border-radius:10px; padding:10px 12px; font-size:.8rem; font-weight:700; color:#3d4a2d; line-height:1.7; white-space:pre-line; }

/* ── Responsive ── */
@@media(max-width:768px) {
    .pat-kpi { grid-template-columns:1fr 1fr; }
    .pat-kpi-card:last-child { grid-column:span 2; }
    .pat-grid { grid-template-columns:1fr; }
    .pm-grid  { grid-template-columns:1fr; }
}
@@media(max-width:480px) {
    .pat-kpi { grid-template-columns:1fr; }
    .pat-kpi-card:last-child { grid-column:span 1; }
    .pm-hero { flex-direction:column; text-align:center; }
}
</style>
</head>
<body class="admin-shell">
<div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<div class="wa-shell" id="waShell">

<aside class="wa-sb" id="sidebar">
    <div class="sb-logo">
        <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
        <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Clinic Admin</div></div>
    </div>
    <nav class="sb-nav">
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard"><span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Daily Management</div>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments"><span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span></a>
            <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Patients"><span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records"><span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Clinic Management</div>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors"><span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Basic_Information"><span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue"><span class="sb-icon">💰</span><span class="sb-lbl">Revenue</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption"><span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Analytics</div>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews"><span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports"><span class="sb-icon">📈</span><span class="sb-lbl">Reports</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation"><span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span></a>
        </div>
    </nav>
    <div class="sb-foot">
        <div class="sb-user-row">
            <div class="sb-av">@initials</div>
            <div class="sb-user-info">
                <div class="sb-user-name">@userName</div>
                <div class="sb-user-role">Clinic Manager 👑</div>
            </div>
        </div>
        <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
            <span class="sb-icon">↩</span><span class="sb-logout-lbl">Sign Out</span>
        </a>
    </div>
</aside>

<header class="wa-tn">
    <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
    <div class="tn-bread"><span>Daily Management</span><span>/</span><b>Patients</b></div>
    <div class="tn-center">
        <div class="tn-center-main">Patients</div>
        <div class="tn-center-sub">@clinicName</div>
    </div>
    <div class="tn-spacer"></div>
    <div class="tn-right">
        <div class="tn-identity">🏥 @clinicName</div>
        <button class="tn-btn notif-btn" type="button">🔔</button>
        <div class="tn-sep"></div>
        <div class="tn-profile">
            <div class="tn-av">@initials</div>
            <div><div class="tn-pname">@userName</div><div class="tn-prole">Clinic Manager 👑</div></div>
        </div>
    </div>
</header>

<main class="wa-main">
<section class="page-hero">
    <div><h1>Patients</h1><p>Registered pets and their medical records.</p></div>
</section>
<div class="page-body">

    @if (!Model.Patients.Any())
    {
        <div style="text-align:center;padding:4rem;color:var(--muted);">
            <div style="font-size:3rem;margin-bottom:12px;">🐾</div>
            <div style="font-weight:800;font-size:1rem;">No patients yet</div>
            <div style="font-size:.86rem;margin-top:6px;">Patients appear here after their first completed appointment.</div>
        </div>
    }
    else
    {
        <!-- KPIs -->
        <div class="pat-kpi">
            <div class="pat-kpi-card">
                <div class="pat-kpi-icon">🐾</div>
                <div>
                    <div class="pat-kpi-val">@Model.TotalPatients</div>
                    <div class="pat-kpi-lbl">Total Patients</div>
                </div>
            </div>
            <div class="pat-kpi-card">
                <div class="pat-kpi-icon">💉</div>
                <div>
                    <div class="pat-kpi-val" style="color:#e07b3c;">@Model.PatientsWithExpiredVacc</div>
                    <div class="pat-kpi-lbl">Vaccination Due / Expired</div>
                </div>
            </div>
            <div class="pat-kpi-card">
                <div class="pat-kpi-icon">📅</div>
                <div>
                    <div class="pat-kpi-val" style="color:#5f7430;">@Model.PatientsVisitedThisMonth</div>
                    <div class="pat-kpi-lbl">Visited This Month</div>
                </div>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="pat-filter">
            <div class="pat-search">
                <span class="s-ico">🔍</span>
                <input id="patSearch" placeholder="Search by pet name or owner..." oninput="filterPatients()">
            </div>
            <select id="speciesFilter" class="doc-sel" onchange="filterPatients()"
                    style="padding:8px 12px;border:1.5px solid var(--line);border-radius:10px;
                           background:var(--ws);font-family:'Nunito',sans-serif;font-size:.84rem;
                           font-weight:700;color:var(--text);outline:none;cursor:pointer;">
                <option value="">All Species</option>
                <option value="dog">🐕 Dogs</option>
                <option value="cat">🐈 Cats</option>
                <option value="bird">🐦 Birds</option>
                <option value="rabbit">🐇 Rabbits</option>
            </select>
            <button class="pat-chip active" data-filter="all" onclick="setFilter(this,'all')">All</button>
            <button class="pat-chip pat-chip-warn" data-filter="vacc" onclick="setFilter(this,'vacc')">⚠️ Vaccination Due</button>
            <span style="margin-left:auto;font-size:.78rem;font-weight:700;color:var(--muted);" id="patCount">
                @Model.Patients.Count patient(s)
            </span>
        </div>

        <!-- Patient Cards Grid -->
        <div class="pat-grid" id="patGrid">
            @foreach (var p in Model.Patients)
            {
                var vaccExpired = p.VaccinationStatus is "NotVaccinated" or "Partial" or null;
                <div class="pat-card"
                     data-name="@(p.PetName.ToLower())"
                     data-owner="@(p.OwnerName.ToLower())"
                     data-species="@(p.Species?.ToLower() ?? "")"
                     data-vacc="@(vaccExpired ? "due" : "ok")"
                     onclick="openPatient(@p.IdPet)">

                    <div class="pat-card-top">
                        <div class="pat-avatar">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            { <img src="@p.ImageUrl" alt="@p.PetName"> }
                            else
                            { @PetEmoji(p.Species) }
                        </div>
                        <div>
                            <div class="pat-name">@p.PetName</div>
                            <div class="pat-breed">
                                @p.Species @if (!string.IsNullOrEmpty(p.Breed)) {<text>· @p.Breed</text>}
                            </div>
                            <div style="margin-top:4px;">
                                @Html.Raw(VaccBadge(p.VaccinationStatus))
                            </div>
                        </div>
                    </div>

                    <div class="pat-card-body">
                        <div class="pat-info-row">
                            <span class="pat-info-lbl">👤 Owner</span>
                            <span class="pat-info-val">@p.OwnerName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(p.OwnerPhone))
                        {
                            <div class="pat-info-row">
                                <span class="pat-info-lbl">📱 Phone</span>
                                <span class="pat-info-val">@p.OwnerPhone</span>
                            </div>
                        }
                        <div class="pat-info-row">
                            <span class="pat-info-lbl">🎂 Age</span>
                            <span class="pat-info-val">@p.AgeDisplay</span>
                        </div>
                        <div class="pat-info-row">
                            <span class="pat-info-lbl">📅 Last Visit</span>
                            <span class="pat-info-val">
                                @(p.LastVisitDate.HasValue
                                    ? p.LastVisitDate.Value.ToString("dd MMM yyyy")
                                    : "—")
                            </span>
                        </div>
                        <div class="pat-info-row">
                            <span class="pat-info-lbl">🏥 Visits</span>
                            <span class="pat-info-val">@p.TotalVisits visit(s)</span>
                        </div>
                    </div>

                    <div class="pat-card-foot">
                        <span style="font-size:.72rem;color:var(--muted);font-weight:700;">
                            Since @p.FirstSeen.ToString("MMM yyyy")
                        </span>
                        <button type="button" class="btn btn-primary btn-sm"
                                onclick="event.stopPropagation();openPatient(@p.IdPet)">
                            📋 View Record
                        </button>
                    </div>
                </div>
            }
        </div>
    }

</div>
</main>
</div>

<!-- ═══════════════════════════════
     PATIENT DETAILS MODAL
═══════════════════════════════ -->
<div class="modal-overlay" id="patientModal">
<div class="modal pat-modal">
    <div class="modal-header">
        <div class="modal-title" id="pmTitle">🐾 Patient Record</div>
        <button class="modal-close" type="button" onclick="closeModal('patientModal')">✕</button>
    </div>
    <div class="modal-body">

        <!-- Hero -->
        <div class="pm-hero">
            <div class="pm-img" id="pmImg">🐾</div>
            <div>
                <div class="pm-name" id="pmName">—</div>
                <div class="pm-breed" id="pmBreed">—</div>
                <div id="pmVacc" style="margin-top:5px;"></div>
            </div>
        </div>

        <!-- Tabs -->
        <div style="display:flex;border-bottom:1.5px solid var(--line);">
            <button class="pm-tab active" data-tab="info" onclick="switchTab(this,'info')"
                    style="flex:1;padding:10px;border:none;background:none;font-family:'Nunito',sans-serif;
                           font-size:.84rem;font-weight:800;color:var(--gd);cursor:pointer;border-bottom:2.5px solid var(--gd);">
                📋 Info
            </button>
            <button class="pm-tab" data-tab="medical" onclick="switchTab(this,'medical')"
                    style="flex:1;padding:10px;border:none;background:none;font-family:'Nunito',sans-serif;
                           font-size:.84rem;font-weight:800;color:var(--muted);cursor:pointer;">
                🩺 Medical
            </button>
            <button class="pm-tab" data-tab="history" onclick="switchTab(this,'history')"
                    style="flex:1;padding:10px;border:none;background:none;font-family:'Nunito',sans-serif;
                           font-size:.84rem;font-weight:800;color:var(--muted);cursor:pointer;">
                📅 Visit History
            </button>
        </div>

        <!-- Tab: Info -->
        <div id="tab-info" class="tab-content">
            <div class="pm-sec">
                <div class="pm-sec-title">🐾 Pet Details</div>
                <div class="pm-grid">
                    <div class="pm-stat"><div class="pm-stat-lbl">Species</div><div class="pm-stat-val" id="pmSpecies">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">Breed</div><div class="pm-stat-val" id="pmBreedVal">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">Gender</div><div class="pm-stat-val" id="pmGender">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">Age</div><div class="pm-stat-val" id="pmAge">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">Color</div><div class="pm-stat-val" id="pmColor">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">Weight</div><div class="pm-stat-val" id="pmWeight">—</div></div>
                </div>
                <div class="pm-row">
                    <div class="pm-lbl">🔖 Microchip</div>
                    <div class="pm-val" id="pmMicrochip">—</div>
                </div>
            </div>
            <div class="pm-sec" style="border-top:1px solid var(--line);">
                <div class="pm-sec-title">👤 Owner</div>
                <div class="pm-row"><div class="pm-lbl">Name</div><div class="pm-val" id="pmOwner">—</div></div>
                <div class="pm-row"><div class="pm-lbl">Phone</div><div class="pm-val" id="pmPhone">—</div></div>
            </div>

            
            <div class="pm-sec" style="border-top:1px solid var(--line);">
                <div class="pm-sec-title">📊 Visit Summary</div>
                <div class="pm-row"><div class="pm-lbl">First Seen</div><div class="pm-val" id="pmFirstSeen">—</div></div>
                <div class="pm-row"><div class="pm-lbl">Last Visit</div><div class="pm-val" id="pmLastVisit">—</div></div>
                <div class="pm-row"><div class="pm-lbl">Total Visits</div><div class="pm-val" id="pmTotalVisits">—</div></div>
            </div>
        </div>

        <!-- Tab: Medical -->
        <div id="tab-medical" class="tab-content" style="display:none;">
            <div class="pm-sec">
                <div class="pm-sec-title">🩺 Medical Status</div>
                <div class="pm-grid">
                    <div class="pm-stat"><div class="pm-stat-lbl">💉 Vaccination</div><div class="pm-stat-val" id="pmVaccText">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">✂️ Neutered</div><div class="pm-stat-val" id="pmNeutered">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">⚡ Energy</div><div class="pm-stat-val" id="pmEnergy">—</div></div>
                    <div class="pm-stat"><div class="pm-stat-lbl">⚖️ Weight</div><div class="pm-stat-val" id="pmWeightMed">—</div></div>
                </div>
                <div id="pmBehavior" class="behav-chips" style="margin-bottom:10px;"></div>
            </div>
            <div id="pmMedNotesSection" class="pm-sec" style="border-top:1px solid var(--line);display:none;">
                <div class="pm-sec-title">📋 Medical Notes</div>
                <div class="med-notes-block" id="pmMedNotes"></div>
                <div style="font-size:.7rem;color:var(--muted);font-weight:700;margin-top:6px;">
                    💡 Last updated by the treating doctor
                </div>
            </div>
        </div>

        <!-- Tab: Visit History -->
        <div id="tab-history" class="tab-content" style="display:none;">
            <div class="visit-timeline" id="pmVisitTimeline">
                <div class="vt-empty">No visit history found.</div>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeModal('patientModal')">Close</button>
    </div>
</div>
</div>

<script>
// ── Patient data from server ──────────────────────────────────────────
const PATIENTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Patients.Select(p => new {
        id          = p.IdPet,
        name        = p.PetName,
        species     = p.Species ?? "",
        breed       = p.Breed ?? "",
        gender      = p.Gender ?? "",
        color       = p.Color ?? "",
        age         = p.AgeDisplay,
        img         = p.ImageUrl ?? "",
        microchip   = p.MicrochipId ?? "",
        weight      = p.Weight.HasValue ? $"{p.Weight:F1} kg" : "—",
        vacc        = p.VaccinationStatus ?? "",
        neutered    = p.IsNeutered,
        medNotes    = p.MedicalNotes ?? "",
        energy      = p.EnergyLevel ?? "",
        traits      = p.Traits ?? "",
        children    = p.GoodWithChildren,
        pets        = p.GoodWithPets,
        trained     = p.IsTrained,
        owner       = p.OwnerName,
        phone       = p.OwnerPhone ?? "",
        firstSeen   = p.FirstSeen.ToString("dd MMM yyyy"),
        lastVisit   = p.LastVisitDate.HasValue ? p.LastVisitDate.Value.ToString("dd MMM yyyy") : "—",
        totalVisits = p.TotalVisits,
        history     = p.VisitHistory.Select(v => new {
            date    = v.VisitDate.ToString("dd MMM yyyy"),
            doctor  = v.DoctorName ?? "",
            service = v.ServiceName ?? "General",
            note    = v.MedicalNote ?? "",
            status  = v.Status
        }).ToList()
    })
));

// ── Open patient modal ────────────────────────────────────────────────
function openPatient(id) {
    const p = PATIENTS.find(x => x.id === id);
    if (!p) return;

    // Hero
    const imgEl = document.getElementById('pmImg');
    imgEl.innerHTML = p.img
        ? `<img src="${p.img}" style="width:100%;height:100%;object-fit:cover;" alt="${p.name}">`
        : (p.species.toLowerCase() === 'dog' ? '🐕'
          : p.species.toLowerCase() === 'cat' ? '🐈'
          : p.species.toLowerCase() === 'bird' ? '🐦' : '🐾');
    document.getElementById('pmName').textContent  = p.name;
    document.getElementById('pmBreed').textContent =
        [p.species, p.breed].filter(Boolean).join(' · ') || '—';

    // Vacc badge
    const vaccMap = {
        uptodate: '<span class="vacc-chip vacc-ok">✅ Up to Date</span>',
        partial:  '<span class="vacc-chip vacc-warn">⚠️ Partial</span>',
        notvaccinated: '<span class="vacc-chip vacc-err">❌ Not Vaccinated</span>'
    };
    document.getElementById('pmVacc').innerHTML =
        vaccMap[p.vacc.toLowerCase()] || '<span class="vacc-chip vacc-unk">❓ Unknown</span>';

    // Info tab
    document.getElementById('pmSpecies').textContent    = p.species || '—';
    document.getElementById('pmBreedVal').textContent   = p.breed   || '—';
    document.getElementById('pmGender').textContent     = p.gender  || '—';
    document.getElementById('pmAge').textContent        = p.age     || '—';
    document.getElementById('pmColor').textContent      = p.color   || '—';
    document.getElementById('pmWeight').textContent     = p.weight;
    document.getElementById('pmMicrochip').textContent  = p.microchip || '—';
    document.getElementById('pmOwner').textContent      = p.owner;
    document.getElementById('pmPhone').textContent      = p.phone || '—';
    document.getElementById('pmFirstSeen').textContent  = p.firstSeen;
    document.getElementById('pmLastVisit').textContent  = p.lastVisit;
    document.getElementById('pmTotalVisits').textContent = `${p.totalVisits} visit(s)`;

    // Medical tab
    document.getElementById('pmVaccText').textContent  =
        p.vacc === 'UpToDate' ? '✅ Up to Date' :
        p.vacc === 'Partial'  ? '⚠️ Partial' :
        p.vacc === 'NotVaccinated' ? '❌ Not Vaccinated' : '❓ Unknown';
    document.getElementById('pmNeutered').textContent  = p.neutered ? '✅ Yes' : '❌ No';
    document.getElementById('pmEnergy').textContent    = p.energy || '—';
    document.getElementById('pmWeightMed').textContent = p.weight;

    // Behavior chips
    const behEl = document.getElementById('pmBehavior');
    const chips = [
        p.children ? '👶 Good with children' : null,
        p.pets     ? '🐾 Good with other pets' : null,
        p.trained  ? '🎓 Trained' : null
    ].filter(Boolean);
    behEl.innerHTML = chips.map(c =>
        `<span class="behav-chip">${c}</span>`
    ).join('');

    // Medical notes
    const noteSec = document.getElementById('pmMedNotesSection');
    if (p.medNotes) {
        document.getElementById('pmMedNotes').textContent = p.medNotes;
        noteSec.style.display = 'block';
    } else {
        noteSec.style.display = 'none';
    }

    // Visit history
    const timeline = document.getElementById('pmVisitTimeline');
    if (p.history && p.history.length > 0) {
        const statusColor = { Completed:'var(--gd)', Cancelled:'var(--wr)', NoShow:'#e07b3c', Confirmed:'#1a3a8f' };
        timeline.innerHTML = p.history.map(v => `
            <div class="vt-item">
                <div class="vt-dot" style="background:${statusColor[v.status] || 'var(--gd)'}"></div>
                <div class="vt-date">${v.date}</div>
                <div class="vt-doc">
                    ${v.doctor ? `👨‍⚕️ Dr. ${v.doctor}` : ''} · ${v.service}
                    <span style="margin-left:6px;font-size:.68rem;
                                 color:${statusColor[v.status] || 'var(--gd)'};font-weight:900;">
                        ${v.status}
                    </span>
                </div>
                ${v.note ? `<div class="vt-note">${v.note}</div>` : ''}
            </div>
        `).join('');
    } else {
        timeline.innerHTML = '<div class="vt-empty">📭 No visit history yet.</div>';
    }

    // Reset to first tab
    switchTab(document.querySelector('.pm-tab[data-tab="info"]'), 'info');
    document.getElementById('pmTitle').textContent = `🐾 ${p.name}'s Record`;
    document.getElementById('patientModal').classList.add('open');
}

// ── Tab switching ─────────────────────────────────────────────────────
function switchTab(btn, tab) {
    document.querySelectorAll('.pm-tab').forEach(t => {
        t.style.color = 'var(--muted)';
        t.style.borderBottom = 'none';
    });
    btn.style.color = 'var(--gd)';
    btn.style.borderBottom = '2.5px solid var(--gd)';
    document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
    document.getElementById(`tab-${tab}`).style.display = 'block';
}

// ── Filter ────────────────────────────────────────────────────────────
let activeFilter = 'all';
function setFilter(btn, filter) {
    activeFilter = filter;
    document.querySelectorAll('.pat-chip').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    filterPatients();
}
function filterPatients() {
    const q       = document.getElementById('patSearch').value.toLowerCase();
    const species = document.getElementById('speciesFilter').value.toLowerCase();
    let visible   = 0;
    document.querySelectorAll('#patGrid .pat-card').forEach(card => {
        const nameMatch    = !q || card.dataset.name.includes(q) || card.dataset.owner.includes(q);
        const speciesMatch = !species || card.dataset.species.includes(species);
        const vaccMatch    = activeFilter !== 'vacc' || card.dataset.vacc === 'due';
        const show = nameMatch && speciesMatch && vaccMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });
    document.getElementById('patCount').textContent = `${visible} patient(s)`;
}

// ── Modal helpers ─────────────────────────────────────────────────────
function closeModal(id) { document.getElementById(id)?.classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(o =>
    o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); })
);

// ── Sidebar ───────────────────────────────────────────────────────────
function toggleSidebar(){const sb=document.getElementById("sidebar"),ov=document.getElementById("sidebarOverlay"),sh=document.getElementById("waShell");if(window.innerWidth<=992){sb?.classList.toggle("mob-open");ov?.classList.toggle("show");document.body.classList.toggle("sidebar-open")}else{sh?.classList.toggle("mini")}}
function closeSidebar(){document.getElementById("sidebar")?.classList.remove("mob-open");document.getElementById("sidebarOverlay")?.classList.remove("show");document.body.classList.remove("sidebar-open");}
document.addEventListener("DOMContentLoaded",()=>{
    document.querySelectorAll(".wa-sb .sb-row").forEach(r=>r.addEventListener("click",()=>{if(window.innerWidth<=992)closeSidebar()}));
    window.addEventListener("resize",()=>{if(window.innerWidth>992)closeSidebar()});
});
</script>
</body>
</html>
