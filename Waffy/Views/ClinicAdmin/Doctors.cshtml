@model Waffy.Models.ViewModels.DoctorsViewModel
@{
    ViewData["Title"] = "Waffy — Doctors";
    Layout = null;

    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <style>
        .modal {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .modal-body {
            overflow-y: auto;
            flex: 1;
        }
    </style>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        <!-- ── Sidebar ── -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Doctors">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Basic_Information">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation">
                        <span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@userInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@sessionUserName</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
                    <span class="sb-icon">↩</span>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread"><span>Clinic Management</span><span>/</span><b>Doctors</b></div>
            <div class="tn-center">
                <div class="tn-center-main">Doctors</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">
            <section class="page-hero">
                <div>
                    <h1>Doctors</h1>
                    <p>Manage doctors registered under your clinic.</p>
                </div>
                <button class="btn btn-primary" onclick="openModal('modalAddDoctor')">
                    + Add Doctor
                </button>
            </section>

            <div class="page-body">

                @if (TempData["DoctorSuccess"] != null)
                {
                    <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                        ✅ @TempData["DoctorSuccess"]
                    </div>
                }
                @if (TempData["DoctorError"] != null)
                {
                    <div style="background:#faece8;border:1px solid rgba(200,106,92,.3);border-radius:12px;
                                    padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#c86a5c;">
                        ⚠️ @TempData["DoctorError"]
                    </div>
                }

                @if (!Model.Doctors.Any())
                {
                    <!-- Empty state -->
                    <div class="chart-card" style="text-align:center;padding:2.5rem;color:var(--muted)">
                        <div style="font-size:2.5rem;margin-bottom:.8rem">👨‍⚕️</div>
                        <div style="font-weight:700;margin-bottom:.4rem">No doctors yet</div>
                        <div style="font-size:.85rem">
                            Click "+ Add Doctor" to register the first doctor.
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid-3">
                        @foreach (var doc in Model.Doctors)
                        {
                            var statusCls = doc.VerificationStatus?.ToLower() switch
                            {
                                "approved" => "s-confirmed",
                                "rejected" => "s-cancelled",
                                _ => "s-pending"
                            };
                            var statusLabel = doc.VerificationStatus?.ToLower() switch
                            {
                                "approved" => "Approved ✓",
                                "rejected" => "Rejected ✗",
                                _ => "Pending ⏳"
                            };

                            <div class="doctor-card">
                                <div class="doctor-ava" style="background:var(--gp)">👨‍⚕️</div>
                                <div style="flex:1">
                                    <div class="doctor-name">Dr. @doc.FullName</div>
                                    <div class="doctor-spec">
                                        @(doc.Specialization ?? "Specialty not set")
                                        @if (doc.ExperienceYears.HasValue)
                                        {
                                            <span> • @doc.ExperienceYears yrs exp</span>
                                        }
                                    </div>
                                    <div class="doctor-stats">
                                        <div class="doctor-stat">
                                            Phone: <span>@(doc.Phone ?? "—")</span>
                                        </div>
                                        <div class="doctor-stat">
                                            Rating: <span>@(doc.Rating.HasValue ? $"{doc.Rating:F1}⭐" : "New")</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="doctor-actions"
                                     style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;flex-shrink:0;">

                                    <!-- Status Badge -->
                                    <span class="status @statusCls" style="font-size:.76rem;">@statusLabel</span>

                                    <!-- Buttons Row -->
                                    <div style="display:flex;gap:6px;align-items:center;">

                                        @if (doc.VerificationStatus?.ToLower() == "approved")
                                        {
                                            <a asp-controller="ClinicAdmin" asp-action="DoctorInfo"
                                               asp-route-id="@doc.IdDoctor"
                                               style="display:inline-flex;align-items:center;gap:4px;
                                  padding:5px 12px;border-radius:10px;
                                  background:var(--gp);color:var(--gd);
                                  font-size:.78rem;font-weight:800;text-decoration:none;
                                  border:1px solid var(--b2);transition:.18s;white-space:nowrap;"
                                               onmouseover="this.style.background='var(--b2)'"
                                               onmouseout="this.style.background='var(--gp)'">
                                                👁 View
                                            </a>
                                        }

                                        @if (doc.VerificationStatus?.ToLower() != "pending")
                                        {
                                            <form asp-controller="ClinicAdmin" asp-action="RemoveDoctor"
                                                  method="post" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idDoctor" value="@doc.IdDoctor">
                                                <button type="submit"
                                                        style="display:inline-flex;align-items:center;justify-content:center;
                                           width:32px;height:32px;border-radius:10px;
                                           background:rgba(200,106,92,.08);color:#c86a5c;
                                           border:1px solid rgba(200,106,92,.22);
                                           font-size:.86rem;cursor:pointer;transition:.18s;"
                                                        onmouseover="this.style.background='rgba(200,106,92,.18)'"
                                                        onmouseout="this.style.background='rgba(200,106,92,.08)'"
                                                        onclick="return confirm('Remove Dr. @doc.FullName from the clinic?')">
                                                    🗑
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Add card -->
                        <div class="doctor-card"
                             style="border:2px dashed var(--b2);cursor:pointer;
                                        justify-content:center;align-items:center;min-height:120px"
                             onclick="openModal('modalAddDoctor')">
                            <div style="text-align:center;color:var(--muted)">
                                <div style="font-size:2rem">➕</div>
                                <div style="font-size:.85rem;font-weight:700;margin-top:6px">
                                    Add Doctor
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </main>
    </div>

    <!-- ══ Modal: Add Doctor ══ -->
    <div class="modal-overlay" id="modalAddDoctor">
        <div class="modal modal-wide">
            <div class="modal-header">
                <div class="modal-title">👨‍⚕️ Add Doctor</div>
                <button class="modal-close" type="button"
                        onclick="closeModal('modalAddDoctor')">
                    ✕
                </button>
            </div>

            <form asp-controller="ClinicAdmin" asp-action="AddDoctor"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
              
                    <div class="modal-body" style="overflow-y:auto; max-height:65vh;">

                    <div class="sec-label">👤 Account Information</div>
                    <div class="f-grid">
                        <div class="f-group">
                            <label class="f-label"><span class="req">*</span>Full Name</label>
                            <input name="FullName" class="f-inp" type="text"
                                   placeholder="Dr. Full Name" required>
                        </div>
                        <div class="f-group">
                            <label class="f-label"><span class="req">*</span>Phone</label>
                            <input name="Phone" class="f-inp" type="tel"
                                   placeholder="07XXXXXXXX" required>
                        </div>
                        <div class="f-group f-full">
                            <label class="f-label"><span class="req">*</span>Email</label>
                            <input name="Email" class="f-inp" type="email"
                                   placeholder="doctor@example.com" required>
                            <div class="f-hint">This will be the doctor's login email</div>
                        </div>
                        <div class="f-group f-full">
                            <label class="f-label"><span class="req">*</span>Temporary Password</label>
                            <input name="Password" class="f-inp" type="text"
                                   placeholder="At least 8 characters" required>
                            <div class="f-hint">Doctor can change this after login</div>
                        </div>
                    </div>

                    <hr class="sec-div">
                    <div class="sec-label">🎓 Professional Information</div>
                    <div class="f-grid">
                        <div class="f-group">
                            <label class="f-label">Specialty</label>
                            <select name="Specialization" class="f-inp">
                                <option value="">-- Select --</option>
                                <option value="General Veterinary Medicine">General Veterinary Medicine</option>
                                <option value="Veterinary Surgery">Veterinary Surgery</option>
                                <option value="Dermatology">Dermatology</option>
                                <option value="Veterinary Dentistry">Veterinary Dentistry</option>
                                <option value="Bird & Reptile Medicine">Bird &amp; Reptile Medicine</option>
                            </select>
                        </div>
                        <div class="f-group">
                            <label class="f-label">Experience Years</label>
                            <select name="ExperienceYears" class="f-inp">
                                <option value="">-- Select --</option>
                                <option value="1">Less than 1 year</option>
                                <option value="2">1–3 years</option>
                                <option value="5">3–5 years</option>
                                <option value="7">5–10 years</option>
                                <option value="10">More than 10 years</option>
                            </select>
                        </div>
                        <div class="f-group f-full">
                            <label class="f-label">Certifications & Qualifications</label>
                            <label class="upload-box" style="cursor:pointer;display:block">
                                <input type="file" name="CertificationFile"
                                       accept=".pdf,.jpg,.jpeg,.png,.docx"
                                       style="display:none"
                                       onchange="updateCertLabel(this)">
                                <div class="upload-icon">🎓</div>
                                <div class="upload-txt" id="certUploadTxt">Upload certification file</div>
                                <div class="upload-sub">PDF, JPG, PNG, DOCX — max 5MB</div>
                            </label>
                        </div>
                    </div>

                    <div style="background:#fff8e1;border:1px solid #f0c040;border-radius:10px;
                                padding:10px 14px;margin-top:.8rem;font-size:.82rem;color:#b8860b;">
                        🔍 After submission, the doctor will have status <strong>Pending</strong>
                        until approved by the SuperAdmin.
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline"
                            onclick="closeModal('modalAddDoctor')">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        💾 Add Doctor
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // ── Modal ─────────────────────────────────────────
        function openModal(id) {
            document.getElementById(id)?.classList.add("open");
        }
        function closeModal(id) {
            document.getElementById(id)?.classList.remove("open");
        }
      

        // ── Sidebar ───────────────────────────────────────
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }
        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }

                function updateCertLabel(input) {
            const txt = document.getElementById("certUploadTxt");
            if (input.files && input.files[0]) {
                txt.textContent = input.files[0].name;
            }
        }

               document.addEventListener("DOMContentLoaded", () => {
            // Modal background close
            document.querySelectorAll(".modal-overlay").forEach(overlay => {
                overlay.addEventListener("click", function(e) {
                    if (e.target === this) {
                        this.classList.remove("open");
                    }
                });
            });

            // Sidebar
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });
            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>