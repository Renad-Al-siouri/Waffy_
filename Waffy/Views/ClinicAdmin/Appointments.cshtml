<script>
// Doctors data
const DOCTORS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.AvailableDoctors.Select(d => new {
        id       = d.IdDoctor,
        name     = d.FullName,
        spec     = d.Specialization ?? "Veterinary",
        days     = d.WorkingDays ?? "",
        maxDaily = d.MaxDailyAppointments.GetValueOrDefault(12),
        avail    = d.IsAvailable.GetValueOrDefault(true)
    })
));
const COUNTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.DoctorAppointmentCounts
));

// Modal helpers
function closeModal(id){ document.getElementById(id)?.classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(o =>
    o.addEventListener('click', e => { if(e.target===o) o.classList.remove('open'); })
);

// ── Details Modal ─────────────────────────────────────────────────────
function openDetails(id) {
    const row = document.querySelector(`#apptTbody tr[data-id="${id}"]`);
    if (!row) return;
    const d = row.dataset;

    // Pet hero
    const imgEl = document.getElementById('detImg');
    imgEl.innerHTML = d.petimg
        ? `<img src="${d.petimg}" style="width:100%;height:100%;object-fit:cover;" alt="${d.petname}">`
        : (d.petspecies==='dog'?'🐕':d.petspecies==='cat'?'🐈':'🐾');
    document.getElementById('detPetName').textContent    = d.petname || 'No pet selected';
    document.getElementById('detPetSpecies').textContent = d.petspecies || '—';

    // Owner
    document.getElementById('detOwner').textContent = d.ownername || '—';
    document.getElementById('detPhone').textContent  = d.ownerphone || '—';

    // Appointment
    document.getElementById('detDate').textContent   = d.date || '—';
    document.getElementById('detTime').textContent   = d.time + (d.endtime ? ` – ${d.endtime}` : '');
    document.getElementById('detDoctor').textContent = d.docname
        ? `Dr. ${d.docname}${d.docspec ? ` · ${d.docspec}` : ''}`
        : (d.status === 'PendingClinicApproval' ? 'To be assigned by clinic' : '—');
    document.getElementById('detService').textContent  = d.service || 'General';
    document.getElementById('detUrgency').innerHTML    = d.urgency === 'Urgent'
        ? '<span style="color:#e07b3c;font-weight:900;">🔴 Urgent</span>'
        : '<span style="color:var(--gd);font-weight:800;">🟢 Normal</span>';
    document.getElementById('detStatus').textContent   = d.status || '—';

    // Deposit
    document.getElementById('detDepMethod').textContent = d.depositmethod || '—';
    const depPaid = d.depositpaid === '1';
    document.getElementById('detDepStatus').innerHTML = depPaid
        ? '<span style="color:var(--gd);font-weight:900;">✅ Paid</span>'
        : (d.depositmethod === 'CliQ'
            ? '<span style="color:#9b6000;font-weight:900;">⏳ CliQ Pending</span>'
            : '<span style="color:var(--muted);">Not paid</span>');

    // Reason
    const rsec = document.getElementById('detReasonSection');
    if (d.reason) {
        document.getElementById('detReason').textContent = d.reason;
        rsec.style.display = 'block';
    } else {
        rsec.style.display = 'none';
    }

    document.getElementById('detTitle').textContent = d.petname
        ? `📅 ${d.petname}'s Appointment`
        : '📅 Appointment Details';

    document.getElementById('detailsModal').classList.add('open');
}

// ── Assign Doctor Modal ───────────────────────────────────────────────
let selDocId = 0;
function openAssignModal(apptId, apptDate) {
    document.getElementById('assignApptId').value = apptId;
    selDocId = 0;
    document.getElementById('assignDoctorId').value = 0;
    document.getElementById('assignBtn').disabled = true;

    const dayOfWeek = new Date(apptDate + 'T00:00:00').getDay();
    let html = '';

    if (!DOCTORS || DOCTORS.length === 0) {
        document.getElementById('doctorList').innerHTML =
            '<div style="color:var(--muted);padding:1rem;font-weight:700;">No doctors registered in this clinic.</div>';
        document.getElementById('assignModal').classList.add('open');
        return;
    }

    DOCTORS.forEach(doc => {
        const wdays = doc.days ? doc.days.split(',').map(x => parseInt(x.trim())) : [];
        const worksToday = wdays.length === 0 || wdays.includes(dayOfWeek);
        const cnt  = COUNTS[doc.id] || 0;
        const full = cnt >= doc.maxDaily;
        const ok   = worksToday && !full && doc.avail;

        const avHtml = ok
            ? `<span class="av-ok">🟢 Available · ${cnt}/${doc.maxDaily} today</span>`
            : !worksToday ? `<span class="av-warn">📅 Day off</span>`
            : full        ? `<span class="av-no">🔴 Full (${cnt}/${doc.maxDaily})</span>`
            :               `<span class="av-no">❌ Unavailable</span>`;

        html += `
        <div class="assign-card ${ok ? '' : 'disabled'}" id="adc${doc.id}"
             onclick="${ok ? `selDoc(${doc.id})` : ''}">
            <div style="width:40px;height:40px;border-radius:50%;background:var(--gp);
                        display:flex;align-items:center;justify-content:center;
                        font-family:'Fredoka',sans-serif;font-size:.95rem;
                        font-weight:700;color:var(--gd);flex-shrink:0;">
                ${doc.name.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase()}
            </div>
            <div style="flex:1;">
                <div style="font-weight:900;font-size:.88rem;">Dr. ${doc.name}</div>
                <div style="font-size:.73rem;color:var(--muted);font-weight:700;">${doc.spec}</div>
                ${avHtml}
            </div>
        </div>`;
    });

    document.getElementById('doctorList').innerHTML = html ||
        '<div style="color:var(--muted);padding:1rem;font-weight:700;">No available doctors for this slot.</div>';
    document.getElementById('assignModal').classList.add('open');
}

function selDoc(id) {
    document.querySelectorAll('.assign-card').forEach(c => c.classList.remove('sel'));
    document.getElementById(`adc${id}`)?.classList.add('sel');
    selDocId = id;
    document.getElementById('assignDoctorId').value = id;
    document.getElementById('assignBtn').disabled = false;
}

// ── Reject Modal ──────────────────────────────────────────────────────
function openRejectModal(id, name) {
    document.getElementById('rejectId').value = id;
    document.getElementById('rejectMsg').textContent =
        `Reject ${name || 'this'} appointment? The 5 JOD deposit will be returned immediately.`;
    document.getElementById('rejectModal').classList.add('open');
}

// ── Attendance Modal ──────────────────────────────────────────────────
function openAttendModal(id, name, attended) {
    document.getElementById('attendId').value = id;
    if (attended) {
        document.getElementById('attendTitle').textContent = '🏁 Confirm Attendance';
        document.getElementById('attendIcon').textContent  = '🏁';
        document.getElementById('attendName').textContent  = `${name || 'Patient'} attended`;
        document.getElementById('attendMsg').textContent   =
            'Marking visit as complete. The 5 JOD deposit will be returned to the patient\'s wallet.';
        document.getElementById('attendBtn').className     = 'btn btn-primary';
        document.getElementById('attendBtn').textContent   = '✅ Confirm & Return Deposit';
        document.getElementById('attendForm').action       = '/ClinicAdmin/ConfirmAttendance';
    } else {
        document.getElementById('attendTitle').textContent = '🚫 Mark No-Show';
        document.getElementById('attendIcon').textContent  = '🚫';
        document.getElementById('attendName').textContent  = `${name || 'Patient'} did not attend`;
        document.getElementById('attendMsg').textContent   =
            'The appointment will be cancelled. The 5 JOD deposit will be RETAINED as per the no-show policy.';
        document.getElementById('attendBtn').className     = 'btn btn-red';
        document.getElementById('attendBtn').textContent   = '🚫 Mark No-Show (Keep Deposit)';
        document.getElementById('attendForm').action       = '/ClinicAdmin/MarkNoShow';
    }
    document.getElementById('attendModal').classList.add('open');
}

// ── CliQ Confirm Modal ────────────────────────────────────────────────
function confirmCliq(id) {
    document.getElementById('cliqApptId').value = id;
    const row = document.querySelector(`#apptTbody tr[data-id="${id}"]`);
    const ref = row?.dataset.cliqref || '—';
    document.getElementById('cliqRefDisplay').textContent = ref;
    document.getElementById('cliqModal').classList.add('open');
}

// ── Table Filter ──────────────────────────────────────────────────────
function filterTable() {
    const q   = (document.getElementById('searchInput')?.value ?? '').toLowerCase();
    const doc = (document.getElementById('docFilter')?.value   ?? '').toLowerCase();
    let vis = 0;
    document.querySelectorAll('#apptTbody tr').forEach(r => {
        const ok = (!q   || (r.dataset.search ?? '').includes(q)) &&
                   (!doc || (r.dataset.doctor ?? '').toLowerCase().includes(doc));
        r.style.display = ok ? '' : 'none';
        if (ok) vis++;
    });
    const lbl = document.getElementById('countLabel');
    if (lbl) lbl.textContent = vis + ' result(s)';
}

// ── Sidebar ───────────────────────────────────────────────────────────
function toggleSidebar(){const sb=document.getElementById("sidebar"),ov=document.getElementById("sidebarOverlay"),sh=document.getElementById("waShell");if(window.innerWidth<=992){sb?.classList.toggle("mob-open");ov?.classList.toggle("show");document.body.classList.toggle("sidebar-open")}else{sh?.classList.toggle("mini")}}
function closeSidebar(){document.getElementById("sidebar")?.classList.remove("mob-open");document.getElementById("sidebarOverlay")?.classList.remove("show");document.body.classList.remove("sidebar-open");}
document.addEventListener("DOMContentLoaded",()=>{
    document.querySelectorAll(".wa-sb .sb-row").forEach(r=>r.addEventListener("click",()=>{if(window.innerWidth<=992)closeSidebar()}));
    window.addEventListener("resize",()=>{if(window.innerWidth>992)closeSidebar()});
});
</script>
</body>
</html>
