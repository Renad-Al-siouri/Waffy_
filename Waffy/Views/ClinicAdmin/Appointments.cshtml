    <div class="modal-header">
        <div class="modal-title">📱 Confirm CliQ Payment</div>
        <button class="modal-close" type="button" onclick="closeModal('cliqModal')">✕</button>
    </div>
    <form asp-controller="ClinicAdmin" asp-action="ConfirmCliqPayment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="cliqApptId">
        <div class="modal-body" style="padding:1.4rem;">
            <div class="c-icon">📱</div>
            <div class="c-title">Confirm CliQ Receipt?</div>
           <div class="c-msg">
    Verify that you received <strong>5 JOD</strong> via CliQ
    from the patient for this appointment.<br>
    Once confirmed, the deposit will be marked as paid.
</div>
<div style="background:#fff8e1;border:1.5px solid #fde68a;
            border-radius:10px;padding:10px 14px;
            margin-top:10px;text-align:center;">
    <div style="font-size:.74rem;color:#9b6000;font-weight:700;margin-bottom:4px;">
        📋 Reference Number to Verify
    </div>
    <div id="cliqRefDisplay"
         style="font-family:'Fredoka',sans-serif;font-size:1.3rem;
                font-weight:700;color:#9b6000;letter-spacing:3px;">
        —
    </div>
    <div style="font-size:.7rem;color:#555;font-weight:600;margin-top:4px;">
        This must match the reference sent by the patient
    </div>
</div>

<div style="background:#fff8e1;border:1.5px solid #fde68a;border-radius:10px;
            padding:10px 14px;margin-top:6px;text-align:center;">
    <div style="font-size:.75rem;color:#9b6000;font-weight:700;">
        Expected Reference Number
    </div>
    <div style="font-family:'Fredoka',sans-serif;font-size:1.2rem;
                font-weight:700;color:#9b6000;letter-spacing:2px;"
         id="cliqRefDisplay">
        —
    </div>
</div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeModal('cliqModal')">Cancel</button>
            <button type="submit" class="btn btn-primary">✅ Confirm Received</button>
        </div>
