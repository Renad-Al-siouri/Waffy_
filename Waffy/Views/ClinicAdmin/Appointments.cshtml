@model Waffy.Models.ViewModels.ClinicAppointmentsViewModel
@{
    ViewData["Title"] = "Waffy — Appointments";
    Layout = null;
    var userName   = Context.Session.GetString("UserName")   ?? "Clinic Manager";
    var clinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var initials   = userName.Length > 0 ? userName[0].ToString().ToUpper() : "C";
    var now        = DateTime.Now;

    var pendingClinic = Model.Appointments.Count(a => a.Status == "PendingClinicApproval");
    var pendingDoctor = Model.Appointments.Count(a => a.Status == "PendingDoctorApproval");
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>@ViewData["Title"]</title>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
<link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
<style>
.kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-bottom:16px;}
.kpi-card{background:var(--ws);border-radius:14px;border:1px solid var(--line);padding:.8rem;text-align:center;}
.kpi-val{font-family:'Fredoka',sans-serif;font-size:1.4rem;font-weight:700;color:var(--gd);}
.kpi-lbl{font-size:.68rem;color:var(--muted);font-weight:700;margin-top:2px;}
.pending-banner{background:#fff8e1;border:1.5px solid #fde68a;border-radius:14px;
    padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;
    gap:12px;font-size:.84rem;font-weight:700;color:#9b6000;}
.pending-count{background:#e07b3c;color:#fff;border-radius:999px;padding:2px 12px;font-size:.78rem;font-weight:900;}
.f-bar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;align-items:center;}
.f-chip{padding:6px 14px;border-radius:10px;border:1.5px solid var(--line);background:var(--ws);
    font-size:.82rem;font-weight:800;color:var(--muted);cursor:pointer;transition:.15s;text-decoration:none;}
.f-chip:hover,.f-chip.active{border-color:var(--gd);background:var(--gp);color:var(--gd);}
.f-chip-warn{border-color:#e07b3c!important;color:#e07b3c!important;background:#fef0e6!important;}
.f-chip-warn.active,.f-chip-warn:hover{background:#e07b3c!important;color:#fff!important;}
.s-wrap{position:relative;flex:1;min-width:180px;max-width:280px;}
.s-inp{width:100%;padding:8px 12px 8px 32px;border:1.5px solid var(--line);border-radius:10px;
    background:var(--ws);font-family:'Nunito',sans-serif;font-size:.84rem;font-weight:700;outline:none;box-sizing:border-box;}
.s-inp:focus{border-color:var(--gd);}
.s-ico{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--muted);pointer-events:none;}
.doc-sel{padding:8px 12px;border:1.5px solid var(--line);border-radius:10px;background:var(--ws);
    font-family:'Nunito',sans-serif;font-size:.84rem;font-weight:700;color:var(--text);outline:none;cursor:pointer;}
.ap-table{width:100%;border-collapse:collapse;}
.ap-table th{font-size:.74rem;font-weight:900;color:var(--muted);padding:8px 12px;
    text-align:left;border-bottom:1.5px solid var(--line);white-space:nowrap;background:var(--ws);}
.ap-table td{font-size:.84rem;padding:10px 12px;border-bottom:.5px solid var(--line);vertical-align:middle;}
.ap-table tr:last-child td{border-bottom:none;}
.ap-table tbody tr:hover td{background:var(--gp);}
.t-time{font-family:'Fredoka',sans-serif;font-size:.9rem;font-weight:700;color:var(--gd);}
.t-date{font-size:.71rem;color:var(--muted);font-weight:700;margin-top:1px;}
.t-name{font-weight:900;font-size:.86rem;color:var(--text);}
.t-sub{font-size:.73rem;color:var(--muted);font-weight:700;margin-top:1px;}
.pet-img{width:34px;height:34px;border-radius:8px;overflow:hidden;display:inline-flex;
    align-items:center;justify-content:center;background:var(--gp);font-size:.9rem;
    border:1px solid var(--b2);flex-shrink:0;vertical-align:middle;margin-right:6px;}
.pet-img img{width:100%;height:100%;object-fit:cover;}
.act-row{display:flex;gap:4px;flex-wrap:wrap;align-items:center;}
.s-pend-c{background:#fff8e1;color:#9b6000;border:1px solid #fde68a;border-radius:8px;padding:2px 8px;font-size:.72rem;font-weight:900;}
.s-pend-d{background:#e8f0fe;color:#1a3a8f;border:1px solid #c5d0e8;border-radius:8px;padding:2px 8px;font-size:.72rem;font-weight:900;}
.s-noshow{background:#fef0e6;color:#e07b3c;border:1px solid #f0c4a0;border-radius:8px;padding:2px 8px;font-size:.72rem;font-weight:900;}
.dep-chip{display:inline-flex;align-items:center;font-size:.68rem;font-weight:800;
    background:#e8f0fe;color:#1a3a8f;border-radius:999px;padding:1px 7px;border:1px solid #c5d0e8;margin-top:2px;}
.dep-ok{background:var(--gp);color:var(--gd);border-color:var(--b2);}
.dep-cliq-pending{background:#fff8e1;color:#9b6000;border-color:#fde68a;}

/* Modals */
.det-modal{max-width:500px;max-height:90vh;display:flex;flex-direction:column;overflow:hidden;}
.det-modal .modal-body{overflow-y:auto;flex:1;padding:0;}
.det-hero{display:flex;gap:14px;align-items:center;padding:1.1rem 1.2rem;background:var(--gp);border-bottom:1px solid var(--b2);}
.det-hero-img{width:60px;height:60px;border-radius:12px;overflow:hidden;flex-shrink:0;
    background:var(--ws);border:2px solid var(--b2);display:flex;align-items:center;justify-content:center;font-size:1.6rem;}
.det-hero-img img{width:100%;height:100%;object-fit:cover;}
.det-sec{padding:.7rem 1.2rem;}
.det-sec-title{font-family:'Fredoka',sans-serif;font-size:.84rem;font-weight:700;color:var(--gd);margin-bottom:7px;}
.det-row{display:flex;gap:8px;padding:4px 0;border-bottom:.5px solid var(--line);font-size:.82rem;}
.det-row:last-child{border-bottom:none;}
.det-lbl{width:110px;color:var(--muted);font-weight:700;flex-shrink:0;}
.det-val{font-weight:800;color:var(--text);flex:1;}
.assign-card{border-radius:12px;border:1.5px solid var(--line);background:var(--ws);
    padding:.8rem;cursor:pointer;transition:.18s;display:flex;align-items:center;gap:10px;margin-bottom:6px;}
.assign-card:hover{border-color:var(--gd);background:var(--gp);}
.assign-card.sel{border-color:var(--gd);background:var(--gp);outline:2px solid var(--gd);}
.assign-card.disabled{opacity:.45;cursor:not-allowed;}
.av-ok{color:var(--gd);font-size:.7rem;font-weight:900;}
.av-no{color:var(--wr);font-size:.7rem;font-weight:900;}
.av-warn{color:#e07b3c;font-size:.7rem;font-weight:900;}
.confirm-modal{max-width:420px;}
.c-icon{font-size:2rem;text-align:center;margin-bottom:6px;}
.c-title{font-family:'Fredoka',sans-serif;font-size:1.05rem;font-weight:700;color:var(--text);text-align:center;margin-bottom:4px;}
.c-msg{font-size:.83rem;color:var(--muted);font-weight:700;text-align:center;margin-bottom:.8rem;line-height:1.6;}
.c-select{width:100%;padding:8px 12px;border:1.5px solid var(--line);border-radius:10px;
    font-family:'Nunito',sans-serif;font-size:.84rem;font-weight:700;outline:none;margin-bottom:.8rem;box-sizing:border-box;}
@@media(max-width:1024px){.kpi-grid{grid-template-columns:repeat(3,1fr);}}
@@media(max-width:640px){.kpi-grid{grid-template-columns:repeat(2,1fr);}
    .ap-table th:nth-child(4),.ap-table td:nth-child(4){display:none;}}
</style>
</head>
<body class="admin-shell">
<div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<div class="wa-shell" id="waShell">

<aside class="wa-sb" id="sidebar">
    <div class="sb-logo">
        <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
        <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Clinic Admin</div></div>
    </div>
    <nav class="sb-nav">
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard"><span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Daily Management</div>
            <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Appointments">
                <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                @if (pendingClinic > 0){ <span class="sb-bdg bd-g">@pendingClinic</span> }
            </a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients"><span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records"><span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Clinic Management</div>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors"><span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Basic_Information"><span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue"><span class="sb-icon">💰</span><span class="sb-lbl">Revenue</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption"><span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group">
            <div class="sb-grp-hd">Analytics</div>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews"><span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span></a>
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports"><span class="sb-icon">📈</span><span class="sb-lbl">Reports</span></a>
        </div>
        <div class="sb-hr"></div>
        <div class="sb-group sb-group-flat">
            <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation"><span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span></a>
        </div>
    </nav>
    <div class="sb-foot">
        <div class="sb-user-row">
            <div class="sb-av">@initials</div>
            <div class="sb-user-info">
                <div class="sb-user-name">@userName</div>
                <div class="sb-user-role">Clinic Manager 👑</div>
            </div>
        </div>
        <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
            <span class="sb-icon">↩</span><span class="sb-logout-lbl">Sign Out</span>
        </a>
    </div>
</aside>

<header class="wa-tn">
    <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
    <div class="tn-bread"><span>Daily Management</span><span>/</span><b>Appointments</b></div>
    <div class="tn-center">
        <div class="tn-center-main">Appointments</div>
        <div class="tn-center-sub">@clinicName</div>
    </div>
    <div class="tn-spacer"></div>
    <div class="tn-right">
        <div class="tn-identity">🏥 @clinicName</div>
        <button class="tn-btn notif-btn" type="button">🔔</button>
        <div class="tn-sep"></div>
        <div class="tn-profile">
            <div class="tn-av">@initials</div>
            <div><div class="tn-pname">@userName</div><div class="tn-prole">Clinic Manager 👑</div></div>
        </div>
    </div>
</header>

<main class="wa-main">
<section class="page-hero">
    <div><h1>Appointments</h1><p>Manage and approve appointment requests.</p></div>
</section>
<div class="page-body">

@if (TempData["ApptSuccess"] != null)
{
    <div style="background:#eef4dd;border:1.5px solid #8da546;border-radius:14px;
                padding:14px 18px;margin-bottom:14px;display:flex;
                align-items:center;gap:12px;">
        <span style="font-size:1.2rem;">✅</span>
        <div>
            <div style="font-weight:900;color:#5f7430;font-size:.9rem;">
                Action Completed
            </div>
            <div style="font-weight:700;color:#5f7430;font-size:.84rem;margin-top:2px;">
                @TempData["ApptSuccess"]
            </div>
        </div>
    </div>
}
@if (TempData["ApptError"] != null)
{
    <div style="background:#faece8;border:1.5px solid #c86a5c;border-radius:14px;
                padding:14px 18px;margin-bottom:14px;display:flex;
                align-items:center;gap:12px;">
        <span style="font-size:1.2rem;">⚠️</span>
        <div>
            <div style="font-weight:900;color:#c86a5c;font-size:.9rem;">
                Action Notice
            </div>
            <div style="font-weight:700;color:#c86a5c;font-size:.84rem;margin-top:2px;">
                @TempData["ApptError"]
            </div>
        </div>
    </div>
}


@if (TempData["ApptError"] != null)
{<div style="background:#faece8;border:1px solid rgba(200,106,92,.3);border-radius:12px;padding:10px 16px;margin-bottom:12px;font-weight:800;color:#c86a5c;font-size:.86rem;">⚠️ @TempData["ApptError"]</div>}

@* Pending banner — clinic approval only *@
@if (pendingClinic > 0)
{
<div class="pending-banner">
    <span style="font-size:1.1rem;">⏳</span>
    <div>
        <strong>@pendingClinic request(s) need your approval</strong>
        — Select an available doctor and confirm each request.
    </div>
    <span class="pending-count">@pendingClinic Pending</span>
</div>
}

@* Info: doctor-specific appointments await the doctor, not clinic *@
@if (pendingDoctor > 0)
{
<div style="background:#e8f0fe;border:1.5px solid #c5d0e8;border-radius:14px;
            padding:10px 16px;margin-bottom:12px;display:flex;align-items:center;
            gap:10px;font-size:.83rem;font-weight:700;color:#1a3a8f;">
    <span style="font-size:1rem;">👨‍⚕️</span>
    <div>
        <strong>@pendingDoctor appointment(s) awaiting doctor approval</strong>
        — These were booked with specific doctors. Doctors must approve or reject them.
    </div>
</div>
}
@if (Model.TodayAppointments.Any())
{
    <div style="background:#fff;border:1.5px solid #8da546;border-radius:16px;
                padding:1rem 1.2rem;margin-bottom:16px;">
        <div style="font-family:'Fredoka',sans-serif;font-size:.95rem;
                    font-weight:700;color:var(--gd);margin-bottom:10px;">
            📅 Today's Appointments
            <span style="background:var(--gd);color:#fff;border-radius:999px;
                         padding:1px 10px;font-size:.76rem;margin-left:6px;">
                @Model.TodayAppointments.Count
            </span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            @foreach (var a in Model.TodayAppointments)
            {
                <div style="background:var(--gp);border:1px solid var(--b2);
                            border-radius:12px;padding:8px 12px;min-width:160px;">
                    <div style="font-family:'Fredoka',sans-serif;font-size:1rem;
                                font-weight:700;color:var(--gd);">
                        @a.StartTime.ToString(@"hh\:mm")
                    </div>
                    <div style="font-weight:800;font-size:.84rem;color:var(--text);">
                        @(a.PetName ?? "No pet") · @(a.UserFullName ?? "—")
                    </div>
                    <div style="font-size:.74rem;color:var(--muted);font-weight:700;">
                        @if (!string.IsNullOrEmpty(a.DoctorName))
                        { <text>Dr. @a.DoctorName</text> }
                        else
                        { <text>Doctor TBD</text> }
                    </div>
                    @{
                        var todayBadge = a.Status switch {
                            "Confirmed"             => ("✅","#5f7430"),
                            "PendingClinicApproval" => ("⏳","#9b6000"),
                            "PendingDoctorApproval" => ("👨‍⚕️","#1a3a8f"),
                            _                       => ("•","#888")
                        };
                    }
                    <span style="font-size:.7rem;font-weight:900;color:@todayBadge.Item2;">
                        @todayBadge.Item1 @a.Status
                    </span>
                </div>
            }
        </div>
    </div>
}
<!-- KPIs -->
<div class="kpi-grid">
    <div class="kpi-card"><div class="kpi-val">@Model.TotalCount</div><div class="kpi-lbl">📋 Total</div></div>
    <div class="kpi-card"><div class="kpi-val" style="color:#9b6000;">@pendingClinic</div><div class="kpi-lbl">⏳ Need Approval</div></div>
    <div class="kpi-card"><div class="kpi-val" style="color:#1a3a8f;">@pendingDoctor</div><div class="kpi-lbl">👨‍⚕️ With Doctor</div></div>
    <div class="kpi-card"><div class="kpi-val" style="color:var(--gd);">@Model.ConfirmedCount</div><div class="kpi-lbl">✅ Confirmed</div></div>
    <div class="kpi-card"><div class="kpi-val" style="color:#5f7430;">@Model.CompletedCount</div><div class="kpi-lbl">🏁 Completed</div></div>
    <div class="kpi-card"><div class="kpi-val" style="color:var(--wr);">@Model.CancelledCount</div><div class="kpi-lbl">❌ Cancelled</div></div>
</div>

<!-- Filters -->
<div class="f-bar">
    <div class="s-wrap">
        <span class="s-ico">🔍</span>
        <input class="s-inp" id="searchInput" placeholder="Search pet, owner, doctor..." oninput="filterTable()">
    </div>
    @if (Model.DoctorNames.Any())
    {
        <select class="doc-sel" id="docFilter" onchange="filterTable()">
            <option value="">All Doctors</option>
            @foreach (var dn in Model.DoctorNames){ <option value="@dn">Dr. @dn</option> }
        </select>
    }
    @foreach (var (lbl,val,cls) in new[]{
        ("All","All",""),
        ("🔍 Verify CliQ","PendingPaymentVerification","f-chip-warn"),
        ("⏳ Need Approval","PendingClinicApproval","f-chip-warn"),
        ("👨‍⚕️ With Doctor","PendingDoctorApproval",""),
        ("✅ Confirmed","Confirmed",""),
        ("🏁 Completed","Completed",""),
        ("❌ Cancelled","Cancelled","")
    })
    {
        <a asp-controller="ClinicAdmin" asp-action="Appointments"
           asp-route-statusFilter="@val"
           class="f-chip @cls @(Model.StatusFilter == val ? "active" : "")">@lbl</a>
    }
    <span style="margin-left:auto;font-size:.78rem;font-weight:700;color:var(--muted);" id="countLabel">
        @Model.Appointments.Count result(s)
    </span>
</div>

<!-- Table -->
<div class="chart-card" style="padding:0;overflow:hidden;">
    <div style="display:flex;align-items:center;justify-content:space-between;
                padding:.9rem 1.2rem;border-bottom:1px solid var(--line);">
        <div style="font-family:'Fredoka',sans-serif;font-size:.92rem;font-weight:700;color:var(--gd);">
            📋 Appointment List
        </div>
    </div>
    @if (!Model.Appointments.Any())
    {
        <div style="text-align:center;padding:3rem;color:var(--muted);font-weight:700;">
            <div style="font-size:2rem;margin-bottom:8px;">📅</div>No appointments found.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="ap-table" id="apptTable">
                <thead>
                    <tr>
                        <th>Date / Time</th>
                        <th>Pet &amp; Owner</th>
                        <th>Doctor</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Deposit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="apptTbody">
                @foreach (var a in Model.Appointments)
                {
                    var isToday = a.AppointmentDate.Date == now.Date;
                    var petNameE  = (a.PetName ?? "").Replace("'","&#39;");
                    var ownerNameE = (a.UserFullName ?? "").Replace("'","&#39;");
                    <tr data-id="@a.Id"
                        data-depositmethod="@(a.DepositPayMethod ?? "")"
data-depositpaid="@(a.DepositPaid ? "1" : "0")"
data-cliqref="@(a.CliqReference ?? "")"
                        data-status="@a.Status"
                        data-petid="@(a.IdPet ?? 0)"
                        data-petname="@petNameE"
                        data-petimg="@(a.PetImageUrl ?? "")"
                        data-petspecies="@(a.PetSpecies ?? "")"
                        data-ownername="@ownerNameE"
                        data-ownerphone="@(a.UserPhone ?? "")"
                        data-docname="@((a.DoctorName ?? "").Replace("'","&#39;"))"
                        data-docspec="@(a.DoctorSpecialization ?? "")"
                        data-date="@a.AppointmentDate.ToString("dd MMM yyyy")"
                        data-time="@a.StartTime.ToString(@"hh\:mm")"
                        data-endtime="@(a.EndTime?.ToString(@"hh\:mm") ?? "")"
                        data-service="@(a.ServiceName ?? "")"
                        data-urgency="@(a.UrgencyLevel ?? "Normal")"
                        data-reason="@((a.Reason ?? "").Replace("'","&#39;"))"
                        data-depositmethod="@(a.DepositPayMethod ?? "")"
                        data-depositpaid="@(a.DepositPaid ? "1" : "0")"
                        data-apptdate="@a.AppointmentDate.ToString("yyyy-MM-dd")"
                        data-search="@($"{a.PetName} {a.UserFullName} {a.DoctorName} {a.ServiceName}".ToLower())"
                        data-doctor="@(a.DoctorName ?? "")">

                        <!-- Date / Time -->
                        <td>
                            <div class="t-time">@a.StartTime.ToString(@"hh\:mm")</div>
                            <div class="t-date">
                                @if (isToday)
                                {<span style="color:var(--gd);font-weight:900;">Today</span>}
                                else
                                {@a.AppointmentDate.ToString("dd MMM yyyy")}
                            </div>
                        </td>

                        <!-- Pet & Owner -->
                        <td>
                            <div style="display:flex;align-items:center;">
                                <div class="pet-img">
                                    @if (!string.IsNullOrEmpty(a.PetImageUrl))
                                    { <img src="@a.PetImageUrl" alt="@a.PetName"> }
                                    else
                                    { @(a.PetSpecies?.ToLower() switch{"dog"=>"🐕","cat"=>"🐈",_=>"🐾"}) }
                                </div>
                                <div>
                                    @if (!string.IsNullOrEmpty(a.PetName))
                                    {<div class="t-name">@a.PetName
                                        @if(!string.IsNullOrEmpty(a.PetSpecies))
                                        {<span style="color:var(--muted);font-size:.76rem;">(@a.PetSpecies)</span>}
                                    </div>}
                                    <div class="t-sub">
                                        👤 @(a.UserFullName ?? "—")
                                        @if (!string.IsNullOrEmpty(a.UserPhone))
                                        {<span> · @a.UserPhone</span>}
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- Doctor -->
                        <td>
                            @if (a.Status == "PendingClinicApproval")
                            {
                                <span style="font-size:.76rem;color:#9b6000;font-weight:800;">
                                    ⏳ To be assigned
                                </span>
                            }
                            else if (!string.IsNullOrEmpty(a.DoctorName))
                            {
                                <div style="font-weight:800;font-size:.84rem;">Dr. @a.DoctorName</div>
                                @if (!string.IsNullOrEmpty(a.DoctorSpecialization))
                                {<div class="t-sub">@a.DoctorSpecialization</div>}
                            }
                            else
                            {<span style="color:var(--muted);">—</span>}
                        </td>

                        <!-- Service -->
                        <td style="font-weight:800;font-size:.84rem;">
                            @(a.ServiceName ?? "General")
                            @if (a.UrgencyLevel == "Urgent")
                            {<div style="font-size:.7rem;color:#e07b3c;font-weight:900;">🔴 Urgent</div>}
                        </td>

                        <!-- Status badge -->
                        <td>
                            @{
                                var (badge, badgeCss) = a.Status switch {
    "PendingPayment"             => ("💳 Awaiting Payment","s-pend-c"),
    "PendingPaymentVerification" => ("🔍 Verify CliQ","s-pend-c"),
    "PendingClinicApproval"      => ("⏳ Need Approval","s-pend-c"),
    "PendingDoctorApproval"      => ("👨‍⚕️ With Doctor","s-pend-d"),
    "Confirmed"                  => ("✅ Confirmed","s-confirmed"),
    "Completed"                  => ("🏁 Completed","s-completed"),
    "Cancelled"                  => ("❌ Cancelled","s-cancelled"),
    "NoShow"                     => ("🚫 No-Show","s-noshow"),
    _                            => (a.Status,"s-pending")
};
                            }
                            <span class="status @badgeCss" style="font-size:.74rem;">@badge</span>
                        </td>

                        <!-- Deposit chip -->
                      <!-- Deposit -->
<td>
    @if (a.DepositPaid && a.DepositReturned)
    {
        <span class="dep-chip dep-ok">✅ Returned</span>
    }
    else if (a.DepositPaid && a.DepositPayMethod == "CliQ")
    {
        <span class="dep-chip dep-ok">📱 CliQ · Paid</span>
    }
    else if (a.DepositPaid && a.DepositPayMethod == "Wallet")
    {
        <span class="dep-chip dep-ok">💳 Wallet · Paid</span>
    }
    else if (a.DepositPayMethod == "CliQ" && !a.DepositPaid)
    {
        <div>
            <span class="dep-chip dep-cliq-pending">📱 CliQ · Pending</span>
            @if (!string.IsNullOrEmpty(a.CliqReference))
            {
                <div style="font-size:.68rem;font-weight:900;
                            color:#9b6000;margin-top:3px;
                            letter-spacing:.5px;font-family:'Fredoka',sans-serif;">
                    🔑 @a.CliqReference
                </div>
            }
        </div>
    }
    else
    {
        <span style="font-size:.74rem;color:var(--muted);">—</span>
    }
</td>
                        <!-- Actions -->
                        <td>
                            <div class="act-row">

                                @* Details button — always visible *@
                                <button type="button" class="btn btn-outline btn-sm"
                                        onclick="openDetails(@a.Id)" title="View details">
                                    👁
                                </button>

                                @* Clinic approval actions — ONLY for "Any Doctor" bookings *@
                                @if (a.Status == "PendingClinicApproval")
                                {
                                    <button type="button" class="btn btn-primary btn-sm"
                                            onclick="openAssignModal(@a.Id,'@a.AppointmentDate.ToString("yyyy-MM-dd")')"
                                            title="Assign doctor & approve">
                                        ✅ Assign
                                    </button>
                                    <button type="button" class="btn btn-red btn-sm"
                                            onclick="openRejectModal(@a.Id,'@petNameE')"
                                            title="Reject">
                                        ❌
                                    </button>
                                }

                                @* Doctor-specific: clinic reads only — doctor approves/rejects *@
                                else if (a.Status == "PendingDoctorApproval")
                                {
                                    <span style="font-size:.7rem;font-weight:800;color:#1a3a8f;
                                                 background:#e8f0fe;padding:3px 7px;border-radius:7px;
                                                 border:1px solid #c5d0e8;white-space:nowrap;">
                                        👨‍⚕️ Doctor's call
                                    </span>
                                }
                                @* CliQ تحت التحقق — الادمن يؤكد الدفع *@
@if (a.Status == "PendingPaymentVerification")
{
    <button type="button" class="btn btn-outline btn-sm"
            style="color:#9b6000;border-color:#fde68a;"
            onclick="confirmCliq(@a.Id)">
        📱 Confirm CliQ
    </button>
    <button type="button" class="btn btn-red btn-sm"
            onclick="openRejectModal(@a.Id,'@petNameE')">
        ❌
    </button>
}

                                @* Confirmed: attendance tracking *@
                              @* Confirmed — الادمن يشوف فقط، التأكيد والغياب من صلاحية الطبيب *@
else if (a.Status == "Confirmed")
{
    <span style="font-size:.72rem;font-weight:800;color:var(--gd);
                 background:var(--gp);padding:3px 8px;border-radius:8px;
                 border:1px solid var(--b2);white-space:nowrap;">
        ✅ Confirmed
    </span>
}

                                @* CliQ unconfirmed — clinic verifies payment *@
                                @if (a.DepositPayMethod == "CliQ" && !a.DepositPaid
                                     && a.Status != "Cancelled" && a.Status != "NoShow")
                                {
                                    <button type="button" class="btn btn-outline btn-sm"
                                            style="color:#9b6000;border-color:#fde68a;font-size:.7rem;"
                                            onclick="confirmCliq(@a.Id)"
                                            title="Confirm CliQ payment received">
                                        📱 Confirm CliQ
                                    </button>
                                }

                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
</div>
</main>
</div>

