@model Waffy.Models.ViewModels.ClinicBasicInfoViewModel
@{
    ViewData["Title"] = "Waffy — Clinic Basic Information";
    Layout = null;

    var sessionUserName = Context.Session.GetString("UserName") ?? "Clinic Manager";
    var sessionClinicName = Context.Session.GetString("ClinicName") ?? "Clinic";
    var userInitials = sessionUserName.Length > 0
                                ? sessionUserName[0].ToString().ToUpper() : "C";

    var areaOptions = ViewBag.AreaOptions as List<string> ?? new List<string>();
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <link rel="stylesheet" href="~/css/clinic-setting.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        <!-- ── Sidebar ── -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Dashboard">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Basic_Information">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Personal_nformation">
                        <span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@userInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@sessionUserName</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <a asp-controller="ClinicAdmin" asp-action="Logout" class="sb-logout">
                    <span class="sb-icon">↩</span>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ── Topnav ── -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread">
                <span>Clinic Management</span><span>/</span><b>Clinic Settings</b>
            </div>
            <div class="tn-center">
                <div class="tn-center-main">Clinic Settings</div>
                <div class="tn-center-sub">@sessionClinicName</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @sessionClinicName</div>
                <button class="tn-btn notif-btn" type="button">🔔</button>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@userInitials</div>
                    <div>
                        <div class="tn-pname">@sessionUserName</div>
                        <div class="tn-prole">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ── Main ── -->
        <main class="wa-main">

            <form asp-controller="ClinicAdmin" asp-action="Basic_Information" method="post">
                @Html.AntiForgeryToken()

                <section class="page-hero">
                    <div>
                        <h1>Clinic Settings</h1>
                        <p>Update clinic profile, contact details, and operational preferences.</p>
                    </div>
                    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                </section>

                <div class="page-body">

                    @if (TempData["SaveSuccess"] != null)
                    {
                        <div style="background:#eef4dd;border:1px solid #8da546;border-radius:12px;
                                        padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#5f7430;">
                            ✅ @TempData["SaveSuccess"]
                        </div>
                    }
                    @if (TempData["SaveError"] != null)
                    {
                        <div style="background:#faece8;border:1px solid rgba(200,106,92,.3);border-radius:12px;
                                        padding:10px 16px;margin-bottom:1rem;font-weight:800;color:#c86a5c;">
                            ⚠️ @TempData["SaveError"]
                        </div>
                    }

                    <nav class="tabs cs-tab-nav">
                        <a class="tab active" asp-controller="ClinicAdmin" asp-action="Basic_Information">📋 Basic Information</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Working_Hours">⏰ Working Hours</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Services">🩺 Services</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Documents_C">📄 Documents</a>
                        <a class="tab" asp-controller="ClinicAdmin" asp-action="Images">🖼 Images</a>
                    </nav>

                    <div class="chart-card">
                        <div class="f-grid">

                            <div class="f-group">
                                <label class="f-label"><span class="req">*</span>Clinic Name</label>
                                <input asp-for="Name" class="f-inp" type="text" required>
                            </div>

                            <div class="f-group">
                                <label class="f-label"><span class="req">*</span>Clinic Type</label>
                                <select asp-for="ClinicType" class="f-inp" required>
                                    <option value="Veterinary">Veterinary Clinic</option>
                                    <option value="Hospital">Veterinary Hospital</option>
                                    <option value="Mobile">Mobile Clinic</option>
                                    <option value="Specialist">Specialist Clinic</option>
                                </select>
                            </div>

                            <div class="f-group">
                                <label class="f-label"><span class="req">*</span>City</label>
                                <select asp-for="City" class="f-inp" id="citySelect" required>
                                    <option value="Amman">Amman</option>
                                    <option value="Zarqa">Zarqa</option>
                                    <option value="Irbid">Irbid</option>
                                    <option value="Balqa">Balqa</option>
                                    <option value="Mafraq">Mafraq</option>
                                    <option value="Jerash">Jerash</option>
                                    <option value="Ajloun">Ajloun</option>
                                    <option value="Karak">Karak</option>
                                    <option value="Tafilah">Tafilah</option>
                                    <option value="Maan">Maan</option>
                                    <option value="Aqaba">Aqaba</option>
                                    <option value="Madaba">Madaba</option>
                                </select>
                            </div>

                            <div class="f-group">
                                <label class="f-label"><span class="req">*</span>Phone Number</label>
                                <input asp-for="Phone" class="f-inp" type="tel" required>
                            </div>
                            <div class="f-group">
                                <label class="f-label">📱 CliQ Number</label>
                                <input asp-for="CliqNumber" class="f-inp" type="tel"
                                       placeholder="e.g. 0791234567">
                                <div class="f-hint">
                                    💡 This number will be shown to patients for CliQ deposit payments
                                </div>
                            </div>
                            <div class="f-group">
                                <label class="f-label">Email Address</label>
                                <input asp-for="Email" class="f-inp" type="email">
                            </div>

                            <!-- ✅ Area dropdown من الـ DB -->
                            <div class="f-group">
                                <label class="f-label">Area / District</label>
                                <select asp-for="Area" class="f-inp" id="areaSelect">
                                    <option value="">-- Select Area --</option>
                                    @foreach (var area in areaOptions)
                                    {
                                        <option value="@area">@area</option>
                                    }
                                </select>
                                <div class="f-hint">
                                    💡 Change city and save to update areas
                                </div>
                            </div>

                            <div class="f-group f-full">
                                <label class="f-label">Full Address</label>
                                <input asp-for="Address" class="f-inp" type="text">
                            </div>

                            <div class="f-group f-full">
                                <label class="f-label">Clinic Description</label>
                                <textarea asp-for="Description" class="f-inp"></textarea>
                            </div>

                            <!-- ── MAP PICKER ── -->
                            <div class="f-group f-full">
                                <label class="f-label">
                                    📍 Clinic Location on Map
                                    <span style="font-size:.72rem;color:var(--muted);font-weight:700;margin-left:6px;">
                                        Click on the map to pin your clinic location
                                    </span>
                                </label>

                                <!-- Current coordinates display -->
                                <div id="coordsDisplay"
                                     style="background:var(--gp);border:1px solid var(--b2);border-radius:10px;
                padding:8px 12px;margin-bottom:8px;font-size:.8rem;font-weight:700;
                color:var(--gd);display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
                                    <span>📍 Lat: <strong id="latDisplay">@(Model.Latitude?.ToString("F6") ?? "Not set")</strong></span>
                                    <span>📍 Lng: <strong id="lngDisplay">@(Model.Longitude?.ToString("F6") ?? "Not set")</strong></span>
                                    <button type="button" id="locateBtn"
                                            style="margin-left:auto;padding:4px 12px;border-radius:8px;
                       background:var(--gd);color:#fff;border:none;
                       font-size:.76rem;font-weight:800;cursor:pointer;
                       font-family:'Nunito',sans-serif;">
                                        🎯 Use My Location
                                    </button>
                                </div>

                                <!-- Map container -->
                                <div id="clinicMap"
                                     style="height:320px;border-radius:12px;border:1.5px solid var(--b2);
                overflow:hidden;cursor:crosshair;">
                                </div>
                                <div class="f-hint">💡 Click anywhere on the map to set the clinic pin</div>

                                <!-- Hidden inputs submitted with form -->
                                <input type="hidden" asp-for="Latitude" id="latInput">
                                <input type="hidden" asp-for="Longitude" id="lngInput">
                            </div>

                        </div>
                    </div>

                </div>
            </form>

        </main>
    </div>

    <script>
        // ── Data from server (JS enhancement only) ────────
        const allGovs  = @Html.Raw(ViewBag.AllGovsJson ?? "[]");
        const allDists = @Html.Raw(ViewBag.AllDistsJson ?? "[]");
        const currentArea = "@Html.Raw(Model.Area ?? "")";
                // ── MAP PICKER ────────────────────────────────────────
        (function initMap() {
            const defaultLat = @(Model.Latitude?.ToString("F6") ?? "31.9539")  + 0;
            const defaultLng = @(Model.Longitude?.ToString("F6") ?? "35.9106") + 0;
            const hasCoords  = @(Model.Latitude.HasValue ? "true" : "false");

            // إنشاء الخريطة
            const map = L.map('clinicMap').setView([defaultLat, defaultLng], hasCoords ? 15 : 10);

            // طبقة OpenStreetMap (مجانية)
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors',
                maxZoom: 19
            }).addTo(map);

            // أيقونة مخصصة
            const pinIcon = L.divIcon({
                html: '<div style="font-size:28px;line-height:1;filter:drop-shadow(0 2px 4px rgba(0,0,0,.3));">📍</div>',
                className: '',
                iconAnchor: [14, 28],
                popupAnchor: [0, -28]
            });

            // Marker — ضعه إذا كان عندنا إحداثيات
            let marker = null;
            if (hasCoords) {
                marker = L.marker([defaultLat, defaultLng], { icon: pinIcon })
                    .addTo(map)
                    .bindPopup('🏥 Your clinic is here')
                    .openPopup();
            }

            // دالة لتحديث المعلومات
            function setLocation(lat, lng) {
                lat = parseFloat(lat.toFixed(6));
                lng = parseFloat(lng.toFixed(6));

                // تحديث Hidden inputs
                document.getElementById('latInput').value = lat;
                document.getElementById('lngInput').value = lng;

                // تحديث الـ display
                document.getElementById('latDisplay').textContent = lat;
                document.getElementById('lngDisplay').textContent = lng;

                // تحريك الـ marker
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng], { icon: pinIcon })
                        .addTo(map)
                        .bindPopup('🏥 Your clinic is here')
                        .openPopup();
                }

                map.setView([lat, lng], 16);
            }

            // ── النقر على الخريطة ──────────────────────────────
            map.on('click', function(e) {
                setLocation(e.latlng.lat, e.latlng.lng);
            });

            // ── زر "Use My Location" ───────────────────────────
            document.getElementById('locateBtn')?.addEventListener('click', function() {
                if (!navigator.geolocation) {
                    alert('Geolocation is not supported by your browser.');
                    return;
                }
                this.textContent = '⏳ Locating...';
                const btn = this;
                navigator.geolocation.getCurrentPosition(
                    function(pos) {
                        setLocation(pos.coords.latitude, pos.coords.longitude);
                        btn.textContent = '🎯 Use My Location';
                    },
                    function() {
                        alert('Could not get your location. Please click on the map manually.');
                        btn.textContent = '🎯 Use My Location';
                    }
                );
            });
        })();
        // ─────────────────────────────────────────────────────
        // ── Update Area dropdown when City changes ─────────
        function updateAreas() {
            const cityVal   = document.getElementById("citySelect")?.value;
            const areaEl    = document.getElementById("areaSelect");
            if (!cityVal || !areaEl) return;

            const gov = allGovs.find(g => g.name === cityVal);
            if (!gov) return;

            const dists = allDists
                .filter(d => d.govId === gov.id)
                .map(d => d.name)
                .sort();

            areaEl.innerHTML = '<option value="">-- Select Area --</option>';
            dists.forEach(name => {
                const opt = document.createElement("option");
                opt.value = name;
                opt.textContent = name;
                if (name === currentArea) opt.selected = true;
                areaEl.appendChild(opt);
            });
        }

        // ── Sidebar ────────────────────────────────────────
        function toggleSidebar() {
            const sidebar = document.getElementById("sidebar");
            const overlay = document.getElementById("sidebarOverlay");
            const shell   = document.getElementById("waShell");
            if (window.innerWidth <= 992) {
                sidebar?.classList.toggle("mob-open");
                overlay?.classList.toggle("show");
                document.body.classList.toggle("sidebar-open");
            } else {
                shell?.classList.toggle("mini");
            }
        }

        function closeSidebar() {
            document.getElementById("sidebar")?.classList.remove("mob-open");
            document.getElementById("sidebarOverlay")?.classList.remove("show");
            document.body.classList.remove("sidebar-open");
        }

        // ── Init ───────────────────────────────────────────
        document.addEventListener("DOMContentLoaded", () => {
            // City change → update areas (JS enhancement)
            document.getElementById("citySelect")
                ?.addEventListener("change", updateAreas);

            // Sidebar mobile auto-close
            document.querySelectorAll(".wa-sb .sb-row").forEach(item => {
                item.addEventListener("click", () => {
                    if (window.innerWidth <= 992) closeSidebar();
                });
            });

            window.addEventListener("resize", () => {
                if (window.innerWidth > 992) closeSidebar();
            });
        });
    </script>

</body>
</html>