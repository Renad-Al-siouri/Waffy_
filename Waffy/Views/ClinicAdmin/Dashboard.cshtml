@{
    ViewData["Title"] = "Clinic Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waffy — Clinic & Doctor Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css">
    <style>
        .sb-group-flat {
            padding: 0;
            background: transparent;
            border: 0;
        }
    </style>
</head>
<body class="admin-shell">

    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="wa-shell" id="waShell">

        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark">
                    <img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img">
                </div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Clinic Admin</div>
                </div>
            </div>

            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row active" asp-controller="ClinicAdmin" asp-action="Dashboard" data-tip="Dashboard">
                        <span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Appointments" data-tip="Appointments">
                        <span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span><span class="sb-bdg bd-g">5</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Patients" data-tip="Patients">
                        <span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Medical_Records" data-tip="Medical Records">
                        <span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group" id="managerSection">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Doctors" data-tip="Doctors">
                        <span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Clinic_Settings" data-tip="Clinic Settings">
                        <span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Revenue" data-tip="Revenue &amp; Payments">
                        <span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Adoption" data-tip="Adoption">
                        <span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reviews" data-tip="Reviews">
                        <span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span><span class="sb-bdg bd-g">2</span>
                    </a>
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="Reports" data-tip="Reports">
                        <span class="sb-icon">📈</span><span class="sb-lbl">Reports</span>
                    </a>
                </div>

                <div class="sb-hr"></div>

                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="ClinicAdmin" asp-action="My_Settings" data-tip="My Settings">
                        <span class="sb-icon">⚙️</span><span class="sb-lbl">My Settings</span>
                    </a>
                </div>
            </nav>

            <div class="sb-foot">
                <div class="sb-user-row" onclick="openSidebarProfile()">
                    <div class="sb-av">DC</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">Daniel Carter</div>
                        <div class="sb-user-role">Clinic Manager 👑</div>
                    </div>
                </div>
                <button class="sb-logout" onclick="doLogout()" type="button">
                    <span class="sb-icon">↩</span>
                    <span class="sb-logout-lbl">Sign Out</span>
                </button>
            </div>
        </aside>

        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()" aria-label="Toggle sidebar">☰</button>
            <div class="tn-bread" id="tnBread"><span>Main</span><span>/</span><b id="tnCur">Dashboard</b></div>
            <div class="tn-center">
                <div class="tn-center-main" id="tnTitle">Clinic Dashboard</div>
                <div class="tn-center-sub" id="tnSub">Waffy Clinic Dashboard</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity" id="tnIdentityPill">🏥 Al Amanah Veterinary Clinic</div>
                <button class="tn-btn notif-btn" type="button" aria-label="Notifications">🔔<span class="tn-count">3</span></button>
                <div class="tn-sep"></div>
                <div class="tn-profile user-btn">
                    <div class="tn-av" id="userAvaTop">M</div>
                    <div>
                        <div class="tn-pname" id="userNameTop">Clinic Manager</div>
                        <div class="tn-prole" id="roleTagTop">Clinic Manager 👑</div>
                    </div>
                </div>
            </div>
        </header>

        <main class="wa-main">
            <section class="page-hero">
                <div>
                    <h1 id="pageHeroTitle">Clinic Dashboard</h1>
                    <p>Monitor clinic activity, appointments, revenue, and doctor performance from one place.</p>
                </div>
            </section>

            <div class="page-body">
                <div id="page-dashboard" class="page-content">

                    <div class="today-bar">
                        <div>
                            <div style="font-size:1rem;font-weight:800" id="todayTitle">☀️ Good morning, Dr. Mohammad!</div>
                            <div style="font-size:.85rem;opacity:.8">Wednesday, 11 March 2026</div>
                        </div>
                        <div class="today-stats" id="todayStats">
                            <div class="today-stat">
                                <div class="today-stat-val">24</div>
                                <div class="today-stat-label">Today's appointments</div>
                            </div>
                            <div class="today-stat">
                                <div class="today-stat-val">3</div>
                                <div class="today-stat-label">Active doctors</div>
                            </div>
                            <div class="today-stat">
                                <div class="today-stat-val">5</div>
                                <div class="today-stat-label">Pending approvals</div>
                            </div>
                        </div>
                        <a asp-controller="ClinicAdmin" asp-action="Appointments" class="today-action">View today's schedule →</a>
                    </div>

                    <div class="kpi-grid kpi-5" id="kpiGrid">
                        <div class="kpi-card green">
                            <div class="kpi-top"><div class="kpi-icon green">📅</div><span class="kpi-badge badge-up">↑ 5%</span></div>
                            <div class="kpi-val">638</div>
                            <div class="kpi-label">Appointments this month</div>
                            <div class="kpi-sub">Average 24 daily</div>
                        </div>
                        <div class="kpi-card blue">
                            <div class="kpi-top"><div class="kpi-icon blue">💰</div><span class="kpi-badge badge-up">↑ 8%</span></div>
                            <div class="kpi-val">840</div>
                            <div class="kpi-label">Monthly revenue (JOD)</div>
                            <div class="kpi-sub">Platform commission: 67 JOD</div>
                        </div>
                        <div class="kpi-card green">
                            <div class="kpi-top"><div class="kpi-icon green">👨‍⚕️</div></div>
                            <div class="kpi-val">5</div>
                            <div class="kpi-label">Active doctors</div>
                            <div class="kpi-sub">Out of 6 doctors</div>
                        </div>
                        <div class="kpi-card orange">
                            <div class="kpi-top"><div class="kpi-icon orange">⭐</div></div>
                            <div class="kpi-val">4.7</div>
                            <div class="kpi-label">Clinic rating</div>
                            <div class="kpi-sub">From 128 reviews</div>
                        </div>
                        <div class="kpi-card red">
                            <div class="kpi-top"><div class="kpi-icon red">❌</div><span class="kpi-badge badge-down">↑ 2%</span></div>
                            <div class="kpi-val">12%</div>
                            <div class="kpi-label">No-show rate</div>
                            <div class="kpi-sub">It was 23% before Waffy</div>
                        </div>
                    </div>

                    <div class="charts-row charts-3 mb">
                        <div class="chart-card">
                            <div class="chart-head">
                                <div>
                                    <div class="chart-title">📈 Monthly Appointments</div>
                                    <div class="chart-sub">Booked vs no-show</div>
                                </div>
                            </div>
                            <div class="chart-wrap h200"><canvas id="apptChart"></canvas></div>
                        </div>
                        <div class="chart-card">
                            <div class="chart-head">
                                <div><div class="chart-title">🍩 Most requested services</div></div>
                            </div>
                            <div class="chart-wrap h160" style="display:flex;justify-content:center">
                                <canvas id="servicesChart"></canvas>
                            </div>
                        </div>
                        <div class="sub-card" id="subCard">
                            <div style="font-size:.82rem;opacity:.8;margin-bottom:4px">Subscription plan</div>
                            <div style="font-family:'Readex Pro',sans-serif;font-size:1.4rem;font-weight:700;margin-bottom:10px">Basic plan</div>
                            <div style="font-size:.82rem;opacity:.9;margin-bottom:4px">✅ 3 doctors &nbsp;✅ Unlimited &nbsp;✅ 8% commission</div>
                            <div style="background:rgba(255,255,255,.2);border-radius:10px;height:6px;margin:10px 0 4px;overflow:hidden">
                                <div style="height:100%;width:70%;background:rgba(255,255,255,.8);border-radius:10px"></div>
                            </div>
                            <div style="font-size:.75rem;opacity:.75;margin-bottom:12px">47 / 67 appointments</div>
                            <button class="sub-upgrade">🚀 Upgrade to Pro</button>
                        </div>
                    </div>

                    <div class="grid-7-5">
                        <div class="table-card">
                            <div class="table-head-bar">
                                <div class="chart-title">📅 Today's upcoming appointments</div>
                                <a asp-controller="ClinicAdmin" asp-action="Appointments" class="btn btn-outline btn-sm">View all</a>
                            </div>
                            <div class="appt-item">
                                <div><div class="appt-time">09:00</div><div class="appt-time-sub">AM</div></div>
                                <div class="appt-divider"></div>
                                <div class="appt-pet" style="background:var(--gp)">🐕</div>
                                <div>
                                    <div class="appt-owner">Sarah Al-Khatib — Max</div>
                                    <div class="appt-sub">Labrador • Routine checkup</div>
                                </div>
                                <div class="appt-doctor">Dr. Ahmad Al-Zoubi</div>
                                <span class="status s-confirmed">Confirmed</span>
                                <div style="display:flex;gap:5px">
                                    <button class="btn btn-outline btn-sm">✅</button>
                                    <button class="btn btn-red btn-sm">✕</button>
                                </div>
                            </div>
                            <div class="appt-item">
                                <div><div class="appt-time">10:30</div><div class="appt-time-sub">AM</div></div>
                                <div class="appt-divider"></div>
                                <div class="appt-pet" style="background:#fce4ec">🐈</div>
                                <div>
                                    <div class="appt-owner">Ahmad Mansour — Luna</div>
                                    <div class="appt-sub">Persian cat • Vaccination</div>
                                </div>
                                <div class="appt-doctor">Dr. Sarah Al-Hussein</div>
                                <span class="status s-pending">Pending</span>
                                <div style="display:flex;gap:5px">
                                    <button class="btn btn-primary btn-sm">Accept</button>
                                    <button class="btn btn-red btn-sm">✕</button>
                                </div>
                            </div>
                            <div class="appt-item">
                                <div><div class="appt-time">11:00</div><div class="appt-time-sub">AM</div></div>
                                <div class="appt-divider"></div>
                                <div class="appt-pet" style="background:var(--bluep)">🐕</div>
                                <div>
                                    <div class="appt-owner">Rana Al-Salem — Buddy</div>
                                    <div class="appt-sub">Husky • Minor surgery</div>
                                </div>
                                <div class="appt-doctor">Dr. Ahmad Al-Zoubi</div>
                                <span class="status s-confirmed">Confirmed</span>
                                <div style="display:flex;gap:5px">
                                    <button class="btn btn-outline btn-sm">✅</button>
                                    <button class="btn btn-red btn-sm">✕</button>
                                </div>
                            </div>
                        </div>

                        <div class="chart-card">
                            <div class="chart-head">
                                <div><div class="chart-title">📊 Doctor Performance</div></div>
                            </div>
                            <div class="prog-row">
                                <div class="prog-label">Dr. Ahmad</div>
                                <div class="prog-bg"><div class="prog-fill" style="width:82%;background:var(--gm)"></div></div>
                                <div class="prog-val" style="color:var(--gd)">142</div>
                            </div>
                            <div class="prog-row">
                                <div class="prog-label">Dr. Sarah</div>
                                <div class="prog-bg"><div class="prog-fill" style="width:68%;background:var(--blue)"></div></div>
                                <div class="prog-val" style="color:var(--blue)">118</div>
                            </div>
                            <div class="prog-row">
                                <div class="prog-label">Dr. Mohammad</div>
                                <div class="prog-bg"><div class="prog-fill" style="width:54%;background:var(--ora)"></div></div>
                                <div class="prog-val" style="color:var(--ora)">94</div>
                            </div>
                            <div class="prog-row">
                                <div class="prog-label">Dr. Layla</div>
                                <div class="prog-bg"><div class="prog-fill" style="width:46%;background:var(--brownl)"></div></div>
                                <div class="prog-val" style="color:var(--brownl)">80</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

    {{-- ========== MODALS ========== --}}

    <div class="modal-overlay" id="modalAppt" onclick="closeOnBg(event,'modalAppt')">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">📅 New Appointment / Edit Appointment</div>
                <button class="modal-close" onclick="closeModal('modalAppt')">✕</button>
            </div>
            <div class="modal-body">
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Pet (Patient)</label>
                        <select class="f-inp">
                            <option>Choose a pet...</option>
                            <option>🐕 Max — Sarah Al-Khatib</option>
                            <option>🐈 Luna — Ahmad Mansour</option>
                            <option>🐕 Buddy — Rana Al-Salem</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Owner</label>
                        <input class="f-inp" placeholder="Owner name or phone number...">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Doctor</label>
                        <select class="f-inp">
                            <option>Choose a doctor...</option>
                            <option>Dr. Ahmad Al-Zoubi</option>
                            <option>Dr. Sarah Al-Hussein</option>
                            <option>Dr. Mohammad Salameh</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Service</label>
                        <select class="f-inp">
                            <option>Choose a service...</option>
                            <option>General checkup</option>
                            <option>Vaccination</option>
                            <option>Surgery</option>
                            <option>Dentistry</option>
                            <option>Lab Tests</option>
                            <option>X-Ray</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Appointment date</label>
                        <input class="f-inp" type="date">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Appointment time</label>
                        <input class="f-inp" type="time" value="09:00">
                    </div>
                    <div class="f-group">
                        <label class="f-label">Status</label>
                        <select class="f-inp">
                            <option>Scheduled — Scheduled</option>
                            <option>Completed — Completed</option>
                            <option>Cancelled — Cancelled</option>
                        </select>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Notes</label>
                        <textarea class="f-inp" placeholder="Any notes about the appointment..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('modalAppt')">Cancel</button>
                <button class="btn btn-primary">💾 Save Appointment</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalPet" onclick="closeOnBg(event,'modalPet')">
        <div class="modal modal-wide">
            <div class="modal-header">
                <div class="modal-title">🐾 Add / Edit Patient (Pet)</div>
                <button class="modal-close" onclick="closeModal('modalPet')">✕</button>
            </div>
            <div class="modal-body">
                <div class="sec-label">🐾 Pet Information</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Pet Name</label>
                        <input class="f-inp" placeholder="Example: Max">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Type</label>
                        <select class="f-inp">
                            <option>Choose a type...</option>
                            <option>🐕 Dog</option>
                            <option>🐈 Cat</option>
                            <option>🐦 Bird</option>
                            <option>🐇 Rabbit</option>
                            <option>🐠 Fish</option>
                            <option>🦎 Reptile</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Breed / Family</label>
                        <input class="f-inp" placeholder="Example: Labrador">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Gender</label>
                        <select class="f-inp">
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Age</label>
                        <input class="f-inp" placeholder="Example: 3 years / 6 months">
                    </div>
                    <div class="f-group">
                        <label class="f-label">Microchip ID</label>
                        <input class="f-inp" placeholder="Microchip number if available">
                        <div class="f-hint">🔍 Used to track lost pets</div>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">❤️ Health Status</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label">Vaccination status</label>
                        <select class="f-inp">
                            <option>Updated ✓</option>
                            <option>Expired — needs update</option>
                            <option>Unknown</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label">Overall Health Status</label>
                        <select class="f-inp">
                            <option>Healthy</option>
                            <option>Has a health issue</option>
                            <option>Under treatment</option>
                        </select>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Chronic health issues</label>
                        <textarea class="f-inp" placeholder="Example: diabetes, heart disease..."></textarea>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Allergies</label>
                        <textarea class="f-inp" placeholder="Example: allergy to some antibiotics..."></textarea>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">👤 Owner Information</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Owner Name</label>
                        <input class="f-inp" placeholder="Full name">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Phone Number</label>
                        <input class="f-inp" type="tel" placeholder="07XXXXXXXX">
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Email Address</label>
                        <input class="f-inp" type="email" placeholder="owner@email.com">
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">🖼 Pet Photo</div>
                <div class="upload-box">
                    <div class="upload-icon">📸</div>
                    <div class="upload-txt">Upload Pet Photo</div>
                    <div class="upload-sub">JPG, PNG — max 5MB</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('modalPet')">Cancel</button>
                <button class="btn btn-primary">💾 Save Patient</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalRecord" onclick="closeOnBg(event,'modalRecord')">
        <div class="modal modal-wide">
            <div class="modal-header">
                <div class="modal-title">📄 Add / Edit Medical Record</div>
                <button class="modal-close" onclick="closeModal('modalRecord')">✕</button>
            </div>
            <div class="modal-body">
                <div class="sec-label">🐾 Visit Information</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Pet</label>
                        <select class="f-inp">
                            <option>Choose a pet...</option>
                            <option>🐕 Max</option>
                            <option>🐈 Luna</option>
                            <option>🐕 Buddy</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Doctor</label>
                        <select class="f-inp">
                            <option>Dr. Ahmad Al-Zoubi</option>
                            <option>Dr. Sarah Al-Hussein</option>
                            <option>Dr. Mohammad Salameh</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Visit date</label>
                        <input class="f-inp" type="date">
                    </div>
                    <div class="f-group">
                        <label class="f-label">Follow-up date</label>
                        <input class="f-inp" type="date">
                        <div class="f-hint">📅 Added automatically to the calendar</div>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">🩺 Diagnosis</div>
                <div class="f-grid">
                    <div class="f-group f-full">
                        <label class="f-label"><span class="req">*</span>Diagnosis</label>
                        <textarea class="f-inp" placeholder="Diagnostic findings..."></textarea>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Symptoms</label>
                        <textarea class="f-inp" placeholder="Symptoms noticed by the owner or doctor..."></textarea>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">💊 Treatment</div>
                <div class="f-grid">
                    <div class="f-group f-full">
                        <label class="f-label">Treatment provided</label>
                        <textarea class="f-inp" placeholder="Completed treatment procedures..."></textarea>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Prescription</label>
                        <textarea class="f-inp" placeholder="Medication: name, dose, duration..."></textarea>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">💉 Vaccination</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label">Vaccine name</label>
                        <input class="f-inp" placeholder="Example: Rabies, FVR...">
                    </div>
                    <div class="f-group">
                        <label class="f-label">Next dose date</label>
                        <input class="f-inp" type="date">
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">📄 Files & Images</div>
                <div class="f-grid">
                    <div class="f-group">
                        <div class="upload-box">
                            <div class="upload-icon">🧪</div>
                            <div class="upload-txt">Lab Test Results</div>
                            <div class="upload-sub">PDF, JPG — max 10MB</div>
                        </div>
                    </div>
                    <div class="f-group">
                        <div class="upload-box">
                            <div class="upload-icon">🩻</div>
                            <div class="upload-txt">X-Ray images</div>
                            <div class="upload-sub">DICOM, JPG — max 20MB</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('modalRecord')">Cancel</button>
                <button class="btn btn-primary">💾 Save Record</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalDoctor" onclick="closeOnBg(event,'modalDoctor')">
        <div class="modal modal-wide">
            <div class="modal-header">
                <div class="modal-title">👨‍⚕️ Add Doctor (Manually)</div>
                <button class="modal-close" onclick="closeModal('modalDoctor')">✕</button>
            </div>
            <div class="modal-body">
                <div class="sec-label">👤 Personal Information</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Doctor Name</label>
                        <input class="f-inp" placeholder="Dr. Full Name">
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Phone Number</label>
                        <input class="f-inp" type="tel" placeholder="07XXXXXXXX">
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label"><span class="req">*</span>Email Address</label>
                        <input class="f-inp" type="email" placeholder="doctor@waffy.jo">
                    </div>
                    <div class="f-group f-full">
                        <div class="upload-box">
                            <div class="upload-icon">👤</div>
                            <div class="upload-txt">Professional profile image</div>
                            <div class="upload-sub">JPG, PNG — max 3MB</div>
                        </div>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">🎓 Professional Information</div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Specialty</label>
                        <select class="f-inp">
                            <option>Choose a specialty...</option>
                            <option>General Veterinary Medicine</option>
                            <option>Veterinary Surgery</option>
                            <option>Dermatology</option>
                            <option>Veterinary Dentistry</option>
                            <option>Bird &amp; Reptile Medicine</option>
                        </select>
                    </div>
                    <div class="f-group">
                        <label class="f-label"><span class="req">*</span>Years of experience</label>
                        <select class="f-inp">
                            <option>Less than 1 year</option>
                            <option>1–3 years</option>
                            <option>3–5 years</option>
                            <option>5–10 years</option>
                            <option>More than 10 years</option>
                        </select>
                    </div>
                    <div class="f-group f-full">
                        <label class="f-label">Certifications &amp; Qualifications</label>
                        <textarea class="f-inp" placeholder="Bachelor of Veterinary Medicine, certifications..."></textarea>
                    </div>
                </div>
                <hr class="sec-div">
                <div class="sec-label">🗓 Work Schedule</div>
                <div class="f-group">
                    <label class="f-label">Working Days</label>
                    <div class="days-row">
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Sunday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Monday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Tuesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Wednesday</div>
                        <div class="day-chip on" onclick="this.classList.toggle('on')">Thursday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Friday</div>
                        <div class="day-chip" onclick="this.classList.toggle('on')">Saturday</div>
                    </div>
                </div>
                <div class="f-grid">
                    <div class="f-group">
                        <label class="f-label">Start time</label>
                        <input class="f-inp" type="time" value="09:00">
                    </div>
                    <div class="f-group">
                        <label class="f-label">End time</label>
                        <input class="f-inp" type="time" value="17:00">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeModal('modalDoctor')">Cancel</button>
                <button class="btn btn-primary">💾 Add Doctor</button>
            </div>
        </div>
    </div>

