@model List<Waffy.Models.Notification>
@{
    ViewData["Title"] = "Waffy — Clinic Admin | Notifications";
    Layout = null;
    var unread = (int)(ViewBag.UnreadCount ?? 0);
    var total = (int)(ViewBag.TotalCount ?? 0);
    var notifs = Model ?? new List<Waffy.Models.Notification>();

    string TypeIcon(string? t) => t switch
    {
        "AppointmentConfirmed" => "✅",
        "AppointmentCancelledByClinic" => "❌",
        "AppointmentCompleted" => "🎉",
        "AppointmentNoShow" => "⚠️",
        "AppointmentReminder" => "🔔",
        "CliQPaymentConfirmed" => "💳",
        "DepositReturn" => "💰",
        "AdoptionApproved" => "🐾",
        "AdoptionRejected" => "❌",
        "AdminWarning" => "⚠️",
        "AdminSuspension" => "🔒",
        "AdminMessage" => "📢",
        _ => "🔔"
    };
    string TypeBg(string? t) => t switch
    {
        "AdminWarning" => "var(--orap)",
        "AdminSuspension" => "var(--redp)",
        "AdminMessage" => "var(--greap)",
        _ => "var(--surface-2)"
    };
    string TypeBorder(string? t) => t switch
    {
        "AdminWarning" => "rgba(191,122,35,.25)",
        "AdminSuspension" => "rgba(200,60,60,.25)",
        "AdminMessage" => "rgba(61,126,13,.2)",
        _ => "var(--line)"
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/AdminClinic&Doctor.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/AdminClinic-sidebar.css" asp-append-version="true">
    <style>
        .notif-card {
            display: flex;
            gap: 12px;
            align-items: flex-start;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid var(--line);
            margin-bottom: 8px;
            transition: box-shadow .15s;
            background: #fff;
        }

            .notif-card.unread {
                background: var(--olive-soft);
                border-color: rgba(151,173,77,.25);
            }

            .notif-card:hover {
                box-shadow: var(--shadow-sm);
            }

        .notif-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            flex-shrink: 0;
            background: var(--surface-2);
            display: grid;
            place-items: center;
            font-size: 1.1rem;
            border: 1px solid var(--line);
        }

        .notif-unread-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--olive);
            flex-shrink: 0;
            margin-top: 6px;
        }
    </style>
</head>
<body class="admin-shell">
    <div class="wa-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
    <div class="wa-shell" id="waShell">

        <!-- SIDEBAR -->
        <aside class="wa-sb" id="sidebar">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img" onerror="this.remove();this.parentElement.innerHTML='🐾';"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Clinic Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Dashboard", "ClinicAdmin")"><span class="sb-icon">📊</span><span class="sb-lbl">Dashboard</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Daily Management</div>
                    <a class="sb-row" href="@Url.Action("Appointments", "ClinicAdmin")"><span class="sb-icon">📅</span><span class="sb-lbl">Appointments</span></a>
                    <a class="sb-row" href="@Url.Action("Patients", "ClinicAdmin")"><span class="sb-icon">🐾</span><span class="sb-lbl">Patients</span></a>
                    <a class="sb-row" href="@Url.Action("Medical_Records", "ClinicAdmin")"><span class="sb-icon">📄</span><span class="sb-lbl">Medical Records</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Clinic Management</div>
                    <a class="sb-row" href="@Url.Action("Doctors", "ClinicAdmin")"><span class="sb-icon">👨‍⚕️</span><span class="sb-lbl">Doctors</span></a>
                    <a class="sb-row" href="@Url.Action("Basic_Information", "ClinicAdmin")"><span class="sb-icon">🏥</span><span class="sb-lbl">Clinic Settings</span></a>
                    <a class="sb-row" href="@Url.Action("Revenue", "ClinicAdmin")"><span class="sb-icon">💰</span><span class="sb-lbl">Revenue &amp; Payments</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" href="@Url.Action("Adoption", "ClinicAdmin")"><span class="sb-icon">🐕</span><span class="sb-lbl">Adoption</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Analytics</div>
                    <a class="sb-row" href="@Url.Action("Reports", "ClinicAdmin")"><span class="sb-icon">📈</span><span class="sb-lbl">Reports</span></a>
                    <a class="sb-row" href="@Url.Action("Reviews", "ClinicAdmin")"><span class="sb-icon">⭐</span><span class="sb-lbl">Reviews</span></a>
                    <a class="sb-row" href="@Url.Action("Complaints", "ClinicAdmin")"><span class="sb-icon">🚨</span><span class="sb-lbl">Complaints</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Settings</div>
                    <a class="sb-row" href="@Url.Action("Images", "ClinicAdmin")"><span class="sb-icon">🖼️</span><span class="sb-lbl">Images</span></a>
                    <a class="sb-row" href="@Url.Action("Services", "ClinicAdmin")"><span class="sb-icon">🔧</span><span class="sb-lbl">Services</span></a>
                    <a class="sb-row" href="@Url.Action("Working_Hours", "ClinicAdmin")"><span class="sb-icon">🕐</span><span class="sb-lbl">Working Hours</span></a>
                    <a class="sb-row" href="@Url.Action("Documents_C", "ClinicAdmin")"><span class="sb-icon">📋</span><span class="sb-lbl">Documents</span></a>
                    <a class="sb-row active" href="@Url.Action("Notifications", "ClinicAdmin")">
                        <span class="sb-icon">🔔</span><span class="sb-lbl">Notifications</span>
                        @if (unread > 0)
                        {
                            <span class="sb-bdg bd-o">@unread</span>
                        }
                    </a>
                    <a class="sb-row" href="@Url.Action("Logout", "ClinicAdmin")"><span class="sb-icon">🚪</span><span class="sb-lbl">Logout</span></a>
                </div>
            </nav>
        </aside>

        <!-- TOPNAV -->
        <header class="wa-tn">
            <button class="tn-toggle" type="button" onclick="toggleSidebar()">☰</button>
            <div class="tn-bread"><span>Clinic Admin</span><span>/</span><b>Notifications</b></div>
            <div class="tn-center">
                <div class="tn-center-main">Notifications</div>
                <div class="tn-center-sub">
                    @if (unread > 0)
                    {
                        <text>@unread unread</text>
                    }
                    else
                    {

                        <text>All caught up</text>
                    }
                </div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-identity">🏥 @(Context.Session.GetString("ClinicName") ?? "Clinic")</div>
            </div>
        </header>

        <!-- MAIN -->
        <main class="wa-main">

            <section class="page-hero page-hero-split">
                <div>
                    <h1>🔔 Notifications</h1>
                    <p>
                        @total notification@(total != 1 ? "s" : "")
                        @if (unread > 0)
                        {
                            <text> · <strong>@unread unread</strong></text>
                        }
                    </p>
                </div>
                @if (unread > 0)
                {
                    <div class="page-hero-actions">
                        <form method="post" asp-action="MarkAllNotificationsRead" asp-controller="ClinicAdmin">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline">✓ Mark all as read</button>
                        </form>
                    </div>
                }
            </section>

            <div class="page-body">

                @if (!notifs.Any())
                {
                    <div class="table-card" style="text-align:center;padding:56px 20px;">
                        <div style="font-size:3rem;margin-bottom:12px;">🔔</div>
                        <div style="font-family:'Fredoka',sans-serif;font-size:1.15rem;font-weight:700;color:var(--text);">
                            No notifications yet
                        </div>
                        <div style="font-size:.84rem;color:var(--text-muted);margin-top:6px;">
                            Appointment updates, admin messages, and alerts will appear here.
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-card" style="padding:14px 16px;">
                        @foreach (var n in notifs)
                        {
                            <div class="notif-card @(!n.IsRead ? "unread" : "")"
                                 style="background:@TypeBg(n.Type);border-color:@TypeBorder(n.Type);">

                                @* Unread dot *@
                                @if (!n.IsRead)
                                {
                                    <div class="notif-unread-dot"></div>
                                }

                                @* Icon *@
                                <div class="notif-icon">@TypeIcon(n.Type)</div>

                                @* Content *@
                                <div style="flex:1;min-width:0;">
                                    <div style="display:flex;align-items:center;
                                                    justify-content:space-between;flex-wrap:wrap;gap:4px;">
                                        <div style="font-weight:900;font-size:.88rem;color:var(--text);">
                                            @(n.Title ?? n.Type)
                                        </div>
                                        <div style="font-size:.73rem;font-weight:700;color:var(--text-muted);">
                                            @n.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(n.Message))
                                    {
                                        <div style="font-size:.83rem;color:var(--text-muted);
                                                            font-weight:700;margin-top:3px;line-height:1.55;">
                                            @n.Message
                                        </div>
                                    }
                                </div>

                                @* Mark read button *@
                                @if (!n.IsRead)
                                {
                                    <form method="post"
                                          asp-action="MarkNotificationRead"
                                          asp-controller="ClinicAdmin"
                                          style="flex-shrink:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button type="submit" class="btn btn-outline btn-sm"
                                                style="white-space:nowrap;font-size:.72rem;padding:4px 10px;">
                                            ✓ Read
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }

            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            document.getElementById('waShell').classList.toggle('sb-open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }
        function closeSidebar() {
            document.getElementById('waShell').classList.remove('sb-open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }
    </script>
</body>
</html>
