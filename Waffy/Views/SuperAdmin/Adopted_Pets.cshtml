                adoptedBy: 'Mohammad Al-Zubi', adopterPhone: '078-444-5566',
                city: 'Amman', adoptedDate: 'Mar 15, 2026', listedDate: 'Mar 1, 2026',
                followup: 'pending', followupNote: '',
                timeline: [
                    { label: 'Listed for adoption', date: 'Mar 1, 2026', color: 'var(--info)' },
                    { label: 'Adoption approved', date: 'Mar 12, 2026', color: 'var(--brand)' },
                    { label: 'Pet handed over to adopter', date: 'Mar 15, 2026', color: 'var(--success)' },
                ]
            },
            {
