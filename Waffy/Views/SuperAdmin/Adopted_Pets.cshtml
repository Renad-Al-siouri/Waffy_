                age: '2 years', gender: 'Male', health: 'Healthy',
                originalOwner: 'Pet Friends Store', source: 'store',
                adoptedBy: 'Lina Haddad', adopterPhone: '077-888-9900',
                city: 'Amman', adoptedDate: 'Feb 22, 2026', listedDate: 'Feb 10, 2026',
                followup: 'done', followupNote: 'Cat adapted well. Adopter very happy.',
                timeline: [
                    { label: 'Listed for adoption', date: 'Feb 10, 2026', color: 'var(--info)' },
                    { label: 'Adoption approved', date: 'Feb 20, 2026', color: 'var(--brand)' },
                    { label: 'Pet handed over', date: 'Feb 22, 2026', color: 'var(--success)' },
                    { label: 'Follow-up done — all good', date: 'Mar 5, 2026', color: 'var(--success)' },
                ]
            },
            {
                id: 4, name: 'Buddy', type: 'dog', emoji: '🐕',
                age: '3 years', gender: 'Male', health: 'Needs care',
                originalOwner: 'Karim Nassar', source: 'user',
                adoptedBy: 'Hana Al-Barakat', adopterPhone: '079-222-3344',
                city: 'Irbid', adoptedDate: 'Mar 2, 2026', listedDate: 'Feb 15, 2026',
                followup: 'pending', followupNote: '',
                timeline: [
                    { label: 'Listed for adoption', date: 'Feb 15, 2026', color: 'var(--info)' },
                    { label: 'Adoption approved', date: 'Feb 28, 2026', color: 'var(--brand)' },
                    { label: 'Pet handed over', date: 'Mar 2, 2026', color: 'var(--success)' },
                ]
            },
            {
                id: 5, name: 'Tweety', type: 'bird', emoji: '🐦',
                age: '8 months', gender: 'Male', health: 'Healthy',
                originalOwner: 'Al Noor Clinic', source: 'clinic',
                adoptedBy: 'Yousef Al-Masri', adopterPhone: '078-555-6677',
                city: 'Amman', adoptedDate: 'Jan 30, 2026', listedDate: 'Jan 10, 2026',
                followup: 'na', followupNote: 'N/A — short-term listing.',
                timeline: [
                    { label: 'Listed for adoption', date: 'Jan 10, 2026', color: 'var(--info)' },
                    { label: 'Adoption approved', date: 'Jan 25, 2026', color: 'var(--brand)' },
                    { label: 'Pet handed over', date: 'Jan 30, 2026', color: 'var(--success)' },
                ]
            },
        ];

        let selectedId = null;

        const srcBadge = s => {
            const m = {user:'badge-info',clinic:'badge-success',store:'badge-purple'};
            const l = {user:'👤 User',clinic:'🏥 Clinic',store:'🏪 Store'};
            return `<span class="badge ${m[s]||'badge-muted'}">${l[s]||s}</span>`;
        };
        const fuBadge = f => {
            if (f==='done')    return `<span class="fu-chip" style="background:var(--success-soft);color:#2e7d32;">✅ Done</span>`;
            if (f==='pending') return `<span class="fu-chip" style="background:var(--warning-soft);color:#9b6000;">⏳ Pending</span>`;
            return `<span class="fu-chip" style="background:var(--surface-2);color:var(--text-muted);">— N/A</span>`;
        };

        function render() {
            const q    = (document.getElementById('searchInput')?.value || '').toLowerCase();
            const type = document.getElementById('typeFilter')?.value   || '';
            const fu   = document.getElementById('fuFilter')?.value     || '';

            const filtered = pets.filter(p => {
                const mQ  = !q    || p.name.toLowerCase().includes(q) || p.adoptedBy.toLowerCase().includes(q) || p.city.toLowerCase().includes(q);
                const mT  = !type || p.type === type;
                const mFu = !fu   || p.followup === fu;
                return mQ && mT && mFu;
            });

            const tbody = document.getElementById('tableBody');
            tbody.innerHTML = filtered.length ? filtered.map(p => `
                <tr style="cursor:pointer;" onclick="openDetail(${p.id})">
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="pet-ava">${p.emoji}</div>
                            <div><div class="cell-title">${p.name}</div><div class="cell-sub">${p.age} · ${p.gender}</div></div>
                        </div>
                    </td>
                    <td>${p.emoji} ${p.type.charAt(0).toUpperCase()+p.type.slice(1)}</td>
                    <td><div style="font-weight:800;font-size:.86rem;color:var(--brand-dark);">${p.adoptedBy}</div><div class="cell-sub">${p.city}</div></td>
                    <td style="font-size:.82rem;color:var(--text-muted);">${p.originalOwner}</td>
                    <td>${p.city}</td>
                    <td style="font-size:.82rem;color:var(--text-muted);">${p.adoptedDate}</td>
                    <td>${fuBadge(p.followup)}</td>
                    <td>
                        <div class="action-group" onclick="event.stopPropagation()">
                            <button class="btn btn-outline btn-xs" onclick="openDetail(${p.id})">👁 View</button>
                            ${p.followup === 'pending' ? `<button class="btn btn-success btn-xs" onclick="quickDone(${p.id})">✅ Done</button>` : ''}
                        </div>
                    </td>
                </tr>`).join('')
            : `<tr><td colspan="8" style="text-align:center;padding:28px;color:var(--text-muted);">No adopted pets found.</td></tr>`;

            document.getElementById('tableCount').textContent = filtered.length + ' pets';
            renderKpis();
        }

        function renderKpis() {
            document.getElementById('kpiTotal').textContent      = pets.length;
            document.getElementById('kpiMonth').textContent      = pets.filter(p => p.adoptedDate.includes('Mar 2026')).length;
            document.getElementById('kpiFollowedUp').textContent = pets.filter(p => p.followup === 'done').length;
            document.getElementById('kpiPending').textContent    = pets.filter(p => p.followup === 'pending').length;
        }

        function openDetail(id) {
            const p = pets.find(x => x.id === id);
            if (!p) return;
            selectedId = id;

            document.getElementById('detailTitle').textContent = `${p.emoji} ${p.name}`;
            document.getElementById('dAva').textContent        = p.emoji;
            document.getElementById('dName').textContent       = p.name;
            document.getElementById('dMeta').textContent       = `${p.age} · ${p.gender} · ${p.health}`;
            document.getElementById('dBadges').innerHTML       = `<span class="badge badge-success">🏠 Adopted</span> ${srcBadge(p.source)}`;

            document.getElementById('dInfo').innerHTML = [
                { label:'Adopted By',    val: p.adoptedBy },
                { label:'Phone',         val: p.adopterPhone },
                { label:'City',          val: p.city },
                { label:'Adoption Date', val: p.adoptedDate },
                { label:'Listed Date',   val: p.listedDate },
                { label:'Original Owner',val: p.originalOwner },
            ].map(r => `<div class="dp-info-item"><div class="dp-info-label">${r.label}</div><div class="dp-info-val">${r.val}</div></div>`).join('');

            const fuColors = {
                done:    { bg:'var(--success-soft)', color:'#2e7d32',           text:'✅ Follow-up completed — pet is doing well.' },
                pending: { bg:'var(--warning-soft)', color:'#9b6000',           text:'⏳ Follow-up not yet completed.' },
                na:      { bg:'var(--surface-2)',    color:'var(--text-muted)', text:'— Follow-up not required for this listing.' },
            };
            const fc = fuColors[p.followup];
            document.getElementById('dFollowupStatus').innerHTML = `
                <div style="background:${fc.bg};border-radius:10px;padding:12px 14px;font-size:.84rem;font-weight:800;color:${fc.color};">${fc.text}</div>
                ${p.followupNote ? `<div style="margin-top:8px;font-size:.82rem;color:var(--text-muted);font-weight:700;">${p.followupNote}</div>` : ''}`;

            document.getElementById('fuSelect').value = p.followup;
            document.getElementById('fuNote').value   = p.followupNote || '';

            document.getElementById('dTimeline').innerHTML = p.timeline.map(t => `
                <div class="tl-row">
                    <div class="tl-dot" style="background:${t.color};"></div>
                    <div>
                        <div style="font-size:.84rem;font-weight:800;">${t.label}</div>
                        <div style="font-size:.74rem;color:var(--text-muted);margin-top:2px;">${t.date}</div>
                    </div>
                </div>`).join('');

            document.getElementById('detailModal').classList.add('open');
        }

        function closeDetail() { document.getElementById('detailModal').classList.remove('open'); }

        function saveFollowup() {
            const p = pets.find(x => x.id === selectedId);
            if (!p) return;
            p.followup     = document.getElementById('fuSelect').value;
            p.followupNote = document.getElementById('fuNote').value.trim();
            closeDetail(); render();
            showToast('💾 Follow-up updated!');
        }

        function quickDone(id) {
            const p = pets.find(x => x.id === id);
            if (!p) return;
            p.followup = 'done'; render();
            showToast(`✅ ${p.name} — follow-up marked as done!`);
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').selectedIndex = 0;
            document.getElementById('fuFilter').selectedIndex   = 0;
            render();
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg; t.style.display = 'flex';
            setTimeout(() => t.style.display = 'none', 3000);
        }

        render();
    </script>
</body>
</html>
