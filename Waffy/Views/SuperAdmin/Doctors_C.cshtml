@model Waffy.Models.ViewModels.DoctorsAdminViewModel
@{
    ViewData["Title"] = "Waffy — Super Admin | Doctors";
    Layout = null;
    var adminName = ViewBag.AdminName as string ?? "Admin";
    var adminInitials = ViewBag.AdminInitials as string ?? "AD";

    bool IsImg(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        var e = System.IO.Path.GetExtension(url).ToLowerInvariant();
        return e is ".jpg" or ".jpeg" or ".png" or ".webp";
    }

    string StatusBadgeCls(string? s) => s?.ToLower() switch
    {
        "approved" => "s-confirmed",
        "rejected" => "s-cancelled",
        _ => "s-pending"
    };
    string StatusLabel(string? s) => s?.ToLower() switch
    {
        "approved" => "✅ Approved",
        "rejected" => "❌ Rejected",
        _ => "⏳ Pending"
    };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        .cert-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 8px;
            background: var(--brand-ghost);
            color: var(--brand-dark);
            font-size: .75rem;
            font-weight: 800;
            text-decoration: none;
            border: 1px solid var(--brand-light);
        }

            .cert-link:hover {
                background: var(--brand-light);
            }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR ══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-clinics" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Doctors_C">
                                    <span class="sb-dot"></span><span class="sb-child-lbl">Doctors</span>
                                    @if (Model.PendingDoctors > 0)
                                    {
                                        <span class="sb-bdg bd-y">@Model.PendingDoctors</span>
                                    }
                                </a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span>
                        <span class="sb-lbl">Notifications</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@adminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@adminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ══ TOPNAV ══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <nav class="tn-bread">
                <span>Clinics</span><span>/</span>
                <a asp-controller="SuperAdmin" asp-action="Clinics" style="color:var(--text-muted);font-weight:800;">All Clinics</a>
                <span>/</span><b>Doctors</b>
            </nav>
            <div class="tn-center">
                <div class="tn-center-main">Doctor Management</div>
                <div class="tn-center-sub">Approve or reject clinic doctors</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-profile">
                    <div class="tn-av">@adminInitials</div>
                    <div>
                        <div class="tn-pname">@adminName</div>
                        <div class="tn-prole">Super Admin</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ══ MAIN ══ -->
        <main class="wa-main" id="waMain">

            @if (ViewBag.Success != null)
            {
                <div id="flashMsg" style="position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;
                     border-radius:14px;background:var(--success-soft);border:1px solid rgba(76,175,80,.3);
                     color:var(--success);font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;
                     box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;">
                    @ViewBag.Success
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div id="flashMsg" style="position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;
                     border-radius:14px;background:var(--danger-soft);border:1px solid rgba(244,67,54,.3);
                     color:var(--danger);font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;
                     box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;">
                    @ViewBag.Error
                </div>
            }

            <section class="page-hero">
                <div>
                    <h1>Doctor Management</h1>
                    <p>Review and approve doctors registered by clinic admins.</p>
                </div>
            </section>

            <div class="page-body">

                @* ── Pending Documents Reminder ── *@
                @if (Model.ClinicsWithPendingDocs > 0)
                {
                    <div style="background:#fff8e1;border:1.5px solid #f0c040;border-radius:14px;
                                padding:14px 18px;margin-bottom:14px;display:flex;
                                align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                        <div>
                            <div style="font-weight:900;color:#b8860b;">
                                📋 @Model.ClinicsWithPendingDocs clinic(s) have pending documents awaiting review
                            </div>
                            <div style="font-size:.78rem;color:#9b7a00;font-weight:700;margin-top:3px;">
                                Review clinic documents before approving their doctors
                            </div>
                        </div>
                        <a asp-controller="SuperAdmin" asp-action="Clinics"
                           asp-route-statusFilter="Pending"
                           class="btn btn-outline btn-sm">
                            📋 Review Clinic Documents →
                        </a>
                    </div>
                }

                @* ── KPI Cards ── *@
                <div class="kpi-grid kpi-grid-4" style="margin-bottom:14px;">
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">👨‍⚕️</div>
                        <div class="kpi-val">@Model.TotalDoctors</div>
                        <div class="kpi-label">Total Doctors</div>
                    </div>
                    <div class="kpi-card c3">
                        <div class="kpi-ico yellow">⏳</div>
                        <div class="kpi-val">@Model.PendingDoctors</div>
                        <div class="kpi-label">Pending Approval</div>
                        <div class="kpi-chip chip-yellow">
                            @(Model.PendingDoctors > 0 ? "Needs review" : "All clear ✓")
                        </div>
                    </div>
                    <div class="kpi-card c2">
                        <div class="kpi-ico blue">✅</div>
                        <div class="kpi-val">@Model.ApprovedDoctors</div>
                        <div class="kpi-label">Approved</div>
                    </div>
                    <div class="kpi-card c4">
                        <div class="kpi-ico red">❌</div>
                        <div class="kpi-val">@Model.RejectedDoctors</div>
                        <div class="kpi-label">Rejected</div>
                    </div>
                </div>

                @* ── Filter Form ── *@
                <form method="get" asp-action="Doctors_C"
                      style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
                    <select name="statusFilter" class="sel-wrap"
                            style="width:auto;min-width:160px;"
                            onchange="this.form.submit()">

                        @if (Model.StatusFilter == "All")
                        {
                            <option value="All" selected>All Statuses</option>
                        }
                        else
                        {
                            <option value="All">All Statuses</option>
                        }

                        @if (Model.StatusFilter == "Pending")
                        {
                            <option value="Pending" selected>⏳ Pending</option>
                        }
                        else
                        {
                            <option value="Pending">⏳ Pending</option>
                        }

                        @if (Model.StatusFilter == "Approved")
                        {
                            <option value="Approved" selected>✅ Approved</option>
                        }
                        else
                        {
                            <option value="Approved">✅ Approved</option>
                        }

                        @if (Model.StatusFilter == "Rejected")
                        {
                            <option value="Rejected" selected>❌ Rejected</option>
                        }
                        else
                        {
                            <option value="Rejected">❌ Rejected</option>
                        }

                    </select>
                </form>

                @* ── Table ── *@
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">👨‍⚕️ Doctors</div>
                        <div style="font-size:.78rem;font-weight:700;color:var(--text-muted);">
                            @Model.Doctors.Count result(s)
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Doctor</th>
                                    <th>Clinic</th>
                                    <th>Specialization</th>
                                    <th>Experience</th>
                                    <th>Certification</th>
                                    <th>Status</th>
                                    <th>Registered</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Doctors.Any())
                                {
                                    <tr>
                                        <td colspan="8" style="text-align:center;padding:32px;
                                            color:var(--text-muted);font-weight:700;">
                                            No doctors found.
                                        </td>
                                    </tr>
                                }
                                @foreach (var doc in Model.Doctors)
                                {
                                    <tr>
                                        <td>
                                            <div style="font-weight:900;font-size:.88rem;">
                                                Dr. @doc.FullName
                                            </div>
                                            <div style="font-size:.75rem;color:var(--text-muted);">
                                                @doc.Email
                                            </div>
                                        </td>
                                        <td>
                                            @if (doc.IdClinic.HasValue)
                                            {
                                                <a asp-controller="SuperAdmin" asp-action="Details_C"
                                                   asp-route-id="@doc.IdClinic"
                                                   style="font-weight:800;font-size:.84rem;
                                                              color:var(--brand-dark);">
                                                    🏥 @(doc.ClinicName ?? "—")
                                                </a>
                                            }
                                            else
                                            {
                                                <span style="color:var(--text-muted);">—</span>
                                            }
                                    </td>
                                    <td style="font-size:.82rem;color:var(--text-muted);font-weight:700;">
                                        @(doc.Specialization ?? "—")
                                    </td>
                                    <td style="font-size:.82rem;color:var(--text-muted);font-weight:700;">
                                        @(doc.ExperienceYears.HasValue
                                                                                ? $"{doc.ExperienceYears} yrs" : "—")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(doc.Certifications))
                                            {
                                                <a href="@doc.Certifications" target="_blank"
                                                   class="cert-link">
                                                    @(IsImg(doc.Certifications) ? "🖼" : "📄") View File
                                                </a>
                                            }
                                            else
                                            {
                                                <span style="font-size:.75rem;color:var(--text-muted);">
                                                    — not uploaded
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="status @StatusBadgeCls(doc.VerificationStatus)">
                                                @StatusLabel(doc.VerificationStatus)
                                            </span>
                                        </td>
                                        <td style="font-size:.78rem;color:var(--text-muted);font-weight:700;">
                                            @doc.CreatedAt?.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            <div style="display:flex;gap:5px;flex-wrap:wrap;">
                                                <a asp-controller="SuperAdmin" asp-action="Details_D"
                                                   asp-route-id="@doc.IdDoctor"
                                                   class="btn btn-outline btn-xs"
                                                   style="text-decoration:none;">
                                                    👁 View
                                                </a>

                                                @if (doc.VerificationStatus?.ToLower() == "pending")
                                                {
                                                    @* Approve *@
                                                    <form asp-controller="SuperAdmin"
                                                          asp-action="ApproveDoctor"
                                                          method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idDoctor" value="@doc.IdDoctor" />
                                                        <input type="hidden" name="idUser" value="@doc.IdUser" />
                                                        <input type="hidden" name="clinicName" value="@doc.ClinicName" />
                                                        <button type="submit" class="btn btn-primary btn-xs"
                                                                onclick="return confirm('Approve Dr. @doc.FullName.Replace("'", "\\'")?')">
                                                            ✅ Approve
                                                        </button>
                                                    </form>

                                                    @* Reject *@
                                                    <button class="btn btn-danger btn-xs"
                                                            onclick="openRejectModal(@doc.IdDoctor, @(doc.IdUser ?? 0), '@doc.FullName.Replace("'", "\\'")','@((doc.ClinicName ?? "").Replace("'", "\\'"))' )">
                                                        ❌ Reject
                                                    </button>
                                                }
                                                else if (doc.VerificationStatus?.ToLower() == "rejected")
                                                {
                                                    @* Re-approve *@
                                                    <form asp-controller="SuperAdmin"
                                                          asp-action="ApproveDoctor"
                                                          method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idDoctor" value="@doc.IdDoctor" />
                                                        <input type="hidden" name="idUser" value="@doc.IdUser" />
                                                        <input type="hidden" name="clinicName" value="@doc.ClinicName" />
                                                        <button type="submit" class="btn btn-primary btn-xs">
                                                            ↩ Re-approve
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    @* ── Reject Modal ── *@
    <div class="modal-overlay" id="rejectModal">
        <div class="modal-box" style="max-width:460px;">
            <div class="modal-head">
                <div class="modal-title">❌ Reject Doctor</div>
                <button class="dp-close" onclick="closeRejectModal()">✕</button>
            </div>
            <div style="padding:20px;">
                <p style="font-size:.83rem;color:var(--text-muted);font-weight:700;margin-bottom:14px;">
                    Doctor: <strong id="rejectDoctorName"></strong>
                </p>
                <form asp-controller="SuperAdmin" asp-action="RejectDoctor"
                      method="post" id="rejectForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idDoctor" id="rejectIdDoctor" />
                    <input type="hidden" name="idUser" id="rejectIdUser" />
                    <input type="hidden" name="clinicName" id="rejectClinicName" />

                    <div style="margin-bottom:12px;">
                        <label style="display:block;font-size:.78rem;font-weight:800;
                                  color:var(--text-muted);margin-bottom:5px;">
                            Rejection Reason
                        </label>
                        <select name="reason" class="sel-wrap" style="width:100%;">
                            <option value="Incomplete or invalid certifications">
                                Incomplete or invalid certifications
                            </option>
                            <option value="Unverified credentials">Unverified credentials</option>
                            <option value="Does not meet requirements">
                                Does not meet requirements
                            </option>
                            <option value="Duplicate profile">Duplicate profile</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
                        <button type="button" class="btn btn-outline btn-sm"
                                onclick="closeRejectModal()">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-danger btn-sm">
                            ❌ Reject & Notify
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        function openRejectModal(idDoctor, idUser, doctorName, clinicName) {
            document.getElementById("rejectIdDoctor").value  = idDoctor;
            document.getElementById("rejectIdUser").value    = idUser;
            document.getElementById("rejectDoctorName").textContent = doctorName;
            document.getElementById("rejectClinicName").value = clinicName;
            document.getElementById("rejectModal").classList.add("open");
        }
        function closeRejectModal() {
            document.getElementById("rejectModal").classList.remove("open");
        }
        document.getElementById("rejectModal").addEventListener("click", e => {
            if (e.target === document.getElementById("rejectModal"))
                closeRejectModal();
        });

        const fm = document.getElementById("flashMsg");
        if (fm) {
            setTimeout(() => fm.style.opacity = "0", 3500);
            setTimeout(() => fm.remove(), 3900);
        }
    </script>
</body>
</html>