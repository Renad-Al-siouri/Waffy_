          {id:3,name:'Rio',type:'bird',emoji:'🐦',breed:'Parrot',city:'Irbid',owner:'Lama Hussein',ownerPhone:'077-888-9900',date:'Mar 5, 2026',reward:0,status:'found',fraud:false,secretQ:'What color is the cage?',secretA:'Green',finderPhone:'077-111-0000',ownerEnteredPhone:'077-111-0000'},
          {id:4,name:'Max',type:'dog',emoji:'🐕',breed:'Labrador',city:'Amman',owner:'Karim Saeed',ownerPhone:'079-222-3344',date:'Mar 3, 2026',reward:50,status:'active',fraud:true,secretQ:'Does the pet have a chip?',secretA:'No',finderPhone:'',ownerEnteredPhone:''},
          {id:5,name:'Fluffy',type:'cat',emoji:'🐈',breed:'Mixed',city:'Amman',owner:'Nour Al-Ahmad',ownerPhone:'079-555-6677',date:'Mar 12, 2026',reward:15,status:'pending',fraud:false,secretQ:"What is the pet's nickname?",secretA:'Fluff',finderPhone:'',ownerEnteredPhone:''},
          {id:6,name:'Kiwi',type:'bird',emoji:'🐦',breed:'Cockatiel',city:'Zarqa',owner:'Rana Haddad',ownerPhone:'078-777-8899',date:'Mar 11, 2026',reward:5,status:'verify',fraud:false,secretQ:'What does the pet eat?',secretA:'Seeds',finderPhone:'078-321-0000',ownerEnteredPhone:'078-321-0000'},
          {id:7,name:'Rex',type:'dog',emoji:'🐕',breed:'German Shepherd',city:'Irbid',owner:'Firas Mansour',ownerPhone:'079-000-1122',date:'Mar 9, 2026',reward:30,status:'pending',fraud:false,secretQ:'What color is the collar?',secretA:'Red',finderPhone:'',ownerEnteredPhone:''},
          {id:8,name:'Luna',type:'cat',emoji:'🐈',breed:'Siamese',city:'Amman',owner:'Sara Al-Khaldi',ownerPhone:'079-111-2233',date:'Mar 7, 2026',reward:20,status:'rejected',fraud:false,secretQ:'Is the pet indoor?',secretA:'Yes',finderPhone:'',ownerEnteredPhone:''},
        ];
        let selectedId=null,currentTab='all';
        function statusBadge(s,fraud){const map={pending:['badge-warning','⏳ Pending'],active:['badge-success','● Active'],verify:['badge-info','🔐 Verify'],found:['badge-success','✅ Found'],rejected:['badge-danger','❌ Rejected'],fake:['badge-danger','🚩 Fake']};const[cls,lbl]=map[s]||['badge-muted',s];const fraudBadge=fraud?`<span class="badge badge-danger" style="margin-left:4px;">🚩 Fraud?</span>`:'';return`<span class="badge ${cls}">${lbl}</span>${fraudBadge}`;}
        function render(){
          const q=(document.getElementById('searchInput')?.value||'').toLowerCase();
          const type=document.getElementById('typeFilter')?.value||'';
          const city=document.getElementById('cityFilter')?.value||'';
          const filtered=pets.filter(p=>{
            const mQ=!q||p.name.toLowerCase().includes(q)||p.owner.toLowerCase().includes(q);
            const mType=!type||p.type===type;
            const mCity=!city||p.city===city;
            const mTab=currentTab==='all'?true:currentTab==='pending'?p.status==='pending':currentTab==='verify'?p.status==='verify':currentTab==='found'?p.status==='found':true;
            return mQ&&mType&&mCity&&mTab;
          });
          const tbody=document.getElementById('tableBody');
          tbody.innerHTML=filtered.length?filtered.map(p=>`
            <tr style="cursor:pointer;${p.fraud?'background:#fffcf3;':''}" onclick="openDetail(${p.id})">
              <td><div style="display:flex;align-items:center;gap:10px;"><div class="lost-ava">${p.emoji}</div><div><div class="cell-title">${p.name}</div><div class="cell-sub">${p.breed}</div></div></div></td>
              <td>${p.emoji} ${p.type.charAt(0).toUpperCase()+p.type.slice(1)}</td>
              <td><div style="font-weight:800;font-size:.86rem;">${p.owner}</div><div class="cell-sub">${p.ownerPhone}</div></td>
              <td>${p.city}</td>
              <td style="font-weight:800;color:var(--brand-dark);">${p.reward>0?p.reward+' JOD':'—'}</td>
              <td style="color:var(--text-muted);font-size:.8rem;">${p.date}</td>
              <td>${statusBadge(p.status,p.fraud)}</td>
              <td><div class="action-group" onclick="event.stopPropagation()">
                <button class="btn btn-outline btn-xs" onclick="openDetail(${p.id})">👁 View</button>
                ${p.status==='pending'?`<button class="btn btn-success btn-xs" onclick="quickApprove(${p.id})">✅</button>`:''}
                ${p.status==='verify'?`<button class="btn btn-info btn-xs" onclick="openDetail(${p.id})">🔐 Verify</button>`:''}
              </div></td>
            </tr>`).join(''):`<tr><td colspan="8" style="text-align:center;padding:28px;color:var(--text-muted);">No reports found.</td></tr>`;
          document.getElementById('tableCount').textContent=filtered.length+' reports';
          document.getElementById('tabAll').textContent=pets.length;
          document.getElementById('tabPending').textContent=pets.filter(p=>p.status==='pending').length;
          document.getElementById('tabVerify').textContent=pets.filter(p=>p.status==='verify').length;
          document.getElementById('tabFound').textContent=pets.filter(p=>p.status==='found').length;
          document.getElementById('kpiMissing').textContent=pets.filter(p=>p.status==='active').length;
          document.getElementById('kpiPending').textContent=pets.filter(p=>p.status==='pending').length;
          document.getElementById('kpiFraud').textContent=pets.filter(p=>p.fraud).length;
        }
        function setTab(btn,tab){document.querySelectorAll('.tabs-bar .tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');currentTab=tab;render();}
        function resetFilters(){document.getElementById('searchInput').value='';document.getElementById('typeFilter').selectedIndex=0;document.getElementById('cityFilter').selectedIndex=0;render();}
        function openDetail(id){
          const p=pets.find(x=>x.id===id);if(!p)return;selectedId=id;
          document.getElementById('dTitle').textContent=`${p.emoji} ${p.name} — Lost ${p.type}`;
          document.getElementById('dGridInfo').innerHTML=`
            <div class="dp-section" style="margin:0;"><div class="dp-section-title">Pet Info</div>
              <div class="info-row"><span class="info-key">Name</span><span class="info-val">${p.name}</span></div>
              <div class="info-row"><span class="info-key">Type / Breed</span><span class="info-val">${p.emoji} ${p.breed}</span></div>
              <div class="info-row"><span class="info-key">City</span><span class="info-val">📍 ${p.city}</span></div>
              <div class="info-row"><span class="info-key">Lost Date</span><span class="info-val">${p.date}</span></div>
              <div class="info-row"><span class="info-key">Reward</span><span class="info-val">${p.reward>0?p.reward+' JOD':'—'}</span></div>
            </div>
            <div class="dp-section" style="margin:0;"><div class="dp-section-title">Owner Info</div>
              <div class="info-row"><span class="info-key">Owner</span><span class="info-val">${p.owner}</span></div>
              <div class="info-row"><span class="info-key">Phone</span><span class="info-val">${p.ownerPhone}</span></div>
              <div class="info-row"><span class="info-key">Status</span><span class="info-val">${statusBadge(p.status,p.fraud)}</span></div>
              ${p.fraud?`<div class="info-row"><span class="info-key">⚠️ Fraud Flag</span><span class="info-val" style="color:var(--danger);">Suspected</span></div>`:''}
            </div>`;
          document.getElementById('dPrivate').innerHTML=`
            <div class="info-row"><span class="info-key">🔑 Secret Question</span><span class="info-val">${p.secretQ}</span></div>
            <div class="info-row"><span class="info-key">✅ Correct Answer</span><span class="info-val">${p.secretA}</span></div>`;
          const vSec=document.getElementById('dVerifySection'),btnConfirm=document.getElementById('btnConfirmFound'),btnApprove=document.getElementById('btnApprove');
          if(p.status==='verify'){
            vSec.style.display='block';
            const phoneMatch=p.finderPhone===p.ownerEnteredPhone&&p.finderPhone!=='';
            document.getElementById('dSecretAnswer').textContent=p.secretA||'—';
            document.getElementById('dFinderPhone').textContent=p.finderPhone||'Not entered';
            document.getElementById('dOwnerPhone').textContent=p.ownerEnteredPhone||'Not entered';
            document.getElementById('dSysMatch').textContent=phoneMatch?'✅ Matched':'❌ Not Matched';
            const mb=document.getElementById('dMatchBox');
            mb.className='match-box '+(phoneMatch?'match-ok':'match-fail');
            mb.textContent=phoneMatch?'✅ Phone and answer matched — system verified!':'❌ No match yet — waiting for both parties to submit.';
            btnConfirm.style.display=phoneMatch?'inline-flex':'none';btnApprove.style.display='none';
          }else{vSec.style.display='none';btnConfirm.style.display='none';btnApprove.style.display=p.status==='pending'?'inline-flex':'none';}
          document.getElementById('dStatusSel').value=p.status;
          openModal('detailModal');
        }
        function quickApprove(id){const p=pets.find(x=>x.id===id);if(!p)return;p.status='active';render();showToast(`✅ ${p.name}'s report approved and published!`);}
        function approveReport(){const p=pets.find(x=>x.id===selectedId);if(!p)return;p.status='active';closeModal('detailModal');render();showToast(`✅ ${p.name}'s report approved!`);}
        function confirmFound(){const p=pets.find(x=>x.id===selectedId);if(!p)return;p.status='found';closeModal('detailModal');render();showToast(`🎉 ${p.name} confirmed found! Reward of ${p.reward} JOD released.`);}
        function markFake(){const p=pets.find(x=>x.id===selectedId);if(!p||!confirm(`Mark ${p.name}'s report as fake?`))return;p.status='fake';p.fraud=true;closeModal('detailModal');render();showToast('🚩 Report marked as fake.');}
        function saveStatus(){const p=pets.find(x=>x.id===selectedId);if(!p)return;p.status=document.getElementById('dStatusSel').value;closeModal('detailModal');render();showToast('💾 Status updated!');}
        function sendReject(){const p=pets.find(x=>x.id===selectedId);if(p)p.status='rejected';closeModal('rejectModal');closeModal('detailModal');render();showToast('📨 Edit request sent to owner.');}
        function openModal(id){document.getElementById(id).classList.add('open');}
        function closeModal(id){document.getElementById(id).classList.remove('open');}
        function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='flex';setTimeout(()=>t.style.display='none',3000);}
        render();
    </script>
</body>
</html>
