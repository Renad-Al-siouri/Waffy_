@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | Lost Pets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        .lost-ava {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--brand-xlight);
            border: 1px solid var(--brand-light);
            display: grid;
            place-items: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .match-box {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: var(--r);
            font-size: .83rem;
            font-weight: 800;
        }

        .match-ok {
            background: var(--success-soft);
            color: #2e7d32;
            border: 1px solid rgba(47,158,95,.2);
        }

        .match-fail {
            background: var(--danger-soft);
            color: var(--danger);
            border: 1px solid rgba(217,83,79,.2);
        }

        .match-wait {
            background: var(--warning-soft);
            color: #9b6000;
            border: 1px solid rgba(226,163,58,.2);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid rgba(221,209,191,.5);
            font-size: .83rem;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-key {
            color: var(--text-muted);
            font-weight: 700;
        }

        .info-val {
            font-weight: 900;
            color: var(--brand-dark);
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo"><div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div><div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div></div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat"><a class="sb-row" href="@Url.Action("Dashboard", "SuperAdmin")" data-tip="Dashboard"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span><span class="sb-lbl">Dashboard</span></a></div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div><button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span><span class="sb-lbl">Users</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-users"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Users", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a></div></div></div>
                    <div><button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span><span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-clinics"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Clinics", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a><a class="sb-child" href="@Url.Action("Reviews_Complaints_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews & Complaints</span></a><a class="sb-child" href="@Url.Action("Analytics_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div><button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span><span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-shop"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Stores", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span><span class="sb-bdg bd-y sb-child-bdg">3</span></a><a class="sb-child" href="@Url.Action("Reviews_Complaints_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews & Complaints</span><span class="sb-bdg bd-r sb-child-bdg">6</span></a><a class="sb-child" href="@Url.Action("Analytics_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div><button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span><span class="sb-lbl">Adoption</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-adopt"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Listings", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a><a class="sb-child" href="@Url.Action("Flagged", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a><a class="sb-child" href="@Url.Action("Adopted_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a><a class="sb-child" href="@Url.Action("Analytics_A", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div>
                        <button class="sb-row open active" id="t-rep" onclick="acc('g-rep','t-rep')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span><span class="sb-lbl">Reports</span><span class="sb-bdg bd-y">8</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button>
                        <div class="sb-sub open" id="g-rep" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" href="@Url.Action("Lost_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" href="@Url.Action("Found_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" href="@Url.Action("Dangerous_Animals", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child" href="@Url.Action("Donations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints">
                                    <span class="sb-dot"></span>
                                    <span class="sb-child-lbl">System Complaints</span>
                                </a>
                                <a class="sb-child" href="@Url.Action("Laws_Regulations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Laws & Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" href="@Url.Action("Map", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" href="@Url.Action("Notifications", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span></a>
                </div>
            </nav>
            <div class="sb-foot"><div class="sb-user-row"><div class="sb-av">DC</div><div class="sb-user-info"><div class="sb-user-name">Daniel Carter</div><div class="sb-user-role">Operations Director</div></div></div><button class="sb-logout" onclick="alert('Sign out')" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></button></div>
        </aside>

        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Reports</span><span>/</span><b>Lost Pets</b></nav>
            <div class="tn-center"><div class="tn-center-main">Lost Pets</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" href="@Url.Action("Notifications", "SuperAdmin")"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="tn-count">9</span></a>
                <div class="tn-sep"></div>
                <div class="tn-profile" onclick="alert('Profile')"><div class="tn-av">DC</div><div><div class="tn-pname">Daniel Carter</div><div class="tn-prole">Operations Director</div></div></div>
            </div>
        </header>

        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div><h1>&#x1F50D; Lost Pets</h1><p>Review reports, approve or reject listings, and confirm verified matches.</p></div>
                <div class="page-hero-actions"><button class="btn btn-outline btn-sm">&#x1F4E5; Export</button></div>
            </section>
            <div class="page-body">
                <div class="kpi-grid kpi-grid-4" style="margin-bottom:20px;">
                    <div class="kpi-card c3"><div class="kpi-ico yellow">&#x1F50D;</div><div class="kpi-val" id="kpiMissing">8</div><div class="kpi-label">Currently Missing</div><div class="kpi-chip chip-yellow">Active cases</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">&#x23F3;</div><div class="kpi-val" id="kpiPending">3</div><div class="kpi-label">Pending Review</div><div class="kpi-chip chip-yellow">Need approval</div></div>
                    <div class="kpi-card c1"><div class="kpi-ico green">&#x2705;</div><div class="kpi-val" id="kpiFound">47</div><div class="kpi-label">Found This Month</div><div class="kpi-chip chip-green">&#x25B2; 12%</div></div>
                    <div class="kpi-card c4"><div class="kpi-ico red">&#x1F6A9;</div><div class="kpi-val" id="kpiFraud">2</div><div class="kpi-label">Suspected Fraud</div><div class="kpi-chip chip-red">Need review</div></div>
                </div>
                <div class="tabs-bar">
                    <button class="tab-btn active" onclick="setTab(this,'all')">All <span class="tab-count" id="tabAll">—</span></button>
                    <button class="tab-btn" onclick="setTab(this,'pending')">&#x23F3; Pending <span class="tab-count" id="tabPending">—</span></button>
                    <button class="tab-btn" onclick="setTab(this,'verify')">&#x1F510; Verify Match <span class="tab-count" id="tabVerify">—</span></button>
                    <button class="tab-btn" onclick="setTab(this,'found')">&#x2705; Found <span class="tab-count" id="tabFound">—</span></button>
                </div>
                <div class="toolbar" style="grid-template-columns:1fr auto auto auto;margin-bottom:14px;">
                    <div class="search-wrap"><span style="color:var(--text-muted);font-size:1rem;flex-shrink:0;">&#x1F50D;</span><input id="searchInput" placeholder="Search pet name or owner..." oninput="render()" /></div>
                    <select class="sel-wrap" id="typeFilter" onchange="render()" style="height:48px;width:auto;min-width:130px;"><option value="">All Types</option><option value="dog">&#x1F415; Dogs</option><option value="cat">&#x1F408; Cats</option><option value="bird">&#x1F426; Birds</option></select>
                    <select class="sel-wrap" id="cityFilter" onchange="render()" style="height:48px;width:auto;min-width:130px;"><option value="">All Cities</option><option>Amman</option><option>Zarqa</option><option>Irbid</option></select>
                    <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                </div>
                <div class="table-card">
                    <div class="table-head-bar"><div class="table-head-title">Lost Pets List</div><span class="table-count" id="tableCount">— reports</span></div>
                    <div class="table-wrap"><table><thead><tr><th>Pet</th><th>Type</th><th>Owner</th><th>City</th><th>Reward</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead><tbody id="tableBody"></tbody></table></div>
                </div>
            </div>
        </main>
    </div>

    <div class="detail-overlay" id="detailModal" onclick="if(event.target===this)closeModal('detailModal')">
        <div class="detail-panel" style="max-width:700px;">
            <div class="dp-header"><div class="dp-title" id="dTitle">Report Details</div><button class="dp-close" onclick="closeModal('detailModal')">&#x2715;</button></div>
            <div class="dp-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;" id="dGridInfo"></div>
                <div id="dVerifySection" style="display:none;">
                    <div class="dp-section-title">&#x1F510; Verification Match</div>
                    <div id="dMatchBox" class="match-box match-wait" style="margin-bottom:12px;">Waiting for verification data...</div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
                        <div class="dp-info-item"><div class="dp-info-label">Secret Answer</div><div class="dp-info-val" id="dSecretAnswer">—</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Finder Phone</div><div class="dp-info-val" id="dFinderPhone">—</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Owner Entered Phone</div><div class="dp-info-val" id="dOwnerPhone">—</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">System Match</div><div class="dp-info-val" id="dSysMatch">—</div></div>
                    </div>
                </div>
                <div class="dp-section">
                    <div class="dp-section-title">Private Admin Info</div>
                    <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.2);border-radius:var(--r);padding:12px 14px;" id="dPrivate"></div>
                </div>
                <div class="dp-section" style="margin-top:12px;">
                    <div class="dp-section-title">Update Status</div>
                    <select id="dStatusSel" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;">
                        <option value="pending">Pending Review</option>
                        <option value="active">Approved — Active</option>
                        <option value="verify">Match Submitted — Needs Verification</option>
                        <option value="found">Found — Confirmed</option>
                        <option value="rejected">Rejected</option>
                        <option value="fake">Fake Report — Remove</option>
                    </select>
                </div>
            </div>
            <div class="dp-footer">
                <button class="btn btn-success btn-sm" id="btnApprove" onclick="approveReport()">Approve &amp; Publish</button>
                <button class="btn btn-success btn-sm" id="btnConfirmFound" style="display:none;" onclick="confirmFound()">Confirm Found + Release Reward</button>
                <button class="btn btn-warning btn-sm" onclick="openModal('rejectModal')">Request Edit</button>
                <button class="btn btn-danger btn-sm" onclick="markFake()">Fake Report</button>
                <button class="btn btn-outline btn-sm" onclick="saveStatus()">Save</button>
                <button class="btn btn-outline btn-sm" onclick="closeModal('detailModal')">Close</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="rejectModal" onclick="if(event.target===this)closeModal('rejectModal')">
        <div class="modal-box" style="max-width:480px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:0 24px 60px rgba(38,31,23,.25);overflow:hidden;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.5);">
                <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--brand-dark);">Request Edit</div>
                <button class="dp-close" onclick="closeModal('rejectModal')">&#x2715;</button>
            </div>
            <div style="padding:20px;">
                <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.2);border-radius:var(--r);padding:12px 14px;margin-bottom:14px;font-size:.83rem;font-weight:800;color:#9b6000;">The owner will be notified with the reason.</div>
                <div class="field" style="margin-bottom:12px;">
                    <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Reason</label>
                    <select id="rejectReason" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option>Unclear or missing photo</option><option>Incomplete pet information</option><option>Location not specified</option><option>Suspected fake report</option><option>Duplicate listing</option></select>
                </div>
                <div class="field">
                    <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Note to Owner</label>
                    <textarea id="rejectNote" placeholder="Explain what needs to be fixed..." style="width:100%;min-height:90px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:12px 14px;font-weight:700;font-size:.86rem;outline:none;font-family:'Nunito',sans-serif;resize:vertical;"></textarea>
                </div>
            </div>
            <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;background:rgba(255,255,255,.5);">
                <button class="btn btn-warning" onclick="sendReject()">Send &amp; Reject</button>
                <button class="btn btn-outline" onclick="closeModal('rejectModal')">Cancel</button>
            </div>
        </div>
    </div>

    <div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:#fff;padding:11px 22px;border-radius:var(--pill);font-weight:800;font-size:.85rem;z-index:1999;display:none;align-items:center;gap:6px;box-shadow:0 8px 22px rgba(89,101,42,.3);white-space:nowrap;"></div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        setPageInfo('Lost Pets','Super Admin Panel','Reports','Lost Pets');
