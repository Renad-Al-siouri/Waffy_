@using Waffy.Models
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Waffy — Super Admin | Clinic Reviews & Complaints";
    ViewData["ActiveSection"] = "clinics";
    ViewData["ActivePage"] = "complaints-clinic";
    ViewData["PageTitle"] = "Clinic Reviews & Complaints";
    ViewData["BreadcrumbParent"] = "Management";
    ViewData["BreadcrumbCurrent"] = "Clinics";
    var complaints = ViewBag.Complaints as List<Complaint> ?? new();
    var allReviews = ViewBag.AllReviews as List<Review> ?? new();
    var clinicReviews = ViewBag.ClinicReviews as List<Review> ?? new();
    var doctorReviews = ViewBag.DoctorReviews as List<Review> ?? new();
    var openComplaints = (int)(ViewBag.OpenComplaints ?? 0);
    var resolvedComplaints = (int)(ViewBag.ResolvedComplaints ?? 0);
    var totalReviews = (int)(ViewBag.TotalReviews ?? 0);
    var avgRating = (double)(ViewBag.AvgRating ?? 0.0);

    string StarStr(int r)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++) sb.Append(i <= r ? "★" : "☆");
        return sb.ToString();
    }

    string RatingBg(int r) => r >= 4 ? "rgba(125,149,61,.12)" :
                                  r == 3 ? "rgba(191,122,35,.12)" : "rgba(200,106,92,.12)";

    string RatingColor(int r) => r >= 4 ? "#5f7430" : r == 3 ? "#8a4f00" : "#c86a5c";
}

@section PageStyles {
    <style>
        .star-fill {
            color: #efb83c;
            letter-spacing: 1px;
        }

        .star-empty {
            color: #d8cbb8;
            letter-spacing: 1px;
        }

        .reviewer-av {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg,#9ab451,#7d953d);
            color: #fff;
            font-size: .8rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-family: 'Fredoka',sans-serif;
        }

        .rev-row {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 16px 18px;
            margin-bottom: 10px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
            transition: box-shadow .18s;
        }

            .rev-row:hover {
                box-shadow: var(--shadow);
            }

        .rev-type-pill {
            display: inline-flex;
            align-items: center;
            padding: 2px 9px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 900;
        }

        .tab-filter-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .tab-chip {
            padding: 6px 16px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
            border: 1.5px solid var(--border);
            background: #fff;
            color: var(--text-muted);
            transition: .15s;
        }

            .tab-chip.active {
                background: var(--brand-ghost);
                border-color: var(--brand);
                color: var(--brand-dark);
            }
    </style>
}

<main class="wa-main" id="waMain">

    @* Alerts *@
    @if (ViewBag.ReviewSuccess != null)
    {
        <div style="margin:16px 24px 0;background:rgba(125,149,61,.12);
                                border:1px solid rgba(125,149,61,.3);color:#5f7430;
                                padding:12px 16px;border-radius:12px;font-weight:800;font-size:.86rem;">
            @ViewBag.ReviewSuccess
        </div>
    }

    <section class="page-hero">
        <div>
            <h1>⭐ Reviews &amp; Complaints</h1>
            <p>Moderate patient reviews and handle clinic complaints from one unified center.</p>
        </div>
    </section>

    <div class="page-body">

        <!-- KPIs -->
        <div class="kpi-grid kpi-grid-4">
            <div class="kpi-card c1">
                <div class="kpi-ico green">⭐</div>
                <div class="kpi-val">@totalReviews</div>
                <div class="kpi-label">Total Reviews</div>
                @if (avgRating > 0)
                {
                    <div class="kpi-chip chip-green">Avg @avgRating.ToString("F1") ★</div>
                }
            </div>
            <div class="kpi-card c1">
                <div class="kpi-ico green">🏥</div>
                <div class="kpi-val">@clinicReviews.Count</div>
                <div class="kpi-label">Clinic Reviews</div>
            </div>
            <div class="kpi-card c3">
                <div class="kpi-ico yellow">🚨</div>
                <div class="kpi-val">@openComplaints</div>
                <div class="kpi-label">Open Complaints</div>
                @if (openComplaints > 0)
                {
                    <div class="kpi-chip chip-yellow">Pending</div>
                }
            </div>
            <div class="kpi-card c1">
                <div class="kpi-ico green">✅</div>
                <div class="kpi-val">@resolvedComplaints</div>
                <div class="kpi-label">Resolved</div>
                <div class="kpi-chip chip-green">Good progress</div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="tabs-bar">
            <button class="tab-btn active" onclick="switchTab('reviews',this)">
                ⭐ Reviews <span class="tab-count">@totalReviews</span>
            </button>
            <button class="tab-btn" onclick="switchTab('complaints',this)">
                🚨 Complaints <span class="tab-count">@complaints.Count</span>
            </button>
        </div>

        <!-- REVIEWS TAB -->
        <div id="tab-reviews">

            @* Filter chips *@
            <div class="tab-filter-row">
                <span class="tab-chip active" onclick="filterRevs('all',this)">All (@totalReviews)</span>
                <span class="tab-chip" onclick="filterRevs('clinic',this)">🏥 Clinics (@clinicReviews.Count)</span>
                <span class="tab-chip" onclick="filterRevs('doctor',this)">👨‍⚕️ Doctors (@doctorReviews.Count)</span>
                <span class="tab-chip" onclick="filterRevs('low',this)">⚠️ Low (1-2 ★)</span>
            </div>

            @if (!allReviews.Any())
            {
                <div style="text-align:center;padding:48px;color:var(--text-muted);">
                    <div style="font-size:2.5rem;margin-bottom:12px;">⭐</div>
                    <p style="font-weight:800;">No reviews yet.</p>
                </div>
            }
            else
            {
                <div id="revList">
                    @foreach (var rev in allReviews)
                    {
                        var ini = string.IsNullOrEmpty(rev.UserFullName) ? "?"
                        : rev.UserFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries) is { Length: >= 2 } p
                        ? $"{p[0][0]}{p[1][0]}".ToUpper()
                        : rev.UserFullName[0].ToString().ToUpper();

                        <div class="rev-row"
                             data-type="@rev.TargetType.ToLower()"
                             data-rating="@rev.Rating">

                            @* Avatar *@
                            @if (!string.IsNullOrEmpty(rev.UserProfileImage))
                            {
                                <img src="@rev.UserProfileImage" alt=""
                                     class="reviewer-av" style="object-fit:cover;">
                            }
                            else
                            {
                                <div class="reviewer-av">@ini</div>
                            }

                            @* Content *@
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:center;
                                                                justify-content:space-between;flex-wrap:wrap;gap:6px;">
                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                        <span style="font-weight:900;font-size:.9rem;color:var(--brand-dark);">
                                            @(rev.UserFullName ?? "Anonymous")
                                        </span>
                                        <span class="rev-type-pill"
                                              style="background:@(rev.TargetType == "Clinic" ? "rgba(125,149,61,.12)" : "rgba(138,161,74,.15)");
                                                                         color:@(rev.TargetType == "Clinic" ? "#5f7430" : "#4a6020");">
                                            @(rev.TargetType == "Clinic" ? "🏥 Clinic" : "👨‍⚕️ Doctor")
                                            #@rev.TargetId
                                        </span>
                                    </div>
                                    <span style="font-size:.74rem;font-weight:700;color:var(--text-muted);">
                                        @rev.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>

                                <div style="margin-top:4px;">
                                    <span style="color:#efb83c;font-size:.9rem;letter-spacing:1px;">
                                        @StarStr(rev.Rating)
                                    </span>
                                    <span style="font-size:.72rem;font-weight:900;
                                                                     padding:2px 8px;border-radius:999px;margin-left:4px;
                                                                     background:@RatingBg(rev.Rating);color:@RatingColor(rev.Rating);">
                                        @rev.Rating / 5
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(rev.Title))
                                {
                                    <div style="font-weight:900;font-size:.86rem;color:var(--brand-dark);margin-top:5px;">
                                        @rev.Title
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(rev.Comment))
                                {
                                    <div style="font-size:.83rem;color:var(--text-muted);
                                                                            font-weight:700;margin-top:3px;line-height:1.6;">
                                        @(rev.Comment.Length > 160 ? rev.Comment[..160] + "…" : rev.Comment)
                                    </div>
                                }
                            </div>

                            @* Delete action *@
                            <div style="flex-shrink:0;">
                                <form method="post" asp-controller="SuperAdmin"
                                      asp-action="DeleteReview" style="display:inline"
                                      onsubmit="return confirm('Delete this review permanently?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@rev.IdReview" />
                                    <button type="submit" class="btn btn-danger btn-xs">🗑 Delete</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- COMPLAINTS TAB -->
        <div id="tab-complaints" style="display:none;">
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
                <div class="search-wrap" style="flex:1 1 240px;">
                    <span style="color:var(--text-muted);">🔍</span>
                    <input type="text" id="compSearch" placeholder="Search complaints..."
                           oninput="filterComplaints()" />
                </div>
                <select class="sel-wrap" style="width:auto;min-width:160px;"
                        id="compStatusFilter" onchange="filterComplaints()">
                    <option value="">All Statuses</option>
                    <option value="open">Open</option>
                    <option value="pending">Pending</option>
                    <option value="resolved">Resolved</option>
                </select>
                <button class="btn btn-outline btn-sm" onclick="resetCompFilters()">Reset</button>
            </div>

            <div id="complaintsList">
                @if (!complaints.Any())
                {
                    <div style="text-align:center;padding:40px;color:var(--text-muted);">
                        <div style="font-size:2rem;margin-bottom:12px;">📋</div>
                        <p style="font-weight:800;">No clinic complaints yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var c in complaints)
                    {
                        var priorityColor = c.Priority == "High" ? "var(--danger)"
                        : c.Priority == "Medium" ? "var(--warning)"
                        : "var(--border)";
                        var stBadge = c.Status switch
                        {
                            "Resolved" => "badge-success",
                            "Pending" => "badge-warning",
                            "Open" => "badge-danger",
                            _ => "badge-muted"
                        };
                        var prBadge = c.Priority switch
                        {
                            "High" => "badge-danger",
                            "Medium" => "badge-warning",
                            _ => "badge-muted"
                        };
                        var targetLabel = c.TargetType == "Clinic" ? "🏥" : "🏪";

                        <div class="complaint-row"
                             data-search="@(c.Title ?? "")@(c.ComplainantName ?? "")@(c.Description ?? "")"
                             data-status="@c.Status?.ToLower()"
                             data-id="@c.IdComplaint"
                             data-title="@(c.Title ?? "Complaint")"
                             data-target="@(c.TargetName ?? "—")"
                             data-complainant="@(c.ComplainantName ?? $"User #{c.IdUser}")"
                             data-date="@c.CreatedAt?.ToString("MMM dd, yyyy")"
                             data-priority="@c.Priority"
                             data-description="@c.Description"
                             data-status-val="@c.Status"
                             style="background:#fff;border:1px solid var(--border);
                                                        border-left:4px solid @priorityColor;
                                                        border-radius:var(--r-lg);padding:18px;
                                                        margin-bottom:12px;box-shadow:var(--shadow);">

                            <div style="display:flex;align-items:flex-start;
                                                            justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px;">
                                <div>
                                    <div style="font-size:.92rem;font-weight:900;color:var(--brand-dark);">
                                        @(c.Title ?? "Complaint")
                                    </div>
                                    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">
                                        @targetLabel @(c.TargetName ?? $"#{c.TargetId}")
                                        &nbsp;·&nbsp;
                                        👤 @(c.ComplainantName ?? $"User #{c.IdUser}")
                                        &nbsp;·&nbsp;
                                        📅 @c.CreatedAt?.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    @if (c.Priority != null)
                                    {
                                        <span class="badge @prBadge" style="font-size:.68rem;">
                                            @(c.Priority == "High" ? "🔴" : c.Priority == "Medium" ? "🟡" : "🟢")
                                            @c.Priority
                                        </span>
                                    }
                                    <span class="badge @stBadge">@c.Status</span>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <div style="font-size:.84rem;color:var(--text-muted);line-height:1.55;margin-bottom:12px;">
                                    @(c.Description.Length > 120 ? c.Description[..120] + "…" : c.Description)
                                </div>
                            }

                            <div class="action-group" style="display:flex;gap:8px;flex-wrap:wrap;">
                                <button type="button" class="btn btn-outline btn-xs"
                                        onclick="openDetails(this.closest('.complaint-row'))">
                                    👁 Details
                                </button>

                                @if (c.Status != "Resolved")
                                {
                                    <form method="post" asp-controller="SuperAdmin"
                                          asp-action="UpdateComplaintStatus" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                        <input type="hidden" name="status" value="Resolved" />
                                        <input type="hidden" name="returnPage" value="Reviews_Complaints_C" />
                                        <button type="submit" class="btn btn-success btn-xs">✅ Resolve</button>
                                    </form>
                                    <form method="post" asp-controller="SuperAdmin"
                                          asp-action="UpdateComplaintStatus" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                        <input type="hidden" name="status" value="Investigating" />
                                        <input type="hidden" name="returnPage" value="Reviews_Complaints_C" />
                                        <button type="submit" class="btn btn-warning btn-xs">🔍 Investigate</button>
                                    </form>
                                }
                                @if (c.Status != "Open")
                                {
                                    <form method="post" asp-controller="SuperAdmin"
                                          asp-action="UpdateComplaintStatus" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                        <input type="hidden" name="status" value="Open" />
                                        <input type="hidden" name="returnPage" value="Reviews_Complaints_C" />
                                        <button type="submit" class="btn btn-outline btn-xs">🔄 Reopen</button>
                                    </form>
                                }
                                <button type="button" class="btn btn-warning btn-xs"
                                        onclick="warnTarget('@(c.TargetName ?? c.TargetType)', @c.TargetId, '@c.TargetType')">
                                    ⚠️ Warn
                                </button>
                                <button type="button" class="btn btn-danger btn-xs"
                                        onclick="suspendTarget('@(c.TargetName ?? c.TargetType)', @c.TargetId, '@c.TargetType')">
                                    🔒 Suspend
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</main>

</div>

<!-- MODAL: Complaint Detail Panel -->
<div class="detail-overlay" id="complaintPanel">
    <div class="detail-panel" style="max-width:780px;">
        <div class="dp-header">
            <div class="dp-title" id="compPanelTitle">🚨 Complaint Details</div>
            <button class="dp-close" onclick="closeM('complaintPanel')">✕</button>
        </div>
        <div class="dp-body" id="complaintPanelBody"></div>
        <div class="dp-footer" id="complaintPanelFooter"></div>
    </div>
</div>

<!-- MODAL: Warn -->
<div class="modal-overlay" id="warnModal">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-head">
            <div class="modal-title">⚠️ Send Warning</div>
            <button class="dp-close" onclick="closeM('warnModal')">✕</button>
        </div>
        <form method="post" asp-controller="SuperAdmin" asp-action="WarnTarget">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <input type="hidden" name="targetType" id="warnTargetType" value="Clinic" />
                <input type="hidden" name="targetId" id="warnTargetId" value="0" />
                <div class="field">
                    <label>Target</label>
                    <input type="text" id="warnTargetDisplay" readonly style="background:#f5f0e8;" />
                </div>
                <div class="field">
                    <label>Type</label>
                    <select name="warnType">
                        <option>Policy violation</option>
                        <option>High complaint volume</option>
                        <option>Doctor no-shows</option>
                        <option>Unprofessional behavior</option>
                    </select>
                </div>
                <div class="field">
                    <label>Message</label>
                    <textarea name="warnMessage" placeholder="Write the official warning..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button type="submit" class="btn btn-warning">Send Warning</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Suspend -->
<div class="modal-overlay" id="suspendModal">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-head">
            <div class="modal-title">🔒 Suspend</div>
            <button class="dp-close" onclick="closeM('suspendModal')">✕</button>
        </div>
        <form method="post" asp-controller="SuperAdmin" asp-action="SuspendTarget">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <input type="hidden" name="targetType" id="suspTargetType" value="Clinic" />
                <input type="hidden" name="targetId" id="suspTargetId" value="0" />
                <div class="field">
                    <label>Target</label>
                    <input type="text" id="suspTargetDisplay" readonly style="background:#f5f0e8;" />
                </div>
                <div class="field">
                    <label>Reason</label>
                    <select name="suspendReason">
                        <option>Multiple complaints</option>
                        <option>Doctor misconduct</option>
                        <option>Policy violations</option>
                    </select>
                </div>
                <div class="field">
                    <label>Duration</label>
                    <select name="suspendDuration">
                        <option>7 days</option>
                        <option>30 days</option>
                        <option>Permanent</option>
                    </select>
                </div>
                <div class="field">
                    <label>Message</label>
                    <textarea name="suspendMessage" placeholder="Explain..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
                <button type="submit" class="btn btn-danger">Suspend</button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/Waffy-SuperAdmin.js" asp-append-version="true"></script>

@section PageScripts {
    <script>
        // ── Tabs ──
        function switchTab(tab, btn) {
            document.getElementById('tab-reviews').style.display    = tab === 'reviews'    ? 'block' : 'none';
            document.getElementById('tab-complaints').style.display = tab === 'complaints' ? 'block' : 'none';
            document.querySelectorAll('.tabs-bar .tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        // ── Filter reviews chips ──
        function filterRevs(type, chip) {
            document.querySelectorAll('.tab-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            document.querySelectorAll('.rev-row').forEach(row => {
                var t = row.dataset.type;
                var r = parseInt(row.dataset.rating);
                var show = type === 'all'    ? true :
                           type === 'clinic' ? t === 'clinic' :
                           type === 'doctor' ? t === 'doctor' :
                           type === 'low'    ? r <= 2 : true;
                row.style.display = show ? 'flex' : 'none';
            });
        }

        // ── Filter complaints ──
        function filterComplaints() {
            var q  = (document.getElementById('compSearch')?.value || '').toLowerCase();
            var st = (document.getElementById('compStatusFilter')?.value || '').toLowerCase();
            document.querySelectorAll('.complaint-row').forEach(function(row) {
                var mQ = !q  || (row.dataset.search || '').toLowerCase().includes(q);
                var mS = !st || (row.dataset.status || '') === st;
                row.style.display = (mQ && mS) ? '' : 'none';
            });
        }
        function resetCompFilters() {
            document.getElementById('compSearch').value = '';
            document.getElementById('compStatusFilter').selectedIndex = 0;
            filterComplaints();
        }

        // ── Complaint Details Panel ──
        function openDetails(row) {
            var title       = row.dataset.title       || 'Complaint';
            var target      = row.dataset.target      || '—';
            var complainant = row.dataset.complainant || '—';
            var date        = row.dataset.date        || '—';
            var priority    = row.dataset.priority    || '—';
            var description = row.dataset.description || '—';
            var status      = row.dataset.statusVal   || row.dataset.status || '—';

            document.getElementById('compPanelTitle').textContent = '🚨 ' + title;

            var prBadge = priority === 'High'
                ? '<span class="badge badge-danger">🔴 High</span>'
                : priority === 'Medium'
                ? '<span class="badge badge-warning">🟡 Medium</span>'
                : '<span class="badge badge-muted">🟢 Low</span>';

            var stBadge = status === 'Resolved'
                ? '<span class="badge badge-success">✅ Resolved</span>'
                : status === 'Investigating'
                ? '<span class="badge badge-warning">🔍 Investigating</span>'
                : '<span class="badge badge-danger">🔴 Open</span>';

            document.getElementById('complaintPanelBody').innerHTML = `
                <div class="dp-section">
                    <div class="dp-section-title">Overview</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                        ${stBadge} ${prBadge}
                    </div>
                    <div class="dp-grid">
                        <div class="dp-info-item">
                            <div class="dp-info-label">🏥 Target</div>
                            <div class="dp-info-val">${target}</div>
                        </div>
                        <div class="dp-info-item">
                            <div class="dp-info-label">📅 Date Filed</div>
                            <div class="dp-info-val">${date}</div>
                        </div>
                        <div class="dp-info-item">
                            <div class="dp-info-label">👤 Complainant</div>
                            <div class="dp-info-val">${complainant}</div>
                        </div>
                        <div class="dp-info-item">
                            <div class="dp-info-label">⚡ Priority</div>
                            <div class="dp-info-val">${priority || '—'}</div>
                        </div>
                    </div>
                </div>
                <div class="dp-section">
                    <div class="dp-section-title">Description</div>
                    <div style="background:var(--surface-2);border-radius:12px;
                                padding:16px;font-size:.88rem;line-height:1.7;">
                        ${description}
                    </div>
                </div>`;

            document.getElementById('complaintPanelFooter').innerHTML = `
                <button class="btn btn-warning btn-sm"
                        onclick="warnTarget('${target}');closeM('complaintPanel')">⚠️ Warn</button>
                <button class="btn btn-danger btn-sm"
                        onclick="suspendTarget('${target}');closeM('complaintPanel')">🔒 Suspend</button>
                <button class="btn btn-outline btn-sm" onclick="closeM('complaintPanel')">Close</button>`;

            openM('complaintPanel');
        }

        // ── Warn / Suspend ──
                var currentWarnTarget = '';
        var currentTargetId   = 0;

        function warnTarget(name, targetId, targetType) {
            currentWarnTarget = name;
            currentTargetId   = targetId || 0;
            document.getElementById('warnTarget').value     = name;
            document.getElementById('warnTargetId').value   = targetId || 0;
            document.getElementById('warnTargetType').value = targetType || 'Clinic';
            openM('warnModal');
        }
        function warnTarget(name, targetId, targetType) {
            document.getElementById('warnTargetDisplay').value  = name;
            document.getElementById('warnTargetId').value       = targetId || 0;
            document.getElementById('warnTargetType').value     = targetType || 'Clinic';
            openM('warnModal');
        }

        function suspendTarget(name, targetId, targetType) {
            document.getElementById('suspTargetDisplay').value  = name;
            document.getElementById('suspTargetId').value       = targetId || 0;
            document.getElementById('suspTargetType').value     = targetType || 'Clinic';
            openM('suspendModal');
        }

        function submitSuspend() {
            var reason   = document.querySelector('#suspendModal select:first-of-type')?.value || '';
            var duration = document.querySelector('#suspendModal select:last-of-type')?.value  || '';
            var msg      = document.querySelector('#suspendModal textarea')?.value || '';
            document.getElementById('suspReasonInput').value   = reason;
            document.getElementById('suspDurationInput').value = duration;
            document.getElementById('suspMessageInput').value  = msg;
            document.getElementById('suspendForm').submit();
        }

        // ── Modal helpers ──
        function openM(id)  { var m = document.getElementById(id); if (m) m.classList.add('open'); }
        function closeM(id) { var m = document.getElementById(id); if (m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay,.detail-overlay').forEach(function(m) {
            m.addEventListener('click', function(e) { if (e.target === m) m.classList.remove('open'); });
        });

        // ── Sidebar ──
        function toggleSb() {
            document.getElementById('waSb').classList.toggle('mob-open');
            document.getElementById('waOvl').classList.toggle('show');
        }
        function closeMob() {
            document.getElementById('waSb').classList.remove('mob-open');
            document.getElementById('waOvl').classList.remove('show');
        }

        // ── Toast ──
        function toast(msg, type) {
            type = type || 'success';
            var bg  = { success:'var(--success-soft)', danger:'var(--danger-soft)', warning:'var(--warning-soft)' };
            var col = { success:'var(--success)',       danger:'var(--danger)',       warning:'#9b6000' };
            var t = document.createElement('div');
            t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;'
                + 'border-radius:14px;background:' + bg[type] + ';color:' + col[type] + ';'
                + 'font-weight:800;font-size:.86rem;font-family:Nunito,sans-serif;'
                + 'box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function() { t.remove(); }, 3000);
        }
    </script>
}
