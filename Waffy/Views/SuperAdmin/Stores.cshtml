@{
    ViewData["Title"] = "Waffy — Super Admin | Store Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users"><div class="sb-sub-inner"><a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a></div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-shop" onclick="acc('g-shop','t-shop')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">@(ViewBag.PendingStores ?? 0)</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-shop" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span><span class="sb-bdg bd-y sb-child-bdg">@(ViewBag.PendingStores ?? 0)</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints">
                                    <span class="sb-dot"></span>
                                    <span class="sb-child-lbl">System Complaints</span>
                                </a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.AdminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.AdminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <a class="sb-logout" href="@Url.Action("Logout", "Account")">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Management</span><span>/</span><b>Stores</b></nav>
            <div class="tn-center"><div class="tn-center-main">Store Management</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <button class="tn-btn" type="button"><svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></button>
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.AdminInitials</div>
                    <div><div class="tn-pname">@ViewBag.AdminName</div><div class="tn-prole">Super Admin</div></div>
                </div>
            </div>
        </header>

        <main class="wa-main" id="waMain">

            @if (ViewBag.Success != null)
            {
                <div style="margin:0 0 12px;padding:12px 16px;background:var(--success-soft);border:1px solid rgba(47,158,95,.3);border-radius:12px;font-weight:800;color:var(--success);font-size:.86rem;">@ViewBag.Success</div>
            }

            <section class="page-hero">
                <div>
                    <h1>Store Management</h1>
                    <p>Approve, suspend, reject or delete stores. Click any row to view full details.</p>
                </div>
               
            </section>

            <div class="page-body">
                <div class="kpi-grid kpi-grid-4">
                    <div class="kpi-card c1"><div class="kpi-ico green">🏪</div><div class="kpi-val" id="kpiTotal">@(ViewBag.TotalStores ?? 0)</div><div class="kpi-label">Total Stores</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">✅</div><div class="kpi-val" id="kpiActive">@(ViewBag.ActiveStores ?? 0)</div><div class="kpi-label">Active</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">⏳</div><div class="kpi-val" id="kpiPending">@(ViewBag.PendingStores ?? 0)</div><div class="kpi-label">Pending Approval</div><div class="kpi-chip chip-yellow">Needs review</div></div>
                    <div class="kpi-card c4"><div class="kpi-ico red">🔒</div><div class="kpi-val" id="kpiSuspended">@(ViewBag.SuspendedStores ?? 0)</div><div class="kpi-label">Suspended</div></div>
                </div>

                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
                    <div class="search-wrap" style="flex:1 1 260px;">
                        <span style="color:var(--text-muted)">🔍</span>
                        <input type="text" id="searchInput" placeholder="Search by store name, owner, city..." oninput="renderTable()" />
                    </div>
                    <select class="sel-wrap" style="width:auto;min-width:160px;" id="statusFilter" onchange="renderTable()">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="pending">Pending</option>
                        <option value="suspended">Suspended</option>
                        <option value="rejected">Rejected</option>
                    </select>
                    <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                </div>

                <div class="chips-row" id="chipsRow">
                    <button class="filter-chip active" data-f="" onclick="setChip(this)">All <span id="chipAll"></span></button>
                    <button class="filter-chip" data-f="pending" onclick="setChip(this)">⏳ Pending <span id="chipPending"></span></button>
                    <button class="filter-chip" data-f="active" onclick="setChip(this)">✅ Active <span id="chipActive"></span></button>
                    <button class="filter-chip" data-f="suspended" onclick="setChip(this)">🔒 Suspended <span id="chipSuspended"></span></button>
                    <button class="filter-chip" data-f="rejected" onclick="setChip(this)">❌ Rejected <span id="chipRejected"></span></button>
                </div>

                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">All Stores</div>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span class="table-count" id="tableCount"></span>
                            <select class="sel-wrap" style="height:36px;font-size:.78rem;width:auto;min-width:160px;" onchange="sortStores(this.value)">
                                <option value="newest">Newest First</option>
                                <option value="name">Name A–Z</option>
                                
                                <option value="revenue">Highest Revenue</option>
                            </select>
                        </div>
                    </div>
                    <div id="bulkBar" style="display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#FFF9EE;border-top:1px solid #E8D9A0;border-bottom:1px solid #E8D9A0;padding:12px 16px;">
                        <span style="font-weight:800;color:var(--brand-dark);font-size:.87rem;" id="bulkCount">0 selected</span>
                        <button class="btn btn-outline btn-sm" onclick="clearSelection()">✕ Clear</button>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="checkAll" onchange="toggleAll(this)" /></th>
                                    <th>Store</th>
                                    <th>Owner</th>
                                    <th>City</th>
                                    <th>Products</th>
                                    <th>Revenue</th>
                                   
                                    <th>Status</th>
                                    <th>Joined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="storesTBody"></tbody>
                        </table>
                    </div>
                    <div class="pagination-bar">
                        <div class="pag-info" id="pagInfo">Showing 0 stores</div>
                        <div class="pag-pages" id="pagPages"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Detail Panel -->
    <div class="detail-overlay" id="storeDetailPanel">
        <div class="detail-panel" style="max-width:780px;">
            <div class="dp-header">
                <div class="dp-title" id="dpTitle">🏪 Store Details</div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <a class="btn btn-outline btn-sm" id="dpViewFullBtn" href="#">Full Details →</a>
                    <button class="dp-close" onclick="closeM('storeDetailPanel')">✕</button>
                </div>
            </div>
            <div class="dp-body">
                <div class="dp-profile">
                    <div class="dp-avatar" id="dpAvatar">🏪</div>
                    <div style="flex:1;">
                        <div class="dp-name" id="dpName"></div>
                        <div class="dp-meta" id="dpMeta"></div>
                        <div id="dpBadges" style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;"></div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;" id="dpActionBtns"></div>
                </div>
                <div class="dp-section">
                    <div class="dp-section-title">Store Information</div>
                    <div class="dp-grid">
                        <div class="dp-info-item"><div class="dp-info-label">Owner</div><div class="dp-info-val" id="dpOwner"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Email</div><div class="dp-info-val" id="dpEmail"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Phone</div><div class="dp-info-val" id="dpPhone"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">City</div><div class="dp-info-val" id="dpCity"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Joined</div><div class="dp-info-val" id="dpJoined"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Status</div><div id="dpStatusVal" style="margin-top:4px;"></div></div>
                    </div>
                </div>
                <div class="dp-section">
                    <div class="dp-section-title">Quick Stats</div>
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Products</div><div class="dp-info-val" id="dpProducts" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Orders</div><div class="dp-info-val" id="dpOrders" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Revenue</div><div class="dp-info-val green" id="dpRevenue" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        
                    </div>
                </div>
            </div>
            <div class="dp-footer">
                <button class="btn btn-outline btn-sm" onclick="closeM('storeDetailPanel')">Close</button>
            </div>
        </div>
    </div>

    <!-- Modals -->
    <div class="modal-overlay" id="approveModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">✅ Approve Store</div><button class="dp-close" onclick="closeM('approveModal')">✕</button></div>
            <div class="modal-body">
                <div style="background:var(--success-soft);border:1px solid rgba(47,158,95,.2);border-radius:12px;padding:14px;margin-bottom:14px;">
                    <div style="font-weight:900;color:var(--success);font-size:.9rem;" id="approveStoreName"></div>
                    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">The owner will be activated and can log in immediately.</div>
                </div>
                <div class="field"><label>Admin Note (optional)</label><textarea id="approveNote" placeholder="Internal note..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('approveModal')">Cancel</button>
                <button class="btn btn-success" onclick="submitApprove()">✅ Approve Store</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="rejectModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">❌ Reject Store</div><button class="dp-close" onclick="closeM('rejectModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Store</label><input type="text" id="rejectTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Reason</label>
                    <select id="rejectReason"><option>Incomplete documents</option><option>Does not meet requirements</option><option>Duplicate store</option><option>Suspicious registration</option><option>Other</option></select>
                </div>
                <div class="field"><label>Message</label><textarea id="rejectMessage" placeholder="Explain..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('rejectModal')">Cancel</button>
                <button class="btn btn-danger" onclick="submitReject()">Confirm Rejection</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="suspendModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">🔒 Suspend Store</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Store</label><input type="text" id="suspendTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Reason</label>
                    <select id="suspendReason"><option>Policy violation</option><option>Multiple complaints</option><option>Unpaid dues</option><option>Invalid documents</option><option>Suspicious activity</option></select>
                </div>
                <div class="field">
                    <label>Duration</label>
                    <select id="suspendDuration"><option>7 days</option><option>30 days</option><option>90 days</option><option>Permanent</option></select>
                </div>
                <div class="field"><label>Message to Store</label><textarea id="suspendMessage" placeholder="Explain..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
                <button class="btn btn-danger" onclick="submitSuspend()">Suspend Store</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box" style="max-width:440px;">
            <div class="modal-head"><div class="modal-title">🗑 Delete Store</div><button class="dp-close" onclick="closeM('deleteModal')">✕</button></div>
            <div class="modal-body" style="text-align:center;padding:24px 20px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">⚠️</div>
                <div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:var(--brand-dark);margin-bottom:8px;">Delete this store permanently?</div>
                <div style="font-size:.86rem;color:var(--text-muted);font-weight:700;"><strong id="deleteStoreName" style="color:var(--danger);"></strong></div>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-outline" onclick="closeM('deleteModal')">Cancel</button>
                <button class="btn btn-danger" onclick="submitDelete()">Yes, Delete</button>
            </div>
        </div>
    </div>

    <!-- POST Forms — هذا هو الجزء المهم الذي يحفظ في قاعدة البيانات -->
    <form id="approveForm" method="post" asp-action="ApproveStore" asp-controller="SuperAdmin">@Html.AntiForgeryToken()<input type="hidden" name="storeId" id="approveStoreId"></form>
    <form id="rejectForm" method="post" asp-action="RejectStore" asp-controller="SuperAdmin">@Html.AntiForgeryToken()<input type="hidden" name="storeId" id="rejectStoreId"><input type="hidden" name="reason" id="rejectReasonH"><input type="hidden" name="message" id="rejectMessageH"></form>
    <form id="suspendForm" method="post" asp-action="SuspendStore" asp-controller="SuperAdmin">@Html.AntiForgeryToken()<input type="hidden" name="storeId" id="suspendStoreId"><input type="hidden" name="reason" id="suspendReasonH"><input type="hidden" name="duration" id="suspendDurationH"><input type="hidden" name="message" id="suspendMessageH"></form>
    <form id="reactivateForm" method="post" asp-action="ReactivateStore" asp-controller="SuperAdmin">@Html.AntiForgeryToken()<input type="hidden" name="storeId" id="reactivateStoreId"></form>
    <form id="deleteForm" method="post" asp-action="DeleteStore" asp-controller="SuperAdmin">@Html.AntiForgeryToken()<input type="hidden" name="storeId" id="deleteStoreId"></form>

    <script src="~/js/Waffy-Shell.js"></script>
    <script src="~/js/superAdminClinic.js"></script>
    <script>
        // ══ البيانات الحقيقية من قاعدة البيانات ══
        const stores = @Html.Raw(ViewBag.StoresJson ?? "[]");

        let currentStoreId = null, selectedIds = new Set(), currentSort = 'newest', currentChip = '';
        const PAGE_SIZE = 8; let currentPage = 1;

        function statusBadge(s) {
            const m = { active:['badge-success','✅ Active'], pending:['badge-warning','⏳ Pending'], suspended:['badge-danger','🔒 Suspended'], rejected:['badge-muted','❌ Rejected'] };
            const [c,l] = m[s]||['badge-muted',s];
            return `<span class="badge ${c}">${l}</span>`;
        }
        function starsHtml(r) {
            return (!r||r===0) ? '<span style="color:var(--text-muted);font-size:.78rem;">—</span>'
                               : `⭐ <span style="font-weight:900;color:var(--brand-dark);">${Number(r).toFixed(1)}</span>`;
        }
        function getFiltered() {
            const q = (document.getElementById('searchInput')?.value||'').toLowerCase();
            const st = document.getElementById('statusFilter')?.value||'';
            const chip = currentChip;
            return stores.filter(s=>{
                const mQ  = !q || [s.name,s.owner,s.email,s.city].some(v=>(v||'').toLowerCase().includes(q));
                const mSt = !st&&!chip?true:(chip?s.status===chip:s.status===st);
                return mQ&&mSt;
            }).sort((a,b)=>{
                if(currentSort==='name')    return a.name.localeCompare(b.name);
               
                if(currentSort==='revenue') return (b.revenue||0)-(a.revenue||0);
                return new Date(b.joined)-new Date(a.joined);
            });
        }
        function renderTable() {
            const data=getFiltered(), total=data.length, pages=Math.ceil(total/PAGE_SIZE)||1;
            if(currentPage>pages) currentPage=1;
            const slice=data.slice((currentPage-1)*PAGE_SIZE, currentPage*PAGE_SIZE);
            document.getElementById('storesTBody').innerHTML = slice.length ? slice.map(s=>`
                <tr style="cursor:pointer;" onclick="openDetail(${s.id})">
                    <td onclick="event.stopPropagation()"><input type="checkbox" class="row-chk" data-id="${s.id}" ${selectedIds.has(s.id)?'checked':''} onchange="toggleRow(this)"/></td>
                    <td><div style="display:flex;align-items:center;gap:10px;"><div style="width:40px;height:40px;border-radius:12px;background:var(--brand-xlight);border:1px solid var(--border);display:grid;place-items:center;font-size:1.2rem;flex-shrink:0;overflow:hidden;">${s.logoUrl?`<img src="${s.logoUrl}" style="width:100%;height:100%;object-fit:cover;">`:'🏪'}</div><div><div class="cell-title">${s.name}</div><div class="cell-sub">${s.email||''}</div></div></div></td>
                    <td>${s.owner||'—'}</td>
                    <td>📍 ${s.city||'—'}</td>
                    <td>${s.products>0?s.products+' 📦':'—'}</td>
                    <td>${s.revenue>0?`<strong style="color:var(--success);">${Number(s.revenue).toLocaleString()} JD</strong>`:'—'}</td>
                   
                    <td>${statusBadge(s.status)}</td>
                    <td style="font-size:.78rem;color:var(--text-muted);">${s.joined}</td>
                    <td onclick="event.stopPropagation()">
                        <div style="display:flex;gap:5px;flex-wrap:wrap;">
                            <button class="btn btn-outline btn-xs" onclick="openDetail(${s.id})">👁</button>
                            ${s.status==='pending'   ?`<button class="btn btn-success btn-xs" onclick="openApproveModal(${s.id})">✅</button><button class="btn btn-danger btn-xs" onclick="openRejectModal(${s.id})">❌</button>`:''}
                            ${s.status==='active'    ?`<button class="btn btn-warning btn-xs" onclick="openSuspendModal(${s.id})">🔒</button>`:''}
                            ${s.status==='suspended' ?`<button class="btn btn-success btn-xs" onclick="reactivate(${s.id})">✅</button>`:''}
                            <button class="btn btn-danger btn-xs" onclick="openDeleteModal(${s.id})">🗑</button>
                        </div>
                    </td>
                </tr>`).join('')
            : `<tr><td colspan="10" style="text-align:center;padding:32px;color:var(--text-muted);">No stores found.</td></tr>`;

            document.getElementById('pagInfo').textContent = total===0?'No stores found':`Showing ${(currentPage-1)*PAGE_SIZE+1}–${Math.min(currentPage*PAGE_SIZE,total)} of ${total} stores`;
            const pagEl=document.getElementById('pagPages'); pagEl.innerHTML='';
            if(pages>1){const ab=(l,p,a=false,d=false)=>{const b=document.createElement('button');b.className='pag-btn'+(a?' active':'');b.textContent=l;b.disabled=d;b.onclick=()=>{currentPage=p;renderTable();};pagEl.appendChild(b);};ab('‹',currentPage-1,false,currentPage===1);for(let i=1;i<=pages;i++)ab(i,i,i===currentPage);ab('›',currentPage+1,false,currentPage===pages);}
            document.getElementById('tableCount').textContent=total+' stores';
            updateKPIs(); updateBulkBar();
        }
        function updateKPIs() {
            const cnt=s=>stores.filter(x=>x.status===s).length;
            ['kpiTotal','kpiActive','kpiPending','kpiSuspended'].forEach((id,i)=>{
                const vals=[stores.length,cnt('active'),cnt('pending'),cnt('suspended')];
                document.getElementById(id).textContent=vals[i];
            });
            document.getElementById('chipAll').textContent=`(${stores.length})`;
            document.getElementById('chipPending').textContent=`(${cnt('pending')})`;
            document.getElementById('chipActive').textContent=`(${cnt('active')})`;
            document.getElementById('chipSuspended').textContent=`(${cnt('suspended')})`;
            document.getElementById('chipRejected').textContent=`(${cnt('rejected')})`;
        }
        function openDetail(id) {
            const s=stores.find(x=>x.id===id); if(!s) return;
            currentStoreId=id;
            document.getElementById('dpTitle').textContent='🏪 '+s.name;
                   const dpAv = document.getElementById('dpAvatar');
        if (s.logoUrl) {
            dpAv.innerHTML = `<img src="${s.logoUrl}" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">`;
        } else {
            dpAv.textContent = '🏪';
        }
            document.getElementById('dpName').textContent=s.name;
            document.getElementById('dpMeta').textContent=`${s.city||''} · Joined ${s.joined}`;
            document.getElementById('dpOwner').textContent=s.owner||'—';
            document.getElementById('dpEmail').textContent=s.email||'—';
            document.getElementById('dpPhone').textContent=s.phone||'—';
            document.getElementById('dpCity').textContent=s.city||'—';
            document.getElementById('dpJoined').textContent=s.joined||'—';
            document.getElementById('dpStatusVal').innerHTML=statusBadge(s.status);
            document.getElementById('dpBadges').innerHTML=statusBadge(s.status);
            document.getElementById('dpProducts').textContent=s.products||0;
            document.getElementById('dpOrders').textContent=s.orders||0;
            document.getElementById('dpRevenue').textContent=s.revenue>0?Number(s.revenue).toLocaleString()+' JD':'—';
            
            document.getElementById('dpViewFullBtn').href=`/SuperAdmin/Details_S?id=${s.id}`;
            let btns='';
            if(s.status==='pending')   btns=`<button class="btn btn-success btn-sm" onclick="openApproveModal(${s.id})">✅ Approve</button><button class="btn btn-danger btn-sm" onclick="openRejectModal(${s.id})">❌ Reject</button>`;
            if(s.status==='active')    btns=`<button class="btn btn-warning btn-sm" onclick="openSuspendModal(${s.id})">🔒 Suspend</button>`;
            if(s.status==='suspended') btns=`<button class="btn btn-success btn-sm" onclick="reactivate(${s.id})">✅ Reactivate</button>`;
            document.getElementById('dpActionBtns').innerHTML=btns;
            openM('storeDetailPanel');
        }

        // ══ Actions — ترسل للسيرفر وتحفظ في قاعدة البيانات ══
        function openApproveModal(id){const s=stores.find(x=>x.id===id);if(!s)return;currentStoreId=id;document.getElementById('approveStoreName').textContent=s.name+' — '+( s.owner||'');openM('approveModal');}
        function submitApprove(){document.getElementById('approveStoreId').value=currentStoreId;closeM('approveModal');document.getElementById('approveForm').submit();}

        function openRejectModal(id){const s=stores.find(x=>x.id===id);if(!s)return;currentStoreId=id;document.getElementById('rejectTarget').value=s.name;openM('rejectModal');}
        function submitReject(){document.getElementById('rejectStoreId').value=currentStoreId;document.getElementById('rejectReasonH').value=document.getElementById('rejectReason').value;document.getElementById('rejectMessageH').value=document.getElementById('rejectMessage').value;closeM('rejectModal');document.getElementById('rejectForm').submit();}

        function openSuspendModal(id){const s=stores.find(x=>x.id===id);if(!s)return;currentStoreId=id;document.getElementById('suspendTarget').value=s.name;openM('suspendModal');}
        function submitSuspend(){document.getElementById('suspendStoreId').value=currentStoreId;document.getElementById('suspendReasonH').value=document.getElementById('suspendReason').value;document.getElementById('suspendDurationH').value=document.getElementById('suspendDuration').value;document.getElementById('suspendMessageH').value=document.getElementById('suspendMessage').value;closeM('suspendModal');document.getElementById('suspendForm').submit();}

        function reactivate(id){currentStoreId=id;const s=stores.find(x=>x.id===id);if(!s)return;if(confirm(`Reactivate "${s.name}"?`)){document.getElementById('reactivateStoreId').value=id;document.getElementById('reactivateForm').submit();}}

        function openDeleteModal(id){const s=stores.find(x=>x.id===id);if(!s)return;currentStoreId=id;document.getElementById('deleteStoreName').textContent=s.name;openM('deleteModal');}
        function submitDelete(){document.getElementById('deleteStoreId').value=currentStoreId;closeM('deleteModal');document.getElementById('deleteForm').submit();}

        // ── Helpers ──
        function toggleRow(cb){const id=Number(cb.dataset.id);cb.checked?selectedIds.add(id):selectedIds.delete(id);updateBulkBar();}
        function toggleAll(m){getFiltered().forEach(s=>m.checked?selectedIds.add(s.id):selectedIds.delete(s.id));renderTable();}
        function clearSelection(){selectedIds.clear();document.getElementById('checkAll').checked=false;renderTable();}
        function updateBulkBar(){const bar=document.getElementById('bulkBar'),cnt=document.getElementById('bulkCount');bar.style.display=selectedIds.size>0?'flex':'none';cnt.textContent=selectedIds.size+' store(s) selected';}
        function setChip(btn){document.querySelectorAll('#chipsRow .filter-chip').forEach(c=>c.classList.remove('active'));btn.classList.add('active');currentChip=btn.dataset.f;document.getElementById('statusFilter').value='';currentPage=1;renderTable();}
        function sortStores(v){currentSort=v;currentPage=1;renderTable();}
        function resetFilters(){document.getElementById('searchInput').value='';document.getElementById('statusFilter').value='';currentChip='';currentPage=1;document.querySelectorAll('#chipsRow .filter-chip').forEach((c,i)=>c.classList.toggle('active',i===0));renderTable();}
        function exportStores(){toast('Exporting '+getFiltered().length+' stores...','success');}
        function openM(id){const m=document.getElementById(id);if(m)m.classList.add('open');}
        function closeM(id){const m=document.getElementById(id);if(m)m.classList.remove('open');}
        document.querySelectorAll('.modal-overlay,.detail-overlay').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open');}));
        function toast(msg,type='success'){const c={success:'var(--success)',danger:'var(--danger)',warning:'#9b6000'},bg={success:'var(--success-soft)',danger:'var(--danger-soft)',warning:'var(--warning-soft)'};const t=document.createElement('div');t.style.cssText=`position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${c[type]}40;color:${c[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;`;t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),3000);}

        renderTable();
    </script>
</body>
</html>
