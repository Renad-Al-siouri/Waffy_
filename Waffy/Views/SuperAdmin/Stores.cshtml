@{
    ViewData["Title"] = "Waffy — Super Admin | Store Management";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR ══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>

                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" data-tip="Users" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button class="sb-row open active" id="t-shop" onclick="acc('g-shop','t-shop')" data-tip="Shop" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-shop" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span><span class="sb-bdg bd-y sb-child-bdg">3</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span><span class="sb-bdg bd-r sb-child-bdg">6</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" data-tip="Adoption" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span><span class="sb-bdg bd-y">5</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span><span class="sb-bdg bd-y sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>

                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" data-tip="Reports" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span><span class="sb-bdg bd-y">8</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map" data-tip="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications" data-tip="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span></a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row"><div class="sb-av">DC</div><div class="sb-user-info"><div class="sb-user-name">Daniel Carter</div><div class="sb-user-role">Operations Director</div></div></div>
                <button class="sb-logout" onclick="alert('Sign out')" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></button>
            </div>
        </aside>

        <!-- ══ TOPNAV ══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Management</span><span>/</span><b id="tnCur">Stores</b></nav>
            <div class="tn-center"><div class="tn-center-main" id="tnTitle">Store Management</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <button class="tn-btn" type="button"><svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></button>
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="tn-count">12</span></a>
                <a class="tn-btn" href="#"><svg class="ico" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg><span class="tn-dot dot-g"></span></a>
                <div class="tn-sep"></div>
                <div class="tn-profile" onclick="alert('Profile')"><div class="tn-av">DC</div><div><div class="tn-pname">Daniel Carter</div><div class="tn-prole">Operations Director</div></div></div>
            </div>
        </header>

        <!-- ══ MAIN ══ -->
        <main class="wa-main" id="waMain">

            <section class="page-hero">
                <div>
                    <h1>Store Management</h1>
                    <p>Approve, suspend, reject or delete stores. Click any store row to view full details, products and orders.</p>
                </div>
                <div class="page-hero-actions">
                    <button class="btn btn-outline btn-sm" onclick="exportStores()">📥 Export</button>
                    <button class="btn btn-primary btn-sm" onclick="openM('addStoreModal')">+ Add Store</button>
                </div>
            </section>

            <div class="page-body">

                <!-- KPI -->
                <div class="kpi-grid kpi-grid-4">
                    <div class="kpi-card c1"><div class="kpi-ico green">🏪</div><div class="kpi-val" id="kpiTotal">42</div><div class="kpi-label">Total Stores</div><div class="kpi-chip chip-green">+5 this month</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">✅</div><div class="kpi-val" id="kpiActive">35</div><div class="kpi-label">Active</div><div class="kpi-chip chip-blue">83% rate</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">⏳</div><div class="kpi-val" id="kpiPending">3</div><div class="kpi-label">Pending Approval</div><div class="kpi-chip chip-yellow">Needs review</div></div>
                    <div class="kpi-card c4"><div class="kpi-ico red">🔒</div><div class="kpi-val" id="kpiSuspended">2</div><div class="kpi-label">Suspended</div><div class="kpi-chip chip-red">Policy issues</div></div>
                </div>

                <!-- Filters -->
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
                    <div class="search-wrap" style="flex:1 1 260px;">
                        <span style="color:var(--text-muted)">🔍</span>
                        <input type="text" id="searchInput" placeholder="Search by store name, owner, city..." oninput="renderTable()" />
                    </div>
                    <select class="sel-wrap" style="width:auto;min-width:160px;" id="statusFilter" onchange="renderTable()">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="pending">Pending</option>
                        <option value="suspended">Suspended</option>
                        <option value="rejected">Rejected</option>
                    </select>
                    <select class="sel-wrap" style="width:auto;min-width:150px;" id="modelFilter" onchange="renderTable()">
                        <option value="">All Models</option>
                        <option value="Subscription">Subscription</option>
                        <option value="Commission">Commission</option>
                    </select>
                    <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                </div>

                <!-- Quick filter chips -->
                <div class="chips-row" id="chipsRow">
                    <button class="filter-chip active" data-f="" onclick="setChip(this)">All <span id="chipAll"></span></button>
                    <button class="filter-chip" data-f="pending" onclick="setChip(this)">⏳ Pending <span id="chipPending"></span></button>
                    <button class="filter-chip" data-f="active" onclick="setChip(this)">✅ Active <span id="chipActive"></span></button>
                    <button class="filter-chip" data-f="suspended" onclick="setChip(this)">🔒 Suspended <span id="chipSuspended"></span></button>
                    <button class="filter-chip" data-f="rejected" onclick="setChip(this)">❌ Rejected <span id="chipRejected"></span></button>
                </div>

                <!-- Table -->
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">All Stores</div>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span class="table-count" id="tableCount"></span>
                            <select class="sel-wrap" style="height:36px;font-size:.78rem;width:auto;min-width:160px;" onchange="sortStores(this.value)">
                                <option value="newest">Newest First</option>
                                <option value="name">Name A–Z</option>
                                <option value="rating">Highest Rating</option>
                                <option value="revenue">Highest Revenue</option>
                            </select>
                        </div>
                    </div>

                    <!-- Bulk bar -->
                    <div id="bulkBar" style="display:none;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#FFF9EE;border-top:1px solid #E8D9A0;border-bottom:1px solid #E8D9A0;padding:12px 16px;">
                        <span style="font-weight:800;color:var(--brand-dark);font-size:.87rem;" id="bulkCount">0 selected</span>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                            <button class="btn btn-success btn-sm" onclick="bulkAction('active')">✅ Activate</button>
                            <button class="btn btn-warning btn-sm" onclick="bulkAction('suspended')">🔒 Suspend</button>
                            <button class="btn btn-danger btn-sm" onclick="bulkAction('delete')">🗑 Delete</button>
                            <button class="btn btn-outline btn-sm" onclick="clearSelection()">✕ Clear</button>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th><input type="checkbox" id="checkAll" onchange="toggleAll(this)" /></th>
                                    <th>Store</th>
                                    <th>Owner</th>
                                    <th>City</th>
                                    <th>Model</th>
                                    <th>Products</th>
                                    <th>Rating</th>
                                    <th>Revenue</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="storesTBody"></tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="pagination-bar">
                        <div class="pag-info" id="pagInfo">Showing 0 stores</div>
                        <div class="pag-pages" id="pagPages"></div>
                    </div>
                </div>

            </div><!-- /page-body -->
        </main>
    </div><!-- /wa-shell -->
    <!-- ══ STORE DETAIL PANEL ══ -->
    <div class="detail-overlay" id="storeDetailPanel">
        <div class="detail-panel" style="max-width:980px;">
            <div class="dp-header">
                <div class="dp-title" id="dpTitle">🏪 Store Details</div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <a class="btn btn-outline btn-sm" id="dpViewFullBtn" href="#">View Full Details →</a>
                    <button class="dp-close" onclick="closeM('storeDetailPanel')">✕</button>
                </div>
            </div>
            <div class="dp-body">

                <div class="dp-profile" id="dpProfile">
                    <div class="dp-avatar" id="dpAvatar">🏪</div>
                    <div style="flex:1;">
                        <div class="dp-name" id="dpName"></div>
                        <div class="dp-meta" id="dpMeta"></div>
                        <div class="dp-badges" id="dpBadges" style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap;"></div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;">
                        <button class="btn btn-success btn-sm" id="dpApproveBtn" onclick="dpAction('active')">✅ Approve</button>
                        <button class="btn btn-warning btn-sm" onclick="dpAction('suspended')">🔒 Suspend</button>
                        <button class="btn btn-danger btn-sm" onclick="dpAction('rejected')">❌ Reject</button>
                        <button class="btn btn-outline btn-sm" onclick="openWarnModal()">⚠️ Warn</button>
                    </div>
                </div>

                <div class="dp-section">
                    <div class="dp-section-title">Store Information</div>
                    <div class="dp-grid">
                        <div class="dp-info-item"><div class="dp-info-label">Owner</div><div class="dp-info-val" id="dpOwner"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Email</div><div class="dp-info-val" id="dpEmail"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Phone</div><div class="dp-info-val" id="dpPhone"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">City</div><div class="dp-info-val" id="dpCity"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Payment Model</div><div class="dp-info-val" id="dpModel"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Joined</div><div class="dp-info-val" id="dpJoined"></div></div>
                    </div>
                </div>

                <div class="dp-section">
                    <div class="dp-section-title">Quick Stats</div>
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;">
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Products</div><div class="dp-info-val" id="dpProducts" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Orders</div><div class="dp-info-val" id="dpOrders" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Revenue</div><div class="dp-info-val green" id="dpRevenue" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                        <div class="dp-info-item" style="text-align:center;"><div class="dp-info-label">Rating</div><div class="dp-info-val" id="dpRating" style="font-family:'Fredoka',sans-serif;font-size:1.5rem;"></div></div>
                    </div>
                </div>

                <div class="dp-section">
                    <div class="dp-section-title">Documents</div>
                    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;" id="dpDocs"></div>
                </div>

                <div class="dp-section">
                    <div class="dp-section-title">Recent Products <span style="font-size:.75rem;font-weight:700;color:var(--text-muted);">(latest 3)</span></div>
                    <div id="dpProductsList"></div>
                </div>

                <div class="dp-section">
                    <div class="dp-section-title">Recent Orders <span style="font-size:.75rem;font-weight:700;color:var(--text-muted);">(latest 3)</span></div>
                    <div id="dpOrdersList"></div>
                </div>

            </div>
            <div class="dp-footer">
                <button class="btn btn-danger btn-sm" onclick="dpAction('delete')">🗑 Delete Store</button>
                <button class="btn btn-outline btn-sm" onclick="closeM('storeDetailPanel')">Close</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Add Store ══ -->
    <div class="modal-overlay" id="addStoreModal">
        <div class="modal-box" style="max-width:680px;">
            <div class="modal-head"><div class="modal-title">🏪 Add New Store</div><button class="dp-close" onclick="closeM('addStoreModal')">✕</button></div>
            <div class="modal-body">
                <div style="display:flex;align-items:center;gap:14px;padding:14px;border-radius:18px;margin-bottom:16px;background:linear-gradient(180deg,#fffdfa,#f7f1ea);border:1px solid var(--border);">
                    <div style="width:52px;height:52px;border-radius:16px;display:grid;place-items:center;font-size:1.6rem;background:linear-gradient(135deg,#8da546,#5f7430);color:#fff;flex-shrink:0;">🏪</div>
                    <div><div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:var(--brand-dark);">New Store Registration</div><div style="font-size:.82rem;color:var(--text-muted);margin-top:3px;">Fill in all required fields to register a new store.</div></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="field" style="grid-column:1/-1;"><label>Store Name *</label><input type="text" id="addStoreName" placeholder="e.g. Pet Food Store" /></div>
                    <div class="field"><label>Owner Full Name *</label><input type="text" id="addOwner" placeholder="e.g. Ahmad Al-Khatib" /></div>
                    <div class="field"><label>Email *</label><input type="email" id="addEmail" placeholder="store@email.com" /></div>
                    <div class="field"><label>Phone *</label><input type="text" id="addPhone" placeholder="07XXXXXXXX" /></div>
                    <div class="field">
                        <label>City *</label>
                        <select id="addCity">
                            <option value="">Select city</option>
                            <option>Amman</option>
                            <option>Zarqa</option>
                            <option>Irbid</option>
                            <option>Aqaba</option>
                            <option>Balqa</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Payment Model *</label>
                        <select id="addModel">
                            <option value="">Select model</option>
                            <option>Subscription</option>
                            <option>Commission</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Initial Status</label>
                        <select id="addStatus">
                            <option value="pending">Pending</option>
                            <option value="active">Active</option>
                        </select>
                    </div>
                    <div class="field" style="grid-column:1/-1;"><label>Store Description</label><textarea id="addDesc" placeholder="Short description..."></textarea></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('addStoreModal')">Cancel</button>
                <button class="btn btn-primary" onclick="saveNewStore()">Save Store</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Warn ══ -->
    <div class="modal-overlay" id="warnModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">⚠️ Send Official Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
            <div class="modal-body">
                <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.2);border-radius:12px;padding:12px;font-size:.82rem;font-weight:700;color:#9b6000;margin-bottom:14px;">The warning will be sent to the store owner and recorded in moderation history.</div>
                <div class="field"><label>Target Store</label><input type="text" id="warnTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Warning Type</label>
                    <select id="warnType">
                        <option>Policy violation</option>
                        <option>Misleading product information</option>
                        <option>High complaint volume</option>
                        <option>Repeated delivery delays</option>
                        <option>Terms of service violation</option>
                    </select>
                </div>
                <div class="field"><label>Warning Message</label><textarea id="warnMessage" placeholder="Write the official warning message..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button class="btn btn-warning" onclick="sendWarning()">Send Warning</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Suspend ══ -->
    <div class="modal-overlay" id="suspendModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">🔒 Suspend Store</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target Store</label><input type="text" id="suspendTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Suspension Reason</label>
                    <select id="suspendReason">
                        <option>Policy violation</option>
                        <option>Multiple complaints</option>
                        <option>Unpaid dues</option>
                        <option>Invalid documents</option>
                        <option>Suspicious activity</option>
                    </select>
                </div>
                <div class="field">
                    <label>Duration</label>
                    <select id="suspendDuration">
                        <option>7 days</option>
                        <option>30 days</option>
                        <option>90 days</option>
                        <option>Permanent</option>
                    </select>
                </div>
                <div class="field"><label>Message to Store</label><textarea id="suspendMessage" placeholder="Explain the reason..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
                <button class="btn btn-danger" onclick="confirmSuspend()">Suspend Store</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Reject ══ -->
    <div class="modal-overlay" id="rejectModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">❌ Reject Store</div><button class="dp-close" onclick="closeM('rejectModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target Store</label><input type="text" id="rejectTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Rejection Reason</label>
                    <select id="rejectReason">
                        <option>Incomplete documents</option>
                        <option>Does not meet platform requirements</option>
                        <option>Duplicate store</option>
                        <option>Suspicious registration</option>
                        <option>Other</option>
                    </select>
                </div>
                <div class="field"><label>Message to Applicant</label><textarea id="rejectMessage" placeholder="Explain why the request was rejected..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('rejectModal')">Cancel</button>
                <button class="btn btn-danger" onclick="confirmReject()">Confirm Rejection</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Delete Confirm ══ -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box" style="max-width:440px;">
            <div class="modal-head"><div class="modal-title">🗑 Delete Store</div><button class="dp-close" onclick="closeM('deleteModal')">✕</button></div>
            <div class="modal-body">
                <div style="text-align:center;padding:10px 0 20px;">
                    <div style="font-size:3rem;margin-bottom:12px;">⚠️</div>
                    <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--brand-dark);margin-bottom:8px;">Are you sure?</div>
                    <div style="font-size:.88rem;color:var(--text-muted);font-weight:700;">You are about to permanently delete <strong id="deleteStoreName" style="color:var(--danger);"></strong>. This action cannot be undone.</div>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-outline" onclick="closeM('deleteModal')">Cancel</button>
                <button class="btn btn-danger" onclick="confirmDelete()">Yes, Delete Store</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Approve ══ -->
    <div class="modal-overlay" id="approveModal">
        <div class="modal-box" style="max-width:540px;">
            <div class="modal-head"><div class="modal-title">✅ Approve Store Registration</div><button class="dp-close" onclick="closeM('approveModal')">✕</button></div>
            <div class="modal-body">
                <div style="background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:14px;">
                    <div style="font-size:.92rem;font-weight:900;color:var(--brand-dark);margin-bottom:4px;" id="approveStoreName"></div>
                    <div style="font-size:.78rem;color:var(--text-muted);" id="approveStoreMeta"></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;" id="approveDocGrid"></div>
                <div class="field"><label>Admin Note (optional)</label><textarea id="approveNote" placeholder="Add an internal note..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger btn-sm" onclick="closeM('approveModal');openRejectModal(currentStoreId)">❌ Reject Instead</button>
                <button class="btn btn-outline" onclick="closeM('approveModal')">Cancel</button>
                <button class="btn btn-success" onclick="confirmApprove()">✅ Approve Store</button>
            </div>
        </div>
    </div>

    <!-- ══ SCRIPTS ══ -->
    <script src="~/js/Waffy-Shell.js"></script>
    <script src="~/js/superAdminClinic.js"></script>
    <script>
        const stores = [
            { id:1, name:"Pet Friends Store", emoji:"🐾", owner:"Mohammad Al-Omari", email:"store@petfriends.jo", phone:"0791234567", city:"Amman", model:"Subscription", status:"active", products:48, orders:186, revenue:1840, rating:4.2, joined:"2026-01-01",
                documents:{ registration:true, license:true, trademark:true, tax:true },
                recentProducts:[ {name:"Premium Dog Food",price:"18.5 JD",status:"active"}, {name:"Cat Litter Box",price:"12 JD",status:"active"}, {name:"Bird Vitamins",price:"9 JD",status:"flagged"} ],
                recentOrders:[ {id:"#1023",user:"Sara",amount:"22 JD",status:"delivered"}, {id:"#1021",user:"Omar",amount:"18 JD",status:"delivered"}, {id:"#1019",user:"Rana",amount:"36 JD",status:"pending"} ]
            },
            { id:2, name:"BestPet Store", emoji:"🛍️", owner:"Layan Haddad", email:"bestpet@store.com", phone:"0784561230", city:"Irbid", model:"Commission", status:"active", products:32, orders:124, revenue:980, rating:4.7, joined:"2026-02-05",
                documents:{ registration:true, license:true, trademark:true, tax:false },
                recentProducts:[ {name:"Cat Scratching Tree",price:"32 JD",status:"active"}, {name:"Dog Collar",price:"8 JD",status:"active"}, {name:"Hamster Cage",price:"25 JD",status:"active"} ],
                recentOrders:[ {id:"#987",user:"Dina",amount:"32 JD",status:"delivered"}, {id:"#982",user:"Khalid",amount:"8 JD",status:"delivered"}, {id:"#978",user:"Nour",amount:"56 JD",status:"canceled"} ]
            },
            { id:3, name:"Pet Care Pharmacy", emoji:"💊", owner:"Ahmad Shboul", email:"pharmacy@petcare.com", phone:"0795558899", city:"Amman", model:"Subscription", status:"pending", products:65, orders:0, revenue:0, rating:0, joined:"2026-03-02",
                documents:{ registration:true, license:false, trademark:true, tax:true },
                recentProducts:[], recentOrders:[]
            },
            { id:4, name:"Happy Tails Market", emoji:"🐶", owner:"Nour Khalil", email:"tails@market.com", phone:"0796688123", city:"Zarqa", model:"Commission", status:"suspended", products:21, orders:60, revenue:510, rating:3.8, joined:"2025-12-19",
                documents:{ registration:true, license:true, trademark:false, tax:true },
                recentProducts:[ {name:"Hamster Wheel",price:"8.2 JD",status:"hidden"}, {name:"Dog Snacks",price:"5 JD",status:"active"} ],
                recentOrders:[ {id:"#821",user:"Fatima",amount:"13 JD",status:"delivered"} ]
            },
            { id:5, name:"Aqaba Pet World", emoji:"🌊", owner:"Raneem Obeid", email:"aqaba@petworld.com", phone:"0771122334", city:"Aqaba", model:"Subscription", status:"pending", products:17, orders:0, revenue:0, rating:0, joined:"2026-03-15",
                documents:{ registration:false, license:true, trademark:false, tax:false },
                recentProducts:[], recentOrders:[]
            },
            { id:6, name:"Cat House", emoji:"🐱", owner:"Razan Sami", email:"cat@house.com", phone:"0792223344", city:"Amman", model:"Subscription", status:"active", products:14, orders:88, revenue:690, rating:4.0, joined:"2026-01-28",
                documents:{ registration:true, license:true, trademark:true, tax:true },
                recentProducts:[ {name:"Cat Wet Food",price:"2.5 JD",status:"active"}, {name:"Cat Toys Set",price:"7 JD",status:"active"} ],
                recentOrders:[ {id:"#910",user:"Hana",amount:"10 JD",status:"delivered"}, {id:"#905",user:"Sami",amount:"7 JD",status:"pending"} ]
            },
            { id:7, name:"Furry Friends Shop", emoji:"🐰", owner:"Bassem Nasser", email:"furry@friends.jo", phone:"0798001122", city:"Balqa", model:"Commission", status:"rejected", products:0, orders:0, revenue:0, rating:0, joined:"2026-03-20",
                documents:{ registration:false, license:false, trademark:false, tax:false },
                recentProducts:[], recentOrders:[]
            }
        ];

        let currentStoreId = null;
        let selectedIds    = new Set();
        let currentSort    = 'newest';
        let currentChip    = '';
        const PAGE_SIZE    = 6;
        let currentPage    = 1;

        function statusBadge(s) {
            const map = { active:['badge-success','✅ Active'], pending:['badge-warning','⏳ Pending'], suspended:['badge-danger','🔒 Suspended'], rejected:['badge-muted','❌ Rejected'] };
            const [cls, lbl] = map[s] || ['badge-muted', s];
            return `<span class="badge ${cls}">${lbl}</span>`;
        }
        function modelBadge(m) {
            return m === 'Subscription' ? `<span class="badge badge-info">💳 Subscription</span>` : `<span class="badge badge-purple">📊 Commission</span>`;
        }
        function starsHtml(r) {
            if (!r) return '<span style="color:var(--text-muted);font-size:.78rem;">No rating</span>';
            return '⭐'.repeat(Math.round(r)) + `<span style="margin-left:4px;font-weight:900;color:var(--brand-dark);">${r.toFixed(1)}</span>`;
        }
        function getFiltered() {
            const q   = (document.getElementById('searchInput')?.value || '').toLowerCase();
            const st  = document.getElementById('statusFilter')?.value || '';
            const mo  = document.getElementById('modelFilter')?.value  || '';
            const chip = currentChip;
            return stores.filter(s => {
                const mQ  = !q  || [s.name,s.owner,s.email,s.city].some(v => v.toLowerCase().includes(q));
                const mSt = !st && !chip ? true : (chip ? s.status === chip : s.status === st);
                const mMo = !mo || s.model === mo;
                return mQ && mSt && mMo;
            }).sort((a,b) => {
                if (currentSort === 'name')    return a.name.localeCompare(b.name);
                if (currentSort === 'rating')  return b.rating - a.rating;
                if (currentSort === 'revenue') return b.revenue - a.revenue;
                return new Date(b.joined) - new Date(a.joined);
            });
        }
        function renderTable() {
            const data   = getFiltered();
            const total  = data.length;
            const pages  = Math.ceil(total / PAGE_SIZE);
            if (currentPage > pages) currentPage = 1;
            const slice = data.slice((currentPage-1)*PAGE_SIZE, currentPage*PAGE_SIZE);
            const tbody = document.getElementById('storesTBody');
            tbody.innerHTML = slice.length ? slice.map(s => `
                <tr style="cursor:pointer;" onclick="openDetail(${s.id})" class="${selectedIds.has(s.id)?'selected':''}">
                    <td onclick="event.stopPropagation()"><input type="checkbox" class="row-chk" data-id="${s.id}" ${selectedIds.has(s.id)?'checked':''} onchange="toggleRow(this)"/></td>
                    <td><div style="display:flex;align-items:center;gap:10px;"><div style="width:40px;height:40px;border-radius:12px;background:var(--brand-xlight);border:1px solid var(--border);display:grid;place-items:center;font-size:1.2rem;flex-shrink:0;">${s.emoji}</div><div><div class="cell-title">${s.name}</div><div class="cell-sub">${s.email}</div></div></div></td>
                    <td>${s.owner}</td>
                    <td>📍 ${s.city}</td>
                    <td>${modelBadge(s.model)}</td>
                    <td>${s.products > 0 ? s.products + ' 📦' : '—'}</td>
                    <td>${starsHtml(s.rating)}</td>
                    <td>${s.revenue > 0 ? '<strong style="color:var(--success);">'+s.revenue.toLocaleString()+' JD</strong>' : '—'}</td>
                    <td>${statusBadge(s.status)}</td>
                    <td style="font-size:.78rem;color:var(--text-muted);">${s.joined}</td>
                    <td onclick="event.stopPropagation()">
                        <div style="display:flex;gap:5px;align-items:center;">
                            <button class="btn btn-outline btn-xs" onclick="openDetail(${s.id})">👁 View</button>
                            ${s.status==='pending' ? `<button class="btn btn-success btn-xs" onclick="quickApprove(${s.id})">✅</button><button class="btn btn-danger btn-xs" onclick="openRejectModal(${s.id})">❌</button>` : ''}
                            ${s.status==='active' ? `<button class="btn btn-warning btn-xs" onclick="openSuspendModal(${s.id})">🔒</button>` : ''}
                            ${s.status==='suspended' ? `<button class="btn btn-success btn-xs" onclick="setStatus(${s.id},'active','Re-activated')">✅</button>` : ''}
                            <button class="btn btn-danger btn-xs" onclick="openDeleteModal(${s.id})">🗑</button>
                        </div>
                    </td>
                </tr>`).join('')
            : `<tr><td colspan="11" style="text-align:center;padding:32px;color:var(--text-muted);font-size:.9rem;">No stores found matching your filters.</td></tr>`;

            document.getElementById('pagInfo').textContent = total === 0 ? 'No stores found' : `Showing ${(currentPage-1)*PAGE_SIZE+1}–${Math.min(currentPage*PAGE_SIZE,total)} of ${total} stores`;
            const pagEl = document.getElementById('pagPages');
            pagEl.innerHTML = '';
            const pages2 = Math.ceil(total / PAGE_SIZE);
            if (pages2 > 1) {
                const addBtn = (label, page, active=false, disabled=false) => {
                    const b = document.createElement('button');
                    b.className = 'pag-btn' + (active?' active':'');
                    b.textContent = label; b.disabled = disabled;
                    b.onclick = () => { currentPage = page; renderTable(); };
                    pagEl.appendChild(b);
                };
                addBtn('‹', currentPage-1, false, currentPage===1);
                for (let i=1; i<=pages2; i++) {
                    if (pages2 > 7 && i > 2 && i < pages2-1 && Math.abs(i-currentPage) > 1) {
                        if (i === 3 || i === pages2-2) { const s=document.createElement('button'); s.className='pag-btn'; s.textContent='…'; s.disabled=true; pagEl.appendChild(s); }
                        continue;
                    }
                    addBtn(i, i, i===currentPage);
                }
                addBtn('›', currentPage+1, false, currentPage===pages2);
            }
            updateKPIs(); updateBulkBar();
            document.getElementById('tableCount').textContent = total + ' stores';
        }
        function updateKPIs() {
            const cnt = s => stores.filter(x => x.status===s).length;
            document.getElementById('kpiTotal').textContent     = stores.length;
            document.getElementById('kpiActive').textContent    = cnt('active');
            document.getElementById('kpiPending').textContent   = cnt('pending');
            document.getElementById('kpiSuspended').textContent = cnt('suspended');
            document.getElementById('chipAll').textContent       = `(${stores.length})`;
            document.getElementById('chipPending').textContent   = `(${cnt('pending')})`;
            document.getElementById('chipActive').textContent    = `(${cnt('active')})`;
            document.getElementById('chipSuspended').textContent = `(${cnt('suspended')})`;
            document.getElementById('chipRejected').textContent  = `(${cnt('rejected')})`;
        }
        function openDetail(id) {
            const s = stores.find(x => x.id === id);
            if (!s) return;
            currentStoreId = id;
            document.getElementById('dpTitle').textContent   = `${s.emoji} ${s.name}`;
            document.getElementById('dpAvatar').textContent  = s.emoji;
            document.getElementById('dpName').textContent    = s.name;
            document.getElementById('dpMeta').textContent    = `${s.city} · ${s.model}`;
            document.getElementById('dpOwner').textContent   = s.owner;
            document.getElementById('dpEmail').textContent   = s.email;
            document.getElementById('dpPhone').textContent   = s.phone;
            document.getElementById('dpCity').textContent    = s.city;
            document.getElementById('dpModel').innerHTML     = modelBadge(s.model);
            document.getElementById('dpJoined').textContent  = s.joined;
            document.getElementById('dpProducts').textContent = s.products;
            document.getElementById('dpOrders').textContent   = s.orders;
            document.getElementById('dpRevenue').textContent  = s.revenue > 0 ? s.revenue.toLocaleString()+' JD' : '—';
            document.getElementById('dpRating').textContent   = s.rating > 0 ? '⭐'+s.rating.toFixed(1) : '—';
            document.getElementById('dpBadges').innerHTML = statusBadge(s.status) + modelBadge(s.model);
            document.getElementById('dpApproveBtn').style.display = s.status === 'pending' ? 'block' : 'none';
            document.getElementById('dpViewFullBtn').href = `/SuperAdmin/Details_S?id=${s.id}`;
            const docLabels = { registration:'Commercial Reg.', license:'Business License', trademark:'Trademark', tax:'Tax File' };
            document.getElementById('dpDocs').innerHTML = Object.entries(s.documents).map(([k,v]) => `
                <div style="background:${v?'var(--success-soft)':'var(--danger-soft)'};border:1px solid ${v?'rgba(47,158,95,.2)':'rgba(217,83,79,.2)'};border-radius:12px;padding:12px;">
                    <div style="font-size:.7rem;color:var(--text-muted);font-weight:900;">${docLabels[k]}</div>
                    <div style="margin-top:5px;font-size:.84rem;font-weight:900;color:${v?'var(--success)':'var(--danger)'};">${v?'✅ Uploaded':'❌ Missing'}</div>
                </div>`).join('');
            const pEl = document.getElementById('dpProductsList');
            pEl.innerHTML = s.recentProducts.length ? s.recentProducts.map(p => `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(221,209,191,.5);">
                    <div style="font-size:.86rem;font-weight:800;color:var(--brand-dark);">📦 ${p.name}</div>
                    <div style="display:flex;align-items:center;gap:8px;"><span style="font-size:.8rem;font-weight:700;color:var(--text-muted);">${p.price}</span>${statusBadge(p.status)}</div>
                </div>`).join('') : '<div style="padding:12px 0;font-size:.84rem;color:var(--text-muted);">No products yet.</div>';
            const oEl = document.getElementById('dpOrdersList');
            oEl.innerHTML = s.recentOrders.length ? s.recentOrders.map(o => `
                <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(221,209,191,.5);">
                    <div style="display:flex;gap:10px;align-items:center;"><span style="font-family:'Fredoka',sans-serif;color:var(--brand-dark);font-weight:700;">${o.id}</span><span style="font-size:.82rem;color:var(--text-muted);">by ${o.user}</span></div>
                    <div style="display:flex;align-items:center;gap:8px;"><span style="font-size:.8rem;font-weight:700;color:var(--success);">${o.amount}</span>${statusBadge(o.status)}</div>
                </div>`).join('') : '<div style="padding:12px 0;font-size:.84rem;color:var(--text-muted);">No orders yet.</div>';
            openM('storeDetailPanel');
        }
        function dpAction(action) {
            const s = stores.find(x => x.id === currentStoreId);
            if (!s) return;
            if (action === 'delete')    { openDeleteModal(s.id); return; }
            if (action === 'suspended') { openSuspendModal(s.id); return; }
            if (action === 'rejected')  { openRejectModal(s.id); return; }
            if (action === 'active')    { openApproveModal(s.id); return; }
        }
        function quickApprove(id) { currentStoreId = id; openApproveModal(id); }
        function openApproveModal(id) {
            const s = stores.find(x => x.id === id);
            if (!s) return;
            currentStoreId = id;
            document.getElementById('approveStoreName').textContent = s.name;
            document.getElementById('approveStoreMeta').textContent = `Owner: ${s.owner} · ${s.city} · ${s.model}`;
            const docLabels = { registration:'Commercial Reg.', license:'Business License', trademark:'Trademark', tax:'Tax File' };
            document.getElementById('approveDocGrid').innerHTML = Object.entries(s.documents).map(([k,v]) => `
                <div style="background:${v?'var(--success-soft)':'var(--danger-soft)'};border:1px solid ${v?'rgba(47,158,95,.2)':'rgba(217,83,79,.2)'};border-radius:12px;padding:12px;">
                    <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;">${docLabels[k]}</div>
                    <div style="margin-top:5px;font-size:.84rem;font-weight:900;color:${v?'var(--success)':'var(--danger)'};">${v?'✅ Uploaded':'❌ Missing'}</div>
                </div>`).join('');
            openM('approveModal');
        }
        function confirmApprove() { setStatus(currentStoreId,'active','Approved'); closeM('approveModal'); if(document.getElementById('storeDetailPanel').classList.contains('open')) openDetail(currentStoreId); }
        function openRejectModal(id) { const s=stores.find(x=>x.id===id); if(!s) return; currentStoreId=id; document.getElementById('rejectTarget').value=s.name; document.getElementById('rejectMessage').value=''; openM('rejectModal'); }
        function confirmReject() { setStatus(currentStoreId,'rejected','Rejected'); closeM('rejectModal'); if(document.getElementById('storeDetailPanel').classList.contains('open')) openDetail(currentStoreId); }
        function openSuspendModal(id) { const s=stores.find(x=>x.id===id); if(!s) return; currentStoreId=id; document.getElementById('suspendTarget').value=s.name; document.getElementById('suspendMessage').value=''; openM('suspendModal'); }
        function confirmSuspend() { setStatus(currentStoreId,'suspended','Suspended'); closeM('suspendModal'); if(document.getElementById('storeDetailPanel').classList.contains('open')) openDetail(currentStoreId); }
        function openDeleteModal(id) { const s=stores.find(x=>x.id===id); if(!s) return; currentStoreId=id; document.getElementById('deleteStoreName').textContent=s.name; openM('deleteModal'); }
        function confirmDelete() { const idx=stores.findIndex(x=>x.id===currentStoreId); if(idx!==-1) stores.splice(idx,1); selectedIds.delete(currentStoreId); closeM('deleteModal'); closeM('storeDetailPanel'); renderTable(); toast('Store deleted successfully.','danger'); }
        function openWarnModal() { const s=stores.find(x=>x.id===currentStoreId); if(!s) return; document.getElementById('warnTarget').value=s.name; document.getElementById('warnMessage').value=''; openM('warnModal'); }
        function sendWarning() { const name=document.getElementById('warnTarget').value; closeM('warnModal'); toast(`Warning sent to ${name}.`,'warning'); }
        function setStatus(id,newStatus,label) { const s=stores.find(x=>x.id===id); if(!s) return; s.status=newStatus; renderTable(); toast(`${s.name} — ${label}.`,newStatus==='active'?'success':newStatus==='rejected'?'danger':'warning'); }
        function saveNewStore() {
            const name=document.getElementById('addStoreName').value.trim(), owner=document.getElementById('addOwner').value.trim(), email=document.getElementById('addEmail').value.trim(), phone=document.getElementById('addPhone').value.trim(), city=document.getElementById('addCity').value, model=document.getElementById('addModel').value;
            if(!name||!owner||!email||!phone||!city||!model){toast('Please fill all required fields.','danger');return;}
            stores.unshift({id:Date.now(),name,emoji:'🏪',owner,email,phone,city,model,status:document.getElementById('addStatus').value,products:0,orders:0,revenue:0,rating:0,joined:new Date().toISOString().split('T')[0],documents:{registration:false,license:false,trademark:false,tax:false},recentProducts:[],recentOrders:[]});
            closeM('addStoreModal'); renderTable(); toast(`${name} added successfully.`,'success');
        }
        function toggleRow(cb) { const id=Number(cb.dataset.id); cb.checked?selectedIds.add(id):selectedIds.delete(id); const row=cb.closest('tr'); if(row) row.classList.toggle('selected',cb.checked); document.getElementById('checkAll').checked=getFiltered().every(s=>selectedIds.has(s.id)); updateBulkBar(); }
        function toggleAll(master) { getFiltered().forEach(s=>master.checked?selectedIds.add(s.id):selectedIds.delete(s.id)); renderTable(); }
        function clearSelection() { selectedIds.clear(); document.getElementById('checkAll').checked=false; renderTable(); }
        function updateBulkBar() { const bar=document.getElementById('bulkBar'),cnt=document.getElementById('bulkCount'); bar.style.display=selectedIds.size>0?'flex':'none'; cnt.textContent=selectedIds.size+' store(s) selected'; }
        function bulkAction(action) {
            if(!selectedIds.size) return;
            const names=[...selectedIds].map(id=>stores.find(s=>s.id===id)?.name).filter(Boolean);
            if(action==='delete'){selectedIds.forEach(id=>{const idx=stores.findIndex(s=>s.id===id);if(idx>-1)stores.splice(idx,1);});selectedIds.clear();toast(`Deleted ${names.length} store(s).`,'danger');}
            else{stores.forEach(s=>{if(selectedIds.has(s.id))s.status=action;});toast(`Updated ${names.length} store(s) to "${action}".`,action==='active'?'success':'warning');selectedIds.clear();}
            renderTable();
        }
        function setChip(btn) { document.querySelectorAll('#chipsRow .filter-chip').forEach(c=>c.classList.remove('active')); btn.classList.add('active'); currentChip=btn.dataset.f; document.getElementById('statusFilter').value=''; currentPage=1; renderTable(); }
        function sortStores(v) { currentSort=v; currentPage=1; renderTable(); }
        function resetFilters() { document.getElementById('searchInput').value=''; document.getElementById('statusFilter').value=''; document.getElementById('modelFilter').value=''; currentChip=''; currentPage=1; document.querySelectorAll('#chipsRow .filter-chip').forEach((c,i)=>c.classList.toggle('active',i===0)); renderTable(); }
        function exportStores() { toast('Exporting '+getFiltered().length+' stores...','success'); }
        function openM(id) { const m=document.getElementById(id); if(m) m.classList.add('open'); }
        function closeM(id) { const m=document.getElementById(id); if(m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay,.detail-overlay').forEach(m=>{ m.addEventListener('click',e=>{if(e.target===m) m.classList.remove('open');}); });
        function toast(msg,type='success') {
            const colors={success:'var(--success)',danger:'var(--danger)',warning:'#9b6000'}, bg={success:'var(--success-soft)',danger:'var(--danger-soft)',warning:'var(--warning-soft)'};
            const t=document.createElement('div');
            t.style.cssText=`position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${colors[type]}40;color:${colors[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
            t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),3000);
        }
        const toastStyle=document.createElement('style');
        toastStyle.textContent=`@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}`;
        document.head.appendChild(toastStyle);
        renderTable();
    </script>
</body>
</html>
