@model Waffy.Models.ViewModels.SuperAdminAdoptionViewModel
@{
    Layout = null;
    var statusOptions = new[] { "All", "Pending", "Approved", "Closed", "Rejected" };
    var sourceOptions = new[] { "All", "User", "Clinic", "Store" };
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | Adoption Listings</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/KpiResponsive.css" asp-append-version="true" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ═══ SIDEBAR ═══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-shop">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span>
                            <span class="sb-bdg bd-y">@Model.PendingCount</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-adopt" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span><span class="sb-bdg bd-y sb-child-bdg">@Model.PendingCount</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints"><span class="sb-dot"></span><span class="sb-child-lbl">System Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span>
                        <span class="sb-lbl">Map</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span>
                        <span class="sb-lbl">Notifications</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.AdminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.AdminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button class="sb-logout" type="submit">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span class="sb-logout-lbl">Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- ═══ TOPNAV ═══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
            <nav class="tn-bread"><span>Adoption</span><span>/</span><b>Listings</b></nav>
            <div class="tn-center">
                <div class="tn-center-main">Adoption Listings</div>
                <div class="tn-center-sub">Super Admin Panel</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.AdminInitials</div>
                    <div><div class="tn-pname">@ViewBag.AdminName</div><div class="tn-prole">Super Admin</div></div>
                </div>
            </div>
        </header>

        <!-- ═══ MAIN ═══ -->
        <main class="wa-main" id="waMain">

            @if (ViewBag.Success != null)
            {
                <div style="margin:16px 24px 0;background:var(--success-soft);border:1px solid rgba(46,125,50,.2);
                            color:#2e7d32;padding:12px 16px;border-radius:var(--r);font-weight:800;font-size:.86rem;">
                    @ViewBag.Success
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div style="margin:16px 24px 0;background:var(--danger-soft);border:1px solid rgba(217,83,79,.2);
                            color:var(--danger);padding:12px 16px;border-radius:var(--r);font-weight:800;font-size:.86rem;">
                    @ViewBag.Error
                </div>
            }

            <section class="page-hero">
                <div>
                    <h1>🐾 Adoption Listings</h1>
                    <p>@Model.TotalCount total posts — @Model.PendingCount pending your approval</p>
                </div>
            </section>

            <div class="page-body">

                <!-- ── KPI Cards ── -->
                <div class="kpi-grid kpi-grid-5" style="margin-bottom:20px;">
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">📋</div>
                        <div class="kpi-val">@Model.TotalCount</div>
                        <div class="kpi-label">Total Posts</div>
                        <div class="kpi-chip chip-green">All time</div>
                    </div>
                    <div class="kpi-card c3">
                        <div class="kpi-ico yellow">⏳</div>
                        <div class="kpi-val">@Model.PendingCount</div>
                        <div class="kpi-label">Pending</div>
                        <div class="kpi-chip chip-yellow">Needs review</div>
                    </div>
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">✅</div>
                        <div class="kpi-val">@Model.ApprovedCount</div>
                        <div class="kpi-label">Approved</div>
                        <div class="kpi-chip chip-green">Live now</div>
                    </div>
                    <div class="kpi-card c2">
                        <div class="kpi-ico blue">🔒</div>
                        <div class="kpi-val">@Model.ClosedCount</div>
                        <div class="kpi-label">Closed</div>
                        <div class="kpi-chip chip-blue">Completed</div>
                    </div>
                    <div class="kpi-card c4">
                        <div class="kpi-ico red">❌</div>
                        <div class="kpi-val">@Model.RejectedCount</div>
                        <div class="kpi-label">Rejected</div>
                        <div class="kpi-chip chip-red">By admin</div>
                    </div>
                </div>

                <!-- ── Filter Form ── -->
                <form method="get" asp-action="Listings" asp-controller="SuperAdmin"
                      class="toolbar" style="margin-bottom:14px;">
                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;width:100%;">
                        <span style="font-weight:800;font-size:.82rem;color:var(--text-muted);white-space:nowrap;">
                            Filter by:
                        </span>
                        <select name="statusFilter" class="sel-wrap"
                                style="height:44px;min-width:160px;border:1.5px solid var(--border);
                                   border-radius:12px;background:#fff;padding:0 12px;
                                   font-weight:700;font-size:.86rem;">
                            @foreach (var s in statusOptions)
                            {
                                if (s == Model.StatusFilter)
                                {
                                    <option value="@s" selected>@s</option>
                                }
                                else
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                        <select name="sourceFilter" class="sel-wrap"
                                style="height:44px;min-width:160px;border:1.5px solid var(--border);
                                   border-radius:12px;background:#fff;padding:0 12px;
                                   font-weight:700;font-size:.86rem;">
                            @foreach (var s in sourceOptions)
                            {
                                if (s == Model.SourceFilter)
                                {
                                    <option value="@s" selected>@(s == "All" ? "All Sources" : s)</option>
                                }
                                else
                                {
                                    <option value="@s">@(s == "All" ? "All Sources" : s)</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                        <a href="@Url.Action("Listings", "SuperAdmin")" class="btn btn-outline btn-sm">Reset</a>
                    </div>
                </form>

                <!-- ── Table ── -->
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">
                            @if (Model.StatusFilter != "All" || Model.SourceFilter != "All")
                            {
                                <span>Filtered Results</span>
                            }
                            else
                            {
                                <span>All Adoption Posts</span>
                            }
                        </div>
                        <span class="table-count">@Model.Posts.Count() posts</span>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Pet</th>
                                    <th>Type</th>
                                    <th>Source</th>
                                    <th>Owner</th>
                                    <th>City</th>
                                    <th>Post Status</th>
                                    <th>Adoption</th>
                                    <th>❤ Likes</th>
                                    <th>🚩</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Posts.Any())
                                {
                                    <tr>
                                        <td colspan="11" style="text-align:center;padding:32px;
                                        color:var(--text-muted);font-weight:700;">
                                            No posts found for the selected filters.
                                        </td>
                                    </tr>
                                }
                                @foreach (var post in Model.Posts)
                                {
                                    var rowBg = post.FlagCount > 0 ? "background:#fffcf3;" : "";
                                    <tr style="@rowBg">
                                        <td>
                                            <div style="display:flex;align-items:center;gap:9px;">
                                                <div style="width:36px;height:36px;border-radius:10px;
                                                 background:var(--brand-xlight);display:grid;
                                                 place-items:center;font-size:1rem;
                                                 border:1px solid var(--brand-light);flex-shrink:0;">
                                                    @(post.AnimalType?.ToLower() == "cat" ? "🐈" :
                                                                                                    post.AnimalType?.ToLower() == "dog" ? "🐕" :
                                                                                                    post.AnimalType?.ToLower() == "bird" ? "🐦" :
                                                                                                    post.AnimalType?.ToLower() == "rabbit" ? "🐇" : "🐾")
                                            </div>
                                            <div>
                                                <div class="cell-title">@post.PetName</div>
                                                <div class="cell-sub">#@post.IdPost</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="font-size:.82rem;">@post.AnimalType</td>
                                    <td>
                                        @{
                                                var srcClass = post.PostedByType == "User" ? "badge-info" :
                                                post.PostedByType == "Clinic" ? "badge-success" :
                                                "badge-purple";
                                            }
                                            <span class="badge @srcClass">@post.PostedByType</span>
                                        </td>
                                        <td style="font-size:.82rem;color:var(--text-muted);">@post.OwnerName</td>
                                        <td style="font-size:.82rem;">@post.City</td>
                                        <td>
                                            @{
                                                var stClass = post.Status == "Approved" ? "badge-success" :
                                                post.Status == "Pending" ? "badge-warning" :
                                                post.Status == "Rejected" ? "badge-danger" :
                                                "badge-muted";
                                            }
                                            <span class="badge @stClass">@post.Status</span>
                                        </td>
                                        <td>
                                            @{
                                                var adClass = post.AdoptionStatus == "Available" ? "badge-info" :
                                                post.AdoptionStatus == "Reserved" ? "badge-orange" :
                                                "badge-muted";
                                            }
                                            <span class="badge @adClass">@post.AdoptionStatus</span>
                                        </td>
                                        <td style="font-size:.84rem;font-weight:800;">❤ @post.Likes</td>
                                        <td>
                                            @if (post.FlagCount > 0)
                                            {
                                                <span style="background:var(--danger-soft);color:var(--danger);
                                                      font-size:.72rem;font-weight:900;padding:3px 8px;
                                                      border-radius:999px;">
                                                    🚩 @post.FlagCount
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--text-muted);font-size:.8rem;">—</span>
                                            }
                                        </td>
                                        <td style="font-size:.78rem;color:var(--text-muted);">
                                            @post.CreatedAt.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            <div class="action-group">
                                                @if (post.Status == "Pending")
                                                {
                                                    <form method="post" asp-action="ApproveListing"
                                                          asp-controller="SuperAdmin" style="display:inline"
                                                          onsubmit="return confirm('Approve and publish this post?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@post.IdPost" />
                                                        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="sourceFilter" value="@Model.SourceFilter" />
                                                        <button type="submit" class="btn btn-success btn-xs">✓ Approve</button>
                                                    </form>
                                                    <form method="post" asp-action="RejectListing"
                                                          asp-controller="SuperAdmin" style="display:inline"
                                                          onsubmit="return confirm('Reject this post?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@post.IdPost" />
                                                        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="sourceFilter" value="@Model.SourceFilter" />
                                                        <button type="submit" class="btn btn-danger btn-xs">✕ Reject</button>
                                                    </form>
                                                }
                                                @if (post.Status == "Approved")
                                                {
                                                    <form method="post" asp-action="CloseListing"
                                                          asp-controller="SuperAdmin" style="display:inline"
                                                          onsubmit="return confirm('Close this post?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@post.IdPost" />
                                                        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
                                                        <input type="hidden" name="sourceFilter" value="@Model.SourceFilter" />
                                                        <button type="submit" class="btn btn-outline btn-xs">🔒 Close</button>
                                                    </form>
                                                }
                                                @if (post.FlagCount > 0)
                                                {
                                                    <a asp-action="Flagged" asp-controller="SuperAdmin"
                                                       class="btn btn-warning btn-xs">🚩 Flags</a>
                                                }
                                                @if (post.Status == "Closed" || post.Status == "Rejected")
                                                {
                                                    <span style="color:var(--text-muted);font-size:.8rem;">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
</body>
</html>