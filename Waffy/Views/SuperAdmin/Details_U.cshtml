        <!-- TAB: CONTACT -->
        <div class="tab-pane" id="tab-contact">
            <div class="grid-2">
                <div class="inner-card">
                    <div class="inner-card-head"><div class="inner-card-title">✉️ Compose Message</div></div>
                    <div class="inner-card-body">
                        <form method="post" asp-controller="SuperAdmin" asp-action="SendMessage">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@fSearch" />
                            <input type="hidden" name="returnStatus" value="@fStatus" />
                            <input type="hidden" name="returnRole" value="@fRole" />
                            <input type="hidden" name="returnPage" value="@fPage" />
                            <div class="compose-field">
                                <div class="compose-label">Message Type</div>
                                <select name="msgType" class="compose-select">
                                    <option value="Warning">⚠️ Warning</option>
                                    <option value="Notification">🔔 Notification</option>
                                    <option value="Info">📧 Info</option>
                                    <option value="Action">⚡ Action Required</option>
                                </select>
                            </div>
                            <div class="compose-field">
                                <div class="compose-label">Priority</div>
                                <select name="priority" class="compose-select">
                                    <option value="Low">🟢 Low</option>
                                    <option value="Normal" selected>🔵 Normal</option>
                                    <option value="High">🟡 High</option>
                                    <option value="Urgent">🔴 Urgent</option>
                                </select>
                            </div>
                            <div class="compose-field">
                                <div class="compose-label">Template</div>
                                <select class="compose-select" id="templateSelect" onchange="applyTemplate(this.value)">
                                    <option value="">Select a template...</option>
                                    <option value="warn_policy">⚠️ Policy Violation Warning</option>
                                    <option value="warn_suspicious">⚠️ Suspicious Activity</option>
                                    <option value="notif_found">🔔 Pet Found Match</option>
                                    <option value="positive">🌟 Community Thanks</option>
                                </select>
                            </div>
                            <div class="compose-field">
                                <div class="compose-label">Title <span style="color:var(--danger);">*</span></div>
                                <input class="compose-input" id="msgTitle" name="title" placeholder="Message subject..." required />
                            </div>
                            <div class="compose-field">
                                <div class="compose-label">Message <span style="color:var(--danger);">*</span></div>
                                <textarea class="compose-textarea" id="msgBody" name="message" placeholder="Write your message here..." required></textarea>
                            </div>
                            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                <button type="submit" class="btn btn-primary btn-sm">📤 Send</button>
                                <button type="button" class="btn btn-outline btn-sm" onclick="clearMsg()">🗑️ Clear</button>
                            </div>
                        </form>
                    </div>
                </div>
                @* ── Recipient Info ── *@
                <div class="inner-card">
                    <div class="inner-card-head"><div class="inner-card-title">📋 Recipient Info</div></div>
                    <div class="inner-card-body">
                        <div class="info-list">
                            <div class="info-line"><span class="info-key">Name</span><span class="info-val">@u.FullName</span></div>
                            <div class="info-line"><span class="info-key">Email</span><span class="info-val">@u.Email</span></div>
                            <div class="info-line"><span class="info-key">Phone</span><span class="info-val">@(u.Phone ?? "—")</span></div>
                            <div class="info-line">
                                <span class="info-key">Status</span>
                                <span class="info-val"><span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span></span>
                            </div>
                            <div class="info-line">
                                <span class="info-key">Warnings</span>
                                <span class="info-val">
                                    @if (u.WarningCount == 0)
                                    {
                                        <span style="color:var(--success);font-weight:900;">✅ None</span>
                                    }
                                    else
                                    {

                                        <span style="color:var(--danger);font-weight:900;">⚠️ @u.WarningCount</span>
                                    }
                                </span>
                            </div>
                            <div class="info-line"><span class="info-key">Last Active</span><span class="info-val">@u.LastActiveLabel</span></div>
                        </div>
                        <div style="margin-top:14px;padding:12px;background:var(--surface-2);
                    border-radius:12px;border:1px solid var(--border);
                    font-size:.78rem;color:var(--text-muted);font-weight:700;">
                            💡 Message will be sent as an in-app notification.
                            User will see it when they next open Waffy.
                        </div>
                    </div>
                </div>

                @* ── Message History ── *@
                <div class="inner-card" style="margin-top:14px;">
                    <div class="inner-card-head">
                        <div class="inner-card-title">📨 Message History</div>
                        <span class="badge badge-muted">@Model.MessageHistory.Count sent</span>
                    </div>

                    @if (!Model.MessageHistory.Any())
                    {
                        <div style="text-align:center;padding:32px;
                            color:var(--text-muted);font-weight:700;">
                            📭 No messages sent yet.
                        </div>
                    }
                    else
                    {
                        <div style="max-height:320px;overflow-y:auto;">
                            @foreach (var msg in Model.MessageHistory)
                            {
                                var typeIcon = msg.Type switch
                                {
                                    "Warning" => "⚠️",
                                    "Notification" => "🔔",
                                    "Info" => "📧",
                                    "Action" => "⚡",
                                    _ => "📨"
                                };
                                var typeColor = msg.Type switch
                                {
                                    "Warning" => "var(--warning)",
                                    "Action" => "var(--danger)",
                                    _ => "var(--brand)"
                                };
                                <div style="padding:12px 18px;
                                            border-bottom:1px solid rgba(221,209,191,.55);
                                            transition:.15s;">
                                    <div style="display:flex;justify-content:space-between;
                                                align-items:flex-start;gap:10px;">
                                        <div style="flex:1;">
                                            <div style="display:flex;align-items:center;gap:6px;
                                                        margin-bottom:4px;">
                                                <span style="font-size:.9rem;">@typeIcon</span>
                                                <span style="font-weight:900;color:var(--brand-dark);
                                                             font-size:.85rem;">
                                                    @(msg.Title ?? "—")
                                                </span>
                                            </div>
                                            <div style="font-size:.78rem;color:var(--text-muted);
                                                        font-weight:700;line-height:1.5;">
                                                @(msg.Message?.Length > 100
                                                                                        ? msg.Message[..100] + "..."
                                                                                        : msg.Message ?? "—")
                                    </div>
                                </div>
                                <div style="text-align:right;flex-shrink:0;">
                                    <div style="font-size:.74rem;color:var(--text-muted);
                                        font-weight:700;">
                                        @msg.CreatedAt?.ToString("dd MMM yyyy")
                                    </div>
                                    <div style="margin-top:4px;">
                                        @if (msg.IsRead)
                                                {
                                                    <span style="font-size:.72rem;color:var(--success);
                                                                         font-weight:800;">✅ Read</span>
                                                }
                                                else
                                                {
                                                    <span style="font-size:.72rem;color:var(--text-muted);
                                                                         font-weight:800;">📭 Unread</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

            </div>
        </div>

    </div>
</main>

</div>

<!-- MODAL: Warn -->
<div class="modal-overlay" id="warnModal">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-head">
            <div class="modal-title">⚠️ Send Warning</div>
            <button class="dp-close" onclick="closeM('warnModal')">✕</button>
        </div>
        <form method="post" asp-controller="SuperAdmin" asp-action="WarnUser">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@u.UserId" />
            <input type="hidden" name="returnSearch" value="@fSearch" />
            <input type="hidden" name="returnStatus" value="@fStatus" />
            <input type="hidden" name="returnRole" value="@fRole" />
            <input type="hidden" name="returnPage" value="@fPage" />
            <div class="modal-body">
                <div class="field">
                    <label>Target User</label>
                    <input type="text" value="@u.FullName" readonly style="background:#f5f0e8;border-radius:10px;padding:10px 14px;border:1px solid var(--border);width:100%;font-weight:800;" />
                </div>
                <div class="field">
                    <label>Warning Type</label>
                    <select name="warningType" class="compose-select">
                        <option value="Policy Violation Warning">⚠️ Policy Violation</option>
                        <option value="Suspicious Activity Warning">🔍 Suspicious Activity</option>
                        <option value="False Report Warning">📋 False Report</option>
                        <option value="Reward Abuse Warning">🎟️ Reward Abuse</option>
                    </select>
                </div>
                <div class="field">
                    <label>Message</label>
                    <textarea name="message" class="compose-textarea" placeholder="Write warning message..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button type="submit" class="btn btn-warning">⚠️ Send Warning</button>
            </div>
        </form>
    </div>
</div>


@section PageScripts {
    <script>
        const currentUser = {
            name:  '@u.FullName.Replace("'", "\\'")',
            email: '@u.Email',
            id:    @u.UserId
        };

        function showTab(id, btn) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tabs-row .tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + id)?.classList.add('active');
            if (btn) btn.classList.add('active');
        }

        const TEMPLATES = {
            warn_policy:     { title: '⚠️ Policy Violation Warning',     body: 'Your account activity has been reviewed and a policy violation was detected.' },
            warn_suspicious: { title: '⚠️ Suspicious Activity Detected', body: 'We have noticed unusual activity on your account. Please review our terms.' },
            notif_found:     { title: '🔔 Pet Match Found!',             body: 'A possible match has been found for your lost pet report. Please check the app.' },
            positive:        { title: '🌟 Thank You for Helping!',       body: 'Your contributions to the Waffy community have been recognized. Thank you!' }
        };

        function applyTemplate(v) {
            const t = TEMPLATES[v];
            if (t) {
                document.getElementById('msgTitle').value = t.title;
                document.getElementById('msgBody').value  = t.body;
            }
        }

        function clearMsg() {
            document.getElementById('msgTitle').value       = '';
            document.getElementById('msgBody').value        = '';
            document.getElementById('templateSelect').value = '';
        }

        function openM(id)  { const m = document.getElementById(id); if (m) m.classList.add('open'); }
        function closeM(id) { const m = document.getElementById(id); if (m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay').forEach(m => {
            m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
        });

        function toast(msg, type = 'success') {
            const bg  = { success: 'var(--success-soft)', danger: 'var(--danger-soft)', warning: 'var(--warning-soft)' };
            const col = { success: 'var(--success)',      danger: 'var(--danger)',      warning: '#9b6000' };
            const t   = document.createElement('div');
            t.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        const fm = document.getElementById('flashMsg');
        if (fm) { setTimeout(() => fm.style.opacity = '0', 3000); setTimeout(() => fm.remove(), 3400); }
    </script>
}
