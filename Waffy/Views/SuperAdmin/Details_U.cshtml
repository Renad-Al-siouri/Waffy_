@model Waffy.Models.ViewModels.UserDetailViewModel
@{
    ViewData["Title"] = $"Waffy — Admin | {Model.User.FullName}";
    Layout = null;
    var u = Model.User;
    var adminName = ViewBag.AdminName as string ?? "Admin";
    var adminInitials = ViewBag.AdminInitials as string ?? "AD";
    var fSearch = Model.ReturnSearch ?? "";
    var fStatus = Model.ReturnStatus ?? "";
    var fRole = Model.ReturnRole ?? "";
    var fPage = Model.ReturnPage;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .detail-hero {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            padding: 22px;
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
            flex-wrap: wrap;
        }

        .dh-avatar {
            width: 84px;
            height: 84px;
            border-radius: 22px;
            font-size: 2.2rem;
            background: var(--brand-mid);
            color: #fff;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .dh-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dh-online {
            position: absolute;
            bottom: -4px;
            right: -4px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            border: 3px solid #fff;
            background: var(--success);
        }

        .dh-info {
            flex: 1;
            min-width: 200px;
        }

        .dh-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .dh-meta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 8px;
            font-size: .83rem;
            color: var(--text-muted);
            font-weight: 700;
        }

        .dh-tags {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .dh-tag {
            padding: 5px 12px;
            border-radius: var(--pill);
            background: var(--surface-2);
            border: 1px solid var(--border);
            font-size: .76rem;
            font-weight: 800;
            color: var(--brand-dark);
        }

        .trust-box {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 16px 22px;
            text-align: center;
            min-width: 130px;
            box-shadow: var(--shadow);
            flex-shrink: 0;
        }

        .trust-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 2rem;
            font-weight: 700;
        }

        .trust-label {
            font-size: .75rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 4px;
        }

        .alert-box {
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: #FFF9EE;
            border: 1.5px solid #E8D9A0;
            border-radius: var(--r);
            padding: 14px 18px;
            margin-bottom: 14px;
            box-shadow: var(--shadow);
        }

            .alert-box.show {
                display: flex;
                animation: fadeUp .22s ease;
            }

        .quick-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px 16px;
            margin-bottom: 14px;
            box-shadow: var(--shadow);
        }

        .mini-stats {
            display: grid;
            grid-template-columns: repeat(6,1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .mini-stat {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px;
            text-align: center;
            box-shadow: var(--shadow);
            transition: .18s;
        }

            .mini-stat:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 22px rgba(78,58,39,.1);
            }

        .mini-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.45rem;
            color: var(--brand-dark);
            font-weight: 700;
        }

        .mini-label {
            font-size: .73rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 5px;
        }

        .tabs-row {
            display: flex;
            gap: 5px;
            overflow-x: auto;
            scrollbar-width: none;
            margin-bottom: 14px;
            padding-bottom: 2px;
        }

            .tabs-row::-webkit-scrollbar {
                display: none;
            }

        .inner-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 14px;
        }

        .inner-card-head {
            padding: 13px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .inner-card-title {
            font-family: 'Fredoka',sans-serif;
            font-size: .97rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .inner-card-body {
            padding: 16px 18px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .pet-row, .coupon-row, .report-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(221,209,191,.55);
            flex-wrap: wrap;
        }

            .pet-row:last-child, .coupon-row:last-child, .report-row:last-child {
                border-bottom: none;
            }

        .row-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--surface-2);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .row-grow {
            flex: 1;
            min-width: 140px;
        }

        .row-title {
            font-weight: 900;
            color: var(--brand-dark);
            font-size: .88rem;
        }

        .row-sub {
            font-size: .74rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-top: 2px;
        }

        .info-list {
            display: grid;
        }

        .info-line {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(221,209,191,.55);
            font-size: .84rem;
        }

            .info-line:last-child {
                border-bottom: none;
            }

        .info-key {
            color: var(--text-muted);
            font-weight: 700;
        }

        .info-val {
            font-weight: 900;
            color: var(--brand-dark);
            text-align: right;
        }

        .tl-wrap {
            position: relative;
            padding-left: 20px;
        }

            .tl-wrap::before {
                content: "";
                position: absolute;
                left: 7px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: var(--border);
            }

        .tl-row {
            position: relative;
            padding: 10px 0 10px 12px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .tl-dot {
            position: absolute;
            left: -5px;
            top: 18px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid #fff;
            flex-shrink: 0;
        }

        .compose-field {
            display: grid;
            gap: 6px;
            margin-bottom: 12px;
        }

        .compose-label {
            font-size: .8rem;
            font-weight: 900;
            color: var(--brand-dark);
        }

        .compose-input, .compose-select, .compose-textarea {
            width: 100%;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #FAFAF8;
            color: var(--text);
            font-size: .86rem;
            font-weight: 700;
            font-family: 'Nunito',sans-serif;
            outline: none;
            transition: .18s;
        }

        .compose-input {
            height: 44px;
            padding: 0 14px;
        }

        .compose-select {
            height: 44px;
            padding: 0 14px;
            cursor: pointer;
            -webkit-appearance: none;
            appearance: none;
        }

        .compose-textarea {
            padding: 12px 14px;
            min-height: 120px;
            resize: vertical;
        }

            .compose-input:focus, .compose-select:focus, .compose-textarea:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 3px rgba(151,173,77,.12);
            }

        .type-toggle {
            display: flex;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 12px;
        }

        .type-toggle-btn {
            flex: 1;
            padding: 10px 8px;
            border: none;
            background: #fff;
            font-size: .77rem;
            font-weight: 800;
            color: var(--text-muted);
            cursor: pointer;
            transition: .18s;
            border-right: 1px solid var(--border);
            text-align: center;
            font-family: 'Nunito',sans-serif;
        }

            .type-toggle-btn:last-child {
                border-right: none;
            }

            .type-toggle-btn.active {
                background: linear-gradient(135deg,var(--brand),var(--brand-dark));
                color: #fff;
            }

        .priority-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .priority-btn {
            flex: 1;
            min-width: 72px;
            padding: 10px 8px;
            border-radius: 12px;
            border: 2px solid var(--border);
            background: #fff;
            font-size: .78rem;
            font-weight: 800;
            cursor: pointer;
            transition: .18s;
            text-align: center;
            font-family: 'Nunito',sans-serif;
        }

            .priority-btn:hover {
                transform: translateY(-1px);
            }

            .priority-btn.p-low.sel {
                border-color: var(--success);
                background: var(--success-soft);
                color: #2e7d32;
            }

            .priority-btn.p-normal.sel {
                border-color: var(--info);
                background: var(--info-soft);
                color: #1565c0;
            }

            .priority-btn.p-high.sel {
                border-color: var(--warning);
                background: var(--warning-soft);
                color: #9b6000;
            }

            .priority-btn.p-urgent.sel {
                border-color: var(--danger);
                background: var(--danger-soft);
                color: var(--danger);
            }

        .msg-history-item {
            display: flex;
            gap: 12px;
            padding: 14px;
            border-bottom: 1px solid rgba(221,209,191,.55);
            transition: .15s;
        }

            .msg-history-item:last-child {
                border-bottom: none;
            }

            .msg-history-item:hover {
                background: #FAFAF8;
            }

        .msg-hdot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 5px;
        }

        .fraud-ok {
            background: var(--success-soft);
            border: 1px solid rgba(47,158,95,.2);
            border-radius: 12px;
            padding: 14px;
            margin-top: 12px;
        }

        .fraud-warn {
            background: var(--danger-soft);
            border: 1px solid rgba(217,83,79,.2);
            border-radius: 12px;
            padding: 14px;
            margin-top: 12px;
        }

        .flash-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            padding: 14px 20px;
            border-radius: 14px;
            font-weight: 800;
            font-size: .86rem;
            font-family: 'Nunito',sans-serif;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
            animation: fadeUp .25s ease;
            max-width: 320px;
        }

        .flash-success {
            background: var(--success-soft);
            border: 1px solid rgba(76,175,80,.3);
            color: var(--success);
        }

        .flash-danger {
            background: var(--danger-soft);
            border: 1px solid rgba(244,67,54,.3);
            color: var(--danger);
        }

        @@media(max-width:900px) {
            .mini-stats {
                grid-template-columns: repeat(3,1fr);
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:600px) {
            .mini-stats {
                grid-template-columns: repeat(2,1fr);
            }

            .detail-hero {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .dh-meta, .dh-tags {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- SIDEBAR -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Super Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row open active" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-users" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users">
                                    <span class="sb-dot"></span><span class="sb-child-lbl">All Users</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-shop">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span><span class="sb-bdg bd-y">5</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span><span class="sb-bdg bd-y sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span><span class="sb-bdg bd-y">8</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints">
                                    <span class="sb-dot"></span>
                                    <span class="sb-child-lbl">System Complaints</span>
                                </a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span>
                        <span class="sb-lbl">Map</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span>
                        <span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@adminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@adminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- TOPNAV -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <nav class="tn-bread">
                <span>Management</span><span>/</span>
                <a asp-controller="SuperAdmin" asp-action="Users"
                   asp-route-search="@fSearch" asp-route-status="@fStatus"
                   asp-route-role="@fRole" asp-route-page="@fPage"
                   style="color:var(--text-muted);font-weight:800;">Users</a>
                <span>/</span><b>@u.FullName</b>
            </nav>
            <div class="tn-center">
                <div class="tn-center-main">@u.FullName</div>
                <div class="tn-center-sub">360° View</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                    <span class="tn-count">12</span>
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@adminInitials</div>
                    <div>
                        <div class="tn-pname">@adminName</div>
                        <div class="tn-prole">Super Admin</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- MAIN -->
        <main class="wa-main" id="waMain">

            @if (ViewBag.Success != null)
            {
                <div class="flash-toast flash-success" id="flashMsg">@ViewBag.Success</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="flash-toast flash-danger" id="flashMsg">@ViewBag.Error</div>
            }

            <section class="page-hero">
                <div>
                    <h1>User 360° Profile</h1>
                    <p>@u.FullName — @u.RoleName · Full view of account, activity, and moderation.</p>
                </div>
                <div class="page-hero-actions">
                    <a asp-controller="SuperAdmin" asp-action="Users"
                       asp-route-search="@fSearch" asp-route-status="@fStatus"
                       asp-route-role="@fRole" asp-route-page="@fPage"
                       class="btn btn-outline btn-sm">← Back to Users</a>
                </div>
            </section>

            <div class="page-body">

                <!-- Risk / Status Alert -->
                @if (u.AccountStatus == "Suspended")
                {
                    <div class="alert-box show">
                        <div>
                            <div style="font-weight:900;color:#9b6000;">🔒 This account is suspended.</div>
                            <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">User cannot log in. You can reactivate below.</div>
                        </div>
                        <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser"
                              onsubmit="return confirm('Activate this account?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@fSearch" />
                            <input type="hidden" name="returnStatus" value="@fStatus" />
                            <input type="hidden" name="returnRole" value="@fRole" />
                            <input type="hidden" name="returnPage" value="@fPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-outline btn-sm">✅ Reactivate</button>
                        </form>
                    </div>
                }

                @if (u.AccountStatus == "Pending")
                {
                    <div class="alert-box show">
                        <div>
                            <div style="font-weight:900;color:#9b6000;">⏳ Account pending review.</div>
                            <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">Review documents then approve or reject.</div>
                        </div>
                        <div style="display:flex;gap:8px;">
                            <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser"
                                  onsubmit="return confirm('Approve this account?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <input type="hidden" name="returnSearch" value="@fSearch" />
                                <input type="hidden" name="returnStatus" value="@fStatus" />
                                <input type="hidden" name="returnRole" value="@fRole" />
                                <input type="hidden" name="returnPage" value="@fPage" />
                                <input type="hidden" name="from" value="details" />
                                <button type="submit" class="btn btn-warning btn-sm">✅ Approve</button>
                            </form>
                            <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser"
                                  onsubmit="return confirm('Reject this account?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <input type="hidden" name="returnSearch" value="@fSearch" />
                                <input type="hidden" name="returnStatus" value="@fStatus" />
                                <input type="hidden" name="returnRole" value="@fRole" />
                                <input type="hidden" name="returnPage" value="@fPage" />
                                <input type="hidden" name="from" value="details" />
                                <button type="submit" class="btn btn-danger btn-sm">🔒 Reject</button>
                            </form>
                        </div>
                    </div>
                }

                <!-- Detail Hero — بيانات حقيقية من DB -->
                <div class="detail-hero">
                    <div class="dh-avatar">
                        @if (!string.IsNullOrEmpty(u.ProfileImage))
                        {
                            <img src="~/uploads/@u.ProfileImage" alt="@u.FullName" />
                        }
                        else
                        {
                            @u.AvatarInitials
                        }
                        @if (u.AccountStatus == "Active")
                        {
                            <div class="dh-online"></div>
                        }
                    </div>
                    <div class="dh-info">
                        <div class="dh-name">@u.FullName</div>
                        <div class="dh-meta">
                            <span>📧 @u.Email</span>
                            <span>📞 @(u.Phone ?? "—")</span>
                            @if (!string.IsNullOrEmpty(u.City))
                            {
                                <span>📍 @u.City@(!string.IsNullOrEmpty(u.Area) ? $" — {u.Area}" : "")</span>
                            }
                            <span>📅 Joined @u.JoinedLabel</span>
                            <span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span>
                        </div>
                        <div class="dh-tags">
                            <span class="dh-tag">@u.RoleIcon @u.RoleName</span>
                            @if (!string.IsNullOrEmpty(u.Gender))
                            {
                                <span class="dh-tag">@u.Gender</span>
                            }
                            @if (!string.IsNullOrEmpty(u.Bio))
                            {
                                <span class="dh-tag" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@u.Bio">@u.Bio</span>
                            }
                        </div>
                    </div>
                    <div class="trust-box">
                        <div class="trust-val" style="font-size:1.4rem;">#@u.UserId</div>
                        <div class="trust-label">User ID</div>
                        <div style="margin-top:10px;font-size:.72rem;color:var(--text-muted);font-weight:800;">Since</div>
                        <div style="font-weight:800;font-size:.85rem;color:var(--brand-dark);">@u.JoinedLabel</div>
                    </div>
                </div>

                <!-- Quick Actions — تعمل على DB حقيقي -->
                <div class="quick-actions">

                    @if (u.AccountStatus == "Active")
                    {
                        <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser"
                              style="display:inline;" onsubmit="return confirm('Suspend this user?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@fSearch" />
                            <input type="hidden" name="returnStatus" value="@fStatus" />
                            <input type="hidden" name="returnRole" value="@fRole" />
                            <input type="hidden" name="returnPage" value="@fPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-danger btn-sm">🔒 Suspend</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser"
                              style="display:inline;" onsubmit="return confirm('Activate this user?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@fSearch" />
                            <input type="hidden" name="returnStatus" value="@fStatus" />
                            <input type="hidden" name="returnRole" value="@fRole" />
                            <input type="hidden" name="returnPage" value="@fPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-primary btn-sm">✅ Activate</button>
                        </form>
                    }

                    <button class="btn btn-warning btn-sm" onclick="openM('warnModal')">⚠️ Warning</button>

                    <form method="post" asp-controller="SuperAdmin" asp-action="DeleteUser"
                          style="display:inline;"
                          onsubmit="return confirm('Delete this user permanently?\nThis cannot be undone.')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <input type="hidden" name="returnSearch" value="@fSearch" />
                        <input type="hidden" name="returnStatus" value="@fStatus" />
                        <input type="hidden" name="returnRole" value="@fRole" />
                        <input type="hidden" name="returnPage" value="@fPage" />
                        <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
                    </form>

                    <button class="btn btn-outline btn-sm" onclick="quickAction('reset')">🔑 Reset Password</button>
                    <button class="btn btn-outline btn-sm" onclick="quickAction('restrict')">🚫 Restrict Reports</button>
                    <button class="btn btn-outline btn-sm" onclick="quickAction('cancelRewards')">🎟️ Cancel Rewards</button>

                    <a asp-controller="SuperAdmin"
                       asp-action="GiveRewardModal"
                       asp-route-userId="@u.UserId"
                       class="btn btn-outline btn-sm"
                       style="background:var(--warning-soft);border-color:rgba(226,163,58,.4);color:#9b6000;">
                        🎁 Give Reward
                    </a>
                </div>
                

                <!-- Mini Stats -->
                <div class="mini-stats">
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">🐾 Pets</div></div>
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">📅 Appointments</div></div>
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">🛍️ Orders</div></div>
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">🔍 Lost Reports</div></div>
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">🎟️ Coupons</div></div>
                    <div class="mini-stat"><div class="mini-val">—</div><div class="mini-label">🏠 Adoptions</div></div>
                </div>

                <!-- Tabs -->
                <div class="tabs-row">
                    <button class="tab-btn active" onclick="showTab('info',this)">👤 Info</button>
                    <button class="tab-btn" onclick="showTab('pets',this)">🐾 Pets</button>
                    <button class="tab-btn" onclick="showTab('lost',this)">🔍 Lost</button>
                    <button class="tab-btn" onclick="showTab('adoption',this)">🏠 Adoption</button>
                    <button class="tab-btn" onclick="showTab('rewards',this)">🎟️ Rewards</button>
                    <button class="tab-btn" onclick="showTab('orders',this)">🛍️ Orders</button>
                    <button class="tab-btn" onclick="showTab('appointments',this)">📅 Appointments</button>
                    <button class="tab-btn" onclick="showTab('timeline',this)">⏱️ Timeline</button>
                    <button class="tab-btn" onclick="showTab('complaints',this)">🚨 Complaints</button>
                    <button class="tab-btn" onclick="showTab('fraud',this)">🕵️ Fraud</button>
                    <button class="tab-btn" onclick="showTab('contact',this)">✉️ Contact</button>
                </div>

                <!-- TAB: INFO — بيانات حقيقية من DB -->
                <div class="tab-pane active" id="tab-info">
                    <div class="grid-2">
                        <div class="inner-card">
                            <div class="inner-card-head">
                                <div class="inner-card-title">👤 Account Information</div>
                                <span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span>
                            </div>
                            <div class="inner-card-body">
                                <div class="info-list">
                                    <div class="info-line"><span class="info-key">User ID</span>   <span class="info-val">#@u.UserId</span></div>
                                    <div class="info-line"><span class="info-key">Full Name</span> <span class="info-val">@u.FullName</span></div>
                                    <div class="info-line"><span class="info-key">Email</span>     <span class="info-val">@u.Email</span></div>
                                    <div class="info-line"><span class="info-key">Phone</span>     <span class="info-val">@(u.Phone ?? "—")</span></div>
                                    <div class="info-line"><span class="info-key">Gender</span>    <span class="info-val">@(u.Gender ?? "—")</span></div>
                                    <div class="info-line">
                                        <span class="info-key">Role</span>
                                        <span class="info-val"><span class="badge @u.RoleBadgeClass">@u.RoleIcon @u.RoleName</span></span>
                                    </div>
                                    <div class="info-line">
                                        <span class="info-key">Status</span>
                                        <span class="info-val"><span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span></span>
                                    </div>
                                    <div class="info-line"><span class="info-key">Joined</span>   <span class="info-val">@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="inner-card">
                            <div class="inner-card-head"><div class="inner-card-title">📍 Location &amp; Bio</div></div>
                            <div class="inner-card-body">
                                <div class="info-list">
                                    <div class="info-line"><span class="info-key">City</span> <span class="info-val">@(u.City ?? "—")</span></div>
                                    <div class="info-line"><span class="info-key">Area</span> <span class="info-val">@(u.Area ?? "—")</span></div>
                                    <div class="info-line">
                                        <span class="info-key">Bio</span>
                                        <span class="info-val" style="max-width:200px;white-space:normal;">@(string.IsNullOrEmpty(u.Bio) ? "—" : u.Bio)</span>
                                    </div>
                                    <div class="info-line">
                                        <span class="info-key">Profile Image</span>
                                        <span class="info-val">
                                            @if (!string.IsNullOrEmpty(u.ProfileImage))
                                            {
                                                <span style="color:var(--success);">✅ Uploaded</span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--text-muted);">None</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB: PETS — placeholder حتى تُبنى Pet Repository -->
                <div class="tab-pane" id="tab-pets">
                    <div class="inner-card">
                        <div class="inner-card-head">
                            <div class="inner-card-title">Connected Pets</div>
                            <span class="badge badge-muted">Coming soon</span>
                        </div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when Pet repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: LOST -->
                <div class="tab-pane" id="tab-lost">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Lost Reports</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when LostPetReport repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: ADOPTION -->
                <div class="tab-pane" id="tab-adoption">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Adoption Listings</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when AdoptionPost repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: REWARDS -->
                <div class="tab-pane" id="tab-rewards">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Rewards &amp; Coupons</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when Wallet repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: ORDERS -->
                <div class="tab-pane" id="tab-orders">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Orders &amp; Purchases</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when Order repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: APPOINTMENTS -->
                <div class="tab-pane" id="tab-appointments">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Appointments</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when Appointment repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: TIMELINE -->
                <div class="tab-pane" id="tab-timeline">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Activity Timeline</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when activity tracking is implemented.
                        </div>
                    </div>
                </div>

                <!-- TAB: COMPLAINTS -->
                <div class="tab-pane" id="tab-complaints">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Complaints &amp; Reports</div><span class="badge badge-muted">Coming soon</span></div>
                        <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🔧 Will be connected when Complaint repository is built.
                        </div>
                    </div>
                </div>

                <!-- TAB: FRAUD -->
                <div class="tab-pane" id="tab-fraud">
                    <div class="grid-2">
                        <div class="inner-card">
                            <div class="inner-card-head"><div class="inner-card-title">Fraud Indicators</div></div>
                            <div class="inner-card-body">
                                <div class="info-list">
                                    <div class="info-line"><span class="info-key">Lost Reports</span>       <span class="info-val">— (coming soon)</span></div>
                                    <div class="info-line"><span class="info-key">Reward Coupons</span>     <span class="info-val">— (coming soon)</span></div>
                                    <div class="info-line"><span class="info-key">Repeated Adoption</span>  <span class="info-val">— (coming soon)</span></div>
                                    <div class="info-line">
                                        <span class="info-key">Account Age</span>
                                        <span class="info-val">
                                            @if (u.CreatedAt.HasValue)
                                            {
                                                var months = (int)((DateTime.UtcNow - u.CreatedAt.Value).TotalDays / 30);
                                                @($"{months} months")
                                            }
                                            else
                                            {
                                                <text>—</text>
                                            }
                                        </span>
                                    </div>
                                    <div class="info-line"><span class="info-key">Unusual Activity</span>   <span class="info-val" style="color:var(--text-muted);">Pending analysis</span></div>
                                </div>
                                <div class="fraud-ok">
                                    <strong style="color:#2e7d32;">✅ No suspicious activity detected yet.</strong>
                                </div>
                            </div>
                        </div>
                        <div class="inner-card">
                            <div class="inner-card-head"><div class="inner-card-title">Restriction Controls</div></div>
                            <div class="inner-card-body">
                                <div class="info-list">
                                    <div class="info-line"><span class="info-key">Max reports/month</span><span class="info-val">5</span></div>
                                    <div class="info-line"><span class="info-key">Max coupons</span>      <span class="info-val">3</span></div>
                                </div>
                                <div style="margin-top:14px;display:grid;gap:8px;">
                                    <button class="btn btn-warning btn-sm" onclick="toast('Reports restricted for 30 days.','warning')">🚫 Restrict Reports</button>
                                    <button class="btn btn-danger btn-sm" onclick="toast('Rewards blocked.','danger')">🎟️ Block Rewards</button>
                                    <button class="btn btn-outline btn-sm" onclick="toast('User marked for monitoring.','success')">👁️ Mark for Monitoring</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB: CONTACT -->
                <div class="tab-pane" id="tab-contact">
                    <div class="grid-2">
                        <div class="inner-card">
                            <div class="inner-card-head"><div class="inner-card-title">✉️ Compose Message</div></div>
                            <div class="inner-card-body">
                                <div style="font-size:.78rem;font-weight:900;color:var(--brand-dark);margin-bottom:6px;">Message Type</div>
                                <div class="type-toggle">
                                    <button class="type-toggle-btn active" onclick="setMsgType(this)">⚠️ Warning</button>
                                    <button class="type-toggle-btn" onclick="setMsgType(this)">🔔 Notification</button>
                                    <button class="type-toggle-btn" onclick="setMsgType(this)">📧 Email</button>
                                    <button class="type-toggle-btn" onclick="setMsgType(this)">⚡ Action</button>
                                </div>
                                <div class="compose-field">
                                    <div class="compose-label">Title <span style="color:var(--danger);">*</span></div>
                                    <input class="compose-input" id="msgTitle" placeholder="Message subject..." />
                                </div>
                                <div class="compose-field">
                                    <div class="compose-label">📅 Send Date</div>
                                    <input class="compose-input" type="datetime-local" id="msgDate" />
                                </div>
                                <div class="compose-field">
                                    <div class="compose-label">🎯 Priority</div>
                                    <div class="priority-row">
                                        <button class="priority-btn p-low" data-p="low" onclick="setPriority(this)">🟢 Low</button>
                                        <button class="priority-btn p-normal sel" data-p="normal" onclick="setPriority(this)">🔵 Normal</button>
                                        <button class="priority-btn p-high" data-p="high" onclick="setPriority(this)">🟡 High</button>
                                        <button class="priority-btn p-urgent" data-p="urgent" onclick="setPriority(this)">🔴 Urgent</button>
                                    </div>
                                </div>
                                <div class="compose-field">
                                    <div class="compose-label">📋 Template</div>
                                    <select class="compose-select" onchange="applyTemplate(this.value)">
                                        <option value="">Select a template...</option>
                                        <option value="warn_policy">⚠️ Policy Violation Warning</option>
                                        <option value="warn_suspicious">⚠️ Suspicious Activity Warning</option>
                                        <option value="notif_appt">🔔 Appointment Reminder</option>
                                        <option value="notif_found">🔔 Pet Found Match</option>
                                        <option value="positive">🌟 Community Thanks</option>
                                    </select>
                                </div>
                                <div class="compose-field">
                                    <div class="compose-label">Message <span style="color:var(--danger);">*</span></div>
                                    <textarea class="compose-textarea" id="msgBody" placeholder="Write your message here..."></textarea>
                                </div>
                                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                                    <button class="btn btn-primary btn-sm" onclick="sendMsg()">📤 Send</button>
                                    <button class="btn btn-outline btn-sm" onclick="previewMsg()">👁️ Preview</button>
                                    <button class="btn btn-outline btn-sm" onclick="saveDraft()">💾 Draft</button>
                                    <span id="msgStatus" style="font-size:.8rem;color:var(--text-muted);font-weight:700;"></span>
                                </div>
                            </div>
                        </div>
                        <div class="inner-card">
                            <div class="inner-card-head">
                                <div class="inner-card-title">Communication History</div>
                                <span class="badge badge-muted">Coming soon</span>
                            </div>
                            <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                                🔧 Will be connected when Notification repository is built.
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- MODAL: Warn -->
    <div class="modal-overlay" id="warnModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">⚠️ Send Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target User</label><input type="text" id="warnTarget" value="@u.FullName" readonly style="background:#f5f0e8;" /></div>
                <div class="field">
                    <label>Warning Type</label>
                    <select><option>Policy violation</option><option>Suspicious activity</option><option>False report</option><option>Coupon abuse</option></select>
                </div>
                <div class="field"><label>Message</label><textarea placeholder="Write warning message..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button class="btn btn-warning" onclick="closeM('warnModal');toast('Warning sent to @u.FullName.Replace("'", "\\'")', 'warning')">Send Warning</button>
            </div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        // ── بيانات المستخدم من الـ Server ──
        const currentUser = {
            name:  '@u.FullName.Replace("'", "\\'")',
            email: '@u.Email',
            id:    @u.UserId
        };

        // ── Tabs ──
        function showTab(id, btn) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tabs-row .tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + id)?.classList.add('active');
            if (btn) btn.classList.add('active');
        }

        // ── Quick Actions (JS-only ones) ──
        function quickAction(type) {
            if      (type === 'reset')         { toast('Password reset link sent to ' + currentUser.email, 'success'); }
            else if (type === 'restrict')      { toast('Reports restricted for 30 days.', 'warning'); }
            else if (type === 'cancelRewards') { toast('All rewards cancelled.', 'danger'); }
        }

        // ── Message Composer ──
        function setMsgType(btn) {
            document.querySelectorAll('.type-toggle-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        function setPriority(btn) {
            document.querySelectorAll('.priority-btn').forEach(b => b.classList.remove('sel'));
            btn.classList.add('sel');
        }
        const TEMPLATES = {
            warn_policy:    { title: '⚠️ Policy Violation Warning',      body: 'Your account activity has been reviewed and a policy violation was detected.' },
            warn_suspicious:{ title: '⚠️ Suspicious Activity Detected',  body: 'We have noticed unusual activity on your account.' },
            notif_appt:     { title: '🔔 Upcoming Appointment Reminder', body: 'You have a scheduled appointment coming up.' },
            notif_found:    { title: '🔔 Pet Match Found!',              body: 'A possible match has been found for your lost pet report.' },
            positive:       { title: '🌟 Thank You for Helping the Community!', body: 'Your contributions have been recognized.' }
        };
        function applyTemplate(v) {
            const t = TEMPLATES[v];
            if (t) { document.getElementById('msgTitle').value = t.title; document.getElementById('msgBody').value = t.body; }
        }
        function sendMsg() {
            const title = document.getElementById('msgTitle').value.trim();
            const body  = document.getElementById('msgBody').value.trim();
            if (!title || !body) { toast('Please fill title and message.', 'danger'); return; }
            const s = document.getElementById('msgStatus');
            s.textContent = '✅ Sent!'; s.style.color = 'var(--success)';
            setTimeout(() => { s.textContent = ''; document.getElementById('msgTitle').value = ''; document.getElementById('msgBody').value = ''; }, 2500);
            toast('Message sent to ' + currentUser.name, 'success');
        }
        function previewMsg() {
            const title = document.getElementById('msgTitle').value || '(no title)';
            const body  = document.getElementById('msgBody').value  || '(no message)';
            alert('PREVIEW:\n\nTitle: ' + title + '\n\n' + body);
        }
        function saveDraft() {
            const s = document.getElementById('msgStatus');
            s.textContent = '💾 Draft saved'; s.style.color = 'var(--text-muted)';
            setTimeout(() => s.textContent = '', 2000);
        }

        // ── Modal Helpers ──
        function openM(id)  { const m = document.getElementById(id); if (m) m.classList.add('open'); }
        function closeM(id) { const m = document.getElementById(id); if (m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay').forEach(m => {
            m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
        });

        // ── Toast ──
        function toast(msg, type = 'success') {
            const bg  = { success: 'var(--success-soft)', danger: 'var(--danger-soft)', warning: 'var(--warning-soft)' };
            const col = { success: 'var(--success)',      danger: 'var(--danger)',      warning: '#9b6000'             };
            const t = document.createElement('div');
            t.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        // ── Flash Auto-Hide ──
        const fm = document.getElementById('flashMsg');
        if (fm) { setTimeout(() => fm.style.opacity = '0', 3000); setTimeout(() => fm.remove(), 3400); }
    </script>
</body>
</html>