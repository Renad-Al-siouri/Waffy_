                            </div>
                        </div>
                        @if (Model.Transactions.Any())
                        {
                            <div style="margin-top:14px;border-top:1px solid var(--border);padding-top:12px;">
                                <div style="font-size:.8rem;font-weight:900;color:var(--text-muted);margin-bottom:8px;">Recent Transactions</div>
                                @foreach (var t in Model.Transactions.OrderByDescending(x => x.CreatedAt).Take(5))
                                {
                                    var isCredit = t.Amount > 0;
                                    <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid rgba(221,209,191,.4);font-size:.83rem;">
                                        <div>
                                            <span style="font-weight:800;color:var(--brand-dark);">@(t.Type ?? "—")</span>
                                            <span style="color:var(--text-muted);font-size:.76rem;margin-left:6px;">@t.CreatedAt?.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <span style="font-weight:900;color:@(isCredit ? "var(--success)" : "var(--danger)");">@(isCredit ? "+" : "")@t.Amount.ToString("F2") JD</span>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="inner-card">
                <div class="inner-card-head"><div class="inner-card-title">🎁 Surprise Rewards (@Model.CouponsCount)</div></div>
