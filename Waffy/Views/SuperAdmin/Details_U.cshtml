        <!-- TAB: TIMELINE -->
        <div class="tab-pane" id="tab-timeline">
            <div class="inner-card">
                <div class="inner-card-head"><div class="inner-card-title">⏱️ Activity Timeline</div></div>
                <div class="inner-card-body">
                    @{
                        var events = new List<(string Icon, string Title, string Sub, DateTime? Date, string Color)>();
                        events.Add(("🎉", "Account Created", "Welcome to Waffy!", u.CreatedAt, "#7bb33a"));
                        foreach (var pet in Model.Pets)
                            events.Add(("🐾", $"Pet Added — {pet.Name}", $"{pet.Species ?? pet.Breed ?? "—"} · {(pet.Gender ?? "—")}", pet.CreatedAt, "#7bb33a"));
                        foreach (var r in Model.LostReports)
                            events.Add(("🔍", $"Lost Pet Report — {r.PetName}", $"{r.City} · {(r.RewardAmount > 0 ? $"Reward: {r.RewardAmount:F2} JD" : "No reward")} · {r.Status}", r.CreatedAt, "#e65100"));
                        foreach (var p in Model.AdoptionPosts)
                            events.Add(("🏠", $"Adoption Ad — {p.PetName}", $"{p.AnimalType} · {p.City} · {p.Status}", p.CreatedAt, "#5a9ecf"));
                        foreach (var o in Model.Orders)
                            events.Add(("🛍️", $"Order — {o.OrderCode}", $"Status: {o.Status} · Payment: {o.PaymentStatus}", o.CreatedAt, "#7b5ea7"));
                        foreach (var t in Model.Transactions.Where(t => t.Type != "RewardHold" && t.Type != "RewardReturn"))
                        {
                            var isCredit = t.Amount > 0;
                            events.Add((isCredit ? "💰" : "💸", isCredit ? $"Wallet Credit — +{t.Amount:F2} JD" : $"Payment — {Math.Abs(t.Amount):F2} JD", t.Type ?? "—", t.CreatedAt ?? DateTime.UtcNow, isCredit ? "#2d7a2d" : "#b91c1c"));
                        }
                        foreach (var r in Model.SurpriseRewards)
                            events.Add(("🎁", $"Surprise Reward — {r.RewardTitle}", $"{r.RewardType} · {r.ReasonCategory ?? "—"} · {r.RewardDisplay}", r.CreatedAt, "#9b6000"));
                        var sorted = events.OrderByDescending(e => e.Date).ToList();
                    }
                    @if (!sorted.Any())
                    {
                        <div style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">⏱️ No activity recorded yet.</div>
                    }
                    else
                    {
                        <div class="tl-wrap">
                            @foreach (var ev in sorted)
                            {
                                <div class="tl-row">
                                    <div class="tl-dot" style="background:@ev.Color;"></div>
                                    <div style="font-size:1.1rem;flex-shrink:0;">@ev.Icon</div>
                                    <div style="flex:1;">
                                        <div style="font-weight:900;color:var(--brand-dark);font-size:.86rem;">@ev.Title</div>
                                        <div style="font-size:.76rem;color:var(--text-muted);font-weight:700;margin-top:2px;">@ev.Sub</div>
                                    </div>
                                    <div style="font-size:.75rem;color:var(--text-muted);font-weight:700;white-space:nowrap;flex-shrink:0;">@(ev.Date?.ToString("dd MMM yyyy") ?? "—")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- TAB: COMPLAINTS -->
        <div class="tab-pane" id="tab-complaints">
            <div class="inner-card">
                <div class="inner-card-head"><div class="inner-card-title">🚨 Complaints (@Model.ComplaintsCount)</div></div>
                @if (!Model.Complaints.Any())
                {
                    <div style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">🚨 No complaints submitted yet.</div>
