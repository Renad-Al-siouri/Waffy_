    <div class="modal-overlay" id="editUserModal">
        <div class="modal-box" style="max-width:640px;">
            <div class="modal-head"><div class="modal-title">✏️ Edit User</div><button class="dp-close" onclick="closeM('editUserModal')">✕</button></div>
            <div class="modal-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="field"><label>Full Name *</label><input type="text" id="editName" /></div>
                    <div class="field"><label>Email *</label><input type="email" id="editEmail" /></div>
                    <div class="field"><label>Phone</label><input type="text" id="editPhone" /></div>
                    <div class="field"><label>Location</label><input type="text" id="editLocation" /></div>
                    <div class="field"><label>User Type</label><select id="editType"><option value="owner">🐾 Pet Owner</option><option value="vet">👨‍⚕️ Veterinarian</option><option value="store">🏪 Store Owner</option></select></div>
                    <div class="field"><label>Status</label><select id="editStatus"><option value="active">✅ Active</option><option value="suspicious">⚠️ Suspicious</option><option value="suspended">🔒 Suspended</option></select></div>
                    <div class="field"><label>Trust Score (0–100)</label><input type="number" id="editTrust" min="0" max="100" /></div>
                    <div class="field"><label>Pets Count</label><input type="number" id="editPets" min="0" /></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeM('editUserModal')">Cancel</button><button class="btn btn-primary" onclick="saveEdit()">Save Changes</button></div>
        </div>
    </div>

    <!-- MODAL: Add Pet -->
    <div class="modal-overlay" id="addPetModal">
        <div class="modal-box" style="max-width:580px;">
            <div class="modal-head"><div class="modal-title">🐾 Add Pet</div><button class="dp-close" onclick="closeM('addPetModal')">✕</button></div>
            <div class="modal-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="field"><label>Pet Name *</label><input type="text" id="petName" placeholder="Max" /></div>
                    <div class="field"><label>Type *</label><select id="petType"><option value="">Select...</option><option>Dog</option><option>Cat</option><option>Rabbit</option><option>Bird</option><option>Other</option></select></div>
                    <div class="field"><label>Breed</label><input type="text" id="petBreed" placeholder="Labrador" /></div>
                    <div class="field"><label>Age</label><input type="text" id="petAge" placeholder="3 years" /></div>
                    <div class="field"><label>Gender</label><select id="petGender"><option value="">Select</option><option>Male</option><option>Female</option></select></div>
                    <div class="field"><label>Status</label><select id="petStatus"><option value="Normal">Normal</option><option value="Lost">Lost</option><option value="For Adoption">For Adoption</option></select></div>
                    <div class="field" style="grid-column:1/-1;"><label>Last Vaccine</label><input type="text" id="petVaccine" placeholder="Mar 2025" /></div>
                </div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeM('addPetModal')">Cancel</button><button class="btn btn-primary" onclick="savePet()">Save Pet</button></div>
        </div>
    </div>

    <!-- MODAL: Warn -->
    <div class="modal-overlay" id="warnModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">⚠️ Send Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target User</label><input type="text" id="warnTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field"><label>Warning Type</label><select><option>Policy violation</option><option>Suspicious activity</option><option>False report</option><option>Coupon abuse</option></select></div>
                <div class="field"><label>Message</label><textarea placeholder="Write warning message..."></textarea></div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button><button class="btn btn-warning" onclick="closeM('warnModal');toast('Warning sent.','warning')">Send Warning</button></div>
        </div>
    </div>

    <!-- MODAL: Suspend -->
    <div class="modal-overlay" id="suspendModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">🔒 Suspend Account</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target User</label><input type="text" id="suspendTarget" readonly style="background:#f5f0e8;" /></div>
                <div class="field"><label>Duration</label><select><option>7 days</option><option>30 days</option><option>90 days</option><option>Permanent</option></select></div>
                <div class="field"><label>Reason</label><textarea placeholder="Explain reason..."></textarea></div>
            </div>
            <div class="modal-footer"><button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button><button class="btn btn-danger" onclick="closeM('suspendModal');toast('Account suspended.','danger')">Suspend</button></div>
        </div>
    </div>

    <!-- MODAL: Delete Confirm -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box" style="max-width:420px;">
            <div class="modal-head"><div class="modal-title">🗑 Delete User</div><button class="dp-close" onclick="closeM('deleteModal')">✕</button></div>
            <div class="modal-body" style="text-align:center;padding:24px 20px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">⚠️</div>
                <div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:var(--brand-dark);margin-bottom:8px;">Are you sure?</div>
                <div style="font-size:.86rem;color:var(--text-muted);font-weight:700;">This action cannot be undone.</div>
            </div>
            <div class="modal-footer" style="justify-content:center;"><button class="btn btn-outline" onclick="closeM('deleteModal')">Cancel</button><button class="btn btn-danger" onclick="doDelete()">Yes, Delete</button></div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        const USERS = [
          {id:'sara',   name:'Sara Al-Khatib',    email:'sara@email.com',     phone:'0791234567', location:'Amman — Al Jubaiha',     joined:'2025-01-10', joinedLabel:'Jan 2025', type:'owner', status:'active',    trust:87, pets:3, appointments:12,  orders:8,   lastActive:'Today',       avatar:'👩'},
          {id:'batool', name:'Batool Almasalmeh', email:'batool@email.com',   phone:'0799876543', location:'Amman — Khalda',          joined:'2025-02-02', joinedLabel:'Feb 2025', type:'owner', status:'active',    trust:72, pets:2, appointments:8,   orders:6,   lastActive:'Yesterday',   avatar:'👩'},
          {id:'risk',   name:'Mohammad Salameh',  email:'m.salama@email.com', phone:'0785432109', location:'Amman — Tlaa Al-Ali',     joined:'2025-03-01', joinedLabel:'Mar 2025', type:'owner', status:'suspicious', trust:31, pets:1, appointments:0,   orders:0,   lastActive:'3 days ago',  avatar:'👤'},
          {id:'vet',    name:'Dr. Ahmad Al-Zoubi',email:'dr.ahmad@email.com', phone:'0796543210', location:'Amman — Medical Complex', joined:'2025-01-15', joinedLabel:'Jan 2025', type:'vet',   status:'active',    trust:95, pets:0, appointments:142, orders:0,   lastActive:'Today',       avatar:'👨‍⚕️'},
          {id:'store',  name:'Batool Jaber',      email:'batool@petworld.jo', phone:'0798765432', location:'Amman — Sweifieh',        joined:'2025-03-04', joinedLabel:'Mar 2025', type:'store', status:'active',    trust:88, pets:0, appointments:0,   orders:320, lastActive:'Yesterday',   avatar:'🏪'},
          {id:'rana',   name:'Rana Al-Haddad',    email:'rana@email.com',     phone:'0793210987', location:'Amman — Shmeisani',       joined:'2024-12-18', joinedLabel:'Dec 2024', type:'owner', status:'suspended',  trust:22, pets:1, appointments:1,   orders:5,   lastActive:'45 days ago', avatar:'👩'},
          {id:'khaled', name:'Khaled Nasser',     email:'khaled@email.com',   phone:'0771122334', location:'Zarqa — New Zarqa',       joined:'2025-02-20', joinedLabel:'Feb 2025', type:'owner', status:'active',    trust:65, pets:4, appointments:5,   orders:12,  lastActive:'2 days ago',  avatar:'👨'},
          {id:'layan',  name:'Layan Mugdadi',     email:'layan@email.com',    phone:'0792223344', location:'Irbid — Downtown',        joined:'2025-03-10', joinedLabel:'Mar 2025', type:'vet',   status:'active',    trust:91, pets:0, appointments:88,  orders:0,   lastActive:'Today',       avatar:'👩‍⚕️'},
        ];

        let currentUser = null;

        function loadUser(){
          const params = new URLSearchParams(window.location.search);
          const id = params.get('id') || 'sara';
          currentUser = USERS.find(u=>u.id===id) || USERS[0];
          renderProfile();
        }

        function renderProfile(){
          const u = currentUser;
          const tc = t => t>=80?'var(--success)':t>=50?'var(--warning)':'var(--danger)';
          const typeLbl = {owner:'🐾 Pet Owner', vet:'👨‍⚕️ Veterinarian', store:'🏪 Store Owner'};

          document.getElementById('tnUserName').textContent = u.name;
          document.getElementById('tnTitle').textContent = u.name;
          document.title = `Waffy Admin | ${u.name}`;

          document.getElementById('heroAvatar').childNodes[0].textContent = u.avatar;
          document.getElementById('heroOnline').style.display = u.status==='active'?'block':'none';
          document.getElementById('heroName').textContent = u.name;
          document.getElementById('heroMeta').innerHTML = `
            <span>📧 ${u.email}</span>
            <span>📞 ${u.phone}</span>
            <span>📍 ${u.location}</span>
            <span>📅 Joined ${u.joinedLabel}</span>
            <span>${statusBadge(u.status)}</span>`;
          document.getElementById('heroTags').innerHTML = [
            '<span class="dh-tag">✅ Verified</span>',
            `<span class="dh-tag">${typeLbl[u.type]||u.type}</span>`,
            u.trust>=80?'<span class="dh-tag">🏅 Trusted</span>':'',
            u.trust<50?'<span class="dh-tag" style="background:var(--danger-soft);border-color:rgba(217,83,79,.2);color:var(--danger);">⚠️ High Risk</span>':'',
          ].join('');

          const tv = document.getElementById('trustVal');
          tv.textContent = u.trust+'%'; tv.style.color = tc(u.trust);

          document.getElementById('riskAlert').classList.toggle('show', u.trust<50);

          document.getElementById('mPets').textContent      = u.pets;
          document.getElementById('mAppts').textContent     = u.appointments;
          document.getElementById('mOrders').textContent    = u.orders || '—';
          document.getElementById('mReports').textContent   = u.trust<50 ? '5' : '1';
          document.getElementById('mCoupons').textContent   = u.trust<50 ? '4' : '2';
          document.getElementById('mAdoption').textContent  = u.type==='owner' ? '0' : '—';

          const months = Math.floor((Date.now()-new Date(u.joined))/2592000000);
          document.getElementById('fAge').textContent      = months + ' months';
          document.getElementById('fLost').textContent     = u.trust<50 ? '5 ⚠️ High' : '1 ✅ Normal';
          document.getElementById('fCoupons').textContent  = u.trust<50 ? '4 ⚠️ High' : '2 ✅ Normal';
          document.getElementById('fActivity').textContent = u.trust<50 ? 'Detected' : 'None';
          document.getElementById('fActivity').style.color = u.trust<50 ? 'var(--danger)' : 'var(--success)';
          const fn = document.getElementById('fraudNote');
          fn.className = u.trust<50 ? 'fraud-warn' : 'fraud-ok';
          fn.innerHTML = u.trust<50
            ? '<strong style="color:var(--danger);">⚠️ Suspicious activity detected — review recommended.</strong>'
            : '<strong style="color:#2e7d32;">✅ Trusted user — no suspicious activity.</strong>';

          document.getElementById('editName').value     = u.name;
          document.getElementById('editEmail').value    = u.email;
          document.getElementById('editPhone').value    = u.phone;
          document.getElementById('editLocation').value = u.location;
          document.getElementById('editType').value     = u.type;
          document.getElementById('editStatus').value   = u.status;
          document.getElementById('editTrust').value    = u.trust;
          document.getElementById('editPets').value     = u.pets;

          document.getElementById('warnTarget').value    = u.name;
          document.getElementById('suspendTarget').value = u.name;
        }

        function statusBadge(s){
          const m={active:'badge-success ✅ Active',suspended:'badge-danger 🔒 Suspended',suspicious:'badge-warning ⚠️ Suspicious'};
          const parts=(m[s]||'badge-muted '+s).split(' ');
          const cls=parts.shift(); const lbl=parts.join(' ');
          return `<span class="badge ${cls}">${lbl}</span>`;
        }

        function showTab(id, btn){
          document.querySelectorAll('.tab-pane').forEach(p=>p.classList.remove('active'));
          document.querySelectorAll('.tabs-row .tab-btn').forEach(b=>b.classList.remove('active'));
          document.getElementById('tab-'+id)?.classList.add('active');
          if(btn) btn.classList.add('active');
        }

        function quickAction(type){
          const u = currentUser;
          if(type==='warn')          { openM('warnModal'); }
          else if(type==='suspend')  { openM('suspendModal'); }
          else if(type==='reset')    { toast('Password reset link sent to '+u.email,'success'); }
          else if(type==='restrict') { toast('Reports restricted for 30 days.','warning'); }
          else if(type==='cancelRewards'){ toast('All rewards cancelled.','danger'); }
          else if(type==='delete')   { openM('deleteModal'); }
        }
        function doDelete(){
          closeM('deleteModal');
          toast('User deleted. Redirecting...','danger');
          setTimeout(()=>window.location.href='/SuperAdmin/Users',1800);
        }

        function saveEdit(){
          const u = currentUser;
          u.name     = document.getElementById('editName').value.trim() || u.name;
          u.email    = document.getElementById('editEmail').value.trim() || u.email;
          u.phone    = document.getElementById('editPhone').value.trim() || u.phone;
          u.location = document.getElementById('editLocation').value.trim() || u.location;
          u.type     = document.getElementById('editType').value;
          u.status   = document.getElementById('editStatus').value;
          u.trust    = +document.getElementById('editTrust').value || u.trust;
          u.pets     = +document.getElementById('editPets').value;
          closeM('editUserModal');
          renderProfile();
          toast('User updated successfully.','success');
        }

        function savePet(){
          const name = document.getElementById('petName').value.trim();
          if(!name){ toast('Pet name required.','danger'); return; }
          const icons={Dog:'🐕',Cat:'🐈',Rabbit:'🐇',Bird:'🐦'};
          const type   = document.getElementById('petType').value;
          const status = document.getElementById('petStatus').value;
          const scls   = status==='Lost'?'badge-danger':status==='For Adoption'?'badge-info':'badge-success';
          const row = document.createElement('div');
          row.className='pet-row';
          row.innerHTML=`<div class="row-icon">${icons[type]||'🐾'}</div><div class="row-grow"><div class="row-title">${name}</div><div class="row-sub">${document.getElementById('petBreed').value||'—'} · ${document.getElementById('petAge').value||'—'}</div></div><span style="font-size:.78rem;color:var(--text-muted);font-weight:700;">Vaccine: ${document.getElementById('petVaccine').value||'—'}</span><span class="badge ${scls}">${status}</span><div style="display:flex;gap:5px;"><button class="btn btn-outline btn-xs">Edit</button><button class="btn btn-danger btn-xs" onclick="this.closest('.pet-row').remove()">Delete</button></div>`;
          document.getElementById('petsList').prepend(row);
          closeM('addPetModal');
          toast(name+' added.','success');
        }

        function setMsgType(btn){document.querySelectorAll('.type-toggle-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');}
        function setPriority(btn){document.querySelectorAll('.priority-btn').forEach(b=>b.classList.remove('sel'));btn.classList.add('sel');}
        const TEMPLATES={
          warn_policy:   {title:'⚠️ Policy Violation Warning',     body:'Your account activity has been reviewed and a policy violation was detected. Please review our community guidelines to avoid further action.'},
          warn_suspicious:{title:'⚠️ Suspicious Activity Detected',body:'We have noticed unusual activity on your account. Please verify your recent actions or contact support if you did not perform them.'},
          notif_appt:    {title:'🔔 Upcoming Appointment Reminder', body:'You have a scheduled appointment coming up. Please ensure you are available and confirm your attendance.'},
          notif_found:   {title:'🔔 Pet Match Found!',             body:'A possible match has been found for your lost pet report. Please check the found pet listings and contact the finder.'},
          positive:      {title:'🌟 Thank You for Helping the Community!', body:'Your contributions to the Waffy community have been recognized. You have been awarded a new badge for your efforts!'}
        };
        function applyTemplate(v){const t=TEMPLATES[v];if(t){document.getElementById('msgTitle').value=t.title;document.getElementById('msgBody').value=t.body;}}
        function sendMsg(){
          const title=document.getElementById('msgTitle').value.trim();
          const body=document.getElementById('msgBody').value.trim();
          if(!title||!body){toast('Please fill title and message.','danger');return;}
          const s=document.getElementById('msgStatus');
          s.textContent='✅ Sent!';s.style.color='var(--success)';
          setTimeout(()=>{s.textContent='';document.getElementById('msgTitle').value='';document.getElementById('msgBody').value='';},2500);
          toast('Message sent to '+currentUser.name,'success');
        }
        function previewMsg(){
          const title=document.getElementById('msgTitle').value||'(no title)';
          const body=document.getElementById('msgBody').value||'(no message)';
          alert(`PREVIEW:\n\nTitle: ${title}\n\n${body}`);
        }
        function saveDraft(){
          const s=document.getElementById('msgStatus');s.textContent='💾 Draft saved';s.style.color='var(--text-muted)';setTimeout(()=>s.textContent='',2000);
        }

        function openM(id){const m=document.getElementById(id);if(m)m.classList.add('open');}
        function closeM(id){const m=document.getElementById(id);if(m)m.classList.remove('open');}
        document.querySelectorAll('.modal-overlay').forEach(m=>{m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open');});});

        function toast(msg,type='success'){
          const bg={success:'var(--success-soft)',danger:'var(--danger-soft)',warning:'var(--warning-soft)'};
          const col={success:'var(--success)',danger:'var(--danger)',warning:'#9b6000'};
          const t=document.createElement('div');
          t.style.cssText=`position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
          t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),3000);
        }

        loadUser();
    </script>
</body>
</html>
