                                            {
                                                <div>@r.ReasonNote</div>
                                            }
                                        </td>
                                        <td style="font-weight:900;color:var(--success);">@r.RewardDisplay</td>
                                        <td style="color:var(--text-muted);font-size:.8rem;">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

