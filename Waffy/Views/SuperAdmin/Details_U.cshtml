                            <tbody>
                                @foreach (var r in Model.SurpriseRewards.OrderByDescending(x => x.CreatedAt))
                                {
                                    var typeIcon = r.RewardType switch { "WalletCredit" => "💰", "StoreDiscount" => "🏪", "ClinicSession" => "🏥", "DeliveryVoucher" => "🚚", _ => "🎁" };
