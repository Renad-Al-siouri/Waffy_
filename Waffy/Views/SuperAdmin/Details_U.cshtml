@model Waffy.Models.ViewModels.UserDetailViewModel
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = $"Waffy — Admin | {Model.User.FullName}";
    ViewData["ActiveSection"] = "users";
    ViewData["ActivePage"] = "users";
    ViewData["PageTitle"] = "User Details";
    ViewData["BreadcrumbParent"] = "Management";
    ViewData["BreadcrumbCurrent"] = "Users";
    var u = Model.User;
    var fSearch = Model.ReturnSearch ?? "";
    var fStatus = Model.ReturnStatus ?? "";
    var fRole = Model.ReturnRole ?? "";
    var fPage = Model.ReturnPage;
}

@section PageStyles {
    <style>
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .detail-hero {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            padding: 22px;
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
            flex-wrap: wrap;
        }

        .dh-avatar {
            width: 84px;
            height: 84px;
            border-radius: 22px;
            font-size: 2.2rem;
            background: var(--brand-mid);
            color: #fff;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .dh-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dh-online {
            position: absolute;
            bottom: -4px;
            right: -4px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            border: 3px solid #fff;
            background: var(--success);
        }

        .dh-info {
            flex: 1;
            min-width: 200px;
        }

        .dh-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .dh-meta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 8px;
            font-size: .83rem;
            color: var(--text-muted);
            font-weight: 700;
        }

        .dh-tags {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .dh-tag {
            padding: 5px 12px;
            border-radius: var(--pill);
            background: var(--surface-2);
            border: 1px solid var(--border);
            font-size: .76rem;
            font-weight: 800;
            color: var(--brand-dark);
        }

        .trust-box {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 16px 22px;
            text-align: center;
            min-width: 130px;
            box-shadow: var(--shadow);
            flex-shrink: 0;
        }

        .trust-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 2rem;
            font-weight: 700;
        }

        .trust-label {
            font-size: .75rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 4px;
        }

        .alert-box {
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: #FFF9EE;
            border: 1.5px solid #E8D9A0;
            border-radius: var(--r);
            padding: 14px 18px;
            margin-bottom: 14px;
            box-shadow: var(--shadow);
        }

            .alert-box.show {
                display: flex;
                animation: fadeUp .22s ease;
            }

        .quick-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px 16px;
            margin-bottom: 14px;
            box-shadow: var(--shadow);
        }

        .mini-stats {
            display: grid;
            grid-template-columns: repeat(6,1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .mini-stat {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px;
            text-align: center;
            box-shadow: var(--shadow);
            transition: .18s;
        }

            .mini-stat:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 22px rgba(78,58,39,.1);
            }

        .mini-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.45rem;
            color: var(--brand-dark);
            font-weight: 700;
        }

        .mini-label {
            font-size: .73rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 5px;
        }

        .tabs-row {
            display: flex;
            gap: 5px;
            overflow-x: auto;
            scrollbar-width: none;
            margin-bottom: 14px;
            padding-bottom: 2px;
        }

            .tabs-row::-webkit-scrollbar {
                display: none;
            }

        .inner-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 14px;
        }

        .inner-card-head {
            padding: 13px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .inner-card-title {
            font-family: 'Fredoka',sans-serif;
            font-size: .97rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .inner-card-body {
            padding: 16px 18px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .info-list {
            display: grid;
        }

        .info-line {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(221,209,191,.55);
            font-size: .84rem;
        }

            .info-line:last-child {
                border-bottom: none;
            }

        .info-key {
            color: var(--text-muted);
            font-weight: 700;
        }

        .info-val {
            font-weight: 900;
            color: var(--brand-dark);
            text-align: right;
        }

        .tl-wrap {
            position: relative;
            padding-left: 20px;
        }

            .tl-wrap::before {
                content: "";
                position: absolute;
                left: 7px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: var(--border);
            }

        .tl-row {
            position: relative;
            padding: 10px 0 10px 12px;
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

        .tl-dot {
            position: absolute;
            left: -5px;
            top: 18px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid #fff;
            flex-shrink: 0;
        }

        .compose-field {
            display: grid;
            gap: 6px;
            margin-bottom: 12px;
        }

        .compose-label {
            font-size: .8rem;
            font-weight: 900;
            color: var(--brand-dark);
        }

        .compose-input, .compose-select, .compose-textarea {
            width: 100%;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #FAFAF8;
            color: var(--text);
            font-size: .86rem;
            font-weight: 700;
            font-family: 'Nunito',sans-serif;
            outline: none;
            transition: .18s;
        }

        .compose-input {
            height: 44px;
            padding: 0 14px;
        }

        .compose-select {
            height: 44px;
            padding: 0 14px;
            cursor: pointer;
            -webkit-appearance: none;
            appearance: none;
        }

        .compose-textarea {
            padding: 12px 14px;
            min-height: 120px;
            resize: vertical;
        }

            .compose-input:focus, .compose-select:focus, .compose-textarea:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 3px rgba(151,173,77,.12);
            }

        .flash-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            padding: 14px 20px;
            border-radius: 14px;
            font-weight: 800;
            font-size: .86rem;
            font-family: 'Nunito',sans-serif;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
            animation: fadeUp .25s ease;
            max-width: 320px;
        }

        .flash-success {
            background: var(--success-soft);
            border: 1px solid rgba(76,175,80,.3);
            color: var(--success);
        }

        .flash-danger {
            background: var(--danger-soft);
            border: 1px solid rgba(244,67,54,.3);
            color: var(--danger);
        }

        @@media(max-width:900px) {
            .mini-stats {
                grid-template-columns: repeat(3,1fr);
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:600px) {
            .mini-stats {
                grid-template-columns: repeat(2,1fr);
            }

            .detail-hero {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .dh-meta, .dh-tags {
                justify-content: center;
            }
        }
    </style>
}

<main class="wa-main" id="waMain">

    @if (ViewBag.Success != null)
    {
        <div class="flash-toast flash-success" id="flashMsg">@ViewBag.Success</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="flash-toast flash-danger" id="flashMsg">@ViewBag.Error</div>
    }

    <section class="page-hero">
        <div>
            <h1>User 360° Profile</h1>
            <p>@u.FullName — @u.RoleName · Full view of account, activity, and moderation.</p>
        </div>
        <div class="page-hero-actions">
            <a asp-controller="SuperAdmin" asp-action="Users"
               asp-route-search="@fSearch" asp-route-status="@fStatus"
               asp-route-role="@fRole" asp-route-page="@fPage"
               class="btn btn-outline btn-sm">← Back to Users</a>
        </div>
    </section>

    <div class="page-body">

        @if (u.AccountStatus == "Suspended")
        {
            <div class="alert-box show">
                <div>
                    <div style="font-weight:900;color:#9b6000;">🔒 This account is suspended.</div>
                    <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">User cannot log in. You can reactivate below.</div>
                </div>
                <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" onsubmit="return confirm('Activate this account?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <input type="hidden" name="returnSearch" value="@fSearch" />
                    <input type="hidden" name="returnStatus" value="@fStatus" />
                    <input type="hidden" name="returnRole" value="@fRole" />
                    <input type="hidden" name="returnPage" value="@fPage" />
                    <input type="hidden" name="from" value="details" />
                    <button type="submit" class="btn btn-outline btn-sm">✅ Reactivate</button>
                </form>
            </div>
        }
        @if (u.AccountStatus == "Pending")
        {
            <div class="alert-box show">
                <div>
                    <div style="font-weight:900;color:#9b6000;">⏳ Account pending review.</div>
                    <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">Review documents then approve or reject.</div>
                </div>
                <div style="display:flex;gap:8px;">
                    <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" onsubmit="return confirm('Approve this account?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <input type="hidden" name="returnSearch" value="@fSearch" />
                        <input type="hidden" name="returnStatus" value="@fStatus" />
                        <input type="hidden" name="returnRole" value="@fRole" />
                        <input type="hidden" name="returnPage" value="@fPage" />
                        <input type="hidden" name="from" value="details" />
                        <button type="submit" class="btn btn-warning btn-sm">✅ Approve</button>
                    </form>
                    <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser" onsubmit="return confirm('Reject this account?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <input type="hidden" name="returnSearch" value="@fSearch" />
                        <input type="hidden" name="returnStatus" value="@fStatus" />
                        <input type="hidden" name="returnRole" value="@fRole" />
                        <input type="hidden" name="returnPage" value="@fPage" />
                        <input type="hidden" name="from" value="details" />
                        <button type="submit" class="btn btn-danger btn-sm">🔒 Reject</button>
                    </form>
                </div>
            </div>
        }

        <!-- Detail Hero -->
        <div class="detail-hero">
            <div class="dh-avatar">
                @if (!string.IsNullOrEmpty(u.ProfileImage))
                {
                    <img src="~/uploads/@u.ProfileImage" alt="@u.FullName" />
                }
                else
                {

                    @u.AvatarInitials
                }
                @if (u.AccountStatus == "Active")
                {
                    <div class="dh-online"></div>
                }
            </div>
            <div class="dh-info">
                <div class="dh-name">@u.FullName</div>
                <div class="dh-meta">
                    <span>📧 @u.Email</span>
                    <span>📞 @(u.Phone ?? "—")</span>
                    @if (!string.IsNullOrEmpty(u.City))
                    {
                        <span>📍 @u.City@(!string.IsNullOrEmpty(u.Area) ? $" — {u.Area}" : "")</span>
                    }
                    <span>📅 Joined @u.JoinedLabel</span>
                    <span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span>
                </div>
                <div class="dh-tags">
                    <span class="dh-tag">@u.RoleIcon @u.RoleName</span>
                    @if (!string.IsNullOrEmpty(u.Gender))
                    {
                        <span class="dh-tag">@u.Gender</span>
                    }
                    @if (!string.IsNullOrEmpty(u.Bio))
                    {
                        <span class="dh-tag" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@u.Bio">@u.Bio</span>
                    }
                </div>
            </div>
            <div class="trust-box">
                <div class="trust-val" style="font-size:1.4rem;">#@u.UserId</div>
                <div class="trust-label">User ID</div>
                <div style="margin-top:10px;font-size:.72rem;color:var(--text-muted);font-weight:800;">Since</div>
                <div style="font-weight:800;font-size:.85rem;color:var(--brand-dark);">@u.JoinedLabel</div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions">
            @if (u.AccountStatus == "Active")
            {
                <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser" style="display:inline;" onsubmit="return confirm('Suspend this user?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <input type="hidden" name="returnSearch" value="@fSearch" />
                    <input type="hidden" name="returnStatus" value="@fStatus" />
                    <input type="hidden" name="returnRole" value="@fRole" />
                    <input type="hidden" name="returnPage" value="@fPage" />
                    <input type="hidden" name="from" value="details" />
                    <button type="submit" class="btn btn-danger btn-sm">🔒 Suspend</button>
                </form>
            }
            else
            {
                <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" style="display:inline;" onsubmit="return confirm('Activate this user?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@u.UserId" />
                    <input type="hidden" name="returnSearch" value="@fSearch" />
                    <input type="hidden" name="returnStatus" value="@fStatus" />
                    <input type="hidden" name="returnRole" value="@fRole" />
                    <input type="hidden" name="returnPage" value="@fPage" />
                    <input type="hidden" name="from" value="details" />
                    <button type="submit" class="btn btn-primary btn-sm">✅ Activate</button>
                </form>
            }
            <button class="btn btn-warning btn-sm" onclick="openM('warnModal')">⚠️ Warning</button>
            <form method="post" asp-controller="SuperAdmin" asp-action="DeleteUser" style="display:inline;" onsubmit="return confirm('Delete this user permanently?\nThis cannot be undone.')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@u.UserId" />
                <input type="hidden" name="returnSearch" value="@fSearch" />
                <input type="hidden" name="returnStatus" value="@fStatus" />
                <input type="hidden" name="returnRole" value="@fRole" />
                <input type="hidden" name="returnPage" value="@fPage" />
                <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
            </form>
            <a asp-controller="SuperAdmin" asp-action="GiveRewardModal" asp-route-userId="@u.UserId"
               class="btn btn-outline btn-sm"
               style="background:var(--warning-soft);border-color:rgba(226,163,58,.4);color:#9b6000;">
                🎁 Give Reward
            </a>
        </div>

        <!-- Mini Stats -->
        <div class="mini-stats">
            <div class="mini-stat"><div class="mini-val">@Model.PetsCount</div><div class="mini-label">🐾 Pets</div></div>
            <div class="mini-stat"><div class="mini-val">@Model.AppointmentsCount</div><div class="mini-label">📅 Appointments</div></div>
<div class="mini-stat"><div class="mini-val">@Model.OrdersCount</div><div class="mini-label">🛍️ Orders</div></div>
            <div class="mini-stat"><div class="mini-val">@Model.LostReportsCount</div><div class="mini-label">🔍 Lost Reports</div></div>
            <div class="mini-stat"><div class="mini-val">@Model.CouponsCount</div><div class="mini-label">🎟️ Rewards</div></div>
            <div class="mini-stat"><div class="mini-val">@Model.AdoptionCount</div><div class="mini-label">🏠 Adoptions</div></div>
        </div>

        <!-- Tabs Row -->
        <div class="tabs-row">
            <button class="tab-btn active" onclick="showTab('info',this)">👤 Info</button>
            <button class="tab-btn" onclick="showTab('pets',this)">🐾 Pets</button>
            <button class="tab-btn" onclick="showTab('lost',this)">🔍 Lost</button>
            <button class="tab-btn" onclick="showTab('adoption',this)">🏠 Adoption</button>
            <button class="tab-btn" onclick="showTab('rewards',this)">🎟️ Rewards</button>
            <button class="tab-btn" onclick="showTab('orders',this)">🛍️ Orders</button>
            <button class="tab-btn" onclick="showTab('appointments',this)">📅 Appointments</button>
            <button class="tab-btn" onclick="showTab('timeline',this)">⏱️ Timeline</button>
            <button class="tab-btn" onclick="showTab('complaints',this)">🚨 Complaints</button>
            
            <button class="tab-btn" onclick="showTab('contact',this)">✉️ Contact</button>
        </div>

        <!-- TAB: INFO -->
        <div class="tab-pane active" id="tab-info">
            <div class="grid-2">
                <div class="inner-card">
                    <div class="inner-card-head">
                        <div class="inner-card-title">👤 Account Information</div>
                        <span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span>
                    </div>
                    <div class="inner-card-body">
                        <div class="info-list">
                            <div class="info-line"><span class="info-key">User ID</span><span class="info-val">#@u.UserId</span></div>
                            <div class="info-line"><span class="info-key">Full Name</span><span class="info-val">@u.FullName</span></div>
                            <div class="info-line"><span class="info-key">Email</span><span class="info-val">@u.Email</span></div>
                            <div class="info-line"><span class="info-key">Phone</span><span class="info-val">@(u.Phone ?? "—")</span></div>
                            <div class="info-line"><span class="info-key">Gender</span><span class="info-val">@(u.Gender ?? "—")</span></div>
                            <div class="info-line"><span class="info-key">Role</span><span class="info-val"><span class="badge @u.RoleBadgeClass">@u.RoleIcon @u.RoleName</span></span></div>
                            <div class="info-line"><span class="info-key">Status</span><span class="info-val"><span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span></span></div>
                            <div class="info-line"><span class="info-key">Joined</span><span class="info-val">@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</span></div>
                            <div class="info-line"><span class="info-key">Last Active</span><span class="info-val">@u.LastActiveLabel</span></div>
                            <div class="info-line">
                                <span class="info-key">Warnings</span>
                                <span class="info-val">
                                    @if (u.WarningCount == 0)
                                    {
                                        <span style="color:var(--success);font-weight:900;">✅ None</span>
                                    }
                                    else
                                    {

                                        <span style="color:var(--danger);font-weight:900;">⚠️ @u.WarningCount warning@(u.WarningCount > 1 ? "s" : "")</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="inner-card">
                    <div class="inner-card-head"><div class="inner-card-title">📍 Location &amp; Bio</div></div>
                    <div class="inner-card-body">
                        <div class="info-list">
                            <div class="info-line"><span class="info-key">City</span><span class="info-val">@(u.City ?? "—")</span></div>
                            <div class="info-line"><span class="info-key">Area</span><span class="info-val">@(u.Area ?? "—")</span></div>
                            <div class="info-line"><span class="info-key">Bio</span><span class="info-val" style="max-width:200px;white-space:normal;">@(string.IsNullOrEmpty(u.Bio) ? "—" : u.Bio)</span></div>
                            <div class="info-line">
                                <span class="info-key">Profile Image</span>
                                <span class="info-val">
                                    @if (!string.IsNullOrEmpty(u.ProfileImage))
                                    {
                                        <span style="color:var(--success);">✅ Uploaded</span>
                                    }
                                    else
                                    {

                                        <span style="color:var(--text-muted);">None</span>
                                    }
                                </span>
                            </div>
                            @if (u.AccountStatus == "Suspended" && !string.IsNullOrEmpty(u.SuspensionReason))
                            {
                                <div class="info-line">
                                    <span class="info-key">Suspension Reason</span>
                                    <span class="info-val" style="color:var(--danger);max-width:200px;white-space:normal;">@u.SuspensionReason</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB: PETS -->
        <div class="tab-pane" id="tab-pets">
            <div class="inner-card">
                <div class="inner-card-head"><div class="inner-card-title">🐾 Pets (@Model.PetsCount)</div></div>
                @if (!Model.Pets.Any())
                {
                    <div style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">🐾 No pets registered yet.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Pet</th><th>Species</th><th>Breed</th><th>Gender</th><th>Age</th><th>Vaccination</th><th>Added</th></tr></thead>
                            <tbody>
                                @foreach (var pet in Model.Pets)
                                {
                                    var ageText = pet.BirthDate.HasValue ? $"{(int)((DateTime.Today - pet.BirthDate.Value).TotalDays / 30)} mo" : "—";
