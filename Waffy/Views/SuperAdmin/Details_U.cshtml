                                        <td>@(pet.Species ?? "—")</td>
                                        <td>@(pet.Breed ?? "—")</td>
                                        <td>@(pet.Gender ?? "—")</td>
                                        <td>@ageText</td>
                                        <td><span class="badge @vaccBadge.Item1">@vaccBadge.Item2</span></td>
                                        <td style="color:var(--text-muted);font-size:.8rem;">@pet.CreatedAt.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
