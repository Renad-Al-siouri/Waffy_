                                <div style="font-size:.75rem;color:var(--text-muted);font-weight:800;">JOD Balance</div>
                            </div>
                            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                                <span class="badge @(Model.Wallet.Status == "Active" ? "badge-success" : "badge-danger")">@(Model.Wallet.Status == "Active" ? "✅ Active" : "🔒 Inactive")</span>
