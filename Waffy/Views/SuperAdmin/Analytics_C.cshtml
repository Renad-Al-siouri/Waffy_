@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | Clinic Analytics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo"><div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div><div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div></div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat"><a class="sb-row" href="@Url.Action("Dashboard", "SuperAdmin")" data-tip="Dashboard"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span><span class="sb-lbl">Dashboard</span></a></div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div><button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span><span class="sb-lbl">Users</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-users"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Users", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a></div></div></div>
                    <div>
                        <button class="sb-row open active" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span><span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button>
                        <div class="sb-sub open" id="g-clinics" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child" href="@Url.Action("Clinics", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" href="@Url.Action("Reviews_Complaints_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews & Complaints</span><span class="sb-bdg bd-r sb-child-bdg">5</span></a>
                                <a class="sb-child active" href="@Url.Action("Analytics_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" data-tip="Shop" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-shop">
                            <div class="sb-sub-inner">
                                <a class="sb-child" href="@Url.Action("Stores", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span><span class="sb-bdg bd-y sb-child-bdg">3</span></a>
                                <a class="sb-child" href="@Url.Action("Reviews_Complaints_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews & Complaints</span><span class="sb-bdg bd-r sb-child-bdg">6</span></a>
                                <a class="sb-child" href="@Url.Action("Analytics_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" data-tip="Adoption" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span><span class="sb-bdg bd-y">5</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" href="@Url.Action("Listings", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span><span class="sb-bdg bd-y sb-child-bdg">5</span></a>
                                <a class="sb-child" href="@Url.Action("Flagged", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a>
                                <a class="sb-child" href="@Url.Action("Adopted_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" href="@Url.Action("Analytics_A", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" data-tip="Reports" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span><span class="sb-bdg bd-y">8</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" href="@Url.Action("Lost_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" href="@Url.Action("Found_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" href="@Url.Action("Dangerous_Animals", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child" href="@Url.Action("Donations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints">
                                    <span class="sb-dot"></span>
                                    <span class="sb-child-lbl">System Complaints</span>
                                </a>
                                <a class="sb-child" href="@Url.Action("Laws_Regulations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Laws & Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" href="@Url.Action("Map", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" href="@Url.Action("Notifications", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot"><div class="sb-user-row"><div class="sb-av">DC</div><div class="sb-user-info"><div class="sb-user-name">Daniel Carter</div><div class="sb-user-role">Operations Director</div></div></div><button class="sb-logout" onclick="alert('Sign out')" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></button></div>
        </aside>

        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Clinics</span><span>/</span><b>Analytics</b></nav>
            <div class="tn-center"><div class="tn-center-main">Clinic Analytics</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" href="@Url.Action("Notifications", "SuperAdmin")"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="tn-count">12</span></a>
                <div class="tn-sep"></div>
                <div class="tn-profile" onclick="alert('Profile')"><div class="tn-av">DC</div><div><div class="tn-pname">Daniel Carter</div><div class="tn-prole">Operations Director</div></div></div>
            </div>
        </header>

        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div>
                    <h1>Clinic Analytics</h1>
                    <p>Platform-wide clinic performance — appointments, revenue, doctors, no-show rates, and growth trends.</p>
                </div>
                <div class="page-hero-actions">
                    <select class="sel-wrap" style="height:40px;width:auto;min-width:150px;font-size:.82rem;" id="periodFilter" onchange="updatePeriod(this.value)">
                        <option value="month">This Month</option>
                        <option value="quarter">Last 3 Months</option>
                        <option value="year">This Year</option>
                    </select>
                    <button class="btn btn-outline btn-sm" onclick="exportReport()">📥 Export</button>
                </div>
            </section>

            <div class="page-body">
                <!-- Revenue Banner -->
                <div style="background:linear-gradient(135deg,#f0f7e2,#e4f0cc);border:1px solid rgba(139,169,74,.25);border-radius:var(--r-xl);padding:22px;margin-bottom:18px;position:relative;overflow:hidden;box-shadow:var(--shadow);">
                    <div style="position:absolute;width:200px;height:200px;border-radius:50%;background:rgba(139,169,74,.07);top:-80px;right:-60px;pointer-events:none;"></div>
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;">
                        <div>
                            <div style="font-size:.72rem;color:var(--text-muted);font-weight:900;letter-spacing:.7px;text-transform:uppercase;margin-bottom:6px;">Platform Clinic Revenue</div>
                            <div style="font-family:'Fredoka',sans-serif;font-size:2.2rem;font-weight:700;color:var(--brand-dark);" id="totalRevenue">12,840 JD</div>
                            <div style="font-size:.84rem;color:var(--text-muted);margin-top:6px;" id="revenueBreakdown">Commission: 1,284 JD (10%) · Net to Clinics: 11,556 JD</div>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                            <span class="badge badge-success" style="padding:12px 16px;justify-content:center;font-size:.78rem;">32 Active Clinics</span>
                            <span class="badge badge-info" style="padding:12px 16px;justify-content:center;font-size:.78rem;">94 Doctors</span>
                            <span class="badge badge-warning" style="padding:12px 16px;justify-content:center;font-size:.78rem;">+6% Growth</span>
                            <span class="badge badge-purple" style="padding:12px 16px;justify-content:center;font-size:.78rem;">14,820 Appts/Mo</span>
                        </div>
                    </div>
                </div>

                <!-- KPIs -->
                <div class="kpi-grid kpi-grid-4">
                    <div class="kpi-card c1"><div class="kpi-ico green">📅</div><div class="kpi-val">14,820</div><div class="kpi-label">Appointments / Month</div><div class="kpi-chip chip-green">+6% vs last month</div></div>
                    <div class="kpi-card c4"><div class="kpi-ico red">❌</div><div class="kpi-val">11%</div><div class="kpi-label">Avg. No-Show Rate</div><div class="kpi-chip chip-red">Target: &lt;10%</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">⭐</div><div class="kpi-val">4.6</div><div class="kpi-label">Avg. Rating</div><div class="kpi-chip chip-yellow">Out of 5.0</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">👨‍⚕️</div><div class="kpi-val">94</div><div class="kpi-label">Active Doctors</div><div class="kpi-chip chip-blue">+4 this month</div></div>
                </div>

                <!-- Charts Row 1 -->
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px;">
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">📈 Monthly Appointments Trend</div></div>
                        <div style="padding:16px;height:260px;"><canvas id="apptsChart"></canvas></div>
                    </div>
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">🏥 Clinic Status</div></div>
                        <div style="padding:16px;height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                            <canvas id="statusChart" style="max-height:180px;"></canvas>
                            <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap;justify-content:center;font-size:.73rem;font-weight:800;">
                                <span style="color:#8ba94a;">● Active (32)</span>
                                <span style="color:#e2a33a;">● Pending (4)</span>
                                <span style="color:#d9534f;">● Suspended (2)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row 2 -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">💰 Monthly Revenue</div></div>
                        <div style="padding:16px;height:220px;"><canvas id="revenueChart"></canvas></div>
                    </div>
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">📊 No-Show Rate Trend</div></div>
                        <div style="padding:16px;height:220px;"><canvas id="noShowChart"></canvas></div>
                    </div>
                </div>

                <!-- Top Clinics Table -->
                <div class="table-card" style="margin-bottom:14px;">
                    <div class="table-head-bar">
                        <div class="table-head-title">🏆 Top Clinics Ranking</div>
                        <select class="sel-wrap" style="height:36px;width:auto;min-width:160px;font-size:.78rem;" onchange="sortTopClinics(this.value)">
                            <option value="appts">Most Appointments</option>
                            <option value="revenue">Highest Revenue</option>
                            <option value="rating">Highest Rating</option>
                            <option value="noshow">Lowest No-Show</option>
                        </select>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>#</th><th>Clinic</th><th>City</th><th>Doctors</th><th>Appts/Mo</th><th>Revenue</th><th>Rating</th><th>No-Show</th><th>Performance</th></tr></thead>
                            <tbody id="topClinicsTBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Bottom Row -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <!-- Top Doctors -->
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">👨‍⚕️ Top Doctors</div></div>
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>#</th><th>Doctor</th><th>Specialty</th><th>Appts</th><th>Rating</th></tr></thead>
                                <tbody id="topDoctorsTBody"></tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Quick Stats -->
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">📊 Quick Stats</div></div>
                        <div style="padding:16px;" id="quickStatsList"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        /* ═══ DATA ═══ */
        const clinicsData=[
          {id:1,name:"Al Rahma Hospital",city:"Amman",doctors:8,appts:1240,revenue:1240,rating:4.8,noShow:6,status:"active"},
          {id:2,name:"Al Amanah Clinic",city:"Amman",doctors:5,appts:638,revenue:510,rating:4.9,noShow:8,status:"active"},
          {id:3,name:"Al Noor Clinic",city:"Amman",doctors:3,appts:420,revenue:336,rating:4.6,noShow:10,status:"active"},
          {id:4,name:"Happy Paws Clinic",city:"Irbid",doctors:2,appts:210,revenue:168,rating:4.3,noShow:14,status:"active"},
          {id:5,name:"Sunrise Animal Clinic",city:"Zarqa",doctors:2,appts:180,revenue:144,rating:4.1,noShow:18,status:"active"},
          {id:6,name:"Al Ferdous Clinic",city:"Irbid",doctors:2,appts:98,revenue:15,rating:3.2,noShow:34,status:"suspended"},
        ];

        const topDoctors=[
          {rank:1,name:"Dr. Ahmad Al-Zoubi",spec:"Vet Surgery",appts:142,rating:4.9},
          {rank:2,name:"Dr. Sarah Al-Hussein",spec:"Dermatology",appts:118,rating:4.7},
          {rank:3,name:"Dr. Mahmoud Al-Najjar",spec:"Vet Surgery",appts:104,rating:4.6},
          {rank:4,name:"Dr. Raneem Al-Obeid",spec:"Surgery",appts:96,rating:4.8},
          {rank:5,name:"Dr. Lina Al-Shami",spec:"Internal Med.",appts:88,rating:4.5},
        ];

        let sortKey='appts';
        const ch={};
        const C={brand:'#8ba94a',dark:'#5f7430',danger:'#d9534f',warn:'#e2a33a',info:'#3A86FF',purple:'#8F79C6'};

        /* ═══ CHARTS ═══ */
        function initCharts(){
          Chart.defaults.font.family="'Nunito',sans-serif";
          Chart.defaults.font.weight='700';
          Chart.defaults.color='#7d6d5f';
          const mk=(id,cfg)=>{const el=document.getElementById(id);if(!el)return;if(ch[id])ch[id].destroy();ch[id]=new Chart(el,cfg);};

          mk('apptsChart',{type:'line',data:{labels:['Oct','Nov','Dec','Jan','Feb','Mar'],datasets:[{label:'Appointments',data:[10200,11400,10800,12600,13800,14820],borderColor:C.brand,backgroundColor:C.brand+'22',tension:.4,fill:true,pointRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:false,ticks:{callback:v=>v.toLocaleString()}}}}});

          mk('statusChart',{type:'doughnut',data:{labels:['Active','Pending','Suspended'],datasets:[{data:[32,4,2],backgroundColor:[C.brand,C.warn,C.danger],borderWidth:2,borderColor:'#fff'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},cutout:'65%'}});

          mk('revenueChart',{type:'bar',data:{labels:['Oct','Nov','Dec','Jan','Feb','Mar'],datasets:[{label:'Revenue (JD)',data:[9800,10600,10200,11400,12100,12840],backgroundColor:C.brand+'cc',borderRadius:8}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,ticks:{callback:v=>v.toLocaleString()+' JD'}}}}});

          mk('noShowChart',{type:'line',data:{labels:['Oct','Nov','Dec','Jan','Feb','Mar'],datasets:[{label:'No-Show %',data:[14,13,12,12,11,11],borderColor:C.danger,backgroundColor:C.danger+'22',tension:.4,fill:true,pointRadius:4},{label:'Target',data:[10,10,10,10,10,10],borderColor:C.brand,borderDash:[5,5],tension:0,pointRadius:0,fill:false}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:12,padding:12}}},scales:{y:{beginAtZero:true,ticks:{callback:v=>v+'%'}}}}});
        }

        /* ═══ TOP CLINICS ═══ */
        function renderTopClinics(){
          const sorted=[...clinicsData].sort((a,b)=>{
            if(sortKey==='revenue') return b.revenue-a.revenue;
            if(sortKey==='rating')  return b.rating-a.rating;
            if(sortKey==='noshow')  return a.noShow-b.noShow;
            return b.appts-a.appts;
          });
          const perfBadge=(c)=>{if(c.noShow<=8&&c.rating>=4.5)return`<span class="badge badge-success">🏆 Excellent</span>`;if(c.noShow<=15&&c.rating>=4.0)return`<span class="badge badge-info">👍 Good</span>`;if(c.noShow>25||c.rating<3.5)return`<span class="badge badge-danger">⚠️ Weak</span>`;return`<span class="badge badge-warning">📊 Average</span>`;};
          document.getElementById('topClinicsTBody').innerHTML=sorted.map((c,i)=>`
            <tr>
              <td><div style="width:28px;height:28px;border-radius:8px;background:${i<3?'linear-gradient(135deg,'+C.brand+','+C.dark+')':'var(--surface-2)'};color:${i<3?'#fff':'var(--text-muted)'};display:grid;place-items:center;font-weight:900;font-size:.82rem;">${i===0?'🥇':i===1?'🥈':i===2?'🥉':i+1}</div></td>
              <td><div class="cell-title">🏥 ${c.name}</div></td>
              <td style="color:var(--text-muted);">📍 ${c.city}</td>
              <td>👨‍⚕️ ${c.doctors}</td>
              <td><strong>${c.appts.toLocaleString()}</strong></td>
              <td><strong style="color:var(--success);">${c.revenue.toLocaleString()} JD</strong></td>
              <td>⭐ ${c.rating.toFixed(1)}</td>
              <td style="color:${c.noShow>20?'var(--danger)':c.noShow>12?'#9b6000':'var(--success)'};">${c.noShow}%</td>
              <td>${perfBadge(c)}</td>
            </tr>`).join('');
        }

        /* ═══ TOP DOCTORS ═══ */
        function renderTopDoctors(){
          document.getElementById('topDoctorsTBody').innerHTML=topDoctors.map(d=>`
            <tr>
              <td><span style="font-weight:900;color:var(--brand-dark);">${d.rank===1?'🥇':d.rank===2?'🥈':d.rank===3?'🥉':'#'+d.rank}</span></td>
              <td><div class="cell-title">${d.name}</div></td>
              <td><span class="badge badge-info" style="font-size:.7rem;">${d.spec}</span></td>
              <td><strong>${d.appts}</strong></td>
              <td>⭐ ${d.rating}</td>
            </tr>`).join('');
        }

        /* ═══ QUICK STATS ═══ */
        function renderQuickStats(){
          const stats=[
            {l:'Best Clinic Rating',v:'Al Amanah Clinic — 4.9 ⭐',c:'var(--success)'},
            {l:'Most Appointments',v:'Al Rahma Hospital — 1,240/mo',c:'var(--success)'},
            {l:'Highest Revenue',v:'Al Rahma Hospital — 1,240 JD',c:'var(--brand-dark)'},
            {l:'Best Doctor',v:'Dr. Ahmad Al-Zoubi — 4.9 ⭐',c:'var(--brand-dark)'},
            {l:'Highest No-Show',v:'Al Ferdous Clinic — 34%',c:'var(--danger)'},
            {l:'Total Doctors',v:'94 active doctors',c:C.info},
            {l:'Pending Approvals',v:'4 clinics awaiting review',c:C.warn},
            {l:'Open Complaints',v:'3 active cases',c:'var(--danger)'},
          ];
          document.getElementById('quickStatsList').innerHTML=stats.map(s=>`<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid rgba(221,209,191,.5);"><span style="font-size:.8rem;font-weight:700;color:var(--text-muted);">${s.l}</span><strong style="font-size:.82rem;color:${s.c};">${s.v}</strong></div>`).join('');
        }

        /* ═══ PERIOD UPDATE ═══ */
        function updatePeriod(v){
          const d={month:{r:'12,840 JD',b:'Commission: 1,284 JD (10%) · Net to Clinics: 11,556 JD'},quarter:{r:'36,200 JD',b:'Commission: 3,620 JD (10%) · Net to Clinics: 32,580 JD'},year:{r:'142,800 JD',b:'Commission: 14,280 JD (10%) · Net to Clinics: 128,520 JD'}};
          document.getElementById('totalRevenue').textContent=d[v].r;
          document.getElementById('revenueBreakdown').textContent=d[v].b;
        }

        function sortTopClinics(k){sortKey=k;renderTopClinics();}
        function exportReport(){const t=document.createElement('div');t.style.cssText='position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:var(--success-soft);border:1px solid rgba(47,158,95,.3);color:var(--success);font-weight:800;font-size:.86rem;font-family:Nunito,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);';t.textContent='✅ Report exported.';document.body.appendChild(t);setTimeout(()=>t.remove(),3000);}

        function openM(id){const m=document.getElementById(id);if(m)m.classList.add('open');}
        function closeM(id){const m=document.getElementById(id);if(m)m.classList.remove('open');}

        const ts=document.createElement('style');ts.textContent=`@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}`;document.head.appendChild(ts);

        document.addEventListener('DOMContentLoaded',()=>{
          initCharts();
          renderTopClinics();
          renderTopDoctors();
          renderQuickStats();
        });
    </script>
</body>
</html>
