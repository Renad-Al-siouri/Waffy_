@model Waffy.Models.ViewModels.UserDetailViewModel
@{
    ViewData["Title"] = $"Waffy — Admin | {Model.User.FullName}";
    Layout = null;
    var u = Model.User;
    var adminName = ViewBag.AdminName as string ?? "Admin";
    var adminInitials = ViewBag.AdminInitials as string ?? "AD";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        /* ── كل الـ styles من الـ View الأصلي محفوظة ── */
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .detail-hero {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            padding: 22px;
            margin-bottom: 16px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
            flex-wrap: wrap;
        }

        .dh-avatar {
            width: 84px;
            height: 84px;
            border-radius: 22px;
            font-size: 2.2rem;
            background: var(--surface-2);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .dh-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dh-online {
            position: absolute;
            bottom: -4px;
            right: -4px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            border: 3px solid #fff;
            background: var(--success);
        }

        .dh-info {
            flex: 1;
            min-width: 200px;
        }

        .dh-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .dh-meta {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-top: 8px;
            font-size: .83rem;
            color: var(--text-muted);
            font-weight: 700;
        }

        .dh-tags {
            display: flex;
            gap: 7px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .dh-tag {
            padding: 5px 12px;
            border-radius: var(--pill);
            background: var(--surface-2);
            border: 1px solid var(--border);
            font-size: .76rem;
            font-weight: 800;
            color: var(--brand-dark);
        }

        .trust-box {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 16px 22px;
            text-align: center;
            min-width: 130px;
            box-shadow: var(--shadow);
            flex-shrink: 0;
        }

        .trust-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 2rem;
            font-weight: 700;
        }

        .trust-label {
            font-size: .75rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 4px;
        }

        .alert-box {
            display: none;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            background: #FFF9EE;
            border: 1.5px solid #E8D9A0;
            border-radius: var(--r);
            padding: 14px 18px;
            margin-bottom: 14px;
        }

            .alert-box.show {
                display: flex;
                animation: fadeUp .22s ease;
            }

        .quick-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px 16px;
            margin-bottom: 14px;
            box-shadow: var(--shadow);
        }

        .mini-stats {
            display: grid;
            grid-template-columns: repeat(6,1fr);
            gap: 10px;
            margin-bottom: 16px;
        }

        .mini-stat {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px;
            text-align: center;
            box-shadow: var(--shadow);
        }

        .mini-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.45rem;
            color: var(--brand-dark);
            font-weight: 700;
        }

        .mini-label {
            font-size: .73rem;
            color: var(--text-muted);
            font-weight: 800;
            margin-top: 5px;
        }

        .tabs-row {
            display: flex;
            gap: 5px;
            overflow-x: auto;
            scrollbar-width: none;
            margin-bottom: 14px;
            padding-bottom: 2px;
        }

            .tabs-row::-webkit-scrollbar {
                display: none;
            }

        .inner-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 14px;
        }

        .inner-card-head {
            padding: 13px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .inner-card-title {
            font-family: 'Fredoka',sans-serif;
            font-size: .97rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .inner-card-body {
            padding: 16px 18px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .info-list {
            display: grid;
        }

        .info-line {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(221,209,191,.55);
            font-size: .84rem;
        }

            .info-line:last-child {
                border-bottom: none;
            }

        .info-key {
            color: var(--text-muted);
            font-weight: 700;
        }

        .info-val {
            font-weight: 900;
            color: var(--brand-dark);
            text-align: right;
        }

        .flash-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            padding: 14px 20px;
            border-radius: 14px;
            font-weight: 800;
            font-size: .86rem;
            font-family: 'Nunito',sans-serif;
            box-shadow: 0 8px 24px rgba(0,0,0,.12);
            max-width: 320px;
            animation: fadeUp .25s ease;
        }

        .flash-success {
            background: var(--success-soft);
            border: 1px solid rgba(76,175,80,.3);
            color: var(--success);
        }

        .flash-danger {
            background: var(--danger-soft);
            border: 1px solid rgba(244,67,54,.3);
            color: var(--danger);
        }

        @@media(max-width:900px) {
            .mini-stats {
                grid-template-columns: repeat(3,1fr);
            }

            .grid-2 {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:600px) {
            .mini-stats {
                grid-template-columns: repeat(2,1fr);
            }

            .detail-hero {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .dh-meta {
                justify-content: center;
            }

            .dh-tags {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR (نفس Users.cshtml بالضبط) ═══════════════════ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row open active" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-users" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Users">
                                    <span class="sb-dot"></span><span class="sb-child-lbl">All Users</span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span>
                        <span class="sb-lbl">Notifications</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@adminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@adminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- ══ TOPNAV ════════════════════════════════════════════════ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <nav class="tn-bread">
                <span>Management</span><span>/</span>
                <a asp-controller="SuperAdmin" asp-action="Users"
                   asp-route-search="@Model.ReturnSearch"
                   asp-route-status="@Model.ReturnStatus"
                   asp-route-role="@Model.ReturnRole"
                   asp-route-page="@Model.ReturnPage"
                   style="color:var(--text-muted);font-weight:800;">Users</a>
                <span>/</span><b>@u.FullName</b>
            </nav>
            <div class="tn-center">
                <div class="tn-center-main">@u.FullName</div>
                <div class="tn-center-sub">360° Profile View</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-profile">
                    <div class="tn-av">@adminInitials</div>
                    <div>
                        <div class="tn-pname">@adminName</div>
                        <div class="tn-prole">Super Admin</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- ══ MAIN ══════════════════════════════════════════════════ -->
        <main class="wa-main" id="waMain">

            @* Flash *@
            @if (ViewBag.Success != null)
            {
                <div class="flash-toast flash-success" id="flashMsg">@ViewBag.Success</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="flash-toast flash-danger" id="flashMsg">@ViewBag.Error</div>
            }

            <section class="page-hero">
                <div>
                    <h1>User 360° Profile</h1>
                    <p>@u.FullName — @u.RoleName · @u.AccountStatus</p>
                </div>
                <div class="page-hero-actions">
                    <a asp-controller="SuperAdmin" asp-action="Users"
                       asp-route-search="@Model.ReturnSearch"
                       asp-route-status="@Model.ReturnStatus"
                       asp-route-role="@Model.ReturnRole"
                       asp-route-page="@Model.ReturnPage"
                       class="btn btn-outline btn-sm">← Back to Users</a>
                </div>
            </section>

            <div class="page-body">

                @* Suspended Alert *@
                @if (u.AccountStatus == "Suspended")
                {
                    <div class="alert-box show">
                        <div>
                            <div style="font-weight:900;color:#9b6000;">🔒 This account is currently suspended.</div>
                            <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">
                                The user cannot log in. You can reactivate it below.
                            </div>
                        </div>
                        <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                            <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                            <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                            <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-outline btn-sm"
                                    onclick="return confirm('Activate this account?')">
                                ✅ Reactivate
                            </button>
                        </form>
                    </div>
                }

                @* Pending Alert *@
                @if (u.AccountStatus == "Pending")
                {
                    <div class="alert-box show">
                        <div>
                            <div style="font-weight:900;color:#9b6000;">⏳ Account pending review.</div>
                            <div style="font-size:.8rem;color:#8b7751;font-weight:700;margin-top:2px;">
                                Review the user's documents and activate or reject their account.
                            </div>
                        </div>
                        <div style="display:flex;gap:8px;">
                            <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                                <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                                <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                                <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                                <input type="hidden" name="from" value="details" />
                                <button type="submit" class="btn btn-primary btn-sm"
                                        onclick="return confirm('Activate this account?')">
                                    ✅ Approve
                                </button>
                            </form>
                            <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.UserId" />
                                <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                                <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                                <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                                <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                                <input type="hidden" name="from" value="details" />
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Reject and suspend this account?')">
                                    🔒 Reject
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <!-- ── Detail Hero ────────────────────────────────── -->
                <div class="detail-hero">
                    <div class="dh-avatar">
                        @if (!string.IsNullOrEmpty(u.ProfileImage))
                        {
                            <img src="~/uploads/@u.ProfileImage" alt="@u.FullName" />
                        }
                        else
                        {
                            @u.AvatarInitials
                        }
                        @if (u.AccountStatus == "Active")
                        {
                            <div class="dh-online"></div>
                        }
                    </div>
                    <div class="dh-info">
                        <div class="dh-name">@u.FullName</div>
                        <div class="dh-meta">
                            <span>📧 @u.Email</span>
                            <span>📞 @u.Phone</span>
                            @if (!string.IsNullOrEmpty(u.City))
                            {
                                <span>📍 @u.City@(!string.IsNullOrEmpty(u.Area) ? $" — {u.Area}" : "")</span>
                            }
                            <span>📅 Joined @u.JoinedLabel</span>
                            <span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span>
                        </div>
                        <div class="dh-tags">
                            <span class="dh-tag">@u.RoleIcon @u.RoleName</span>
                            @if (!string.IsNullOrEmpty(u.Gender))
                            {
                                <span class="dh-tag">@u.Gender</span>
                            }
                            @if (!string.IsNullOrEmpty(u.Bio))
                            {
                                <span class="dh-tag" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                    @u.Bio
                                </span>
                            }
                        </div>
                    </div>
                    <div class="trust-box">
                        <div class="trust-val">ID</div>
                        <div style="font-family:'Fredoka',sans-serif;font-size:1.4rem;font-weight:700;color:var(--brand-dark);">
                            #@u.UserId
                        </div>
                        <div class="trust-label">User ID</div>
                    </div>
                </div>

                <!-- ── Quick Actions (POST forms) ─────────────────── -->
                <div class="quick-actions">
                    @if (u.AccountStatus == "Active")
                    {
                        <form method="post" asp-controller="SuperAdmin" asp-action="SuspendUser" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                            <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                            <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                            <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Suspend @u.FullName.Replace("'", "\\'")?')">
                                🔒 Suspend
                            </button>
                        </form>
                    }
                    else if (u.AccountStatus is "Suspended" or "Pending")
                    {
                        <form method="post" asp-controller="SuperAdmin" asp-action="ActivateUser" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.UserId" />
                            <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                            <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                            <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                            <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                            <input type="hidden" name="from" value="details" />
                            <button type="submit" class="btn btn-primary btn-sm"
                                    onclick="return confirm('Activate @u.FullName.Replace("'", "\\'")?')">
                                ✅ Activate
                            </button>
                        </form>
                    }

                    <form method="post" asp-controller="SuperAdmin" asp-action="DeleteUser" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@u.UserId" />
                        <input type="hidden" name="returnSearch" value="@Model.ReturnSearch" />
                        <input type="hidden" name="returnStatus" value="@Model.ReturnStatus" />
                        <input type="hidden" name="returnRole" value="@Model.ReturnRole" />
                        <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete @u.FullName.Replace("'", "\\'")\npermanently? This cannot be undone.')">
                            🗑️ Delete User
                        </button>
                    </form>

                    <a asp-controller="SuperAdmin" asp-action="Users"
                       asp-route-search="@Model.ReturnSearch"
                       asp-route-status="@Model.ReturnStatus"
                       asp-route-role="@Model.ReturnRole"
                       asp-route-page="@Model.ReturnPage"
                       class="btn btn-outline btn-sm">← Back</a>
                </div>

                <!-- ── Info Cards ──────────────────────────────────── -->
                <div class="grid-2">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">👤 Account Information</div></div>
                        <div class="inner-card-body">
                            <div class="info-list">
                                <div class="info-line"><span class="info-key">User ID</span>     <span class="info-val">#@u.UserId</span></div>
                                <div class="info-line"><span class="info-key">Full Name</span>   <span class="info-val">@u.FullName</span></div>
                                <div class="info-line"><span class="info-key">Email</span>       <span class="info-val">@u.Email</span></div>
                                <div class="info-line"><span class="info-key">Phone</span>       <span class="info-val">@(u.Phone ?? "—")</span></div>
                                <div class="info-line"><span class="info-key">Gender</span>      <span class="info-val">@(u.Gender ?? "—")</span></div>
                                <div class="info-line"><span class="info-key">Role</span>        <span class="info-val"><span class="badge @u.RoleBadgeClass">@u.RoleIcon @u.RoleName</span></span></div>
                                <div class="info-line"><span class="info-key">Status</span>      <span class="info-val"><span class="badge @u.StatusBadgeClass">@u.StatusIcon @u.AccountStatus</span></span></div>
                                <div class="info-line"><span class="info-key">Joined</span>      <span class="info-val">@(u.CreatedAt?.ToString("dd MMM yyyy") ?? "—")</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">📍 Location & Bio</div></div>
                        <div class="inner-card-body">
                            <div class="info-list">
                                <div class="info-line"><span class="info-key">City</span>          <span class="info-val">@(u.City ?? "—")</span></div>
                                <div class="info-line"><span class="info-key">Area</span>          <span class="info-val">@(u.Area ?? "—")</span></div>
                                <div class="info-line">
                                    <span class="info-key">Bio</span>
                                    <span class="info-val" style="max-width:200px;text-align:right;">
                                        @(string.IsNullOrEmpty(u.Bio) ? "—" : u.Bio)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Tabs — المحتوى مؤقت حتى تُربط الـ repos ────── -->
                <div class="tabs-row">
                    <button class="tab-btn active" onclick="showTab('info',this)">📋 Info</button>
                    <button class="tab-btn" onclick="showTab('pets',this)">🐾 Pets</button>
                    <button class="tab-btn" onclick="showTab('appointments',this)">📅 Appointments</button>
                    <button class="tab-btn" onclick="showTab('orders',this)">🛍️ Orders</button>
                    <button class="tab-btn" onclick="showTab('lost',this)">🔍 Lost Reports</button>
                    <button class="tab-btn" onclick="showTab('adoption',this)">🏠 Adoption</button>
                    <button class="tab-btn" onclick="showTab('timeline',this)">⏱️ Timeline</button>
                    <button class="tab-btn" onclick="showTab('complaints',this)">🚨 Complaints</button>
                </div>

                <div class="tab-pane active" id="tab-info">
                    <div class="inner-card">
                        <div class="inner-card-head"><div class="inner-card-title">Summary</div></div>
                        <div class="inner-card-body" style="color:var(--text-muted);font-size:.86rem;font-weight:700;">
                            Full user activity data (Pets, Appointments, Orders, Reports) will be connected here once the corresponding repositories are built. The account management actions above are fully functional.
                        </div>
                    </div>
                </div>

                @* باقي الـ tabs — placeholder حتى تُبنى الـ repos *@
                @foreach (var tabId in new[] { "pets", "appointments", "orders", "lost", "adoption", "timeline", "complaints" })
                {
                    <div class="tab-pane" id="tab-@tabId">
                        <div class="inner-card">
                            <div class="inner-card-head">
                                <div class="inner-card-title">@tabId.ToUpper()</div>
                                <span class="badge badge-muted">Coming soon</span>
                            </div>
                            <div class="inner-card-body" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                                🔧 This tab will be connected when the corresponding repository is built.
                            </div>
                        </div>
                    </div>
                }

            </div>
        </main>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        function showTab(id, btn) {
            document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tabs-row .tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + id)?.classList.add('active');
            if (btn) btn.classList.add('active');
        }
        // Auto-hide flash
        const fm = document.getElementById('flashMsg');
        if (fm) { setTimeout(() => fm.style.opacity = '0', 3000); setTimeout(() => fm.remove(), 3400); }
    </script>
</body>
</html>