@{
    ViewData["Title"] = "Waffy — Super Admin | Store Details";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR ══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard" data-tip="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" data-tip="Users" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span>
                            <span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-shop" onclick="acc('g-shop','t-shop')" data-tip="Shop" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span>
                            <span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-shop" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span><span class="sb-bdg bd-y sb-child-bdg">3</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span><span class="sb-bdg bd-r sb-child-bdg">6</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" data-tip="Adoption" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span><span class="sb-bdg bd-y">5</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span><span class="sb-bdg bd-y sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" data-tip="Reports" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span><span class="sb-bdg bd-y">8</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map" data-tip="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications" data-tip="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span></a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row"><div class="sb-av">DC</div><div class="sb-user-info"><div class="sb-user-name">Daniel Carter</div><div class="sb-user-role">Operations Director</div></div></div>
                <button class="sb-logout" onclick="alert('Sign out')" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></button>
            </div>
        </aside>

        <!-- ══ TOPNAV ══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Shop</span><span>/</span><a asp-controller="SuperAdmin" asp-action="Stores" style="color:var(--text-muted);font-weight:800;">Stores</a><span>/</span><b id="tnCur">Details</b></nav>
            <div class="tn-center"><div class="tn-center-main" id="tnTitle">Store Details</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <button class="tn-btn" type="button"><svg class="ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg></button>
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="tn-count">12</span></a>
                <a class="tn-btn" href="#"><svg class="ico" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg><span class="tn-dot dot-g"></span></a>
                <div class="tn-sep"></div>
                <div class="tn-profile" onclick="alert('Profile')"><div class="tn-av">DC</div><div><div class="tn-pname">Daniel Carter</div><div class="tn-prole">Operations Director</div></div></div>
            </div>
        </header>

        <!-- ══ MAIN ══ -->
        <main class="wa-main" id="waMain">

            <section class="page-hero" id="storeHero">
                <div>
                    <h1 id="heroTitle">🏪 Store Details</h1>
                    <p id="heroSub">Full store profile — products, orders, documents, and actions.</p>
                </div>
                <div class="page-hero-actions">
                    <a class="btn btn-outline btn-sm" asp-controller="SuperAdmin" asp-action="Stores">← Back to Stores</a>
                    <button class="btn btn-warning btn-sm" onclick="openM('warnModal')">⚠️ Warn</button>
                    <button class="btn btn-danger btn-sm" onclick="openM('suspendModal')">🔒 Suspend</button>
                </div>
            </section>

            <div class="page-body">

                <!-- Store profile card -->
                <div style="background:#fff;border:1px solid var(--border);border-radius:var(--r-xl);padding:22px;margin-bottom:16px;box-shadow:var(--shadow);">
                    <div style="display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;">
                        <div style="width:80px;height:80px;border-radius:22px;background:var(--brand-xlight);border:1px solid var(--border);display:grid;place-items:center;font-size:2.2rem;flex-shrink:0;" id="storeEmoji">🏪</div>
                        <div style="flex:1;min-width:200px;">
                            <div style="font-family:'Fredoka',sans-serif;font-size:1.6rem;font-weight:700;color:var(--brand-dark);" id="storeName">—</div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;align-items:center;" id="storeBadges"></div>
                            <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;font-size:.84rem;font-weight:700;color:var(--text-muted);" id="storeMeta"></div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;" id="storeActions"></div>
                    </div>
                </div>

                <!-- KPI mini stats -->
                <div class="kpi-grid kpi-grid-4" style="margin-bottom:16px;">
                    <div class="kpi-card c1"><div class="kpi-ico green">📦</div><div class="kpi-val" id="ksProducts">—</div><div class="kpi-label">Products</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">🛒</div><div class="kpi-val" id="ksOrders">—</div><div class="kpi-label">Total Orders</div></div>
                    <div class="kpi-card c1"><div class="kpi-ico green">💰</div><div class="kpi-val" id="ksRevenue">—</div><div class="kpi-label">Revenue</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">⭐</div><div class="kpi-val" id="ksRating">—</div><div class="kpi-label">Rating</div></div>
                </div>

                <!-- Tabs -->
                <div class="tabs-bar" id="tabsBar">
                    <button class="tab-btn active" onclick="showTab('products',this)">📦 Products</button>
                    <button class="tab-btn" onclick="showTab('orders',this)">🛒 Orders</button>
                    <button class="tab-btn" onclick="showTab('documents',this)">📋 Documents</button>
                    <button class="tab-btn" onclick="showTab('info',this)">ℹ️ Store Info</button>
                </div>

                <!-- TAB: PRODUCTS -->
                <div id="tab-products">
                    <div class="table-card">
                        <div class="table-head-bar">
                            <div class="table-head-title">Product List</div>
                            <div style="display:flex;gap:8px;">
                                <select class="sel-wrap" style="height:36px;width:auto;min-width:150px;font-size:.78rem;" id="prodStatusFilter" onchange="renderProducts()">
                                    <option value="">All Statuses</option>
                                    <option value="active">Active</option>
                                    <option value="hidden">Hidden</option>
                                    <option value="flagged">Flagged</option>
                                </select>
                                <div class="search-wrap" style="height:36px;min-width:200px;border-radius:10px;">
                                    <span style="font-size:.9rem;color:var(--text-muted);">🔍</span>
                                    <input type="text" id="prodSearch" placeholder="Search product..." oninput="renderProducts()" style="font-size:.82rem;" />
                                </div>
                            </div>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Sales</th><th>Status</th><th>Actions</th></tr></thead>
                                <tbody id="productsTBody"></tbody>
                            </table>
                        </div>
                        <div class="pagination-bar"><div class="pag-info" id="prodPagInfo"></div></div>
                    </div>
                </div>

                <!-- TAB: ORDERS -->
                <div id="tab-orders" style="display:none;">
                    <div class="table-card">
                        <div class="table-head-bar">
                            <div class="table-head-title">Order History</div>
                            <div style="display:flex;gap:8px;">
                                <select class="sel-wrap" style="height:36px;width:auto;min-width:150px;font-size:.78rem;" id="orderStatusFilter" onchange="renderOrders()">
                                    <option value="">All Statuses</option>
                                    <option value="pending">Pending</option>
                                    <option value="delivered">Delivered</option>
                                    <option value="canceled">Canceled</option>
                                </select>
                                <div class="search-wrap" style="height:36px;min-width:200px;border-radius:10px;">
                                    <span style="font-size:.9rem;color:var(--text-muted);">🔍</span>
                                    <input type="text" id="orderSearch" placeholder="Search order or user..." oninput="renderOrders()" style="font-size:.82rem;" />
                                </div>
                            </div>
                        </div>
                        <div class="table-wrap">
                            <table>
                                <thead><tr><th>Order ID</th><th>Customer</th><th>Items</th><th>Total</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead>
                                <tbody id="ordersTBody"></tbody>
                            </table>
                        </div>
                        <div class="pagination-bar"><div class="pag-info" id="orderPagInfo"></div></div>
                    </div>
                </div>

                <!-- TAB: DOCUMENTS -->
                <div id="tab-documents" style="display:none;">
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">Verification Documents</div></div>
                        <div style="padding:20px;display:grid;grid-template-columns:repeat(2,1fr);gap:14px;" id="docsGrid"></div>
                    </div>
                </div>

                <!-- TAB: INFO -->
                <div id="tab-info" style="display:none;">
                    <div class="table-card">
                        <div class="table-head-bar">
                            <div class="table-head-title">Store Information</div>
                            <button class="btn btn-outline btn-sm" onclick="openM('editStoreModal')">✏️ Edit Info</button>
                        </div>
                        <div style="padding:20px;" id="storeInfoGrid"></div>
                    </div>
                </div>

            </div><!-- /page-body -->
        </main>
    </div>

    <!-- ══ MODAL: Edit Product ══ -->
    <div class="modal-overlay" id="editProductModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">✏️ Edit Product</div><button class="dp-close" onclick="closeM('editProductModal')">✕</button></div>
            <div class="modal-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="field" style="grid-column:1/-1;"><label>Product Name</label><input type="text" id="editProdName" /></div>
                    <div class="field"><label>Price (JD)</label><input type="number" id="editProdPrice" step="0.01" /></div>
                    <div class="field"><label>Category</label><select id="editProdCat"><option>Food</option><option>Accessories</option><option>Health Care</option><option>Toys</option></select></div>
                    <div class="field"><label>Stock</label><input type="number" id="editProdStock" min="0" /></div>
                    <div class="field"><label>Status</label><select id="editProdStatus"><option value="active">Active</option><option value="hidden">Hidden</option><option value="flagged">Flagged</option></select></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('editProductModal')">Cancel</button>
                <button class="btn btn-primary" onclick="saveProductEdit()">Save Changes</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Order Details ══ -->
    <div class="modal-overlay" id="orderDetailModal">
        <div class="modal-box" style="max-width:560px;">
            <div class="modal-head"><div class="modal-title">🛒 Order Details</div><button class="dp-close" onclick="closeM('orderDetailModal')">✕</button></div>
            <div class="modal-body" id="orderDetailBody"></div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('orderDetailModal')">Close</button>
                <button class="btn btn-danger btn-sm" id="cancelOrderBtn" onclick="cancelCurrentOrder()">Cancel Order</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Warn ══ -->
    <div class="modal-overlay" id="warnModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">⚠️ Send Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
            <div class="modal-body">
                <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.2);border-radius:12px;padding:12px;font-size:.82rem;font-weight:700;color:#9b6000;margin-bottom:14px;">The warning will be sent to the store owner and recorded in moderation history.</div>
                <div class="field">
                    <label>Warning Type</label>
                    <select id="warnType"><option>Policy violation</option><option>Misleading product information</option><option>High complaint volume</option><option>Repeated delivery delays</option><option>Terms of service violation</option></select>
                </div>
                <div class="field"><label>Warning Message</label><textarea id="warnMessage" placeholder="Write the official warning message..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button class="btn btn-warning" onclick="sendWarning()">Send Warning</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Suspend ══ -->
    <div class="modal-overlay" id="suspendModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">🔒 Suspend Store</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Suspension Reason</label><select id="suspendReason"><option>Policy violation</option><option>Multiple complaints</option><option>Unpaid dues</option><option>Invalid documents</option><option>Suspicious activity</option></select></div>
                <div class="field"><label>Duration</label><select id="suspendDuration"><option>7 days</option><option>30 days</option><option>90 days</option><option>Permanent</option></select></div>
                <div class="field"><label>Message to Store</label><textarea id="suspendMessage" placeholder="Explain the reason..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
                <button class="btn btn-danger" onclick="confirmSuspend()">Suspend Store</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Edit Store Info ══ -->
    <div class="modal-overlay" id="editStoreModal">
        <div class="modal-box" style="max-width:560px;">
            <div class="modal-head"><div class="modal-title">✏️ Edit Store Info</div><button class="dp-close" onclick="closeM('editStoreModal')">✕</button></div>
            <div class="modal-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="field" style="grid-column:1/-1;"><label>Store Name</label><input type="text" id="editSName" /></div>
                    <div class="field"><label>Owner</label><input type="text" id="editSOwner" /></div>
                    <div class="field"><label>Email</label><input type="email" id="editSEmail" /></div>
                    <div class="field"><label>Phone</label><input type="text" id="editSPhone" /></div>
                    <div class="field"><label>City</label><select id="editSCity"><option>Amman</option><option>Zarqa</option><option>Irbid</option><option>Aqaba</option><option>Balqa</option></select></div>
                    <div class="field"><label>Payment Model</label><select id="editSModel"><option>Subscription</option><option>Commission</option></select></div>
                    <div class="field" style="grid-column:1/-1;"><label>Description</label><textarea id="editSDesc" placeholder="Store description..."></textarea></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('editStoreModal')">Cancel</button>
                <button class="btn btn-primary" onclick="saveStoreEdit()">Save Changes</button>
            </div>
        </div>
    </div>

    <!-- ══ MODAL: Delete Product ══ -->
    <div class="modal-overlay" id="deleteProdModal">
        <div class="modal-box" style="max-width:420px;">
            <div class="modal-head"><div class="modal-title">🗑 Delete Product</div><button class="dp-close" onclick="closeM('deleteProdModal')">✕</button></div>
            <div class="modal-body" style="text-align:center;padding:24px 20px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">⚠️</div>
                <div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:var(--brand-dark);margin-bottom:8px;">Delete this product?</div>
                <div style="font-size:.86rem;color:var(--text-muted);font-weight:700;" id="deleteProdName"></div>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-outline" onclick="closeM('deleteProdModal')">Cancel</button>
                <button class="btn btn-danger" onclick="confirmDeleteProd()">Yes, Delete</button>
            </div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js"></script>
    <script src="~/js/superAdminClinic.js"></script>
    <script>
        const storeData = {
            id:1, name:"Pet Friends Store", emoji:"🐾",
            owner:"Mohammad Al-Omari", email:"store@petfriends.jo",
            phone:"0791234567", city:"Amman", model:"Subscription",
            status:"active", joined:"2026-01-01",
            description:"A premium pet supplies store offering food, accessories, and health products for all pet types.",
            products:48, orders:186, revenue:1840, rating:4.2,
            documents:{ registration:true, license:true, trademark:true, tax:true }
        };
        const products = [
            {id:101,name:"Premium Dog Food",cat:"Food",price:18.5,stock:120,sales:90,status:"active",emoji:"🥣"},
            {id:102,name:"Cat Scratching Tree",cat:"Accessories",price:32.0,stock:45,sales:41,status:"active",emoji:"🌴"},
            {id:103,name:"Flea Spray",cat:"Health Care",price:12.75,stock:80,sales:15,status:"flagged",emoji:"🧴"},
            {id:104,name:"Hamster Wheel",cat:"Accessories",price:8.2,stock:0,sales:9,status:"hidden",emoji:"🎡"},
            {id:105,name:"Cat Wet Food",cat:"Food",price:2.5,stock:300,sales:180,status:"active",emoji:"🐟"},
            {id:106,name:"Bird Vitamins",cat:"Health Care",price:9.0,stock:55,sales:20,status:"active",emoji:"💊"},
            {id:107,name:"Dog Collar Premium",cat:"Accessories",price:14.0,stock:70,sales:35,status:"active",emoji:"🏷️"},
            {id:108,name:"Aquarium Filter",cat:"Accessories",price:22.0,stock:18,sales:11,status:"active",emoji:"🐠"},
        ];
        const orders = [
            {id:"#1023",user:"Sara Al-Khatib",items:"Dog Food 5kg",total:22,date:"2026-03-28",status:"delivered"},
            {id:"#1021",user:"Omar Nasser",items:"Cat Toys x2",total:18,date:"2026-03-26",status:"delivered"},
            {id:"#1019",user:"Rana Al-Haddad",items:"Bird Vitamins, Flea Spray",total:36,date:"2026-03-25",status:"pending"},
            {id:"#1015",user:"Khaled Sami",items:"Premium Dog Food",total:18.5,date:"2026-03-22",status:"delivered"},
            {id:"#1010",user:"Dina Saleh",items:"Cat Scratching Tree",total:32,date:"2026-03-20",status:"canceled"},
            {id:"#1008",user:"Ahmad Zaid",items:"Hamster Wheel",total:8.2,date:"2026-03-18",status:"delivered"},
            {id:"#1005",user:"Fatima Khalil",items:"Cat Wet Food x4",total:10,date:"2026-03-15",status:"delivered"},
            {id:"#1001",user:"Bassem Nour",items:"Dog Collar Premium",total:14,date:"2026-03-10",status:"delivered"},
        ];
        let currentProdId=null, currentOrderId=null;

        function statusBadge(s) {
            const map={active:['badge-success','✅ Active'],hidden:['badge-muted','🙈 Hidden'],flagged:['badge-danger','🚩 Flagged'],pending:['badge-warning','⏳ Pending'],delivered:['badge-success','📦 Delivered'],canceled:['badge-danger','❌ Canceled'],suspended:['badge-danger','🔒 Suspended']};
            const [cls,lbl]=map[s]||['badge-muted',s];
            return `<span class="badge ${cls}">${lbl}</span>`;
        }
        function modelBadge(m) { return m==='Subscription'?`<span class="badge badge-info">💳 Subscription</span>`:`<span class="badge badge-purple">📊 Commission</span>`; }

        function initPage() {
            const s=storeData;
            document.title=`Waffy — ${s.name}`;
            document.getElementById('tnCur').textContent=s.name;
            document.getElementById('tnTitle').textContent=s.name;
            document.getElementById('heroTitle').textContent=`${s.emoji} ${s.name}`;
            document.getElementById('heroSub').textContent=`${s.city} · ${s.model} · Joined ${s.joined}`;
            document.getElementById('storeEmoji').textContent=s.emoji;
            document.getElementById('storeName').textContent=s.name;
            document.getElementById('storeBadges').innerHTML=statusBadge(s.status)+modelBadge(s.model)+`<span class="badge badge-muted">📍 ${s.city}</span>`;
            document.getElementById('storeMeta').innerHTML=`<span>👤 ${s.owner}</span><span>📧 ${s.email}</span><span>📞 ${s.phone}</span><span>📅 Joined ${s.joined}</span>`;
            document.getElementById('storeActions').innerHTML=`
                <button class="btn btn-success btn-sm" onclick="activateStore()">✅ Activate</button>
                <button class="btn btn-warning btn-sm" onclick="openM('warnModal')">⚠️ Warn</button>
                <button class="btn btn-danger btn-sm" onclick="openM('suspendModal')">🔒 Suspend</button>`;
            document.getElementById('ksProducts').textContent=s.products;
            document.getElementById('ksOrders').textContent=s.orders;
            document.getElementById('ksRevenue').textContent=s.revenue.toLocaleString()+' JD';
            document.getElementById('ksRating').textContent='⭐ '+s.rating.toFixed(1);
            renderProducts(); renderDocuments(); renderStoreInfo();
        }

        function renderProducts() {
            const q=(document.getElementById('prodSearch')?.value||'').toLowerCase(), sf=document.getElementById('prodStatusFilter')?.value||'';
            const data=products.filter(p=>(!q||p.name.toLowerCase().includes(q)||p.cat.toLowerCase().includes(q))&&(!sf||p.status===sf));
            document.getElementById('productsTBody').innerHTML=data.length?data.map(p=>`
                <tr><td><div style="display:flex;align-items:center;gap:10px;"><div style="width:38px;height:38px;border-radius:10px;background:var(--brand-xlight);display:grid;place-items:center;font-size:1.2rem;flex-shrink:0;">${p.emoji}</div><div class="cell-title">${p.name}</div></div></td>
                <td><span class="badge badge-info" style="font-size:.7rem;">${p.cat}</span></td>
                <td><strong style="color:var(--brand-dark);">${p.price.toFixed(2)} JD</strong></td>
                <td style="color:${p.stock===0?'var(--danger)':'var(--text)'};">${p.stock===0?'⚠️ Out of stock':p.stock+' units'}</td>
                <td>${p.sales}</td><td>${statusBadge(p.status)}</td>
                <td><div style="display:flex;gap:5px;"><button class="btn btn-outline btn-xs" onclick="openEditProduct(${p.id})">✏️ Edit</button><button class="btn btn-warning btn-xs" onclick="toggleHide(${p.id})">${p.status==='hidden'?'👁 Show':'🙈 Hide'}</button><button class="btn btn-danger btn-xs" onclick="openDeleteProd(${p.id})">🗑</button></div></td>
                </tr>`).join(''):`<tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted);">No products found.</td></tr>`;
            document.getElementById('prodPagInfo').textContent=`Showing ${data.length} of ${products.length} products`;
        }
        function openEditProduct(id) { const p=products.find(x=>x.id===id); if(!p) return; currentProdId=id; document.getElementById('editProdName').value=p.name; document.getElementById('editProdPrice').value=p.price; document.getElementById('editProdCat').value=p.cat; document.getElementById('editProdStock').value=p.stock; document.getElementById('editProdStatus').value=p.status; openM('editProductModal'); }
        function saveProductEdit() { const p=products.find(x=>x.id===currentProdId); if(!p) return; p.name=document.getElementById('editProdName').value; p.price=parseFloat(document.getElementById('editProdPrice').value)||p.price; p.cat=document.getElementById('editProdCat').value; p.stock=parseInt(document.getElementById('editProdStock').value)||0; p.status=document.getElementById('editProdStatus').value; closeM('editProductModal'); renderProducts(); toast('Product updated successfully.','success'); }
        function toggleHide(id) { const p=products.find(x=>x.id===id); if(!p) return; p.status=p.status==='hidden'?'active':'hidden'; renderProducts(); toast(`Product ${p.status==='hidden'?'hidden':'shown'}.`,p.status==='hidden'?'warning':'success'); }
        function openDeleteProd(id) { const p=products.find(x=>x.id===id); if(!p) return; currentProdId=id; document.getElementById('deleteProdName').textContent=p.name; openM('deleteProdModal'); }
        function confirmDeleteProd() { const idx=products.findIndex(x=>x.id===currentProdId); if(idx>-1) products.splice(idx,1); closeM('deleteProdModal'); renderProducts(); toast('Product deleted.','danger'); }

        function renderOrders() {
            const q=(document.getElementById('orderSearch')?.value||'').toLowerCase(), sf=document.getElementById('orderStatusFilter')?.value||'';
            const data=orders.filter(o=>(!q||o.id.toLowerCase().includes(q)||o.user.toLowerCase().includes(q)||o.items.toLowerCase().includes(q))&&(!sf||o.status===sf));
            document.getElementById('ordersTBody').innerHTML=data.length?data.map(o=>`
                <tr><td><strong style="color:var(--brand-dark);font-family:'Fredoka',sans-serif;">${o.id}</strong></td>
                <td>${o.user}</td><td style="font-size:.82rem;color:var(--text-muted);max-width:160px;white-space:normal;">${o.items}</td>
                <td><strong style="color:var(--success);">${o.total.toFixed(2)} JD</strong></td>
                <td style="font-size:.8rem;color:var(--text-muted);">${o.date}</td><td>${statusBadge(o.status)}</td>
                <td><div style="display:flex;gap:5px;"><button class="btn btn-outline btn-xs" onclick="viewOrder('${o.id}')">👁 View</button>${o.status==='pending'?`<button class="btn btn-danger btn-xs" onclick="cancelOrder('${o.id}')">❌ Cancel</button>`:''}</div></td>
                </tr>`).join(''):`<tr><td colspan="7" style="text-align:center;padding:28px;color:var(--text-muted);">No orders found.</td></tr>`;
            document.getElementById('orderPagInfo').textContent=`Showing ${data.length} of ${orders.length} orders`;
        }
        function viewOrder(id) {
            const o=orders.find(x=>x.id===id); if(!o) return;
            currentOrderId=id;
            document.getElementById('cancelOrderBtn').style.display=o.status==='pending'?'inline-flex':'none';
            document.getElementById('orderDetailBody').innerHTML=`
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
                    <div class="dp-info-item"><div class="dp-info-label">Order ID</div><div class="dp-info-val" style="font-family:'Fredoka',sans-serif;">${o.id}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Status</div><div style="margin-top:4px;">${statusBadge(o.status)}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Customer</div><div class="dp-info-val">${o.user}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Date</div><div class="dp-info-val">${o.date}</div></div>
                    <div class="dp-info-item" style="grid-column:1/-1;"><div class="dp-info-label">Items</div><div class="dp-info-val">${o.items}</div></div>
                    <div class="dp-info-item" style="grid-column:1/-1;background:var(--success-soft);border-color:rgba(47,158,95,.2);"><div class="dp-info-label">Total Amount</div><div class="dp-info-val green" style="font-family:'Fredoka',sans-serif;font-size:1.4rem;">${o.total.toFixed(2)} JD</div></div>
                </div>`;
            openM('orderDetailModal');
        }
        function cancelOrder(id) { const o=orders.find(x=>x.id===id); if(!o) return; o.status='canceled'; renderOrders(); toast(`Order ${id} canceled.`,'danger'); }
        function cancelCurrentOrder() { cancelOrder(currentOrderId); closeM('orderDetailModal'); }

        function renderDocuments() {
            const docLabels={registration:'📜 Commercial Registration',license:'🏢 Business License',trademark:'™️ Trademark File',tax:'💼 Tax Document'};
            const docDesc={registration:'Official commercial registration from the Ministry of Industry.',license:'Valid business operating license.',trademark:'Brand trademark protection certificate.',tax:'Tax identification number document.'};
            document.getElementById('docsGrid').innerHTML=Object.entries(storeData.documents).map(([k,v])=>`
                <div style="background:${v?'var(--success-soft)':'var(--danger-soft)'};border:1.5px solid ${v?'rgba(47,158,95,.22)':'rgba(217,83,79,.22)'};border-radius:var(--r-lg);padding:18px;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;">
                        <div style="font-size:.92rem;font-weight:900;color:var(--brand-dark);">${docLabels[k]}</div>
                        <span class="badge ${v?'badge-success':'badge-danger'}">${v?'✅ Uploaded':'❌ Missing'}</span>
                    </div>
                    <div style="font-size:.8rem;color:var(--text-muted);font-weight:700;line-height:1.5;">${docDesc[k]}</div>
                    ${!v?`<button class="btn btn-outline btn-sm" style="margin-top:12px;width:100%;" onclick="requestDoc('${k}')">📩 Request Upload</button>`:`<button class="btn btn-outline btn-sm" style="margin-top:12px;width:100%;">👁 View Document</button>`}
                </div>`).join('');
        }
        function requestDoc(key) { toast(`Document request sent to store owner: ${key}.`,'warning'); }

        function renderStoreInfo() {
            const s=storeData;
            document.getElementById('storeInfoGrid').innerHTML=`
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div class="dp-info-item"><div class="dp-info-label">Store Name</div><div class="dp-info-val">${s.name}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Owner</div><div class="dp-info-val">${s.owner}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Email</div><div class="dp-info-val">${s.email}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Phone</div><div class="dp-info-val">${s.phone}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">City</div><div class="dp-info-val">📍 ${s.city}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Payment Model</div><div style="margin-top:4px;">${modelBadge(s.model)}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Status</div><div style="margin-top:4px;">${statusBadge(s.status)}</div></div>
                    <div class="dp-info-item"><div class="dp-info-label">Joined</div><div class="dp-info-val">${s.joined}</div></div>
                    <div class="dp-info-item" style="grid-column:1/-1;"><div class="dp-info-label">Description</div><div style="font-size:.86rem;font-weight:700;color:var(--text);margin-top:6px;line-height:1.6;">${s.description}</div></div>
                </div>`;
            document.getElementById('editSName').value=s.name; document.getElementById('editSOwner').value=s.owner;
            document.getElementById('editSEmail').value=s.email; document.getElementById('editSPhone').value=s.phone;
            document.getElementById('editSCity').value=s.city; document.getElementById('editSModel').value=s.model;
            document.getElementById('editSDesc').value=s.description;
        }
        function saveStoreEdit() { storeData.name=document.getElementById('editSName').value; storeData.owner=document.getElementById('editSOwner').value; storeData.email=document.getElementById('editSEmail').value; storeData.phone=document.getElementById('editSPhone').value; storeData.city=document.getElementById('editSCity').value; storeData.model=document.getElementById('editSModel').value; storeData.description=document.getElementById('editSDesc').value; closeM('editStoreModal'); initPage(); renderStoreInfo(); toast('Store info updated.','success'); }
        function activateStore() { storeData.status='active'; initPage(); toast('Store activated successfully.','success'); }
        function confirmSuspend() { storeData.status='suspended'; closeM('suspendModal'); initPage(); toast('Store suspended.','danger'); }
        function sendWarning() { closeM('warnModal'); toast('Warning sent to store owner.','warning'); }

        const TABS=['products','orders','documents','info'];
        function showTab(id,btn) { TABS.forEach(t=>{ document.getElementById('tab-'+t).style.display=t===id?'block':'none'; }); document.querySelectorAll('#tabsBar .tab-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); if(id==='orders') renderOrders(); }

        function openM(id) { const m=document.getElementById(id); if(m) m.classList.add('open'); }
        function closeM(id) { const m=document.getElementById(id); if(m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay,.detail-overlay').forEach(m=>{ m.addEventListener('click',e=>{if(e.target===m) m.classList.remove('open');}); });
        function toast(msg,type='success') {
            const bg={success:'var(--success-soft)',danger:'var(--danger-soft)',warning:'var(--warning-soft)'}, col={success:'var(--success)',danger:'var(--danger)',warning:'#9b6000'};
            const t=document.createElement('div');
            t.style.cssText=`position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
            t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),3000);
        }
        const ts=document.createElement('style');
        ts.textContent=`@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}`;
        document.head.appendChild(ts);
        initPage();
    </script>
</body>
</html>
