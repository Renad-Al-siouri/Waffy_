@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | Donations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        .don-ico {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--brand-xlight);
            border: 1px solid var(--brand-light);
            display: grid;
            place-items: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .animal-card {
            background: #fff;
            border: 1.5px solid var(--border);
            border-radius: var(--r-lg);
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: .2s ease;
            position: relative;
        }

            .animal-card:hover {
                box-shadow: var(--shadow);
                transform: translateY(-1px);
            }

            .animal-card.paused {
                opacity: .6;
            }

                .animal-card.paused::after {
                    content: 'Paused';
                    position: absolute;
                    top: 10px;
                    right: 12px;
                    background: var(--warning-soft);
                    color: #9b6000;
                    font-size: .68rem;
                    font-weight: 900;
                    padding: 3px 8px;
                    border-radius: 999px;
                }

        .animal-ava {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: var(--brand-xlight);
            border: 1px solid var(--brand-light);
            display: grid;
            place-items: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .animal-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .animal-meta {
            font-size: .76rem;
            color: var(--text-muted);
            font-weight: 700;
            margin-top: 2px;
        }

        .prog-wrap {
            height: 7px;
            background: var(--border);
            border-radius: 999px;
            overflow: hidden;
            margin: 8px 0 4px;
        }

        .prog-fill {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg,var(--brand),var(--brand-dark));
        }

        .animals-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(290px,1fr));
            gap: 12px;
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <aside class="wa-sb" id="waSb">
            <div class="sb-logo"><div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div><div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div></div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat"><a class="sb-row" href="@Url.Action("Dashboard", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span><span class="sb-lbl">Dashboard</span></a></div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div><button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span><span class="sb-lbl">Users</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-users"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Users", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a></div></div></div>
                    <div><button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span><span class="sb-lbl">Clinics</span><span class="sb-bdg bd-y">4</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-clinics"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Clinics", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a><a class="sb-child" href="@Url.Action("Reviews_Complaints_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a><a class="sb-child" href="@Url.Action("Analytics_C", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div><button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span><span class="sb-lbl">Shop</span><span class="sb-bdg bd-r">3</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-shop"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Stores", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a><a class="sb-child" href="@Url.Action("Reviews_Complaints_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a><a class="sb-child" href="@Url.Action("Analytics_S", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div><button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span><span class="sb-lbl">Adoption</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-adopt"><div class="sb-sub-inner"><a class="sb-child" href="@Url.Action("Listings", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a><a class="sb-child" href="@Url.Action("Flagged", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span><span class="sb-bdg bd-r sb-child-bdg">3</span></a><a class="sb-child" href="@Url.Action("Adopted_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a><a class="sb-child" href="@Url.Action("Analytics_A", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a></div></div></div>
                    <div>
                        <button class="sb-row open active" id="t-rep" onclick="acc('g-rep','t-rep')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span><span class="sb-lbl">Reports</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button>
                        <div class="sb-sub open" id="g-rep" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child" href="@Url.Action("Lost_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span><span class="sb-bdg bd-y sb-child-bdg">8</span></a>
                                <a class="sb-child" href="@Url.Action("Found_Pets", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span><span class="sb-bdg bd-g sb-child-bdg">5</span></a>
                                <a class="sb-child" href="@Url.Action("Dangerous_Animals", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span><span class="sb-bdg bd-r sb-child-bdg">4</span></a>
                                <a class="sb-child active" href="@Url.Action("Donations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" href="@Url.Action("Laws_Regulations", "SuperAdmin")"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" href="@Url.Action("Map", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" href="@Url.Action("Notifications", "SuperAdmin")"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span><span class="sb-bdg bd-r">12</span></a>
                </div>
            </nav>
            <div class="sb-foot"><div class="sb-user-row"><div class="sb-av">DC</div><div class="sb-user-info"><div class="sb-user-name">Daniel Carter</div><div class="sb-user-role">Operations Director</div></div></div><button class="sb-logout" onclick="alert('Sign out')" type="button"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></button></div>
        </aside>
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Reports</span><span>/</span><b>Donations</b></nav>
            <div class="tn-center"><div class="tn-center-main">Donations</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" href="@Url.Action("Notifications", "SuperAdmin")"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg><span class="tn-count">9</span></a>
                <div class="tn-sep"></div>
                <div class="tn-profile" onclick="alert('Profile')"><div class="tn-av">DC</div><div><div class="tn-pname">Daniel Carter</div><div class="tn-prole">Operations Director</div></div></div>
            </div>
        </header>
        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div><h1>&#x2764;&#xFE0F; Donations</h1><p>Track incoming donations and manage the animals available for targeted donations.</p></div>
                <div class="page-hero-actions"><button class="btn btn-outline btn-sm">&#x1F4E5; Export</button></div>
            </section>
            <div class="page-body">
                <div class="kpi-grid kpi-grid-4" style="margin-bottom:20px;">
                    <div class="kpi-card c1"><div class="kpi-ico green">&#x1F4B0;</div><div class="kpi-val" id="kpiAmount">1,240</div><div class="kpi-label">Collected This Month (JOD)</div><div class="kpi-chip chip-green">&#x25B2; 22%</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">&#x2764;&#xFE0F;</div><div class="kpi-val" id="kpiCount">87</div><div class="kpi-label">Donations This Month</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">&#x23F3;</div><div class="kpi-val" id="kpiPending">3</div><div class="kpi-label">Pending Distribution</div><div class="kpi-chip chip-yellow">Needs action</div></div>
                    <div class="kpi-card c1"><div class="kpi-ico green">&#x1F4E6;</div><div class="kpi-val" id="kpiDistributed">84</div><div class="kpi-label">Distributed</div><div class="kpi-chip chip-green">98% rate</div></div>
                </div>
                <div class="tabs-bar" style="margin-bottom:20px;">
                    <button class="tab-btn active" onclick="switchTab(this,'donations')">&#x1F4B5; Donations Log</button>
                    <button class="tab-btn" onclick="switchTab(this,'animals')">&#x1F43E; Donation Animals <span class="tab-count" id="tabAnimalsCount">—</span></button>
                </div>
                <div id="pane-donations">
                    <div class="toolbar" style="grid-template-columns:1fr auto auto auto;margin-bottom:14px;">
                        <div class="search-wrap"><span style="color:var(--text-muted);font-size:1rem;flex-shrink:0;">&#x1F50D;</span><input id="searchInput" placeholder="Search donor name or reference..." oninput="renderDonations()" /></div>
                        <select class="sel-wrap" id="typeFilter" onchange="renderDonations()" style="height:48px;width:auto;min-width:130px;"><option value="">All Types</option><option value="money">&#x1F4B5; Money</option><option value="food">&#x1F356; Food</option><option value="medicine">&#x1F48A; Medicine</option><option value="supplies">&#x1F4E6; Supplies</option></select>
                        <select class="sel-wrap" id="statusFilter" onchange="renderDonations()" style="height:48px;width:auto;min-width:140px;"><option value="">All Statuses</option><option value="received">Received</option><option value="processing">Processing</option><option value="distributed">Distributed</option></select>
                        <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                    </div>
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">Donations List</div><span class="table-count" id="tableCount">— donations</span></div>
                        <div class="table-wrap"><table><thead><tr><th>Ref</th><th>Donor</th><th>Type</th><th>Amount</th><th>Target Animal</th><th>Date</th><th>Status</th><th>Actions</th></tr></thead><tbody id="tableBody"></tbody></table></div>
                    </div>
                </div>
                <div id="pane-animals" style="display:none;">
                    <div class="toolbar" style="grid-template-columns:1fr auto auto auto;margin-bottom:14px;">
                        <div class="search-wrap"><span style="color:var(--text-muted);font-size:1rem;flex-shrink:0;">&#x1F50D;</span><input id="animalSearch" placeholder="Search animal name..." oninput="renderAnimals()" /></div>
                        <select class="sel-wrap" id="animalTypeFilter" onchange="renderAnimals()" style="height:48px;width:auto;min-width:130px;"><option value="">All Types</option><option value="dog">&#x1F415; Dogs</option><option value="cat">&#x1F408; Cats</option><option value="bird">&#x1F426; Birds</option><option value="other">&#x1F43E; Others</option></select>
                        <select class="sel-wrap" id="animalStatusFilter" onchange="renderAnimals()" style="height:48px;width:auto;min-width:130px;"><option value="">All Statuses</option><option value="active">Active</option><option value="paused">Paused</option><option value="completed">Completed</option></select>
                        <button class="btn btn-primary btn-sm" onclick="openAnimalModal()">&#xFF0B; Add Animal</button>
                    </div>
                    <div class="table-card">
                        <div class="table-head-bar"><div class="table-head-title">&#x1F43E; Animals Available for Donation</div><span style="font-size:.78rem;font-weight:700;color:var(--text-muted);">These appear in the user-facing donation screen</span></div>
                        <div style="padding:16px;"><div class="animals-grid" id="animalsGrid"></div></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div class="modal-overlay" id="lawModal" onclick="if(event.target===this)closeModal('lawModal')">
        <div class="modal-box" style="max-width:600px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:0 24px 60px rgba(38,31,23,.25);overflow:hidden;display:flex;flex-direction:column;max-height:92vh;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.5);flex-shrink:0;">
                <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--brand-dark);" id="modalTitle">&#xFF0B; Add Law</div>
                <button class="dp-close" onclick="closeModal('lawModal')">&#x2715;</button>
            </div>
            <div style="padding:20px;overflow-y:auto;">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                    <div class="field" style="grid-column:1/-1;margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Law Title *</label><input id="fTitle" placeholder="e.g. Animal Protection Law 2008" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                    <div class="field" style="margin-bottom:0;">
                        <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Category *</label>
                        <select id="fCategory" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option value="">Select category</option><option value="travel">&#x2708;&#xFE0F; Pet Travel</option><option value="adoption">&#x1F43E; Adoption</option><option value="protection">&#x1F6E1; Animal Protection</option><option value="vaccination">&#x1F489; Vaccinations</option><option value="breeding">&#x1F9EC; Breeding &amp; Import</option><option value="stray">&#x1F3DA; Stray Animals</option></select>
                    </div>
                    <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Source / Reference</label><input id="fSource" placeholder="e.g. Ministry of Agriculture" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                    <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Last Updated</label><input type="date" id="fUpdated" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                    <div class="field" style="grid-column:1/-1;margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Law Summary *</label><textarea id="fBody" placeholder="Write the law summary..." style="width:100%;min-height:110px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:12px 14px;font-weight:700;font-size:.86rem;outline:none;font-family:'Nunito',sans-serif;resize:vertical;"></textarea></div>
                </div>
            </div>
            <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;background:rgba(255,255,255,.5);flex-shrink:0;">
                <button class="btn btn-primary" onclick="saveLaw()">&#x1F4BE; Save Law</button>
                <button class="btn btn-outline" onclick="closeModal('lawModal')">Cancel</button>
            </div>
        </div>
    </div>

    <div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:#fff;padding:11px 22px;border-radius:var(--pill);font-weight:800;font-size:.85rem;z-index:1999;display:none;align-items:center;gap:6px;box-shadow:0 8px 22px rgba(89,101,42,.3);white-space:nowrap;"></div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        setPageInfo('Laws & Regulations','Super Admin Panel','Reports','Laws');
        let laws=[
          {id:1,cat:'travel',catLabel:'✈️ Pet Travel',title:'Pet Travel Requirements To and From Jordan',body:'Traveling with pets requires a health certificate from a licensed vet, a pet passport, and a valid rabies vaccination (30 days–1 year before travel). An ISO microchip is required by many countries.',source:'Natural Resources Department',updated:'2024-01-15'},
          {id:2,cat:'travel',catLabel:'✈️ Pet Travel',title:'Animals Restricted From Import Into Jordan',body:'Importing dangerous dog breeds may require prior approval. Importing wild or endangered animals is prohibited under CITES.',source:'Jordanian Ministry of Agriculture',updated:'2023-08-20'},
          {id:3,cat:'adoption',catLabel:'🐾 Adoption',title:'Pet Adoption Conditions in Jordan',body:'No dedicated adoption law yet, but organizations regulate adoption through internal rules including adopter screening, signed agreements, and follow-up checks.',source:'JAWS Jordan',updated:'2024-03-01'},
          {id:4,cat:'protection',catLabel:'🛡 Animal Protection',title:'Animal Welfare Law — Article 24',body:'Jordanian law criminalizes animal abuse and harm without legal justification. Penalties range from fines to imprisonment depending on severity.',source:'Jordanian Legislation Bureau',updated:'2023-11-10'},
          {id:5,cat:'vaccination',catLabel:'💉 Vaccinations',title:'Mandatory Vaccinations for Dogs and Cats',body:'Dogs must be vaccinated against rabies annually. Additional vaccinations recommended. Non-compliance may result in administrative penalties.',source:'Ministry of Agriculture — Livestock',updated:'2024-02-28'},
          {id:6,cat:'breeding',catLabel:'🧬 Breeding & Import',title:'Licensing Pet Shops and Breeding Facilities',body:'A license from the municipality and Ministry of Agriculture is required to open a pet shop or breeding facility. Health and veterinary standards apply.',source:'Jordanian Ministry of Agriculture',updated:'2023-06-15'},
          {id:7,cat:'stray',catLabel:'🏚 Stray Animals',title:'Policy for Handling Stray Animals in Jordan',body:'Municipalities manage stray animals. Many follow a catch-treat-neuter-vaccinate-release approach. A national regulation is still under development.',source:'Greater Amman Municipality',updated:'2024-04-01'},
        ];
        let nextId=8,editingId=null,currentCategory='all';
        const catLabels={travel:'✈️ Pet Travel',adoption:'🐾 Adoption',protection:'🛡 Animal Protection',vaccination:'💉 Vaccinations',breeding:'🧬 Breeding & Import',stray:'🏚 Stray Animals'};
        function render(){
          const q=(document.getElementById('searchInput')?.value||'').toLowerCase();
          const filtered=laws.filter(l=>{
            const mCat=currentCategory==='all'||l.cat===currentCategory;
            const mQ=!q||l.title.toLowerCase().includes(q)||l.body.toLowerCase().includes(q);
            return mCat&&mQ;
          });
          document.getElementById('lawCount').textContent=filtered.length+' laws';
          document.getElementById('kpiTotal').textContent=laws.length;
          document.getElementById('tabAll').textContent=laws.length;
          const container=document.getElementById('lawsContainer');
          container.innerHTML=filtered.length?filtered.map(l=>`
            <div class="law-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:8px;">
                <div><div class="law-title">${l.title}</div><span class="badge badge-info" style="font-size:.72rem;">${l.catLabel}</span></div>
                <div class="action-group" style="flex-shrink:0;">
                  <button class="btn btn-outline btn-xs" onclick="openEdit(${l.id})">✏️ Edit</button>
                  <button class="btn btn-danger btn-xs" onclick="deleteLaw(${l.id})">🗑 Delete</button>
                </div>
              </div>
              <div class="law-body">${l.body}</div>
              <div class="law-meta"><span>🔄 Updated: <strong>${l.updated}</strong></span><span>📚 ${l.source}</span></div>
            </div>`).join(''):`<div style="text-align:center;padding:40px;color:var(--text-muted);">No laws found in this category.</div>

        <div class="modal-overlay" id="distributeModal" onclick="if(event.target===this)closeModal('distributeModal')">
          <div class="modal-box" style="max-width:440px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:0 24px 60px rgba(38,31,23,.25);overflow:hidden;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.5);">
              <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--brand-dark);">&#x1F4E6; Distribute Donation</div>
              <button class="dp-close" onclick="closeModal('distributeModal')">&#x2715;</button>
            </div>
            <div style="padding:20px;">
              <div id="dDistInfo" style="background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r);padding:12px;margin-bottom:14px;font-size:.85rem;font-weight:800;color:var(--text);"></div>
              <div class="field" style="margin-bottom:12px;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Distributed To</label><input id="dDistTarget" placeholder="e.g. Al Amanah Clinic, Zarqa shelter..." style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
              <div class="field"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Note</label><textarea id="dDistNote" style="width:100%;min-height:70px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:12px 14px;font-weight:700;font-size:.86rem;outline:none;font-family:'Nunito',sans-serif;resize:vertical;" placeholder="Add a distribution note..."></textarea></div>
            </div>
            <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;background:rgba(255,255,255,.5);">
              <button class="btn btn-success" onclick="confirmDistribute()">&#x2705; Mark as Distributed</button>
              <button class="btn btn-outline" onclick="closeModal('distributeModal')">Cancel</button>
            </div>
          </div>
        </div>

        <div class="modal-overlay" id="animalModal" onclick="if(event.target===this)closeModal('animalModal')">
          <div class="modal-box" style="max-width:520px;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-lg);box-shadow:0 24px 60px rgba(38,31,23,.25);overflow:hidden;display:flex;flex-direction:column;max-height:92vh;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.5);flex-shrink:0;">
              <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;font-weight:700;color:var(--brand-dark);" id="animalModalTitle">&#x1F43E; Add Donation Animal</div>
              <button class="dp-close" onclick="closeModal('animalModal')">&#x2715;</button>
            </div>
            <div style="padding:20px;overflow-y:auto;">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="field" style="grid-column:1/-1;margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Animal Name *</label><input id="afName" placeholder="e.g. Rex" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Type *</label><select id="afType" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option value="">Select type</option><option value="dog">&#x1F415; Dog</option><option value="cat">&#x1F408; Cat</option><option value="bird">&#x1F426; Bird</option><option value="other">&#x1F43E; Other</option></select></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Condition</label><select id="afCondition" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option>Injured</option><option>Sick</option><option>Stray — Needs Care</option><option>Post-Surgery</option><option>Malnourished</option><option>Healthy — General Support</option></select></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Location</label><input id="afLocation" placeholder="e.g. Amman Shelter" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Target Amount (JOD) *</label><input id="afGoal" type="number" min="1" placeholder="e.g. 150" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Collected So Far (JOD)</label><input id="afCollected" type="number" min="0" placeholder="0" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"></div>
                <div class="field" style="grid-column:1/-1;margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Story / Description *</label><textarea id="afStory" style="width:100%;min-height:90px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:12px 14px;font-weight:700;font-size:.86rem;outline:none;font-family:'Nunito',sans-serif;resize:vertical;" placeholder="Explain the animal situation..."></textarea></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Status</label><select id="afStatus" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option value="active">Active — Visible to Users</option><option value="paused">Paused — Hidden</option></select></div>
                <div class="field" style="margin-bottom:0;"><label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Urgency</label><select id="afUrgency" style="width:100%;min-height:44px;border:1.5px solid var(--border);border-radius:12px;background:#fff;padding:0 14px;font-weight:700;font-size:.86rem;outline:none;"><option value="normal">Normal</option><option value="urgent">&#x1F534; Urgent</option></select></div>
              </div>
            </div>
            <div style="padding:14px 20px;border-top:1px solid var(--border);display:flex;gap:8px;background:rgba(255,255,255,.5);flex-shrink:0;">
              <button class="btn btn-primary" onclick="saveAnimal()">&#x1F4BE; Save</button>
              <button class="btn btn-outline" onclick="closeModal('animalModal')">Cancel</button>
            </div>
          </div>
        </div>

        <div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:#fff;padding:11px 22px;border-radius:var(--pill);font-weight:800;font-size:.85rem;z-index:1999;display:none;align-items:center;gap:6px;box-shadow:0 8px 22px rgba(89,101,42,.3);white-space:nowrap;"></div>

        <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        setPageInfo('Donations','Super Admin Panel','Reports','Donations');
        const donations=[
          {ref:'DON-001',donor:'Sara M.',type:'money',typeLabel:'&#x1F4B5; Money',amount:'25 JOD',animalId:2,target:'Rex — Injured Dog',date:'Mar 13, 2026',status:'distributed'},
          {ref:'DON-002',donor:'Ahmad A.',type:'food',typeLabel:'&#x1F356; Food',amount:'5 Food Bags',animalId:null,target:'General Shelter',date:'Mar 12, 2026',status:'received'},
          {ref:'DON-003',donor:'Lama H.',type:'money',typeLabel:'&#x1F4B5; Money',amount:'10 JOD',animalId:1,target:'Luna — Cat',date:'Mar 11, 2026',status:'processing'},
          {ref:'DON-004',donor:'Anonymous',type:'medicine',typeLabel:'&#x1F48A; Medicine',amount:'Various Medicines',animalId:null,target:'General',date:'Mar 10, 2026',status:'received'},
          {ref:'DON-005',donor:'Rania S.',type:'supplies',typeLabel:'&#x1F4E6; Supplies',amount:'Blankets x 10',animalId:null,target:'Stray Shelter — Irbid',date:'Mar 9, 2026',status:'distributed'},
          {ref:'DON-006',donor:'Karim N.',type:'money',typeLabel:'&#x1F4B5; Money',amount:'50 JOD',animalId:3,target:'Bobby — Lost Dog Fund',date:'Mar 8, 2026',status:'processing'},
        ];
        let animals=[
          {id:1,name:'Luna',type:'cat',emoji:'&#x1F408;',condition:'Sick',location:'Amman Shelter',goal:120,collected:85,story:'Luna was found with a respiratory infection. She needs medicine and care for 3 weeks.',status:'active',urgency:'urgent'},
          {id:2,name:'Rex',type:'dog',emoji:'&#x1F415;',condition:'Injured',location:'Zarqa Clinic',goal:200,collected:25,story:'Rex was hit by a car and needs surgery on his right leg. Your donation helps him walk again.',status:'active',urgency:'urgent'},
          {id:3,name:'Bobby',type:'dog',emoji:'&#x1F415;',condition:'Malnourished',location:'Irbid Shelter',goal:80,collected:50,story:'Bobby was found starving on the streets. He needs food and basic care for one month.',status:'active',urgency:'normal'},
          {id:4,name:'Tweety',type:'bird',emoji:'&#x1F426;',condition:'Post-Surgery',location:'Amman Vet Center',goal:60,collected:60,story:'Tweety completed surgery for a broken wing. Donations helped cover the full cost!',status:'completed',urgency:'normal'},
          {id:5,name:'Mimi',type:'cat',emoji:'&#x1F408;',condition:'Stray — Needs Care',location:'Amman Shelter',goal:50,collected:10,story:'Mimi is a stray kitten that needs vaccination, food, and a safe place to stay.',status:'active',urgency:'normal'},
          {id:6,name:'Nemo',type:'other',emoji:'&#x1F41F;',condition:'Healthy — General Support',location:'Zarqa Aquarium',goal:100,collected:0,story:'Nemo is an injured sea turtle rescued from the coast. Needs specialized care.',status:'paused',urgency:'normal'},
        ];
        let nextAnimalId=7,editingAnimalId=null,selectedRef=null;
        function switchTab(btn,tab){document.querySelectorAll('.tabs-bar .tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.getElementById('pane-donations').style.display=tab==='donations'?'block':'none';document.getElementById('pane-animals').style.display=tab==='animals'?'block':'none';if(tab==='animals')renderAnimals();}
        const statusBadge=s=>{const m={received:'badge-info',processing:'badge-warning',distributed:'badge-success'};const l={received:'&#x1F4E5; Received',processing:'&#x23F3; Processing',distributed:'&#x2705; Distributed'};return`<span class="badge ${m[s]||'badge-muted'}">${l[s]||s}</span>`;};
        const typeIco=t=>({money:'&#x1F4B5;',food:'&#x1F356;',medicine:'&#x1F48A;',supplies:'&#x1F4E6;'})[t]||'&#x2764;&#xFE0F;';
        function renderDonations(){
          const q=(document.getElementById('searchInput')?.value||'').toLowerCase();
          const type=document.getElementById('typeFilter')?.value||'';
          const status=document.getElementById('statusFilter')?.value||'';
          const filtered=donations.filter(d=>{const mQ=!q||d.donor.toLowerCase().includes(q)||d.ref.toLowerCase().includes(q)||d.target.toLowerCase().includes(q);const mT=!type||d.type===type;const mSt=!status||d.status===status;return mQ&&mT&&mSt;});
          const tbody=document.getElementById('tableBody');
          tbody.innerHTML=filtered.length?filtered.map(d=>{
            const animal=d.animalId?animals.find(a=>a.id===d.animalId):null;
            const targetCell=animal?`<div style="display:flex;align-items:center;gap:6px;"><span>${animal.emoji}</span><div><div style="font-weight:800;font-size:.84rem;">${animal.name}</div><div style="font-size:.72rem;color:var(--text-muted);">${animal.condition}</div></div></div>`:`<span class="badge badge-muted">&#x1F30D; General</span>`;
            return`<tr><td style="font-size:.78rem;color:var(--text-muted);font-weight:800;">${d.ref}</td><td><div style="display:flex;align-items:center;gap:9px;"><div class="don-ico">${typeIco(d.type)}</div><div style="font-weight:900;color:var(--brand-dark);">${d.donor}</div></div></td><td>${d.typeLabel}</td><td style="font-weight:900;color:var(--brand-dark);">${d.amount}</td><td>${targetCell}</td><td style="font-size:.8rem;color:var(--text-muted);">${d.date}</td><td>${statusBadge(d.status)}</td><td>${d.status!=='distributed'?`<button class="btn btn-success btn-xs" onclick="openDistribute('${d.ref}')">&#x1F4E6; Distribute</button>`:`<span style="font-size:.78rem;color:var(--text-muted);font-weight:800;">Done &#x2713;</span>`}</td></tr>`;
          }).join(''):`<tr><td colspan="8" style="text-align:center;padding:28px;color:var(--text-muted);">No donations found.</td></tr>`;
          document.getElementById('tableCount').textContent=filtered.length+' donations';
          document.getElementById('kpiPending').textContent=donations.filter(d=>d.status!=='distributed').length;
          document.getElementById('kpiDistributed').textContent=donations.filter(d=>d.status==='distributed').length;
        }
        function renderAnimals(){
          const q=(document.getElementById('animalSearch')?.value||'').toLowerCase();
          const type=document.getElementById('animalTypeFilter')?.value||'';
          const status=document.getElementById('animalStatusFilter')?.value||'';
          const filtered=animals.filter(a=>{const mQ=!q||a.name.toLowerCase().includes(q)||a.condition.toLowerCase().includes(q)||a.location.toLowerCase().includes(q);const mT=!type||a.type===type;const mSt=!status||a.status===status;return mQ&&mT&&mSt;});
          document.getElementById('tabAnimalsCount').textContent=animals.filter(a=>a.status==='active').length+' active';
          const grid=document.getElementById('animalsGrid');
          if(!filtered.length){grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:32px;color:var(--text-muted);">No animals found.</div>`;return;}
          grid.innerHTML=filtered.map(a=>{
            const pct=Math.min(100,Math.round((a.collected/a.goal)*100));
            const remaining=Math.max(0,a.goal-a.collected);
            const stBadge=a.status==='active'?`<span class="badge badge-success">&#x2705; Active</span>`:a.status==='paused'?`<span class="badge badge-warning">&#x23F8; Paused</span>`:`<span class="badge badge-info">&#x1F389; Completed</span>`;
            const urgBadge=a.urgency==='urgent'?`<span class="badge badge-danger" style="font-size:.66rem;">&#x1F534; Urgent</span>`:'';
            const donCount=donations.filter(d=>d.animalId===a.id).length;
            return`<div class="animal-card ${a.status==='paused'?'paused':''}"><div class="animal-ava">${a.emoji}</div><div style="flex:1;min-width:0;"><div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:2px;"><div class="animal-name">${a.name}</div>${urgBadge}</div><div class="animal-meta">&#x1F4CD; ${a.location} &middot; ${a.condition}</div><div style="font-size:.72rem;color:var(--text-muted);font-weight:700;margin-top:2px;">&#x2764;&#xFE0F; ${donCount} donation${donCount!==1?'s':''} received</div><div class="prog-wrap"><div class="prog-fill" style="width:${pct}%"></div></div><div style="display:flex;justify-content:space-between;font-size:.72rem;font-weight:800;"><span style="color:var(--brand-dark);">${a.collected} / ${a.goal} JOD</span><span style="color:var(--text-muted);">${pct}%${remaining>0?' &middot; '+remaining+' JOD left':' &middot; Goal reached!'}</span></div><div style="display:flex;align-items:center;justify-content:space-between;margin-top:10px;gap:6px;flex-wrap:wrap;"><div>${stBadge}</div><div class="action-group"><button class="btn btn-outline btn-xs" onclick="openEditAnimal(${a.id})">&#x270F;&#xFE0F; Edit</button>${a.status==='active'?`<button class="btn btn-warning btn-xs" onclick="toggleAnimalStatus(${a.id})">&#x23F8; Pause</button>`:a.status==='paused'?`<button class="btn btn-success btn-xs" onclick="toggleAnimalStatus(${a.id})">&#x25B6; Activate</button>`:''}<button class="btn btn-danger btn-xs" onclick="deleteAnimal(${a.id})">&#x1F5D1;</button></div></div></div></div>`;
          }).join('');
        }
        function openAnimalModal(){editingAnimalId=null;document.getElementById('animalModalTitle').textContent='Add Donation Animal';['afName','afLocation','afStory'].forEach(id=>document.getElementById(id).value='');document.getElementById('afType').value='';document.getElementById('afGoal').value='';document.getElementById('afCollected').value='0';document.getElementById('afStatus').value='active';document.getElementById('afUrgency').value='normal';document.getElementById('afCondition').selectedIndex=0;openModal('animalModal');}
        function openEditAnimal(id){const a=animals.find(x=>x.id===id);if(!a)return;editingAnimalId=id;document.getElementById('animalModalTitle').textContent='Edit — '+a.name;document.getElementById('afName').value=a.name;document.getElementById('afType').value=a.type;document.getElementById('afCondition').value=a.condition;document.getElementById('afLocation').value=a.location;document.getElementById('afGoal').value=a.goal;document.getElementById('afCollected').value=a.collected;document.getElementById('afStory').value=a.story;document.getElementById('afStatus').value=a.status;document.getElementById('afUrgency').value=a.urgency;openModal('animalModal');}
        function saveAnimal(){
          const name=document.getElementById('afName').value.trim(),type=document.getElementById('afType').value,goal=parseFloat(document.getElementById('afGoal').value),story=document.getElementById('afStory').value.trim();
          if(!name){showToast('Name is required');return;}if(!type){showToast('Type is required');return;}if(!goal||goal<1){showToast('Enter a valid goal amount');return;}if(!story){showToast('Story is required');return;}
          const emojiMap={dog:'&#x1F415;',cat:'&#x1F408;',bird:'&#x1F426;',other:'&#x1F43E;'};
          const obj={name,type,emoji:emojiMap[type]||'&#x1F43E;',condition:document.getElementById('afCondition').value,location:document.getElementById('afLocation').value.trim()||'—',goal,collected:parseFloat(document.getElementById('afCollected').value)||0,story,status:document.getElementById('afStatus').value,urgency:document.getElementById('afUrgency').value};
          if(editingAnimalId){Object.assign(animals.find(x=>x.id===editingAnimalId),obj);showToast(name+' updated!');}
          else{animals.push({id:nextAnimalId++,...obj});showToast(name+' added!');}
          closeModal('animalModal');renderAnimals();
        }
        function toggleAnimalStatus(id){const a=animals.find(x=>x.id===id);if(!a)return;a.status=a.status==='active'?'paused':'active';renderAnimals();showToast(a.status==='active'?a.name+' is now active.':a.name+' paused.');}
        function deleteAnimal(id){const a=animals.find(x=>x.id===id);if(!a||!confirm('Remove "'+a.name+'" from donation animals?'))return;animals=animals.filter(x=>x.id!==id);renderAnimals();showToast(a.name+' removed.');}
        function openDistribute(ref){const d=donations.find(x=>x.ref===ref);if(!d)return;selectedRef=ref;document.getElementById('dDistInfo').innerHTML='<strong>'+d.ref+'</strong> — '+d.donor+' &middot; '+d.typeLabel+' &middot; <strong>'+d.amount+'</strong>';document.getElementById('dDistTarget').value=d.target;document.getElementById('dDistNote').value='';openModal('distributeModal');}
        function confirmDistribute(){const d=donations.find(x=>x.ref===selectedRef);if(!d)return;d.status='distributed';closeModal('distributeModal');renderDonations();showToast(d.ref+' marked as distributed!');}
        function resetFilters(){document.getElementById('searchInput').value='';['typeFilter','statusFilter'].forEach(id=>document.getElementById(id).selectedIndex=0);renderDonations();}
        function openModal(id){document.getElementById(id).classList.add('open');}
        function closeModal(id){document.getElementById(id).classList.remove('open');}
        function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='flex';setTimeout(()=>t.style.display='none',3000);}
        renderDonations();
        document.getElementById('tabAnimalsCount').textContent=animals.filter(a=>a.status==='active').length+' active';
    </script>
</body>
</html>