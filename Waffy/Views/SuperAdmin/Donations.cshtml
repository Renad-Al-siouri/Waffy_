@using Waffy.Models
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Waffy — Super Admin | Donations";
    ViewData["ActiveSection"] = "reports";
    ViewData["ActivePage"] = "donations";
    ViewData["PageTitle"] = "Donations";
    ViewData["BreadcrumbParent"] = "Reports";
    ViewData["BreadcrumbCurrent"] = "Donations";
    var donations = ViewBag.Donations as List<Donation> ?? new List<Donation>();
    var animals = ViewBag.Animals as List<DonationAnimal> ?? new List<DonationAnimal>();
    var totalDon = (int)(ViewBag.TotalDonations ?? 0);
    var pendingDon = (int)(ViewBag.PendingDonations ?? 0);
    var completedDon = (int)(ViewBag.CompletedDonations ?? 0);
    var activeAnimals = (int)(ViewBag.ActiveAnimals ?? 0);
}

@section PageStyles {
    <style>
        .don-ico {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--brand-xlight);
            border: 1px solid var(--brand-light);
            display: grid;
            place-items: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .animal-card-da {
            background: #fff;
            border: 1.5px solid var(--border);
            border-radius: var(--r-lg);
            padding: 16px 18px;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            transition: .2s ease;
            position: relative;
        }

            .animal-card-da:hover {
                box-shadow: var(--shadow);
                transform: translateY(-1px);
            }

        .animal-ava {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            background: var(--brand-xlight);
            border: 1px solid var(--brand-light);
            display: grid;
            place-items: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .animal-name {
            font-family: 'Fredoka',sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .animal-meta {
            font-size: .76rem;
            color: var(--text-muted);
            font-weight: 700;
            margin-top: 2px;
        }

        .prog-wrap {
            height: 7px;
            background: var(--border);
            border-radius: 999px;
            overflow: hidden;
            margin: 8px 0 4px;
        }

        .prog-fill {
            height: 100%;
            border-radius: 999px;
            background: linear-gradient(90deg,var(--brand),var(--brand-dark));
        }

        .animals-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(290px,1fr));
            gap: 12px;
        }

        .add-form-card {
            background: #fff;
            border: 1.5px solid var(--brand-light);
            border-radius: var(--r-lg);
            padding: 20px;
            margin-bottom: 16px;
        }

        .add-form-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 16px;
        }

        .add-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

            .add-form-grid .full {
                grid-column: 1/-1;
            }

            .add-form-grid label {
                display: flex;
                flex-direction: column;
                gap: 5px;
                font-size: .8rem;
                font-weight: 900;
                color: var(--brand-dark);
            }

            .add-form-grid input,
            .add-form-grid select,
            .add-form-grid textarea {
                min-height: 44px;
                border: 1.5px solid var(--border);
                border-radius: 12px;
                background: #fff;
                padding: 0 14px;
                font-weight: 700;
                font-size: .86rem;
                outline: none;
                font-family: 'Nunito',sans-serif;
            }

            .add-form-grid textarea {
                padding: 11px 14px;
                min-height: 90px;
                resize: vertical;
            }

                .add-form-grid input:focus,
                .add-form-grid select:focus,
                .add-form-grid textarea:focus {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(151,173,77,0.12);
                }
    </style>
}

<main class="wa-main" id="waMain">
    <section class="page-hero">
        <div>
            <h1>❤️ Donations</h1>
            <p>Track incoming donations and manage the animals available for targeted donations.</p>
        </div>
    </section>

    <div class="page-body">

        @* رسائل النجاح والخطأ *@
        @if (ViewBag.Success != null)
        {
            <div style="background:var(--success-soft);border:1px solid rgba(47,158,95,.25);
                                    color:#2e7d32;padding:12px 16px;border-radius:14px;
                                    font-weight:800;font-size:.86rem;margin-bottom:16px;">
                @ViewBag.Success
            </div>
        }
        @if (ViewBag.Error != null)
        {
            <div style="background:var(--danger-soft);border:1px solid rgba(217,83,79,.25);
                                    color:var(--danger);padding:12px 16px;border-radius:14px;
                                    font-weight:800;font-size:.86rem;margin-bottom:16px;">
                @ViewBag.Error
            </div>
        }

        @* KPI — بيانات حقيقية *@
        <div class="kpi-grid kpi-grid-4" style="margin-bottom:20px;">
            <div class="kpi-card c1">
                <div class="kpi-ico green">💰</div>
                <div class="kpi-val">@totalDon</div>
                <div class="kpi-label">Total Donations</div>
            </div>
            <div class="kpi-card c2">
                <div class="kpi-ico blue">✅</div>
                <div class="kpi-val">@completedDon</div>
                <div class="kpi-label">Completed</div>
                <div class="kpi-chip chip-green">Done</div>
            </div>
            <div class="kpi-card c3">
                <div class="kpi-ico yellow">⏳</div>
                <div class="kpi-val">@pendingDon</div>
                <div class="kpi-label">Pending</div>
                @if (pendingDon > 0)
                {
                    <div class="kpi-chip chip-yellow">Needs action</div>
                }
            </div>
            <div class="kpi-card c1">
                <div class="kpi-ico green">🐾</div>
                <div class="kpi-val">@activeAnimals</div>
                <div class="kpi-label">Active Animals</div>
                <div class="kpi-chip chip-green">Visible to users</div>
            </div>
        </div>

        @* Tabs *@
        <div class="tabs-bar" style="margin-bottom:20px;">
            <button class="tab-btn active" type="button" onclick="switchTab(this,'donations')">
                💵 Donations Log
            </button>
            <button class="tab-btn" type="button" onclick="switchTab(this,'animals')">
                🐾 Donation Animals
                <span class="tab-count">@activeAnimals active</span>
            </button>
        </div>

        @* ══ TAB: Donations Log ══ *@
        <div id="pane-donations">
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
                <div class="search-wrap" style="flex:1 1 200px;">
                    <span style="color:var(--text-muted);">🔍</span>
                    <input id="searchInput" placeholder="Search by reference or donor..." oninput="filterDonations()" />
                </div>
                <select class="sel-wrap" id="typeFilter" onchange="filterDonations()" style="height:48px;min-width:130px;">
                    <option value="">All Types</option>
                    <option value="money">💵 Money</option>
                    <option value="food">🍖 Food</option>
                    <option value="medicine">💊 Medicine</option>
                    <option value="supplies">📦 Supplies</option>
                </select>
                <select class="sel-wrap" id="statusFilter" onchange="filterDonations()" style="height:48px;min-width:130px;">
                    <option value="">All Statuses</option>
                    <option value="pending">Pending</option>
                    <option value="completed">Completed</option>
                </select>
                <button class="btn btn-outline btn-sm" onclick="resetDonationFilters()">Reset</button>
            </div>

            <div class="table-card">
                <div class="table-head-bar">
                    <div class="table-head-title">Donations List</div>
                    <span class="table-count" id="donationCount">@totalDon donations</span>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Ref</th>
                                <th>Donor</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Target</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!donations.Any())
                            {
                                <tr>
                                    <td colspan="8" style="text-align:center;padding:28px;color:var(--text-muted);">
                                        No donations yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var d in donations)
                                {
                                    var typeIcon = d.DonationType switch
                                    {
                                        "Money" => "💵",
                                        "Food" => "🍖",
                                        "Medicine" => "💊",
                                        "Supplies" => "📦",
                                        _ => "❤️"
                                    };
                                    var stBadge = d.Status == "Completed"
                                    ? "badge-success" : "badge-warning";
                                    var amountDisplay = d.DonationType == "Money"
                                    ? $"{d.Amount:F2} JOD"
                                    : $"{d.Quantity} {d.Unit}";

                                    <tr data-ref="@d.ReferenceCode?.ToLower()"
                                        data-donor="@((d.DonorName ?? $"User #{d.IdUser}").ToLower())"
                                        data-type="@d.DonationType?.ToLower()"
                                        data-status="@d.Status?.ToLower()">
                                        <td style="font-size:.78rem;color:var(--text-muted);font-weight:800;">
                                            @d.ReferenceCode
                                        </td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:9px;">
                                                <div class="don-ico">@typeIcon</div>
                                                <div style="font-weight:900;color:var(--brand-dark);">
                                                    @(d.DonorName ?? $"User #{d.IdUser}")
                                                </div>
                                            </div>
                                        </td>
                                        <td>@typeIcon @d.DonationType</td>
                                        <td style="font-weight:900;color:var(--brand-dark);">
                                            @amountDisplay
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(d.TargetType) || d.TargetType == "General")
                                            {
                                                <span class="badge badge-muted">🌍 General</span>
                                            }
                                            else
                                            {
                                                <span style="font-weight:800;font-size:.84rem;">
                                                    @if (d.TargetType == "Animal")
                                                    {
                                                        <span>🐾 @(d.AnimalName ?? "Animal")</span>
                                                    }
                                                    else if (d.TargetType == "General")
                                                    {
                                                        <span>🌍 General Support</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@d.TargetType</span>
                                                    }
                                                </span>
                                            }
                                        </td>
                                        <td style="font-size:.8rem;color:var(--text-muted);">
                                            @d.CreatedAt?.ToString("MMM dd, yyyy")
                                        </td>
                                        <td>
                                            <span class="badge @stBadge">@d.Status</span>
                                        </td>
                                        <td>
                                            @if (d.Status != "Completed")
                                            {
                                                <form method="post"
                                                      asp-controller="SuperAdmin"
                                                      asp-action="UpdateDonationStatus"
                                                      style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="donationId" value="@d.Id" />
                                                    <input type="hidden" name="status" value="Completed" />
                                                    <button type="submit" class="btn btn-success btn-xs">
                                                        📦 Mark Done
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span style="font-size:.78rem;color:var(--text-muted);font-weight:800;">
                                                    Done ✓
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* ══ TAB: Donation Animals ══ *@
        <div id="pane-animals" style="display:none;">

            @* Filters + Add Button *@
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:stretch;">
                <div class="search-wrap" style="flex:1 1 200px;">
                    <span style="color:var(--text-muted);">🔍</span>
                    <input id="animalSearch" placeholder="Search animal name..." oninput="filterAnimals()" />
                </div>
                <select class="sel-wrap" id="animalTypeFilter" onchange="filterAnimals()" style="height:48px;min-width:130px;">
                    <option value="">All Types</option>
                    <option value="dog">🐕 Dogs</option>
                    <option value="cat">🐈 Cats</option>
                    <option value="bird">🐦 Birds</option>
                    <option value="other">🐾 Others</option>
                </select>
                <select class="sel-wrap" id="animalStatusFilter" onchange="filterAnimals()" style="height:48px;min-width:130px;">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="paused">Paused</option>
                    <option value="completed">Completed</option>
                </select>
                <button class="btn btn-outline btn-sm" onclick="resetAnimalFilters()">Reset</button>
                <button class="btn btn-primary btn-sm" type="button" onclick="toggleAddForm()">
                    ＋ Add Animal
                </button>
            </div>

            @* ✅ فورم إضافة حيوان — مخفي بالبداية *@
            <div id="addAnimalSection" style="display:none;margin-bottom:16px;">
                <div class="add-form-card">
                    <div class="add-form-title">🐾 Add Donation Animal</div>
                    <form method="post"
                          asp-controller="SuperAdmin"
                          asp-action="AddDonationAnimal">
                        @Html.AntiForgeryToken()
                        <div class="add-form-grid">
                            <label class="full">
                                Animal Name *
                                <input type="text" name="name" placeholder="e.g. Rex" required />
                            </label>
                            <label>
                                Type *
                                <select name="animalType" required>
                                    <option value="">Select type</option>
                                    <option value="Dog">🐕 Dog</option>
                                    <option value="Cat">🐈 Cat</option>
                                    <option value="Bird">🐦 Bird</option>
                                    <option value="Other">🐾 Other</option>
                                </select>
                            </label>
                            <label>
                                Condition
                                <select name="condition">
                                    <option>Injured</option>
                                    <option>Sick</option>
                                    <option>Stray — Needs Care</option>
                                    <option>Post-Surgery</option>
                                    <option>Malnourished</option>
                                    <option>Healthy — General Support</option>
                                </select>
                            </label>
                            <label>
                                Location
                                <input type="text" name="location" placeholder="e.g. Amman Shelter" />
                            </label>
                            <label>
                                Goal Amount (JOD)
                                <input type="number" name="goalAmount" min="1" placeholder="e.g. 150" />
                            </label>
                            <label class="full">
                                Story / Description *
                                <textarea name="story" placeholder="Explain why this animal needs donations..." required></textarea>
                            </label>
                        </div>
                        <div style="display:flex;gap:8px;margin-top:16px;">
                            <button type="submit" class="btn btn-primary btn-sm">💾 Save Animal</button>
                            <button type="button" class="btn btn-outline btn-sm" onclick="toggleAddForm()">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            @* Animals Grid — Razor rendered *@
            <div class="table-card">
                <div class="table-head-bar">
                    <div class="table-head-title">🐾 Animals Available for Donation</div>
                    <span style="font-size:.78rem;font-weight:700;color:var(--text-muted);">
                        These appear in the user-facing donation screen
                    </span>
                </div>
                <div style="padding:16px;">
                    @if (!animals.Any())
                    {
                        <div style="text-align:center;padding:40px;color:var(--text-muted);">
                            <div style="font-size:2.5rem;margin-bottom:12px;">🐾</div>
                            <p style="font-weight:800;">No animals added yet. Click "+ Add Animal" to get started.</p>
                        </div>
                    }
                    else
                    {
                        <div class="animals-grid" id="animalsGrid">
                            @foreach (var a in animals)
                            {
                                var animalEmoji = a.AnimalType?.ToLower() switch
                                {
                                    "dog" => "🐕",
                                    "cat" => "🐈",
                                    "bird" => "🐦",
                                    _ => "🐾"
                                };
                                var pct = (a.GoalAmount.HasValue && a.GoalAmount > 0)
                                ? (int)Math.Min(100, Math.Round(a.CollectedAmount / a.GoalAmount.Value * 100))
                                : 0;
                                var remaining = a.GoalAmount.HasValue
                                ? Math.Max(0, a.GoalAmount.Value - a.CollectedAmount)
                                : 0;
                                var stBadge = a.Status switch
                                {
                                    "Active" => "badge-success",
                                    "Paused" => "badge-warning",
                                    "Completed" => "badge-info",
                                    _ => "badge-muted"
                                };
                                var stLabel = a.Status switch
                                {
                                    "Active" => "✅ Active",
                                    "Paused" => "⏸ Paused",
                                    "Completed" => "🎉 Completed",
                                    _ => a.Status
                                };

                                <div class="animal-card-da @(a.Status == "Paused" ? "paused" : "")"
                                     data-name="@a.Name?.ToLower()"
                                     data-type="@a.AnimalType?.ToLower()"
                                     data-status="@a.Status?.ToLower()">

                                    <div class="animal-ava">@animalEmoji</div>

                                    <div style="flex:1;min-width:0;">
                                        <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:2px;">
                                            <div class="animal-name">@a.Name</div>
                                        </div>
                                        <div class="animal-meta">
                                            📍 @(a.Location ?? "—") · @a.Condition
                                        </div>
                                        <div style="font-size:.72rem;color:var(--text-muted);font-weight:700;
                                                                        margin-top:4px;margin-bottom:4px;line-height:1.4;">
                                            @(a.Story?.Length > 80 ? a.Story[..80] + "…" : a.Story)
                                        </div>

                                        @if (a.GoalAmount.HasValue)
                                        {
                                            <div class="prog-wrap">
                                                <div class="prog-fill" style="width:@pct%"></div>
                                            </div>
                                            <div style="display:flex;justify-content:space-between;font-size:.72rem;font-weight:800;">
                                                <span style="color:var(--brand-dark);">
                                                    @a.CollectedAmount.ToString("F0") / @a.GoalAmount.Value.ToString("F0") JOD
                                                </span>
                                                <span style="color:var(--text-muted);">
                                                    @pct% @(remaining > 0 ? $"· {remaining:F0} JOD left" : "· Goal reached!")
                                                </span>
                                            </div>
                                        }

                                        <div style="display:flex;align-items:center;justify-content:space-between;
                                                                        margin-top:10px;gap:6px;flex-wrap:wrap;">
                                            <span class="badge @stBadge">@stLabel</span>

                                            <div class="action-group">
                                                @if (a.Status == "Active")
                                                {
                                                    <form method="post"
                                                          asp-controller="SuperAdmin"
                                                          asp-action="UpdateDonationAnimalStatus"
                                                          style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="animalId" value="@a.Id" />
                                                        <input type="hidden" name="status" value="Paused" />
                                                        <button type="submit" class="btn btn-warning btn-xs">⏸ Pause</button>
                                                    </form>
                                                }
                                                else if (a.Status == "Paused")
                                                {
                                                    <form method="post"
                                                          asp-controller="SuperAdmin"
                                                          asp-action="UpdateDonationAnimalStatus"
                                                          style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="animalId" value="@a.Id" />
                                                        <input type="hidden" name="status" value="Active" />
                                                        <button type="submit" class="btn btn-success btn-xs">▶ Activate</button>
                                                    </form>
                                                }
                                                @if (a.Status != "Completed")
                                                {
                                                    <form method="post"
                                                          asp-controller="SuperAdmin"
                                                          asp-action="UpdateDonationAnimalStatus"
                                                          style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="animalId" value="@a.Id" />
                                                        <input type="hidden" name="status" value="Completed" />
                                                        <button type="submit" class="btn btn-info btn-xs">🎉 Complete</button>
                                                    </form>
                                                }
                                                <form method="post"
                                                      asp-controller="SuperAdmin"
                                                      asp-action="DeleteDonationAnimal"
                                                      style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="animalId" value="@a.Id" />
                                                    <button type="submit" class="btn btn-danger btn-xs"
                                                            onclick="return confirm('Remove @a.Name from donation animals?')">
                                                        🗑
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</main>

</div>

<div id="toast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
     background:linear-gradient(135deg,var(--brand),var(--brand-dark));color:#fff;
     padding:11px 22px;border-radius:var(--pill);font-weight:800;font-size:.85rem;
     z-index:1999;display:none;align-items:center;gap:6px;
     box-shadow:0 8px 22px rgba(89,101,42,.3);white-space:nowrap;"></div>


@section PageScripts {
    <script>
        // ✅ setPageInfo صحيح
        setPageInfo('Donations', 'Super Admin Panel', 'Reports', 'Donations');

        // ══ Tab Switching ══
        function switchTab(btn, tab) {
            document.querySelectorAll('.tabs-bar .tab-btn').forEach(function(b) {
                b.classList.remove('active');
            });
            btn.classList.add('active');
            document.getElementById('pane-donations').style.display = tab === 'donations' ? 'block' : 'none';
            document.getElementById('pane-animals').style.display   = tab === 'animals'   ? 'block' : 'none';
        }

        // ══ Add Animal Form Toggle ══
        function toggleAddForm() {
            var f = document.getElementById('addAnimalSection');
            f.style.display = f.style.display === 'none' ? 'block' : 'none';
        }

        // ══ Donations Filter (JS ثانوي — فلترة مرئية فقط) ══
        function filterDonations() {
            var q      = (document.getElementById('searchInput')?.value || '').toLowerCase();
            var type   = (document.getElementById('typeFilter')?.value   || '').toLowerCase();
            var status = (document.getElementById('statusFilter')?.value || '').toLowerCase();

            var rows = document.querySelectorAll('tbody tr[data-ref]');
            var visible = 0;
            rows.forEach(function(row) {
                var ref    = (row.dataset.ref    || '');
                var donor  = (row.dataset.donor  || '');
                var rType  = (row.dataset.type   || '');
                var rStat  = (row.dataset.status || '');

                var mQ = !q      || ref.includes(q)   || donor.includes(q);
                var mT = !type   || rType === type;
                var mS = !status || rStat === status;

                var show = mQ && mT && mS;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            var c = document.getElementById('donationCount');
            if (c) c.textContent = visible + ' donations';
        }

        function resetDonationFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').selectedIndex   = 0;
            document.getElementById('statusFilter').selectedIndex = 0;
            filterDonations();
        }

        // ══ Animals Filter (JS ثانوي — فلترة مرئية فقط) ══
        function filterAnimals() {
            var q      = (document.getElementById('animalSearch')?.value       || '').toLowerCase();
            var type   = (document.getElementById('animalTypeFilter')?.value   || '').toLowerCase();
            var status = (document.getElementById('animalStatusFilter')?.value || '').toLowerCase();

            var cards = document.querySelectorAll('#animalsGrid .animal-card-da');
            cards.forEach(function(card) {
                var name  = (card.dataset.name   || '');
                var aType = (card.dataset.type   || '');
                var aStat = (card.dataset.status || '');

                var mQ = !q      || name.includes(q);
                var mT = !type   || aType === type;
                var mS = !status || aStat === status;

                card.style.display = (mQ && mT && mS) ? '' : 'none';
            });
        }

        function resetAnimalFilters() {
            document.getElementById('animalSearch').value = '';
            document.getElementById('animalTypeFilter').selectedIndex   = 0;
            document.getElementById('animalStatusFilter').selectedIndex = 0;
            filterAnimals();
        }

        // ══ Escape key ══
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('addAnimalSection').style.display = 'none';
            }
        });
    </script>
}
