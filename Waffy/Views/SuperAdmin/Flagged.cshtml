@model IEnumerable<Waffy.Models.ViewModels.FlaggedPostWithReporters>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] ="Waffy — Super Admin | Flagged Posts";
    ViewData["ActiveSection"] = "adoption";
    ViewData["ActivePage"] = "flagged";
    ViewData["PageTitle"] = "Flagged Posts";
    ViewData["BreadcrumbParent"] = "Adoption";
    ViewData["BreadcrumbCurrent"] = "Flagged";
    var allReasons = new[] {
        "Selling instead of adoption",
        "Fake listing",
        "Inappropriate content",
        "Other"
    };
    var historyItems = ViewBag.HistoryItems as
        List<Waffy.Models.ViewModels.FlaggedPostWithReporters>
        ?? new List<Waffy.Models.ViewModels.FlaggedPostWithReporters>();
}

@section PageStyles {
    <style>
        .reporter-row {
            background: #fff;
            border: 1px solid rgba(220,38,38,.12);
            border-radius: 10px;
            padding: .6rem .8rem;
            margin-bottom: .4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .4rem;
        }

        .reporter-name {
            font-weight: 900;
            font-size: .84rem;
            color: var(--brand-dark);
        }

        .reporter-meta {
            font-size: .74rem;
            color: var(--text-muted);
        }

        .reporter-reason {
            font-size: .72rem;
            font-weight: 900;
            background: var(--danger-soft);
            color: var(--danger);
            padding: 2px 9px;
            border-radius: 20px;
        }

        .action-log-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0,0,0,.05);
        }

            .action-log-row:last-child {
                border-bottom: none;
            }

        .action-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 4px;
        }

        .warn-form {
            background: #fffcf3;
            border: 1px solid rgba(226,163,58,.2);
            border-radius: 14px;
            padding: 1rem;
            margin-top: .8rem;
        }

            .warn-form label {
                font-size: .78rem;
                font-weight: 900;
                color: var(--brand-dark);
                display: block;
                margin-bottom: .3rem;
            }

            .warn-form select, .warn-form textarea {
                width: 100%;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                background: #fff;
                padding: 8px 12px;
                font-weight: 700;
                font-size: .82rem;
                font-family: 'Nunito', sans-serif;
                outline: none;
                margin-bottom: .6rem;
            }

            .warn-form textarea {
                min-height: 80px;
                resize: vertical;
            }

        .section-divider {
            font-size: .75rem;
            font-weight: 900;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: .4rem 0;
            margin: .6rem 0;
            border-bottom: 1px solid var(--border);
        }

        .history-detail {
            display: none;
            padding: 14px 16px;
            background: var(--surface-2);
        }

            .history-detail.open {
                display: block;
            }

        .action-type-chip {
            font-size: .7rem;
            font-weight: 900;
            padding: 2px 9px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .chip-warned {
            background: var(--warning-soft);
            color: #9b6000;
        }

        .chip-cleared {
            background: var(--success-soft);
            color: #2e7d32;
        }

        .chip-closed {
            background: var(--danger-soft);
            color: var(--danger);
        }

        .chip-reverted {
            background: #f3f4f6;
            color: #6b7280;
        }

        .chip-final {
            background: #fee2e2;
            color: #991b1b;
        }
    </style>
}

<main class="wa-main" id="waMain">

    @if (ViewBag.Success != null)
    {
        <div style="margin:16px 24px 0;background:var(--success-soft);
                                border:1px solid rgba(46,125,50,.2);color:#2e7d32;
                                padding:12px 16px;border-radius:var(--r);
                                font-weight:800;font-size:.86rem;">
            @ViewBag.Success
        </div>
    }

    <section class="page-hero">
        <div>
            <h1>🚩 Flagged Listings</h1>
            <p>@Model.Count() active — @historyItems.Count reviewed</p>
        </div>
    </section>

    <div class="page-body">

        <div class="kpi-grid kpi-grid-4" style="margin-bottom:20px;">
            <div class="kpi-card c4">
                <div class="kpi-ico red">🚩</div>
                <div class="kpi-val">@Model.Count()</div>
                <div class="kpi-label">Active Flags</div>
                <div class="kpi-chip chip-red">Needs review</div>
            </div>
            @foreach (var reason in allReasons.Take(3))
            {
                var cnt = Model.Count(f => f.Post.TopReason == reason);
                <div class="kpi-card c3">
                    <div class="kpi-ico yellow">📋</div>
                    <div class="kpi-val">@cnt</div>
                    <div class="kpi-label" style="font-size:.72rem;">@reason</div>
                    <div class="kpi-chip chip-yellow">Reports</div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="table-card" style="text-align:center;padding:48px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">🎉</div>
                <div style="font-weight:900;color:var(--brand-dark);">No active flags</div>
                <div style="font-size:.84rem;color:var(--text-muted);margin-top:4px;">
                    All reports have been reviewed.
                </div>
            </div>
        }

        @* ── Active Flagged Posts ── *@
        @foreach (var item in Model)
        {
            var post = item.Post;
            var reporters = item.Reporters.ToList();
            var actions = item.Actions.ToList();
            var warnCount = actions.Count(a => a.ActionType.Contains("Warn") || a.ActionType == "FinalWarning");
            var postBadge = post.Status == "Approved" ? "badge-success" :
            post.Status == "Pending" ? "badge-warning" : "badge-muted";

            <div class="table-card" style="margin-bottom:16px;">

                <div style="padding:16px;border-bottom:1px solid var(--border);
                                        display:flex;align-items:center;
                                        justify-content:space-between;flex-wrap:wrap;gap:10px;">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:42px;height:42px;border-radius:12px;
                                         background:var(--brand-xlight);display:grid;
                                         place-items:center;font-size:1.2rem;
                                         border:1px solid var(--brand-light);">
                            @(post.AnimalType?.ToLower() == "cat" ? "🐈" :
                                                    post.AnimalType?.ToLower() == "dog" ? "🐕" :
                                                    post.AnimalType?.ToLower() == "bird" ? "🐦" : "🐾")
                    </div>
                    <div>
                        <div style="font-weight:900;font-size:.95rem;color:var(--brand-dark);">
                            @post.PetName
                            <span style="font-size:.75rem;color:var(--text-muted);font-weight:700;">
                                #@post.IdPost
                            </span>
                        </div>
                        <div style="font-size:.78rem;color:var(--text-muted);">
                            @post.AnimalType · @post.City · Owner: @post.OwnerName
                        </div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span class="badge @postBadge">@post.Status</span>
                    <span style="background:var(--danger-soft);color:var(--danger);
                                  font-size:.8rem;font-weight:900;padding:4px 12px;
                                  border-radius:999px;">
                        🚩 @post.FlagCount reports
                    </span>
                    @if (actions.Any())
                        {
                            <span style="background:var(--warning-soft);color:#9b6000;
                                                      font-size:.74rem;font-weight:900;padding:3px 10px;
                                                      border-radius:999px;">
                                ⚠️ @actions.Count action@(actions.Count > 1 ? "s" : "") taken
                            </span>
                        }
                    </div>
                </div>

                <div style="padding:14px 16px;">
                    <div class="section-divider">👥 Reporters (@reporters.Count)</div>
                    @foreach (var r in reporters)
                    {
                        <div class="reporter-row">
                            <div>
                                <div class="reporter-name">@r.ReporterName</div>
                                <div class="reporter-meta">
                                    📧 @r.ReporterEmail
                                    @if (!string.IsNullOrEmpty(r.ReporterPhone))
                                    {
                                        <span> · 📞 @r.ReporterPhone</span>
                                    }
                                    · @r.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt")
                                </div>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span class="reporter-reason">@r.Reason</span>
                                <span style="font-size:.7rem;color:var(--text-muted);">
                                    ID: @r.IdUser
                                </span>
                            </div>
                        </div>
                    }
                </div>

                @if (actions.Any())
                {
                    <div style="padding:0 16px 14px;">
                        <div class="section-divider">📋 Actions Taken (@actions.Count)</div>
                        @foreach (var a in actions)
                        {
                            var dotColor = a.ActionType == "Cleared" ? "#2e7d32" :
                            a.ActionType == "Closed" ? "#dc2626" :
                            a.ActionType == "DecisionReverted" ? "#6b7280" : "#9b6000";
                            var chipClass = a.ActionType == "Cleared" ? "chip-cleared" :
                            a.ActionType == "Closed" ? "chip-closed" :
                            a.ActionType == "DecisionReverted" ? "chip-reverted" :
                            a.ActionType == "FinalWarning" ? "chip-final" : "chip-warned";

                            <div class="action-log-row">
                                <div class="action-dot" style="background:@dotColor;"></div>
                                <div style="flex:1;">
                                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                        <span class="action-type-chip @chipClass">@a.ActionType</span>
                                        @if (!string.IsNullOrEmpty(a.TargetName))
                                        {
                                            <span style="font-size:.76rem;color:var(--text-muted);">
                                                → @a.TargetName
                                            </span>
                                        }
                                        <span style="font-size:.72rem;color:var(--text-muted);margin-left:auto;">
                                            @a.CreatedAt.ToString("MMM dd · hh:mm tt")
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Message))
                                    {
                                        <div style="font-size:.78rem;color:var(--text-muted);
                                                                                        margin-top:3px;font-style:italic;">
                                            "@a.Message"
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div style="padding:0 16px 14px;">
                    <div class="section-divider">⚖️ Final Decision</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <form method="post" asp-action="ClearFlags" asp-controller="SuperAdmin"
                              style="display:inline"
                              onsubmit="return confirm('No violation — clear all flags?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="postId" value="@post.IdPost" />
                            <button type="submit" class="btn btn-success btn-sm">
                                ✓ No Violation — Clear
                            </button>
                        </form>
                        @if (post.Status != "Closed")
                        {
                            <form method="post" asp-action="FlagClosePost"
                                  asp-controller="SuperAdmin" style="display:inline"
                                  onsubmit="return confirm('Close post and mark as reviewed?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.IdPost" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    🔒 Close Post
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div style="padding:0 16px 16px;">
                    <details>
                        <summary style="cursor:pointer;font-size:.82rem;font-weight:900;
                                                   color:#9b6000;padding:8px 0;user-select:none;">
                            ⚠️ Send Warning
                            @if (warnCount > 0)
                            {
                                <span style="font-size:.72rem;color:var(--text-muted);font-weight:700;">
                                    (@warnCount sent)
                                </span>
                            }
                        </summary>
                        <div class="warn-form">
                            <div style="background:var(--warning-soft);border-radius:10px;
                                                    padding:8px 12px;margin-bottom:.8rem;
                                                    font-size:.78rem;font-weight:800;color:#9b6000;">
                                ⚠️ Sending a warning does NOT close this flag.
                                The post stays active until you make a final decision above.
                            </div>
                            <form method="post" asp-action="SendWarning" asp-controller="SuperAdmin">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.IdPost" />
                                <input type="hidden" name="targetName"
                                       id="tname_@post.IdPost" value="@post.OwnerName" />

                                <label>Send Warning To:</label>
                                <select name="targetUserId"
                                        onchange="updateTargetName(this, 'tname_@post.IdPost')">
                                    <option value="@post.PostedById" data-name="@post.OwnerName">
                                        👤 Post Owner — @post.OwnerName
                                    </option>
                                    @foreach (var r in reporters)
                                    {
                                        <option value="@r.IdUser" data-name="@r.ReporterName">
                                            🚩 Reporter — @r.ReporterName (@r.Reason)
                                        </option>
                                    }
                                </select>

                                <label>Warning Type:</label>
                                <select name="adminAction">
                                    <option value="WarnedOwner">⚠️ First Warning — Post Owner</option>
                                    <option value="WarnedReporter">⚠️ False Report — Reporter</option>
                                    <option value="FinalWarning">🔴 Final Warning</option>
                                </select>

                                <label>Warning Message:</label>
                                <textarea name="warningMessage"
                                      placeholder="Write a clear warning message..."></textarea>

                                <button type="submit" class="btn btn-warning btn-sm">
                                    📨 Send Warning
                                </button>
                            </form>
                        </div>
                    </details>
                </div>

            </div>
        }

        @* ── History Section ── *@
        @if (historyItems.Any())
        {
            <div style="margin-top:32px;">
                <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;
                                        color:var(--brand-dark);font-weight:700;margin-bottom:12px;">
                    📂 Review History (@historyItems.Count)
                </div>

                @foreach (var item in historyItems)
                {
                    var post = item.Post;
                    var reporters = item.Reporters.ToList();
                    var actions = item.Actions.ToList();
                    var lastAction = actions.LastOrDefault();
                    var histBadge = post.Status == "Approved" ? "badge-success" :
                    post.Status == "Closed" ? "badge-muted" : "badge-warning";
                    var lastChip = lastAction == null ? "chip-warned" :
                    lastAction.ActionType == "Cleared" ? "chip-cleared" :
                    lastAction.ActionType == "Closed" ? "chip-closed" :
                    lastAction.ActionType == "DecisionReverted" ? "chip-reverted" : "chip-warned";

                    <div class="table-card" style="margin-bottom:10px;opacity:.9;">

                        <div style="padding:14px 16px;display:flex;align-items:center;
                                                        justify-content:space-between;flex-wrap:wrap;gap:8px;">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div style="width:36px;height:36px;border-radius:10px;
                                                         background:var(--surface-2);display:grid;
                                                         place-items:center;font-size:1rem;
                                                         border:1px solid var(--border);">
                                    @(post.AnimalType?.ToLower() == "cat" ? "🐈" :
                                                                post.AnimalType?.ToLower() == "dog" ? "🐕" :
                                                                post.AnimalType?.ToLower() == "bird" ? "🐦" : "🐾")
                        </div>
                        <div>
                            <div style="font-weight:900;font-size:.88rem;color:var(--brand-dark);">
                                @post.PetName
                                <span style="font-size:.72rem;color:var(--text-muted);">
                                    #@post.IdPost
                                </span>
                            </div>
                            <div style="font-size:.74rem;color:var(--text-muted);">
                                @post.OwnerName · @post.City ·
                                🚩 @post.FlagCount flags ·
                                @actions.Count action@(actions.Count != 1 ? "s" : "")
                                @if (lastAction != null)
                                        {
                                            <span class="action-type-chip @lastChip"
                                                  style="margin-left:4px;">
                                                @lastAction.ActionType
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                <span class="badge @histBadge">@post.Status</span>
                                <button type="button" class="btn btn-outline btn-xs"
                                        onclick="toggleDetail('hd_@post.IdPost')">
                                    👁 Details
                                </button>
                                <form method="post" asp-action="RevertDecision"
                                      asp-controller="SuperAdmin" style="display:inline"
                                      onsubmit="return confirm('Revert this decision? Post returns to active flags.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@post.IdPost" />
                                    <button type="submit" class="btn btn-warning btn-xs">
                                        ↩ Revert
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div id="hd_@post.IdPost" class="history-detail">

                            <div class="section-divider">👥 Reporters (@reporters.Count)</div>
                            @foreach (var r in reporters)
                            {
                                <div class="reporter-row" style="opacity:.85;">
                                    <div>
                                        <div class="reporter-name">@r.ReporterName</div>
                                        <div class="reporter-meta">
                                            📧 @r.ReporterEmail
                                            @if (!string.IsNullOrEmpty(r.ReporterPhone))
                                            {
                                                <span> · 📞 @r.ReporterPhone</span>
                                            }
                                            · @r.CreatedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <span class="reporter-reason">@r.Reason</span>
                                </div>
                            }

                            <div class="section-divider" style="margin-top:.8rem;">
                                📋 Action Timeline (@actions.Count)
                            </div>
                            @foreach (var a in actions)
                            {
                                var aDot = a.ActionType == "Cleared" ? "#2e7d32" :
                                a.ActionType == "Closed" ? "#dc2626" :
                                a.ActionType == "DecisionReverted" ? "#6b7280" : "#9b6000";
                                var aChip = a.ActionType == "Cleared" ? "chip-cleared" :
                                a.ActionType == "Closed" ? "chip-closed" :
                                a.ActionType == "DecisionReverted" ? "chip-reverted" :
                                a.ActionType == "FinalWarning" ? "chip-final" : "chip-warned";

                                <div class="action-log-row">
                                    <div class="action-dot" style="background:@aDot;"></div>
                                    <div style="flex:1;">
                                        <div style="display:flex;align-items:center;
                                                                                gap:8px;flex-wrap:wrap;">
                                            <span class="action-type-chip @aChip">
                                                @a.ActionType
                                            </span>
                                            @if (!string.IsNullOrEmpty(a.TargetName))
                                            {
                                                <span style="font-size:.76rem;color:var(--text-muted);">
                                                    → @a.TargetName
                                                </span>
                                            }
                                            <span style="font-size:.72rem;color:var(--text-muted);
                                                                                     margin-left:auto;">
                                                @a.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(a.Message))
                                        {
                                            <div style="font-size:.78rem;color:var(--text-muted);
                                                                                            margin-top:3px;font-style:italic;">
                                                "@a.Message"
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        }

    </div>
</main>

</div>


@section PageScripts {
    <script>
        function toggleDetail(id) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }

        function updateTargetName(select, hiddenId) {
            const opt = select.options[select.selectedIndex];
            const name = opt.getAttribute('data-name') || opt.text;
            const hidden = document.getElementById(hiddenId);
            if (hidden) hidden.value = name;
        }
    </script>
}
