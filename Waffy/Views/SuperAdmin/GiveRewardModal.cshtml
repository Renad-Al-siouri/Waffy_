@{
    Layout = null;
    var recipient = ViewBag.Recipient as Waffy.Models.User;
    var pool = ViewBag.Pool as List<Waffy.Models.SurpriseRewardPool> ?? new();
    var history = ViewBag.RewardHistory as List<Waffy.Models.ViewModels.RewardLogDto> ?? new();
    bool hasRecent = (bool)(ViewBag.HasRecentReward ?? false);
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Give Reward</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        @* ── Sidebar ── *@
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <a class="sb-row active" asp-controller="SuperAdmin" asp-action="Users">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                        <span class="sb-lbl">Users</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.AdminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.AdminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button class="sb-logout" type="submit">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span class="sb-logout-lbl">Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        @* ── Topnav ── *@
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>
            <nav class="tn-bread">
                <a asp-controller="SuperAdmin" asp-action="Users" style="color:var(--text-muted);font-weight:800;">Users</a>
                <span>/</span>
                <a asp-controller="SuperAdmin" asp-action="Details_U"
                   asp-route-id="@recipient?.UserId"
                   style="color:var(--text-muted);font-weight:800;">@recipient?.FullName</a>
                <span>/</span><b>Give Reward</b>
            </nav>
            <div class="tn-center">
                <div class="tn-center-main">🎁 Give Reward</div>
                <div class="tn-center-sub">Manual gift · Admin choice</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.AdminInitials</div>
                    <div><div class="tn-pname">@ViewBag.AdminName</div><div class="tn-prole">Super Admin</div></div>
                </div>
            </div>
        </header>

        @* ── Main ── *@
        <main class="wa-main" id="waMain">

            @if (ViewBag.Error != null)
            {
                <div style="margin:16px 24px 0;background:var(--danger-soft);border:1px solid rgba(220,38,38,.2);
                            color:var(--danger);padding:12px 16px;border-radius:var(--r);font-weight:800;font-size:.86rem;">
                    @ViewBag.Error
                </div>
            }

            <section class="page-hero">
                <div>
                    <h1>🎁 Give Reward to User</h1>
                    <p>Choose a reward from the pool and assign it manually</p>
                </div>
                <div class="page-hero-actions">
                    <a asp-controller="SuperAdmin" asp-action="Details_U"
                       asp-route-id="@recipient?.UserId"
                       class="btn btn-outline btn-sm">← Back to User</a>
                </div>
            </section>

            <div class="page-body">
                <div style="display:grid;grid-template-columns:360px 1fr;gap:16px;align-items:start;">

                    @* ── LEFT: Recipient Info ── *@
                    <div style="display:flex;flex-direction:column;gap:14px;">

                        @* User Card *@
                        <div class="table-card">
                            <div class="table-head-bar">
                                <div class="table-head-title">👤 Recipient</div>
                                <span class="badge badge-info">#@recipient?.UserId</span>
                            </div>
                            <div style="padding:16px 20px;">
                                @* Avatar *@
                                <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
                                    <div style="width:56px;height:56px;border-radius:16px;
                                            background:var(--brand-mid);color:#fff;
                                            display:grid;place-items:center;
                                            font-family:'Fredoka',sans-serif;font-size:1.4rem;
                                            font-weight:700;flex-shrink:0;">
                                        @(recipient?.FullName?.Length > 0
                                                                                ? recipient.FullName[0].ToString().ToUpper() : "?")
                                    </div>
                                    <div>
                                        <div style="font-family:'Fredoka',sans-serif;font-size:1.1rem;
                                                font-weight:700;color:var(--brand-dark);">
                                            @recipient?.FullName
                                        </div>
                                        <div style="font-size:.78rem;color:var(--text-muted);font-weight:700;">
                                            @recipient?.City
                                        </div>
                                    </div>
                                </div>

                                <div class="info-list">
                                    <div class="info-line">
                                        <span>📧 Email</span>
                                        <strong style="font-size:.82rem;">@recipient?.Email</strong>
                                    </div>
                                    <div class="info-line">
                                        <span>📞 Phone</span>
                                        <strong style="font-family:monospace;">@(recipient?.Phone ?? "—")</strong>
                                    </div>
                                    <div class="info-line">
                                        <span>📍 City</span>
                                        <strong>@(recipient?.City ?? "—")@(recipient?.Area != null ? $" · {recipient.Area}" : "")</strong>
                                    </div>
                                    <div class="info-line">
                                        <span>🔑 User ID</span>
                                        <strong style="font-family:monospace;">#@recipient?.UserId</strong>
                                    </div>
                                </div>

                                @if (hasRecent)
                                {
                                    <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.3);
                                                border-radius:10px;padding:10px 12px;margin-top:10px;
                                                font-size:.8rem;color:#9b6000;font-weight:700;">
                                        ⚠️ This user received a reward within the last 30 days
                                    </div>
                                }
                            </div>
                        </div>

                        @* Reward History *@
                        <div class="table-card">
                            <div class="table-head-bar">
                                <div class="table-head-title">📋 Reward History</div>
                                <span class="badge badge-muted">@history.Count total</span>
                            </div>
                            @if (!history.Any())
                            {
                                <div style="padding:20px;text-align:center;color:var(--text-muted);
                                            font-weight:700;font-size:.84rem;">
                                    No rewards given yet
                                </div>
                            }
                            else
                            {
                                <div style="padding:0 8px;">
                                    @foreach (var h in history)
                                    {
                                        <div style="display:flex;gap:10px;align-items:flex-start;
                                                        padding:10px 12px;border-bottom:1px solid var(--border);">
                                            <div style="font-size:1rem;margin-top:2px;">🎁</div>
                                            <div style="flex:1;min-width:0;">
                                                <div style="font-weight:800;font-size:.82rem;color:var(--brand-dark);">
                                                    @h.RewardTitle
                                                </div>
                                                <div style="font-size:.74rem;color:var(--text-muted);font-weight:700;">
                                                    @h.GiftTypeLabel
                                                </div>
                                                <div style="font-size:.74rem;color:var(--text-muted);font-weight:700;">
                                                    @h.ReasonCategory · @h.CreatedAt.ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                            <div style="font-size:.76rem;font-weight:800;
                                                            color:var(--success);white-space:nowrap;">
                                                @h.RewardDisplay
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── RIGHT: Form ── *@
                    <div>
                        <form method="post"
                              asp-controller="SuperAdmin"
                              asp-action="GiveReward"
                              onsubmit="return confirmGive()">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="recipientId" value="@recipient?.UserId" />

                            <div class="table-card" style="border:2px solid rgba(226,163,58,.3);">
                                <div class="table-head-bar" style="background:var(--warning-soft);">
                                    <div class="table-head-title">🎁 Choose Reward & Reason</div>
                                    <span class="badge badge-warning">@pool.Count available</span>
                                </div>
                                <div style="padding:16px 20px;display:flex;flex-direction:column;gap:16px;">

                                    @* Reason Category *@
                                    <div>
                                        <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);
                                                  display:block;margin-bottom:6px;">
                                            📋 Reason for gift <span style="color:var(--danger);">*</span>
                                        </label>
                                        <select name="reasonCategory" required
                                                style="width:100%;border:1.5px solid var(--border);border-radius:12px;
                                                   background:#fff;padding:10px 14px;font-size:.84rem;
                                                   font-weight:700;font-family:'Nunito',sans-serif;outline:none;">
                                            <option value="">— Select reason —</option>
                                            <option value="Helpful community member">🤝 Helpful community member</option>
                                            <option value="Loyalty reward">🏆 Loyalty reward</option>
                                            <option value="Exceptional behavior">⭐ Exceptional behavior</option>
                                            <option value="Engagement milestone">🎯 Engagement milestone</option>
                                            <option value="Special occasion">🎉 Special occasion</option>
                                            <option value="Community encouragement">💪 Community encouragement</option>
                                            <option value="Other">📝 Other</option>
                                        </select>
                                    </div>

                                    @* Optional Note *@
                                    <div>
                                        <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);
                                                  display:block;margin-bottom:6px;">
                                            📝 Personal note to user (optional)
                                        </label>
                                        <textarea name="reasonNote" rows="2"
                                                  placeholder="E.g. Your contributions to the community have been noticed..."
                                                  style="width:100%;border:1.5px solid var(--border);border-radius:12px;
                                                     background:#fff;padding:10px 14px;font-size:.84rem;
                                                     font-weight:700;font-family:'Nunito',sans-serif;
                                                     outline:none;resize:vertical;"></textarea>
                                    </div>

                                    @* Reward Pool *@
                                    <div>
                                        <label style="font-size:.8rem;font-weight:900;color:var(--brand-dark);
                                                  display:block;margin-bottom:8px;">
                                            🎁 Select reward <span style="color:var(--danger);">*</span>
                                        </label>

                                        @if (!pool.Any())
                                        {
                                            <div style="background:var(--danger-soft);border:1px solid rgba(220,38,38,.2);
                                                        border-radius:12px;padding:16px;text-align:center;
                                                        font-weight:700;color:var(--danger);">
                                                ❌ No rewards available. Add rewards in Lost Pets page.
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                                @foreach (var r in pool)
                                                {
                                                    var icon = r.RewardType switch
                                                    {
                                                        "WalletCredit" => "💰",
                                                        "StoreDiscount" => "🏪",
                                                        "ClinicSession" => "🏥",
                                                        "DeliveryVoucher" => "🚚",
                                                        _ => "🎁"
                                                    };
                                                    <label style="cursor:pointer;" onclick="selectReward(this, @r.IdReward)">
                                                        <input type="radio" name="rewardId"
                                                               value="@r.IdReward" required
                                                               style="display:none;" />
                                                        <div class="reward-card-opt" id="ropt_@r.IdReward"
                                                             style="border:2px solid var(--border);border-radius:14px;
                                                                        padding:14px;background:#fff;
                                                                        transition:.18s;height:100%;box-sizing:border-box;">
                                                            <div style="font-size:1.4rem;margin-bottom:6px;">@icon</div>
                                                            <div style="font-weight:900;color:var(--brand-dark);
                                                                            font-size:.84rem;margin-bottom:4px;">
                                                                @r.Title
                                                            </div>
                                                            <div style="font-size:.72rem;color:var(--text-muted);font-weight:700;">
                                                                @r.RewardType
                                                                @if (r.PartnerName != null)
                                                                {
                                                                    <text>· @r.PartnerName</text>
                                                                }
                                                            </div>
                                                            @if (r.Value.HasValue)
                                                            {
                                                                <div style="font-family:'Fredoka',sans-serif;font-size:.95rem;
                                                                                    font-weight:700;color:var(--success);margin-top:6px;">
                                                                    @r.Value.Value.ToString("F2") JOD
                                                                </div>
                                                            }
                                                            else if (r.DiscountPercent.HasValue)
                                                            {
                                                                <div style="font-family:'Fredoka',sans-serif;font-size:.95rem;
                                                                                    font-weight:700;color:#9b6000;margin-top:6px;">
                                                                    @r.DiscountPercent% off
                                                                </div>
                                                            }
                                                            @if (r.CouponCode != null)
                                                            {
                                                                <div style="font-family:monospace;font-size:.7rem;
                                                                                    background:var(--surface-2);padding:2px 6px;
                                                                                    border-radius:6px;margin-top:4px;display:inline-block;">
                                                                    @r.CouponCode
                                                                </div>
                                                            }
                                                        </div>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @* Delivery notice *@
                                    <div style="background:var(--surface-2);border:1px solid var(--border);
                                            border-radius:12px;padding:12px 14px;">
                                        <div style="font-size:.78rem;font-weight:900;color:var(--brand-dark);
                                                margin-bottom:4px;">
                                            📦 Delivery is automatic
                                        </div>
                                        <div style="font-size:.76rem;color:var(--text-muted);font-weight:700;line-height:1.6;">
                                            WalletCredit → Added to wallet instantly<br>
                                            Others → User receives notification with details
                                        </div>
                                    </div>

                                    @* Submit *@
                                    @if (pool.Any())
                                    {
                                        <button type="submit" class="btn btn-success"
                                                style="width:100%;justify-content:center;padding:12px;font-size:.9rem;">
                                            🎁 Give Reward to @recipient?.FullName
                                        </button>
                                    }

                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        function selectReward(label, id) {
            document.querySelectorAll('.reward-card-opt').forEach(el => {
                el.style.border     = '2px solid var(--border)';
                el.style.background = '#fff';
            });
            const opt = document.getElementById('ropt_' + id);
            if (opt) {
                opt.style.border     = '2px solid var(--brand)';
                opt.style.background = 'var(--brand-xlight)';
            }
            label.querySelector('input[type="radio"]').checked = true;
        }

        function confirmGive() {
            const reason = document.querySelector('select[name="reasonCategory"]').value;
            const reward = document.querySelector('input[name="rewardId"]:checked');
            if (!reason) { alert('Please select a reason.'); return false; }
            if (!reward) { alert('Please select a reward.'); return false; }
            return confirm('Give this reward? This action cannot be undone.');
        }
    </script>
</body>
</html>
