@{
    ViewData["Title"] = "Waffy — Super Admin | Map Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        .wa-main {
            padding: 0 !important;
            overflow: hidden;
        }

        .map-shell {
            display: flex;
            height: calc(100vh - var(--tn-h));
            position: relative;
        }

        .map-panel {
            width: 320px;
            flex-shrink: 0;
            background: linear-gradient(180deg,var(--sb-bg) 0%,var(--sb-bg-2) 100%);
            border-right: 1px solid var(--sb-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            z-index: 200;
            box-shadow: 4px 0 24px rgba(42,34,24,.14);
            transition: width .3s cubic-bezier(.4,0,.2,1);
        }

            .map-panel.collapsed {
                width: 0;
                overflow: hidden;
            }

        .mp-header {
            padding: 14px 16px;
            border-bottom: 1px solid var(--sb-border);
            background: rgba(255,255,255,.06);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .mp-title {
            font-family: 'Fredoka',sans-serif;
            font-size: .95rem;
            font-weight: 700;
            color: #f2f7ea;
        }

        .mp-coord {
            font-size: .65rem;
            color: rgba(242,247,234,.62);
            font-weight: 700;
        }

        .mp-tabs {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 4px;
            padding: 8px 10px;
            border-bottom: 1px solid var(--sb-border);
            flex-shrink: 0;
            background: rgba(0,0,0,.06);
        }

        .mp-tab {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            padding: 8px 4px;
            border-radius: 10px;
            cursor: pointer;
            transition: .18s;
            border: 1px solid transparent;
            background: rgba(255,255,255,.06);
            font-size: .6rem;
            font-weight: 800;
            color: rgba(242,247,234,.7);
            text-align: center;
        }

            .mp-tab span {
                font-size: 1rem;
                display: block;
            }

            .mp-tab:hover {
                background: rgba(255,255,255,.12);
                color: #f2f7ea;
            }

            .mp-tab.active {
                background: #fff7ea;
                color: var(--brand-dark);
                border-color: rgba(139,169,74,.28);
                box-shadow: 0 4px 12px rgba(62,56,38,.14);
            }

        .mp-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.1) transparent;
        }

            .mp-body::-webkit-scrollbar {
                width: 3px;
            }

            .mp-body::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.12);
                border-radius: 99px;
            }

        .mp-section {
            display: none;
        }

            .mp-section.active {
                display: block;
            }

        .mp-section-hd {
            font-size: .62rem;
            font-weight: 900;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: rgba(242,247,234,.56);
            padding: 10px 14px 4px;
        }

        .layer-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 12px;
            margin: 3px 8px;
            border-radius: 12px;
            cursor: pointer;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            transition: .18s;
        }

            .layer-row:hover {
                background: rgba(255,255,255,.12);
                border-color: rgba(255,255,255,.16);
                transform: translateY(-1px);
            }

        .layer-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .layer-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .layer-name {
            font-size: .82rem;
            font-weight: 800;
            color: #f2f7ea;
        }

        .layer-count {
            font-size: .68rem;
            color: rgba(242,247,234,.62);
            margin-top: 1px;
        }

        .tog {
            width: 32px;
            height: 16px;
            background: rgba(255,255,255,.18);
            border-radius: 9px;
            position: relative;
            flex-shrink: 0;
            transition: background .22s;
            cursor: pointer;
        }

            .tog.on {
                background: var(--brand);
            }

            .tog::after {
                content: '';
                position: absolute;
                top: 2px;
                left: 2px;
                width: 12px;
                height: 12px;
                background: #fff;
                border-radius: 50%;
                transition: transform .22s;
                box-shadow: 0 1px 3px rgba(0,0,0,.18);
            }

            .tog.on::after {
                transform: translateX(16px);
            }

        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding: 12px;
        }

        .stat-card {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
            padding: 12px;
            transition: .18s;
        }

            .stat-card:hover {
                background: rgba(255,255,255,.13);
                transform: translateY(-1px);
            }

        .stat-val {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            line-height: 1;
            color: #f2f7ea;
        }

        .stat-lbl {
            font-size: .68rem;
            color: rgba(242,247,234,.62);
            margin-top: 4px;
        }

        .stat-card.c-green .stat-val {
            color: #a8d96a;
        }

        .stat-card.c-red .stat-val {
            color: #f09090;
        }

        .stat-card.c-yellow .stat-val {
            color: #e8c96e;
        }

        .stat-card.c-blue .stat-val {
            color: #8ac7f0;
        }

        .stat-card.c-purple .stat-val {
            color: #c4b0f0;
        }

        .stat-card.c-orange .stat-val {
            color: #f0b880;
        }

        .mp-divider {
            padding: 6px 14px 2px;
            font-size: .62rem;
            font-weight: 900;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: rgba(242,247,234,.5);
            border-bottom: 1px solid rgba(255,255,255,.08);
            margin-bottom: 2px;
        }

        .bar-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
        }

        .bar-lbl {
            font-size: .78rem;
            font-weight: 700;
            color: rgba(242,247,234,.82);
            min-width: 64px;
        }

        .bar-track {
            flex: 1;
            height: 5px;
            background: rgba(255,255,255,.12);
            border-radius: 3px;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(90deg,var(--brand),var(--brand-dark));
        }

        .bar-num {
            font-size: .72rem;
            font-weight: 800;
            color: var(--brand-light);
            min-width: 14px;
            text-align: right;
        }

        .alert-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 14px;
            border-bottom: 1px solid rgba(255,255,255,.07);
            cursor: pointer;
            transition: .15s;
        }

            .alert-item:hover {
                background: rgba(255,255,255,.07);
            }

        .alert-ico {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: .9rem;
            flex-shrink: 0;
        }

        .alert-title {
            font-size: .8rem;
            font-weight: 800;
            color: #f2f7ea;
            line-height: 1.3;
        }

        .alert-sub {
            font-size: .7rem;
            color: rgba(242,247,234,.62);
            margin-top: 2px;
        }

        .alert-time {
            font-size: .63rem;
            color: rgba(242,247,234,.44);
            margin-top: 2px;
        }

        .map-toggle {
            position: absolute;
            top: 50%;
            left: 320px;
            transform: translateY(-50%);
            width: 18px;
            height: 44px;
            background: #fff;
            border: 1px solid var(--border);
            border-left: none;
            border-radius: 0 8px 8px 0;
            display: grid;
            place-items: center;
            cursor: pointer;
            z-index: 220;
            color: var(--text-muted);
            font-size: .72rem;
            box-shadow: 3px 0 10px rgba(0,0,0,.06);
            transition: left .3s cubic-bezier(.4,0,.2,1),background .18s;
        }

            .map-toggle:hover {
                background: var(--brand-ghost);
                color: var(--brand-dark);
            }

            .map-toggle.collapsed {
                left: 0;
                border-left: 1px solid var(--border);
                border-radius: 0 8px 8px 0;
            }

        .map-area {
            flex: 1;
            position: relative;
            background: linear-gradient(135deg,#e8ddd2 0%,#f0e7df 50%,#e8ddd2 100%);
            overflow: hidden;
        }

        .map-grid {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(180,162,142,.28) 1px,transparent 1px),linear-gradient(90deg,rgba(180,162,142,.28) 1px,transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
        }

        .road {
            position: absolute;
            background: rgba(160,140,118,.45);
            border-radius: 2px;
        }

            .road.h {
                height: 4px;
            }

            .road.v {
                width: 4px;
            }

            .road.hm {
                height: 8px;
            }

            .road.vm {
                width: 8px;
            }

        .area-lbl {
            position: absolute;
            font-size: .62rem;
            font-weight: 900;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(120,100,82,.38);
            pointer-events: none;
        }

        .heat-blob {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(32px);
            opacity: 0;
            transition: opacity .4s;
        }

            .heat-blob.show {
                opacity: .35;
            }

        .marker {
            position: absolute;
            transform: translate(-50%,-100%);
            cursor: pointer;
            z-index: 150;
            transition: transform .18s;
        }

            .marker:hover {
                transform: translate(-50%,-100%) scale(1.22);
                z-index: 160;
            }

        .m-pin {
            width: 32px;
            height: 36px;
            border-radius: 50% 50% 50% 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .9rem;
            border: 2px solid rgba(255,255,255,.75);
            box-shadow: 0 3px 12px rgba(80,60,40,.18);
            transform: rotate(-45deg);
        }

            .m-pin span {
                transform: rotate(45deg);
                display: block;
            }

        .m-lbl {
            position: absolute;
            bottom: -18px;
            left: 50%;
            transform: translateX(-50%);
            white-space: nowrap;
            font-size: .58rem;
            font-weight: 800;
            color: var(--text);
            background: rgba(255,255,255,.9);
            padding: 1px 5px;
            border-radius: 4px;
            border: 1px solid var(--border);
        }

        .m-pulse {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            animation: pulse 2s infinite;
            pointer-events: none;
        }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(217,83,79,.32);
            }

            70% {
                box-shadow: 0 0 0 14px rgba(217,83,79,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(217,83,79,0);
            }
        }

        .radius-circle {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            border: 2px dashed;
            transform: translate(-50%,-50%);
            display: none;
            transition: opacity .3s;
        }

        .map-search-wrap {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            width: 300px;
            z-index: 200;
        }

        .map-search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 8px 14px;
            box-shadow: var(--shadow);
            transition: .18s;
        }

            .map-search-box:focus-within {
                border-color: var(--brand);
                box-shadow: 0 0 0 3px rgba(139,169,74,.12);
            }

            .map-search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'Nunito',sans-serif;
                font-size: .84rem;
                color: var(--text);
                width: 100%;
            }

                .map-search-box input::placeholder {
                    color: var(--text-muted);
                }

        #searchResults {
            display: none;
            margin-top: 5px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .sr-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 14px;
            cursor: pointer;
            font-size: .82rem;
            border-bottom: 1px solid var(--border);
            transition: background .14s;
        }

            .sr-item:last-child {
                border-bottom: none;
            }

            .sr-item:hover {
                background: var(--brand-ghost);
            }

            .sr-item strong {
                color: var(--brand-dark);
            }

            .sr-item small {
                font-size: .7rem;
                color: var(--text-muted);
            }

        .map-toolbar {
            position: absolute;
            top: 14px;
            right: 14px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            z-index: 200;
        }

        .tb {
            width: 36px;
            height: 36px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            display: grid;
            place-items: center;
            cursor: pointer;
            font-size: 1rem;
            transition: .18s;
            color: var(--text-muted);
            box-shadow: var(--shadow);
        }

            .tb:hover {
                background: var(--brand-ghost);
                border-color: var(--brand);
                color: var(--brand-dark);
            }

            .tb.on {
                background: var(--brand-ghost);
                border-color: var(--brand);
                color: var(--brand-dark);
            }

        .add-bar {
            position: absolute;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg,var(--brand),var(--brand-dark));
            color: #fff;
            padding: 10px 22px;
            border-radius: var(--pill);
            font-size: .84rem;
            font-weight: 800;
            z-index: 300;
            display: none;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 16px rgba(95,116,48,.35);
            white-space: nowrap;
        }

            .add-bar.show {
                display: flex;
            }

            .add-bar button {
                background: rgba(255,255,255,.18);
                border: none;
                color: #fff;
                font-family: 'Nunito',sans-serif;
                font-size: .78rem;
                font-weight: 800;
                padding: 4px 10px;
                border-radius: var(--pill);
                cursor: pointer;
            }

                .add-bar button:hover {
                    background: rgba(255,255,255,.28);
                }

        .api-banner {
            position: absolute;
            top: 70px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--warning-soft);
            border: 1px solid rgba(226,163,58,.3);
            border-radius: 12px;
            padding: 8px 16px;
            z-index: 200;
            font-size: .76rem;
            color: #9b6000;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: var(--shadow);
            white-space: nowrap;
        }

            .api-banner button {
                background: none;
                border: none;
                color: #9b6000;
                cursor: pointer;
                font-size: .9rem;
                opacity: .7;
            }

                .api-banner button:hover {
                    opacity: 1;
                }

        .map-legend {
            position: absolute;
            bottom: 14px;
            right: 14px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 12px 14px;
            z-index: 200;
            min-width: 155px;
            box-shadow: var(--shadow);
        }

        .legend-title {
            font-size: .62rem;
            font-weight: 900;
            color: var(--text-muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 5px;
            font-size: .72rem;
            color: var(--text-muted);
        }

        .legend-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .map-popup {
            position: absolute;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-lg);
            padding: 14px 16px;
            width: 252px;
            box-shadow: var(--shadow);
            z-index: 250;
            display: none;
        }

        .popup-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .popup-title {
            font-size: .86rem;
            font-weight: 900;
            color: var(--brand-dark);
        }

        .popup-close {
            width: 22px;
            height: 22px;
            border-radius: 6px;
            border: none;
            background: var(--surface-2);
            color: var(--text-muted);
            cursor: pointer;
            font-size: .78rem;
            display: grid;
            place-items: center;
            transition: .14s;
        }

            .popup-close:hover {
                background: var(--danger-soft);
                color: var(--danger);
            }

        .popup-row {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
            border-bottom: 1px solid var(--border);
            font-size: .76rem;
        }

            .popup-row:last-child {
                border-bottom: none;
            }

        .popup-key {
            color: var(--text-muted);
            font-weight: 700;
        }

        .popup-val {
            font-weight: 900;
            color: var(--text);
        }

        .popup-actions {
            display: flex;
            gap: 5px;
            margin-top: 10px;
            flex-wrap: wrap;
        }

            .popup-actions .btn {
                font-size: .7rem;
                padding: 5px 10px;
                border-radius: 8px;
            }

            .popup-actions .btn-success {
                background: var(--success-soft);
                color: var(--success);
                border: 1px solid rgba(47,158,95,.2);
            }

                .popup-actions .btn-success:hover {
                    background: var(--success);
                    color: #fff;
                }

            .popup-actions .btn-danger {
                background: var(--danger-soft);
                color: var(--danger);
                border: 1px solid rgba(217,83,79,.2);
            }

                .popup-actions .btn-danger:hover {
                    background: var(--danger);
                    color: #fff;
                }

            .popup-actions .btn-warning {
                background: var(--warning-soft);
                color: #9b6000;
                border: 1px solid rgba(226,163,58,.2);
            }

            .popup-actions .btn-outline {
                background: #fff;
                color: var(--brand-dark);
                border: 1px solid var(--border);
            }

                .popup-actions .btn-outline:hover {
                    background: var(--brand-ghost);
                    border-color: var(--brand);
                }

        .confirm-overlay {
            position: fixed;
            inset: 0;
            background: rgba(38,31,23,.4);
            backdrop-filter: blur(5px);
            z-index: 1400;
            display: none;
            align-items: center;
            justify-content: center;
        }

            .confirm-overlay.show {
                display: flex;
            }

        .confirm-box {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            padding: 28px;
            width: 340px;
            text-align: center;
            box-shadow: var(--shadow-lg);
        }

        .confirm-ico {
            font-size: 2.5rem;
            margin-bottom: 12px;
            display: block;
        }

        .confirm-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 6px;
        }

        .confirm-sub {
            font-size: .82rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .confirm-btns {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .loc-overlay {
            position: fixed;
            inset: 0;
            background: rgba(38,31,23,.4);
            backdrop-filter: blur(5px);
            z-index: 1350;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .loc-overlay.show {
                display: flex;
            }

        .loc-modal {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: var(--r-xl);
            width: 100%;
            max-width: 400px;
            max-height: 88vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
        }

        .loc-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 1;
        }

        .loc-head-title {
            font-family: 'Fredoka',sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .loc-body {
            padding: 18px;
        }

        .loc-foot {
            padding: 12px 18px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 8px;
        }

        .loc-type-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 6px;
            margin-bottom: 14px;
        }

        .loc-type-btn {
            padding: 10px 4px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: .18s;
            background: #fff;
        }

            .loc-type-btn:hover {
                border-color: var(--brand);
                background: var(--brand-ghost);
            }

            .loc-type-btn.active {
                border-color: var(--brand);
                background: var(--brand-ghost);
            }

        .loc-type-ico {
            font-size: 1.2rem;
            display: block;
            margin-bottom: 3px;
        }

        .loc-type-lbl {
            font-size: .62rem;
            font-weight: 800;
            color: var(--text-muted);
        }

        .loc-type-btn.active .loc-type-lbl {
            color: var(--brand-dark);
        }

        .loc-coord-note {
            background: var(--brand-xlight);
            border: 1px solid rgba(139,169,74,.2);
            border-radius: 10px;
            padding: 8px 12px;
            font-size: .76rem;
            color: var(--brand-dark);
            font-weight: 800;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .field {
            display: grid;
            gap: 5px;
            margin-bottom: 11px;
        }

            .field label {
                font-size: .76rem;
                font-weight: 900;
                color: var(--brand-dark);
            }

            .field input, .field select, .field textarea {
                width: 100%;
                min-height: 40px;
                border: 1.5px solid var(--border);
                border-radius: 10px;
                background: #fff;
                color: var(--text);
                padding: 0 12px;
                outline: none;
                font-size: .84rem;
                font-weight: 700;
                font-family: 'Nunito',sans-serif;
                transition: .18s;
            }

            .field textarea {
                padding: 10px 12px;
                min-height: 80px;
                resize: vertical;
            }

                .field input:focus, .field select:focus, .field textarea:focus {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px rgba(139,169,74,.12);
                }

        .placing-pin {
            position: absolute;
            pointer-events: none;
            z-index: 280;
            transform: translate(-50%,-100%);
        }

        .panel-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(38,31,23,.4);
            backdrop-filter: blur(4px);
            z-index: 180;
        }

            .panel-overlay.show {
                display: block;
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@media(max-width:992px) {
            .map-panel {
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 300px;
                max-width: 84vw;
                z-index: 190;
            }

                .map-panel.collapsed {
                    width: 0;
                }

            .map-toggle {
                left: 0 !important;
            }

                .map-toggle.open {
                    left: 300px !important;
                }

            .map-search-wrap {
                width: calc(100vw - 110px);
                left: 14px;
                transform: none;
            }

            .map-legend {
                max-width: 160px;
            }
        }

        @@media(max-width:600px) {
            .map-popup {
                width: calc(100vw - 28px);
            }

            .confirm-box {
                width: calc(100vw - 24px);
            }

            .loc-modal {
                max-width: calc(100vw - 20px);
            }

            .loc-type-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }
    </style>
</head>
