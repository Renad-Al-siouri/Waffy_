    <div id="toast"></div>
    @Html.AntiForgeryToken()

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/Waffy-Shell.js"></script>
    <script>
        // ════════════════════════════════════════════════════════════════
        // STATE
        // ════════════════════════════════════════════════════════════════
        let map, addMode = false, editingId = null;
        let pendingLat = null, pendingLng = null;
        let allData = { clinics:[], stores:[], dangerReports:[], adminMarkers:[] };
        let leafMarkers = [], panelSearch = '';
        let selectedType = null;

        const COLORS = { clinic:'#00c896', store:'#8b5cf6', danger:'#ef4444', petfriendly:'#f59e0b', playground:'#f59e0b', park:'#10b981' };
        const EMOJIS = { clinic:'🏥', store:'🛍️', danger:'🚨', petfriendly:'🌳', playground:'🎡', park:'🌲' };
        const LABELS = { clinic:'Clinic', store:'Store', danger:'Danger Report', petfriendly:'Pet-Friendly', playground:'Playground', park:'Park' };

        // ════════════════════════════════════════════════════════════════
        // MAP INIT
        // ════════════════════════════════════════════════════════════════
        function initMap() {
            map = L.map('adminMap', { zoomControl: false })
                   .setView([31.9539, 35.9106], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);
            L.control.zoom({ position: 'bottomright' }).addTo(map);

            map.on('click', function(e) {
                if (!addMode) { closeRightPanel(); return; }
                pendingLat = e.latlng.lat.toFixed(6);
                pendingLng = e.latlng.lng.toFixed(6);
                openAddPanel();
            });
        }

        // ════════════════════════════════════════════════════════════════
        // FETCH DATA
        // ════════════════════════════════════════════════════════════════
        async function fetchData() {
            const res = await fetch('/Map/GetMapData');
            allData   = await res.json();
            renderAll();
        }

        function renderAll() {
            renderMapMarkers();
            renderClinics();
            renderStores();
            renderMarkers();
            renderDanger();
            renderStats();
            document.getElementById('dangerBadge').textContent = allData.dangerReports?.length ?? 0;
        }

        // ════════════════════════════════════════════════════════════════
        // MAP MARKERS
        // ════════════════════════════════════════════════════════════════
        function renderMapMarkers() {
            leafMarkers.forEach(m => m.remove());
            leafMarkers = [];
            addMarkerSet(allData.clinics,       'clinic');
            addMarkerSet(allData.stores,        'store');
            addMarkerSet(allData.adminMarkers,  'adminMarker');
            addMarkerSet(allData.dangerReports, 'danger');
        }

        function addMarkerSet(places, type) {
            (places || []).forEach(p => {
                const color = COLORS[p.markerType || type] || '#7fa85a';
                const emoji = EMOJIS[p.markerType || type] || '📍';
                const imgContent = p.image || p.logo
                    ? `<img src="${p.image || p.logo}" alt="" />`
                    : `<span>${emoji}</span>`;

                const icon = L.divIcon({
                    className: '',
                    html: `<div class="am-wrap">
                             <div class="am-pin" style="background:${color}">${imgContent}</div>
                             <div class="am-tail" style="border-top-color:${color}"></div>
                             <div class="am-shadow"></div>
                           </div>`,
                    iconSize  : [40, 52],
                    iconAnchor: [20, 52]
                });

                const m = L.marker([p.lat, p.lng], { icon }).addTo(map);
                m.on('click', e => { L.DomEvent.stopPropagation(e); openDetailPanel(p, p.markerType || type); });
                leafMarkers.push(m);
            });
        }

        // ════════════════════════════════════════════════════════════════
        // LEFT PANEL LISTS
        // ════════════════════════════════════════════════════════════════
        function renderClinics() {
            const items = (allData.clinics || []).filter(bySearch);
            document.getElementById('clinicCnt').textContent = `(${items.length})`;
            document.getElementById('clinicList').innerHTML = items.map(p => readonlyRow(p, 'clinic')).join('') ||
                emptyState('No clinics on map — add Latitude/Longitude in clinic settings');
        }
        function renderStores() {
            const items = (allData.stores || []).filter(bySearch);
            document.getElementById('storeCnt').textContent = `(${items.length})`;
            document.getElementById('storeList').innerHTML = items.map(p => readonlyRow(p, 'store')).join('') ||
                emptyState('No stores on map — add Latitude/Longitude in store settings');
        }
        function renderMarkers() {
            const items = (allData.adminMarkers || []).filter(bySearch);
            document.getElementById('markerCnt').textContent = `(${items.length})`;
            document.getElementById('markerList').innerHTML = items.map(p => editableRow(p)).join('') ||
                emptyState('No markers yet — click "+ Add" to start');
        }
        function renderDanger() {
            const items = (allData.dangerReports || []).filter(bySearch);
            document.getElementById('dangerList').innerHTML = items.map(d => dangerRow(d)).join('') ||
                emptyState('No active danger reports 🎉');
        }
        function renderStats() {
            const c = allData.clinics?.length??0, s = allData.stores?.length??0;
            const d = allData.dangerReports?.length??0, m = allData.adminMarkers?.length??0;
            document.getElementById('statsGrid').innerHTML =
                statCard('🏥','Clinics',c,'#00c896') + statCard('🛍️','Stores',s,'#8b5cf6') +
                statCard('🚨','Danger',d,'#ef4444') + statCard('📍','Markers',m,'#f59e0b');
        }

        function statCard(ico, lbl, val, color) {
            return `<div class="stat-box"><div class="stat-num" style="color:${color}">${val}</div><div style="font-size:1.2rem;margin:4px 0">${ico}</div><div class="stat-lbl">${lbl}</div></div>`;
        }

        function readonlyRow(p, type) {
            const color = COLORS[type], emoji = EMOJIS[type];
            const img   = (p.logo || p.image)
                ? `<div class="prow-img"><img src="${p.logo||p.image}" /></div>`
                : `<div class="prow-img" style="background:${color}15;color:${color}">${emoji}</div>`;
            return `<div class="prow" onclick="flyTo(${p.lat},${p.lng})">
                ${img}
                <div class="prow-body">
                    <div class="prow-name">${p.name}</div>
                    <div class="prow-sub">📍 ${[p.city,p.area].filter(Boolean).join(', ')||'—'}</div>
                </div>
                <span style="font-size:.65rem;font-weight:700;padding:2px 7px;border-radius:20px;background:${color}15;color:${color}">Live</span>
            </div>`;
        }

        function editableRow(p) {
            const color = COLORS[p.markerType] || '#f59e0b';
            const emoji = EMOJIS[p.markerType] || '📍';
            const img   = (p.image || p.logo)
                ? `<div class="prow-img"><img src="${p.image||p.logo}" /></div>`
                : `<div class="prow-img" style="background:${color}15;color:${color}">${emoji}</div>`;
            return `<div class="prow" onclick="flyAndDetail(${p.lat},${p.lng},'${p.markerType}',${JSON.stringify(p).replace(/"/g,"'")})">
                ${img}
                <div class="prow-body">
                    <div class="prow-name">${p.name}</div>
                    <div class="prow-sub">📍 ${[p.city,p.area].filter(Boolean).join(', ')||'—'}</div>
                </div>
                <div class="prow-acts">
                    <button class="prow-btn edit" title="Edit" onclick="event.stopPropagation();openEditPanel(${p.id})">✏️</button>
                    <button class="prow-btn del"  title="Delete" onclick="event.stopPropagation();confirmDelete(${p.id},'${p.name.replace(/'/g,'')}')">🗑</button>
                </div>
            </div>`;
        }

        function dangerRow(d) {
            const sev = d.severity || 'Medium';
            return `<div class="drow" onclick="flyAndDetail(${d.lat},${d.lng},'danger',${JSON.stringify(d).replace(/"/g,"'")})">
                <div class="drow-hd">
                    <div class="drow-name">${d.animalType} — ${d.name?.split('—')[1]?.trim()||''}</div>
                    <span class="drow-sev sev-${sev}">${sev}</span>
                </div>
                <div class="drow-meta">📍 ${[d.city,d.area].filter(Boolean).join(', ')} &nbsp;·&nbsp; ${d.status}</div>
                ${d.reportCode ? `<div class="drow-code">${d.reportCode}</div>` : ''}
                <div class="drow-btns">
                    ${d.status!=='Under Review' ? `<button class="drow-btn review"  onclick="event.stopPropagation();updateDanger(${d.id},'Under Review')">🔍 Review</button>` : ''}
                    ${d.status!=='Resolved'     ? `<button class="drow-btn resolve" onclick="event.stopPropagation();updateDanger(${d.id},'Resolved')">✅ Resolve</button>` : ''}
                    <button class="drow-btn fake" onclick="event.stopPropagation();updateDanger(${d.id},'Resolved')">🚫 Fake</button>
                </div>
            </div>`;
        }

        function emptyState(msg) {
            return `<div class="ls-empty">${msg}</div>`;
        }

        // ════════════════════════════════════════════════════════════════
        // TAB SWITCHING
        // ════════════════════════════════════════════════════════════════
        function switchTab(tab) {
            ['places','danger','stats'].forEach(t => {
                document.getElementById(`lt-${t}`).classList.toggle('active', t===tab);
                document.getElementById(`sec-${t}`).classList.toggle('active', t===tab);
            });
        }

        function filterList(q) {
            panelSearch = q.toLowerCase();
            renderClinics(); renderStores(); renderMarkers(); renderDanger();
        }
        function bySearch(p) {
            if (!panelSearch) return true;
            return (p.name||'').toLowerCase().includes(panelSearch) ||
                   (p.city||'').toLowerCase().includes(panelSearch) ||
                   (p.area||'').toLowerCase().includes(panelSearch);
        }

        // ════════════════════════════════════════════════════════════════
        // ADD MODE
        // ════════════════════════════════════════════════════════════════
        function startAddMode() {
            addMode = true;
            editingId = null;
            pendingLat = null; pendingLng = null;
            document.getElementById('addBanner').classList.add('show');
            document.getElementById('adminMap').style.cursor = 'crosshair';
            closeRightPanel();
        }

        function cancelAddMode() {
            addMode = false;
            document.getElementById('addBanner').classList.remove('show');
            document.getElementById('adminMap').style.cursor = '';
            selectedType = null;
        }

        // ════════════════════════════════════════════════════════════════
        // RIGHT PANEL — TYPE SELECTOR then FORM
        // ════════════════════════════════════════════════════════════════
        function openAddPanel() {
            // Reset
            selectedType = null;
            document.getElementById('rpTitle').textContent = 'Choose Place Type';
            document.getElementById('rpBody').innerHTML = typeSelectorHtml();
            openRightPanel();
            cancelAddMode();   // exit adding mode cursor
        }

        function typeSelectorHtml() {
            const types = [
                { key:'petfriendly', ico:'🌳', name:'Pet-Friendly', desc:'Park, café, or any pet-welcoming place' },
                { key:'playground',  ico:'🎡', name:'Playground',   desc:'Pet playground or play area' },
                { key:'park',        ico:'🌲', name:'Park / Garden', desc:'Public park or outdoor space' }
            ];
            return `<div class="type-selector">
                <div class="ts-label">What are you adding?</div>
                <div class="ts-cards">
                    ${types.map(t => `
                    <div class="ts-card" id="tc-${t.key}" onclick="selectType('${t.key}')">
                        <div class="ts-ico">${t.ico}</div>
                        <div class="ts-name">${t.name}</div>
                        <div class="ts-desc">${t.desc}</div>
                    </div>`).join('')}
                </div>
                <button class="ts-next-btn" id="tsNext" disabled onclick="showAddForm()">
                    Continue →
                </button>
            </div>`;
        }

        function selectType(type) {
            selectedType = type;
            document.querySelectorAll('.ts-card').forEach(c => c.classList.remove('selected'));
            document.getElementById('tc-' + type)?.classList.add('selected');
            document.getElementById('tsNext').disabled = false;
        }

        function showAddForm(prefill) {
            const coordLabel = pendingLat
                ? `✅ ${parseFloat(pendingLat).toFixed(5)}, ${parseFloat(pendingLng).toFixed(5)}`
                : '⚠️ No location set — go back and click on map';
            const isEmpty = !pendingLat;

            document.getElementById('rpTitle').textContent = editingId ? 'Edit Marker' : 'Add Marker Details';
            document.getElementById('rpBody').innerHTML = buildForm(prefill, coordLabel, isEmpty);

            // Preview existing image
            if (prefill?.imageUrl) {
                document.getElementById('imgPreview').src = prefill.imageUrl;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('imgPlaceholder').style.display = 'none';
                document.getElementById('imgArea').classList.add('has-img');
            }
        }

        function buildForm(pf, coordLabel, isEmpty) {
            return `<div class="details-form">
                <div class="coord-pill ${isEmpty ? 'empty' : ''}" id="coordPill">
                    <span>${isEmpty ? '⚠️' : '📍'}</span>
                    <span>${coordLabel}</span>
                    ${editingId ? '<button onclick="repin()" style="margin-left:auto;font-size:.7rem;font-weight:700;border:none;background:transparent;color:#5a7a3e;cursor:pointer">📍 Move Pin</button>' : ''}
                </div>

                <div class="f-sep">📷 Place Photo</div>
                <div class="img-upload-area" id="imgArea" onclick="document.getElementById('imgFile').click()">
                    <div class="img-placeholder" id="imgPlaceholder">
                        <div class="ico">📷</div>
                        <p>Click to upload photo</p>
                        <span>JPG, PNG — max 5MB</span>
                    </div>
                    <img id="imgPreview" class="img-preview" alt="" />
                    <div class="img-change-overlay">🔄 Change Photo</div>
                </div>
                <input type="file" id="imgFile" accept="image/*" onchange="previewImg(this)" />

                <div class="f-sep">📋 Basic Info</div>
                <div class="f-group">
                    <label class="f-label">Place Name <span class="req">*</span></label>
                    <input class="f-input" id="fLabel" type="text" placeholder="e.g. Al Hussein Park" value="${pf?.label||''}" />
                </div>
                <div class="f-grid-2">
                    <div class="f-group">
                        <label class="f-label">City</label>
                        <input class="f-input" id="fCity" type="text" placeholder="Amman" value="${pf?.city||''}" />
                    </div>
                    <div class="f-group">
                        <label class="f-label">Area</label>
                        <input class="f-input" id="fArea" type="text" placeholder="Rabieh" value="${pf?.area||''}" />
                    </div>
                </div>

                <div class="f-sep">📞 Contact & Hours</div>
                <div class="f-group">
                    <label class="f-label">Phone Number</label>
                    <input class="f-input" id="fPhone" type="tel" placeholder="+962 79 123 4567" value="${pf?.phone||pf?.workingHours&&''||''}" />
                </div>
                <div class="f-group">
                    <label class="f-label">Working Hours</label>
                    <input class="f-input" id="fHours" type="text" placeholder="Daily 9AM–10PM / Closed Friday" value="${pf?.hours||pf?.workingHours||''}" />
                </div>
                <div class="f-group">
                    <label class="f-label">Website</label>
                    <input class="f-input" id="fWebsite" type="url" placeholder="https://example.com" value="${pf?.website||''}" />
                </div>

                <div class="f-sep">📝 Description</div>
                <div class="f-group">
                    <label class="f-label">Description</label>
                    <textarea class="f-textarea" id="fDesc" placeholder="Tell users about this place — what makes it special for pet owners?">${pf?.description||''}</textarea>
                </div>
                <div class="f-group">
                    <label class="f-label">Admin Notes (internal)</label>
                    <textarea class="f-textarea" id="fNotes" placeholder="Internal notes — not shown to users" style="min-height:60px">${pf?.notes||''}</textarea>
                </div>

                <input type="hidden" id="fLat" value="${pendingLat||pf?.lat||''}" />
                <input type="hidden" id="fLng" value="${pendingLng||pf?.lng||''}" />

                <button class="f-save-btn" onclick="saveMarker()">
                    💾 ${editingId ? 'Save Changes' : 'Add to Map'}
                </button>
                ${!editingId ? `<button class="f-back-btn" onclick="backToTypeSelector()">← Back</button>` : ''}
            </div>`;
        }

        function backToTypeSelector() {
            selectedType = null;
            document.getElementById('rpTitle').textContent = 'Choose Place Type';
            document.getElementById('rpBody').innerHTML = typeSelectorHtml();
        }

        function previewImg(input) {
            if (!input.files?.[0]) return;
            const r = new FileReader();
            r.onload = e => {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('imgPlaceholder').style.display = 'none';
                document.getElementById('imgArea').classList.add('has-img');
            };
            r.readAsDataURL(input.files[0]);
        }

        function repin() {
            startAddMode();
            showToast('Click on the map to move the pin');
        }

        // ════════════════════════════════════════════════════════════════
        // EDIT
        // ════════════════════════════════════════════════════════════════
        async function openEditPanel(id) {
            editingId = id;
            const res  = await fetch(`/Map/GetMarkerById?id=${id}`);
            const data = await res.json();
            if (!data.success) { showToast('⚠️ Could not load marker'); return; }

            selectedType = data.markerType;
            pendingLat   = String(data.lat);
            pendingLng   = String(data.lng);

            document.getElementById('rpTitle').textContent = 'Edit Marker';
            document.getElementById('rpBody').innerHTML = buildForm(data,
                `📍 ${parseFloat(data.lat).toFixed(5)}, ${parseFloat(data.lng).toFixed(5)}`, false);

            // Show existing image
            if (data.imageUrl) {
                document.getElementById('imgPreview').src = data.imageUrl;
                document.getElementById('imgPreview').style.display = 'block';
                document.getElementById('imgPlaceholder').style.display = 'none';
                document.getElementById('imgArea').classList.add('has-img');
            }

            openRightPanel();
        }

        // ════════════════════════════════════════════════════════════════
        // SAVE
        // ════════════════════════════════════════════════════════════════
        async function saveMarker() {
            const label = document.getElementById('fLabel')?.value.trim();
            const lat   = document.getElementById('fLat')?.value;
            const lng   = document.getElementById('fLng')?.value;

            if (!label) { document.getElementById('fLabel').style.borderColor = '#dc2626'; return; }
            if (!lat)   { showToast('⚠️ Location not set — go back and click on the map'); return; }

            const formData = new FormData();
            formData.append('markerType',  selectedType || 'petfriendly');
            formData.append('label',       label);
            formData.append('latitude',    lat);
            formData.append('longitude',   lng);
            formData.append('city',        document.getElementById('fCity')?.value  || '');
            formData.append('area',        document.getElementById('fArea')?.value  || '');
            formData.append('phone',       document.getElementById('fPhone')?.value || '');
            formData.append('workingHours',document.getElementById('fHours')?.value || '');
            formData.append('description', document.getElementById('fDesc')?.value  || '');
            formData.append('website',     document.getElementById('fWebsite')?.value || '');
            formData.append('notes',       document.getElementById('fNotes')?.value || '');
            formData.append('__RequestVerificationToken', getToken());

            const imgFile = document.getElementById('imgFile')?.files?.[0];
            if (imgFile) formData.append('image', imgFile);

            const url = editingId
                ? `/Map/EditAdminMarker`
                : `/Map/AddAdminMarker`;

            if (editingId) formData.append('id', editingId);

            const res  = await fetch(url, { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                closeRightPanel();
                await fetchData();
                // Fly to the new/edited marker
                map.setView([parseFloat(lat), parseFloat(lng)], 16, { animate: true });
                showToast(editingId ? '✅ Marker updated!' : '✅ Marker added to map!');
                editingId = null;
            } else {
                showToast('⚠️ ' + (data.message || 'Error saving'));
            }
        }

        // ════════════════════════════════════════════════════════════════
        // DETAIL PANEL
        // ════════════════════════════════════════════════════════════════
        function openDetailPanel(p, type) {
            editingId = null;
            const color = COLORS[p.markerType || type] || '#7fa85a';
            const emoji = EMOJIS[p.markerType || type] || '📍';
            const label = LABELS[p.markerType || type] || type;

            document.getElementById('rpTitle').textContent = label + ' Details';

            const photoHtml = (p.image || p.logo)
                ? `<img src="${p.image||p.logo}" alt="${p.name}" />`
                : `<span>${emoji}</span>`;

            const rows = [];
            if (p.city||p.area) rows.push(dRow('📍','Location',[p.city,p.area].filter(Boolean).join(', ')));
            if (p.phone)         rows.push(dRow('📞','Phone',`<a href="tel:${p.phone}" style="color:#5a7a3e">${p.phone}</a>`));
            if (p.hours)         rows.push(dRow('🕐','Hours',p.hours));
            if (p.description)   rows.push(dRow('📝','About',p.description));
            if (p.website)       rows.push(dRow('🌐','Website',`<a href="${p.website}" target="_blank" style="color:#5a7a3e">${p.website}</a>`));
            if (p.notes)         rows.push(dRow('🗒️','Notes',p.notes));
            if (p.reportCode)    rows.push(dRow('🔖','Code',`<code style="font-size:.72rem">${p.reportCode}</code>`));
            if (p.severity)      rows.push(dRow('⚠️','Severity',`<strong class="sev-${p.severity}">${p.severity}</strong>`));
            if (p.hasEmergency)  rows.push(dRow('🚑','Emergency','<strong style="color:#16a34a">24/7 Available</strong>'));

            const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;

            // Danger-specific bar
            const dangerBar = type === 'danger' ? `
                <div class="dv-danger-bar sev-${p.severity||'Medium'}">
                    <span>${p.severity==='High'?'🔴':p.severity==='Low'?'🟢':'🟠'}</span>
                    <span>${p.severity} Severity — ${p.status}</span>
                </div>` : '';

            // Actions
            let actions = `<a class="dv-btn primary" href="${mapsUrl}" target="_blank">🧭 Directions</a>`;
            if (type !== 'clinic' && type !== 'store' && type !== 'danger') {
                actions += `<button class="dv-btn edit" onclick="openEditPanel(${p.id})">✏️ Edit</button>`;
                actions += `<button class="dv-btn danger" onclick="confirmDelete(${p.id},'${(p.name||'').replace(/'/g,'')}')">🗑 Delete</button>`;
                actions += `<button class="dv-btn hide" onclick="toggleHide(${p.id},this)">👁 Hide</button>`;
            }
            if (type === 'danger') {
                if (p.status !== 'Resolved') actions += `<button class="dv-btn edit" onclick="updateDanger(${p.id},'Resolved')">✅ Resolve</button>`;
                actions += `<a class="dv-btn hide" href="/SuperAdmin/Dangerous_Animals">📋 Full Report</a>`;
            }
            if (type === 'clinic') actions += `<a class="dv-btn edit" href="/SuperAdmin/Clinics">⚙️ Manage</a>`;
            if (type === 'store')  actions += `<a class="dv-btn edit" href="/SuperAdmin/Stores">⚙️ Manage</a>`;

            document.getElementById('rpBody').innerHTML = `<div class="detail-view">
                <div class="dv-photo">${photoHtml}</div>
                <div class="dv-name">${p.name}</div>
                <span class="dv-type-badge" style="background:${color}18;color:${color}">${label}</span>
                ${dangerBar}
                ${rows.join('')}
                <div class="dv-actions">${actions}</div>
            </div>`;

            openRightPanel();
        }

        function dRow(ico, key, val) {
            return `<div class="dv-row"><div class="dv-ico">${ico}</div><span class="dv-key">${key}</span><span class="dv-val">${val}</span></div>`;
        }

        // ════════════════════════════════════════════════════════════════
        // API CALLS
        // ════════════════════════════════════════════════════════════════
        async function confirmDelete(id, name) {
            if (!confirm(`Delete "${name}"?`)) return;
            const form = new URLSearchParams({ id, __RequestVerificationToken: getToken() });
            await fetch('/Map/DeleteAdminMarker', { method:'POST', body:form });
            closeRightPanel();
            await fetchData();
            showToast('🗑 Marker deleted');
        }

        async function toggleHide(id, btn) {
            const form = new URLSearchParams({ id, status:'Hidden', __RequestVerificationToken: getToken() });
            await fetch('/Map/ToggleAdminMarker', { method:'POST', body:form });
            closeRightPanel();
            await fetchData();
            showToast('👁 Marker hidden');
        }

        async function updateDanger(id, status) {
            const form = new URLSearchParams({ reportId:id, status, __RequestVerificationToken: getToken() });
            await fetch('/SuperAdmin/UpdateDangerStatus', { method:'POST', body:form });
            await fetchData();
            showToast(status==='Resolved' ? '✅ Report resolved' : '🔍 Under review');
        }

        // ════════════════════════════════════════════════════════════════
        // PANEL HELPERS
        // ════════════════════════════════════════════════════════════════
        function openRightPanel() {
            document.getElementById('rightPanel').classList.add('open');
        }
        function closeRightPanel() {
            document.getElementById('rightPanel').classList.remove('open');
            editingId = null;
        }
        function flyTo(lat, lng) {
            map.setView([lat, lng], 16, { animate: true });
        }
        function flyAndDetail(lat, lng, type, p) {
            map.setView([lat, lng], 16, { animate: true });
            if (typeof p === 'string') p = JSON.parse(p.replace(/'/g, '"'));
            openDetailPanel(p, type);
        }

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg; t.classList.add('show');
            clearTimeout(t._t);
            t._t = setTimeout(() => t.classList.remove('show'), 2800);
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') { cancelAddMode(); closeRightPanel(); }
        });

        // ════════════════════════════════════════════════════════════════
        // BOOT
        // ════════════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', () => { initMap(); fetchData(); });
    </script>
</body>
</html>
