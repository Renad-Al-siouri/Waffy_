                    <div class="api-banner" id="apiBanner">
                        🔑 Add <code style="background:rgba(155,96,0,.1);padding:1px 6px;border-radius:4px;">Google Maps API Key</code> to enable live map
                        <button onclick="document.getElementById('apiBanner').style.display='none'">✕</button>
                    </div>
                    <div class="map-search-wrap">
                        <div class="map-search-box">
                            <span style="color:var(--text-muted);">🔍</span>
                            <input placeholder="Search clinics, animals, areas..." id="mapSearch" oninput="handleSearch(this.value)" />
                            <span id="searchClear" style="cursor:pointer;color:var(--text-muted);display:none;" onclick="clearSearch()">✕</span>
                        </div>
                        <div id="searchResults"></div>
                    </div>
                    <div class="map-toolbar">
                        <div class="tb" onclick="zoomIn()" title="Zoom In">＋</div>
                        <div class="tb" onclick="zoomOut()" title="Zoom Out">－</div>
                        <div class="tb" onclick="resetView()" title="Reset">⊙</div>
                        <div style="height:1px;background:var(--border);margin:2px 0;"></div>
                        <div class="tb" onclick="toggleFullscreen()" title="Fullscreen">⛶</div>
                        <div class="tb" onclick="exportMap()" title="Export">📤</div>
                    </div>
                    <div class="add-bar" id="addBar">
                        <span>📍 Click on the map to place a pin</span>
                        <button onclick="cancelAddMode()">✕ Cancel</button>
                    </div>
                    <div class="map-popup" id="mapPopup">
                        <div class="popup-hd"><div class="popup-title" id="popupTitle">—</div><button class="popup-close" onclick="closePopup()">✕</button></div>
                        <div id="popupBody"></div>
                        <div class="popup-actions" id="popupActions"></div>
                    </div>
                    <div class="map-legend">
                        <div class="legend-title">Map Legend</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#00d4aa;"></div>Veterinary Clinic</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#a78bfa;"></div>Pet Store</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#ff4d6d;"></div>Lost Animal</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#4da6ff;"></div>Found Animal</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#ffd93d;"></div>For Adoption</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#ff9f43;"></div>Danger Report</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#f472b6;"></div>Donation</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#4ade80;"></div>Pet-Friendly</div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- CONFIRM DIALOG -->
    <div class="confirm-overlay" id="confirmOverlay">
        <div class="confirm-box">
            <span class="confirm-ico" id="confirmIco">⚠️</span>
            <div class="confirm-title" id="confirmTitle">Confirm Action</div>
            <div class="confirm-sub" id="confirmSub">Are you sure?</div>
            <div class="confirm-btns">
                <button class="btn btn-outline" onclick="closeConfirm()">Cancel</button>
                <button class="btn btn-danger" id="confirmOkBtn" onclick="execConfirm()">Confirm</button>
            </div>
        </div>
    </div>

    <!-- ADD LOCATION MODAL -->
    <div class="loc-overlay" id="locOverlay">
        <div class="loc-modal">
            <div class="loc-head">
                <div class="loc-head-title" id="locTitle">📍 Add New Location</div>
                <button class="dp-close" onclick="closeLocModal()">✕</button>
            </div>
            <div class="loc-body">
                <div class="loc-type-grid" id="locTypeGrid">
                    <div class="loc-type-btn active" onclick="selLocType(this,'clinics')"><span class="loc-type-ico">🏥</span><span class="loc-type-lbl">Clinic</span></div>
                    <div class="loc-type-btn" onclick="selLocType(this,'stores')"><span class="loc-type-ico">🏪</span><span class="loc-type-lbl">Store</span></div>
                    <div class="loc-type-btn" onclick="selLocType(this,'petfriendly')"><span class="loc-type-ico">🌳</span><span class="loc-type-lbl">Pet-Friendly</span></div>
                    <div class="loc-type-btn" onclick="selLocType(this,'danger')"><span class="loc-type-ico">🚨</span><span class="loc-type-lbl">Danger</span></div>
                </div>
                <div class="loc-coord-note" id="locCoordNote">📍 Click on the map to select a location first</div>
                <div class="field"><label>Name *</label><input type="text" id="locName" placeholder="e.g. Al Amanah Veterinary Clinic" /></div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                    <div class="field"><label>City *</label><select id="locCity"><option>Amman</option><option>Zarqa</option><option>Irbid</option><option>Aqaba</option><option>Salt</option></select></div>
                    <div class="field"><label>Area</label><input type="text" id="locArea" placeholder="e.g. Jubaiha" /></div>
                </div>
                <div id="locExtraFields"></div>
                <div class="field"><label>Notes</label><textarea id="locNotes" placeholder="Additional notes..."></textarea></div>
            </div>
            <div class="loc-foot">
                <button class="btn btn-primary" onclick="saveLocation()" style="flex:1;justify-content:center;">💾 Save Location</button>
                <button class="btn btn-outline" onclick="closeLocModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        const mapData={
          clinics:[{id:'c1',name:'Al Amanah Veterinary Clinic',city:'Amman',area:'Jubaiha',status:'active',rating:4.5,x:18,y:28,radius:5},{id:'c2',name:'Al Rahma Veterinary Clinic',city:'Amman',area:'Rabieh',status:'active',rating:4.2,x:45,y:50,radius:3},{id:'c3',name:'Animal Medical Center',city:'Amman',area:'Gardens',status:'active',rating:4.8,x:28,y:65,radius:7},{id:'c4',name:'Sahl Clinic',city:'Amman',area:'Sweileh',status:'active',rating:3.9,x:62,y:22,radius:4}],
          stores:[{id:'s1',name:'Animal Friends Store',city:'Amman',area:"Tla' Al-Ali",status:'active',x:70,y:38,radius:4},{id:'s2',name:'Pet Care Pharmacy',city:'Amman',area:'Jubaiha',status:'active',x:22,y:42,radius:3},{id:'s3',name:'Colorful Birds Store',city:'Amman',area:'Rabieh',status:'active',x:50,y:60,radius:3}],
          lost:[{id:'l1',name:'Bobby',type:'🐕 Dog',breed:'Husky',city:'Amman',area:'Jubaiha',date:'10/3',reward:25,x:15,y:25},{id:'l2',name:'Mishmish',type:'🐈 Cat',breed:'Persian',city:'Amman',area:'Rabieh',date:'8/3',reward:10,x:48,y:48},{id:'l3',name:'Rio',type:'🐦 Bird',breed:'Parrot',city:'Amman',area:'Sweileh',date:'9/3',reward:0,x:65,y:20},{id:'l4',name:'Max',type:'🐕 Dog',breed:'Labrador',city:'Amman',area:'Gardens',date:'5/3',reward:50,x:25,y:70}],
          found:[{id:'f1',name:'Golden Dog',type:'🐕 Dog',city:'Amman',area:'Jubaiha',date:'12/3',finder:'Karim',x:20,y:32},{id:'f2',name:'Black Cat',type:'🐈 Cat',city:'Amman',area:'Rabieh',date:'11/3',finder:'Reem',x:43,y:55}],
          adoption:[{id:'a1',name:'Soso',type:'🐈 Cat',city:'Amman',area:'Gardens',x:30,y:68},{id:'a2',name:'Falafel',type:'🐈 Cat',city:'Amman',area:'Jubaiha',x:12,y:38},{id:'a3',name:'Coco',type:'🐦 Bird',city:'Amman',area:"Tla' Al-Ali",x:72,y:42}],
          danger:[{id:'d1',type:'Aggressive',animal:'🐕 Dog',city:'Amman',area:'Jubaiha',sev:'high',x:17,y:22},{id:'d2',type:'Injured',animal:'🐈 Cat',city:'Amman',area:'Rabieh',sev:'med',x:42,y:53},{id:'d3',type:'Stray',animal:'🐕 Dog',city:'Amman',area:'Sweileh',sev:'low',x:68,y:18}],
          donation:[{id:'dn1',name:'Rex',need:'💊 Fracture Treatment',goal:150,raised:80,x:55,y:35},{id:'dn2',name:'Luna',need:'🍖 Food',goal:50,raised:32,x:35,y:62}],
          petfriendly:[{id:'pf1',name:'Al Hussein Park',subtype:'park',subtypeAr:'🌳 Park',city:'Amman',area:'Rabieh',rating:4.6,allowedPets:['Dogs','Cats'],hours:'7AM–10PM',notes:'Off-leash dog area',x:38,y:30},{id:'pf2',name:'Barker Café',subtype:'cafe',subtypeAr:'☕ Café',city:'Amman',area:'Jubaiha',rating:4.8,allowedPets:['Dogs','Cats'],hours:'9AM–11PM',notes:'Pets welcome inside',x:20,y:55},{id:'pf3',name:'Paws Dog Park',subtype:'dogpark',subtypeAr:'🐕 Dog Park',city:'Amman',area:'Sweileh',rating:4.9,allowedPets:['Dogs'],hours:'6AM–9PM',notes:'Fenced dog-only area',x:60,y:40},{id:'pf4',name:'Green Valley Hotel',subtype:'hotel',subtypeAr:'🏨 Hotel',city:'Amman',area:'Gardens',rating:4.3,allowedPets:['Dogs','Cats'],hours:'24 Hours',notes:'Pets up to 10kg allowed',x:32,y:72}]
        };
        const layerColors={clinics:'#00d4aa',stores:'#a78bfa',lost:'#ff4d6d',found:'#4da6ff',adoption:'#ffd93d',danger:'#ff9f43',donation:'#f472b6',petfriendly:'#4ade80'};
        const layerIcons={clinics:'🏥',stores:'🏪',lost:'🔍',found:'✅',adoption:'🐾',danger:'🚨',donation:'❤️',petfriendly:'🌳'};
        const layerState={clinics:true,stores:true,lost:true,found:true,adoption:true,danger:true,donation:true,petfriendly:true};
        let heatmapOn=false,radiusOn=false,addModeOn=false,pendingCoord=null,editingItem=null,editingLayer=null,confirmCallback=null,selectedLocType='clinics',mapScale=1,mapPanelOpen=true;

        function renderMarkers(){
          const c=document.getElementById('markersContainer');if(!c)return;c.innerHTML='';
          Object.entries(mapData).forEach(([layer,items])=>{
            if(!layerState[layer])return;
            const color=layerColors[layer],icon=layerIcons[layer];
            items.forEach(item=>{
              const m=document.createElement('div');m.className='marker';m.style.cssText=`left:${item.x}%;top:${item.y}%`;
              m.innerHTML=`${layer==='danger'?`<div class="m-pulse" style="background:${color}20;box-shadow:0 0 0 0 ${color}50;"></div>`:''}
                <div class="m-pin" style="background:${color}22;border-color:${color}"><span>${icon}</span></div>
                <div class="m-lbl">${item.name||item.type||item.animal||''}</div>`;
              m.onclick=(e)=>{e.stopPropagation();showPopup(item,layer,e.clientX,e.clientY);};
              c.appendChild(m);
            });
          });
        }

        function showPopup(item,layer,cx,cy){
          const popup=document.getElementById('mapPopup');
          const rect=document.getElementById('mapContainer').getBoundingClientRect();
          let left=cx-rect.left+10,top=cy-rect.top-10;
          if(left+260>rect.width)left=cx-rect.left-270;
          if(top+300>rect.height)top=cy-rect.top-290;
          popup.style.left=`${Math.max(10,left)}px`;popup.style.top=`${Math.max(10,top)}px`;
          let title='',rows=[],actions=[];
          if(layer==='clinics'){title=`🏥 ${item.name}`;rows=[['Area',item.area],['Rating',`⭐ ${item.rating}`],['Radius',`${item.radius} km`],['Status','<span class="badge badge-success">Active</span>']];actions=[`<button class="btn btn-outline" onclick="showRadius(mapData.clinics.find(i=>i.id==='${item.id}'))">⭕ Radius</button>`,`<button class="btn btn-outline" onclick="openEdit(mapData.clinics.find(i=>i.id==='${item.id}'),'clinics')">✏️ Edit</button>`,`<button class="btn btn-warning" onclick="confirmDeactivate(mapData.clinics.find(i=>i.id==='${item.id}'),'clinics')">⏸</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.clinics.find(i=>i.id==='${item.id}'),'clinics')">🗑</button>`];}
          else if(layer==='stores'){title=`🏪 ${item.name}`;rows=[['Area',item.area],['Delivery Radius',`${item.radius} km`],['Status','<span class="badge badge-success">Active</span>']];actions=[`<button class="btn btn-outline" onclick="showRadius(mapData.stores.find(i=>i.id==='${item.id}'))">⭕ Radius</button>`,`<button class="btn btn-outline" onclick="openEdit(mapData.stores.find(i=>i.id==='${item.id}'),'stores')">✏️ Edit</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.stores.find(i=>i.id==='${item.id}'),'stores')">🗑</button>`];}
          else if(layer==='lost'){title=`🔍 Lost: ${item.name}`;rows=[['Type',item.type],['Breed',item.breed],['Area',item.area],['Date Lost',item.date],['Reward',item.reward?`${item.reward} JD`:'—']];actions=[`<button class="btn btn-success">✓ Found</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.lost.find(i=>i.id==='${item.id}'),'lost')">🗑</button>`];}
          else if(layer==='found'){title=`✅ ${item.name}`;rows=[['Type',item.type],['Area',item.area],['Found By',item.finder],['Date',item.date]];actions=[`<button class="btn btn-danger" onclick="confirmDelete(mapData.found.find(i=>i.id==='${item.id}'),'found')">🗑</button>`];}
          else if(layer==='adoption'){title=`🐾 ${item.name} — Adoption`;rows=[['Type',item.type],['Area',item.area],['Status','<span class="badge badge-info">Available</span>']];actions=[`<button class="btn btn-primary">View Listing</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.adoption.find(i=>i.id==='${item.id}'),'adoption')">🗑</button>`];}
          else if(layer==='danger'){title=`🚨 ${item.type} Report`;const sb=item.sev==='high'?'<span class="badge badge-danger">🔴 High</span>':item.sev==='med'?'<span class="badge badge-warning">🟠 Medium</span>':'<span class="badge badge-success">🟢 Low</span>';rows=[['Animal',item.animal],['Area',item.area],['Severity',sb]];actions=[`<button class="btn btn-danger">📨 Notify</button>`,`<button class="btn btn-success" onclick="confirmDelete(mapData.danger.find(i=>i.id==='${item.id}'),'danger')">✅ Close</button>`,`<button class="btn btn-outline" onclick="confirmFake(mapData.danger.find(i=>i.id==='${item.id}'),'danger')">🚫 Fake</button>`];}
          else if(layer==='donation'){const pct=Math.round(item.raised/item.goal*100);title=`❤️ ${item.name}`;rows=[['Need',item.need],['Goal',`${item.goal} JD`],['Raised',`${item.raised} JD`],['Progress',`<div style="background:var(--border);border-radius:3px;height:4px;width:80px;"><div style="width:${pct}%;height:100%;background:var(--success);border-radius:3px;"></div></div>`]];actions=[`<button class="btn btn-primary">💰 Donate</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.donation.find(i=>i.id==='${item.id}'),'donation')">🗑</button>`];}
          else if(layer==='petfriendly'){const ico={park:'🌳',cafe:'☕',dogpark:'🐕',hotel:'🏨'}[item.subtype]||'📍';title=`${ico} ${item.name}`;rows=[['Type',item.subtypeAr],['Area',item.area],['Hours',item.hours||'—'],['Rating',`⭐ ${item.rating}`],['Pets',Array.isArray(item.allowedPets)?item.allowedPets.join(', '):item.allowedPets||'—']];if(item.notes)rows.push(['Notes',item.notes]);actions=[`<button class="btn btn-outline" onclick="openEdit(mapData.petfriendly.find(i=>i.id==='${item.id}'),'petfriendly')">✏️ Edit</button>`,`<button class="btn btn-danger" onclick="confirmDelete(mapData.petfriendly.find(i=>i.id==='${item.id}'),'petfriendly')">🗑</button>`];}
          document.getElementById('popupTitle').innerHTML=title;
          document.getElementById('popupBody').innerHTML=rows.map(([k,v])=>`<div class="popup-row"><span class="popup-key">${k}</span><span class="popup-val">${v}</span></div>`).join('');
          document.getElementById('popupActions').innerHTML=actions.join('');
          popup.style.display='block';
        }
        function closePopup(){document.getElementById('mapPopup').style.display='none';}

        function showRadius(item){
          if(!radiusOn)return;
          const c=document.getElementById('radiiContainer');
          const ex=document.getElementById(`rad-${item.id}`);if(ex){ex.remove();return;}
          const mapEl=document.getElementById('mapContainer');
          const pxPerKm=mapEl.offsetWidth*0.028;const size=item.radius*pxPerKm*2;
          const lk=item.id?.startsWith('c')?'clinics':'stores';
          const div=document.createElement('div');div.id=`rad-${item.id}`;div.className='radius-circle';
          div.style.cssText=`width:${size}px;height:${size}px;left:${item.x}%;top:${item.y}%;border-color:${layerColors[lk]};background:${layerColors[lk]}10;display:block;`;
          c.appendChild(div);
        }
        function toggleLayer(layer){layerState[layer]=!layerState[layer];document.getElementById(`tog-${layer}`)?.classList.toggle('on',layerState[layer]);renderMarkers();}
        function toggleHeatmap(){heatmapOn=!heatmapOn;document.getElementById('tog-heatmap').classList.toggle('on',heatmapOn);['heat1','heat2','heat3','heat4'].forEach(id=>document.getElementById(id).classList.toggle('show',heatmapOn));}
        function toggleRadius(){radiusOn=!radiusOn;document.getElementById('tog-radius').classList.toggle('on',radiusOn);if(!radiusOn)document.getElementById('radiiContainer').innerHTML='';}
        function switchPanel(name,btn){document.querySelectorAll('.mp-tab').forEach(t=>t.classList.remove('active'));document.querySelectorAll('.mp-section').forEach(s=>s.classList.remove('active'));if(btn)btn.classList.add('active');document.getElementById(`panel-${name}`)?.classList.add('active');}
        function toggleMapPanel(){const panel=document.getElementById('mapPanel');const toggle=document.getElementById('mapToggle');const overlay=document.getElementById('panelOverlay');mapPanelOpen=!mapPanelOpen;panel.classList.toggle('collapsed',!mapPanelOpen);toggle.textContent=mapPanelOpen?'‹':'›';toggle.classList.toggle('collapsed',!mapPanelOpen);if(window.innerWidth<=992){overlay.classList.toggle('show',mapPanelOpen);document.getElementById('panelCloseBtn').style.display=mapPanelOpen?'block':'none';}}
        function closeMapPanel(){const panel=document.getElementById('mapPanel');const toggle=document.getElementById('mapToggle');const overlay=document.getElementById('panelOverlay');mapPanelOpen=false;panel.classList.add('collapsed');toggle.textContent='›';toggle.classList.add('collapsed');overlay.classList.remove('show');}
        function zoomIn(){mapScale=Math.min(2,mapScale+.15);document.getElementById('markersContainer').style.transform=`scale(${mapScale})`;}
        function zoomOut(){mapScale=Math.max(.5,mapScale-.15);document.getElementById('markersContainer').style.transform=`scale(${mapScale})`;}
        function resetView(){mapScale=1;document.getElementById('markersContainer').style.transform='scale(1)';closePopup();}
        function toggleFullscreen(){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen();}
        function exportMap(){toast('Map export coming soon!','success');}
        function handleSearch(q){const results=document.getElementById('searchResults');const clear=document.getElementById('searchClear');clear.style.display=q.trim()?'block':'none';if(!q.trim()){results.style.display='none';return;}const all=[...mapData.clinics,...mapData.stores,...mapData.lost,...mapData.found].map(i=>({...i,layer:i.id?.startsWith('c')?'clinics':i.id?.startsWith('s')?'stores':i.id?.startsWith('l')?'lost':'found'}));const filtered=all.filter(i=>(i.name||'').toLowerCase().includes(q.toLowerCase())||(i.area||'').toLowerCase().includes(q.toLowerCase()));if(!filtered.length){results.style.display='none';return;}results.innerHTML=filtered.slice(0,5).map(i=>`<div class="sr-item" onclick="selectSearchResult('${i.id}','${i.layer}')"><span>${layerIcons[i.layer]}</span><div><strong>${i.name||i.type}</strong><br/><small>📍 ${i.area}</small></div></div>`).join('');results.style.display='block';}
        function selectSearchResult(id,layer){document.getElementById('searchResults').style.display='none';const item=mapData[layer]?.find(i=>i.id===id);if(!item)return;const rect=document.getElementById('mapContainer').getBoundingClientRect();showPopup(item,layer,rect.left+item.x/100*rect.width,rect.top+item.y/100*rect.height);}
        function clearSearch(){document.getElementById('mapSearch').value='';document.getElementById('searchResults').style.display='none';document.getElementById('searchClear').style.display='none';}
        function toggleAddMode(){addModeOn=!addModeOn;document.getElementById('addLocBtn').classList.toggle('on',addModeOn);document.getElementById('addBar').classList.toggle('show',addModeOn);document.getElementById('mapContainer').style.cursor=addModeOn?'crosshair':'default';if(!addModeOn){pendingCoord=null;const pp=document.getElementById('placingPin');if(pp)pp.remove();}closePopup();}
        function cancelAddMode(){addModeOn=false;document.getElementById('addLocBtn').classList.remove('on');document.getElementById('addBar').classList.remove('show');document.getElementById('mapContainer').style.cursor='default';pendingCoord=null;const pp=document.getElementById('placingPin');if(pp)pp.remove();}
        function handleMapClick(e){
          const mapBg=e.target===document.getElementById('mapContainer')||e.target.classList.contains('map-grid')||e.target.classList.contains('road')||e.target.classList.contains('area-lbl')||e.target.classList.contains('heat-blob');
          if(addModeOn&&mapBg){
            const rect=document.getElementById('mapContainer').getBoundingClientRect();
            const xPct=((e.clientX-rect.left)/rect.width*100).toFixed(1);const yPct=((e.clientY-rect.top)/rect.height*100).toFixed(1);
            pendingCoord={x:parseFloat(xPct),y:parseFloat(yPct)};
            let pp=document.getElementById('placingPin');
            if(!pp){pp=document.createElement('div');pp.id='placingPin';pp.className='placing-pin';pp.innerHTML=`<div style="width:30px;height:34px;border-radius:50% 50% 50% 0;background:rgba(139,169,74,.2);border:2px dashed var(--brand);display:flex;align-items:center;justify-content:center;transform:rotate(-45deg);"><span style="transform:rotate(45deg);">📍</span></div>`;document.getElementById('mapContainer').appendChild(pp);}
            pp.style.left=`${xPct}%`;pp.style.top=`${yPct}%`;
            document.getElementById('locCoordNote').textContent=`✅ Selected: ${xPct}%, ${yPct}%`;
            document.getElementById('locTitle').textContent='📍 Add New Location';
            editingItem=null;editingLayer=null;document.getElementById('locName').value='';document.getElementById('locArea').value='';
            updateExtraFields(selectedLocType);document.getElementById('locOverlay').classList.add('show');return;
          }
          if(mapBg)closePopup();
        }
        document.getElementById('mapContainer').addEventListener('mousemove',(e)=>{const rect=document.getElementById('mapContainer').getBoundingClientRect();const x=((e.clientX-rect.left)/rect.width*100).toFixed(1);const y=((e.clientY-rect.top)/rect.height*100).toFixed(1);document.getElementById('coordDisplay').textContent=`📍 ${x}%, ${y}%`;});
        function selLocType(btn,type){document.querySelectorAll('.loc-type-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');selectedLocType=type;updateExtraFields(type);}
        function updateExtraFields(type){const el=document.getElementById('locExtraFields');if(type==='clinics'){el.innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"><div class="field"><label>Rating</label><input type="number" id="locRating" min="1" max="5" step="0.1" placeholder="4.5"/></div><div class="field"><label>Radius (km)</label><input type="number" id="locRadius" min="1" max="20" placeholder="5"/></div></div>`;}else if(type==='stores'){el.innerHTML=`<div class="field"><label>Delivery Radius (km)</label><input type="number" id="locRadius" min="1" max="20" placeholder="3"/></div>`;}else{el.innerHTML='';}if(editingItem)fillEdit(type,editingItem);}
        function fillEdit(type,item){if(type==='clinics'){const r=document.getElementById('locRating');const rd=document.getElementById('locRadius');if(r)r.value=item.rating||'';if(rd)rd.value=item.radius||'';}else if(type==='stores'){const rd=document.getElementById('locRadius');if(rd)rd.value=item.radius||'';}}
        function openEdit(item,layer){editingItem=item;editingLayer=layer;document.getElementById('locTitle').textContent='✏️ Edit Location';document.getElementById('locName').value=item.name||'';document.getElementById('locCity').value=item.city||'Amman';document.getElementById('locArea').value=item.area||'';document.getElementById('locNotes').value=item.notes||'';document.getElementById('locCoordNote').textContent=`📍 Current: ${item.x}%, ${item.y}%`;selectedLocType=layer;document.querySelectorAll('.loc-type-btn').forEach((b,i)=>{const map=['clinics','stores','petfriendly','danger'];b.classList.toggle('active',map[i]===layer);});updateExtraFields(layer);document.getElementById('locOverlay').classList.add('show');}
        function closeLocModal(){document.getElementById('locOverlay').classList.remove('show');if(!editingItem)cancelAddMode();editingItem=null;editingLayer=null;}
        function saveLocation(){const name=document.getElementById('locName').value.trim();if(!name){document.getElementById('locName').style.borderColor='var(--danger)';return;}const coord=pendingCoord||(editingItem?{x:editingItem.x,y:editingItem.y}:{x:50,y:50});const city=document.getElementById('locCity').value;const area=document.getElementById('locArea').value.trim();const notes=document.getElementById('locNotes').value.trim();if(editingItem){Object.assign(editingItem,{name,city,area,notes});if(selectedLocType==='clinics'){editingItem.rating=parseFloat(document.getElementById('locRating')?.value)||editingItem.rating;editingItem.radius=parseInt(document.getElementById('locRadius')?.value)||editingItem.radius;}else if(selectedLocType==='stores'){editingItem.radius=parseInt(document.getElementById('locRadius')?.value)||editingItem.radius;}toast('Location updated.','success');}else{const newId=selectedLocType[0]+Date.now();const newItem={id:newId,name,city,area,x:coord.x,y:coord.y,status:'active',notes};if(selectedLocType==='clinics'){newItem.rating=parseFloat(document.getElementById('locRating')?.value)||4.0;newItem.radius=parseInt(document.getElementById('locRadius')?.value)||3;}else if(selectedLocType==='stores'){newItem.radius=parseInt(document.getElementById('locRadius')?.value)||3;}else if(selectedLocType==='danger'){newItem.type='Stray';newItem.animal='🐕 Dog';newItem.sev='low';}mapData[selectedLocType].push(newItem);toast('Location added.','success');}renderMarkers();closeLocModal();cancelAddMode();}
        function confirmDelete(item,layer){confirmCallback=()=>{const idx=mapData[layer].findIndex(i=>i.id===item.id);if(idx>-1)mapData[layer].splice(idx,1);renderMarkers();closePopup();toast('Deleted.','danger');};showConfirm('🗑','Delete Item',`Delete "${item.name||item.type||item.animal}"? Cannot be undone.`,'btn btn-danger','Delete');}
        function confirmDeactivate(item,layer){confirmCallback=()=>{item.status='inactive';renderMarkers();closePopup();toast('Deactivated.','warning');};showConfirm('⏸','Deactivate',`Deactivate "${item.name||item.type}"?`,'btn btn-warning','Deactivate');}
        function confirmFake(item,layer){confirmCallback=()=>{const idx=mapData[layer].findIndex(i=>i.id===item.id);if(idx>-1)mapData[layer].splice(idx,1);renderMarkers();closePopup();toast('Marked as fake.','warning');};showConfirm('🚫','Fake Report',`Mark "${item.name||item.type||item.animal}" as fake?`,'btn btn-warning','Yes, Mark as Fake');}
        function showConfirm(ico,title,sub,btnCls,btnLbl){document.getElementById('confirmIco').textContent=ico;document.getElementById('confirmTitle').textContent=title;document.getElementById('confirmSub').textContent=sub;const btn=document.getElementById('confirmOkBtn');btn.className=btnCls;btn.textContent=btnLbl;document.getElementById('confirmOverlay').classList.add('show');}
        function closeConfirm(){document.getElementById('confirmOverlay').classList.remove('show');confirmCallback=null;}
        function execConfirm(){const cb=confirmCallback;closeConfirm();if(cb)cb();}
        function renderStats(){const areas=[{name:'Jubaiha',count:8,pct:100},{name:'Rabieh',count:5,pct:62},{name:'Gardens',count:4,pct:50},{name:'Sweileh',count:3,pct:37},{name:"Tla' Al-Ali",count:2,pct:25}];document.getElementById('areaStats').innerHTML=areas.map(a=>`<div class="bar-item"><span class="bar-lbl">${a.name}</span><div class="bar-track"><div class="bar-fill" style="width:${a.pct}%"></div></div><span class="bar-num">${a.count}</span></div>`).join('');const types=[{name:'🐕 Dogs',count:5,pct:62},{name:'🐈 Cats',count:2,pct:25},{name:'🐦 Birds',count:1,pct:13}];document.getElementById('typeStats').innerHTML=types.map(t=>`<div class="bar-item"><span class="bar-lbl">${t.name}</span><div class="bar-track"><div class="bar-fill" style="width:${t.pct}%;background:var(--brand-light);"></div></div><span class="bar-num">${t.count}</span></div>`).join('');}
        function renderAlerts(){const hi=[{ico:'🚨',bg:'rgba(217,83,79,.12)',title:'Aggressive Dog — Jubaiha',sub:'Attacking pedestrians near the school',time:'20 min ago'},{ico:'🆘',bg:'rgba(217,83,79,.12)',title:'Urgent Rescue — Jubaiha',sub:'Injured dog on main road',time:'35 min ago'}];const med=[{ico:'🔍',bg:'rgba(226,163,58,.12)',title:'Lost: Bobby (Husky)',sub:'Jubaiha — Reward 25 JD',time:'1 hour ago'},{ico:'🐈',bg:'rgba(47,158,95,.12)',title:'Found: Black Cat — Rabieh',sub:'Found report submitted',time:'2 hours ago'},{ico:'❤️',bg:'rgba(217,83,79,.12)',title:'Donation: Rex',sub:'Needs 70 JD more',time:'3 hours ago'}];document.getElementById('alertsHigh').innerHTML=hi.map(a=>`<div class="alert-item"><div class="alert-ico" style="background:${a.bg}">${a.ico}</div><div style="flex:1;"><div class="alert-title">${a.title}</div><div class="alert-sub">${a.sub}</div><div class="alert-time">${a.time}</div></div></div>`).join('');document.getElementById('alertsMed').innerHTML=med.map(a=>`<div class="alert-item"><div class="alert-ico" style="background:${a.bg}">${a.ico}</div><div style="flex:1;"><div class="alert-title">${a.title}</div><div class="alert-sub">${a.sub}</div><div class="alert-time">${a.time}</div></div></div>`).join('');}
        function toast(msg,type='success'){const bg={success:'var(--success-soft)',danger:'var(--danger-soft)',warning:'var(--warning-soft)'};const col={success:'var(--success)',danger:'var(--danger)',warning:'#9b6000'};const t=document.createElement('div');t.style.cssText=`position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;`;t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),3000);}
        document.addEventListener('click',e=>{if(!e.target.closest('.map-search-wrap'))document.getElementById('searchResults').style.display='none';});
        document.addEventListener('keydown',e=>{if(e.key==='Escape'){closePopup();closeConfirm();closeLocModal();}});
        renderMarkers();renderStats();renderAlerts();
    </script>
</body>
</html>
