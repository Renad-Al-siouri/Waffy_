@{
    ViewData["Title"] = "Map Management — Waffy Admin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        .wa-main {
            padding: 0 !important;
            overflow: hidden;
        }

        /* ═══════════════════════════════════════════════════════
                   SHELL
                ═══════════════════════════════════════════════════════ */
        .amap-shell {
            display: flex;
            height: calc(100vh - var(--tn-h, 56px));
        }

        /* ═══════════════════════════════════════════════════════
                   LEFT PANEL — fixed 320px
                ═══════════════════════════════════════════════════════ */
        .amap-left {
            width: 320px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: #fff;
            border-right: 1px solid #ece6df;
            overflow: hidden;
        }

        /* Tabs */
        .left-tabs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            border-bottom: 1px solid #ece6df;
            flex-shrink: 0;
        }

        .lt {
            padding: 13px 6px 11px;
            border: none;
            background: transparent;
            font-family: 'DM Sans', sans-serif;
            font-size: .76rem;
            font-weight: 600;
            color: #9a8a78;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color .18s;
        }

            .lt .lt-ico {
                font-size: 1.05rem;
            }

            .lt.active {
                color: #1a1612;
                border-bottom-color: #5a7a3e;
                font-weight: 700;
            }

        .lt-badge {
            background: #fee2e2;
            color: #dc2626;
            border-radius: 50px;
            padding: 0 6px;
            font-size: .63rem;
            font-weight: 800;
        }

        .lt.active .lt-badge {
            background: #e8f5d8;
            color: #3d7a2a;
        }

        /* Search bar */
        .left-search {
            padding: 10px 14px;
            border-bottom: 1px solid #ece6df;
            flex-shrink: 0;
        }

        .ls-wrap {
            display: flex;
            align-items: center;
            gap: 7px;
            background: #f7f3ee;
            border-radius: 10px;
            padding: 0 12px;
            height: 36px;
        }

            .ls-wrap input {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'DM Sans', sans-serif;
                font-size: .82rem;
                color: #1a1612;
                width: 100%;
            }

                .ls-wrap input::placeholder {
                    color: #bab0a4;
                }

        /* Sections */
        .left-sec {
            display: none;
            flex: 1;
            overflow: hidden;
            flex-direction: column;
        }

            .left-sec.active {
                display: flex;
            }

        .ls-sub-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px 6px;
            flex-shrink: 0;
        }

        .ls-sub-title {
            font-size: .68rem;
            font-weight: 800;
            color: #9a8a78;
            letter-spacing: .9px;
            text-transform: uppercase;
        }

        .ls-add-btn {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 20px;
            border: none;
            background: #1a1612;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: .7rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .18s;
        }

            .ls-add-btn:hover {
                opacity: .85;
            }

        .ls-list {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #e0d8d0 transparent;
        }

        /* Place row */
        .prow {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 14px;
            border-bottom: 1px solid #f5f0eb;
            cursor: pointer;
            transition: background .14s;
        }

            .prow:hover {
                background: #faf7f3;
            }

            .prow.selected {
                background: #f0f7e8;
            }

        .prow-img {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

            .prow-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .prow-body {
            flex: 1;
            min-width: 0;
        }

        .prow-name {
            font-size: .83rem;
            font-weight: 600;
            color: #1a1612;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .prow-sub {
            font-size: .7rem;
            color: #9a8a78;
            font-weight: 500;
            margin-top: 1px;
        }

        .prow-acts {
            display: flex;
            gap: 5px;
            flex-shrink: 0;
        }

        .prow-btn {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            border: none;
            background: #f0ebe4;
            color: #9a8a78;
            font-size: .7rem;
            cursor: pointer;
            display: grid;
            place-items: center;
            transition: .15s;
        }

            .prow-btn:hover {
                background: #e8e0d8;
                color: #1a1612;
            }

            .prow-btn.del:hover {
                background: #fce8e8;
                color: #dc2626;
            }

            .prow-btn.edit:hover {
                background: #e8f5d8;
                color: #3d7a2a;
            }

        /* Danger rows */
        .drow {
            padding: 11px 14px;
            border-bottom: 1px solid #f5f0eb;
            cursor: pointer;
            transition: background .14s;
        }

            .drow:hover {
                background: #faf7f3;
            }

        .drow-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        .drow-name {
            font-size: .83rem;
            font-weight: 700;
            color: #1a1612;
        }

        .drow-sev {
            padding: 2px 8px;
            border-radius: 20px;
            font-size: .65rem;
            font-weight: 800;
        }

        .sev-High {
            background: #fee2e2;
            color: #dc2626;
        }

        .sev-Medium {
            background: #fff3e0;
            color: #b45309;
        }

        .sev-Low {
            background: #f0fdf4;
            color: #16a34a;
        }

        .drow-meta {
            font-size: .71rem;
            color: #9a8a78;
            font-weight: 500;
        }

        .drow-code {
            font-family: monospace;
            font-size: .66rem;
            color: #b0a090;
            margin-top: 3px;
        }

        .drow-btns {
            display: flex;
            gap: 6px;
            margin-top: 7px;
        }

        .drow-btn {
            padding: 3px 9px;
            border-radius: 20px;
            border: none;
            font-family: 'DM Sans', sans-serif;
            font-size: .68rem;
            font-weight: 700;
            cursor: pointer;
        }

            .drow-btn.review {
                background: #fff3e0;
                color: #b45309;
            }

            .drow-btn.resolve {
                background: #f0fdf4;
                color: #16a34a;
            }

            .drow-btn.fake {
                background: #f5f0eb;
                color: #9a8a78;
            }

        /* Stats */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 14px;
        }

        .stat-box {
            background: #f7f3ee;
            border-radius: 14px;
            padding: 14px;
            text-align: center;
        }

        .stat-num {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            font-weight: 800;
            line-height: 1;
        }

        .stat-lbl {
            font-size: .68rem;
            color: #9a8a78;
            font-weight: 600;
            margin-top: 4px;
        }

        /* Empty state */
        .ls-empty {
            padding: 28px 16px;
            text-align: center;
            color: #b0a090;
            font-size: .8rem;
        }

        /* ═══════════════════════════════════════════════════════
                   MAP AREA
                ═══════════════════════════════════════════════════════ */
        .amap-map {
            flex: 1;
            position: relative;
        }

        #adminMap {
            width: 100%;
            height: 100%;
        }

        /* Adding mode banner */
        .add-banner {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a1612;
            color: #fff;
            padding: 11px 24px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 700;
            z-index: 400;
            display: none;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 28px rgba(0,0,0,.25);
            white-space: nowrap;
            animation: slideDown .3s ease;
        }

            .add-banner.show {
                display: flex;
            }

            .add-banner .cancel-btn {
                background: rgba(255,255,255,.15);
                border: none;
                color: #fff;
                font-family: 'DM Sans', sans-serif;
                font-size: .78rem;
                font-weight: 700;
                padding: 5px 14px;
                border-radius: 50px;
                cursor: pointer;
            }

                .add-banner .cancel-btn:hover {
                    background: rgba(255,255,255,.25);
                }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        /* Legend */
        .map-legend {
            position: absolute;
            bottom: 16px;
            right: 16px;
            background: rgba(255,255,255,.95);
            border-radius: 16px;
            padding: 12px 16px;
            z-index: 300;
            box-shadow: 0 6px 24px rgba(0,0,0,.12);
        }

        .lg-hd {
            font-size: .6rem;
            font-weight: 800;
            color: #9a8a78;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .lg-row {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .72rem;
            font-weight: 600;
            color: #1a1612;
            margin-bottom: 5px;
        }

            .lg-row:last-child {
                margin-bottom: 0;
            }

        .lg-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

        /* Map marker styles */
        .am-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .am-pin {
            width: 40px;
            height: 40px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2.5px solid rgba(255,255,255,.9);
            box-shadow: 0 6px 20px rgba(0,0,0,.22);
            overflow: hidden;
            transition: transform .18s;
        }

            .am-pin span {
                transform: rotate(45deg);
                display: block;
                font-size: .95rem;
            }

            .am-pin img {
                transform: rotate(45deg);
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .am-tail {
            width: 0;
            height: 0;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            border-top: 10px solid;
            margin: -2px auto 0;
        }

        .am-shadow {
            width: 14px;
            height: 5px;
            background: rgba(0,0,0,.14);
            border-radius: 50%;
            filter: blur(2px);
            margin-top: 1px;
        }

        /* ═══════════════════════════════════════════════════════
                   RIGHT PANEL — form + detail (slides in/out)
                ═══════════════════════════════════════════════════════ */
        .right-panel {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 380px;
            background: #fff;
            border-left: 1px solid #ece6df;
            display: flex;
            flex-direction: column;
            z-index: 500;
            transform: translateX(100%);
            transition: transform .32s cubic-bezier(.4,0,.2,1);
            box-shadow: -8px 0 32px rgba(0,0,0,.1);
        }

            .right-panel.open {
                transform: translateX(0);
            }

        .rp-hd {
            display: flex;
            align-items: center;
            padding: 16px 20px 14px;
            border-bottom: 1px solid #ece6df;
            flex-shrink: 0;
        }

        .rp-title {
            font-family: 'Syne', sans-serif;
            font-size: .95rem;
            font-weight: 800;
            color: #1a1612;
            flex: 1;
        }

        .rp-close {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: #f0ebe4;
            color: #9a8a78;
            cursor: pointer;
            display: grid;
            place-items: center;
            font-size: .82rem;
            transition: .15s;
        }

            .rp-close:hover {
                background: #e8e0d8;
            }

        .rp-body {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #e0d8d0 transparent;
        }

        /* ── TYPE SELECTOR ─────────────────────────────────────── */
        .type-selector {
            padding: 20px;
        }

        .ts-label {
            font-size: .76rem;
            font-weight: 700;
            color: #9a8a78;
            letter-spacing: .8px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .ts-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .ts-card {
            padding: 16px 8px;
            border: 2px solid #ece6df;
            border-radius: 16px;
            background: #fff;
            cursor: pointer;
            text-align: center;
            transition: all .18s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

            .ts-card:hover {
                border-color: #7fa85a;
                background: #f4faea;
            }

            .ts-card.selected {
                border-color: #5a7a3e;
                background: #f0f7e8;
            }

            .ts-card .ts-ico {
                font-size: 1.8rem;
            }

            .ts-card .ts-name {
                font-family: 'Syne', sans-serif;
                font-size: .78rem;
                font-weight: 700;
                color: #1a1612;
            }

            .ts-card .ts-desc {
                font-size: .65rem;
                color: #9a8a78;
                font-weight: 500;
                line-height: 1.4;
            }

            .ts-card.selected .ts-name {
                color: #3d7a2a;
            }

        .ts-next-btn {
            margin-top: 16px;
            width: 100%;
            padding: 13px;
            background: #1a1612;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: .84rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .18s;
        }

            .ts-next-btn:hover {
                opacity: .88;
            }

            .ts-next-btn:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

        /* ── DETAILS FORM ──────────────────────────────────────── */
        .details-form {
            padding: 0 20px 24px;
        }

        /* Coord display */
        .coord-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f0f7e8;
            border: 1px solid #c4d9a8;
            border-radius: 12px;
            padding: 10px 14px;
            margin: 16px 0 14px;
            font-size: .78rem;
            font-weight: 700;
            color: #3d7a2a;
        }

            .coord-pill.empty {
                background: #fff3e0;
                border-color: #f5d6a8;
                color: #b45309;
            }

        /* Image upload */
        .img-upload-area {
            border: 2px dashed #d8d0c8;
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all .18s;
            margin-bottom: 14px;
            position: relative;
            overflow: hidden;
        }

            .img-upload-area:hover {
                border-color: #7fa85a;
                background: #f9fdf5;
            }

            .img-upload-area.has-img {
                padding: 0;
                border-style: solid;
                border-color: #c4d9a8;
            }

        .img-preview {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 12px;
            display: none;
        }

        .img-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

            .img-placeholder .ico {
                font-size: 1.6rem;
            }

            .img-placeholder p {
                font-size: .78rem;
                color: #9a8a78;
                font-weight: 500;
                margin: 0;
            }

            .img-placeholder span {
                font-size: .68rem;
                color: #b0a090;
            }

        .img-change-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.5);
            display: none;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            border-radius: 12px;
        }

        .img-upload-area.has-img:hover .img-change-overlay {
            display: flex;
        }

        #imgFile {
            display: none;
        }

        /* Form fields */
        .f-group {
            margin-bottom: 13px;
        }

        .f-label {
            display: block;
            font-size: .74rem;
            font-weight: 700;
            color: #3d7a2a;
            margin-bottom: 5px;
        }

            .f-label .req {
                color: #dc2626;
            }

        .f-input, .f-select, .f-textarea {
            width: 100%;
            border: 1.5px solid #ddd5cb;
            border-radius: 11px;
            padding: 10px 13px;
            font-family: 'DM Sans', sans-serif;
            font-size: .84rem;
            font-weight: 500;
            color: #1a1612;
            outline: none;
            box-sizing: border-box;
            transition: .18s;
        }

            .f-input:focus, .f-select:focus, .f-textarea:focus {
                border-color: #5a7a3e;
                box-shadow: 0 0 0 3px rgba(90,122,62,.1);
            }

        .f-textarea {
            resize: vertical;
            min-height: 80px;
            padding-top: 10px;
        }

        .f-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* Section separator */
        .f-sep {
            font-size: .68rem;
            font-weight: 800;
            color: #9a8a78;
            letter-spacing: .9px;
            text-transform: uppercase;
            padding: 12px 0 8px;
            border-top: 1px solid #f0ebe4;
            margin-top: 8px;
        }

        /* Save button */
        .f-save-btn {
            width: 100%;
            padding: 13px;
            background: #1a1612;
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: .85rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: opacity .18s;
        }

            .f-save-btn:hover {
                opacity: .88;
            }

        .f-back-btn {
            width: 100%;
            padding: 11px;
            margin-top: 8px;
            border: 1.5px solid #ddd5cb;
            border-radius: 12px;
            background: #fff;
            color: #9a8a78;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
        }

        /* ── DETAIL VIEW ───────────────────────────────────────── */
        .detail-view {
            padding: 0 20px 24px;
        }

        .dv-photo {
            width: calc(100% + 40px);
            margin: 0 -20px;
            height: 160px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #e8f5d8, #c4d9a8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            flex-shrink: 0;
        }

            .dv-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dv-name {
            font-family: 'Syne', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1612;
            margin: 16px 0 4px;
        }

        .dv-type-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .dv-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid #f0ebe4;
            font-size: .8rem;
        }

            .dv-row:last-of-type {
                border-bottom: none;
            }

        .dv-ico {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: grid;
            place-items: center;
            font-size: .85rem;
            flex-shrink: 0;
            background: #f7f3ee;
        }

        .dv-key {
            color: #9a8a78;
            font-weight: 500;
            min-width: 72px;
        }

        .dv-val {
            font-weight: 600;
            color: #1a1612;
            flex: 1;
            line-height: 1.5;
        }

        .dv-actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            flex-wrap: wrap;
        }

        .dv-btn {
            flex: 1;
            min-width: calc(50% - 4px);
            padding: 10px;
            border-radius: 12px;
            border: none;
            font-family: 'DM Sans', sans-serif;
            font-size: .76rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: .15s;
            text-decoration: none;
        }

            .dv-btn.primary {
                background: #1a1612;
                color: #fff;
            }

                .dv-btn.primary:hover {
                    opacity: .88;
                    color: #fff;
                }

            .dv-btn.edit {
                background: #f0f7e8;
                color: #3d7a2a;
            }

                .dv-btn.edit:hover {
                    background: #e4f0d8;
                }

            .dv-btn.danger {
                background: #fee2e2;
                color: #dc2626;
            }

                .dv-btn.danger:hover {
                    background: #fcd0d0;
                }

            .dv-btn.hide {
                background: #f5f0eb;
                color: #9a8a78;
            }

        /* Danger badge in detail */
        .dv-danger-bar {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 13px;
            border-radius: 12px;
            margin-bottom: 12px;
            font-size: .8rem;
            font-weight: 700;
        }

        /* ═══════════════════════════════════════════════════════
                   TOAST
                ═══════════════════════════════════════════════════════ */
        #toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: #1a1612;
            color: #fff;
            padding: 11px 24px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            z-index: 9999;
            opacity: 0;
            transition: all .3s;
            pointer-events: none;
            white-space: nowrap;
        }

            #toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* Leaflet */
        .leaflet-control-zoom {
            border: none !important;
        }

            .leaflet-control-zoom a {
                background: #fff !important;
                border: none !important;
                box-shadow: 0 3px 12px rgba(0,0,0,.1) !important;
                color: #1a1612 !important;
                width: 34px !important;
                height: 34px !important;
                line-height: 34px !important;
            }

                .leaflet-control-zoom a:first-child {
                    border-radius: 10px 10px 0 0 !important;
                }

                .leaflet-control-zoom a:last-child {
                    border-radius: 0 0 10px 10px !important;
                }

        @@media (max-width: 1024px) {
            .amap-left {
                display: none;
            }
        }

        @@media (max-width: 768px) {
            .right-panel {
                width: 100%;
                border-radius: 24px 24px 0 0;
                top: auto;
                bottom: 0;
                height: 85vh;
                border-left: none;
                transform: translateY(100%);
            }

                .right-panel.open {
                    transform: translateY(0);
                }
        }
    </style>
</head>
<body>
