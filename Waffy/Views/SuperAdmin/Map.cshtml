@{
    ViewData["Title"] = "Map Management — Waffy Admin";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        .wa-main {
            padding: 0 !important;
            overflow: hidden;
        }

        /* ══════════════════════════════════════════════════════
                   SHELL — flex row on desktop, column on mobile
                ══════════════════════════════════════════════════════ */
        .amap-shell {
            display: flex;
            flex-direction: row;
            height: calc(100vh - var(--tn-h, 56px));
            position: relative;
            /* NO overflow:hidden here — it clips the tablet overlay panel */
        }

        /* Only the map area clips its content */
        .amap-map {
            overflow: hidden;
        }

        /* ══════════════════════════════════════════════════════
                   LEFT PANEL
                ══════════════════════════════════════════════════════ */
        .amap-left {
            width: 300px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: #faf8f5;
            border-right: 1px solid #e8e0d8;
            overflow: hidden;
            z-index: 10;
        }

        /* Panel header */
        .panel-hd {
            padding: 14px 16px 12px;
            background: #fff;
            border-bottom: 1px solid #e8e0d8;
            flex-shrink: 0;
        }

        .panel-hd-title {
            font-family: 'Syne', sans-serif;
            font-size: .88rem;
            font-weight: 800;
            color: #1a1612;
            margin-bottom: 10px;
        }

        /* Filter pills */
        .filter-pills {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 2px;
        }

            .filter-pills::-webkit-scrollbar {
                display: none;
            }

        .fp {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            border-radius: 20px;
            border: 1.5px solid #e8e0d8;
            background: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: .72rem;
            font-weight: 700;
            color: #9a8a78;
            cursor: pointer;
            white-space: nowrap;
            transition: all .18s;
        }

            .fp:hover {
                border-color: #b0a090;
                color: #1a1612;
            }

            .fp.active {
                background: #1a1612;
                border-color: #1a1612;
                color: #fff;
            }

        .fp-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .fp.active .fp-dot {
            background: rgba(255,255,255,.55);
        }

        /* Search */
        .panel-search {
            padding: 10px 14px;
            border-bottom: 1px solid #e8e0d8;
            background: #fff;
            flex-shrink: 0;
        }

        .ps-wrap {
            display: flex;
            align-items: center;
            gap: 7px;
            background: #f7f3ee;
            border-radius: 10px;
            padding: 0 12px;
            height: 36px;
        }

            .ps-wrap input {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'DM Sans', sans-serif;
                font-size: .82rem;
                color: #1a1612;
                width: 100%;
            }

                .ps-wrap input::placeholder {
                    color: #c0b0a0;
                }

        /* Tabs */
        .panel-tabs {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            border-bottom: 1px solid #e8e0d8;
            background: #fff;
            flex-shrink: 0;
        }

        .pt {
            padding: 10px 6px 8px;
            border: none;
            background: transparent;
            font-family: 'DM Sans', sans-serif;
            font-size: .72rem;
            font-weight: 600;
            color: #9a8a78;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            transition: color .15s;
        }

            .pt .pt-ico {
                font-size: .95rem;
            }

            .pt.active {
                color: #1a1612;
                border-bottom-color: #5a7a3e;
                font-weight: 700;
            }

        .pt-cnt {
            background: #fee2e2;
            color: #dc2626;
            border-radius: 50px;
            padding: 0 5px;
            font-size: .6rem;
            font-weight: 800;
        }

        .pt.active .pt-cnt {
            background: #e8f5d8;
            color: #3d7a2a;
        }

        /* Sections */
        .panel-sec {
            display: none;
            flex: 1;
            overflow: hidden;
            flex-direction: column;
        }

            .panel-sec.active {
                display: flex;
            }

        .sec-label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 14px 5px;
            flex-shrink: 0;
        }

        .sec-label-text {
            font-size: .65rem;
            font-weight: 900;
            color: #b0a090;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .sec-add-btn {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 20px;
            border: none;
            background: #1a1612;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: .68rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .15s;
        }

            .sec-add-btn:hover {
                opacity: .82;
            }

        .sec-list {
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #e0d8d0 transparent;
        }

        /* Place row */
        .prow {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-bottom: 1px solid #f2ede8;
            cursor: pointer;
            transition: background .14s;
        }

            .prow:hover {
                background: #f0ede9;
            }

        .prow-img {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
        }

            .prow-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .prow-body {
            flex: 1;
            min-width: 0;
        }

        .prow-name {
            font-size: .82rem;
            font-weight: 700;
            color: #1a1612;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .prow-sub {
            font-size: .68rem;
            color: #b0a090;
            font-weight: 500;
            margin-top: 1px;
        }

        .prow-source {
            font-size: .62rem;
            font-weight: 800;
            padding: 1px 7px;
            border-radius: 20px;
            flex-shrink: 0;
        }

        .source-reg {
            background: #f0f0ff;
            color: #6b46c1;
        }

        .prow-acts {
            display: flex;
            gap: 4px;
            flex-shrink: 0;
        }

        .prow-btn {
            width: 26px;
            height: 26px;
            border-radius: 7px;
            border: none;
            background: #f0ebe4;
            color: #9a8a78;
            font-size: .68rem;
            cursor: pointer;
            display: grid;
            place-items: center;
            transition: .14s;
        }

            .prow-btn:hover {
                background: #e8e0d8;
                color: #1a1612;
            }

            .prow-btn.del:hover {
                background: #fce8e8;
                color: #dc2626;
            }

            .prow-btn.edit:hover {
                background: #e8f5d8;
                color: #3d7a2a;
            }

        /* Danger row */
        .drow {
            padding: 10px 14px;
            border-bottom: 1px solid #f2ede8;
            cursor: pointer;
            transition: background .14s;
        }

            .drow:hover {
                background: #f0ede9;
            }

        .drow-hd {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        .drow-name {
            font-size: .8rem;
            font-weight: 700;
            color: #1a1612;
        }

        .drow-sev {
            padding: 2px 7px;
            border-radius: 20px;
            font-size: .64rem;
            font-weight: 800;
        }

        .sev-High {
            background: #fee2e2;
            color: #dc2626;
        }

        .sev-Medium {
            background: #fff3e0;
            color: #b45309;
        }

        .sev-Low {
            background: #f0fdf4;
            color: #16a34a;
        }

        .drow-meta {
            font-size: .68rem;
            color: #b0a090;
        }

        .drow-code {
            font-family: monospace;
            font-size: .64rem;
            color: #c0b0a0;
            margin-top: 2px;
        }

        .drow-btns {
            display: flex;
            gap: 5px;
            margin-top: 6px;
        }

        .drow-btn {
            padding: 3px 8px;
            border-radius: 20px;
            border: none;
            font-family: 'DM Sans', sans-serif;
            font-size: .66rem;
            font-weight: 700;
            cursor: pointer;
        }

            .drow-btn.review {
                background: #fff3e0;
                color: #b45309;
            }

            .drow-btn.resolve {
                background: #f0fdf4;
                color: #16a34a;
            }

            .drow-btn.fake {
                background: #f5f0eb;
                color: #9a8a78;
            }

        /* Stats */
        .stats-wrap {
            padding: 12px;
            overflow-y: auto;
            flex: 1;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin-bottom: 14px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #e8e0d8;
            border-radius: 14px;
            padding: 14px 12px;
            text-align: center;
        }

        .stat-num {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
        }

        .stat-ico {
            font-size: 1.1rem;
            margin: 4px 0;
        }

        .stat-lbl {
            font-size: .67rem;
            color: #b0a090;
            font-weight: 700;
        }

        .empty-state {
            padding: 24px 14px;
            text-align: center;
            color: #c0b0a0;
            font-size: .78rem;
            line-height: 1.6;
        }

        /* ══════════════════════════════════════════════════════
                   MAP AREA
                ══════════════════════════════════════════════════════ */
        .amap-map {
            flex: 1;
            position: relative;
            overflow: hidden;
            min-width: 0;
        }

        #adminMap {
            width: 100%;
            height: 100%;
        }

        /* Add mode banner */
        .add-banner {
            position: absolute;
            top: 16px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(26,22,18,.92);
            backdrop-filter: blur(12px);
            color: #fff;
            padding: 12px 22px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 700;
            z-index: 400;
            display: none;
            align-items: center;
            gap: 14px;
            box-shadow: 0 8px 32px rgba(0,0,0,.28);
            white-space: nowrap;
            border: 1px solid rgba(255,255,255,.12);
            animation: slideDown .3s ease;
        }

            .add-banner.show {
                display: flex;
            }

        .ab-pulse {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #7fa85a;
            box-shadow: 0 0 0 0 rgba(127,168,90,.6);
            animation: abPulse 1.5s infinite;
        }

        @@keyframes abPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(127,168,90,.6)
            }

            70% {
                box-shadow: 0 0 0 8px rgba(127,168,90,0)
            }

            100% {
                box-shadow: 0 0 0 0 rgba(127,168,90,0)
            }
        }

        .cancel-btn {
            background: rgba(255,255,255,.14);
            border: none;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: .76rem;
            font-weight: 700;
            padding: 5px 13px;
            border-radius: 50px;
            cursor: pointer;
        }

            .cancel-btn:hover {
                background: rgba(255,255,255,.22);
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(-12px)
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0)
            }
        }

        /* ── SVG PIN MARKERS ─────────────────────────────── */
        .am-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .am-body {
            width: 36px;
            height: 44px;
            position: relative;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,.25));
            transition: filter .18s, transform .18s;
        }

        .am-wrap:hover .am-body {
            filter: drop-shadow(0 6px 14px rgba(0,0,0,.35));
            transform: translateY(-3px);
        }

        .am-svg {
            width: 36px;
            height: 44px;
        }

        .am-icon {
            position: absolute;
            top: 6px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .am-icon svg {
                width: 14px;
                height: 14px;
            }

        .am-shadow-dot {
            width: 12px;
            height: 4px;
            background: rgba(0,0,0,.18);
            border-radius: 50%;
            filter: blur(2px);
            margin-top: -2px;
        }

        /* Legend */
        .map-legend {
            position: absolute;
            bottom: 16px;
            right: 16px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(200,190,178,.3);
            border-radius: 16px;
            padding: 12px 16px;
            z-index: 300;
            box-shadow: 0 6px 24px rgba(0,0,0,.12);
        }

        .lg-hd {
            font-size: .59rem;
            font-weight: 900;
            color: #b0a090;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .lg-row {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .71rem;
            font-weight: 700;
            color: #1a1612;
            margin-bottom: 5px;
        }

            .lg-row:last-child {
                margin-bottom: 0;
            }

        .lg-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

        /* ══════════════════════════════════════════════════════
                   TABLET PANEL TOGGLE (overlay mode)
                ══════════════════════════════════════════════════════ */
        .panel-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(26,22,18,.4);
            backdrop-filter: blur(3px);
            z-index: 150;
        }

            .panel-overlay.show {
                display: block;
            }

        /* Thin tab button on the map edge */
        .panel-tab-btn {
            display: none;
            position: absolute;
            top: 50%;
            right: auto;
            left: 0;
            transform: translateY(-50%);
            z-index: 200;
            width: 22px;
            height: 52px;
            background: #fff;
            border: 1px solid #e8e0d8;
            border-left: none;
            border-radius: 0 10px 10px 0;
            cursor: pointer;
            align-items: center;
            justify-content: center;
            box-shadow: 3px 0 12px rgba(0,0,0,.1);
            transition: background .18s;
            color: #9a8a78;
        }

            .panel-tab-btn:hover {
                background: #f5f1ec;
                color: #1a1612;
            }

            .panel-tab-btn svg {
                width: 12px;
                height: 12px;
                transition: transform .3s;
            }

            .panel-tab-btn.open svg {
                transform: rotate(180deg);
            }

        /* ══════════════════════════════════════════════════════
                   RIGHT PANEL
                ══════════════════════════════════════════════════════ */
        .right-panel {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 390px;
            background: #fff;
            border-left: 1px solid #e8e0d8;
            display: flex;
            flex-direction: column;
            z-index: 500;
            transform: translateX(100%);
            transition: transform .32s cubic-bezier(.4,0,.2,1);
            box-shadow: -10px 0 40px rgba(0,0,0,.1);
        }

            .right-panel.open {
                transform: translateX(0);
            }

        .rp-hd {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px 14px;
            border-bottom: 1px solid #e8e0d8;
            flex-shrink: 0;
            background: #fff;
        }

        .rp-back {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: #f0ebe4;
            color: #9a8a78;
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            transition: .14s;
            flex-shrink: 0;
        }

            .rp-back.show {
                display: flex;
            }

            .rp-back:hover {
                background: #e8e0d8;
            }

        .rp-title {
            font-family: 'Syne', sans-serif;
            font-size: .95rem;
            font-weight: 800;
            color: #1a1612;
            flex: 1;
        }

        .rp-close {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: none;
            background: #f0ebe4;
            color: #9a8a78;
            cursor: pointer;
            display: grid;
            place-items: center;
            font-size: .8rem;
            flex-shrink: 0;
            transition: .14s;
        }

            .rp-close:hover {
                background: #e8e0d8;
            }

        .rp-body {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #e0d8d0 transparent;
        }

        /* Type selector */
        .type-sel {
            padding: 24px 20px 20px;
        }

        .type-sel-lbl {
            font-size: .68rem;
            font-weight: 900;
            color: #b0a090;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .type-cards {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .tc {
            padding: 20px 8px 16px;
            border: 2px solid #e8e0d8;
            border-radius: 18px;
            background: #fff;
            cursor: pointer;
            text-align: center;
            transition: all .2s;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

            .tc::before {
                content: '';
                position: absolute;
                inset: 0;
                opacity: 0;
                transition: opacity .2s;
            }

            .tc:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(0,0,0,.1);
            }

            .tc.selected {
                transform: translateY(-2px);
            }

            .tc[data-type="clinic"]::before {
                background: linear-gradient(135deg,#e6faf5,#c8f5ea);
            }

            .tc[data-type="store"]::before {
                background: linear-gradient(135deg,#f3f0ff,#e8dfff);
            }

            .tc[data-type="petfriendly"]::before {
                background: linear-gradient(135deg,#f0f7e8,#e0f0c8);
            }

            .tc[data-type="clinic"]:hover::before, .tc[data-type="clinic"].selected::before {
                opacity: 1;
            }

            .tc[data-type="store"]:hover::before, .tc[data-type="store"].selected::before {
                opacity: 1;
            }

            .tc[data-type="petfriendly"]:hover::before, .tc[data-type="petfriendly"].selected::before {
                opacity: 1;
            }

            .tc[data-type="clinic"].selected, .tc[data-type="clinic"]:hover {
                border-color: #00c896;
                box-shadow: 0 6px 20px rgba(0,200,150,.18);
            }

            .tc[data-type="store"].selected, .tc[data-type="store"]:hover {
                border-color: #8b5cf6;
                box-shadow: 0 6px 20px rgba(139,92,246,.18);
            }

            .tc[data-type="petfriendly"].selected, .tc[data-type="petfriendly"]:hover {
                border-color: #7fa85a;
                box-shadow: 0 6px 20px rgba(127,168,90,.18);
            }

        .tc-ico-wrap {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            position: relative;
            z-index: 1;
        }

        .tc[data-type="clinic"] .tc-ico-wrap {
            background: rgba(0,200,150,.12);
        }

        .tc[data-type="store"] .tc-ico-wrap {
            background: rgba(139,92,246,.12);
        }

        .tc[data-type="petfriendly"] .tc-ico-wrap {
            background: rgba(127,168,90,.12);
        }

        .tc-name {
            font-family: 'Syne', sans-serif;
            font-size: .8rem;
            font-weight: 700;
            color: #1a1612;
            position: relative;
            z-index: 1;
        }

        .tc-desc {
            font-size: .64rem;
            color: #b0a090;
            font-weight: 500;
            line-height: 1.4;
            position: relative;
            z-index: 1;
        }

        .tc-check {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #1a1612;
            color: #fff;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: .62rem;
            font-weight: 900;
            z-index: 2;
        }

        .tc.selected .tc-check {
            display: flex;
        }

        .tc-continue {
            width: 100%;
            padding: 14px;
            background: #1a1612;
            color: #fff;
            border: none;
            border-radius: 14px;
            font-family: 'DM Sans', sans-serif;
            font-size: .86rem;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .18s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .tc-continue:hover {
                opacity: .88;
            }

            .tc-continue:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        /* Form */
        .add-form {
            padding: 0 20px 28px;
        }

        .loc-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 12px;
            margin: 16px 0 14px;
            font-size: .78rem;
            font-weight: 700;
        }

            .loc-pill.ok {
                background: #f0f7e8;
                border: 1px solid #c4d9a8;
                color: #3d7a2a;
            }

            .loc-pill.empty {
                background: #fff7ed;
                border: 1px solid #fcd9a8;
                color: #b45309;
            }

        .loc-pill-repin {
            margin-left: auto;
            font-size: .7rem;
            font-weight: 700;
            color: #5a7a3e;
            background: none;
            border: none;
            cursor: pointer;
            text-decoration: underline;
        }

        .photo-upload {
            border: 2px dashed #d8d0c8;
            border-radius: 16px;
            padding: 24px 20px;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
            margin-bottom: 16px;
            position: relative;
            overflow: hidden;
        }

            .photo-upload:hover {
                border-color: #7fa85a;
                background: #fafdf6;
            }

            .photo-upload.filled {
                padding: 0;
                border-style: solid;
                border-color: #c4d9a8;
            }

        .pu-preview {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 14px;
            display: none;
        }

        .pu-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .pu-ico {
            font-size: 2rem;
        }

        .pu-lbl {
            font-size: .8rem;
            font-weight: 700;
            color: #9a8a78;
        }

        .pu-sub {
            font-size: .68rem;
            color: #c0b0a0;
        }

        .pu-hover {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.52);
            display: none;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .78rem;
            font-weight: 700;
            border-radius: 14px;
        }

        .photo-upload.filled:hover .pu-hover {
            display: flex;
        }

        #imgFile {
            display: none;
        }

        .form-section {
            font-size: .65rem;
            font-weight: 900;
            color: #b0a090;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 14px 0 8px;
            border-top: 1px solid #f0ebe4;
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .fg {
            margin-bottom: 12px;
        }

        .fl {
            display: block;
            font-size: .73rem;
            font-weight: 700;
            color: #5a7a3e;
            margin-bottom: 5px;
        }

            .fl .req {
                color: #dc2626;
                margin-left: 1px;
            }

        .fi, .fta {
            width: 100%;
            border: 1.5px solid #ddd5cb;
            border-radius: 11px;
            padding: 10px 13px;
            font-family: 'DM Sans', sans-serif;
            font-size: .84rem;
            font-weight: 500;
            color: #1a1612;
            outline: none;
            box-sizing: border-box;
            transition: .18s;
            background: #fff;
        }

            .fi:focus, .fta:focus {
                border-color: #5a7a3e;
                box-shadow: 0 0 0 3px rgba(90,122,62,.09);
            }

        .fta {
            resize: vertical;
            min-height: 82px;
            padding-top: 10px;
        }

        .fg-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .save-btn {
            width: 100%;
            padding: 14px;
            background: #1a1612;
            color: #fff;
            border: none;
            border-radius: 13px;
            font-family: 'DM Sans', sans-serif;
            font-size: .86rem;
            font-weight: 700;
            cursor: pointer;
            margin-top: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: all .2s;
            box-shadow: 0 4px 16px rgba(26,22,18,.2);
        }

            .save-btn:hover {
                opacity: .88;
            }

        .back-btn {
            width: 100%;
            padding: 11px;
            margin-top: 8px;
            border: 1.5px solid #ddd5cb;
            border-radius: 12px;
            background: #fff;
            color: #9a8a78;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
        }

            .back-btn:hover {
                background: #f7f3ee;
                color: #1a1612;
            }

        /* Detail view */
        .detail-view {
            padding-bottom: 28px;
        }

        .dv-photo {
            width: 100%;
            height: 170px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .dv-photo img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .dv-photo-ph {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
        }

        .dv-content {
            padding: 18px 20px 0;
        }

        .dv-name {
            font-family: 'Syne', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1612;
            margin-bottom: 5px;
        }

        .dv-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: .72rem;
            font-weight: 700;
            margin-bottom: 16px;
        }

        .dv-row {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            padding: 9px 0;
            border-bottom: 1px solid #f0ebe4;
            font-size: .8rem;
        }

            .dv-row:last-of-type {
                border-bottom: none;
            }

        .dv-ico {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: #f7f3ee;
            display: grid;
            place-items: center;
            font-size: .84rem;
            flex-shrink: 0;
        }

        .dv-key {
            color: #b0a090;
            font-weight: 600;
            min-width: 70px;
        }

        .dv-val {
            font-weight: 700;
            color: #1a1612;
            flex: 1;
            line-height: 1.5;
        }

            .dv-val a {
                color: #5a7a3e;
                text-decoration: none;
            }

        .dv-actions {
            display: flex;
            gap: 8px;
            padding: 16px 20px 0;
            flex-wrap: wrap;
        }

        .dv-btn {
            flex: 1;
            min-width: calc(50% - 4px);
            padding: 10px;
            border-radius: 12px;
            border: none;
            font-family: 'DM Sans', sans-serif;
            font-size: .74rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: .15s;
            text-decoration: none;
        }

            .dv-btn.primary {
                background: #1a1612;
                color: #fff;
            }

                .dv-btn.primary:hover {
                    opacity: .88;
                    color: #fff;
                }

            .dv-btn.edit {
                background: #f0f7e8;
                color: #3d7a2a;
            }

                .dv-btn.edit:hover {
                    background: #e4f0d8;
                }

            .dv-btn.del {
                background: #fee2e2;
                color: #dc2626;
            }

                .dv-btn.del:hover {
                    background: #fcd0d0;
                }

            .dv-btn.hide {
                background: #f5f0eb;
                color: #9a8a78;
            }

        .dv-danger-bar {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 14px;
            border-radius: 12px;
            margin-bottom: 14px;
            font-size: .8rem;
            font-weight: 700;
        }

        /* Toast */
        #toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: #1a1612;
            color: #fff;
            padding: 11px 24px;
            border-radius: 50px;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            z-index: 9999;
            opacity: 0;
            transition: all .3s;
            pointer-events: none;
            white-space: nowrap;
        }

            #toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* Leaflet */
        .leaflet-control-zoom {
            border: none !important;
        }

            .leaflet-control-zoom a {
                background: #fff !important;
                border: none !important;
                box-shadow: 0 3px 12px rgba(0,0,0,.1) !important;
                color: #1a1612 !important;
                width: 34px !important;
                height: 34px !important;
                line-height: 34px !important;
            }

                .leaflet-control-zoom a:first-child {
                    border-radius: 10px 10px 0 0 !important;
                }

                .leaflet-control-zoom a:last-child {
                    border-radius: 0 0 10px 10px !important;
                }

        /* ══════════════════════════════════════════════════════
                   FIX 1 — App sidebar must always be above map (Leaflet has high z-index)
                ══════════════════════════════════════════════════════ */
        .wa-sb {
            z-index: 3000 !important;
        }

        .wa-overlay {
            z-index: 2999 !important;
        }

        /* ══════════════════════════════════════════════════════
                   RESPONSIVE
                   • Desktop  >1100px  : panel 300px + map — side by side
                   • Tablet   768-1100px: panel 240px + map — side by side (always visible)
                   • Mobile   <768px   : stacked — map 50% top, panel 50% bottom
                ══════════════════════════════════════════════════════ */

        /* ── TABLET (768px – 1100px) ────────────────────────
                   Panel stays IN the flow at 240px — always visible.
                   No overlay, no toggle button needed.
                ───────────────────────────────────────────────────── */
        @@media (min-width: 768px) and (max-width: 1100px) {
            .amap-left {
                width: 240px;
                /* stays in normal flow — no position:fixed */
                position: relative;
                transform: none !important;
                box-shadow: none;
                flex-shrink: 0;
            }
            /* Hide tablet-only overlay/toggle (not needed in this mode) */
            .panel-tab-btn {
                display: none !important;
            }

            .panel-overlay {
                display: none !important;
            }
            /* Compact text slightly */
            .panel-hd-title {
                font-size: .82rem;
            }

            .fp {
                padding: 5px 9px;
                font-size: .7rem;
            }

            .sec-label-text {
                font-size: .6rem;
            }

            .prow-name {
                font-size: .78rem;
            }
            /* Right panel narrower */
            .right-panel {
                width: 320px;
            }
        }

        /* ── MOBILE (<768px) : STACKED ──────────────────────
                   Map fills top half, panel fills bottom half.
                   Everything visible, no overlap possible.
                ───────────────────────────────────────────────────── */
        @@media (max-width: 767px) {
            .amap-shell {
                flex-direction: column;
                height: calc(100vh - var(--tn-h, 56px));
            }
            /* Map: top 50% */
            .amap-map {
                height: 50%;
                flex-shrink: 0;
                order: 1;
                min-height: 0;
            }
            /* Panel: bottom 50% — always visible in flow */
            .amap-left {
                width: 100% !important;
                height: 50% !important;
                flex-shrink: 0;
                order: 2;
                border-right: none;
                border-top: 2px solid #e8e0d8;
                position: relative !important;
                transform: none !important;
                box-shadow: none !important;
                min-height: 0;
            }
            /* Right detail panel: slides up from bottom as fixed sheet */
            .right-panel {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                width: 100%;
                height: 80vh;
                top: auto;
                border-left: none;
                border-radius: 20px 20px 0 0;
                transform: translateY(100%);
                z-index: 3100; /* above everything including sidebar */
            }

                .right-panel.open {
                    transform: translateY(0);
                }
            /* Hide elements that don't fit */
            .map-legend {
                display: none;
            }

            .panel-tab-btn, .panel-overlay {
                display: none !important;
            }
            /* Compact sizes */
            .fp {
                padding: 5px 8px;
                font-size: .67rem;
            }

            .panel-hd {
                padding: 9px 12px 8px;
            }

            .panel-hd-title {
                font-size: .8rem;
                margin-bottom: 7px;
            }

            #clinicList {
                max-height: 88px !important;
            }

            #storeList {
                max-height: 88px !important;
            }

            .stat-num {
                font-size: 1.3rem;
            }
        }

        @@media (max-width: 480px) {
            .amap-map {
                height: 45% !important;
            }

            .amap-left {
                height: 55% !important;
            }

            .fg-2 {
                grid-template-columns: 1fr;
            }

            .tc-desc {
                display: none;
            }

            .tc {
                padding: 11px 5px 9px;
                gap: 6px;
            }

            .tc-ico-wrap {
                width: 36px;
                height: 36px;
                font-size: 1.2rem;
            }

            .tc-name {
                font-size: .72rem;
            }
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- SIDEBAR (app sidebar) -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span><span class="sb-lbl">Dashboard</span></a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div><button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span><span class="sb-lbl">Users</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-users"><div class="sb-sub-inner"><a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a></div></div></div>
                    <div><button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg></span><span class="sb-lbl">Clinics</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-clinics"><div class="sb-sub-inner"><a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a></div></div></div>
                    <div><button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg></span><span class="sb-lbl">Shop</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button><div class="sb-sub" id="g-shop"><div class="sb-sub-inner"><a class="sb-child" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a></div></div></div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" type="button"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span><span class="sb-lbl">Reports</span><span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span></button>
                        <div class="sb-sub" id="g-rep">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row active" asp-controller="SuperAdmin" asp-action="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /><line x1="8" y1="2" x2="8" y2="18" /><line x1="16" y1="6" x2="16" y2="22" /></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></span><span class="sb-lbl">Notifications</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20 12V22H4V12" /><path d="M22 7H2v5h20V7z" /><path d="M12 22V7" /></svg></span><span class="sb-lbl">Reward Log</span></a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row"><div class="sb-av">@(ViewBag.AdminInitials ?? "AD")</div><div class="sb-user-info"><div class="sb-user-name">@(ViewBag.AdminName ?? "Admin")</div><div class="sb-user-role">Super Admin</div></div></div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg><span class="sb-logout-lbl">Sign Out</span></a>
            </div>
        </aside>

        <!-- TOPNAV -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg></button>
            <nav class="tn-bread"><span>Tools</span><span>/</span><b>Map Management</b></nav>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <button onclick="startAddMode()"
                        style="display:flex;align-items:center;gap:9px;padding:9px 20px 9px 14px;border:none;border-radius:50px;background:linear-gradient(135deg,#5a7a3e,#3d5a2a);color:#fff;font-family:'DM Sans',sans-serif;font-size:.84rem;font-weight:800;cursor:pointer;box-shadow:0 4px 18px rgba(58,100,38,.38);transition:all .2s"
                        onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform=''">
                    <svg viewBox="0 0 24 24" fill="none" style="width:18px;height:18px" stroke="currentColor" stroke-width="2.2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" /><circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none" /></svg>
                    Add Location
                </button>
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg></a>
                <div class="tn-profile"><div class="tn-av">@(ViewBag.AdminInitials ?? "AD")</div><div><div class="tn-pname">@(ViewBag.AdminName ?? "Admin")</div><div class="tn-prole">Super Admin</div></div></div>
            </div>
        </header>

        <!-- MAIN -->
        <main class="wa-main" id="waMain">
            <div class="amap-shell" id="amapShell">

                <!-- Tablet overlay (not used on mobile) -->
                <div class="panel-overlay" id="panelOverlay" onclick="closePanelOverlay()"></div>

                <!-- LEFT PANEL -->
                <div class="amap-left" id="amapLeft">
                    <div class="panel-hd">
                        <div class="panel-hd-title">🗺️ Map Overview</div>
                        <div class="filter-pills">
                            <button class="fp active" data-f="all" onclick="applyFilter(this,'all')"><svg style="width:10px;height:10px;opacity:.6" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10" /></svg>All</button>
                            <button class="fp" data-f="clinic" onclick="applyFilter(this,'clinic')"><span class="fp-dot" style="background:#00c896"></span>Clinics</button>
                            <button class="fp" data-f="store" onclick="applyFilter(this,'store')"><span class="fp-dot" style="background:#8b5cf6"></span>Stores</button>
                            <button class="fp" data-f="friendly" onclick="applyFilter(this,'friendly')"><span class="fp-dot" style="background:#7fa85a"></span>Places</button>
                            <button class="fp" data-f="danger" onclick="applyFilter(this,'danger')"><span class="fp-dot" style="background:#ef4444"></span>Reports</button>
                        </div>
                    </div>
                    <div class="panel-search">
                        <div class="ps-wrap">
                            <svg style="width:13px;color:#c0b0a0;flex-shrink:0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                            <input type="text" placeholder="Search places…" oninput="filterList(this.value)" />
                        </div>
                    </div>
                    <div class="panel-tabs">
                        <button class="pt active" id="pt-places" onclick="switchTab('places')"><span class="pt-ico">📍</span>Places</button>
                        <button class="pt" id="pt-danger" onclick="switchTab('danger')"><span class="pt-ico">🚨</span>Reports<span class="pt-cnt" id="dangerBadge">0</span></button>
                        <button class="pt" id="pt-stats" onclick="switchTab('stats')"><span class="pt-ico">📊</span>Stats</button>
                    </div>

                    <!-- PLACES -->
                    <div class="panel-sec active" id="sec-places">
                        <div class="sec-label" style="padding-top:10px">
                            <div class="sec-label-text">🏥 Clinics <span id="clinicCnt" style="font-weight:500"></span></div>
                            <button class="sec-add-btn" onclick="startAddModeFor('clinic')">＋ Add</button>
                        </div>
                        <div class="sec-list" id="clinicList" style="max-height:160px;border-bottom:1px solid #f0ebe4"></div>
                        <div class="sec-label" style="border-top:1px solid #f0ebe4;padding-top:8px">
                            <div class="sec-label-text">🛍️ Stores <span id="storeCnt" style="font-weight:500"></span></div>
                            <button class="sec-add-btn" onclick="startAddModeFor('store')">＋ Add</button>
                        </div>
                        <div class="sec-list" id="storeList" style="max-height:160px;border-bottom:1px solid #f0ebe4"></div>
                        <div class="sec-label" style="border-top:1px solid #f0ebe4;padding-top:8px">
                            <div class="sec-label-text">🌳 Pet-Friendly Places <span id="friendlyCnt" style="font-weight:500"></span></div>
                            <button class="sec-add-btn" onclick="startAddModeFor('petfriendly')">＋ Add</button>
                        </div>
                        <div class="sec-list" id="friendlyList" style="flex:1"></div>
                    </div>

                    <!-- DANGER -->
                    <div class="panel-sec" id="sec-danger">
                        <div class="sec-label" style="padding-top:10px">
                            <div class="sec-label-text">Active Reports</div>
                            <a href="/SuperAdmin/Dangerous_Animals" style="font-size:.68rem;font-weight:700;color:#7fa85a;text-decoration:none">View All →</a>
                        </div>
                        <div class="sec-list" id="dangerList" style="flex:1"></div>
                    </div>

                    <!-- STATS -->
                    <div class="panel-sec" id="sec-stats">
                        <div class="stats-wrap"><div class="stat-grid" id="statsGrid"></div><div id="statsExtra"></div></div>
                    </div>
                </div>

                <!-- MAP -->
                <div class="amap-map">
                    <!-- Tablet: thin tab to open/close panel -->
                    <div class="panel-tab-btn" id="panelTabBtn" onclick="toggleTabletPanel()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <polyline points="15 18 9 12 15 6" />
                        </svg>
                    </div>

                    <div id="adminMap"></div>

                    <div class="add-banner" id="addBanner">
                        <div class="ab-pulse"></div>
                        Click on the map to pin your location
                        <button class="cancel-btn" onclick="cancelAddMode()">✕ Cancel</button>
                    </div>

                    <div class="map-legend">
                        <div class="lg-hd">Legend</div>
                        <div class="lg-row"><div class="lg-dot" style="background:#00c896"></div>Clinic</div>
                        <div class="lg-row"><div class="lg-dot" style="background:#8b5cf6"></div>Store</div>
                        <div class="lg-row"><div class="lg-dot" style="background:#7fa85a"></div>Pet-Friendly</div>
                        <div class="lg-row"><div class="lg-dot" style="background:#10b981"></div>Park</div>
                        <div class="lg-row"><div class="lg-dot" style="background:#ef4444"></div>Danger</div>
                    </div>

                    <!-- RIGHT PANEL -->
                    <div class="right-panel" id="rightPanel">
                        <div class="rp-hd">
                            <button class="rp-back" id="rpBack" onclick="rpGoBack()">←</button>
                            <div class="rp-title" id="rpTitle">Add Location</div>
                            <button class="rp-close" onclick="closeRP()">✕</button>
                        </div>
                        <div class="rp-body" id="rpBody"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div id="toast"></div>
    @Html.AntiForgeryToken()

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/Waffy-Shell.js"></script>
    <script>
        /* ════════════════════════════════════════════════════════════
           STATE
        ════════════════════════════════════════════════════════════ */
        let map, addMode = false, editingId = null;
        let pendingLat = null, pendingLng = null;
        let allData = { clinics:[], stores:[], dangerReports:[], adminMarkers:[] };
        let leafMarkers = [], panelSearch = '', panelFilter = 'all';
        let selectedType = null, presetType = null;
        let tabletPanelOpen = false;

        const COLORS = {
            clinic:'#00c896', store:'#8b5cf6', danger:'#ef4444',
            petfriendly:'#7fa85a', playground:'#f59e0b', park:'#10b981'
        };
        const EMOJIS = { clinic:'🏥', store:'🛍️', danger:'🚨', petfriendly:'🌳', playground:'🎡', park:'🌲' };
        const LABELS = { clinic:'Clinic', store:'Store', danger:'Danger Report', petfriendly:'Pet-Friendly', playground:'Playground', park:'Park' };

        const PIN_ICONS = {
            clinic:`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`,
            store:`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>`,
            danger:`<svg viewBox="0 0 24 24" stroke="none"><path fill="rgba(255,255,255,0.9)" d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13" stroke="#c00" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="17" r="1" fill="#c00"/></svg>`,
            petfriendly:`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M12 21s-8-5-8-12a8 8 0 0 1 16 0c0 7-8 12-8 12z"/></svg>`,
            playground:`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="7" r="3.5"/><path d="M5 21l3.5-7m7 7L12 14m-3.5 7h7"/></svg>`,
            park:`<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L7 9H3l5 6H5l7 7 7-7h-3l5-6h-4z"/></svg>`
        };

        /* ════════════════════════════════════════════════════════════
           MAP INIT
        ════════════════════════════════════════════════════════════ */
        function initMap() {
            map = L.map('adminMap', { zoomControl: false })
                   .setView([31.9539, 35.9106], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { maxZoom:19 }).addTo(map);
            L.control.zoom({ position:'bottomright' }).addTo(map);

            map.on('click', function(e) {
                if (!addMode) { closeRP(); return; }
                pendingLat = e.latlng.lat.toFixed(6);
                pendingLng = e.latlng.lng.toFixed(6);
                if (presetType) {
                    selectedType = presetType; presetType = null;
                    cancelAddMode(); showAddForm(null);
                } else {
                    showTypeSelector();
                }
            });
        }

        /* ════════════════════════════════════════════════════════════
           FETCH
        ════════════════════════════════════════════════════════════ */
        async function fetchData() {
            try {
                const res = await fetch('/Map/GetMapData');
                allData   = await res.json();
                renderAll();
            } catch(e) { showToast('⚠️ Could not load data'); }
        }

        function renderAll() {
            renderMapMarkers();
            renderClinics(); renderStores(); renderFriendly(); renderDanger(); renderStats();
            document.getElementById('dangerBadge').textContent = allData.dangerReports?.length ?? 0;
        }

        /* ════════════════════════════════════════════════════════════
           MAP MARKERS — ★ Tag _src on every set
        ════════════════════════════════════════════════════════════ */
        function buildPin(type) {
            const color = COLORS[type] || '#7fa85a';
            const icon  = PIN_ICONS[type] || PIN_ICONS.petfriendly;
            return L.divIcon({
                className: '',
                html: `<div class="am-wrap">
                         <div class="am-body">
                           <svg class="am-svg" viewBox="0 0 36 44" xmlns="http://www.w3.org/2000/svg">
                             <path d="M18 2C10.27 2 4 8.27 4 16c0 10.4 13.05 24.57 13.62 25.18a.53.53 0 0 0 .78 0C18.95 40.57 32 26.4 32 16 32 8.27 25.73 2 18 2z"
                                   fill="${color}" stroke="rgba(255,255,255,.3)" stroke-width="1"/>
                             <circle cx="18" cy="16" r="9" fill="rgba(0,0,0,.1)"/>
                           </svg>
                           <div class="am-icon">${icon}</div>
                         </div>
                         <div class="am-shadow-dot"></div>
                       </div>`,
                iconSize: [36,48], iconAnchor: [18,48]
            });
        }

        function renderMapMarkers() {
            leafMarkers.forEach(m => m.remove());
            leafMarkers = [];

            const show = t => {
                if (panelFilter === 'all')      return true;
                if (panelFilter === 'clinic')   return t === 'clinic';
                if (panelFilter === 'store')    return t === 'store';
                if (panelFilter === 'friendly') return ['petfriendly','playground','park'].includes(t);
                if (panelFilter === 'danger')   return t === 'danger';
                return true;
            };

            // ★ Tag each set with _src so detail panel knows edit/delete eligibility
            const addSet = (places, defaultType, src) => (places||[]).forEach(p => {
                const t = p.markerType || defaultType;
                if (!show(t)) return;
                const tagged = {...p, _src: src};
                const m = L.marker([p.lat, p.lng], { icon: buildPin(t) }).addTo(map);
                m.on('click', e => { L.DomEvent.stopPropagation(e); openDetail(tagged, t); });
                leafMarkers.push(m);
            });

            addSet(allData.clinics,       'clinic',  'reg');
            addSet(allData.stores,        'store',   'reg');
            addSet(allData.adminMarkers,  null,      'admin');   // ← admin-added
            addSet(allData.dangerReports, 'danger',  'danger');  // ← danger = never editable
        }

        /* ════════════════════════════════════════════════════════════
           PANEL LISTS — merge adminMarkers into correct section
        ════════════════════════════════════════════════════════════ */
        function getClinicItems() {
            const reg   = (allData.clinics||[]).map(p  => ({...p, _src:'reg',   _type:'clinic'}));
            const admin = (allData.adminMarkers||[]).filter(m => m.markerType==='clinic')
                          .map(p => ({...p, _src:'admin', _type:'clinic', name:p.name||p.label||'—'}));
            return [...reg, ...admin].filter(bySearch);
        }
        function getStoreItems() {
            const reg   = (allData.stores||[]).map(p  => ({...p, _src:'reg',   _type:'store'}));
            const admin = (allData.adminMarkers||[]).filter(m => m.markerType==='store')
                          .map(p => ({...p, _src:'admin', _type:'store', name:p.name||p.label||'—'}));
            return [...reg, ...admin].filter(bySearch);
        }
        function getFriendlyItems() {
            return (allData.adminMarkers||[])
                .filter(m => ['petfriendly','playground','park'].includes(m.markerType))
                .map(p => ({...p, _src:'admin', _type:p.markerType, name:p.name||p.label||'—'}))
                .filter(bySearch);
        }

        function renderClinics() {
            const items = getClinicItems();
            document.getElementById('clinicCnt').textContent = `(${items.length})`;
            document.getElementById('clinicList').innerHTML = items.map(p => placeRow(p,'clinic')).join('') ||
                `<div class="empty-state">No clinics on map yet.</div>`;
        }
        function renderStores() {
            const items = getStoreItems();
            document.getElementById('storeCnt').textContent = `(${items.length})`;
            document.getElementById('storeList').innerHTML = items.map(p => placeRow(p,'store')).join('') ||
                `<div class="empty-state">No stores on map yet.</div>`;
        }
        function renderFriendly() {
            const items = getFriendlyItems();
            document.getElementById('friendlyCnt').textContent = `(${items.length})`;
            document.getElementById('friendlyList').innerHTML = items.map(p => placeRow(p,p._type)).join('') ||
                `<div class="empty-state">No pet-friendly places yet.<br>Click "+ Add" to start.</div>`;
        }
        function renderDanger() {
            const items = (allData.dangerReports||[]).filter(bySearch);
            document.getElementById('dangerList').innerHTML = items.map(d => dangerRow(d)).join('') ||
                `<div class="empty-state">No active danger reports 🎉</div>`;
        }
        function renderStats() {
            const c=getClinicItems().length, s=getStoreItems().length;
            const f=getFriendlyItems().length, d=(allData.dangerReports||[]).length;
            const total=c+s+f+d;
            document.getElementById('statsGrid').innerHTML =
                sc('🏥','Clinics',c,'#00c896')+sc('🛍️','Stores',s,'#8b5cf6')+
                sc('🌳','Places',f,'#7fa85a')+sc('🚨','Reports',d,'#ef4444');
            document.getElementById('statsExtra').innerHTML=`
                <div style="background:#fff;border:1px solid #e8e0d8;border-radius:14px;padding:14px">
                    <div style="font-size:.63rem;font-weight:900;color:#b0a090;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px">Distribution</div>
                    ${bar('Clinics',c,total,'#00c896')}${bar('Stores',s,total,'#8b5cf6')}
                    ${bar('Places',f,total,'#7fa85a')}${bar('Reports',d,total,'#ef4444')}
                </div>`;
        }
        function sc(ico,lbl,val,col){return`<div class="stat-card"><div class="stat-num" style="color:${col}">${val}</div><div class="stat-ico">${ico}</div><div class="stat-lbl">${lbl}</div></div>`;}
        function bar(lbl,val,total,col){const p=total>0?Math.round(val/total*100):0;return`<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:.74rem"><span style="min-width:60px;font-weight:700;color:#1a1612">${lbl}</span><div style="flex:1;height:4px;background:#f0ebe4;border-radius:3px;overflow:hidden"><div style="width:${p}%;height:100%;background:${col};border-radius:3px"></div></div><span style="color:#b0a090;font-weight:700;min-width:22px;text-align:right">${val}</span></div>`;}

        /* ── Row renderers ── */
        function placeRow(p, type) {
            const col = COLORS[type]||'#7fa85a', emo = EMOJIS[type]||'📍';
            const img = (p.logo||p.image)
                ? `<div class="prow-img"><img src="${p.logo||p.image}"/></div>`
                : `<div class="prow-img" style="background:${col}14;color:${col}">${emo}</div>`;
            const right = p._src==='admin'
                ? `<div class="prow-acts">
                       <button class="prow-btn edit" title="Edit"   onclick="event.stopPropagation();openEdit(${p.id})">✏️</button>
                       <button class="prow-btn del"  title="Delete" onclick="event.stopPropagation();confirmDel(${p.id},'${(p.name||'').replace(/'/g,'')}')">🗑</button>
                   </div>`
                : `<span class="prow-source source-reg">Registered</span>`;
                    const _k = storeRow(p);
            return `<div class="prow" onclick="rowClick('${_k}','${type}')">
                ${img}
                <div class="prow-body">
                    <div class="prow-name">${p.name||'—'}</div>
                    <div class="prow-sub">📍 ${[p.city,p.area].filter(Boolean).join(', ')||'—'}</div>
                </div>
                ${right}
            </div>`;
        }

        // ★ Danger rows: NO edit button, only review/resolve/fake + fly to location
        function dangerRow(d) {
            const sev = d.severity||'Medium';
                    const _dk = storeRow(d);
            return `<div class="drow" onclick="rowClick('${_dk}','danger')">
                <div class="drow-hd">
                    <div class="drow-name">${d.animalType} — ${(d.name||'').split('—')[1]?.trim()||''}</div>
                    <span class="drow-sev sev-${sev}">${sev}</span>
                </div>
                <div class="drow-meta">📍 ${[d.city,d.area].filter(Boolean).join(', ')} · ${d.status}</div>
                ${d.reportCode?`<div class="drow-code">${d.reportCode}</div>`:''}
                <div class="drow-btns">
                    ${d.status!=='Under Review'?`<button class="drow-btn review"  onclick="event.stopPropagation();updDanger(${d.id},'Under Review')">🔍 Review</button>`:''}
                    ${d.status!=='Resolved'    ?`<button class="drow-btn resolve" onclick="event.stopPropagation();updDanger(${d.id},'Resolved')">✅ Resolve</button>`:''}
                    <button class="drow-btn fake" onclick="event.stopPropagation();updDanger(${d.id},'Resolved')">🚫 Fake</button>
                </div>
            </div>`;
        }

        /* ★ DATA STORE — avoids inline JSON serialization bugs */
        const _rowStore = new Map();
        let _rowKey = 0;
        function storeRow(p) {
            const key = 'r' + (_rowKey++);
            _rowStore.set(key, p);
            return key;
        }

        /* ★ Click on row: fly map + open detail */
        function rowClick(key, type) {
            const p = _rowStore.get(key);
            if (!p) return;
            closePanelOverlay();
            map.setView([p.lat, p.lng], 16, { animate: true });
            setTimeout(() => openDetail(p, type), 150);
        }

        /* ════════════════════════════════════════════════════════════
           PANEL TOGGLE — tablet panel is always visible now (no toggle needed)
           closePanelOverlay kept as no-op for rowClick compatibility
        ════════════════════════════════════════════════════════════ */
        function toggleTabletPanel() { /* panel always visible on tablet */ }
        function openTabletPanel()   { /* no-op */ }
        function closePanelOverlay() { /* no-op — panel stays visible */ }


        /* ════════════════════════════════════════════════════════════
           FILTER / SEARCH / TABS
        ════════════════════════════════════════════════════════════ */
        function applyFilter(btn, f) {
            panelFilter = f;
            document.querySelectorAll('.fp').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderMapMarkers();
        }
        function filterList(q) {
            panelSearch = q.toLowerCase();
            renderClinics(); renderStores(); renderFriendly(); renderDanger();
        }
        function bySearch(p) {
            if (!panelSearch) return true;
            return (p.name||p.label||'').toLowerCase().includes(panelSearch)||
                   (p.city||'').toLowerCase().includes(panelSearch)||
                   (p.area||'').toLowerCase().includes(panelSearch);
        }
        function switchTab(tab) {
            ['places','danger','stats'].forEach(t => {
                document.getElementById(`pt-${t}`).classList.toggle('active', t===tab);
                document.getElementById(`sec-${t}`).classList.toggle('active', t===tab);
            });
        }

        /* ════════════════════════════════════════════════════════════
           ADD MODE
        ════════════════════════════════════════════════════════════ */
        function startAddMode() {
            presetType=null; addMode=true; editingId=null; pendingLat=null; pendingLng=null;
            document.getElementById('addBanner').classList.add('show');
            document.getElementById('adminMap').style.cursor='crosshair';
            closeRP();
        }
        function startAddModeFor(type) {
            presetType=type; addMode=true; editingId=null; pendingLat=null; pendingLng=null;
            document.getElementById('addBanner').classList.add('show');
            document.getElementById('adminMap').style.cursor='crosshair';
            closeRP();
        }
        function cancelAddMode() {
            addMode=false; presetType=null;
            document.getElementById('addBanner').classList.remove('show');
            document.getElementById('adminMap').style.cursor='';
        }

        /* ════════════════════════════════════════════════════════════
           TYPE SELECTOR
        ════════════════════════════════════════════════════════════ */
        function showTypeSelector() {
            cancelAddMode(); selectedType=null;
            setRP('Choose Location Type',false);
            document.getElementById('rpBody').innerHTML=`
            <div class="type-sel">
                <div class="type-sel-lbl">What type of location are you adding?</div>
                <div class="type-cards">
                    <div class="tc" id="tc-clinic"      data-type="clinic"      onclick="pickType('clinic')"><div class="tc-check">✓</div><div class="tc-ico-wrap">🏥</div><div class="tc-name">Clinic</div><div class="tc-desc">Vet clinic or animal hospital</div></div>
                    <div class="tc" id="tc-store"       data-type="store"       onclick="pickType('store')"><div class="tc-check">✓</div><div class="tc-ico-wrap">🛍️</div><div class="tc-name">Store</div><div class="tc-desc">Pet supply shop or pharmacy</div></div>
                    <div class="tc" id="tc-petfriendly" data-type="petfriendly" onclick="pickType('petfriendly')"><div class="tc-check">✓</div><div class="tc-ico-wrap">🌳</div><div class="tc-name">Pet Place</div><div class="tc-desc">Park, café, playground & more</div></div>
                </div>
                <button class="tc-continue" id="tcContinue" disabled onclick="showAddForm(null)">
                    <svg viewBox="0 0 24 24" fill="none" style="width:17px;height:17px" stroke="currentColor" stroke-width="2.2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5" fill="currentColor" stroke="none"/></svg>
                    Continue — Fill in Details
                </button>
            </div>`;
            openRP();
        }
        function pickType(type) {
            selectedType=type;
            document.querySelectorAll('.tc').forEach(c=>c.classList.remove('selected'));
            document.getElementById('tc-'+type)?.classList.add('selected');
            document.getElementById('tcContinue').disabled=false;
        }

        /* ════════════════════════════════════════════════════════════
           FORM
        ════════════════════════════════════════════════════════════ */
        function showAddForm(pf) {
            const coordOk = !!(pendingLat||pf?.lat);
            const coordTxt = coordOk
                ? `✅ ${parseFloat(pendingLat||pf?.lat).toFixed(5)}, ${parseFloat(pendingLng||pf?.lng).toFixed(5)}`
                : '⚠️ Location not set — go back and click on map';
            const tl={clinic:'Clinic',store:'Store',petfriendly:'Pet Place'}[selectedType]||'Location';
            setRP(editingId?`Edit ${tl}`:`Add ${tl} Details`,!editingId);
            document.getElementById('rpBody').innerHTML=`
            <div class="add-form">
                <div class="loc-pill ${coordOk?'ok':'empty'}"><span>${coordOk?'📍':'⚠️'}</span><span>${coordTxt}</span>${editingId?'<button class="loc-pill-repin" onclick="repin()">Move Pin</button>':''}</div>
                <div class="form-section">📷 Place Photo</div>
                <div class="photo-upload" id="imgArea" onclick="document.getElementById('imgFile').click()">
                    <div class="pu-placeholder" id="imgPH"><div class="pu-ico">📷</div><div class="pu-lbl">Click to upload a photo</div><div class="pu-sub">JPG or PNG — Max 5MB</div></div>
                    <img id="imgPrev" class="pu-preview" alt="" /><div class="pu-hover">🔄 Change Photo</div>
                </div>
                <input type="file" id="imgFile" accept="image/*" onchange="prevImg(this)" />
                <div class="form-section">📋 Basic Information</div>
                <div class="fg"><label class="fl">Name <span class="req">*</span></label><input class="fi" id="fLabel" type="text" placeholder="e.g. Al Amanah Clinic" value="${pf?.label||pf?.name||''}" /></div>
                <div class="fg-2"><div class="fg"><label class="fl">City</label><input class="fi" id="fCity" type="text" placeholder="Amman" value="${pf?.city||''}" /></div><div class="fg"><label class="fl">Area</label><input class="fi" id="fArea" type="text" placeholder="Jubaiha" value="${pf?.area||''}" /></div></div>
                <div class="form-section">📞 Contact & Hours</div>
                <div class="fg"><label class="fl">Phone Number</label><input class="fi" id="fPhone" type="tel" placeholder="+962 79 123 4567" value="${pf?.phone||''}" /></div>
                <div class="fg"><label class="fl">Working Hours</label><input class="fi" id="fHours" type="text" placeholder="Daily 9AM – 10PM" value="${pf?.hours||pf?.workingHours||''}" /></div>
                <div class="fg"><label class="fl">Website</label><input class="fi" id="fWeb" type="url" placeholder="https://example.com" value="${pf?.website||''}" /></div>
                <div class="form-section">📝 Description & Notes</div>
                <div class="fg"><label class="fl">Description</label><textarea class="fta" id="fDesc" placeholder="What makes this place special?">${pf?.description||''}</textarea></div>
                <div class="fg"><label class="fl">Admin Notes <span style="font-weight:500;color:#b0a090">(internal)</span></label><textarea class="fta" id="fNotes" placeholder="Private notes…" style="min-height:60px">${pf?.notes||''}</textarea></div>
                <input type="hidden" id="fLat" value="${pendingLat||pf?.lat||''}" />
                <input type="hidden" id="fLng" value="${pendingLng||pf?.lng||''}" />
                <button class="save-btn" onclick="saveMarker()">
                    <svg viewBox="0 0 24 24" fill="none" style="width:16px;height:16px" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    ${editingId?'Save Changes':'Add to Map'}
                </button>
                ${!editingId?`<button class="back-btn" onclick="showTypeSelector()">← Back to type selection</button>`:''}
            </div>`;
            if (pf?.imageUrl) {
                document.getElementById('imgPrev').src=pf.imageUrl;document.getElementById('imgPrev').style.display='block';
                document.getElementById('imgPH').style.display='none';document.getElementById('imgArea').classList.add('filled');
            }
            openRP();
        }
        function prevImg(input) {
            if (!input.files?.[0]) return;
            const r=new FileReader();
            r.onload=e=>{document.getElementById('imgPrev').src=e.target.result;document.getElementById('imgPrev').style.display='block';document.getElementById('imgPH').style.display='none';document.getElementById('imgArea').classList.add('filled');};
            r.readAsDataURL(input.files[0]);
        }
        function repin() { startAddMode(); showToast('Click on map to move the pin'); }

        /* ════════════════════════════════════════════════════════════
           EDIT
        ════════════════════════════════════════════════════════════ */
        async function openEdit(id) {
            editingId=id;
            const res=await fetch(`/Map/GetMarkerById?id=${id}`);
            const data=await res.json();
            if(!data.success){showToast('⚠️ Could not load');return;}
            selectedType=data.markerType;pendingLat=String(data.lat);pendingLng=String(data.lng);
            showAddForm(data);
        }

        /* ════════════════════════════════════════════════════════════
           SAVE
        ════════════════════════════════════════════════════════════ */
        async function saveMarker() {
            const label=document.getElementById('fLabel')?.value.trim();
            const lat=document.getElementById('fLat')?.value;
            const lng=document.getElementById('fLng')?.value;
            if(!label){hilite('fLabel');return;}
            if(!lat){showToast('⚠️ Location not set');return;}
            const fd=new FormData();
            fd.append('markerType',  selectedType||'petfriendly');
            fd.append('label',       label); fd.append('latitude',    lat); fd.append('longitude',   lng);
            fd.append('city',        document.getElementById('fCity')?.value||'');
            fd.append('area',        document.getElementById('fArea')?.value||'');
            fd.append('phone',       document.getElementById('fPhone')?.value||'');
            fd.append('workingHours',document.getElementById('fHours')?.value||'');
            fd.append('description', document.getElementById('fDesc')?.value||'');
            fd.append('website',     document.getElementById('fWeb')?.value||'');
            fd.append('notes',       document.getElementById('fNotes')?.value||'');
            fd.append('__RequestVerificationToken',getToken());
            const imgFile=document.getElementById('imgFile')?.files?.[0];
            if(imgFile)fd.append('image',imgFile);
            const url=editingId?'/Map/EditAdminMarker':'/Map/AddAdminMarker';
            if(editingId)fd.append('id',editingId);
            const res=await fetch(url,{method:'POST',body:fd});
            const data=await res.json();
            if(data.success){closeRP();await fetchData();map.setView([parseFloat(lat),parseFloat(lng)],16,{animate:true});showToast(editingId?'✅ Updated!':'✅ Added to map!');editingId=null;}
            else{showToast('⚠️ '+(data.message||'Error'));}
        }

        /* ════════════════════════════════════════════════════════════
           DETAIL PANEL
           ★ isAdmin = only admin-added places (NOT danger, NOT registered clinic/store)
        ════════════════════════════════════════════════════════════ */
        function openDetail(p, type) {
            editingId=null;
            const color=COLORS[type]||'#7fa85a';
            const emoji=EMOJIS[type]||'📍';
            const label=LABELS[type]||type;

            // ★ FIX: Only show edit/delete for admin-added non-danger items
            const canEdit = p._src === 'admin' && type !== 'danger';

            setRP(label+' Details',false);
            const photoHtml=(p.image||p.logo)?`<img src="${p.image||p.logo}" alt="${p.name||''}" />`:`<div class="dv-photo-ph" style="background:linear-gradient(135deg,${color}18,${color}32)">${emoji}</div>`;
            const dangerBar=type==='danger'?`<div class="dv-danger-bar" style="background:${p.severity==='High'?'#fee2e2':p.severity==='Low'?'#f0fdf4':'#fff3e0'};color:${p.severity==='High'?'#dc2626':p.severity==='Low'?'#16a34a':'#b45309'}"><span>${p.severity==='High'?'🔴':p.severity==='Low'?'🟢':'🟠'}</span><strong>${p.severity||'Medium'} Severity</strong><span style="margin-left:auto;font-size:.72rem;opacity:.75">${p.status||''}</span></div>`:'';
            const rows=[];
            if(p.city||p.area) rows.push(dr('📍','Location',[p.city,p.area].filter(Boolean).join(', ')));
            if(p.phone)         rows.push(dr('📞','Phone',`<a href="tel:${p.phone}">${p.phone}</a>`));
                    const _hrs = p.hours || p.workingHours || p.openingHours;
        if (_hrs) rows.push(dr('🕐','Hours', _hrs));
            if(p.description)   rows.push(dr('📝','About',p.description));
            if(p.website)       rows.push(dr('🌐','Website',`<a href="${p.website}" target="_blank">${p.website.replace(/https?:\/\//,'')}</a>`));
            if(p.notes)         rows.push(dr('🗒️','Notes',p.notes));
            if(p.reportCode)    rows.push(dr('🔖','Code',`<code style="font-size:.74rem">${p.reportCode}</code>`));
            if(p.hasEmergency)  rows.push(dr('🚑','Emergency','<strong style="color:#16a34a">24/7 Available</strong>'));

            const mapsUrl=`https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}`;
            let acts=`<a class="dv-btn primary" href="${mapsUrl}" target="_blank">🧭 Directions</a>`;

            if (canEdit) {
                // Admin-added clinics, stores, pet-friendly places → full edit controls
                acts += `<button class="dv-btn edit" onclick="openEdit(${p.id})">✏️ Edit</button>`;
                acts += `<button class="dv-btn del"  onclick="confirmDel(${p.id},'${(p.name||'').replace(/'/g,'')}')">🗑 Delete</button>`;
                acts += `<button class="dv-btn hide" onclick="doHide(${p.id})">👁 Hide</button>`;
            } else if (type==='clinic' && p._src!=='admin') {
                acts += `<a class="dv-btn edit" href="/SuperAdmin/Clinics">⚙️ Manage Clinic</a>`;
            } else if (type==='store' && p._src!=='admin') {
                acts += `<a class="dv-btn edit" href="/SuperAdmin/Stores">⚙️ Manage Store</a>`;
            } else if (type==='danger') {
                // Danger: only resolve + full report (NO edit)
                if (p.status!=='Resolved') acts += `<button class="dv-btn edit" onclick="updDanger(${p.id},'Resolved')">✅ Resolve</button>`;
                acts += `<a class="dv-btn hide" href="/SuperAdmin/Dangerous_Animals">📋 Full Report</a>`;
            }

            document.getElementById('rpBody').innerHTML=`<div class="detail-view"><div class="dv-photo" style="${!(p.image||p.logo)?'background:linear-gradient(135deg,'+color+'18,'+color+'32)':''}">${photoHtml}</div><div class="dv-content"><div class="dv-name">${p.name||p.label||'—'}</div><span class="dv-badge" style="background:${color}18;color:${color}">${emoji} ${label}</span>${dangerBar}${rows.join('')}</div><div class="dv-actions">${acts}</div></div>`;
            openRP();
                    // ── جلب صور البلاغ إذا كان danger ──────────────────
        if (type === 'danger' && p.id) {
            fetch('/SuperAdmin/GetDangerImages?reportId=' + p.id)
                .then(function(r) { return r.json(); })
                .then(function(images) {
                    if (!images || images.length === 0) return;

                    // نبحث عن dv-actions ونضيف الصور قبله
                    var rpBody = document.getElementById('rpBody');
                    var acts   = rpBody.querySelector('.dv-actions');
                    if (!acts) return;

                    var grid = document.createElement('div');
                    grid.style.cssText = 'padding:0 20px 16px';
                    grid.innerHTML =
                        '<div style="font-size:.63rem;font-weight:900;color:#b0a090;' +
                        '     letter-spacing:1px;text-transform:uppercase;margin-bottom:8px">' +
                        '📷 Evidence Photos (' + images.length + ')</div>' +
                        '<div style="display:grid;grid-template-columns:repeat(' +
                        Math.min(images.length, 4) + ',1fr);gap:6px">' +
                        images.map(function(img) {
                            return '<a href="' + img.imageUrl + '" target="_blank" ' +
                                   '   style="display:block;border-radius:10px;overflow:hidden;' +
                                   '          aspect-ratio:1;background:#f0e8d8">' +
                                   '  <img src="' + img.imageUrl + '" ' +
                                   '       style="width:100%;height:100%;object-fit:cover"/>' +
                                   '</a>';
                        }).join('') +
                        '</div>';

                    // ندرج الـ grid قبل الـ actions
                    acts.parentNode.insertBefore(grid, acts);
                })
                .catch(function() {}); // لا صور — نتجاهل
        }
        }

        function dr(ico,key,val){return`<div class="dv-row"><div class="dv-ico">${ico}</div><span class="dv-key">${key}</span><span class="dv-val">${val}</span></div>`;}

        /* ════════════════════════════════════════════════════════════
           API
        ════════════════════════════════════════════════════════════ */
        async function confirmDel(id,name){if(!confirm(`Delete "${name}"?`))return;const form=new URLSearchParams({id,__RequestVerificationToken:getToken()});await fetch('/Map/DeleteAdminMarker',{method:'POST',body:form});closeRP();await fetchData();showToast('🗑 Deleted');}
        async function doHide(id){const form=new URLSearchParams({id,status:'Hidden',__RequestVerificationToken:getToken()});await fetch('/Map/ToggleAdminMarker',{method:'POST',body:form});closeRP();await fetchData();showToast('👁 Hidden');}
        async function updDanger(id,status){const form=new URLSearchParams({reportId:id,status,__RequestVerificationToken:getToken()});await fetch('/SuperAdmin/UpdateDangerStatus',{method:'POST',body:form});await fetchData();showToast(status==='Resolved'?'✅ Resolved':'🔍 Under review');}

        /* ════════════════════════════════════════════════════════════
           HELPERS
        ════════════════════════════════════════════════════════════ */
        function setRP(title,showBack){document.getElementById('rpTitle').textContent=title;const b=document.getElementById('rpBack');if(showBack)b.classList.add('show');else b.classList.remove('show');}
        function rpGoBack(){showTypeSelector();}
        function openRP() {document.getElementById('rightPanel').classList.add('open');}
        function closeRP(){document.getElementById('rightPanel').classList.remove('open');editingId=null;}
        function hilite(id){const el=document.getElementById(id);if(!el)return;el.style.borderColor='#dc2626';el.focus();setTimeout(()=>el.style.borderColor='',2000);}
        function getToken(){return document.querySelector('input[name="__RequestVerificationToken"]')?.value??'';}
        function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2800);}
        document.addEventListener('keydown',e=>{if(e.key==='Escape'){cancelAddMode();closeRP();}});
        window.addEventListener('resize',()=>{ if(map) map.invalidateSize(); });
        document.addEventListener('DOMContentLoaded',()=>{ initMap(); fetchData(); });
    </script>
</body>
</html>
