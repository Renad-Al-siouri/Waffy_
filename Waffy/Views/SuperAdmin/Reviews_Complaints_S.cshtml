@using Waffy.Models
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Waffy — Super Admin | Store Reviews & Complaints";
    ViewData["ActiveSection"] = "shop";
    ViewData["ActivePage"] = "complaints-store";
    ViewData["PageTitle"] = "Store Reviews & Complaints";
    ViewData["BreadcrumbParent"] = "Shop";
    ViewData["BreadcrumbCurrent"] = "Stores";
    var complaints = ViewBag.Complaints as List<Complaint> ?? new();
    var totalComplaints = (int)(ViewBag.TotalComplaints ?? 0);
    var openComplaints = (int)(ViewBag.OpenComplaints ?? 0);
    var investigatingCount = (int)(ViewBag.InvestigatingCount ?? 0);
    var resolvedComplaints = (int)(ViewBag.ResolvedComplaints ?? 0);
}

<main class="wa-main" id="waMain">

    @if (ViewBag.Success != null)
    {
        <div style="margin:0 0 12px;padding:12px 16px;background:var(--success-soft);border:1px solid rgba(47,158,95,.3);border-radius:12px;font-weight:800;color:var(--success);font-size:.86rem;">@ViewBag.Success</div>
    }

    <section class="page-hero">
        <div>
            <h1>Store Complaints</h1>
            <p>Handle and resolve complaints submitted against stores.</p>
        </div>
    </section>

    <div class="page-body">

        <!-- KPIs -->
        <div class="kpi-grid kpi-grid-4">
            <div class="kpi-card c1"><div class="kpi-ico green">📋</div><div class="kpi-val">@totalComplaints</div><div class="kpi-label">Total Complaints</div></div>
            <div class="kpi-card c4">
                <div class="kpi-ico red">🚨</div><div class="kpi-val">@openComplaints</div><div class="kpi-label">Open</div>@if(openComplaints>0){
                <div class="kpi-chip chip-red">Needs action</div>
                                }
            </div>
            <div class="kpi-card c3"><div class="kpi-ico yellow">🔍</div><div class="kpi-val">@investigatingCount</div><div class="kpi-label">Investigating</div></div>
            <div class="kpi-card c1"><div class="kpi-ico green">✅</div><div class="kpi-val">@resolvedComplaints</div><div class="kpi-label">Resolved</div></div>
        </div>

        <!-- Filters -->
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
            <div class="search-wrap" style="flex:1 1 240px;">
                <span style="color:var(--text-muted);">🔍</span>
                <input type="text" id="compSearch" placeholder="Search complaints..." oninput="filterComplaints()" />
            </div>
            <select class="sel-wrap" style="width:auto;min-width:160px;" id="compStatusFilter" onchange="filterComplaints()">
                <option value="">All Statuses</option>
                <option value="open">🔴 Open</option>
                <option value="pending">🟡 Pending</option>
                <option value="investigating">🔍 Investigating</option>
                <option value="resolved">✅ Resolved</option>
            </select>
            <select class="sel-wrap" style="width:auto;min-width:160px;" id="compPriorityFilter" onchange="filterComplaints()">
                <option value="">All Priorities</option>
                <option value="high">🔴 High</option>
                <option value="medium">🟡 Medium</option>
                <option value="low">🟢 Low</option>
            </select>
            <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
        </div>

        <!-- Complaints List -->
        <div id="complaintsList">
            @if (!complaints.Any())
            {
                <div style="text-align:center;padding:48px;color:var(--text-muted);">
                    <div style="font-size:2.5rem;margin-bottom:12px;">📋</div>
                    <p style="font-weight:800;">No store complaints yet.</p>
                </div>
            }
            else
            {
                @foreach (var c in complaints)
                {
                    var priorityColor = c.Priority == "High" ? "var(--danger)"
                    : c.Priority == "Medium" ? "var(--warning)"
                    : "var(--border)";

                    var stBadge = c.Status switch
                    {
                        "Resolved" => "badge-success",
                        "Investigating" => "badge-warning",
                        "Pending" => "badge-warning",
                        "Open" => "badge-danger",
                        _ => "badge-muted"
                    };
                    var prBadge = c.Priority switch
                    {
                        "High" => "badge-danger",
                        "Medium" => "badge-warning",
                        _ => "badge-muted"
                    };

                    var storeName = c.TargetName ?? $"Store #{c.TargetId}";
                    var userName = c.ComplainantName ?? $"User #{c.IdUser}";

                    <div class="complaint-row"
                         data-search="@c.Title @c.ComplainantName @c.Description @storeName"
                         data-status="@c.Status?.ToLower()"
                         data-priority="@c.Priority?.ToLower()"
                         style="background:#fff;border:1px solid var(--border);
                                                    border-left:4px solid @priorityColor;
                                                    border-radius:var(--r-lg);padding:18px;
                                                    margin-bottom:12px;box-shadow:var(--shadow);">

                        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:10px;">
                            <div>
                                <div style="font-size:.92rem;font-weight:900;color:var(--brand-dark);">@(c.Title ?? "Complaint")</div>
                                <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">
                                    🏪 @storeName &nbsp;·&nbsp; 👤 @userName &nbsp;·&nbsp; 📅 @c.CreatedAt?.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                @if (c.Priority != null)
                                {
                                    <span class="badge @prBadge">
                                        @(c.Priority == "High" ? "🔴" : c.Priority == "Medium" ? "🟡" : "🟢") @c.Priority
                                    </span>
                                }
                                <span class="badge @stBadge">@c.Status</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <div style="font-size:.84rem;color:var(--text-muted);line-height:1.55;margin-bottom:12px;padding:12px;background:var(--surface-2);border-radius:10px;">
                                @(c.Description.Length > 160 ? c.Description[..160] + "…" : c.Description)
                            </div>
                        }

                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                            <!-- تفاصيل -->
                            <button type="button" class="btn btn-outline btn-xs"
                                    onclick="openDetails('@c.IdComplaint','@(c.Title?.Replace("'", "") ?? "Complaint")','@storeName','@userName','@c.CreatedAt?.ToString("MMM dd, yyyy")','@c.Priority','@(c.Description?.Replace("'", "").Replace("\n", " ") ?? "")','@c.Status')">
                                👁 Details
                            </button>

                            <!-- Resolve -->
                            <!-- Warn — يرسل للسيرفر فعلاً -->
                            <button type="button" class="btn btn-warning btn-xs"
                                    onclick="openWarn('@c.TargetId','@storeName')">
                                ⚠️ Warn Store
                            </button>

                            <!-- Suspend -->
                            <button type="button" class="btn btn-danger btn-xs"
                                    onclick="openSuspend('@c.TargetId','@storeName')">
                                🔒 Suspend
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</main>

</div>

<!-- Detail Panel -->
<div class="detail-overlay" id="compDetailPanel">
    <div class="detail-panel" style="max-width:680px;">
        <div class="dp-header">
            <div class="dp-title" id="detailTitle">🚨 Complaint Details</div>
            <button class="dp-close" onclick="closeM('compDetailPanel')">✕</button>
        </div>
        <div class="dp-body" id="detailBody"></div>
        <div class="dp-footer">
            <button class="btn btn-outline btn-sm" onclick="closeM('compDetailPanel')">Close</button>
        </div>
    </div>
</div>

<!-- Warn Modal -->
<div class="modal-overlay" id="warnModal">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-head"><div class="modal-title">⚠️ Send Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
        <div class="modal-body">
            <div class="field"><label>Store</label><input type="text" id="warnStoreName" readonly style="background:#f5f0e8;" /></div>
            <div class="field">
                <label>Warning Type</label>
                <select id="warnType">
                    <option>High complaint volume</option>
                    <option>Policy violation</option>
                    <option>Misleading information</option>
                    <option>Repeated delivery delays</option>
                </select>
            </div>
            <div class="field"><label>Message</label><textarea id="warnMessage" placeholder="Write the warning..."></textarea></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
            <button class="btn btn-warning" onclick="sendWarning()">Send Warning</button>
        </div>
    </div>
</div>

<!-- Suspend Modal -->
<div class="modal-overlay" id="suspendModal">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-head"><div class="modal-title">🔒 Suspend Store</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
        <div class="modal-body">
            <div class="field"><label>Store</label><input type="text" id="suspendStoreName" readonly style="background:#f5f0e8;" /></div>
            <div class="field">
                <label>Reason</label>
                <select id="suspendReason">
                    <option>Multiple complaints</option>
                    <option>Policy violation</option>
                    <option>Suspicious activity</option>
                </select>
            </div>
            <div class="field">
                <label>Duration</label>
                <select id="suspendDuration">
                    <option>7 days</option>
                    <option>30 days</option>
                    <option>90 days</option>
                    <option>Permanent</option>
                </select>
            </div>
            <div class="field"><label>Message</label><textarea id="suspendMessage" placeholder="Explain..."></textarea></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
            <button class="btn btn-danger" onclick="submitSuspend()">Suspend Store</button>
        </div>
    </div>
</div>

<!-- Hidden Suspend Form -->
<form id="suspendForm" method="post" asp-controller="SuperAdmin" asp-action="SuspendStore">
    @Html.AntiForgeryToken()
    <input type="hidden" name="storeId" id="suspendStoreId" />
    <input type="hidden" name="reason" id="suspendReasonH" />
    <input type="hidden" name="duration" id="suspendDurationH" />
    <input type="hidden" name="message" id="suspendMessageH" />
    <input type="hidden" name="from" value="complaints" />
</form>

<script src="~/js/superAdminClinic.js"></script>

@section PageScripts {
    <script>
        let currentWarnStoreId = null;

        // ── Filter ──
        function filterComplaints() {
            const q  = (document.getElementById('compSearch')?.value || '').toLowerCase();
            const st = (document.getElementById('compStatusFilter')?.value || '').toLowerCase();
            const pr = (document.getElementById('compPriorityFilter')?.value || '').toLowerCase();

            document.querySelectorAll('.complaint-row').forEach(row => {
                const mQ  = !q  || (row.dataset.search   || '').toLowerCase().includes(q);
                const mSt = !st || (row.dataset.status   || '') === st;
                const mPr = !pr || (row.dataset.priority || '') === pr;
                row.style.display = (mQ && mSt && mPr) ? '' : 'none';
            });
        }

        function resetFilters() {
            document.getElementById('compSearch').value = '';
            document.getElementById('compStatusFilter').selectedIndex = 0;
            document.getElementById('compPriorityFilter').selectedIndex = 0;
            filterComplaints();
        }

        // ── Details Panel ──
        function openDetails(id, title, store, user, date, priority, desc, status) {
            const prBadge = priority === 'High'
                ? '<span class="badge badge-danger">🔴 High</span>'
                : priority === 'Medium'
                ? '<span class="badge badge-warning">🟡 Medium</span>'
                : '<span class="badge badge-muted">🟢 Low</span>';

            const stBadge = status === 'Resolved'
                ? '<span class="badge badge-success">✅ Resolved</span>'
                : status === 'Investigating'
                ? '<span class="badge badge-warning">🔍 Investigating</span>'
                : '<span class="badge badge-danger">🔴 Open</span>';

            document.getElementById('detailTitle').textContent = '🚨 ' + title;
            document.getElementById('detailBody').innerHTML = `
                <div class="dp-section">
                    <div class="dp-section-title">Overview</div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">${stBadge} ${prBadge}</div>
                    <div class="dp-grid">
                        <div class="dp-info-item"><div class="dp-info-label">🏪 Store</div><div class="dp-info-val">${store}</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">👤 Filed By</div><div class="dp-info-val">${user}</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">📅 Date</div><div class="dp-info-val">${date}</div></div>
                        <div class="dp-info-item"><div class="dp-info-label">⚡ Priority</div><div class="dp-info-val">${priority || '—'}</div></div>
                    </div>
                </div>
                <div class="dp-section">
                    <div class="dp-section-title">Description</div>
                    <div style="background:var(--surface-2);border-radius:12px;padding:16px;font-size:.88rem;line-height:1.7;">${desc || '—'}</div>
                </div>`;

            openM('compDetailPanel');
        }

        // ── Warn — يرسل للسيرفر ──
        function openWarn(storeId, storeName) {
            currentWarnStoreId = storeId;
            document.getElementById('warnStoreName').value = storeName;
            document.getElementById('warnMessage').value   = '';
            openM('warnModal');
        }

        async function sendWarning() {
            const msg  = document.getElementById('warnMessage').value.trim();
            const type = document.getElementById('warnType').value;
            if (!msg) { toast('Please write a warning message.', 'warning'); return; }

            const fd = new FormData();
            fd.append('storeId',     currentWarnStoreId);
            fd.append('warnType',    type);
            fd.append('warnMessage', msg);
            fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            try {
                const res  = await fetch('/SuperAdmin/WarnStore', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    closeM('warnModal');
                    toast('⚠️ Warning sent to store owner.', 'warning');
                }
            } catch(e) { toast('Error sending warning.', 'danger'); }
        }

        // ── Suspend — يرسل للسيرفر ──
        function openSuspend(storeId, storeName) {
            document.getElementById('suspendStoreId').value   = storeId;
            document.getElementById('suspendStoreName').value = storeName;
            document.getElementById('suspendMessage').value   = '';
            openM('suspendModal');
        }

        function submitSuspend() {
            document.getElementById('suspendReasonH').value   = document.getElementById('suspendReason').value;
            document.getElementById('suspendDurationH').value = document.getElementById('suspendDuration').value;
            document.getElementById('suspendMessageH').value  = document.getElementById('suspendMessage').value;
            closeM('suspendModal');
            document.getElementById('suspendForm').submit();
        }

        // ── Modal helpers ──
        function openM(id)  { const m = document.getElementById(id); if (m) m.classList.add('open'); }
        function closeM(id) { const m = document.getElementById(id); if (m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay,.detail-overlay').forEach(m =>
            m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); }));

        // ── Toast ──
        function toast(msg, type = 'success') {
            const bg  = { success:'var(--success-soft)', danger:'var(--danger-soft)', warning:'var(--warning-soft)' };
            const col = { success:'var(--success)', danger:'var(--danger)', warning:'#9b6000' };
            const t   = document.createElement('div');
            t.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;
                border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;
                color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;
                box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }
    </script>
}
