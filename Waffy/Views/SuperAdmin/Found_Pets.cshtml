@model Waffy.Models.ViewModels.SuperAdminFoundViewModel
@{
    Layout = null;
    var medals = new[] { "🥇", "🥈", "🥉" };
    var medalBg = new[] { "#FFF8E1", "#F5F5F5", "#FFF3E0" };
    var medalBorder = new[] { "rgba(255,193,7,.3)", "rgba(158,158,158,.3)", "rgba(255,152,0,.3)" };
    var medalColor = new[] { "#F9A825", "#757575", "#E65100" };
    var rewardedIds = ViewBag.RewardedClaimIds as HashSet<int> ?? new HashSet<int>();
    // إجمالي الـ Confirmed هذا الشهر من Top Finders (للـ progress bar)
    var topTotal = Model.TopFinders.Sum(f => f.ConfirmedCount);
    if (topTotal == 0) topTotal = 1; // منع القسمة على صفر
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | Found Pets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
    <style>
        /* ── Top Finder Card ── */
        .finder-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 20px;
            box-shadow: var(--shadow);
            transition: transform .18s, box-shadow .18s;
            position: relative;
            overflow: hidden;
        }

            .finder-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(89,101,42,.12);
            }

        .finder-rank-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            font-size: 1.6rem;
        }

        .finder-av {
            width: 52px;
            height: 52px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Fredoka', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 12px;
            background: linear-gradient(135deg, var(--brand), var(--brand-dark));
        }

        .finder-name {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--brand-dark);
            margin-bottom: 3px;
        }

        .finder-phone {
            font-size: .78rem;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 12px;
        }

        .finder-stats {
            display: flex;
            gap: 12px;
            margin-bottom: 14px;
        }

        .finder-stat {
            flex: 1;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 8px 10px;
            text-align: center;
        }

        .finder-stat-val {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--brand-dark);
        }

        .finder-stat-lbl {
            font-size: .67rem;
            color: var(--text-muted);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .03em;
        }
        /* Progress bar */
        .finder-progress-wrap {
            margin-bottom: 14px;
        }

        .finder-progress-label {
            display: flex;
            justify-content: space-between;
            font-size: .72rem;
            font-weight: 900;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .finder-progress-bg {
            height: 7px;
            background: var(--surface-2);
            border-radius: 10px;
            overflow: hidden;
        }

        .finder-progress-fill {
            height: 100%;
            border-radius: 10px;
            background: linear-gradient(90deg, var(--brand), var(--brand-dark));
            transition: width .6s ease;
        }
        /* Hero badge */
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: linear-gradient(135deg, #fff8e1, #ffecb3);
            border: 1px solid rgba(255,193,7,.4);
            border-radius: 20px;
            padding: 3px 10px;
            font-size: .7rem;
            font-weight: 900;
            color: #F9A825;
            margin-bottom: 10px;
        }
        /* Contact reveal */
        .contact-reveal {
            display: none;
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 14px;
            margin-top: 10px;
            animation: fadeIn .2s ease;
        }

            .contact-reveal.open {
                display: block;
            }
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .contact-line {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 0;
            border-bottom: 1px solid rgba(0,0,0,.05);
            font-size: .82rem;
        }

            .contact-line:last-child {
                border-bottom: none;
            }

            .contact-line span:first-child {
                color: var(--text-muted);
                font-weight: 700;
            }

            .contact-line span:last-child {
                font-weight: 900;
                color: var(--brand-dark);
            }
        /* Detail row */
        .detail-panel-row {
            display: none;
            background: var(--surface-2);
            border-top: 1px solid var(--border);
        }

            .detail-panel-row.open {
                display: table-row;
            }

        .detail-inner {
            padding: 14px 18px;
        }
        /* Anonymous badge */
        .anon-badge {
            display: inline-block;
            background: #f5f5f5;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 2px 8px;
            font-size: .68rem;
            color: #888;
            font-weight: 800;
        }
    </style>
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        @* ── Sidebar ── *@
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark">
                    <div class="sb-wm-name">Waffy</div>
                    <div class="sb-wm-tag">Super Admin</div>
                </div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Users">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg></span>
                        <span class="sb-lbl">Users</span>
                    </a>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg></span>
                            <span class="sb-lbl">Adoption</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg></span>
                            <span class="sb-lbl">Reports</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-rep" style="height:auto;">
                            <div class="sb-sub-inner">
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                                <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Found_Pets">
                                    <span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span>
                                    <span class="sb-bdg bd-g sb-child-bdg">@Model.ConfirmedCount</span>
                                </a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                                <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6" /></svg></span>
                        <span class="sb-lbl">Map</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20 12V22H4V12" /><path d="M22 7H2v5h20V7z" /><path d="M12 22V7" /></svg></span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon">
                            <svg class="ico" viewBox="0 0 24 24">
                                <path d="M20 12V22H4V12" />
                                <path d="M22 7H2v5h20V7z" />
                                <path d="M12 22V7" />
                            </svg>
                        </span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@ViewBag.AdminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@ViewBag.AdminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <form method="post" asp-controller="Account" asp-action="Logout" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button class="sb-logout" type="submit">
                        <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        <span class="sb-logout-lbl">Sign Out</span>
                    </button>
                </form>
            </div>
        </aside>

        @* ── Topnav ── *@
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <nav class="tn-bread"><span>Reports</span><span>/</span><b>Found Pets</b></nav>
            <div class="tn-center">
                <div class="tn-center-main">✅ Found Pets</div>
                <div class="tn-center-sub">Finder claims & rewards</div>
            </div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <div class="tn-profile">
                    <div class="tn-av">@ViewBag.AdminInitials</div>
                    <div>
                        <div class="tn-pname">@ViewBag.AdminName</div>
                        <div class="tn-prole">Super Admin</div>
                    </div>
                </div>
            </div>
        </header>

        @* ── Main ── *@
        <main class="wa-main" id="waMain">

            @if (ViewBag.Success != null)
            {
                <div style="margin:16px 24px 0;background:var(--success-soft);border:1px solid rgba(46,125,50,.2);
                            color:#2e7d32;padding:12px 16px;border-radius:var(--r);font-weight:800;font-size:.86rem;">
                    @ViewBag.Success
                </div>
            }
            @if (ViewBag.Error != null)
            {
                <div style="margin:16px 24px 0;background:var(--danger-soft);border:1px solid rgba(220,38,38,.2);
                            color:var(--danger);padding:12px 16px;border-radius:var(--r);font-weight:800;font-size:.86rem;">
                    @ViewBag.Error
                </div>
            }

            <section class="page-hero">
                <div>
                    <h1>✅ Found Pets</h1>
                    <p>@Model.TotalClaims total claims — @Model.TotalRewardsIssued.ToString("F2") JOD in rewards issued</p>
                </div>
            </section>

            <div class="page-body">

                @* ── KPI Cards ── *@
                <div class="kpi-grid kpi-grid-4" style="margin-bottom:24px;">
                    <div class="kpi-card c3">
                        <div class="kpi-ico yellow">🔍</div>
                        <div class="kpi-val">@Model.PendingCount</div>
                        <div class="kpi-label">Pending Claims</div>
                        <div class="kpi-chip chip-yellow">Awaiting owner</div>
                    </div>
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">✅</div>
                        <div class="kpi-val">@Model.ConfirmedCount</div>
                        <div class="kpi-label">Confirmed</div>
                        <div class="kpi-chip chip-green">Pets returned</div>
                    </div>
                    <div class="kpi-card c2">
                        <div class="kpi-ico blue">💰</div>
                        <div class="kpi-val">@Model.TotalRewardsIssued.ToString("F0")</div>
                        <div class="kpi-label">JOD Rewarded</div>
                        <div class="kpi-chip chip-blue">All time</div>
                    </div>
                    <div class="kpi-card c4">
                        <div class="kpi-ico red">🏆</div>
                        <div class="kpi-val">@Model.TopFinders.Count()</div>
                        <div class="kpi-label">Top Finders</div>
                        <div class="kpi-chip chip-red">This month</div>
                    </div>
                </div>

                @* ══ TOP FINDERS SECTION ══════════════════════════════════ *@
                @if (Model.TopFinders.Any())
                {
                    <div style="margin-bottom:24px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;
                                    margin-bottom:14px;flex-wrap:wrap;gap:8px;">
                            <div>
                                <div style="font-family:'Fredoka',sans-serif;font-size:1.15rem;
                                            font-weight:700;color:var(--brand-dark);">
                                    🏆 Top Finders This Month
                                </div>
                                <div style="font-size:.78rem;color:var(--text-muted);font-weight:700;margin-top:2px;">
                                    Ranked by confirmed finds · Contact for urgent cases
                                </div>
                            </div>
                            <div style="background:var(--warning-soft);border:1px solid rgba(226,163,58,.3);
                                        border-radius:10px;padding:6px 12px;font-size:.76rem;
                                        font-weight:900;color:#9b6000;">
                                ⚡ Use Contact for urgent missing pets in their area
                            </div>
                        </div>
                        <div style="display:grid;
                grid-template-columns:repeat(3, minmax(0, 320px));
                gap:14px;
                justify-content:start;">
                            @{
                                int ri = 0;
                            }
                            @foreach (var f in Model.TopFinders)
                            {
                                var pct = (int)Math.Round((double)f.ConfirmedCount / topTotal * 100);
                                var isHero = f.ConfirmedCount >= 3;
                                var isAnon = !(f.IdUser.HasValue && f.IdUser.Value > 0);
                                var initials = f.FinderName.Length > 0
                                ? (f.FinderName.Contains(" ")
                                ? $"{f.FinderName[0]}{f.FinderName[f.FinderName.IndexOf(' ') + 1]}"
                                : f.FinderName[0].ToString())
                                : "?";
                                var cardId = $"fc_{ri}";

                                <div class="finder-card"
                                     style="border-color:@medalBorder[ri];background:linear-gradient(160deg,@medalBg[ri],#fff);">

                                    @* Rank badge *@
                                    <div class="finder-rank-badge">@medals[ri]</div>

                                    @* Avatar *@
                                    <div class="finder-av">@initials.ToUpper()</div>

                                    @* Hero badge *@
                                    @if (isHero)
                                    {
                                        <div class="hero-badge">⭐ Community Hero</div>
                                    }

                                    @* Name *@
                                    <div class="finder-name">@f.FinderName</div>
                                    <div class="finder-phone">
                                        📞 @f.FinderPhone
                                        @if (isAnon)
                                        {
                                            <span class="anon-badge">Guest</span>
                                        }
                                    </div>

                                    @* Stats *@
                                    <div class="finder-stats">
                                        <div class="finder-stat">
                                            <div class="finder-stat-val" style="color:@medalColor[ri];">
                                                @f.ConfirmedCount
                                            </div>
                                            <div class="finder-stat-lbl">Pets Found</div>
                                        </div>
                                        <div class="finder-stat">
                                            <div class="finder-stat-val" style="color:var(--success);">
                                                @f.TotalRewardEarned.ToString("F0")
                                            </div>
                                            <div class="finder-stat-lbl">JOD Earned</div>
                                        </div>
                                    </div>

                                    @* Progress bar — contribution among top 3 *@
                                    <div class="finder-progress-wrap">
                                        <div class="finder-progress-label">
                                            <span>Contribution (top 3)</span>
                                            <span style="color:@medalColor[ri];font-size:.76rem;">@pct%</span>
                                        </div>
                                        <div class="finder-progress-bg">
                                            <div class="finder-progress-fill"
                                                 style="width:@pct%;background:linear-gradient(90deg,@medalColor[ri],@medalBg[ri]);">
                                            </div>
                                        </div>
                                    </div>

                                    @* Action buttons *@
                                    <div style="display:flex;gap:8px;flex-wrap:wrap;">

                                        @* Contact toggle *@
                                        <button type="button"
                                                class="btn btn-outline btn-sm"
                                                style="flex:1;font-size:.78rem;"
                                                onclick="toggleContact('@cardId')">
                                            📞 Contact
                                        </button>

                                        @* Give Reward — فقط إذا مسجل (IdUser موجب) *@
                                        @if (!isAnon && f.IdUser.HasValue)
                                        {
                                            <a asp-controller="SuperAdmin"
                                               asp-action="GiveRewardModal"
                                               asp-route-userId="@f.IdUser.Value"
                                               class="btn btn-sm"
                                               style="flex:1;font-size:.78rem;justify-content:center;
                                                              background:var(--warning-soft);
                                                              border:1.5px solid rgba(226,163,58,.4);
                                                              color:#9b6000;">
                                                🎁 Reward
                                            </a>
                                        }
                                        else
                                        {
                                            @* Guest — لا يمكن إعطاء محفظة *@
                                            <span class="btn btn-sm"
                                                  style="flex:1;font-size:.72rem;cursor:default;
                                                                 background:#f5f5f5;border-color:#ddd;
                                                                 color:#aaa;justify-content:center;"
                                                  title="Guest finder — no account to reward">
                                                👤 Guest
                                            </span>
                                        }
                                    </div>

                                    @* Contact reveal panel *@
                                    <div id="@cardId" class="contact-reveal">
                                        <div style="font-size:.72rem;font-weight:900;color:var(--brand-dark);
                                                        margin-bottom:8px;text-transform:uppercase;letter-spacing:.05em;">
                                            📋 Contact Details
                                        </div>
                                        <div class="contact-line">
                                            <span>👤 Name</span>
                                            <span>@f.FinderName</span>
                                        </div>
                                        <div class="contact-line">
                                            <span>📞 Phone</span>
                                            <span>
                                                <a href="tel:@f.FinderPhone"
                                                   style="color:var(--brand);text-decoration:none;font-weight:900;">
                                                    @f.FinderPhone
                                                </a>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(f.FinderEmail))
                                        {
                                            <div class="contact-line">
                                                <span>📧 Email</span>
                                                <span>
                                                    <a href="mailto:@f.FinderEmail"
                                                       style="color:var(--brand);text-decoration:none;font-weight:900;font-size:.8rem;">
                                                        @f.FinderEmail
                                                    </a>
                                                </span>
                                            </div>
                                        }
                                        <div class="contact-line">
                                            <span>🔍 Confirmed this month</span>
                                            <span style="color:var(--success);">@f.ConfirmedCount pet@(f.ConfirmedCount != 1 ? "s" : "")</span>
                                        </div>
                                        @if (!isAnon)
                                        {
                                            <div style="margin-top:8px;">
                                                <a asp-controller="SuperAdmin"
                                                   asp-action="Details_U"
                                                   asp-route-id="@f.IdUser"
                                                   class="btn btn-outline btn-sm"
                                                   style="width:100%;justify-content:center;font-size:.78rem;">
                                                    👁 View Full Profile
                                                </a>
                                            </div>
                                        }
                                    </div>

                                </div>
                                ri++;
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-card" style="margin-bottom:24px;">
                        <div style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            🏆 No confirmed finders this month yet.
                        </div>
                    </div>
                }

                @* ── Status Filter ── *@
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
                    @foreach (var s in new[] { "All", "Pending", "Confirmed", "Rejected", "Cancelled" })
                    {
                        var isA = Model.StatusFilter == s;
                        <a asp-action="Found_Pets" asp-route-statusFilter="@s"
                           class="btn @(isA ? "btn-primary" : "btn-outline") btn-sm">
                            @s
                        </a>
                    }
                </div>

                @* ── Claims Table ── *@
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">All Found Claims</div>
                        <span class="table-count">@Model.Claims.Count() claims</span>
                    </div>

                    @if (!Model.Claims.Any())
                    {
                        <div style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">
                            No claims found for this filter.
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Pet</th>
                                        <th>Finder</th>
                                        <th>Owner</th>
                                        <th>City</th>
                                        <th>Verified</th>
                                        <th>Reward</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.Claims)
                                    {
                                        var detId = $"det_{c.IdClaim}";
                                        var stClass = c.Status == "Confirmed" ? "badge-success" :
                                        c.Status == "Pending" ? "badge-warning" :
                                        c.Status == "Cancelled" ? "badge-danger" : "badge-muted";
                                        <tr>
                                            <td>
                                                <div style="display:flex;align-items:center;gap:9px;">
                                                    <div style="width:34px;height:34px;border-radius:9px;
                                                                    background:var(--brand-xlight);
                                                                    display:grid;place-items:center;
                                                                    font-size:.9rem;
                                                                    border:1px solid var(--brand-light);">
                                                        @(c.AnimalType?.ToLower() == "cat" ? "🐈" :
                                                                                                        c.AnimalType?.ToLower() == "dog" ? "🐕" :
                                                                                                        c.AnimalType?.ToLower() == "bird" ? "🐦" : "🐾")
                                            </div>
                                            <div style="font-weight:800;font-size:.84rem;">@c.PetName</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-weight:800;font-size:.84rem;">@c.FinderName</div>
                                        <div class="cell-sub">📞 @c.FinderPhone</div>
                                    </td>
                                    <td>
                                        <div style="font-size:.82rem;color:var(--text-muted);">@c.OwnerName</div>
                                        <div class="cell-sub">📞 @c.OwnerPhone</div>
                                    </td>
                                    <td style="font-size:.8rem;">📍 @c.City</td>
                                    <td>
                                        @if (c.IsVerified)
                                                {
                                                    <span class="badge badge-success">✅ Verified</span>
                                                }
                                                else
                                                {

                                                    <span class="badge badge-warning">⚠️ Unverified</span>
                                                }
                                            </td>
                                            <td style="font-weight:800;color:var(--brand-dark);">
                                                @if (c.RewardAmount > 0)
                                                {
                                                    <span>@c.RewardAmount?.ToString("F2") JOD</span>
                                                }
                                                else
                                                {

                                                    <span style="color:var(--text-muted);">—</span>
                                                }
                                            </td>
                                            <td style="font-size:.78rem;color:var(--text-muted);">
                                                @c.CreatedAt?.ToString("MMM dd, yyyy")
                                            </td>
                                            <td><span class="badge @stClass">@c.Status</span></td>
                                            <td>

                                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                                    @if (c.Status == "Confirmed" && (c.RewardAmount == null || c.RewardAmount == 0))
                                                    {
                                                        if (rewardedIds.Contains(c.IdClaim))
                                                        {
                                                            @* ✅ أخذ مكافأة Surprise من الأدمن *@
                                                            <span style="display:inline-flex;align-items:center;gap:3px;
                                     background:#e8f5e9;border:1px solid rgba(46,125,50,.2);
                                     border-radius:8px;padding:3px 8px;
                                     font-size:.68rem;font-weight:900;color:#2d7a2d;
                                     white-space:nowrap;"
                                                                  title="Admin gave a surprise reward for this claim">
                                                                🎁 Rewarded
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            @* ⚠️ لم يأخذ مكافأة بعد *@
                                                            <span style="display:inline-flex;align-items:center;gap:3px;
                                     background:#fff3e0;border:1px solid rgba(230,81,0,.2);
                                     border-radius:8px;padding:3px 8px;
                                     font-size:.68rem;font-weight:900;color:#e65100;
                                     white-space:nowrap;"
                                                                  title="No reward given yet for this claim">
                                                                ⚠️ No Reward
                                                            </span>
                                                        }
                                                    }

                                                    <button type="button" class="btn btn-outline btn-xs"
                                                            onclick="toggleDetail('@detId')">
                                                        👁 Details
                                                    </button>
                                                    @if (c.Status == "Confirmed")
                                                    {
                                                        <details style="display:inline-block;position:relative;">
                                                            <summary class="btn btn-danger btn-xs"
                                                                     style="list-style:none;cursor:pointer;">
                                                                🚫 Cancel
                                                            </summary>
                                                            <div style="position:absolute;right:0;top:100%;z-index:50;
                                                                                background:#fff;border:1px solid var(--border);
                                                                                border-radius:12px;padding:12px;width:240px;
                                                                                box-shadow:0 8px 20px rgba(0,0,0,.12);">
                                                                <form method="post"
                                                                      asp-action="CancelReward"
                                                                      asp-controller="SuperAdmin">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="claimId" value="@c.IdClaim" />
                                                                    <input type="text" name="reason"
                                                                           placeholder="Reason..."
                                                                           required
                                                                           style="width:100%;border:1.5px solid var(--border);
                                                                                          border-radius:8px;padding:6px 10px;
                                                                                          font-size:.8rem;font-weight:700;
                                                                                          font-family:'Nunito',sans-serif;
                                                                                          outline:none;margin-bottom:8px;" />
                                                                    <button type="submit"
                                                                            class="btn btn-danger btn-sm"
                                                                            style="width:100%;"
                                                                            onclick="return confirm('Cancel this reward?')">
                                                                        Confirm Cancel
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </details>
                                                    }
                                                </div>
                                            </td>
                                        </tr>

                                        @* Detail expand row *@
                                        <tr id="@detId" class="detail-panel-row">
                                            <td colspan="9">
                                                <div class="detail-inner">
                                                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;
                                                                    gap:12px;font-size:.82rem;">
                                                        <div>
                                                            <div style="font-size:.72rem;color:var(--text-muted);
                                                                            font-weight:700;margin-bottom:3px;">
                                                                📅 Submitted
                                                            </div>
                                                            <div style="font-weight:900;">
                                                                @c.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div style="font-size:.72rem;color:var(--text-muted);
                                                                            font-weight:700;margin-bottom:3px;">
                                                                📧 Finder Email
                                                            </div>
                                                            <div style="font-weight:900;">
                                                                @(string.IsNullOrEmpty(c.FinderEmail) ? "—" : c.FinderEmail)
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div style="font-size:.72rem;color:var(--text-muted);
                                                                            font-weight:700;margin-bottom:3px;">
                                                                💰 Reward Status
                                                            </div>
                                                            <div style="font-weight:900;">
                                                                @(c.RewardStatus ?? "—")
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div style="margin-top:10px;
                                                                    background:@(c.IsVerified ? "var(--success-soft)" : "var(--warning-soft)");
                                                                    border-radius:10px;padding:10px 12px;
                                                                    font-size:.82rem;font-weight:800;
                                                                    color:@(c.IsVerified ? "#2e7d32" : "#9b6000");">
                                                        @if (c.IsVerified)
                                                        {
                                                            <span>✅ Finder answered the secret question correctly.</span>
                                                        }
                                                        else
                                                        {

                                                            <span>⚠️ Wrong secret answer — owner confirmed manually.</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </main>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        function toggleDetail(id) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }
        function toggleContact(id) {
            // أغلق باقي الـ panels أولاً
            document.querySelectorAll('.contact-reveal.open').forEach(el => {
                if (el.id !== id) el.classList.remove('open');
            });
            const el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }
    </script>
</body>
</html>

