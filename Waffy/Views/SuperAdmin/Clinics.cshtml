@model Waffy.Models.ViewModels.ClinicManagementViewModel
@{
    ViewData["Title"] = "Waffy — Super Admin | Clinic Management";
    Layout = null;
    var adminName     = ViewBag.AdminName     as string ?? "Admin";
    var adminInitials = ViewBag.AdminInitials as string ?? "AD";
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- SIDEBAR -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            @if (Model.PendingClinics > 0) { <span class="sb-bdg bd-y">@Model.PendingClinics</span> }
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-clinics" style="height:auto;"><div class="sb-sub-inner">
                            <a class="sb-child active" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span>
                                @if (Model.PendingClinics > 0) { <span class="sb-bdg bd-y sb-child-bdg">@Model.PendingClinics</span> }
                            </a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        <a class="sb-child" asp-controller="SuperAdmin" asp-action="Doctors_C">
    <span class="sb-dot"></span>
    <span class="sb-child-lbl">Doctors</span>
</a>
                            </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                            <span class="sb-lbl">Shop</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-shop"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
                            <span class="sb-lbl">Adoption</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                            <span class="sb-lbl">Reports</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-rep"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="System_Complaints"><span class="sb-dot"></span><span class="sb-child-lbl">System Complaints</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                        </div></div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span><span class="sb-lbl">Notifications</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="RewardLog">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/></svg></span>
                        <span class="sb-lbl">Reward Log</span>
                    </a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row">
                    <div class="sb-av">@adminInitials</div>
                    <div class="sb-user-info">
                        <div class="sb-user-name">@adminName</div>
                        <div class="sb-user-role">Super Admin</div>
                    </div>
                </div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span class="sb-logout-lbl">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- TOPNAV -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button">
                <svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <nav class="tn-bread"><span>Management</span><span>/</span><b>Clinics</b></nav>
            <div class="tn-center"><div class="tn-center-main">Clinic Management</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications">
                    <svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </a>
                <div class="tn-sep"></div>
                <div class="tn-profile">
                    <div class="tn-av">@adminInitials</div>
                    <div><div class="tn-pname">@adminName</div><div class="tn-prole">Super Admin</div></div>
                </div>
            </div>
        </header>

        <!-- MAIN -->
        <main class="wa-main" id="waMain">

            @* Flash Messages *@
            @if (TempData["ClinicSuccess"] != null)
            {
                <div id="flashMsg" style="position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:var(--success-soft);border:1px solid rgba(76,175,80,.3);color:var(--success);font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;">
                    @TempData["ClinicSuccess"]
                </div>
            }
            @if (TempData["ClinicError"] != null)
            {
                <div id="flashMsg" style="position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:var(--danger-soft);border:1px solid rgba(244,67,54,.3);color:var(--danger);font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;">
                    @TempData["ClinicError"]
                </div>
            }

            <section class="page-hero">
                <div>
                    <h1>Clinic Management</h1>
                    <p>Approve, suspend, or reject clinics. Click any row to view details and documents.</p>
                </div>
                <div class="page-hero-actions">
                    <button class="btn btn-outline btn-sm" onclick="exportClinics()">📥 Export</button>
                </div>
            </section>

            <div class="page-body">
                <!-- KPIs -->
                <div class="kpi-grid kpi-grid-4">
                    <div class="kpi-card c1"><div class="kpi-ico green">🏥</div><div class="kpi-val" id="kpiTotal">@Model.TotalClinics</div><div class="kpi-label">Total Clinics</div><div class="kpi-chip chip-green">+@Model.NewThisMonth this month</div></div>
                    <div class="kpi-card c2"><div class="kpi-ico blue">✅</div><div class="kpi-val" id="kpiActive">@Model.ActiveClinics</div><div class="kpi-label">Active</div><div class="kpi-chip chip-blue">@(Model.TotalClinics > 0 ? (Model.ActiveClinics * 100 / Model.TotalClinics) : 0)% rate</div></div>
                    <div class="kpi-card c3"><div class="kpi-ico yellow">⏳</div><div class="kpi-val" id="kpiPending">@Model.PendingClinics</div><div class="kpi-label">Pending Approval</div><div class="kpi-chip chip-yellow">@(Model.PendingClinics > 0 ? "Needs review" : "All clear ✓")</div></div>
                    <div class="kpi-card c4"><div class="kpi-ico red">🔒</div><div class="kpi-val" id="kpiSuspended">@Model.SuspendedClinics</div><div class="kpi-label">Suspended</div><div class="kpi-chip chip-red">Restricted access</div></div>
                </div>

                <!-- Filters -->
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
                    <div class="search-wrap" style="flex:1 1 260px;">
                        <span style="color:var(--text-muted)">🔍</span>
                        <input type="text" id="searchInput" placeholder="Search by clinic name, city, owner..." oninput="renderTable()" />
                    </div>
                    <select class="sel-wrap" style="width:auto;min-width:150px;" id="statusFilter" onchange="renderTable()">
                        <option value="">All Statuses</option>
                        <option value="active"    @@Html.Raw(Model.StatusFilter == "Approved"  ? "selected" : "")>Active</option>
                        <option value="pending"   @@Html.Raw(Model.StatusFilter == "Pending"   ? "selected" : "")>Pending</option>
                        <option value="suspended" @@Html.Raw(Model.StatusFilter == "Suspended" ? "selected" : "")>Suspended</option>
                        <option value="rejected">Rejected</option>
                    </select>
                    <select class="sel-wrap" style="width:auto;min-width:150px;" id="cityFilter" onchange="renderTable()">
                        <option value="">All Cities</option>
                        @foreach (var city in Model.Clinics.Select(c => c.City).Distinct().OrderBy(x => x))
                        {
                            <option>@city</option>
                        }
                    </select>
                    <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                </div>

                <!-- Chips -->
                <div class="chips-row" id="chipsRow">
                    <button class="filter-chip active" data-f="" onclick="setChip(this)">All <span id="chipAll"></span></button>
                    <button class="filter-chip" data-f="pending" onclick="setChip(this)">⏳ Pending <span id="chipPending"></span></button>
                    <button class="filter-chip" data-f="active" onclick="setChip(this)">✅ Active <span id="chipActive"></span></button>
                    <button class="filter-chip" data-f="suspended" onclick="setChip(this)">🔒 Suspended <span id="chipSuspended"></span></button>
                    <button class="filter-chip" data-f="rejected" onclick="setChip(this)">❌ Rejected <span id="chipRejected"></span></button>
                </div>

                <!-- Table -->
                <div class="table-card">
                    <div class="table-head-bar">
                        <div class="table-head-title">All Clinics</div>
                        <div style="display:flex;gap:8px;align-items:center;">
                            <span class="table-count" id="tableCount"></span>
                            <select class="sel-wrap" style="height:36px;font-size:.78rem;width:auto;min-width:160px;" onchange="sortClinics(this.value)">
                                <option value="newest">Newest First</option>
                                <option value="name">Name A–Z</option>
                                <option value="status">By Status</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Clinic</th>
                                    <th>Owner</th>
                                    <th>City</th>
                                    <th>Documents</th>
                                    <th>Status</th>
                                    <th>Registered</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="clinicsTBody"></tbody>
                        </table>
                    </div>
                    <div class="pagination-bar">
                        <div class="pag-info" id="pagInfo"></div>
                        <div class="pag-pages" id="pagPages"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- DETAIL PANEL -->
    <div class="detail-overlay" id="clinicDetailPanel">
        <div class="detail-panel" style="max-width:860px;">
            <div class="dp-header">
                <div class="dp-title" id="dpTitle">🏥 Clinic Details</div>
                <div style="display:flex;gap:8px;align-items:center;">
                    <a class="btn btn-outline btn-sm" id="dpViewFullBtn" href="#">📋 Full Review →</a>
                    <button class="dp-close" onclick="closeM('clinicDetailPanel')">✕</button>
                </div>
            </div>
            <div class="dp-body">
                <!-- Profile -->
                <div class="dp-profile" id="dpProfile">
                    <div class="dp-avatar" id="dpAvatar">🏥</div>
                    <div style="flex:1;">
                        <div class="dp-name" id="dpName"></div>
                        <div class="dp-meta" id="dpMeta"></div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;" id="dpBadges"></div>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;flex-shrink:0;" id="dpActions"></div>
                </div>

                <!-- Info Grid -->
                <div class="dp-section">
                    <div class="dp-section-title">Clinic Information</div>
                    <div class="dp-grid">
                        <div class="dp-info-item"><div class="dp-info-label">Owner</div><div class="dp-info-val" id="dpOwner"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Email</div><div class="dp-info-val" id="dpEmail"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Phone</div><div class="dp-info-val" id="dpPhone"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">City</div><div class="dp-info-val" id="dpCity"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Registered</div><div class="dp-info-val" id="dpJoined"></div></div>
                        <div class="dp-info-item"><div class="dp-info-label">Pending Docs</div><div class="dp-info-val" id="dpPendingDocs"></div></div>
                    </div>
                </div>

                <!-- Documents Status -->
                <div class="dp-section">
                    <div class="dp-section-title">Documents Status</div>
                    <div id="dpDocs" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;"></div>
                    <div style="margin-top:12px;font-size:.8rem;color:var(--text-muted);font-weight:700;">
                        💡 Click <strong>"Full Review"</strong> above to review and approve individual documents.
                    </div>
                </div>
            </div>
            <div class="dp-footer">
                <div id="dpFooterActions"></div>
                <button class="btn btn-outline btn-sm" onclick="closeM('clinicDetailPanel')">Close</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Approve Confirmation -->
    <div class="modal-overlay" id="approveModal">
        <div class="modal-box" style="max-width:480px;">
            <div class="modal-head"><div class="modal-title">✅ Approve Clinic</div><button class="dp-close" onclick="closeM('approveModal')">✕</button></div>
            <div class="modal-body">
                <div style="background:#f0f7e2;border:1px solid rgba(139,169,74,.25);border-radius:14px;padding:16px;margin-bottom:14px;">
                    <div style="font-weight:900;color:var(--brand-dark);" id="approveClinicName"></div>
                    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;" id="approveClinicMeta"></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:14px;" id="approveDocGrid"></div>
                <div style="background:#fff9f0;border:1px solid #f0d9a0;border-radius:10px;padding:12px;font-size:.82rem;font-weight:700;color:#9b6000;">
                    ⚠️ Approving will activate the clinic and allow the owner to log in.
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('approveModal')">Cancel</button>
                <form method="post" asp-controller="SuperAdmin" asp-action="ApproveClinic" style="display:inline;" id="approveForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clinicId" id="approveClinicId" />
                    <input type="hidden" name="from" value="list" />
                    <button type="submit" class="btn btn-primary">✅ Confirm Approval</button>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Warn -->
    <div class="modal-overlay" id="warnModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">⚠️ Send Warning</div><button class="dp-close" onclick="closeM('warnModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target Clinic</label><input type="text" id="warnTarget" readonly style="background:#f5f0e8;"/></div>
                <div class="field">
                    <label>Warning Type</label>
                    <select id="warnTypeSelect"><option>Policy violation</option><option>High no-show rate</option><option>Multiple complaints</option><option>Document issue</option><option>Terms of service violation</option></select>
                </div>
                <div class="field"><label>Message</label><textarea id="warnMessage" rows="4" placeholder="Write the official warning..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('warnModal')">Cancel</button>
                <button class="btn btn-primary" onclick="submitWarn()">⚠️ Send Warning</button>
            </div>
        </div>
    </div>

    <!-- MODAL: Suspend -->
    <div class="modal-overlay" id="suspendModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">🔒 Suspend Clinic</div><button class="dp-close" onclick="closeM('suspendModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target Clinic</label><input type="text" id="suspendTarget" readonly style="background:#f5f0e8;"/></div>
                <div class="field">
                    <label>Reason</label>
                    <select id="suspendReason"><option value="Policy violation">Policy violation</option><option value="Multiple complaints">Multiple complaints</option><option value="High no-show rate">High no-show rate</option><option value="Invalid documents">Invalid documents</option><option value="Suspicious activity">Suspicious activity</option></select>
                </div>
                <div class="field">
                    <label>Duration</label>
                    <select id="suspendDuration"><option value="7 days">7 days</option><option value="14 days">14 days</option><option value="30 days">30 days</option><option value="indefinite">Indefinite</option></select>
                </div>
                <div class="field"><label>Message to Clinic Owner</label><textarea id="suspendMessage" rows="3" placeholder="Explain the reason..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('suspendModal')">Cancel</button>
                <form method="post" asp-controller="SuperAdmin" asp-action="SuspendClinic" id="suspendForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clinicId"  id="suspendClinicId" />
                    <input type="hidden" name="from"      value="list" />
                    <input type="hidden" name="reason"    id="suspendReasonHidden" />
                    <input type="hidden" name="duration"  id="suspendDurationHidden" />
                    <input type="hidden" name="message"   id="suspendMessageHidden" />
                    <button type="submit" class="btn btn-danger">🔒 Suspend Clinic</button>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Reject -->
    <div class="modal-overlay" id="rejectModal">
        <div class="modal-box" style="max-width:500px;">
            <div class="modal-head"><div class="modal-title">❌ Reject Application</div><button class="dp-close" onclick="closeM('rejectModal')">✕</button></div>
            <div class="modal-body">
                <div class="field"><label>Target Clinic</label><input type="text" id="rejectTarget" readonly style="background:#f5f0e8;"/></div>
                <div class="field">
                    <label>Reason</label>
                    <select id="rejectReasonSelect">
                        <option value="Incomplete documents">Incomplete or unreadable documents</option>
                        <option value="Expired license">Expired license</option>
                        <option value="Invalid information">Invalid clinic information</option>
                        <option value="Duplicate application">Duplicate application</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="field"><label>Message to Applicant <span style="opacity:.6;">(optional)</span></label><textarea id="rejectMessage" rows="3" placeholder="Explain what needs to be corrected..."></textarea></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeM('rejectModal')">Cancel</button>
                <form method="post" asp-controller="SuperAdmin" asp-action="RejectClinic" id="rejectForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clinicId" id="rejectClinicId" />
                    <input type="hidden" name="from"     value="list" />
                    <input type="hidden" name="reason"   id="rejectReasonHidden" />
                    <input type="hidden" name="message"  id="rejectMessageHidden" />
                    <button type="submit" class="btn btn-danger">❌ Confirm Rejection</button>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: Delete -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-box" style="max-width:420px;">
            <div class="modal-head"><div class="modal-title">🗑 Delete Clinic</div><button class="dp-close" onclick="closeM('deleteModal')">✕</button></div>
            <div class="modal-body" style="text-align:center;padding:24px 20px;">
                <div style="font-size:2.5rem;margin-bottom:12px;">⚠️</div>
                <div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:var(--brand-dark);margin-bottom:8px;">Are you sure?</div>
                <div style="font-size:.86rem;color:var(--text-muted);font-weight:700;">
                    Permanently delete <strong id="deleteClinicName" style="color:var(--danger);"></strong>. This cannot be undone.
                </div>
            </div>
            <div class="modal-footer" style="justify-content:center;">
                <button class="btn btn-outline" onclick="closeM('deleteModal')">Cancel</button>
                <form method="post" asp-controller="SuperAdmin" asp-action="DeleteClinic" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clinicId" id="deleteClinicId" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                </form>
            </div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        /* ═══════════════════════════════════════════════════════
           SERVER DATA  — injected from the ViewModel
        ═══════════════════════════════════════════════════════ */
        const clinics = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Clinics.Select(c => new {
                id           = c.IdClinic,
                name         = c.Name,
                owner        = c.OwnerName,
                email        = c.OwnerEmail,
                phone        = c.OwnerPhone,
                city         = c.City,
                logoUrl      = c.LogoUrl ?? "",
                status       = c.VerificationStatus.ToLower(),   // active/pending/suspended/rejected
                joined       = c.CreatedAt.ToString("yyyy-MM-dd"),
                docsTotal    = c.DocumentsCount,
                docsPending  = c.PendingDocsCount
            })
        ));

        /* URLs */
        const detailsBaseUrl  = '@Url.Action("Details_C",    "SuperAdmin")';
        const reactivateUrl   = '@Url.Action("ReactivateClinic","SuperAdmin")';
        const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        let currentClinicId = null;
        let currentSort     = 'newest';
        let currentChip     = '';
        let currentPage     = 1;
        const PAGE_SIZE     = 8;

        /* ═══ HELPERS ═══ */
        function statusBadge(s) {
            const m = {
                active:    ['badge-success', '✅ Active'],
                pending:   ['badge-warning', '⏳ Pending'],
                suspended: ['badge-danger',  '🔒 Suspended'],
                rejected:  ['badge-muted',   '❌ Rejected']
            };
            const [cls, lbl] = m[s] || ['badge-muted', s];
            return `<span class="badge ${cls}">${lbl}</span>`;
        }

        function docPill(total, pending) {
            if (total === 0)   return `<span style="font-size:.76rem;font-weight:800;color:var(--text-muted);">— no docs</span>`;
            if (pending > 0)   return `<span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:20px;background:#FFF3CD;color:#856404;font-size:.72rem;font-weight:800;">⏳ ${pending} pending</span>`;
            return `<span style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:20px;background:var(--success-soft);color:var(--success);font-size:.72rem;font-weight:800;">✅ ${total} reviewed</span>`;
        }

        function getFiltered() {
            const q  = (document.getElementById('searchInput')?.value || '').toLowerCase();
            const sf = document.getElementById('statusFilter')?.value || '';
            const cf = document.getElementById('cityFilter')?.value || '';
            return clinics.filter(c => {
                const mQ = !q || [c.name, c.owner, c.email, c.city].some(v => v.toLowerCase().includes(q));
                const mS = (!sf && !currentChip) ? true : (currentChip ? c.status === currentChip : c.status === sf);
                const mC = !cf || c.city === cf;
                return mQ && mS && mC;
            }).sort((a, b) => {
                if (currentSort === 'name')   return a.name.localeCompare(b.name);
                if (currentSort === 'status') return a.status.localeCompare(b.status);
                return new Date(b.joined) - new Date(a.joined);
            });
        }

        /* ═══ RENDER TABLE ═══ */
        function renderTable() {
            const data  = getFiltered();
            const total = data.length;
            const pages = Math.ceil(total / PAGE_SIZE);
            if (currentPage > pages) currentPage = 1;
            const slice = data.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
            const tbody = document.getElementById('clinicsTBody');

            tbody.innerHTML = slice.length ? slice.map(c => {
                const logoHtml = c.logoUrl
                    ? `<img src="${c.logoUrl}" style="width:40px;height:40px;border-radius:12px;object-fit:cover;border:1px solid var(--border);flex-shrink:0;" />`
                    : `<div style="width:40px;height:40px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);display:grid;place-items:center;font-size:1.2rem;flex-shrink:0;">🏥</div>`;

                const actionBtns = (() => {
                    const view = `<a href="${detailsBaseUrl}?id=${c.id}" class="btn btn-outline btn-xs">👁 Review</a>`;
                    if (c.status === 'pending')   return view + `<button class="btn btn-primary btn-xs" onclick="openApproveModal(${c.id})">✅ Approve</button><button class="btn btn-danger btn-xs" onclick="openRejectModal(${c.id})">❌ Reject</button>`;
                    if (c.status === 'active')    return view + `<button class="btn btn-danger btn-xs" onclick="openSuspendModal(${c.id})">🔒 Suspend</button>`;
                    if (c.status === 'suspended') return view + `<button class="btn btn-primary btn-xs" onclick="submitReactivate(${c.id})">✅ Reactivate</button>`;
                    return view;
                })();

                return `
                <tr style="cursor:pointer;" onclick="openDetail(${c.id})">
                    <td>
                        <div style="display:flex;align-items:center;gap:10px;">
                            ${logoHtml}
                            <div>
                                <div class="cell-title">${c.name}</div>
                                <div class="cell-sub">ID #${c.id}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="cell-title">${c.owner}</div>
                        <div class="cell-sub">${c.email}</div>
                    </td>
                    <td style="color:var(--text-muted);font-weight:700;">📍 ${c.city}</td>
                    <td>${docPill(c.docsTotal, c.docsPending)}</td>
                    <td>${statusBadge(c.status)}</td>
                    <td style="font-size:.78rem;color:var(--text-muted);font-weight:700;">${c.joined}</td>
                    <td onclick="event.stopPropagation()">
                        <div style="display:flex;gap:5px;flex-wrap:wrap;">${actionBtns}</div>
                    </td>
                </tr>`;
            }).join('')
            : `<tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted);font-weight:700;">No clinics found.</td></tr>`;

            /* pagination */
            document.getElementById('pagInfo').textContent = total === 0 ? 'No clinics found'
                : `Showing ${(currentPage - 1) * PAGE_SIZE + 1}–${Math.min(currentPage * PAGE_SIZE, total)} of ${total} clinics`;

            const pagEl = document.getElementById('pagPages');
            pagEl.innerHTML = '';
            if (pages > 1) {
                const addBtn = (label, page, active = false, disabled = false) => {
                    const b = document.createElement('button');
                    b.className = 'pag-btn' + (active ? ' active' : '');
                    b.textContent = label;
                    b.disabled = disabled;
                    b.onclick = () => { currentPage = page; renderTable(); };
                    pagEl.appendChild(b);
                };
                addBtn('‹', currentPage - 1, false, currentPage === 1);
                for (let i = 1; i <= pages; i++) {
                    if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - currentPage) > 1) {
                        if (i === 3 || i === pages - 2) {
                            const s = document.createElement('button');
                            s.className = 'pag-btn'; s.textContent = '…'; s.disabled = true;
                            pagEl.appendChild(s);
                        }
                        continue;
                    }
                    addBtn(i, i, i === currentPage);
                }
                addBtn('›', currentPage + 1, false, currentPage === pages);
            }

            /* chips counts */
            const cnt = s => clinics.filter(x => x.status === s).length;
            document.getElementById('chipAll').textContent      = `(${clinics.length})`;
            document.getElementById('chipPending').textContent  = `(${cnt('pending')})`;
            document.getElementById('chipActive').textContent   = `(${cnt('active')})`;
            document.getElementById('chipSuspended').textContent= `(${cnt('suspended')})`;
            document.getElementById('chipRejected').textContent = `(${cnt('rejected')})`;
            document.getElementById('tableCount').textContent   = total + ' clinics';
        }

        /* ═══ DETAIL PANEL ═══ */
        function openDetail(id) {
            const c = clinics.find(x => x.id === id);
            if (!c) return;
            currentClinicId = id;

            document.getElementById('dpTitle').textContent  = `🏥 ${c.name}`;
            document.getElementById('dpName').textContent   = c.name;
            document.getElementById('dpMeta').textContent   = `${c.city} · ${c.owner}`;
            document.getElementById('dpBadges').innerHTML   = statusBadge(c.status) + `<span class="badge badge-muted">📍 ${c.city}</span>`;
            document.getElementById('dpOwner').textContent  = c.owner;
            document.getElementById('dpEmail').textContent  = c.email;
            document.getElementById('dpPhone').textContent  = c.phone || '—';
            document.getElementById('dpCity').textContent   = c.city;
            document.getElementById('dpJoined').textContent = c.joined;
            document.getElementById('dpPendingDocs').innerHTML = docPill(c.docsTotal, c.docsPending);
            document.getElementById('dpViewFullBtn').href   = detailsBaseUrl + '?id=' + c.id;

            /* avatar */
            const avatarEl = document.getElementById('dpAvatar');
            if (c.logoUrl) {
                avatarEl.innerHTML = `<img src="${c.logoUrl}" style="width:100%;height:100%;object-fit:cover;border-radius:18px;" />`;
            } else {
                avatarEl.textContent = '🏥';
            }

            /* doc status boxes */
            const docLabels = {
                MunicipalLicense:  '🏛 Municipal License',
                VeterinaryLicense: '⚕️ Practice License',
                NationalId:        '🪪 Manager ID',
                Logo:              '🎨 Logo'
            };
            // We only show summary here — full review is on Details_C page
            const docsHtml = c.docsTotal > 0
                ? `<div style="background:${c.docsPending>0?'#FFF3CD':'var(--success-soft)'};border:1px solid ${c.docsPending>0?'rgba(133,100,4,.2)':'rgba(47,158,95,.2)'};border-radius:12px;padding:14px;grid-column:1/-1;">
                       <div style="font-size:.8rem;font-weight:900;color:var(--brand-dark);">Total documents: ${c.docsTotal}</div>
                       <div style="font-size:.78rem;font-weight:700;margin-top:5px;color:${c.docsPending>0?'#856404':'var(--success)'};">
                           ${c.docsPending>0 ? `⏳ ${c.docsPending} pending review` : '✅ All documents reviewed'}
                       </div>
                   </div>`
                : `<div style="color:var(--text-muted);font-size:.82rem;font-weight:700;grid-column:1/-1;">No documents uploaded yet.</div>`;
            document.getElementById('dpDocs').innerHTML = docsHtml;

            /* action buttons */
            let actHtml = '';
            if (c.status === 'pending') {
                actHtml = `<button class="btn btn-primary btn-sm" onclick="openApproveModal(${c.id})">✅ Approve</button>
                           <button class="btn btn-danger btn-sm"  onclick="openRejectModal(${c.id})">❌ Reject</button>
                           <a href="${detailsBaseUrl}?id=${c.id}" class="btn btn-outline btn-sm">📋 Review Docs</a>`;
            } else if (c.status === 'active') {
                actHtml = `<button class="btn btn-danger btn-sm" onclick="openSuspendModal(${c.id})">🔒 Suspend</button>
                           <button class="btn btn-outline btn-sm" onclick="openWarnModal(${c.id})">⚠️ Warn</button>`;
            } else if (c.status === 'suspended') {
                actHtml = `<button class="btn btn-primary btn-sm" onclick="submitReactivate(${c.id})">✅ Reactivate</button>`;
            }
            document.getElementById('dpActions').innerHTML = actHtml;

            /* footer */
            document.getElementById('dpFooterActions').innerHTML =
                `<button class="btn btn-danger btn-sm" onclick="openDeleteModal(${c.id})">🗑 Delete</button>`;

            openM('clinicDetailPanel');
        }

        /* ═══ ACTION FUNCTIONS ═══ */

        // ── Approve ──────────────────────────────────────────────
        function openApproveModal(id) {
            const c = clinics.find(x => x.id === id); if (!c) return;
            currentClinicId = id;
            document.getElementById('approveClinicId').value   = id;
            document.getElementById('approveClinicName').textContent = c.name;
            document.getElementById('approveClinicMeta').textContent = `Owner: ${c.owner} · ${c.city}`;
            document.getElementById('approveDocGrid').innerHTML =
                c.docsPending > 0
                    ? `<div style="grid-column:1/-1;background:#fff9f0;border:1px solid #f0d9a0;border-radius:10px;padding:12px;font-size:.82rem;font-weight:800;color:#9b6000;">
                           ⚠️ ${c.docsPending} document(s) still pending review. Consider reviewing them first on the full page.
                       </div>`
                    : `<div style="grid-column:1/-1;background:var(--success-soft);border:1px solid rgba(47,158,95,.2);border-radius:10px;padding:12px;font-size:.82rem;font-weight:800;color:var(--success);">
                           ✅ All ${c.docsTotal} documents have been reviewed.
                       </div>`;
            openM('approveModal');
        }

        // ── Reject ───────────────────────────────────────────────
        function openRejectModal(id) {
            const c = clinics.find(x => x.id === id); if (!c) return;
            currentClinicId = id;
            document.getElementById('rejectClinicId').value = id;
            document.getElementById('rejectTarget').value   = c.name;
            openM('rejectModal');
        }
        // Copy selects to hidden inputs before submit
        document.getElementById('rejectForm').addEventListener('submit', () => {
            document.getElementById('rejectReasonHidden').value  = document.getElementById('rejectReasonSelect').value;
            document.getElementById('rejectMessageHidden').value = document.getElementById('rejectMessage').value;
        });

        // ── Suspend ──────────────────────────────────────────────
        function openSuspendModal(id) {
            const c = clinics.find(x => x.id === id); if (!c) return;
            currentClinicId = id;
            document.getElementById('suspendClinicId').value = id;
            document.getElementById('suspendTarget').value   = c.name;
            openM('suspendModal');
        }
        document.getElementById('suspendForm').addEventListener('submit', () => {
            document.getElementById('suspendReasonHidden').value   = document.getElementById('suspendReason').value;
            document.getElementById('suspendDurationHidden').value = document.getElementById('suspendDuration').value;
            document.getElementById('suspendMessageHidden').value  = document.getElementById('suspendMessage').value;
        });

        // ── Reactivate (direct POST via fetch) ───────────────────
        function submitReactivate(id) {
            if (!confirm('Reactivate this clinic?')) return;
            const form = new FormData();
            form.append('clinicId', id);
            form.append('from', 'list');
            form.append('__RequestVerificationToken', antiForgeryToken);
            fetch(reactivateUrl, { method:'POST', body: form })
                .then(() => location.reload());
        }

        // ── Warn ─────────────────────────────────────────────────
        function openWarnModal(id) {
            const c = clinics.find(x => x.id === id); if (!c) return;
            currentClinicId = id;
            document.getElementById('warnTarget').value = c.name;
            openM('warnModal');
        }
        function submitWarn() {
            const warnType    = document.getElementById('warnTypeSelect').value;
            const warnMessage = document.getElementById('warnMessage').value;
            if (!warnMessage.trim()) { toast('Please write a warning message.', 'danger'); return; }
            const form = new FormData();
            form.append('clinicId',    currentClinicId);
            form.append('warnType',    warnType);
            form.append('warnMessage', warnMessage);
            form.append('__RequestVerificationToken', antiForgeryToken);
            fetch('@Url.Action("WarnClinic", "SuperAdmin")', { method:'POST', body: form })
                .then(r => r.json())
                .then(data => {
                    closeM('warnModal');
                    toast(data.success ? '⚠️ Warning sent successfully.' : '❌ Failed to send.', data.success ? 'success' : 'danger');
                });
        }

        // ── Delete ───────────────────────────────────────────────
        function openDeleteModal(id) {
            const c = clinics.find(x => x.id === id); if (!c) return;
            currentClinicId = id;
            document.getElementById('deleteClinicId').value    = id;
            document.getElementById('deleteClinicName').textContent = c.name;
            openM('deleteModal');
        }

        /* ═══ FILTER / SORT ═══ */
        function setChip(btn) {
            document.querySelectorAll('#chipsRow .filter-chip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');
            currentChip = btn.dataset.f;
            document.getElementById('statusFilter').value = '';
            currentPage = 1;
            renderTable();
        }
        function sortClinics(v) { currentSort = v; currentPage = 1; renderTable(); }
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('cityFilter').value = '';
            currentChip = ''; currentPage = 1;
            document.querySelectorAll('#chipsRow .filter-chip').forEach((c, i) => c.classList.toggle('active', i === 0));
            renderTable();
        }
        function exportClinics() { toast('Exporting ' + getFiltered().length + ' clinics...', 'success'); }

        /* ═══ MODAL HELPERS ═══ */
        function openM(id)  { const m = document.getElementById(id); if(m) m.classList.add('open'); }
        function closeM(id) { const m = document.getElementById(id); if(m) m.classList.remove('open'); }
        document.querySelectorAll('.modal-overlay, .detail-overlay').forEach(m => {
            m.addEventListener('click', e => { if(e.target === m) m.classList.remove('open'); });
        });

        /* ═══ TOAST ═══ */
        function toast(msg, type = 'success') {
            const bg  = { success:'var(--success-soft)', danger:'var(--danger-soft)', warning:'#fff9f0' };
            const col = { success:'var(--success)', danger:'var(--danger)', warning:'#9b6000' };
            const t   = document.createElement('div');
            t.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:${bg[type]};border:1px solid ${col[type]}40;color:${col[type]};font-weight:800;font-size:.86rem;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);animation:fadeUp .25s ease;max-width:320px;`;
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 3200);
        }
        const ts = document.createElement('style');
        ts.textContent = `@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}`;
        document.head.appendChild(ts);

        /* flash auto-hide */
        const fm = document.getElementById('flashMsg');
        if (fm) { setTimeout(() => fm.style.opacity = '0', 3500); setTimeout(() => fm.remove(), 3900); }

        /* ═══ INIT ═══ */
        renderTable();
    </script>
</body>
</html>
