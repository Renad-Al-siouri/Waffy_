@using Waffy.Models
@{
    Layout = null;
    var complaints         = ViewBag.Complaints         as List<Complaint> ?? new List<Complaint>();
    var openComplaints     = (int)(ViewBag.OpenComplaints     ?? 0);
    var resolvedComplaints = (int)(ViewBag.ResolvedComplaints ?? 0);
    var investigatingCount = (int)(ViewBag.InvestigatingCount ?? 0);
    var totalComplaints    = (int)(ViewBag.TotalComplaints    ?? 0);
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy — Super Admin | System Complaints</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/waffy-Super-Admin.css" asp-append-version="true" />
</head>
<body>
    <div class="wa-overlay" id="waOvl" onclick="closeMob()"></div>
    <div class="wa-shell" id="waShell">

        <!-- ══ SIDEBAR ══ -->
        <aside class="wa-sb" id="waSb">
            <div class="sb-logo">
                <div class="sb-mark"><img src="~/Images/logoW.png" alt="Waffy" class="sb-logo-img"></div>
                <div class="sb-wordmark"><div class="sb-wm-name">Waffy</div><div class="sb-wm-tag">Super Admin</div></div>
            </div>
            <nav class="sb-nav">
                <div class="sb-group sb-group-flat">
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Dashboard">
                        <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
                        <span class="sb-lbl">Dashboard</span>
                    </a>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Management</div>
                    <div>
                        <button class="sb-row" id="t-users" onclick="acc('g-users','t-users')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
                            <span class="sb-lbl">Users</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-users"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Users"><span class="sb-dot"></span><span class="sb-child-lbl">All Users</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-clinics" onclick="acc('g-clinics','t-clinics')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
                            <span class="sb-lbl">Clinics</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-clinics"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Clinics"><span class="sb-dot"></span><span class="sb-child-lbl">All Clinics</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_C"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_C"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-shop" onclick="acc('g-shop','t-shop')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                            <span class="sb-lbl">Shop</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-shop"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Stores"><span class="sb-dot"></span><span class="sb-child-lbl">Stores</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Reviews_Complaints_S"><span class="sb-dot"></span><span class="sb-child-lbl">Reviews &amp; Complaints</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_S"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row" id="t-adopt" onclick="acc('g-adopt','t-adopt')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
                            <span class="sb-lbl">Adoption</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub" id="g-adopt"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Listings"><span class="sb-dot"></span><span class="sb-child-lbl">Listings</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Flagged"><span class="sb-dot"></span><span class="sb-child-lbl">Flagged</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Adopted_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Adopted Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Analytics_A"><span class="sb-dot"></span><span class="sb-child-lbl">Analytics</span></a>
                        </div></div>
                    </div>
                    <div>
                        <button class="sb-row open active" id="t-rep" onclick="acc('g-rep','t-rep')" type="button">
                            <span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                            <span class="sb-lbl">Reports</span>
                            <span class="sb-chv"><svg class="ico" style="width:13px;height:13px" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></span>
                        </button>
                        <div class="sb-sub open" id="g-rep" style="height:auto;"><div class="sb-sub-inner">
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Lost_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Lost Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Found_Pets"><span class="sb-dot"></span><span class="sb-child-lbl">Found Pets</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Dangerous_Animals"><span class="sb-dot"></span><span class="sb-child-lbl">Dangerous Animals</span></a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Donations"><span class="sb-dot"></span><span class="sb-child-lbl">Donations</span></a>
                            
                            <a class="sb-child active" asp-controller="SuperAdmin" asp-action="System_Complaints">
                                <span class="sb-dot"></span>
                                <span class="sb-child-lbl">System Complaints</span>
                                @if (openComplaints > 0)
                                {
                                    <span class="sb-bdg bd-r sb-child-bdg">@openComplaints</span>
                                }
                            </a>
                            <a class="sb-child" asp-controller="SuperAdmin" asp-action="Laws_Regulations"><span class="sb-dot"></span><span class="sb-child-lbl">Laws &amp; Regulations</span></a>
                        </div></div>
                    </div>
                </div>
                <div class="sb-hr"></div>
                <div class="sb-group">
                    <div class="sb-grp-hd">Tools</div>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Map"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/></svg></span><span class="sb-lbl">Map</span></a>
                    <a class="sb-row" asp-controller="SuperAdmin" asp-action="Notifications"><span class="sb-icon"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span><span class="sb-lbl">Notifications</span></a>
                </div>
            </nav>
            <div class="sb-foot">
                <div class="sb-user-row"><div class="sb-av">@(ViewBag.AdminInitials ?? "AD")</div><div class="sb-user-info"><div class="sb-user-name">@(ViewBag.AdminName ?? "Admin")</div><div class="sb-user-role">Super Admin</div></div></div>
                <a class="sb-logout" asp-controller="Account" asp-action="Logout"><svg class="ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span class="sb-logout-lbl">Sign Out</span></a>
            </div>
        </aside>

        <!-- ══ TOPNAV ══ -->
        <header class="wa-tn" id="waTn">
            <button class="tn-toggle" onclick="toggleSb()" type="button"><svg class="ico" style="width:17px;height:17px" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
            <nav class="tn-bread"><span>Reports</span><span>/</span><b>System Complaints</b></nav>
            <div class="tn-center"><div class="tn-center-main">System Complaints</div><div class="tn-center-sub">Super Admin Panel</div></div>
            <div class="tn-spacer"></div>
            <div class="tn-right">
                <a class="tn-btn" asp-controller="SuperAdmin" asp-action="Notifications"><svg class="ico" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></a>
                <div class="tn-sep"></div>
                <div class="tn-profile"><div class="tn-av">@(ViewBag.AdminInitials ?? "AD")</div><div><div class="tn-pname">@(ViewBag.AdminName ?? "Admin")</div><div class="tn-prole">Super Admin</div></div></div>
            </div>
        </header>

        <!-- ══ MAIN ══ -->
        <main class="wa-main" id="waMain">
            <section class="page-hero">
                <div>
                    <h1>⚙️ System Complaints</h1>
                    <p>Handle technical issues and system-related complaints submitted by users.</p>
                </div>
            </section>

            <div class="page-body">

                @if (ViewBag.Success != null)
                {
                    <div style="background:var(--success-soft);border:1px solid rgba(47,158,95,.25);
                                color:#2e7d32;padding:12px 16px;border-radius:14px;
                                font-weight:800;font-size:.86rem;margin-bottom:16px;">
                        @ViewBag.Success
                    </div>
                }

                @* KPIs *@
                <div class="kpi-grid kpi-grid-4">
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">📋</div>
                        <div class="kpi-val">@totalComplaints</div>
                        <div class="kpi-label">Total</div>
                    </div>
                    <div class="kpi-card c4">
                        <div class="kpi-ico red">🔴</div>
                        <div class="kpi-val">@openComplaints</div>
                        <div class="kpi-label">Open</div>
                        @if (openComplaints > 0)
                        {
                            <div class="kpi-chip chip-red">Need action</div>
                        }
                    </div>
                    <div class="kpi-card c3">
                        <div class="kpi-ico yellow">🔍</div>
                        <div class="kpi-val">@investigatingCount</div>
                        <div class="kpi-label">Investigating</div>
                        @if (investigatingCount > 0)
                        {
                            <div class="kpi-chip chip-yellow">In progress</div>
                        }
                    </div>
                    <div class="kpi-card c1">
                        <div class="kpi-ico green">✅</div>
                        <div class="kpi-val">@resolvedComplaints</div>
                        <div class="kpi-label">Resolved</div>
                        <div class="kpi-chip chip-green">Done</div>
                    </div>
                </div>

                @* Filters *@
                <div style="display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 14px;">
                    <div class="search-wrap" style="flex:1 1 240px;">
                        <span style="color:var(--text-muted);">🔍</span>
                        <input type="text" id="compSearch" placeholder="Search complaints..."
                               oninput="filterComplaints()" />
                    </div>
                    <select class="sel-wrap" style="width:auto;min-width:160px;"
                            id="compStatusFilter" onchange="filterComplaints()">
                        <option value="">All Statuses</option>
                        <option value="open">Open</option>
                        <option value="investigating">Investigating</option>
                        <option value="resolved">Resolved</option>
                    </select>
                    <select class="sel-wrap" style="width:auto;min-width:160px;"
                            id="compPriorityFilter" onchange="filterComplaints()">
                        <option value="">All Priorities</option>
                        <option value="urgent">🔴 Urgent</option>
                        <option value="high">🔴 High</option>
                        <option value="medium">🟡 Medium</option>
                        <option value="low">🟢 Low</option>
                    </select>
                    <button class="btn btn-outline btn-sm" onclick="resetFilters()">Reset</button>
                </div>

                @* Complaints List *@
                <div id="complaintsList">
                    @if (!complaints.Any())
                    {
                        <div style="text-align:center;padding:40px;color:var(--text-muted);">
                            <div style="font-size:2rem;margin-bottom:12px;">⚙️</div>
                            <p style="font-weight:800;">No system complaints yet.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var c in complaints)
                        {
                            var priorityColor = c.Priority == "High" || c.Priority == "Urgent"
                                              ? "var(--danger)"
                                              : c.Priority == "Medium"
                                              ? "var(--warning)"
                                              : "var(--border)";

                            var stBadge = c.Status switch {
                                "Resolved"      => "badge-success",
                                "Investigating" => "badge-warning",
                                "Open"          => "badge-danger",
                                _               => "badge-muted"
                            };

                            var prBadge = c.Priority switch {
                                "Urgent" => "badge-danger",
                                "High"   => "badge-danger",
                                "Medium" => "badge-warning",
                                _        => "badge-muted"
                            };

                            var prIcon = c.Priority switch {
                                "Urgent" => "🚨",
                                "High"   => "🔴",
                                "Medium" => "🟡",
                                _        => "🟢"
                            };

                            <div class="complaint-row"
                                 data-search="@(c.Title ?? "")@(c.ComplainantName ?? "")@(c.Description ?? "")"
                                 data-status="@c.Status?.ToLower()"
                                 data-priority="@c.Priority?.ToLower()"
                                 data-title="@(c.Title ?? "System Complaint")"
                                 data-complainant="@(c.ComplainantName ?? $"User #{c.IdUser}")"
                                 data-date="@c.CreatedAt?.ToString("MMM dd, yyyy")"
                                 data-description="@c.Description"
                                 data-status-val="@c.Status"
                                 style="background:#fff;border:1px solid var(--border);
                                        border-left:4px solid @priorityColor;
                                        border-radius:var(--r-lg);padding:18px;
                                        margin-bottom:12px;box-shadow:var(--shadow);">

                                <div style="display:flex;align-items:flex-start;
                                            justify-content:space-between;gap:12px;
                                            flex-wrap:wrap;margin-bottom:10px;">
                                    <div>
                                        <div style="font-size:.92rem;font-weight:900;color:var(--brand-dark);">
                                            ⚙️ @(c.Title ?? "System Complaint")
                                        </div>
                                        <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">
                                            👤 @(c.ComplainantName ?? $"User #{c.IdUser}")
                                            &nbsp;·&nbsp;
                                            📅 @c.CreatedAt?.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                        @if (c.Priority != null)
                                        {
                                            <span class="badge @prBadge" style="font-size:.68rem;">
                                                @prIcon @c.Priority
                                            </span>
                                        }
                                        <span class="badge @stBadge">@c.Status</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <div style="font-size:.84rem;color:var(--text-muted);
                                                line-height:1.55;margin-bottom:12px;">
                                        @(c.Description.Length > 120 ? c.Description[..120] + "…" : c.Description)
                                    </div>
                                }

                                <div class="action-group" style="display:flex;gap:8px;flex-wrap:wrap;">

                                    <button type="button" class="btn btn-outline btn-xs"
                                            onclick="openDetails(this.closest('.complaint-row'))">
                                        👁 Details
                                    </button>

                                    @if (c.Status != "Resolved")
                                    {
                                        <form method="post" asp-controller="SuperAdmin"
                                              asp-action="UpdateComplaintStatus" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                            <input type="hidden" name="status"      value="Resolved" />
                                            <input type="hidden" name="returnPage"  value="System_Complaints" />
                                            <button type="submit" class="btn btn-success btn-xs">✅ Resolve</button>
                                        </form>

                                        <form method="post" asp-controller="SuperAdmin"
                                              asp-action="UpdateComplaintStatus" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                            <input type="hidden" name="status"      value="Investigating" />
                                            <input type="hidden" name="returnPage"  value="System_Complaints" />
                                            <button type="submit" class="btn btn-warning btn-xs">🔍 Investigate</button>
                                        </form>
                                    }

                                    @if (c.Status == "Resolved" || c.Status == "Investigating")
                                    {
                                        <form method="post" asp-controller="SuperAdmin"
                                              asp-action="UpdateComplaintStatus" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="complaintId" value="@c.IdComplaint" />
                                            <input type="hidden" name="status"      value="Open" />
                                            <input type="hidden" name="returnPage"  value="System_Complaints" />
                                            <button type="submit" class="btn btn-outline btn-xs">🔄 Reopen</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </main>
    </div>

    @* Details Panel *@
    <div class="detail-overlay" id="complaintPanel">
        <div class="detail-panel" style="max-width:780px;">
            <div class="dp-header">
                <div class="dp-title" id="compPanelTitle">⚙️ Complaint Details</div>
                <button class="dp-close" onclick="closeM('complaintPanel')">✕</button>
            </div>
            <div class="dp-body" id="complaintPanelBody"></div>
            <div class="dp-footer" id="complaintPanelFooter"></div>
        </div>
    </div>

    <script src="~/js/Waffy-Shell.js" asp-append-version="true"></script>
    <script>
        function filterComplaints() {
            var q        = (document.getElementById('compSearch')?.value        || '').toLowerCase();
            var status   = (document.getElementById('compStatusFilter')?.value  || '').toLowerCase();
            var priority = (document.getElementById('compPriorityFilter')?.value || '').toLowerCase();

            document.querySelectorAll('.complaint-row').forEach(function(row) {
                var search = (row.dataset.search   || '').toLowerCase();
                var rStat  = (row.dataset.status   || '');
                var rPri   = (row.dataset.priority || '');

                var mQ = !q        || search.includes(q);
                var mS = !status   || rStat === status;
                var mP = !priority || rPri  === priority;

                row.style.display = (mQ && mS && mP) ? '' : 'none';
            });
        }

        function resetFilters() {
            document.getElementById('compSearch').value = '';
            document.getElementById('compStatusFilter').selectedIndex   = 0;
            document.getElementById('compPriorityFilter').selectedIndex = 0;
            filterComplaints();
        }

        function openDetails(row) {
            var title       = row.dataset.title       || 'System Complaint';
            var complainant = row.dataset.complainant || '—';
            var date        = row.dataset.date        || '—';
            var priority    = row.dataset.priority    || '—';
            var description = row.dataset.description || '—';
            var status      = row.dataset.statusVal   || row.dataset.status || '—';

            document.getElementById('compPanelTitle').textContent = '⚙️ ' + title;

            var prBadge = priority === 'High' || priority === 'Urgent'
                ? '<span class="badge badge-danger">🔴 ' + priority + '</span>'
                : priority === 'Medium'
                ? '<span class="badge badge-warning">🟡 Medium</span>'
                : '<span class="badge badge-muted">🟢 Low</span>';

            var stBadge = status === 'Resolved'
                ? '<span class="badge badge-success">✅ Resolved</span>'
                : status === 'Investigating'
                ? '<span class="badge badge-warning">🔍 Investigating</span>'
                : '<span class="badge badge-danger">🔴 Open</span>';

            document.getElementById('complaintPanelBody').innerHTML =
                '<div class="dp-section">' +
                    '<div class="dp-section-title">Overview</div>' +
                    '<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">' + stBadge + ' ' + prBadge + '</div>' +
                    '<div class="dp-grid">' +
                        '<div class="dp-info-item"><div class="dp-info-label">⚙️ Type</div><div class="dp-info-val">System Complaint</div></div>' +
                        '<div class="dp-info-item"><div class="dp-info-label">📅 Date Filed</div><div class="dp-info-val">' + date + '</div></div>' +
                        '<div class="dp-info-item"><div class="dp-info-label">👤 Submitted By</div><div class="dp-info-val">' + complainant + '</div></div>' +
                        '<div class="dp-info-item"><div class="dp-info-label">⚡ Priority</div><div class="dp-info-val">' + priority + '</div></div>' +
                    '</div>' +
                '</div>' +
                '<div class="dp-section">' +
                    '<div class="dp-section-title">Description</div>' +
                    '<div style="background:var(--surface-2);border-radius:12px;padding:16px;font-size:.88rem;line-height:1.7;">' + description + '</div>' +
                '</div>';

            document.getElementById('complaintPanelFooter').innerHTML =
                '<button class="btn btn-outline btn-sm" onclick="closeM(\'complaintPanel\')">Close</button>';

            openM('complaintPanel');
        }

        function openM(id)  { var m = document.getElementById(id); if (m) m.classList.add('open'); }
        function closeM(id) { var m = document.getElementById(id); if (m) m.classList.remove('open'); }

        document.querySelectorAll('.detail-overlay').forEach(function(m) {
            m.addEventListener('click', function(e) {
                if (e.target === m) m.classList.remove('open');
            });
        });

        function toast(msg, type) {
            type = type || 'success';
            var bg  = { success:'var(--success-soft)', danger:'var(--danger-soft)', warning:'var(--warning-soft)' };
            var col = { success:'var(--success)', danger:'var(--danger)', warning:'#9b6000' };
            var t = document.createElement('div');
            t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:14px 20px;border-radius:14px;background:' + bg[type] + ';border:1px solid ' + col[type] + '40;color:' + col[type] + ';font-weight:800;font-size:.86rem;font-family:Nunito,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.12);max-width:320px;';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(function() { t.remove(); }, 3000);
        }

        var ts = document.createElement('style');
        ts.textContent = '@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}';
        document.head.appendChild(ts);
    </script>
</body>
</html>