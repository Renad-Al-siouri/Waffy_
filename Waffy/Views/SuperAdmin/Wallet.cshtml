@model Waffy.Models.ViewModels.SuperAdminWalletViewModel

@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";

    ViewData["Title"] = "Waffy — Super Admin | Wallet";
    ViewData["ActiveSection"] = "wallet";
    ViewData["ActivePage"] = "wallet";
    ViewData["PageTitle"] = "Wallet";
    ViewData["BreadcrumbParent"] = "Financial";
    ViewData["BreadcrumbCurrent"] = "Super Admin Wallet";

    var adminName = ViewBag.AdminName as string ?? "Admin";
    var adminInitials = ViewBag.AdminInitials as string ?? "AD";
}

<style>
    .wallet-page {
        padding-bottom: 28px;
    }

    .wallet-hero {
        background: radial-gradient(circle at top right, rgba(154, 180, 81, .18), transparent 34%), linear-gradient(135deg, #fffdf9, #fbf6f1);
        border: 1.5px solid var(--line, #e8ddd0);
        border-radius: 26px;
        padding: 22px;
        margin-bottom: 16px;
        box-shadow: 0 10px 28px rgba(90, 75, 49, .08);
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 18px;
        align-items: stretch;
    }

    .wallet-hero-left {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

    .wallet-eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 7px;
        padding: 5px 10px;
        border-radius: 999px;
        background: #f3f7e7;
        color: #5f7430;
        border: 1px solid #dbe8b8;
        font-size: .74rem;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .wallet-hero h1 {
        font-family: 'Fredoka', sans-serif;
        color: var(--gd, #5f7430);
        margin: 0 0 7px;
        font-size: clamp(1.55rem, 2.2vw, 2.15rem);
        line-height: 1.1;
    }

    .wallet-hero p {
        margin: 0;
        color: var(--muted, #7b6c58);
        font-weight: 800;
        max-width: 680px;
        line-height: 1.55;
        font-size: .92rem;
    }

    .balance-card {
        background: linear-gradient(180deg, #9ab451, #7d953d);
        color: white;
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 12px 24px rgba(95, 116, 48, .24);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 150px;
        overflow: hidden;
        position: relative;
    }

        .balance-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .13);
            right: -38px;
            bottom: -42px;
        }

    .balance-label {
        font-size: .78rem;
        font-weight: 900;
        opacity: .92;
        position: relative;
        z-index: 1;
    }

    .balance-value {
        font-family: 'Fredoka', sans-serif;
        font-size: clamp(1.7rem, 2.5vw, 2.25rem);
        font-weight: 800;
        line-height: 1;
        margin-top: 12px;
        position: relative;
        z-index: 1;
        word-break: break-word;
    }

    .balance-sub {
        font-size: .73rem;
        font-weight: 800;
        opacity: .88;
        margin-top: 12px;
        position: relative;
        z-index: 1;
    }

    .wallet-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 16px;
    }

    .wallet-kpi {
        background: var(--card, #fffdf9);
        border: 1.5px solid var(--line, #e8ddd0);
        border-radius: 20px;
        padding: 16px;
        box-shadow: 0 6px 18px rgba(90, 75, 49, .08);
        min-width: 0;
    }

    .wallet-kpi-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .wallet-kpi .ico {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: #f3f7e7;
        color: #5f7430;
        font-size: 1.25rem;
        flex: 0 0 auto;
    }

    .wallet-kpi .tag {
        font-size: .68rem;
        font-weight: 900;
        color: #7b6c58;
        background: #fbf6f1;
        border: 1px solid #e8ddd0;
        border-radius: 999px;
        padding: 3px 8px;
        white-space: nowrap;
    }

    .wallet-kpi .val {
        font-family: 'Fredoka', sans-serif;
        font-size: clamp(1.08rem, 1.6vw, 1.35rem);
        font-weight: 800;
        color: var(--gd, #5f7430);
        word-break: break-word;
    }

    .wallet-kpi .lbl {
        font-size: .76rem;
        font-weight: 800;
        color: var(--muted, #7b6c58);
        margin-top: 5px;
        line-height: 1.35;
    }

    .wallet-content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
    }

    .wallet-table-card {
        background: var(--card, #fffdf9);
        border: 1.5px solid var(--line, #e8ddd0);
        border-radius: 22px;
        box-shadow: 0 8px 24px rgba(90, 75, 49, .08);
        overflow: hidden;
        min-width: 0;
    }

    .wallet-table-head {
        padding: 16px 18px;
        border-bottom: 1px solid var(--line, #e8ddd0);
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        background: linear-gradient(180deg, #fffdf9, #fbf6f1);
    }

    .wallet-table-title {
        min-width: 0;
    }

        .wallet-table-title h2 {
            font-family: 'Fredoka', sans-serif;
            color: var(--gd, #5f7430);
            font-size: 1.15rem;
            font-weight: 800;
            margin: 0;
        }

        .wallet-table-title p {
            margin: 3px 0 0;
            color: var(--muted, #7b6c58);
            font-size: .78rem;
            font-weight: 800;
        }

    .table-search {
        padding: 10px 12px;
        border-radius: 13px;
        border: 1.5px solid var(--line, #e8ddd0);
        background: #fff;
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        width: min(320px, 100%);
        outline: none;
        color: var(--text, #45382e);
    }

        .table-search:focus {
            border-color: #9ab451;
            box-shadow: 0 0 0 4px rgba(154, 180, 81, .12);
        }

    .table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .wallet-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 860px;
    }

        .wallet-table th {
            text-align: left;
            padding: 12px 14px;
            font-size: .73rem;
            color: var(--muted, #7b6c58);
            border-bottom: 1px solid var(--line, #e8ddd0);
            white-space: nowrap;
            background: #fffdf9;
            font-weight: 900;
        }

        .wallet-table td {
            padding: 14px;
            border-bottom: 1px solid rgba(232, 221, 208, .65);
            font-size: .82rem;
            font-weight: 750;
            color: var(--text, #45382e);
            vertical-align: middle;
        }

        .wallet-table tr:hover td {
            background: rgba(251, 246, 241, .62);
        }

    .tx-main {
        min-width: 190px;
    }

    .tx-code {
        font-weight: 950;
        color: var(--gd, #5f7430);
        line-height: 1.2;
        word-break: break-word;
    }

    .tx-desc {
        font-size: .73rem;
        color: var(--muted, #7b6c58);
        margin-top: 5px;
        max-width: 360px;
        line-height: 1.35;
        font-weight: 800;
    }

    .tx-type {
        font-weight: 900;
        color: #564632;
        white-space: nowrap;
    }

    .amt-in {
        color: #2f9e5f;
        font-weight: 950;
        white-space: nowrap;
    }

    .amt-out {
        color: #c86a5c;
        font-weight: 950;
        white-space: nowrap;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 9px;
        font-size: .72rem;
        font-weight: 950;
        background: #f3f7e7;
        color: #5f7430;
        border: 1px solid #dbe8b8;
        white-space: nowrap;
        max-width: 170px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pill-cliq {
        background: #fff8e1;
        color: #9b6000;
        border-color: #fde68a;
    }

    .pill-wallet {
        background: #edf7e8;
        color: #2f9e5f;
        border-color: #bfe7c8;
    }

    .pill-status {
        background: #f4f1ec;
        color: #6f5d47;
        border-color: #e8ddd0;
    }

    .tx-date-main {
        font-weight: 950;
        color: #564632;
        white-space: nowrap;
    }

    .tx-date-sub {
        font-size: .72rem;
        color: var(--muted, #7b6c58);
        font-weight: 850;
        margin-top: 3px;
        white-space: nowrap;
    }

    .empty-row {
        text-align: center;
        padding: 34px !important;
        color: var(--muted, #7b6c58);
        font-weight: 850;
    }

    .alert-ok {
        background: #edf7e8;
        border: 1px solid #bccc7e;
        color: #5f7430;
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-weight: 850;
    }

    .alert-bad {
        background: #faece8;
        border: 1px solid rgba(200, 106, 92, .3);
        color: #c86a5c;
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 16px;
        font-weight: 850;
    }

    @@media(max-width: 1180px) {
        .wallet-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .wallet-hero {
            grid-template-columns: minmax(0, 1fr) 250px;
        }
    }

    @@media(max-width: 820px) {
        .wallet-hero {
            grid-template-columns: 1fr;
            padding: 18px;
        }

        .balance-card {
            width: 100%;
            min-height: 128px;
        }

        .wallet-grid {
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .wallet-table-head {
            align-items: stretch;
        }

        .table-search {
            width: 100%;
        }
    }

    @@media(max-width: 560px) {
        .wallet-hero {
            border-radius: 20px;
            padding: 16px;
        }

        .wallet-grid {
            grid-template-columns: 1fr;
        }

        .wallet-kpi {
            padding: 14px;
        }

        .wallet-table-card {
            border-radius: 18px;
        }

        .wallet-table-head {
            padding: 14px;
        }

        .wallet-table {
            min-width: 760px;
        }
    }
</style>

<main class="wa-main wallet-page" id="waMain">

    <section class="wallet-hero">
        <div class="wallet-hero-left">
            <div class="wallet-eyebrow">💼 Financial Control</div>
            <h1>Super Admin Wallet</h1>
            <p>
                Track Waffy booking deposits collected from users, refunds returned after attendance or valid cancellation,
                and retained balances for no-show cases.
            </p>
        </div>

        <div class="balance-card">
            <div>
                <div class="balance-label">Current Balance</div>
                <div class="balance-value">@Model.CurrentBalance.ToString("F2") JOD</div>
            </div>
            <div class="balance-sub">Held by Waffy until refund or retention decision.</div>
        </div>
    </section>

    @if (ViewBag.Success != null)
    {
        <div class="alert-ok">@ViewBag.Success</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert-bad">@ViewBag.Error</div>
    }

    <section class="wallet-grid">
        <div class="wallet-kpi">
            <div class="wallet-kpi-top">
                <div class="ico">💳</div>
                <div class="tag">IN</div>
            </div>
            <div class="val">@Model.TotalDepositsCollected.ToString("F2") JOD</div>
            <div class="lbl">Deposits Collected</div>
        </div>

        <div class="wallet-kpi">
            <div class="wallet-kpi-top">
                <div class="ico">↩️</div>
                <div class="tag">OUT</div>
            </div>
            <div class="val">@Model.TotalDepositsReturned.ToString("F2") JOD</div>
            <div class="lbl">Deposits Returned</div>
        </div>

        <div class="wallet-kpi">
            <div class="wallet-kpi-top">
                <div class="ico">🔒</div>
                <div class="tag">HELD</div>
            </div>
            <div class="val">@Model.TotalDepositsRetained.ToString("F2") JOD</div>
            <div class="lbl">Current Retained Balance</div>
        </div>

        <div class="wallet-kpi">
            <div class="wallet-kpi-top">
                <div class="ico">🧾</div>
                <div class="tag">LOG</div>
            </div>
            <div class="val">@Model.TotalTransactions</div>
            <div class="lbl">Transactions</div>
        </div>
    </section>
    <form asp-controller="SuperAdmin"
          asp-action="UpdateAppointmentCliqNumber"
          method="post"
          style="background:#fff;border:1px solid #e8ddd0;border-radius:16px;padding:16px;margin-bottom:16px;">
        @Html.AntiForgeryToken()

        <div style="font-family:'Fredoka',sans-serif;font-size:1rem;font-weight:700;color:#5f7430;margin-bottom:8px;">
            📱 Waffy CliQ Number
        </div>

        <div style="font-size:.82rem;font-weight:700;color:#7b6c58;margin-bottom:10px;line-height:1.6;">
            This number will appear to users when they choose CliQ payment for appointment deposits.
            Users must transfer the 5 JOD deposit to this number.
        </div>

        <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <input type="text"
                   name="cliqNumber"
                   value="@(ViewBag.SuperAdminCliqNumber ?? "")"
                   placeholder="e.g. 078XXXXXXX"
                   style="flex:1;min-width:220px;padding:10px 12px;border:1.5px solid #e8ddd0;border-radius:10px;font-weight:800;">

            <button type="submit"
                    style="border:none;border-radius:10px;padding:10px 16px;background:#8ba94a;color:#fff;font-weight:900;cursor:pointer;">
                Save CliQ
            </button>
        </div>
    </form>
    <section class="wallet-content-grid">
        <div class="wallet-table-card">
            <div class="wallet-table-head">
                <div class="wallet-table-title">
                    <h2>Wallet Transactions</h2>
                    <p>Search by code, payment method, type, reference, or description.</p>
                </div>

                <input class="table-search"
                       id="txSearch"
                       type="text"
                       placeholder="Search transaction..."
                       oninput="filterTransactions()" />
            </div>

            <div class="table-wrap">
                <table class="wallet-table">
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Type</th>
                            <th>Method</th>
                            <th>Amount</th>
                            <th>Reference</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody id="txBody">
                        @if (Model.Transactions.Any())
                        {
                            foreach (var t in Model.Transactions)
                            {
                                var isIn = t.Amount >= 0;
                                var paymentMethod = t.PaymentMethod ?? "—";
                                var methodClass = paymentMethod.ToLower() == "cliq" ? "pill-cliq" : "pill-wallet";

                                <tr class="tx-row">
                                    <td>
                                        <div class="tx-main">
                                            <div class="tx-code">@(t.TransactionCode ?? "—")</div>

                                            @if (!string.IsNullOrWhiteSpace(t.Description))
                                            {
                                                <div class="tx-desc">@t.Description</div>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="tx-type">@(t.Type ?? "—")</span>
                                    </td>

                                    <td>
                                        <span class="pill @methodClass">@paymentMethod</span>
                                    </td>

                                    <td>
                                        <span class="@(isIn ? "amt-in" : "amt-out")">
                                            @(isIn ? "+" : "-")@Math.Abs(t.Amount).ToString("F2") JOD
                                        </span>
                                    </td>

                                    <td>
                                        @if (t.ReferenceId != null)
                                        {
                                            <span class="pill">
                                                @(t.ReferenceType ?? "Ref") #@t.ReferenceId
                                            </span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="pill pill-status">@(t.Status ?? "—")</span>
                                    </td>

                                    <td>
                                        <div class="tx-date-main">@t.CreatedAt</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="empty-row">
                                    No wallet transactions yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

</main>

@section PageScripts {
    <script>
        function filterTransactions() {
            const q = (document.getElementById('txSearch')?.value || '').toLowerCase();

            document.querySelectorAll('.tx-row').forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}