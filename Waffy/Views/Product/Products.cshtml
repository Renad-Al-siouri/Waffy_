@model Waffy.Models.ViewModels.ProductListViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Store.Name + " — Products";
    var priceRanges = new (decimal? Value, string Label)[]
    {
        (null,  "All Prices"),
        (5m,    "Under 5 JD"),
        (10m,   "Under 10 JD"),
        (20m,   "Under 20 JD"),
        (35m,   "Under 35 JD"),
        (50m,   "Under 50 JD"),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/prodstayle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --olive: #7a9e35;
            --olive-dark: #4d6620;
            --olive-light: #a8c558;
            --olive-xlight: #eef4e0;
            --cream: #faf6f0;
            --card-bg: #ffffff;
            --text-dark: #26321a;
            --text-mid: #5a6e40;
            --text-muted: #8fa070;
            --line: #e2ecd0;
            --danger: #d94f3a;
            --warning: #e8a020;
            --radius-card: 18px;
            --radius-btn: 999px;
            --shadow-card: 0 2px 12px rgba(80,110,30,.09);
            --shadow-hover: 0 12px 32px rgba(80,110,30,.18);
            --transition: .22s cubic-bezier(.4,0,.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: var(--cream);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        main {
            flex: 1;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            display: block;
            max-width: 100%;
        }

        .container {
            width: min(1220px, calc(100% - 28px));
            margin: 0 auto;
        }

        /* ── NAVBAR ────────────────────────────── */
        .top-hero-area {
            width: 100%;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 900;
            background: rgba(250,246,240,.88);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(120,160,50,.12);
        }

        .header-shell {
            display: flex;
            justify-content: center;
            padding: 10px 20px;
        }

        .navbar {
            width: 100%;
            max-width: 1280px;
            display: grid;
            grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);
            align-items: center;
            gap: 16px;
            min-height: 68px;
        }

        .desktop-nav {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .left-nav {
            justify-content: flex-start;
        }

        .right-nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .logo-center {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-logo {
            width: 130px;
            height: auto;
        }

        .nav-link {
            padding: 8px 14px;
            border-radius: var(--radius-btn);
            font-size: .86rem;
            font-weight: 800;
            color: var(--text-mid);
            border: none;
            background: transparent;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .nav-link:hover, .nav-link.active {
                background: var(--olive);
                color: #fff;
            }

        .login-btn {
            background: var(--olive);
            color: #fff !important;
            box-shadow: 0 4px 14px rgba(120,160,50,.3);
        }

            .login-btn:hover {
                background: var(--olive-dark);
            }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .nav-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--olive-dark);
            font-size: .95rem;
            cursor: pointer;
            transition: var(--transition);
            flex-shrink: 0;
        }

            .nav-icon:hover {
                background: var(--olive);
                color: #fff;
                border-color: var(--olive);
            }

        .profile-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid rgba(120,160,50,.3);
            flex-shrink: 0;
        }

            .profile-btn img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .services-dropdown {
            position: relative;
        }

        .dropdown-arrow {
            font-size: .65rem;
            margin-left: 5px;
            transition: transform .2s;
        }

        .services-dropdown.open .dropdown-arrow {
            transform: rotate(180deg);
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 210px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: 0 16px 40px rgba(60,90,20,.14);
            padding: 8px;
            flex-direction: column;
            gap: 2px;
            z-index: 2000;
        }

        .services-dropdown.open .dropdown-menu {
            display: flex;
        }

        .dropdown-link {
            display: block;
            padding: 9px 12px;
            border-radius: 10px;
            font-size: .84rem;
            font-weight: 700;
            color: var(--text-dark);
            transition: var(--transition);
        }

            .dropdown-link:hover {
                background: var(--olive-xlight);
                color: var(--olive-dark);
            }

        .mobile-nav-wrap {
            display: none;
            position: relative;
        }

        .menu-btn {
            display: none;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--olive);
            color: #fff;
            border: none;
            font-size: 1rem;
            cursor: pointer;
            place-items: center;
        }

        .nav-links {
            display: none;
            position: absolute;
            top: 52px;
            right: 0;
            width: min(260px, calc(100vw - 20px));
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 16px 40px rgba(60,90,20,.14);
            padding: 12px;
            flex-direction: column;
            gap: 6px;
            z-index: 3000;
            max-height: calc(100vh - 80px);
            overflow-y: auto;
        }

            .nav-links.open {
                display: flex;
            }

            .nav-links .nav-link {
                width: 100%;
                justify-content: center;
            }

        .mobile-menu-logo {
            display: flex;
            justify-content: center;
            padding-bottom: 8px;
        }

            .mobile-menu-logo img {
                width: 70px;
            }

        .mobile-services-block {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .mobile-services-toggle {
            width: 100%;
            border: 1px solid var(--line);
            background: #fafafa;
            color: var(--olive-dark);
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: .86rem;
        }

        .mobile-services-menu {
            display: none;
            flex-direction: column;
            gap: 4px;
            padding-top: 4px;
        }

        .mobile-services-block.open .mobile-services-menu {
            display: flex;
        }

        .mobile-services-block.open .dropdown-arrow {
            transform: rotate(180deg);
        }

        /* ── PAGE WRAPPER ────────────────────────── */
        .products-page {
            padding: 28px 0 48px;
        }

        /* ── HERO ────────────────────────────────── */
        .hero-section {
            text-align: center;
            padding: 4px 0 22px;
        }

            .hero-section h1 {
                font-family: 'Fredoka', sans-serif;
                font-size: clamp(1.7rem, 3.5vw, 2.6rem);
                color: var(--olive-dark);
                margin-bottom: 8px;
            }

            .hero-section p {
                color: var(--text-muted);
                font-weight: 700;
                font-size: .92rem;
                max-width: 560px;
                margin: 0 auto;
            }

        /* ── STORE STRIP ─────────────────────────── */
        .store-strip {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #fff;
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 14px 18px;
            margin-bottom: 22px;
            box-shadow: var(--shadow-card);
        }

        .store-logo-box, .store-logo-ph {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            flex-shrink: 0;
        }

        .store-logo-box {
            object-fit: cover;
            border: 2px solid var(--line);
        }

        .store-logo-ph {
            background: var(--olive-xlight);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .store-strip-info h2 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--olive-dark);
            margin-bottom: 3px;
        }

        .store-meta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            font-size: .74rem;
            color: var(--text-muted);
            font-weight: 700;
        }

            .store-meta span {
                display: flex;
                align-items: center;
                gap: 4px;
            }

        .back-link {
            margin-left: auto;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: var(--radius-btn);
            border: 1.5px solid var(--line);
            background: var(--olive-xlight);
            color: var(--olive-dark);
            font-size: .8rem;
            font-weight: 800;
            transition: var(--transition);
        }

            .back-link:hover {
                background: var(--olive);
                color: #fff;
                border-color: var(--olive);
            }

        /* ── FILTERS ─────────────────────────────── */
        .filters-wrap {
            margin-bottom: 22px;
        }

        .search-price-row {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 12px;
        }

        .search-box {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #fff;
            border: 1.5px solid var(--line);
            border-radius: var(--radius-btn);
            padding: 0 16px;
            height: 48px;
            transition: var(--transition);
        }

            .search-box:focus-within {
                border-color: var(--olive);
            }

            .search-box i {
                color: var(--text-muted);
                font-size: .95rem;
                flex-shrink: 0;
            }

            .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-family: 'Nunito', sans-serif;
                font-size: .9rem;
                font-weight: 700;
                color: var(--text-dark);
                width: 100%;
            }

                .search-box input::placeholder {
                    color: var(--text-muted);
                }

        .price-select {
            height: 48px;
            padding: 0 14px;
            border-radius: var(--radius-btn);
            border: 1.5px solid var(--line);
            background: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-mid);
            cursor: pointer;
            outline: none;
            flex-shrink: 0;
            transition: var(--transition);
        }

            .price-select:focus {
                border-color: var(--olive);
            }

        .cat-scroll {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 4px;
            scrollbar-width: none;
        }

            .cat-scroll::-webkit-scrollbar {
                display: none;
            }

        .cat-tab {
            flex-shrink: 0;
            padding: 7px 16px;
            border-radius: var(--radius-btn);
            border: 1.5px solid var(--line);
            background: #fff;
            font-size: .8rem;
            font-weight: 800;
            color: var(--text-mid);
            text-decoration: none;
            white-space: nowrap;
            transition: var(--transition);
        }

            .cat-tab:hover {
                border-color: var(--olive-light);
                color: var(--olive-dark);
            }

            .cat-tab.active {
                background: var(--olive);
                border-color: var(--olive);
                color: #fff;
                box-shadow: 0 4px 14px rgba(120,160,50,.25);
            }

        /* ── PRODUCTS GRID ───────────────────────── */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        /* ── PRODUCT CARD ────────────────────────── */
        .product-card {
            background: var(--card-bg);
            border: 1px solid var(--line);
            border-radius: var(--radius-card);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: transform var(--transition), box-shadow var(--transition);
            box-shadow: var(--shadow-card);
            position: relative;
        }

            .product-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-hover);
            }

        /* Image area */
        .product-image-box {
            position: relative;
            width: 100%;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            background: var(--olive-xlight);
            flex-shrink: 0;
        }

            .product-image-box img.slide-img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0;
                transition: opacity .35s ease;
            }

                .product-image-box img.slide-img.active {
                    opacity: 1;
                }

        .no-img-box {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #c5d5a8;
        }

        /* Image overlay on hover */
        .img-overlay {
            position: absolute;
            inset: 0;
            background: rgba(30,50,10,.0);
            transition: background var(--transition);
            z-index: 2;
        }

        .product-card:hover .img-overlay {
            background: rgba(30,50,10,.15);
        }

        /* Badges on image */
        .img-badges {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            z-index: 3;
        }

        .badge-pill {
            display: inline-block;
            padding: 3px 9px;
            border-radius: var(--radius-btn);
            font-size: .65rem;
            font-weight: 800;
        }

        .badge-sale {
            background: #fff3e0;
            color: #c95c00;
        }

        .badge-oos {
            background: #fdecea;
            color: #b32b18;
        }

        /* Image count badge */
        .img-count {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,.42);
            color: #fff;
            font-size: .6rem;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 8px;
            z-index: 3;
        }

        /* Slider controls */
        .slider-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,.82);
            color: var(--olive-dark);
            border: none;
            width: 28px;
            height: 36px;
            border-radius: 8px;
            font-size: .9rem;
            cursor: pointer;
            z-index: 4;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity .2s;
        }

        .product-image-box:hover .slider-btn {
            opacity: 1;
        }

        .slider-btn.prev {
            left: 6px;
        }

        .slider-btn.next {
            right: 6px;
        }

        .slider-dots {
            position: absolute;
            bottom: 8px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 4px;
            z-index: 4;
        }

        .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: rgba(255,255,255,.5);
            cursor: pointer;
            transition: .2s;
        }

            .dot.active {
                background: #fff;
                transform: scale(1.4);
            }

       
        /* Card content area */
        .product-content {
            padding: 12px 14px 14px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .product-title {
            font-family: 'Fredoka', sans-serif;
            font-size: .98rem;
            font-weight: 600;
            color: var(--text-dark);
            line-height: 1.3;
            margin-bottom: 6px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .price-row {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
        }

        .price-main {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text-dark);
        }

            .price-main.is-sale {
                color: #c95c00;
            }

        .price-original {
            font-size: .78rem;
            color: #bbb;
            text-decoration: line-through;
            font-weight: 700;
        }

        .product-meta-text {
            font-size: .75rem;
            color: var(--text-muted);
            font-weight: 700;
            line-height: 1.4;
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Bottom qty + cart row */
        .card-bottom {
            margin-top: auto;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qty-control {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--olive-xlight);
            border-radius: var(--radius-btn);
            padding: 4px 8px;
            flex-shrink: 0;
        }

        .qty-btn {
            width: 24px;
            height: 24px;
            border-radius: 8px;
            border: none;
            background: #fff;
            color: var(--text-dark);
            font-weight: 900;
            cursor: pointer;
            font-size: .8rem;
            transition: var(--transition);
        }

            .qty-btn:hover {
                background: var(--olive);
                color: #fff;
            }

        .qty-value {
            min-width: 18px;
            text-align: center;
            font-weight: 800;
            font-size: .82rem;
        }

        .add-cart-btn {
            flex: 1;
            height: 36px;
            border: none;
            border-radius: var(--radius-btn);
            background: var(--olive);
            color: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
            transition: var(--transition);
        }

            .add-cart-btn:hover {
                background: var(--olive-dark);
            }

        .oos-label {
            font-size: .78rem;
            color: var(--danger);
            font-weight: 800;
            margin-top: auto;
        }

        /* ── EMPTY STATE ─────────────────────────── */
        .empty-state {
            grid-column: 1/-1;
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 2.8rem;
                display: block;
                margin-bottom: 14px;
            }

            .empty-state h3 {
                font-size: 1.1rem;
                color: var(--text-mid);
                margin-bottom: 6px;
            }

            .empty-state a {
                color: var(--olive);
                font-weight: 800;
            }

        /* ── LIGHTBOX ────────────────────────────── */
        .lightbox {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.92);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
        }

            .lightbox.open {
                display: flex;
            }

            .lightbox img {
                max-width: 90vw;
                max-height: 80vh;
                border-radius: 16px;
                object-fit: contain;
            }

        .lightbox-close {
            position: absolute;
            top: 16px;
            right: 20px;
            color: #fff;
            font-size: 2rem;
            cursor: pointer;
            border: none;
            background: none;
        }

        .lightbox-prev, .lightbox-next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,.14);
            color: #fff;
            border: none;
            width: 44px;
            height: 64px;
            font-size: 1.5rem;
            border-radius: 10px;
            cursor: pointer;
        }

        .lightbox-prev {
            left: 12px;
        }

        .lightbox-next {
            right: 12px;
        }

        .lightbox-counter {
            color: rgba(255,255,255,.6);
            font-size: .82rem;
            font-weight: 700;
        }

        /* ── FOOTER ──────────────────────────────── */
        .footer {
            background: linear-gradient(135deg, var(--olive-dark) 0%, #2e4512 100%);
            color: rgba(255,255,255,.8);
            padding: 28px 20px 34px;
            text-align: center;
            margin-top: 12px;
        }

        .footer-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 10px;
            font-size: .9rem;
        }

            .footer-links a {
                color: rgba(255,255,255,.8);
            }

                .footer-links a:hover {
                    color: #fff;
                }

        /* ── TOAST ───────────────────────────────── */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            background: var(--olive-dark);
            color: #fff;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 800;
            font-size: .86rem;
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: opacity .3s, transform .3s;
        }

            .toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

        /* ── FADE UP ─────────────────────────────── */
        .fade-up {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity .55s ease, transform .55s ease;
        }

            .fade-up.show {
                opacity: 1;
                transform: none;
            }

        /* ── RESPONSIVE ──────────────────────────── */
        @@media (max-width: 1100px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 14px;
            }
        }

        @@media (max-width: 1180px) {
            .desktop-links, .left-nav {
                display: none;
            }

            .mobile-nav-wrap {
                display: flex;
            }

            .menu-btn {
                display: grid;
            }
        }

        @@media (max-width: 760px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }

            .slider-btn {
                opacity: .8 !important;
                width: 24px;
                height: 30px;
            }

            .product-content {
                padding: 10px 11px 11px;
            }

            .product-title {
                font-size: .88rem;
            }

            .price-main {
                font-size: .92rem;
            }

            .add-cart-btn, .quick-add-btn {
                font-size: .75rem;
            }

            .nav-actions .login-btn {
                display: none;
            }
        }

        @@media (max-width: 760px) {
            .product-image-box {
                min-height: 130px;
            }

            .card-bottom {
                flex-direction: column;
                gap: 6px;
            }

            .qty-control {
                justify-content: center;
                width: 100%;
            }

            .add-cart-btn {
                width: 100%;
                height: 32px;
                font-size: .74rem;
            }
        }

        @@media (max-width: 480px) {
            .products-grid {
                gap: 8px;
            }

            .store-strip {
                padding: 10px 12px;
                gap: 10px;
            }

            .back-link span {
                display: none;
            }

            .back-link::before {
                content: '←';
            }

            .product-content {
                padding: 8px 9px 10px;
            }

            .product-image-box {
                min-height: 110px;
            }

            .qty-btn {
                width: 22px;
                height: 22px;
            }

            .add-cart-btn {
                height: 30px;
                font-size: .7rem;
            }
        }
        }
    </style>
</head>
<body>

    <!-- ═══ NAVBAR ═══ -->
    <div class="top-hero-area">
        <header class="topbar">
            <div class="header-shell">
                <nav class="navbar">
                    <div class="left-nav desktop-nav desktop-links">
                        <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                        <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                        <a asp-controller="Product" asp-action="Stores" class="nav-link active">Stores</a>
                        <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                        <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                    </div>
                    <div class="logo-center">
                        <img src="../Images/logo.png" alt="Waffy" class="main-logo">
                    </div>
                    <div class="right-nav">
                        <div class="desktop-nav desktop-links" style="justify-content:flex-end">
                            <div class="services-dropdown" id="servicesDropdown">
                                <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                    Services <span class="dropdown-arrow">▼</span>
                                </button>
                                <div class="dropdown-menu" id="servicesMenu">
                                    <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                    <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                    <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                    <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                    <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                    <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                </div>
                            </div>
                            <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                        </div>
                        <div class="nav-actions">
                            <a asp-controller="Payment" asp-action="Cart" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                            <a asp-controller="Home" asp-action="Notifications" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                            <a asp-controller="Account" asp-action="Profile" class="profile-btn"><img src="../Images/user.jpg" alt="Profile"></a>
                            <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                        </div>
                        <div class="mobile-nav-wrap">
                            <button class="menu-btn" id="menuBtn" type="button">☰</button>
                            <div class="nav-links" id="navLinks">
                                <div class="mobile-menu-logo"><img src="../Images/logo.png" alt="Waffy"></div>
                                <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                                <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                <a asp-controller="Product" asp-action="Stores" class="nav-link active">Stores</a>
                                <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                <div class="mobile-services-block" id="mobileServicesBlock">
                                    <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                        <span>Services</span><span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="mobile-services-menu" id="mobileServicesMenu">
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                        </div>
                    </div>
                </nav>
            </div>
        </header>
    </div>

    <!-- ═══ MAIN ═══ -->
    <main class="container products-page">

        <!-- Hero -->
        <section class="hero-section fade-up">
            <h1>Pet Products 🐾</h1>
            <p>Find everything your furry friend needs, all in one place.</p>
        </section>

        <!-- Store Strip -->
        <div class="store-strip fade-up">
            @if (!string.IsNullOrEmpty(Model.Store.LogoUrl))
            {
                <img src="@Model.Store.LogoUrl" alt="@Model.Store.Name" class="store-logo-box">
            }
            else
            {
                <div class="store-logo-ph">🏪</div>
            }
            <div class="store-strip-info">
                <h2>@Model.Store.Name</h2>
                <div class="store-meta">
                    @if (!string.IsNullOrEmpty(Model.Store.City))
                    {
                        <span><i class="fa-solid fa-location-dot"></i> @Model.Store.City</span>
                    }
                    <span><i class="fa-solid fa-box"></i> @Model.TotalCount item@(Model.TotalCount != 1 ? "s" : "")</span>
                </div>
            </div>
            <a asp-controller="Product" asp-action="Stores" class="back-link">
                ← <span>All Stores</span>
            </a>
        </div>

        <!-- Filters -->
        <div class="filters-wrap fade-up">
            <form method="get" asp-controller="Product" asp-action="Products" id="filterForm">
                <input type="hidden" name="storeId" value="@Model.Store.IdStore">
                <div class="search-price-row">
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="search" id="searchInput"
                               value="@Model.Search" placeholder="Search products…" autocomplete="off">
                    </div>
                    <select name="maxPrice" class="price-select" onchange="this.form.submit()">
                        @foreach (var r in priceRanges)
                        {
                            <option value="@r.Value" selected="@(Model.MaxPrice == r.Value ? "selected" : null)">
                                @r.Label
                            </option>
                        }
                    </select>
                </div>
                <div class="cat-scroll" id="catTabsContainer">
                    <a class="cat-tab @(!Model.CategoryId.HasValue ? "active" : "")"
                       href="@Url.Action("Products", "Product", new { storeId = Model.Store.IdStore, search = Model.Search, maxPrice = Model.MaxPrice })">
                        All
                    </a>
                </div>
            </form>
        </div>

        <!-- Products Grid -->
        <section id="productsGrid" class="products-grid fade-up">
            @if (!Model.Products.Any())
            {
                <div class="empty-state">
                    <i class="fa-solid fa-box-open"></i>
                    <h3>No products found</h3>
                    <p>
                        @if (!string.IsNullOrEmpty(Model.Search))
                        {
                            <span>No results for "<strong>@Model.Search</strong>". </span>
                        }
                        <a href="@Url.Action("Products", "Product", new { storeId = Model.Store.IdStore })">View all</a>
                    </p>
                </div>
            }
            else
            {
                @foreach (var p in Model.Products)
                {
                    var dp = p.SalePrice ?? p.Price;
                    var onSale = p.SalePrice.HasValue && p.SalePrice < p.Price;
                    var oos = p.StockQuantity <= 0;

                    <article class="product-card"
                             data-id="@p.Id"
                             data-name="@p.Name"
                             data-price="@dp.ToString("F2")"
                             data-image="@(p.ImageUrl ?? "")">

                        <div class="product-image-box" id="imgBox-@p.Id">
                            <div class="no-img-box">🐾</div>
                            <div class="img-overlay"></div>
                            <div class="img-badges">
                                @if (oos)
                                {
                                    <span class="badge-pill badge-oos">Out of Stock</span>
                                }
                                else if (onSale)
                                {

                                    <span class="badge-pill badge-sale">🔥 Sale</span>
                                }
                            </div>
                        </div>

                      

                        <div class="product-content">
                            <h3 class="product-title">@p.Name</h3>
                            <div class="price-row">
                                <span class="price-main @(onSale ? "is-sale" : "")">@dp.ToString("F2") JD</span>
                                @if (onSale)
                                {
                                    <span class="price-original">@p.Price.ToString("F2") JD</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <p class="product-meta-text">
                                    @(p.Description.Length > 65 ? p.Description[..65] + "…" : p.Description)
                                </p>
                            }
                            <div class="card-bottom">
                                @if (!oos)
                                {
                                    
                                    <button class="add-cart-btn" data-action="add-cart" type="button">
                                        Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <span class="oos-label">Unavailable</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </section>
    </main>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" onclick="closeLightbox()">✕</button>
        <button class="lightbox-prev" onclick="lightboxGo(-1)">‹</button>
        <img id="lightboxImg" src="" alt="">
        <span class="lightbox-counter" id="lightboxCounter"></span>
        <button class="lightbox-next" onclick="lightboxGo(1)">›</button>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a><span>|</span>
            <a asp-controller="Home" asp-action="About">Contact</a><span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a>
        </div>
        <div style="font-size:.82rem;opacity:.7">© 2026 Waffy, all rights reserved.</div>
    </footer>

    <div id="toast" class="toast"></div>

    <!-- Data -->
    <script>
        window.serverProducts   = @Html.Raw(ViewBag.ProductsJson ?? "[]");
        window.serverCategories = @Html.Raw(ViewBag.CategoriesJson ?? "[]");
        window.currentStoreId   = @Model.Store.IdStore;
        window.currentSearch    = "@Html.Raw(Model.Search ?? "")";
        window.currentCatId     = @(Model.CategoryId?.ToString() ?? "null");
        window.currentMaxPrice  = @(Model.MaxPrice?.ToString() ?? "null");
    </script>

    <script>
        (function(){
        'use strict';

        const productsData = window.serverProducts || [];
        const imgMap = {};
        productsData.forEach(p => { imgMap[p.id] = p.images || []; });
        const sliderState = {};

        // ── Slider ───────────────────────────────────────────
        function buildSlider(productId) {
            const box    = document.getElementById('imgBox-' + productId);
            if (!box) return;
            const images = imgMap[productId] || [];
            if (!images.length) return;

            // حذف placeholder
            const ph = box.querySelector('.no-img-box');
            if (ph) ph.remove();

            if (images.length === 1) {
                const img = document.createElement('img');
                img.src = images[0]; img.alt = '';
                img.className = 'slide-img active';
                img.onclick = () => openLightbox(productId, 0);
                box.insertBefore(img, box.querySelector('.img-overlay'));
                return;
            }

            sliderState[productId] = 0;

            images.forEach((url, i) => {
                const img = document.createElement('img');
                img.src = url; img.alt = '';
                img.className = 'slide-img' + (i === 0 ? ' active' : '');
                img.onclick = () => openLightbox(productId, sliderState[productId]);
                box.insertBefore(img, box.querySelector('.img-overlay'));
            });

            const prev = document.createElement('button');
            prev.className = 'slider-btn prev'; prev.innerHTML = '‹';
            prev.onclick = e => { e.stopPropagation(); slideGo(productId, -1); };
            box.appendChild(prev);

            const next = document.createElement('button');
            next.className = 'slider-btn next'; next.innerHTML = '›';
            next.onclick = e => { e.stopPropagation(); slideGo(productId, 1); };
            box.appendChild(next);

            const dotsWrap = document.createElement('div');
            dotsWrap.className = 'slider-dots';
            images.forEach((_, i) => {
                const d = document.createElement('span');
                d.className = 'dot' + (i === 0 ? ' active' : '');
                d.onclick = e => { e.stopPropagation(); slideTo(productId, i); };
                dotsWrap.appendChild(d);
            });
            box.appendChild(dotsWrap);

            if (images.length > 1) {
                const ctr = document.createElement('span');
                ctr.className = 'img-count'; ctr.id = 'sc-' + productId;
                ctr.textContent = '1/' + images.length;
                box.appendChild(ctr);
            }
        }

        function slideGo(id, dir) {
            const imgs = imgMap[id] || [];
            slideTo(id, (sliderState[id] + dir + imgs.length) % imgs.length);
        }

        function slideTo(id, idx) {
            const box  = document.getElementById('imgBox-' + id);
            if (!box) return;
            const slides = box.querySelectorAll('.slide-img');
            const dots   = box.querySelectorAll('.dot');
            const ctr    = document.getElementById('sc-' + id);
            const cur    = sliderState[id] || 0;

            if (slides[cur]) slides[cur].classList.remove('active');
            if (dots[cur])   dots[cur].classList.remove('active');

            sliderState[id] = idx;
            if (slides[idx]) slides[idx].classList.add('active');
            if (dots[idx])   dots[idx].classList.add('active');
            if (ctr)         ctr.textContent = (idx+1) + '/' + slides.length;
        }

        // ── Lightbox ─────────────────────────────────────────
        let lbImages = [], lbIndex = 0;

        function openLightbox(productId, startIdx) {
            lbImages = imgMap[productId] || [];
            if (!lbImages.length) return;
            lbIndex = startIdx; updateLb();
            document.getElementById('lightbox').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeLightbox() {
            document.getElementById('lightbox').classList.remove('open');
            document.body.style.overflow = '';
        }
        function lightboxGo(dir) {
            lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
            updateLb();
        }
        function updateLb() {
            document.getElementById('lightboxImg').src        = lbImages[lbIndex];
            document.getElementById('lightboxCounter').textContent = (lbIndex+1) + ' / ' + lbImages.length;
        }
        window.closeLightbox = closeLightbox;
        window.lightboxGo    = lightboxGo;

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
        document.getElementById('lightbox').addEventListener('click', e => {
            if (e.target === document.getElementById('lightbox')) closeLightbox();
        });

        // ── Category Tabs ─────────────────────────────────────
        function buildCategoryTabs() {
            const cats      = window.serverCategories || [];
            const container = document.getElementById('catTabsContainer');
            if (!container || !cats.length) return;

            const storeId  = window.currentStoreId;
            const search   = window.currentSearch  || '';
            const maxPrice = window.currentMaxPrice || '';
            const activeCat = window.currentCatId;

            cats.forEach(c => {
                const a = document.createElement('a');
                a.className = 'cat-tab' + (String(activeCat) === String(c.id) ? ' active' : '');
                a.textContent = c.name;
                const params = new URLSearchParams();
                params.set('storeId', storeId);
                params.set('categoryId', c.id);
                if (search)   params.set('search',   search);
                if (maxPrice) params.set('maxPrice', maxPrice);
                a.href = '/Product/Products?' + params.toString();
                container.appendChild(a);
            });
        }

        // ── Init ──────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            productsData.forEach(p => buildSlider(p.id));
            buildCategoryTabs();
        });

        })();

        // ── Add to Cart ──────────────────────────────────────
        document.addEventListener('click', async function(e) {
            const btn = e.target.closest('[data-action="add-cart"]');
            if (!btn) return;

            const card    = btn.closest('.product-card');
            const id      = card?.dataset.id;
            const storeId = window.currentStoreId;
            const qty     = card?.querySelector('.qty-value')?.textContent || '1';
            if (!id || !storeId) return;

            const origText  = btn.textContent;
            btn.disabled    = true;
            btn.textContent = '⏳';

            const fd = new FormData();
            fd.append('productId', id);
            fd.append('storeId',   storeId);
            fd.append('quantity',  qty);

            try {
                const res  = await fetch('/Payment/AddToCart', { method:'POST', body:fd });
                const data = await res.json();
                if (data.success) {
                    btn.textContent = '✅';
                    document.querySelectorAll('.cart-badge, #cartCount').forEach(el => {
                        el.textContent = data.cartCount;
                        el.style.display = data.cartCount > 0 ? 'flex' : 'none';
                    });
                    setTimeout(() => { btn.textContent = origText; btn.disabled = false; }, 1500);
                } else {
                    showToast(data.message || 'Could not add to cart');
                    btn.textContent = origText; btn.disabled = false;
                }
            } catch {
                showToast('Network error');
                btn.textContent = origText; btn.disabled = false;
            }
        });

        // ── Qty ──────────────────────────────────────────────
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.qty-btn');
            if (!btn) return;
            const ctrl = btn.closest('.qty-control');
            const el   = ctrl?.querySelector('.qty-value');
            if (!el) return;
            let v = parseInt(el.textContent, 10) || 1;
            v = btn.dataset.action === 'increase' ? v+1 : Math.max(1, v-1);
            el.textContent = v;
        });

        // ── Toast ────────────────────────────────────────────
        function showToast(msg) {
            const t = document.getElementById('toast');
            if (!t) return;
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // ── Navbar Dropdown ──────────────────────────────────
        const dd = document.getElementById('servicesDropdown');
        const dg = document.getElementById('servicesToggle');
        if (dd && dg) {
            dg.addEventListener('click', e => { e.stopPropagation(); dd.classList.toggle('open'); });
            document.addEventListener('click', e => { if (!dd.contains(e.target)) dd.classList.remove('open'); });
        }
        const mb = document.getElementById('menuBtn');
        const nl = document.getElementById('navLinks');
        if (mb && nl) {
            mb.addEventListener('click', e => { e.stopPropagation(); nl.classList.toggle('open'); });
            document.addEventListener('click', e => {
                if (!nl.contains(e.target) && !mb.contains(e.target)) nl.classList.remove('open');
            });
        }
        const ms = document.getElementById('mobileServicesBlock');
        const mt = document.getElementById('mobileServicesToggle');
        if (ms && mt) mt.addEventListener('click', e => { e.stopPropagation(); ms.classList.toggle('open'); });

        // ── Search debounce ──────────────────────────────────
        const si = document.getElementById('searchInput');
        const ff = document.getElementById('filterForm');
        if (si && ff) {
            let t; si.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => ff.submit(), 500); });
        }

        // ── Fade Up ──────────────────────────────────────────
        const obs = 'IntersectionObserver' in window
            ? new IntersectionObserver(entries => {
                entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('show'); obs.unobserve(e.target); } });
            }, { threshold: .08 })
            : null;
        document.querySelectorAll('.fade-up').forEach(el => obs ? obs.observe(el) : el.classList.add('show'));
    </script>

    <script src="~/js/prodjs.js?v=3"></script>
</body>
</html>
