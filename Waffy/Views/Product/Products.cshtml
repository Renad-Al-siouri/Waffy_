@{
    Layout = null;  
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pet Products - Waffy</title>

    <link rel="stylesheet" href="~/css/prodstayle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">

                        <div class="left-nav desktop-nav desktop-links">
                            <a href="home-after.html" class="nav-link">Home</a>
                            <a href="veterinary.html" class="nav-link">Clinics</a>
                            <a href="product.html" class="nav-link active">Stores</a>
                            <a href="adapt.html" class="nav-link">Adoption</a>
                            <a href="lost.html" class="nav-link">Lost Pets</a>
                        </div>

                        <div class="logo-center">
                            <a href="home-after.html">
                                <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                            </a>
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services
                                        <span class="dropdown-arrow">▼</span>
                                    </button>

                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a href="veterinary.html" class="dropdown-link">Clinics</a>
                                        <a href="product.html" class="dropdown-link">Stores</a>
                                        <a href="adapt.html" class="dropdown-link">Adoption</a>
                                        <a href="lost.html" class="dropdown-link">Lost Pets</a>
                                        <a href="gps.html" class="dropdown-link">Map</a>
                                        <a href="money.html" class="dropdown-link">Donations</a>
                                        <a href="law.html" class="dropdown-link">Law</a>
                                        <a href="dangerousAnimal.html" class="dropdown-link">Dangerous Animal</a>
                                        <a href="support.html" class="dropdown-link">Technical Support</a>
                                        <a href="faq.html" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>

                                <a href="about.html" class="nav-link">About Us</a>
                            </div>

                            <div class="nav-actions">
                                <a href="cart.html" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                    <span id="cartCount" class="cart-badge">0</span>
                                </a>

                                <a href="#" class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>

                                <a href="profile.html" class="profile-btn" aria-label="Profile">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>

                                <a href="logout.html" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>

                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>

                                    <a href="home-after.html" class="nav-link">Home</a>
                                    <a href="veterinary.html" class="nav-link">Clinics</a>
                                    <a href="product.html" class="nav-link active">Stores</a>
                                    <a href="adapt.html" class="nav-link">Adoption</a>
                                    <a href="lost.html" class="nav-link">Lost Pets</a>
                                    <a href="gps.html" class="nav-link">Map</a>

                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>

                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a href="money.html" class="dropdown-link">Donations</a>
                                            <a href="travel.html" class="dropdown-link">Law</a>
                                            <a href="support.html" class="dropdown-link">Technical Support</a>
                                            <a href="faq.html" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a href="about.html" class="nav-link">About Us</a>
                                    <a href="cart.html" class="nav-link">Cart</a>
                                    <a href="logout.html" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>

                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container products-page">
        <section class="hero-section fade-up">
            <h1>Pet Products 🐾</h1>
            <p>
                Find and buy everything your furry friend needs, all in one adorable place.
            </p>
        </section>

        <section class="controls-area fade-up">
            <div class="search-wrap">
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text"
                       id="searchInput"
                       placeholder="Search products..." />
            </div>

            <div class="filters-row">
                <div class="category-filters">
                    <button class="category-btn active" data-category="all">All</button>
                    <button class="category-btn" data-category="food">Food</button>
                    <button class="category-btn" data-category="treats">Treats</button>
                    <button class="category-btn" data-category="toys">Toys</button>
                    <button class="category-btn" data-category="beds">Beds</button>
                    <button class="category-btn" data-category="accessories">Accessories</button>
                    <button class="category-btn" data-category="care">Care</button>
                </div>

                <div class="price-filter-box">
                    <label for="priceFilter">Filter by price:</label>
                    <select id="priceFilter">
                        <option value="all">All prices</option>
                        <option value="1">1 JD</option>
                        <option value="2">2 JD</option>
                        <option value="5">5 JD</option>
                        <option value="7">7 JD</option>
                        <option value="10">10 JD</option>
                        <option value="15">15 JD</option>
                        <option value="20">20 JD</option>
                        <option value="25">25 JD</option>
                        <option value="35">35 JD</option>
                    </select>
                </div>
            </div>
        </section>

        <section id="productsGrid" class="products-grid fade-up"></section>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a>
            <span>|</span>
            <a href="about.html">Contact</a>
            <span>|</span>
            <a href="faq.html">FAQ</a>
            <span>|</span>
            <div class="social-inline">
                <span>f</span>
                <span>🐦</span>
                <span>◎</span>
            </div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <div id="toast" class="toast"></div>

    <script src="~/js/prodjs.js"></script>
</body>
</html>