@{
    ViewData["Title"] = "Stores";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Stores</title>

    <link rel="stylesheet" href="~/css/stores.css">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">

                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Products" class="nav-link active">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>

                        <div class="logo-center">
                            <img src="~/Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services
                                        <span class="dropdown-arrow">▼</span>
                                    </button>

                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Products" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>

                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>

                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>

                                <a class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>

                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                    <img src="~/Images/user.jpg" alt="Profile">
                                </a>

                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>

                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="~/Images/logo.png" alt="Waffy Logo">
                                    </div>

                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Products" class="nav-link active">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>

                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>

                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>

                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container stores-page">
        <section class="hero-section fade-up">
            <h1>Pet Stores 🛍️</h1>
            <p>
                Browse trusted pet stores and explore products with the same cozy Waffy shopping experience.
            </p>
        </section>

        <section class="controls-area fade-up">
            <div class="search-wrap">
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="storeSearch" placeholder="Search store name..." />
            </div>
        </section>

        <section class="featured-block fade-up" id="featuredSection">
            <div class="featured-card">
                <div class="featured-image-wrap">
                    <img src="~/Images/Animals/clinic1.png" alt="Happy Paws Market" class="featured-image" />
                </div>

                <div class="featured-content">
                    <span class="featured-tag">Featured Store</span>
                    <h3>Happy Paws Market</h3>
                    <p>
                        A premium pet store offering top quality food, accessories,
                        toys, and pet essentials with a beautiful and simple shopping experience.
                    </p>

                    <div class="featured-meta">
                        <span><i class="fa-solid fa-location-dot"></i> Amman, Jordan</span>
                        <span><i class="fa-solid fa-box-open"></i> Food • Toys • Beds</span>
                    </div>

                    <div class="featured-actions">
                        <a asp-controller="Product" asp-action="Products" asp-route-storeId="1" class="btn btn-primary">
                            Shop Now
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="stores-grid fade-up" id="storesGrid">

            <article class="store-card" data-category="food" data-search="happy paws market amman food toys beds">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic2.png" alt="Happy Paws Market" class="store-image" />
                    <span class="store-badge">Top Rated</span>
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Happy Paws Market</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Amman, Jordan</span>
                        </div>
                    </div>

                    <p>Premium pet food, playful toys, comfy beds, and trusted daily essentials.</p>

                    <div class="store-tags">
                        <span>Food</span>
                        <span>Toys</span>
                        <span>Beds</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="1" class="store-btn">Shop Now</a>
                </div>
            </article>

            <article class="store-card" data-category="accessories" data-search="pet zone irbid accessories collars bowls carriers">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic3.png" alt="Pet Zone" class="store-image" />
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Pet Zone</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Irbid, Jordan</span>
                        </div>
                    </div>

                    <p>Stylish accessories, collars, bowls, harnesses, and travel carriers.</p>

                    <div class="store-tags">
                        <span>Accessories</span>
                        <span>Bowls</span>
                        <span>Carriers</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="2" class="store-btn">Shop Now</a>
                </div>
            </article>

            <article class="store-card" data-category="grooming" data-search="paw care center zarqa grooming shampoos brushes hygiene">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic4.png" alt="Paw Care Center" class="store-image" />
                    <span class="store-badge soft">Popular</span>
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Paw Care Center</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Zarqa, Jordan</span>
                        </div>
                    </div>

                    <p>Grooming supplies, shampoos, brushes, and wellness products for pets.</p>

                    <div class="store-tags">
                        <span>Grooming</span>
                        <span>Health</span>
                        <span>Care</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="3" class="store-btn">Shop Now</a>
                </div>
            </article>

            <article class="store-card" data-category="mixed" data-search="woofy corner aqaba mixed food grooming accessories">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic4.png" alt="Woofy Corner" class="store-image" />
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Woofy Corner</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Aqaba, Jordan</span>
                        </div>
                    </div>

                    <p>A complete stop for food, grooming, accessories, and daily pet needs.</p>

                    <div class="store-tags">
                        <span>Mixed</span>
                        <span>Food</span>
                        <span>Grooming</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="4" class="store-btn">Shop Now</a>
                </div>
            </article>

            <article class="store-card" data-category="food" data-search="tail treats salt nutrition dry food snacks">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic5.png" alt="Tail Treats" class="store-image" />
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Tail Treats</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Salt, Jordan</span>
                        </div>
                    </div>

                    <p>Nutritious dry food, snacks, canned meals, and special feeding products.</p>

                    <div class="store-tags">
                        <span>Nutrition</span>
                        <span>Dry Food</span>
                        <span>Snacks</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="5" class="store-btn">Shop Now</a>
                </div>
            </article>

            <article class="store-card" data-category="mixed" data-search="little paws karak home daily care accessories mixed">
                <div class="store-image-wrap">
                    <img src="~/Images/Animals/clinic1.png" alt="Little Paws Store" class="store-image" />
                </div>
                <div class="store-body">
                    <div class="store-top">
                        <h3>Little Paws Store</h3>
                        <div class="store-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Karak, Jordan</span>
                        </div>
                    </div>

                    <p>Friendly local store with daily essentials, home products, and accessories.</p>

                    <div class="store-tags">
                        <span>Mixed</span>
                        <span>Home</span>
                        <span>Daily Care</span>
                    </div>

                    <a asp-controller="Product" asp-action="Products" asp-route-storeId="6" class="store-btn">Shop Now</a>
                </div>
            </article>
        </section>

        <div class="empty-state" id="emptyState">
            <i class="fa-solid fa-store-slash"></i>
            <h3>No stores found</h3>
            <p>Try another search term.</p>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a>
            <span>|</span>
            <a href="about.html">Contact</a>
            <span>|</span>
            <a href="faq.html">FAQ</a>
            <span>|</span>
            <div class="social-inline">
                <span>f</span>
                <span>🐦</span>
                <span>◎</span>
            </div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <script src="~/js/stores.js"></script>
</body>
</html>