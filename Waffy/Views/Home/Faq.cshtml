@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAQ - Waffy</title>

    <link rel="stylesheet" href="~/css/faq.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">

                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Products" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>

                        </div>

                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">



                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services
                                        <span class="dropdown-arrow">▼</span>
                                    </button>

                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Products" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>

                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>

                            </div>

                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </a>

                                <a class="nav-icon" aria-label="Notifications">
                                    <i class="fa-solid fa-bell"></i>
                                </a>

                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a href="logout.html" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>

                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo">
                                        <img src="../Images/logo.png" alt="Waffy Logo">
                                    </div>

                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Products" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>

                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span>
                                            <span class="dropdown-arrow">▼</span>
                                        </button>

                                        <div class="mobile-services-menu" id="mobileServicesMenu">

                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>

                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>

                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="faq-page">
        <section class="faq-top fade-up">
            <h1>Frequently Asked Questions</h1>
            <p class="faq-sub">
                Find quick answers about Waffy services, bookings, shopping, adoption, and support.
            </p>
        </section>

        <section class="faq-container">

            <div class="faq-group active fade-up">
                <button class="faq-group-title" type="button">
                    <span>✨ Getting Started</span>
                    <span class="group-arrow">⌃</span>
                </button>

                <div class="faq-group-content open">
                    <div class="faq-item active">
                        <button class="faq-question" type="button">
                            <span>🐾 What is Waffy?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer open">
                            <p>
                                Waffy is an online platform that connects pet owners with veterinary clinics,
                                pet stores, and adoption services in one place.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>🐾 How do I create an account?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                You can create an account by selecting the sign up option, filling in your details,
                                and choosing the account type that fits your needs.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>🐾 Is it free to create an account?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, creating a Waffy account is free for users who want to browse services,
                                adopt pets, or shop for pet supplies.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>🐾 What types of accounts are available?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Waffy offers user accounts for pet owners, veterinary clinics, and service providers,
                                depending on the features they need.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>🐾 Can I change my account type later?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, account type changes can be requested later depending on the available settings
                                and support process in your account.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>🐾 Veterinary Clinics</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>How do I book a clinic appointment?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Go to the Clinics page, choose your preferred clinic, open the schedule,
                                select a time slot, and confirm your appointment.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>Can I cancel or change my appointment?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, appointments can be changed or canceled depending on the clinic policy
                                and the booking settings available.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>🤍 Pet Adoption</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>How can I reserve a pet for adoption?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Browse the Adoption page, choose the pet you like, and click Reserve.
                                Your request will be recorded and prepared for follow-up.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>Can I view pet health details before reserving?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, each pet can include detailed information such as age, breed,
                                temperament, health notes, and vaccination history.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>👜 Pet Marketplace (Supplies)</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>How do I add products to the cart?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Select the product quantity you want, then click Add to Cart.
                                The cart counter will update automatically.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>Can I filter products by category or price?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, the Supplies page supports filtering by category, searching by name,
                                and narrowing products by selected price.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>💳 Payments & Pricing</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>What payment methods are available?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Waffy supports payment options such as cash on delivery and card payment,
                                depending on the service or order type.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>Can I review my total before checkout?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, the cart and checkout pages clearly show item totals, subtotal,
                                shipping fees, and final payment amount.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>👤 Account Management</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>Can I update my personal details later?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                Yes, you can update your profile information later from your account settings,
                                depending on the available account features.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faq-group fade-up">
                <button class="faq-group-title" type="button">
                    <span>💬 Support & Help</span>
                    <span class="group-arrow">›</span>
                </button>

                <div class="faq-group-content">
                    <div class="faq-item">
                        <button class="faq-question" type="button">
                            <span>How can I contact support?</span>
                            <span class="faq-arrow">⌄</span>
                        </button>
                        <div class="faq-answer">
                            <p>
                                You can contact support through the Contact section or the support options
                                available in the platform whenever you need help.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </section>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a>
            <span>|</span>
            <a href="about.html">Contact</a>
            <span>|</span>
            <a href="faq.html">FAQ</a>
            <span>|</span>
            <div class="social-inline">
                <span>f</span>
                <span>🐦</span>
                <span>◎</span>
            </div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <script src="~/js/faq.js"></script>
</body>
</html>