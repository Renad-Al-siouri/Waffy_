@{
    Layout = "_Layout";
    ViewData["Title"] = "About Us - Waffy";
}
@section Styles {
    <link rel="stylesheet" href="~/css/aboutstyle.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
}

    <div class="top-hero-area about-top-area">
        <div class="top-hero-shell">
           
        </div>
    </div>

    <main class="container about-page">

        <section class="hero-section fade-up">
            <div class="welcome-block">
                <h1>Welcome to Waffy!</h1>
                <p>
                    At Waffy, we're here to make caring for your furry friends easier and better.
                    Our mission is to be a trusted partner in pet care, providing support and
                    services that both pet owners and veterinarians can rely on.
                </p>
            </div>
        </section>

        <section class="contact-card fade-up">
            <h2>Contact Us</h2>
            <p>We're always here to help. Reach out to us anytime!</p>

            <div class="contact-row">
                <a href="tel:+962791234567" class="contact-pill">📞 +962 79 1234567</a>
                <a href="tel:+962791234567" class="contact-pill">📞 +962 79 1234567</a>
            </div>

            <div class="contact-row center">
                <a href="mailto:contact@waffy.com" class="contact-pill wide">✉️ contact@waffy.com</a>
            </div>
        </section>

        <section class="stories-section fade-up">
            <div class="section-head centered-head">
                <div class="section-title-wrap">
                    <span>🐾</span>
                    <h2 class="section-title">Success Stories or Happy Adoptions</h2>
                </div>
            </div>

            <div class="stories-grid">
                <article class="story-card">
                    <img src="../Images/story1.png" alt="Story 1" />
                    <p>“Found our match!”</p>
                    <span>A happy ending for a rescued companion.</span>
                </article>

                <article class="story-card">
                    <img src="../Images/story2.png" alt="Story 2" />
                    <p>“Waffy made adoption easy.”</p>
                    <span>A smooth journey from search to adoption.</span>
                </article>

                <article class="story-card">
                    <img src="../Images/story3.png" alt="Story 3" />
                    <p>“Found our dogs!”</p>
                    <span>Community support brought them home safely.</span>
                </article>

                <article class="story-card">
                    <img src="../Images/story4.png" alt="Story 4" />
                    <p>“A second chance.”</p>
                    <span>A loving family opened their home.</span>
                </article>
            </div>
        </section>

        <section class="bottom-section fade-up">
            <div class="bottom-card">
                <p>Together, we can ensure every pet is happy, healthy, and loved.</p>
                <p>Thank you for being a part of the Waffy family!</p>
            </div>

            <div class="bottom-images">
                <img src="../Images/bottom-pets.png" alt="Bottom pets illustration" />
            </div>
        </section>

    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="about.html">About Us</a>
            <span>|</span>
            <a href="about.html">Contact</a>
            <span>|</span>
            <a href="faq.html">FAQ</a>
            <span>|</span>
            <div class="social-inline" aria-label="Social links">
                <span>f</span>
                <span>🐦</span>
                <span>◎</span>
            </div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>
@section Scripts {
    <script src="~/js/aboutjs.js"></script>
}
