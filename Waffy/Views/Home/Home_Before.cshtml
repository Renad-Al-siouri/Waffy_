    <script>
        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");
        const servicesToggle = document.getElementById("servicesToggle");
        const servicesDropdown = document.getElementById("servicesDropdown");
        const mobileServicesToggle = document.getElementById("mobileServicesToggle");
        const mobileServicesBlock = document.getElementById("mobileServicesBlock");

        if (menuBtn && navLinks) {
          menuBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            navLinks.classList.toggle("open");
          });
        }

        if (servicesToggle && servicesDropdown) {
          servicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            servicesDropdown.classList.toggle("open");
          });
        }

        if (mobileServicesToggle && mobileServicesBlock) {
          mobileServicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileServicesBlock.classList.toggle("open");
          });
        }

        document.querySelectorAll(".nav-links .nav-link, .nav-links .dropdown-link").forEach(link => {
          link.addEventListener("click", () => {
            if (window.innerWidth <= 1188) {
              navLinks.classList.remove("open");
              mobileServicesBlock.classList.remove("open");
            }
          });
        });

        document.addEventListener("click", (e) => {
          if (servicesDropdown && !servicesDropdown.contains(e.target)) {
            servicesDropdown.classList.remove("open");
          }

          if (navLinks && menuBtn && !navLinks.contains(e.target) && !menuBtn.contains(e.target)) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 1188) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

        document.querySelectorAll(".chip").forEach(chip => {
          chip.addEventListener("click", () => {
            document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
            chip.classList.add("active");
          });
        });

        const searchInput = document.getElementById("productSearch");
        const productCards = document.querySelectorAll("#productsGrid .product-card");

        if (searchInput) {
          searchInput.addEventListener("input", () => {
            const value = searchInput.value.toLowerCase().trim();

            productCards.forEach(card => {
              const title = card.querySelector(".product-title").textContent.toLowerCase();
              card.style.display = title.includes(value) ? "" : "none";
            });
          });
        }

        const map = L.map("map").setView([31.9539, 35.9106], 12);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        const locations = [
          { title: "Waffy Vet Center", lat: 31.9539, lng: 35.9106, text: "Nearby Clinic" },
          { title: "Paws Pet Shop", lat: 31.9565, lng: 35.9182, text: "Pet Store" },
          { title: "Happy Tail Clinic", lat: 31.9497, lng: 35.9239, text: "Checkups & Vaccines" },
          { title: "Emergency Pet Care", lat: 31.9614, lng: 35.8993, text: "24/7 Services" }
        ];

        const markers = {};

        locations.forEach(loc => {
          const marker = L.marker([loc.lat, loc.lng])
            .addTo(map)
            .bindPopup(`<strong>${loc.title}</strong><br>${loc.text}`);
          markers[loc.title] = marker;
        });

        document.querySelectorAll(".map-item").forEach(item => {
          item.addEventListener("click", () => {
            const lat = parseFloat(item.dataset.lat);
            const lng = parseFloat(item.dataset.lng);
            const title = item.dataset.title;

            map.setView([lat, lng], 15, { animate: true });

            if (markers[title]) {
              markers[title].openPopup();
            }
          });
        });
    </script>

    <style>
        .fp-runway {
            overflow: hidden;
            padding: 20px 0;
            -webkit-mask: linear-gradient(90deg,transparent 0%,#000 10%,#000 90%,transparent 100%);
            mask: linear-gradient(90deg,transparent 0%,#000 10%,#000 90%,transparent 100%);
        }

        .fp-belt {
            display: flex;
            gap: 16px;
            width: max-content;
            animation: fpRoll 35s linear infinite;
        }

            .fp-belt:hover {
                animation-play-state: paused;
            }
        @@keyframes fpRoll {
            from

        {
            transform: translateX(0)
        }

        to {
            transform: translateX(-50%)
        }

        }

        .fp-card {
            width: 220px;
            flex-shrink: 0;
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e8f0d8;
            box-shadow: 0 4px 16px rgba(90,101,42,.08);
            cursor: pointer;
            transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s;
            text-decoration: none;
            display: block;
        }

            .fp-card:hover {
                transform: translateY(-12px) scale(1.04);
                box-shadow: 0 20px 48px rgba(90,101,42,.18);
            }

        .fp-img-box {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg,#e8f0d8,#f4f9ee);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
            position: relative;
        }

            .fp-img-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .fp-store-badge {
            position: absolute;
            bottom: 8px;
            left: 8px;
            background: rgba(58,94,31,.85);
            color: #fff;
            font-size: .65rem;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 20px;
            backdrop-filter: blur(4px);
        }

        .fp-body {
            padding: 12px 14px 14px;
        }

        .fp-name {
            font-weight: 800;
            font-size: .88rem;
            color: #2d3a1f;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .fp-desc {
            font-size: .72rem;
            color: #8a9a6a;
            margin-bottom: 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.45;
        }

        .fp-price-row {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .fp-price {
            font-size: .92rem;
            font-weight: 900;
            color: #3a5e1f;
        }

        .fp-old {
            font-size: .74rem;
            color: #bbb;
            text-decoration: line-through;
        }

        .fp-sale {
            font-size: .62rem;
            font-weight: 800;
            background: #fff3e0;
            color: #e65100;
            padding: 2px 6px;
            border-radius: 20px;
        }
    </style>

    <script>
        (function(){
            const products = @Html.Raw(ViewBag.FeaturedProductsJson ?? "[]");
            const belt = document.getElementById('fpBelt');
            if (!belt || !products.length) return;

            const emoji = t => ({Dog:'🐕',Cat:'🐈',Bird:'🦜',Rabbit:'🐇',Fish:'🐟'}[t] || '🐾');

            function card(p) {
                const a = document.createElement('a');
                a.className = 'fp-card';
                a.href = '/Product/Products?storeId=' + p.storeId;
                const price = (p.salePrice || p.price).toFixed(3);
                a.innerHTML = `
                    <div class="fp-img-box">
                        ${p.imageUrl
                            ? `<img src="${p.imageUrl}" alt="${p.name}" loading="lazy">`
                            : `<span>${emoji(p.petType)}</span>`}
                        <div class="fp-store-badge">🏪 ${p.storeName}</div>
                    </div>
                    <div class="fp-body">
                        <div class="fp-name">${p.name}</div>
                        ${p.desc ? `<div class="fp-desc">${p.desc}</div>` : ''}
                        <div class="fp-price-row">
                            <span class="fp-price">${price} JD</span>
                            ${p.salePrice ? `<span class="fp-old">${p.price.toFixed(3)}</span><span class="fp-sale">Sale</span>` : ''}
                        </div>
                    </div>`;
                return a;
            }
        let pool = [...products];
        while (pool.length < 10) pool = [...pool, ...products];
        pool = pool.slice(0, 12);
        [...pool, ...pool].forEach(p => belt.appendChild(card(p)));
        })();
    </script>
</body>
</html>