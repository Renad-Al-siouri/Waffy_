@model IEnumerable<Waffy.Models.PetLaw>
@{
    Layout = null;
    var currentCategory = ViewBag.CurrentCategory as string ?? "all";
    var searchTerm = ViewBag.SearchTerm as string ?? "";

    var travelLaws = Model.Where(l => l.Category == "travel").ToList();
    var adoptionLaws = Model.Where(l => l.Category == "adoption").ToList();
    var allLaws = Model.ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pet Laws &amp; Travel Guide - Waffy</title>
    <link rel="stylesheet" href="~/css/travel.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* ── Category filter pills ─────────────────────────── */
        .cat-pills-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-width: 900px;
            margin: 0 auto 32px;
            padding: 0 4px;
        }

        .cat-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 16px;
            border-radius: 30px;
            font-family: 'Nunito', sans-serif;
            font-size: .82rem;
            font-weight: 700;
            background: #fff;
            border: 1.5px solid #ddd5c8;
            color: #8a7f72;
            text-decoration: none;
            transition: background .18s, color .18s, border-color .18s;
        }

            .cat-pill:hover {
                background: #6b7a3e;
                border-color: #6b7a3e;
                color: #fff;
            }

            .cat-pill.active {
                background: #6b7a3e;
                border-color: #6b7a3e;
                color: #fff;
            }

        /* ── Enhanced guide-box ────────────────────────────── */
        .guide-box {
            border-radius: 20px !important;
            border: 1px solid #e8e0d5 !important;
            box-shadow: 0 2px 16px rgba(44,36,22,.07) !important;
            overflow: hidden;
            transition: box-shadow .2s;
        }

            .guide-box:hover {
                box-shadow: 0 6px 28px rgba(44,36,22,.11) !important;
            }

        .guide-box-title {
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
            background: linear-gradient(135deg, #f0ece4, #faf7f2) !important;
            border-bottom: 1px solid #e8e0d5 !important;
            font-family: 'Fredoka', sans-serif !important;
            font-size: 1.12rem !important;
            font-weight: 700 !important;
            color: #2c2416 !important;
            padding: 18px 24px !important;
        }

        .law-count-badge {
            margin-left: auto;
            background: #6b7a3e;
            color: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .73rem;
            font-weight: 800;
            padding: 3px 11px;
            border-radius: 20px;
            white-space: nowrap;
        }

        /* ── Enhanced info-card ────────────────────────────── */
        .info-card {
            border-radius: 20px !important;
            border: 1px solid #e8e0d5 !important;
            box-shadow: 0 2px 12px rgba(44,36,22,.06) !important;
            transition: transform .22s ease, box-shadow .22s ease !important;
        }

            .info-card:hover {
                transform: translateY(-4px) !important;
                box-shadow: 0 10px 32px rgba(44,36,22,.13) !important;
            }

        .info-card-image {
            background: linear-gradient(135deg, #f0ece4, #e8ddd0) !important;
        }

        /* ── Enhanced law rows (h3 + p inside guide-box-body) ─ */
        .guide-box-body h3 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: #2c2416;
            margin-bottom: 6px;
            margin-top: 18px;
            padding-bottom: 4px;
        }

            .guide-box-body h3:first-child {
                margin-top: 0;
            }

        .guide-box-body > p {
            font-family: 'Nunito', sans-serif;
            font-size: .88rem;
            color: #7a6f63;
            line-height: 1.65;
            margin-bottom: 4px;
        }

        .law-meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            font-family: 'Nunito', sans-serif;
            font-size: .76rem;
            color: #a09590;
            margin-bottom: 20px;
            padding-bottom: 18px;
            border-bottom: 1px solid #f0ece4;
        }

            .law-meta-row:last-of-type {
                border-bottom: none;
                margin-bottom: 0;
            }

            .law-meta-row strong {
                color: #6b7a3e;
            }

        /* ── Enhanced table ────────────────────────────────── */
        .table-wrap {
            border-radius: 14px !important;
            border: 1px solid #e8e0d5 !important;
            overflow: hidden;
        }

        table thead {
            background: #f0ece4;
        }

        table th {
            font-family: 'Nunito', sans-serif;
            font-size: .77rem;
            font-weight: 800;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: #6b7a3e;
            padding: 12px 16px;
            border-bottom: 1px solid #e2d9cc;
        }

        table td {
            font-family: 'Nunito', sans-serif;
            font-size: .86rem;
            padding: 12px 16px;
            border-bottom: 1px solid #f0ece4;
            line-height: 1.55;
        }

        table tr:last-child td {
            border-bottom: none;
        }

        table tr:hover td {
            background: #faf7f2;
        }

        /* ── Enhanced mini-card ────────────────────────────── */
        .mini-card {
            border-radius: 14px !important;
            border: 1px solid #e8e0d5 !important;
            background: #f7f3ed !important;
        }

            .mini-card h4 {
                font-family: 'Fredoka', sans-serif !important;
                font-size: .9rem !important;
                color: #4a5429 !important;
            }

            .mini-card p {
                font-family: 'Nunito', sans-serif !important;
                font-size: .8rem !important;
                color: #8a7f72 !important;
            }

        /* ── Enhanced section-heading ──────────────────────── */
        .section-heading h2 {
            font-family: 'Fredoka', sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
            color: #2c2416;
        }

        .section-heading p {
            font-family: 'Nunito', sans-serif;
            font-size: .88rem;
            color: #8a7f72;
        }

        /* ── Category tag (used in search / grouped results) ── */
        .cat-tag {
            display: inline-block;
            font-family: 'Nunito', sans-serif;
            font-size: .73rem;
            background: #f0ece4;
            color: #6b7a3e;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        /* ── Empty state ───────────────────────────────────── */
        .empty-state-block {
            text-align: center;
            padding: 56px 20px;
        }

            .empty-state-block .es-icon {
                font-size: 2.8rem;
                opacity: .4;
                margin-bottom: 12px;
            }

            .empty-state-block h3 {
                font-family: 'Fredoka', sans-serif;
                font-size: 1.25rem;
                color: #2c2416;
                margin-bottom: 8px;
            }

            .empty-state-block p {
                font-family: 'Nunito', sans-serif;
                font-size: .88rem;
                color: #8a7f72;
            }

            .empty-state-block a {
                color: #6b7a3e;
                font-weight: 700;
            }
    </style>
</head>
<body>

    <!-- ══ NAVBAR — original unchanged ═══════════════════════════ -->
    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>

                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>

                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>

                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon" aria-label="Cart"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon" aria-label="Notifications"><i class="fa-solid fa-bell"></i></a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn" aria-label="Profile"><img src="../Images/user.jpg" alt="Profile"></a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>

                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="../Images/logo.png" alt="Waffy Logo"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">▼</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <!-- ══ MAIN — same structure as original ═════════════════════ -->
    <main class="container guide-page">

        <!-- Hero section — original unchanged -->
        <section class="hero-section fade-up">
            <h1>Pet Travel Regulations 🌍</h1>
            <p>Stay informed about pet adoption laws, travel requirements, and legal procedures in Jordan and abroad.</p>
            <div class="hero-image">
                <img src="../Images/travel/l.png" alt="Pet Travel Guide Illustration">
            </div>
        </section>

        <!-- Search bar — original unchanged -->
        <section class="fade-up" style="margin-bottom:24px;">
            <form method="get" asp-controller="Home" asp-action="Travel"
                  style="display:flex;gap:10px;max-width:520px;margin:0 auto;">
                <input type="text" name="search" value="@searchTerm"
                       placeholder="Search laws and regulations..."
                       style="flex:1;padding:10px 16px;border:2px solid #e0ddd6;border-radius:24px;font-family:'Nunito',sans-serif;font-size:.9rem;outline:none;" />
                <button type="submit" class="olive-btn"
                        style="padding:10px 20px;border-radius:24px;cursor:pointer;">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a asp-controller="Home" asp-action="Travel" class="olive-btn"
                       style="padding:10px 16px;border-radius:24px;text-decoration:none;">&#x2715; Clear</a>
                }
            </form>
        </section>

        <!-- Category filter pills — NEW addition -->
        <section class="fade-up" style="margin-bottom:8px;">
            <div class="cat-pills-row">
                <a class="cat-pill @(string.IsNullOrEmpty(searchTerm) && currentCategory == "all" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel">&#x1F5C2; All</a>
                <a class="cat-pill @(currentCategory == "travel" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="travel">&#x2708;&#xFE0F; Pet Travel</a>
                <a class="cat-pill @(currentCategory == "adoption" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="adoption">&#x1F43E; Adoption</a>
                <a class="cat-pill @(currentCategory == "protection" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="protection">&#x1F6E1; Protection</a>
                <a class="cat-pill @(currentCategory == "vaccination" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="vaccination">&#x1F489; Vaccinations</a>
                <a class="cat-pill @(currentCategory == "breeding" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="breeding">&#x1F9EC; Breeding</a>
                <a class="cat-pill @(currentCategory == "stray" ? "active" : "")"
                   asp-controller="Home" asp-action="Travel" asp-route-category="stray">&#x1F3DA; Stray Animals</a>
            </div>
        </section>

       
        <section class="section-heading fade-up">
            <h2>Frequently Used Guide Sections</h2>
            <p>Browse the most important legal and travel information for pets.</p>
        </section>

        <!-- ── Dynamic guide content from database ── -->
        <section class="guide-content">

            @if (!Model.Any())
            {
                <article class="guide-box fade-up">
                    <div class="guide-box-body">
                        <div class="empty-state-block">
                            <div class="es-icon">&#x1F50D;</div>
                            @if (!string.IsNullOrEmpty(searchTerm))
                            {
                                <h3>No results for &ldquo;@searchTerm&rdquo;</h3>
                                <p>Try different keywords or <a asp-controller="Home" asp-action="Travel">view all laws</a>.</p>
                            }
                            else
                            {
                                <h3>No laws available yet</h3>
                                <p>Check back soon &mdash; content is being added.</p>
                            }
                        </div>
                    </div>
                </article>
            }
            else
            {
                // ── Adoption section ──────────────────────────────
                if (adoptionLaws.Any())
                {
                    <article id="adoptionSection" class="guide-box fade-up">
                        <div class="guide-box-title">
                            &#x1F43E; Pet Adoption Laws in Jordan
                            <span class="law-count-badge">@adoptionLaws.Count law@(adoptionLaws.Count != 1 ? "s" : "")</span>
                        </div>
                        <div class="guide-box-body">
                            @foreach (var law in adoptionLaws)
                            {
                                <h3>@law.Title</h3>
                                <p>@law.Summary</p>
                                <div class="law-meta-row">
                                    @if (!string.IsNullOrEmpty(law.Source))
                                    {
                                        <span>&#x1F4DA; <strong>@law.Source</strong></span>
                                    }
                                    <span>&#x1F504; Last updated: <strong>@law.LastUpdated.ToString("MMM dd, yyyy")</strong></span>
                                </div>
                            }
                        </div>
                    </article>
                }

                // ── Travel section ────────────────────────────────
                if (travelLaws.Any())
                {
                    <article id="travelSection" class="guide-box fade-up">
                        <div class="guide-box-title">
                            &#x2708;&#xFE0F; Pet Travel Regulations
                            <span class="law-count-badge">@travelLaws.Count law@(travelLaws.Count != 1 ? "s" : "")</span>
                        </div>
                        <div class="guide-box-body">
                            @foreach (var law in travelLaws)
                            {
                                <h3>@law.Title</h3>
                                <p>@law.Summary</p>
                                <div class="law-meta-row">
                                    @if (!string.IsNullOrEmpty(law.Source))
                                    {
                                        <span>&#x1F4DA; <strong>@law.Source</strong></span>
                                    }
                                    <span>&#x1F504; Last updated: <strong>@law.LastUpdated.ToString("MMM dd, yyyy")</strong></span>
                                </div>
                            }
                            <div class="mini-grid">
                                <div class="mini-card"><h4>Travel Checklists</h4><p>Passport, microchip, vaccine record, crate, permit documents.</p></div>
                                <div class="mini-card"><h4>Health Requirements</h4><p>Vaccination schedule, health check, fit-to-travel approval.</p></div>
                                <div class="mini-card"><h4>Airline Guidelines</h4><p>Cabin rules, cargo rules, carrier dimensions, destination notes.</p></div>
                            </div>
                        </div>
                    </article>
                }

                // ── Other categories ──────────────────────────────
                var otherLaws = Model.Where(l => l.Category != "travel" && l.Category != "adoption").ToList();
                if (otherLaws.Any())
                {
                    <article id="lawsSection" class="guide-box fade-up">
                        <div class="guide-box-title">
                            &#x1F4CB; Comprehensive Guide to Pet Laws
                            <span class="law-count-badge">@otherLaws.Count law@(otherLaws.Count != 1 ? "s" : "")</span>
                        </div>
                        <div class="guide-box-body">

                            <h3>Main Legal and Travel Procedures</h3>
                            <div class="table-wrap">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Law / Procedure</th>
                                            <th>Summary</th>
                                            <th>Source</th>
                                            <th>Last Updated</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var law in otherLaws)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@law.Title</strong><br />
                                                    <small style="color:#8a7f72;">@law.CategoryLabel</small>
                                                </td>
                                                <td>@law.Summary</td>
                                                <td>@(law.Source ?? "—")</td>
                                                <td>@law.LastUpdated.ToString("MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @foreach (var group in otherLaws.GroupBy(l => l.CategoryLabel))
                            {
                                <h3>@group.Key</h3>
                                <ul>
                                    @foreach (var law in group)
                                    {
                                        <li>
                                            <strong>@law.Title:</strong> @law.Summary
                                            <br /><small style="color:#a09590;">
                                                &#x1F4DA; @law.Source &mdash; &#x1F504; @law.LastUpdated.ToString("MMM yyyy")
                                            </small>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </article>
                }
            }
        </section>

        <section class="bottom-illustration fade-up">
            <img src="../Images/travel/p.png" alt="Bottom Pets Illustration">
        </section>
    </main>

    <!-- ══ FOOTER — original unchanged ══════════════════════════ -->
    <footer class="footer">
        <div class="footer-links">
            <a asp-controller="Home" asp-action="About">About Us</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="About">Contact</a>
            <span>|</span>
            <a asp-controller="Home" asp-action="Faq">FAQ</a>
            <span>|</span>
            <div class="social-inline"><span>f</span><span>&#x1F426;</span><span>&#x25CE;</span></div>
        </div>
        <div>&#169; 2026 Waffy, all rights reserved.</div>
    </footer>

    <script src="~/js/travel.js"></script>
    <script>
        document.querySelectorAll('[data-scroll]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var target = document.querySelector(btn.getAttribute('data-scroll'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });
    </script>
</body>
</html>
