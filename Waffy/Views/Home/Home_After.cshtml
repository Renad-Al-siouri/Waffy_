    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");
        const servicesToggle = document.getElementById("servicesToggle");
        const servicesDropdown = document.getElementById("servicesDropdown");
        const mobileServicesToggle = document.getElementById("mobileServicesToggle");
        const mobileServicesBlock = document.getElementById("mobileServicesBlock");

        if (menuBtn && navLinks) {
          menuBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            navLinks.classList.toggle("open");
          });
        }

        if (servicesToggle && servicesDropdown) {
          servicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            servicesDropdown.classList.toggle("open");
          });
        }

        if (mobileServicesToggle && mobileServicesBlock) {
          mobileServicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileServicesBlock.classList.toggle("open");
          });
        }

        document.querySelectorAll(".nav-links .nav-link, .nav-links .dropdown-link").forEach(link => {
          link.addEventListener("click", () => {
            if (window.innerWidth <= 1188) {
              navLinks.classList.remove("open");
              mobileServicesBlock.classList.remove("open");
            }
          });
        });

        document.addEventListener("click", (e) => {
          if (servicesDropdown && !servicesDropdown.contains(e.target)) {
            servicesDropdown.classList.remove("open");
          }

          if (navLinks && menuBtn && !navLinks.contains(e.target) && !menuBtn.contains(e.target)) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 1188) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

                // ── Home Map ──────────────────────────────────────────
              // ── Home Map ──────────────────────────────────────────
        (function() {
            const mapEl = document.getElementById('map');
            if (!mapEl) return;

            const COLORS = {
                clinic: '#00c896', store: '#8b5cf6',
                petfriendly: '#f59e0b', playground: '#f59e0b', park: '#38a169'
            };
            const LABELS = {
                clinic: 'Clinic', store: 'Store',
                petfriendly: 'Pet Place', playground: 'Playground', park: 'Park'
            };
            const EMOJI = {
                clinic: '🏥', store: '🛍️',
                petfriendly: '🌳', playground: '🎡', park: '🌲'
            };

            const map = L.map('map').setView([31.9539, 35.9106], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',
                { maxZoom: 19 }).addTo(map);

            let allPlaces = [];

            // جلب البيانات من نفس الـ API الخاص بخريطة اليوزر
            fetch('/Map/GetMapData')
                .then(r => r.json())
                .then(data => {
                    allPlaces = [
                        ...(data.clinics      || []).map(p => ({...p, type:'clinic'})),
                        ...(data.stores       || []).map(p => ({...p, type:'store'})),
                        ...(data.adminMarkers || []).map(p => ({...p, type: p.markerType || 'petfriendly'}))
                    ].filter(p => p.lat && p.lng);

                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(pos => {
                            const { latitude: lat, longitude: lng } = pos.coords;

                            // موقع المستخدم
                            L.circleMarker([lat, lng], {
                                radius: 8, fillColor: '#3b82f6',
                                color: '#fff', weight: 2, fillOpacity: 1
                            }).addTo(map).bindPopup('📍 You are here');

                            map.setView([lat, lng], 14);

                            // رتّب بالمسافة
                            const sorted = allPlaces.map(p => ({
                                ...p,
                                dist: Math.hypot(p.lat - lat, p.lng - lng)
                            })).sort((a, b) => a.dist - b.dist);

                            renderMarkers(sorted);
                            renderPanel(sorted);
                        }, () => {
                            renderMarkers(allPlaces);
                            renderPanel(allPlaces);
                        });
                    } else {
                        renderMarkers(allPlaces);
                        renderPanel(allPlaces);
                    }
                })
                .catch(() => {
                    document.getElementById('mapClinicList').innerHTML =
                        '<p style="color:#aaa;font-size:.8rem;padding:10px 0">Could not load places.</p>';
                });

            function renderMarkers(list) {
                list.forEach(p => {
                    const color = COLORS[p.type] || '#7a9e35';
                    L.circleMarker([p.lat, p.lng], {
                        radius: 7, fillColor: color,
                        color: '#fff', weight: 2, fillOpacity: 0.9
                    }).addTo(map)
                     .bindPopup(`<strong>${p.name || p.label || '—'}</strong><br>📍 ${p.city || ''}`)
                     .on('click', () => goToMap(p.lat, p.lng));
                });
            }

            function renderPanel(list) {
                const container = document.getElementById('mapClinicList');
                if (!container) return;
                if (!list.length) {
                    container.innerHTML = '<p style="color:#aaa;font-size:.8rem;padding:10px 0">No places found.</p>';
                    return;
                }
                container.innerHTML = list.slice(0, 6).map(p => {
                    const color = COLORS[p.type] || '#7a9e35';
                    const label = LABELS[p.type] || p.type;
                    const emoji = EMOJI[p.type] || '📍';
                    const name  = p.name || p.label || '—';
                    return `<div class="map-item" style="cursor:pointer"
                                 onclick="goToMap(${p.lat}, ${p.lng})">
                                <div>
                                    <strong>${emoji} ${name}</strong>
                                    <span>${p.city || label}</span>
                                </div>
                                <span class="map-badge" style="background:${color}20;color:${color}">${label}</span>
                            </div>`;
                }).join('');
            }

            window.goToMap = function(lat, lng) {
                window.location.href = '/Map/Gps?lat=' + lat + '&lng=' + lng;
            };
        })();
    </script>

    <style>
        .fp-runway {
            overflow: hidden;
            padding: 20px 0;
            -webkit-mask: linear-gradient(90deg,transparent 0%,#000 10%,#000 90%,transparent 100%);
            mask: linear-gradient(90deg,transparent 0%,#000 10%,#000 90%,transparent 100%);
        }

        .fp-belt {
            display: flex;
            gap: 16px;
            width: max-content;
            animation: fpRoll 35s linear infinite;
        }

            .fp-belt:hover {
                animation-play-state: paused;
            }

        @@keyframes fpRoll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        .fp-card {
            width: 220px;
            flex-shrink: 0;
            border-radius: 18px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e8f0d8;
            box-shadow: 0 4px 16px rgba(90,101,42,.08);
            cursor: pointer;
            transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s;
            text-decoration: none;
            display: block;
        }

            .fp-card:hover {
                transform: translateY(-12px) scale(1.04);
                box-shadow: 0 20px 48px rgba(90,101,42,.18);
            }

        .fp-img-box {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg,#e8f0d8,#f4f9ee);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
