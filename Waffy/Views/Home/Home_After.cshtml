    <script>
        (function(){
            const products = @Html.Raw(ViewBag.FeaturedProductsJson ?? "[]");
            const belt = document.getElementById('fpBelt');
            if (!belt || !products.length) return;

            const emoji = t => ({Dog:'🐕',Cat:'🐈',Bird:'🦜',Rabbit:'🐇',Fish:'🐟'}[t] || '🐾');

            function card(p) {
                const a = document.createElement('a');
                a.className = 'fp-card';
                a.href = '/Product/Products?storeId=' + p.storeId;
                const price = (p.salePrice || p.price).toFixed(3);
                a.innerHTML = `
                    <div class="fp-img-box">
                        ${p.imageUrl
                            ? `<img src="${p.imageUrl}" alt="${p.name}" loading="lazy">`
                            : `<span>${emoji(p.petType)}</span>`}
                        <div class="fp-store-badge">🏪 ${p.storeName}</div>
                    </div>
                    <div class="fp-body">
                        <div class="fp-name">${p.name}</div>
                        ${p.desc ? `<div class="fp-desc">${p.desc}</div>` : ''}
                        <div class="fp-price-row">
                            <span class="fp-price">${price} JD</span>
                            ${p.salePrice ? `<span class="fp-old">${p.price.toFixed(3)}</span><span class="fp-sale">Sale</span>` : ''}
                        </div>
                    </div>`;
                return a;
            }

            let pool = [...products];
            while (pool.length < 10) pool = [...pool, ...products];
            pool = pool.slice(0, 12);
            [...pool, ...pool].forEach(p => belt.appendChild(card(p)));
        })();

                                  (function () {
            const reports = @Html.Raw(ViewBag.LostReportsJson ?? "[]");
            const grid    = document.getElementById('lpGrid');
            const ticker  = document.getElementById('lpTicker');
            if (!grid) return;

            const em = { bird:'🦜', rabbit:'🐇', duck:'🦆', dog:'🐕', cat:'🐈', hamster:'🐹' };
            const ge = t => em[(t||'').toLowerCase()] || '🐾';
            const ago = d => {
                if (!d) return '';
                const v = Math.round((Date.now() - new Date(d)) / 86400000);
                return v === 0 ? 'Today' : v === 1 ? '1 day ago' : v + ' days ago';
            };

            function buildCard(r) {
                const card = document.createElement('div');
                card.className = 'lp-card';

                const imgs = (r.images && r.images.length) ? r.images : (r.image ? [r.image] : []);
                const multi = imgs.length > 1;

                /* Left — image side */
                const imgSide = document.createElement('div');
                imgSide.className = 'lp-img-side';

                if (imgs.length) {
                    imgs.forEach((src, i) => {
                        const img = document.createElement('img');
                        if (i === 0) img.classList.add('active');
                        img.src = src; img.alt = r.name || ''; img.loading = 'lazy';
                        imgSide.appendChild(img);
                    });

                    const hasRw = r.hasReward && parseFloat(r.reward) > 0;
                    if (hasRw) {
                        const rb = document.createElement('div');
                        rb.className = 'lp-img-reward';
                        rb.textContent = '🎁 ' + parseFloat(r.reward).toFixed(0) + ' JD';
                        imgSide.appendChild(rb);
                    }

                    if (multi) {
                        const ctr = document.createElement('div');
                        ctr.className = 'lp-iphoto';
                        ctr.textContent = '1/' + imgs.length;
                        imgSide.appendChild(ctr);

                        const prev = document.createElement('button');
                        prev.className = 'lp-iarr prev'; prev.innerHTML = '‹'; prev.type = 'button';
                        const next = document.createElement('button');
                        next.className = 'lp-iarr next'; next.innerHTML = '›'; next.type = 'button';
                        imgSide.appendChild(prev); imgSide.appendChild(next);

                        const dotsWrap = document.createElement('div');
                        dotsWrap.className = 'lp-idots';
                        imgs.forEach((_, i) => {
                            const d = document.createElement('button');
                            d.className = 'lp-idot' + (i === 0 ? ' on' : '');
                            d.type = 'button'; dotsWrap.appendChild(d);
                        });
                        imgSide.appendChild(dotsWrap);

                        let cur = 0;
                        const allImgs = imgSide.querySelectorAll('img');
                        const allDots = dotsWrap.querySelectorAll('.lp-idot');
                              // إلى
        const goTo = idx => {
            allImgs[cur].classList.remove('active'); allDots[cur].classList.remove('on');
            cur = ((idx % imgs.length) + imgs.length) % imgs.length;
            allImgs[cur].classList.add('active'); allDots[cur].classList.add('on');
            ctr.textContent = (cur + 1) + '/' + imgs.length;
        };
                        prev.addEventListener('click', e => { e.stopPropagation(); goTo(cur - 1); });
                        next.addEventListener('click', e => { e.stopPropagation(); goTo(cur + 1); });
                        allDots.forEach((d, i) => d.addEventListener('click', e => { e.stopPropagation(); goTo(i); }));
                    }
                } else {
                    const ph = document.createElement('div');
                    ph.className = 'lp-img-ph';
                    ph.textContent = ge(r.animalType || r.AnimalType);
                    imgSide.appendChild(ph);
                }
                card.appendChild(imgSide);

                /* Right — detail side */
                const name  = r.name  || r.Name  || 'Unknown';
                const type  = r.animalType || r.AnimalType || '';
                const breed = r.breed || r.Breed || '';
                const color = r.color || r.Color || '';
                const city  = r.city  || r.City  || '';
                const area  = r.area  || r.Area  || '';
                const phone = r.contactPhone || r.ContactPhone || '';
                const a     = ago(r.dateLost || r.DateLost);
                const hasRw = r.hasReward && parseFloat(r.reward) > 0;

                const det = document.createElement('div');
                det.className = 'lp-detail-side';
                det.innerHTML = `
                    <div class="lp-card-top">
                        <div class="lp-pet-name">${name}</div>
                        <div class="lp-type-tag">${type}</div>
                    </div>
                    <div class="lp-rows">
                        ${breed ? `<div class="lp-row"><strong>Breed</strong> ${breed}</div>` : ''}
                        ${color ? `<div class="lp-row"><strong>Color</strong> ${color}</div>` : ''}
                        <div class="lp-row">📍 ${city}${area ? ' — ' + area : ''}</div>
                        ${phone ? `<div class="lp-row">📞 ${phone}</div>` : ''}
                    </div>
                    <div class="lp-card-bottom">
                        <div class="lp-ago">🕒 ${a || '—'}</div>
                        ${hasRw ? `<div class="lp-reward-pill">🎁 ${parseFloat(r.reward).toFixed(0)} JD reward</div>` : ''}
                    </div>`;
                card.appendChild(det);

                card.addEventListener('click', () => { window.location.href = '/Pet/Lost'; });
                return card;
            }

            if (reports.length) {
                reports.slice(0, 6).forEach(r => grid.appendChild(buildCard(r)));
            } else {
                grid.style.display = 'none';
            }

            if (ticker && reports.length) {
                [...reports, ...reports].forEach(r => {
                    const imgs = (r.images && r.images.length) ? r.images : (r.image ? [r.image] : []);
                    const el = document.createElement('a');
                    el.className = 'lp-ticker-item'; el.href = '/Pet/Lost';
                    el.innerHTML = `
                        <div class="lp-ticker-thumb">${imgs[0] ? `<img src="${imgs[0]}" alt="${r.name||''}">` : `<span>${ge(r.animalType||r.AnimalType)}</span>`}</div>
                        <span class="lp-ticker-name">${r.name||r.Name||'Unknown'}</span>
                        <span class="lp-ticker-city">${r.city||r.City||''}</span>`;
                    ticker.appendChild(el);
                });
            }
        })();

                (function () {
            const posts  = @Html.Raw(ViewBag.AdoptionJson ?? "[]");
            const grid   = document.getElementById('adoptionGrid');
            if (!grid || !posts.length) return;

            const em = { dog:'🐕', cat:'🐈', bird:'🦜', rabbit:'🐇', hamster:'🐹', snake:'🐍' };
            const ge = t => em[(t||'').toLowerCase()] || '🐾';

            posts.forEach(p => {
                const imgs   = (p.images && p.images.length) ? p.images : (p.image ? [p.image] : []);
                const multi  = imgs.length > 1;

                const article = document.createElement('article');
                article.className = 'animal-card';

                /* ── Image wrap with carousel ── */
                const wrap = document.createElement('div');
                wrap.className = 'adopt-img-wrap';

                if (imgs.length) {
                    imgs.forEach((src, i) => {
                        const img = document.createElement('img');
                        if (i === 0) img.classList.add('acar-active');
                        img.src = src; img.alt = p.name || ''; img.loading = 'lazy';
                        wrap.appendChild(img);
                    });

                    if (multi) {
                        // counter
                        const ctr = document.createElement('div');
                        ctr.className = 'acar-counter';
                        ctr.textContent = '1 / ' + imgs.length;
                        wrap.appendChild(ctr);

                        // arrows
                        const prev = document.createElement('button');
                        prev.className = 'acar-arr prev'; prev.innerHTML = '‹'; prev.type = 'button';
                        const next = document.createElement('button');
                        next.className = 'acar-arr next'; next.innerHTML = '›'; next.type = 'button';
                        wrap.appendChild(prev); wrap.appendChild(next);

                        // dots
                        const dotsWrap = document.createElement('div');
                        dotsWrap.className = 'acar-dots';
                        imgs.forEach((_, i) => {
                            const d = document.createElement('button');
                            d.className = 'acar-dot' + (i === 0 ? ' on' : '');
                            d.type = 'button'; dotsWrap.appendChild(d);
                        });
                        wrap.appendChild(dotsWrap);

                        let cur = 0;
                        const allImgs = wrap.querySelectorAll('img');
                        const allDots = dotsWrap.querySelectorAll('.acar-dot');
                              
               // إلى
        const goTo = idx => {
            allImgs[cur].classList.remove('acar-active');
            allDots[cur].classList.remove('on');
            cur = ((idx % imgs.length) + imgs.length) % imgs.length;
            allImgs[cur].classList.add('acar-active');
            allDots[cur].classList.add('on');
            ctr.textContent = (cur + 1) + ' / ' + imgs.length;
        };
                        prev.addEventListener('click', e => { e.stopPropagation(); goTo(cur - 1); });
                        next.addEventListener('click', e => { e.stopPropagation(); goTo(cur + 1); });
                        allDots.forEach((d, i) => d.addEventListener('click', e => { e.stopPropagation(); goTo(i); }));
                    }
                } else {
                    const ph = document.createElement('div');
                    ph.className = 'adopt-img-ph';
                    ph.textContent = ge(p.type);
                    wrap.appendChild(ph);
                }

                article.appendChild(wrap);

                /* ── Info ── */
                const info = document.createElement('div');
                info.innerHTML = `
                    <strong>${p.name || 'Unknown'}</strong>
                    <ul>
                        ${p.breed  ? `<li>Breed: ${p.breed}</li>` : ''}
                        ${p.age    ? `<li>Age: ${p.age}</li>` : ''}
                        ${p.gender ? `<li>Gender: ${p.gender}</li>` : ''}
                        ${p.city   ? `<li>📍 ${p.city}${p.area ? ' — ' + p.area : ''}</li>` : ''}
                        ${p.temperament ? `<li>Temperament: ${p.temperament}</li>` : ''}
                    </ul>`;
                article.appendChild(info);

                /* ── Click → adoption page ── */
                article.style.cursor = 'pointer';
                article.addEventListener('click', () => { window.location.href = '/Pet/Adapt'; });

                grid.appendChild(article);
            });
        })();

                (function () {
            const clinics = @Html.Raw(ViewBag.HomeClinicsJson ?? "[]");
            const grid    = document.getElementById('homeClinicsGrid');
            if (!grid || !clinics.length) return;

            clinics.forEach(c => {
                const card = document.createElement('a');
                card.className = 'hc-card';
                card.href = '/Clinic/ClinicDetail/' + c.id;

                const hours = (c.openTime && c.closeTime)
                    ? c.openTime + ' – ' + c.closeTime
                    : '—';
                const stars = c.rating > 0
                    ? '⭐ ' + parseFloat(c.rating).toFixed(1)
                    : 'New';

                card.innerHTML = `
                    <div class="hc-cover">
                        ${c.cover
                            ? `<img src="${c.cover}" alt="${c.name}" loading="lazy">`
                            : `<div class="hc-cover-ph">🏥</div>`}
                        <span class="hc-status ${c.isOpen ? 'hc-open' : 'hc-closed'}">
                            ${c.isOpen ? '● Open' : '● Closed'}
                        </span>
                        ${c.hasEmergency ? `<span class="hc-emg">🚨 Emergency</span>` : ''}
                    </div>
                    <div class="hc-body">
                        <div class="hc-name">${c.name}</div>
                        <div class="hc-loc">📍 ${c.city}${c.area ? ' — ' + c.area : ''}</div>
                        <div class="hc-row">
                            <span class="hc-hours">🕐 ${hours}</span>
                            <span class="hc-rating">${stars}</span>
                        </div>
                    </div>`;

                grid.appendChild(card);
            });
        })();
    </script>
</body>
</html>