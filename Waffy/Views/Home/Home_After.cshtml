    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");
        const servicesToggle = document.getElementById("servicesToggle");
        const servicesDropdown = document.getElementById("servicesDropdown");
        const mobileServicesToggle = document.getElementById("mobileServicesToggle");
        const mobileServicesBlock = document.getElementById("mobileServicesBlock");

        if (menuBtn && navLinks) {
          menuBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            navLinks.classList.toggle("open");
          });
        }

        if (servicesToggle && servicesDropdown) {
          servicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            servicesDropdown.classList.toggle("open");
          });
        }

        if (mobileServicesToggle && mobileServicesBlock) {
          mobileServicesToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            mobileServicesBlock.classList.toggle("open");
          });
        }

        document.querySelectorAll(".nav-links .nav-link, .nav-links .dropdown-link").forEach(link => {
          link.addEventListener("click", () => {
            if (window.innerWidth <= 1188) {
              navLinks.classList.remove("open");
              mobileServicesBlock.classList.remove("open");
            }
          });
        });

        document.addEventListener("click", (e) => {
          if (servicesDropdown && !servicesDropdown.contains(e.target)) {
            servicesDropdown.classList.remove("open");
          }

          if (navLinks && menuBtn && !navLinks.contains(e.target) && !menuBtn.contains(e.target)) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 1188) {
            navLinks.classList.remove("open");
            mobileServicesBlock.classList.remove("open");
          }
        });

        document.querySelectorAll(".chip").forEach(chip => {
          chip.addEventListener("click", () => {
            document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
            chip.classList.add("active");
          });
        });

        const searchInput = document.getElementById("productSearch");
        const productCards = document.querySelectorAll("#productsGrid .product-card");

        if (searchInput) {
          searchInput.addEventListener("input", () => {
            const value = searchInput.value.toLowerCase().trim();

            productCards.forEach(card => {
              const title = card.querySelector(".product-title").textContent.toLowerCase();
              card.style.display = title.includes(value) ? "" : "none";
            });
          });
        }

        const map = L.map("map").setView([31.9539, 35.9106], 12);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        const locations = [
          { title: "Waffy Vet Center", lat: 31.9539, lng: 35.9106, text: "Nearby Clinic" },
          { title: "Paws Pet Shop", lat: 31.9565, lng: 35.9182, text: "Pet Store" },
          { title: "Happy Tail Clinic", lat: 31.9497, lng: 35.9239, text: "Checkups & Vaccines" },
          { title: "Emergency Pet Care", lat: 31.9614, lng: 35.8993, text: "24/7 Services" }
        ];

        const markers = {};

        locations.forEach(loc => {
          const marker = L.marker([loc.lat, loc.lng])
            .addTo(map)
            .bindPopup(`<strong>${loc.title}</strong><br>${loc.text}`);
          markers[loc.title] = marker;
        });

        document.querySelectorAll(".map-item").forEach(item => {
          item.addEventListener("click", () => {
            const lat = parseFloat(item.dataset.lat);
            const lng = parseFloat(item.dataset.lng);
            const title = item.dataset.title;

            map.setView([lat, lng], 15, { animate: true });

            if (markers[title]) {
              markers[title].openPopup();
            }
          });
        });

        document.querySelectorAll(".add-cart-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            alert("Item added to cart.");
          });
        });

        document.querySelectorAll(".details-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            alert("Clinic details page will open here.");
          });
        });

        document.querySelectorAll(".reserve-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            alert("Reservation request sent successfully.");
          });
        });

        document.querySelectorAll(".done-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            alert("This report has been marked as done.");
          });
        });
    </script>
</body>
</html>