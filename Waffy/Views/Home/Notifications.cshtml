@model Waffy.Models.ViewModels.NotificationViewModel
@{
    ViewData["Title"] = "Notifications";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Waffy - Notifications</title>
    <link rel="stylesheet" href="~/css/notifications.css" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

    <div class="top-hero-area">
        <div class="top-hero-shell">
            <header class="topbar">
                <div class="header-shell">
                    <nav class="navbar">
                        <div class="left-nav desktop-nav desktop-links">
                            <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                            <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                            <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                            <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                            <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                        </div>
                        <div class="logo-center">
                            <img src="../Images/logo.png" alt="Waffy Main Logo" class="main-logo">
                        </div>
                        <div class="right-nav">
                            <div class="desktop-nav desktop-links desktop-right-links">
                                <div class="services-dropdown" id="servicesDropdown">
                                    <button class="nav-link dropdown-toggle" id="servicesToggle" type="button">
                                        Services <span class="dropdown-arrow">▼</span>
                                    </button>
                                    <div class="dropdown-menu" id="servicesMenu">
                                        <a asp-controller="Clinic" asp-action="Clinics" class="dropdown-link">Clinics</a>
                                        <a asp-controller="Product" asp-action="Stores" class="dropdown-link">Stores</a>
                                        <a asp-controller="Pet" asp-action="Adapt" class="dropdown-link">Adoption</a>
                                        <a asp-controller="Pet" asp-action="Lost" class="dropdown-link">Lost Pets</a>
                                        <a asp-controller="Map" asp-action="Gps" class="dropdown-link">Map</a>
                                        <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                        <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                        <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                        <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                        <a asp-controller="Home" asp-action="Faq" class="dropdown-link">FAQ</a>
                                    </div>
                                </div>
                                <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                            </div>
                            <div class="nav-actions">
                                <a asp-controller="Payment" asp-action="Cart" class="nav-icon"><i class="fa-solid fa-cart-shopping"></i></a>
                                <a asp-controller="Home" asp-action="Notifications" class="nav-icon"><i class="fa-solid fa-bell"></i></a>
                                <a asp-controller="Account" asp-action="Profile" class="profile-btn">
                                    <img src="../Images/user.jpg" alt="Profile">
                                </a>
                                <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                            </div>
                            <div class="mobile-nav-wrap">
                                <button class="menu-btn" id="menuBtn" type="button">☰</button>
                                <div class="nav-links" id="navLinks">
                                    <div class="mobile-menu-logo"><img src="../Images/logo.png" alt="Waffy Logo"></div>
                                    <a asp-controller="Home" asp-action="Home_After" class="nav-link active">Home</a>
                                    <a asp-controller="Clinic" asp-action="Clinics" class="nav-link">Clinics</a>
                                    <a asp-controller="Product" asp-action="Stores" class="nav-link">Stores</a>
                                    <a asp-controller="Pet" asp-action="Adapt" class="nav-link">Adoption</a>
                                    <a asp-controller="Pet" asp-action="Lost" class="nav-link">Lost Pets</a>
                                    <a asp-controller="Map" asp-action="Gps" class="nav-link">Map</a>
                                    <div class="mobile-services-block" id="mobileServicesBlock">
                                        <button class="mobile-services-toggle" id="mobileServicesToggle" type="button">
                                            <span>Services</span><span class="dropdown-arrow">▼</span>
                                        </button>
                                        <div class="mobile-services-menu" id="mobileServicesMenu">
                                            <a asp-controller="Payment" asp-action="Donate" class="dropdown-link">Donations</a>
                                            <a asp-controller="Home" asp-action="Travel" class="dropdown-link">Law</a>
                                            <a asp-controller="Map" asp-action="Dangerous" class="dropdown-link">Dangerous Animal</a>
                                            <a asp-controller="Home" asp-action="Suport" class="dropdown-link">Technical Support</a>
                                            <a asp-controller="Home" asp-action="Fag" class="dropdown-link">FAQ</a>
                                        </div>
                                    </div>
                                    <a asp-controller="Home" asp-action="About" class="nav-link">About Us</a>
                                    <a asp-controller="Account" asp-action="Logout" class="nav-link login-btn">Log out</a>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        </div>
    </div>

    <main class="container notifications-page">
        <section class="hero-section fade-up">
            <h1>Notifications 🔔</h1>
            <p>Stay updated with adoption approvals, warnings, rewards, and important updates from Waffy.</p>
        </section>

        <!-- ── Summary Cards ── -->
        <section class="top-summary fade-up">
            <article class="summary-card">
                <span class="summary-icon"><i class="fa-solid fa-bell"></i></span>
                <div>
                    <strong>@Model.UnreadCount New Notification@(Model.UnreadCount != 1 ? "s" : "")</strong>
                    <p>Unread alerts waiting for you</p>
                </div>
            </article>
            <article class="summary-card">
                <span class="summary-icon"><i class="fa-solid fa-list-check"></i></span>
                <div>
                    <strong>@Model.TotalCount Total</strong>
                    <p>All notifications in your inbox</p>
                </div>
            </article>
            <article class="summary-card">
                <span class="summary-icon"><i class="fa-solid fa-shield-heart"></i></span>
                <div>
                    <strong>@Model.Notifications.Count(n => n.Type == "Warning") Warnings</strong>
                    <p>From Waffy admin team</p>
                </div>
            </article>
        </section>

        <!-- ── Controls ── -->
        <section class="controls-area fade-up">
            <div class="search-wrap">
                <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="notificationSearch" placeholder="Search notifications..." />
            </div>
            <div class="filters-row">
                <div class="category-filters">
                    <button class="category-btn active" data-filter="all">All</button>
                    <button class="category-btn" data-filter="adoption">Adoption</button>
                    <button class="category-btn" data-filter="warning">Warnings</button>
                    <button class="category-btn" data-filter="reward">Rewards</button>
                    <button class="category-btn" data-filter="system">System</button>
                </div>
                <div class="actions-box">
                    @if (Model.UnreadCount > 0)
                    {
                        <form method="post" asp-controller="Home" asp-action="MarkAllNotificationsRead"
                              style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ghost-btn">
                                <i class="fa-solid fa-check-double"></i>
                                Mark all as read
                            </button>
                        </form>
                    }
                </div>
            </div>
        </section>

        <!-- ── Notifications List ── -->
        <section class="notifications-list fade-up" id="notificationsList">

            @if (!Model.Notifications.Any())
            {
                <div class="empty-state show">
                    <i class="fa-solid fa-bell-slash"></i>
                    <h3>No notifications yet</h3>
                    <p>When you receive notifications they'll appear here.</p>
                </div>
            }

            @foreach (var notif in Model.Notifications)
            {
                var typeClass = notif.Type?.ToLower() switch
                {
                    "warning" => "system",
                    "adoption" => "adoption",
                    "reward" => "reward",
                    _ => "system"
                };
                var icon = notif.Type?.ToLower() switch
                {
                    "warning" => "fa-triangle-exclamation",
                    "adoption" => "fa-paw",
                    "reward" => "fa-trophy",
                    _ => "fa-bell"
                };
                var filterType = notif.Type?.ToLower() switch
                {
                    "warning" => "warning",
                    "adoption" => "adoption",
                    "reward" => "reward",
                    _ => "system"
                };
                var searchText = $"{notif.Title} {notif.Message} {notif.Type}".ToLower();
                var isUnread = !notif.IsRead;

                <article class="notification-card @(isUnread ? "unread" : "")"
                         data-type="@filterType"
                         data-search="@searchText">
                    <div class="notification-icon @typeClass">
                        <i class="fa-solid @icon"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-top">
                            <div>
                                <h3>@notif.Title</h3>
                                <p class="notification-message">@notif.Message</p>
                            </div>
                            @if (isUnread)
                            {
                                <span class="notification-badge">New</span>
                            }
                            @if (notif.Type == "Warning")
                            {
                                <span class="notification-badge" style="background:#fef3c7;color:#9b6000;">
                                    ⚠️ Warning
                                </span>
                            }
                    </div>
                    <div class="notification-meta">
                        <span>
                            <i class="fa-regular fa-clock"></i>
                            @(notif.CreatedAt.HasValue
                                                        ? notif.CreatedAt.Value.ToString("MMM dd, yyyy · hh:mm tt")
                                                        : "—")
                        </span>
                        <span>
                            <i class="fa-solid fa-layer-group"></i>
                            @(notif.Type ?? "System")
                        </span>
                    </div>
                    @if (isUnread)
                        {
                            <div class="notification-actions">
                                <form method="post"
                                      asp-controller="Home"
                                      asp-action="MarkNotificationRead"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notif.Id" />
                                    <button type="submit" class="notif-btn secondary">
                                        Mark as Read
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </article>
            }
        </section>

        <div class="empty-state" id="emptyState">
            <i class="fa-solid fa-bell-slash"></i>
            <h3>No notifications found</h3>
            <p>Try another search term or choose a different category.</p>
        </div>
    </main>

    <footer class="footer">
        <div class="footer-links">
            <a href="#">About Us</a><span>|</span>
            <a href="#">Contact</a><span>|</span>
            <a href="#">FAQ</a><span>|</span>
            <div class="social-inline"><span>f</span><span>🐦</span><span>◎</span></div>
        </div>
        <div>© 2026 Waffy, all rights reserved.</div>
    </footer>

    <script src="~/js/Notifications.js"></script>
</body>
</html>